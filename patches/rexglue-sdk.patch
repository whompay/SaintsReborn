+// prepass_fuse_verify (debug, dist file): exact GPU self-test. The largest fused batch of each submission is
+// drawn again at the end of the submission into two scratch depth / stencil buffers cleared the same way:
+// A = one fused instanced draw (depth-only fused pipeline), B = the original separate indexed native draws
+// (IA index buffer + per-draw constant buffer, depth-only native pipeline); a compute shader compares every
+// sample's depth bits and stencil. At most every 250 ms. Log 'PREPASS FUSE VERIFY'.
+struct PrepassFuseVerifyBatch {
+  std::vector<PrepassFuseDraw> records;
+  const void* fused_pipeline = nullptr;
+  const void* plain_pipeline = nullptr;
+  D3D12_GPU_VIRTUAL_ADDRESS table_gpu = 0;
+  uint32_t draw_vertices = 0, draw_instances = 0, topology = 0, stencil_ref = 0, depth_format = 0, samples = 1;
+  uint32_t fused_topology = 0;  // v6: concatenated batches are drawn as lists (topology = the guest one)
+  D3D12_VIEWPORT viewport = {};
+  D3D12_RECT scissor = {};
+};
+struct PrepassFuseVerifyState {
+  static constexpr uint32_t kSlots = 8;
+  bool init_ok = false;
+  Microsoft::WRL::ComPtr<ID3D12RootSignature> root;
+  Microsoft::WRL::ComPtr<ID3D12PipelineState> compare;
+  Microsoft::WRL::ComPtr<ID3D12Resource> ds[2];
+  D3D12_RESOURCE_STATES ds_state[2] = {D3D12_RESOURCE_STATE_DEPTH_WRITE, D3D12_RESOURCE_STATE_DEPTH_WRITE};
+  uint32_t ds_w = 0, ds_h = 0, ds_format = UINT32_MAX, ds_samples = 0;
+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> dsv_heap;
+  Microsoft::WRL::ComPtr<ID3D12Resource> result, readback, zero;
+  D3D12_RESOURCE_STATES result_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  const uint32_t* readback_map = nullptr;
+  uint64_t slot_submission[kSlots] = {};
+  bool slot_pending[kSlots] = {};
+  uint32_t slot_instances[kSlots] = {};
+  uint32_t next_slot = 0;
+  std::vector<std::pair<uint64_t, Microsoft::WRL::ComPtr<ID3D12Resource>>> retired;
+  std::vector<std::pair<uint64_t, Microsoft::WRL::ComPtr<ID3D12DescriptorHeap>>> retired_heaps;
+  PrepassFuseVerifyBatch cur, best;
+  uint64_t last_test_tick = 0;
+  // Stats (per log period).
+  uint64_t tests = 0, exact = 0, instances = 0, depth_differ = 0, stencil_differ = 0, covered = 0, skipped = 0;
+};
+static PrepassFuseVerifyState g_pfv;
+static bool PrepassFuseVerifyOn() {
+  static uint64_t next = 0;
+  static bool on = false;
+  const uint64_t now = GetTickCount64();
+  if (now >= next) {
+    next = now + 1000;
+    on = false;
+    if (FILE* f = RexFlagFopen("prepass_fuse_verify")) {
+      on = true;
+      std::fclose(f);
+    }
+  }
+  return on;
+}
+static void PrepassFuseVerifyHarvest(uint64_t completed_submission) {
+  PrepassFuseVerifyState& v = g_pfv;
+  for (uint32_t i = 0; i < PrepassFuseVerifyState::kSlots; ++i) {
+    if (!v.slot_pending[i] || v.slot_submission[i] > completed_submission || !v.readback_map) continue;
+    const uint32_t* r = v.readback_map + i * 8;
+    ++v.tests;
+    v.instances += v.slot_instances[i];
+    v.depth_differ += r[0];
+    v.stencil_differ += r[1];
+    v.covered += r[2];
+    if (!r[0] && !r[1]) ++v.exact;
+    v.slot_pending[i] = false;
+  }
+  for (size_t i = 0; i < v.retired.size();) {
+    if (v.retired[i].first <= completed_submission) {
+      v.retired[i] = std::move(v.retired.back());
+      v.retired.pop_back();
+    } else {
+      ++i;
