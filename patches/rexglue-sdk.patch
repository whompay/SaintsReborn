@@ -0,0 +1,264 @@
+/**
+ * Saints Reborn online identity and fair play (used by eos_lan.cpp, the
+ * Xbox Live session layer and the user profile).
+ *
+ * Reserved names: "Whompay" and look-alikes (sr_reserved_names.h) belong to
+ * one person. That person's game has owner.key next to the exe (an ECDSA P-256
+ * private key, never shared or published). After the Epic login it signs
+ * "SaintsReborn owner v1|<its Epic ProductUserId>" and publishes the signature
+ * with its lobby membership (SROWN). Every other game checks the signature
+ * against the public key below, for that member's own Epic ID, so a copied
+ * signature is useless to anyone else. A reserved name without a valid
+ * signature is refused locally (shown as "Player") and ignored by others.
+ *
+ * Fair play: the game (online_integrity.cpp in the exe) sets the cvars
+ * online_modded / online_modded_reason when mods, custom maps, cheat tools or
+ * a debugger are in use. Public Xbox Live matches keep modded and unmodded
+ * players apart and ranked is unmodded only (xgi_live.inc, eos_lan.cpp).
+ */
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <bcrypt.h>
+#pragma comment(lib, "bcrypt.lib")
+
+#include "sr_reserved_names.h"
+
+REXCVAR_DEFINE_BOOL(online_modded, false, "Online",
+                    "Mods, custom maps or cheat tools are in use (set by the game; public matches with other modded "
+                    "players only, no ranked)");
+REXCVAR_DEFINE_STRING(online_modded_reason, "", "Online", "What makes this game modded (set by the game)");
+REXCVAR_DEFINE_STRING(online_notice, "", "Online", "Message for the player from the online layer (shown by the game)");
+// Players online (MULTIPLAYER > PLAYERS tab, project/src/online_players.cpp):
+REXCVAR_DEFINE_BOOL(online_wanted, false, "Online", "Join the online player list now (set by the game when MULTIPLAYER opens)");
+REXCVAR_DEFINE_STRING(online_activity, "", "Online", "What this player is doing, shown to others (set by the game)");
+REXCVAR_DEFINE_STRING(online_session, "", "Online", "The Live match this game hosts / plays in (set by the Live layer)");
+REXCVAR_DEFINE_STRING(online_friend_code, "", "Online", "This player's friend code (set after the Epic login)");
+REXCVAR_DEFINE_STRING(online_friend_add, "", "Online", "A friend code typed in MULTIPLAYER > OPTIONS > Add Friend");
+REXCVAR_DEFINE_STRING(online_invite_from, "", "Online", "Name of the player whose lobby invite is waiting (F10 joins)");
+REXCVAR_DEFINE_BOOL(online_invite_accept, false, "Online", "Set by the game when the player accepts the waiting invite");
+REXCVAR_DEFINE_STRING(online_players, "", "Online",
+                      "Everyone online: first line '#' + state, then one 'flags|name|activity' line per player "
+                      "(flags: s this game, m modded, o verified owner)");
+
+namespace rex::system::online {
+
+namespace {
+
+// BCRYPT_ECCPUBLIC_BLOB (ECDSA P-256) of the owner key.
+const uint8_t kOwnerPublic[72] = {
+    0x45, 0x43, 0x53, 0x31, 0x20, 0x00, 0x00, 0x00, 0x18, 0xEF, 0x0C, 0x74,
+    0x54, 0x4C, 0x58, 0xC5, 0x45, 0x87, 0x7E, 0xFB, 0x05, 0xFD, 0xC9, 0x6E,
+    0x75, 0xFE, 0x8D, 0x86, 0x25, 0xD9, 0xF0, 0xD9, 0x16, 0x68, 0x59, 0xBA,
+    0x07, 0x1E, 0x2B, 0x24, 0x1C, 0xDE, 0x52, 0x9B, 0xFD, 0xE3, 0x6E, 0x31,
+    0x8B, 0x5D, 0xA6, 0x12, 0x97, 0x34, 0xA8, 0xD7, 0xE3, 0x25, 0x30, 0x14,
+    0x46, 0x3F, 0xA1, 0x17, 0x08, 0xC1, 0x98, 0xFF, 0x4E, 0xFC, 0x24, 0x8D
+};
+constexpr char kProofPrefix[] = "SaintsReborn owner v1|";
+
+std::string ExeDir() {
+  char path[MAX_PATH] = {};
+  GetModuleFileNameA(nullptr, path, MAX_PATH);
+  std::string s(path);
+  return s.substr(0, s.find_last_of("\\/") + 1);
+}
+
+bool Sha256(const std::string& text, uint8_t out[32]) {
+  BCRYPT_ALG_HANDLE alg = nullptr;
+  if (BCryptOpenAlgorithmProvider(&alg, BCRYPT_SHA256_ALGORITHM, nullptr, 0) != 0) return false;
+  const bool ok = BCryptHash(alg, nullptr, 0, reinterpret_cast<PUCHAR>(const_cast<char*>(text.data())),
+                             ULONG(text.size()), out, 32) == 0;
+  BCryptCloseAlgorithmProvider(alg, 0);
+  return ok;
+}
+
+BCRYPT_KEY_HANDLE ImportKey(BCRYPT_ALG_HANDLE alg, const wchar_t* type, const uint8_t* blob, ULONG size) {
+  BCRYPT_KEY_HANDLE key = nullptr;
+  if (BCryptImportKeyPair(alg, nullptr, type, &key, const_cast<PUCHAR>(blob), size, 0) != 0) return nullptr;
+  return key;
+}
+
+bool Verify(const std::string& message, const uint8_t sig[64]) {
+  uint8_t hash[32];
+  if (!Sha256(message, hash)) return false;
+  BCRYPT_ALG_HANDLE alg = nullptr;
+  if (BCryptOpenAlgorithmProvider(&alg, BCRYPT_ECDSA_P256_ALGORITHM, nullptr, 0) != 0) return false;
+  bool ok = false;
+  if (BCRYPT_KEY_HANDLE key = ImportKey(alg, BCRYPT_ECCPUBLIC_BLOB, kOwnerPublic, sizeof(kOwnerPublic))) {
+    ok = BCryptVerifySignature(key, nullptr, hash, 32, const_cast<PUCHAR>(sig), 64, 0) == 0;
+    BCryptDestroyKey(key);
+  }
+  BCryptCloseAlgorithmProvider(alg, 0);
+  return ok;
+}
+
+bool Sign(const std::vector<uint8_t>& priv, const std::string& message, uint8_t sig[64]) {
+  uint8_t hash[32];
+  if (!Sha256(message, hash)) return false;
+  BCRYPT_ALG_HANDLE alg = nullptr;
+  if (BCryptOpenAlgorithmProvider(&alg, BCRYPT_ECDSA_P256_ALGORITHM, nullptr, 0) != 0) return false;
+  bool ok = false;
+  if (BCRYPT_KEY_HANDLE key = ImportKey(alg, BCRYPT_ECCPRIVATE_BLOB, priv.data(), ULONG(priv.size()))) {
+    ULONG n = 0;
+    ok = BCryptSignHash(key, nullptr, hash, 32, sig, 64, &n, 0) == 0 && n == 64;
+    BCryptDestroyKey(key);
+  }
+  BCryptCloseAlgorithmProvider(alg, 0);
+  return ok;
+}
+
+std::once_flag g_key_once;
+std::vector<uint8_t> g_private;  // BCRYPT_ECCPRIVATE_BLOB, only on the owner's PC
+bool g_owner = false;
+
+void LoadOwnerKey() {
+  const std::string path = ExeDir() + "owner.key";
+  FILE* f = std::fopen(path.c_str(), "rb");
+  if (!f) return;
+  std::vector<uint8_t> blob(104);
+  const size_t n = std::fread(blob.data(), 1, blob.size(), f);
+  std::fclose(f);
+  // Same curve point as the built-in public key, and it really signs.
+  if (n != 104 || std::memcmp(blob.data() + 8, kOwnerPublic + 8, 64) != 0 || blob[0] != 0x45 || blob[2] != 0x53 ||
+      blob[3] != 0x32) {
+    REXSYS_WARN("Online: owner.key is not the owner key; ignored");
+    return;
+  }
+  uint8_t sig[64];
+  if (!Sign(blob, "self test", sig) || !Verify("self test", sig)) {
+    REXSYS_WARN("Online: owner.key failed its self test; ignored");
+    return;
+  }
+  g_private = std::move(blob);
+  g_owner = true;
+  REXSYS_INFO("Online: owner key loaded (reserved names allowed for this game)");
+}
+
+std::string Hex(const uint8_t* p, size_t n) {
+  static const char* d = "0123456789abcdef";
+  std::string s;
+  for (size_t i = 0; i < n; ++i) { s += d[p[i] >> 4]; s += d[p[i] & 15]; }
+  return s;
+}
+
+}  // namespace
+
+bool IsReservedName(const std::string& name) { return sr_names::IsReserved(name); }
+bool PacketHasReservedName(const uint8_t* data, size_t len) { return sr_names::PacketHasReservedName(data, len); }
+
+bool IsOwner() {
+  std::call_once(g_key_once, LoadOwnerKey);
+  return g_owner;
+}
+
+// The name this game may use: printable ASCII, up to 15 characters, and a
+// reserved name only with the owner key.
+std::string SafeName(const std::string& wanted) {
+  std::string s;
+  for (unsigned char c : wanted)
+    if (c >= 0x20 && c < 0x7F) s.push_back(char(c));
+  while (!s.empty() && s.back() == ' ') s.pop_back();
+  while (!s.empty() && s.front() == ' ') s.erase(s.begin());
+  s = s.substr(0, 15);
+  if (!s.empty() && IsReservedName(s) && !IsOwner()) {
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true)) REXSYS_WARN("Online: the name '{}' is reserved; using 'Player' instead", s);
+    return "Player";
+  }
+  return s;
+}
+
+// Signature for this game's Epic ID (hex), or "" without the owner key.
+std::string OwnerProof(const std::string& puid) {
+  if (!IsOwner() || puid.empty()) return {};
+  uint8_t sig[64];
+  if (!Sign(g_private, kProofPrefix + puid, sig)) return {};
+  return Hex(sig, 64);
+}
+
+bool VerifyOwnerProof(const std::string& puid, const std::string& hex) {
+  if (puid.empty() || hex.size() != 128) return false;
+  uint8_t sig[64];
+  for (int i = 0; i < 64; ++i) {
+    auto nib = [](char c) -> int { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; };
+    const int a = nib(hex[i * 2]), b = nib(hex[i * 2 + 1]);
+    if (a < 0 || b < 0) return false;
+    sig[i] = uint8_t(a << 4 | b);
+  }
+  return Verify(kProofPrefix + puid, sig);
+}
+
+bool Modded() { return rex::cvar::GetFlagByName("online_modded") == "true"; }
+std::string ModdedReason() {
+  std::string r = rex::cvar::GetFlagByName("online_modded_reason");
+  return r.empty() ? std::string("modded") : r;
+}
+
+// Message for the player; the game shows it for a few seconds.
+void Notice(const std::string& text) {
+  rex::cvar::SetFlagByName("online_notice", text);
+  REXSYS_INFO("Online notice: {}", text);
+}
+
+// This player's Xbox Live XUID for multiplayer (XamUserGetXUID with the
+// online bit). Everyone used to report the profile XUID 0xB13EBABEBABEBABE,
+// and the game matches players by XUID: the match start message (type 83)
+// hands out teams as {xuid, team} pairs, so with equal XUIDs every player got
+// the last team ("all on one team"), and each game took every player for
+// itself. The profile XUID stays as it is (saves use it); this one is made
+// once per install (dist\online_id.txt, random) and mixed with the PC and
+// Windows user names, so a copied folder still gives a different XUID.
+uint64_t OnlineXuid() {
+  static std::once_flag once;
+  static uint64_t xuid = 0;
+  std::call_once(once, [] {
+    const std::string path = ExeDir() + "online_id.txt";
+    std::string id;
+    if (FILE* f = std::fopen(path.c_str(), "rb")) {
+      char buf[64] = {};
+      const size_t n = std::fread(buf, 1, sizeof(buf) - 1, f);
+      std::fclose(f);
+      for (size_t i = 0; i < n; ++i)
+        if ((buf[i] >= '0' && buf[i] <= '9') || (buf[i] >= 'a' && buf[i] <= 'f')) id += buf[i];
+    }
+    if (id.size() < 16) {
+      uint8_t rnd[16] = {};
+      if (BCryptGenRandom(nullptr, rnd, sizeof(rnd), BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0) {
+        const uint64_t t = GetTickCount64() ^ (uint64_t(GetCurrentProcessId()) << 32);
+        std::memcpy(rnd, &t, 8);
+      }
+      id = Hex(rnd, sizeof(rnd));
+      if (FILE* f = std::fopen(path.c_str(), "wb")) {
+        std::fwrite(id.data(), 1, id.size(), f);
+        std::fclose(f);
+      }
+    }
+    char pc[MAX_COMPUTERNAME_LENGTH + 1] = {};
+    DWORD pc_n = sizeof(pc);
+    GetComputerNameA(pc, &pc_n);
+    char user[256] = {};
+    DWORD user_n = 0;
+    if (const DWORD got = GetEnvironmentVariableA("USERNAME", user, sizeof(user)); got && got < sizeof(user)) user_n = got;
+    const std::string key = "saintsreborn-xuid|" + id + "|" + std::string(pc, pc_n) + "|" + std::string(user, user_n);
+    uint64_t h = 1469598103934665603ull;
+    for (char c : key) { h ^= uint8_t(c); h *= 1099511628211ull; }
+    // 0x0009 = online (Live) XUID range, like the friend list XUIDs.
+    xuid = 0x0009000000000000ull | (h & 0x0000FFFFFFFFFFFFull);
+    if (xuid == 0x0009000000000000ull) xuid |= 1;
+    REXSYS_INFO("Online: multiplayer XUID {:016X} (profile XUID unchanged)", xuid);
+  });
+  return xuid;
+}
+
+}  // namespace rex::system::online
