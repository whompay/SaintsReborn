+    }
+    const uint32_t old = g_m3.mode.exchange(mode, std::memory_order_relaxed);
+    // Installed once and kept: owned NOP spans already in flight must still be rebuilt after a switch-off.
+    if (mode) rex::graphics::g_m3_marker_hook.store(&M3MarkerHook, std::memory_order_relaxed);
+    if (old != mode) REXLOG_INFO("NATIVE M3 (NATIVE23A2): mode {}", mode == 2 ? "REPLACE" : mode ? "shadow" : "off");
+  }
