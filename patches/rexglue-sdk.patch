+  const int sent = rex::system::eoslan::SendInvites(xuids);
+  REXLOG_INFO("LIVE XInviteSend(user {}, {} invitee(s)): {}", user, count,
+              sent < 0 ? std::string("not in a lobby") : fmt::format("{} delivered over Epic", sent));
+  const uint32_t result = sent > 0 ? 0 : 1627;
+  if (overlapped_ptr) {
+    ks->CompleteOverlappedImmediate(overlapped_ptr, result);
+    return 997;  // ERROR_IO_PENDING, like the console
+  }
+  return result;
+}
