+void D3D12CommandProcessor::OnHostWroteGuestMemory(uint32_t physical_address, uint32_t length) {
+  // Fence / event writes land on pages the GPU side usually holds nothing of:
+  // then there is nothing to invalidate and no watch (a watch needs valid
+  // pages), so skip the global lock and the watch callbacks. ~2000 writes/s.
+  if (shared_memory_ && length &&
+      shared_memory_->RangeHasNoValidPages(physical_address & 0x1FFFFFFF, length)) {
+    return;
+  }
+  // Performance work: how often and where the command processor writes guest
+  // memory (each write invalidates GPU-side copies of the page).
+  if (D3D12PerfDiag()) {
+    static std::unordered_map<uint32_t, uint64_t> page_stats;
+    static uint64_t stats_tick = 0, total = 0;
+    ++page_stats[(physical_address & 0x1FFFFFFF) >> 12];
+    ++total;
+    const uint64_t now = GetTickCount64();
+    if (!stats_tick) stats_tick = now;
+    if (now - stats_tick >= 10000) {
+      const double seconds = double(now - stats_tick) / 1000.0;
+      static const char* kSites[8] = {"read ptr writeback", "scratch reg", "REG_TO_MEM",
+                                      "MEM_WRITE",          "COND_WRITE",  "EVENT_WRITE_SHD",
+                                      "EVENT_WRITE_EXT",    "ZPD samples"};
+      std::string sites;
+      for (uint32_t i = 0; i < 8; ++i) {
+        const uint64_t n = g_host_write_sites[i].exchange(0);
+        if (n) sites += fmt::format(" [{}: {:.1f}/s]", kSites[i], n / seconds);
+      }
+      std::vector<std::pair<uint32_t, uint64_t>> v(page_stats.begin(), page_stats.end());
+      std::sort(v.begin(), v.end(), [](auto& x, auto& y) { return x.second > y.second; });
+      std::string pages;
+      for (size_t i = 0; i < v.size() && i < 10; ++i) {
+        pages += fmt::format(" [{:08X}: {:.1f}/s]", v[i].first << 12, v[i].second / seconds);
+      }
+      REXLOG_INFO("HOST WRITES by the command processor: {:.1f}/s; by site:{}; pages:{}",
+                  total / seconds, sites, pages);
+      page_stats.clear();
+      total = 0;
+      stats_tick = now;
+    }
+  }
+  if (shared_memory_ && length) {
+    shared_memory_->MemoryInvalidationCallback(physical_address & 0x1FFFFFFF, length, true);
+  }
+}
