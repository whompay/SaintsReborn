+// Pre-pass fusion (AGENT_NATIVE22A, design codexNV14b): consecutive native city depth FAST-path draws with the
+// same fused pipeline and nothing else recorded in between are drawn as ONE DrawInstanced - one instance per
+// guest draw (its NativeFastConstants + index base / count / format in a structured buffer indexed by
+// SV_InstanceID), indices fetched by the VS from shared memory (same bits the IA reads), shorter draws padded
+// by repeating their last index (zero-area primitives, no samples). D3D keeps primitive order across instances,
+// so depth / stencil (REPLACE, INCR/DECR wrap) results equal the separate draws. Any command recorded between
+// two draws (upload, barrier, state, query) ends the batch, so the original order is kept by construction.
+// The draw is recorded once as a marker D3DDrawInstanced(0xFFFFFFFF, 0, header pointer); the counts live in
+// the batch header (upload memory) and are read when the list is replayed (end of submission,
+// deferred_command_list.cpp). Opt-in: dist file prepass_fuse; prepass_fuse.off wins.
+// prepass_fuse_cap N = max instances per call (1..256, default 256; 1 = fused shader without instancing).
+struct PrepassFuseDraw {
+  NativeFastConstants nc;
+  uint32_t p3[4];  // index base (bytes in shared memory), index count, flags (1 = 32-bit indices, 2 = strip
+                   // drawn as a list, 4 = strip odd order {i+1, i, i+2}), first vertex (concat)
+};
+static_assert(sizeof(PrepassFuseDraw) == 160, "fused draw record layout");
+static_assert(offsetof(PrepassFuseDraw, p3) == 144, "fused draw header p3 offset");
+static constexpr uint32_t kPrepassFuseMaxCap = 256;
+// Table = header record (slot 0: u32 [0] vertices per instance, [1] instances - read by the replay; p3 = record
+// count, mode 1 = concatenated triangle list / 0 = instanced) + the draw records in slots 1..n.
+static constexpr uint32_t kPrepassFuseHeaderP3Offset = 144;
+static constexpr uint32_t kPrepassFuseNativeId = 0x46555345;  // pipeline cache id of the fused VS
+struct PrepassFuseState {
+  bool init_ok = false;
+  std::vector<uint8_t> vs;
+  ID3D12RootSignature* root_signature = nullptr;
+  // Open batch.
+  bool open = false;
+  uint64_t submission = 0, frame = 0;
+  size_t end_size = 0;  // deferred command stream size right after the batch's draw
+  const void* pipeline = nullptr;
+  uint32_t* header = nullptr;  // [0] vertices per instance, [1] instances (written only, upload memory)
+  uint32_t* header_p3 = nullptr;  // [0] record count, [1] mode (1 = concatenated triangle list)
+  PrepassFuseDraw* records = nullptr;
+  bool concat = false;
+  uint32_t count = 0, min_vertices = 0, max_vertices = 0, total_vertices = 0, cap = kPrepassFuseMaxCap;
+  // Stats (per log period).
+  uint64_t draws = 0, batches = 0, source_vertices = 0, padded_vertices = 0, max_batch = 0, concat_batches = 0, empty = 0;
+  uint64_t inel_ib = 0, inel_reset = 0, inel_align = 0, split_state = 0, split_ratio = 0, split_cap = 0;
+  // v6 (AGENT_NATIVE24A): triangle STRIPS concatenated as triangle lists (the VS maps list ordinal -> strip
+  // ordinal with the D3D odd-triangle swap). 0 = off (v5: strips instanced), 1 = odd triangle {i, i+2, i+1},
+  // 2 = odd triangle {i+1, i, i+2} (same winding, other rotation). dist prepass_fuse_strips.off -> 0,
+  // prepass_fuse_strip_order2 (present) -> 2.
+  uint32_t strip_mode = 1;
+  uint64_t strip_draws = 0;
+};
+static PrepassFuseState g_pfuse;
+static bool PrepassFuseOn() {
+  static uint64_t next = 0;
+  static bool on = false;
+  const uint64_t now = GetTickCount64();
+  if (now >= next) {
+    next = now + 1000;
+    on = false;
+    if (FILE* f = RexFlagFopen("prepass_fuse")) {
+      on = true;
+      std::fclose(f);
+    }
+    if (FILE* f = RexFlagFopen("prepass_fuse.off")) {
+      on = false;
+      std::fclose(f);
+    }
+    uint32_t cap = kPrepassFuseMaxCap;
+    if (FILE* f = RexFlagFopen("prepass_fuse_cap")) {
+      unsigned v = 0;
+      if (std::fscanf(f, "%u", &v) == 1) cap = std::min(kPrepassFuseMaxCap, std::max(1u, v));
+      std::fclose(f);
+    }
+    g_pfuse.cap = cap;
+    uint32_t strip_mode = 1;
+    if (FILE* f = RexFlagFopen("prepass_fuse_strip_order2")) {
+      strip_mode = 2;
+      std::fclose(f);
+    }
+    if (FILE* f = RexFlagFopen("prepass_fuse_strips.off")) {
+      strip_mode = 0;
+      std::fclose(f);
+    }
+    g_pfuse.strip_mode = strip_mode;
+  }
+  return on;
+}
