+/**
+ * Scene post-process (pre-HUD), see scene_post.h.
+ *
+ * Switch file "scene_post" (next to the exe), optional content = options,
+ * separated by spaces / commas / new lines. An empty file = preset "modern".
+ *   preset=subtle|modern|cinematic|classic   base values (applied first, the
+ *                                   other options override single values)
+ *   noao nobloom notonemap nosky novoid nohaze   turn single effects off
+ *   debug=ao | debug=depth | debug=logz | debug=haze   debug views
+ *   ao_radius=300 ao_strength=1.4 ao_max_px=48 ao_samples=8 ao_div=0 fov=60
+ *       (radius in near-plane units; ao_div = AO resolution divisor, 0 = 2 x res scale)
+ *   bloom_threshold=0.55 bloom_strength=0.3 bloom_radius=1 (1/8 res dual filter)
+ *   exposure=1 contrast=1 saturation=1.06 vibrance=0.3 shoulder=0.9 white=1.25 lift=0
+ *   filmic=0.35 (S-curve amount) split=0.6 (cool shadows / warm highlights)
+ *   temperature=0 tint=0 vignette=0.25 sharpen=0.35 black=0.0
+ *   sky=0.75 (regrade of the flat sky to a gradient) horizon=0.55 (screen fraction)
+ *   sky_top=r,g,b sky_horizon=r,g,b (linear, written as r/g/b, e.g. sky_top=0.06/0.18/0.55)
+ *   void=0.6 (fill pixels with no geometry with the horizon haze, brightness; 0 = off)
+ *   haze=0.35 haze_start=1024 haze_end=16384 (aerial perspective, near-plane units;
+ *       calibrated with debug=logz: ground below the bench spot ~2^9.8, far
+ *       buildings ~2^12.5)
+ *   ao_lag1 (final uses the previous frame's AO, one barrier stage less)
+ *   ao_far=0 (no AO beyond this linear depth, near-plane units; 0 = off;
+ *       the normal / skylight is kept)
+ *   dest=0F642000                   guest address of the scene resolve
+ *   ao_rel=0.2                      AO radius at most this fraction of the pixel's distance (no
+ *                                   dark halo around close objects at street level; 0 = off)
+ *   bloom_prev                      old bloom / clarity input: the PREVIOUS frame's 1/8 res bright
+ *                                   pass (cheaper, but pumps / flickers on fast camera turns)
+ *   count_pick                      old way to find the final scene resolve (by its index; flickers
+ *                                   when the number of scene resolves changes, e.g. lights at night)
+ * "scene_post.off" disables everything (wins over "scene_post").
+ *
+ * Depth: the scene uses reversed float depth (GEQUAL, near = 1, far -> 0), so
+ * linear view depth in units of the near plane distance is 1 / d. Pixels with
