+// Diagnostics: frames drawn with the exact view-projection / the fallback, and how far
+// (m, along the view) the drawn camera was from the mod's camera when last checked.
+extern "C" __declspec(dllexport) void RexWorldMeshStats(float* out3) {
+  using namespace rex::graphics::d3d12;
+  if (!out3) return;
+  out3[0] = float(g_world_mesh_exact_frames.load(std::memory_order_relaxed));
+  out3[1] = float(g_world_mesh_fallback_frames.load(std::memory_order_relaxed));
+  out3[2] = g_world_vp_wpos.load(std::memory_order_relaxed);
+}
