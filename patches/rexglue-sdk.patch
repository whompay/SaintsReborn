+      // and verify its 64 KB region every frame from now on.
+      bool still_same = false;
+      {
+        auto global_lock = global_critical_region_.Acquire();
+        still_same = (system_page_flags_valid_[page >> 6] & bit) &&
+                     (page_hash_known_[page >> 6] & bit) && page_hashes_[page] == stored;
+        if (still_same) {
+          const uint32_t region = (page << log2) >> 16;
+          reinterpret_cast<std::atomic<uint64_t>*>(volatile_regions_.data() + (region >> 6))
+              ->fetch_or(uint64_t(1) << (region & 63), std::memory_order_relaxed);
+        }
+      }
+      if (still_same) {
+        verifier_changed_.fetch_add(1, std::memory_order_relaxed);
+        MemoryInvalidationCallback(page << log2, uint32_t(page_size), true);
+      }
+    }
+    pages.clear();
+    {
+      std::lock_guard<std::mutex> lock(verifier_mutex_);
+      verifier_busy_ = false;
+    }
+    const uint64_t now = GetTickCount64();
+    if (now - last_log >= 10000) {
+      const double seconds = double(now - last_log) / 1000.0;
+      last_log = now;
+      REXLOG_INFO(
+          "BACKGROUND VERIFY: {:.0f} pages/s hashed, {:.1f}/s changed without a fault, {:.1f} "
+          "frames/s fell back (verifier busy)",
+          verifier_checked_.exchange(0) / seconds, verifier_changed_.exchange(0) / seconds,
+          verifier_skipped_frames_.exchange(0) / seconds);
+    }
+  }
