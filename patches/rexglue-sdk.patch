+  GroupMemoryBarrierWithGroupSync();
+  if (gi < 8u) {
+    float4 col = 0.0;
+    [unroll] for (uint r = 0; r < 8; ++r) col += g_bl[gi + r * 8u];
+    g_bl[gi] = col;
+    if (flags & 16384u) {
+      float4 sk = 0.0;
+      [unroll] for (uint r = 0; r < 8; ++r) sk += g_sk[gi + r * 8u];
+      g_sk[gi] = sk;
+    }
+  }
+  GroupMemoryBarrierWithGroupSync();
