+    uint64_t submission = 0;
+    bool busy = false;
+    uint64_t vs = 0, ps = 0;
+    uint32_t dc = 0, cmask = 0, rt_bits = 0, stencil_ref = 0;
+    uint32_t ext[14] = {};
+    bool has_q = false;
