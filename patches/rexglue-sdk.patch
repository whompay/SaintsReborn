+                        uint32_t(sb.aniso_filter));
+  }
+  REXLOG_INFO("NATIVE CITY MAIN: PS bindings {}{}:{}", ok ? "OK" : "MISMATCH (fallback), missing",
+              missing, text);
+  return ok;
+}
+
+static void CityMainPoll(uint64_t now_tick) {
+  CityMainState& cm = g_city_main;
+  uint32_t mode = 0;
+  if (!Perf5FileExists("native_city_main.off")) {
+    if (FILE* f = RexFlagFopen("native_city_main")) {
+      const int c = std::fgetc(f);
+      mode = c == 'v' ? 2 : c == 'p' ? 3 : 1;
+      std::fclose(f);
+    } else if (Perf5FileExists("native_city_main_vs")) {
+      mode = 2;  // same as content "v" (for the benchmark jobs, which create empty files)
+    } else if (Perf5FileExists("native_city_main_ps")) {
+      mode = 3;
+    }
+  }
+  if (mode != cm.mode) {
+    cm.mode = mode;
+    REXLOG_INFO("NATIVE CITY MAIN: {}", mode == 0   ? "OFF"
+                                        : mode == 1 ? "ON (native VS + native PS)"
+                                        : mode == 2 ? "ON (native VS, translated PS)"
+                                                    : "ON (translated VS, native PS)");
+  }
+  if (now_tick < cm.next_log) return;
+  uint64_t fallback_total = 0;
+  for (uint64_t n : cm.fallbacks) fallback_total += n;
+  if (cm.next_log && (cm.mode || cm.draws || fallback_total)) {
+    const double frames = double(std::max<uint64_t>(1, g_prepass_frame - cm.log_frame));
+    std::string reasons;
+    for (uint32_t i = 0; i < kCityMainFbCount; ++i) {
+      if (cm.fallbacks[i]) reasons += fmt::format(" {} {}", kCityMainFbNames[i], cm.fallbacks[i]);
+    }
+    REXLOG_INFO("NATIVE CITY MAIN: mode {} ({}), last 10 s: {:.0f} frames, native draws {} ({:.1f}/frame), "
+                "fallbacks to emulation {} ({:.1f}/frame){}{}",
+                cm.mode, cm.init_tried ? (cm.init_ok ? "ready" : "init FAILED") : "not initialized",
+                frames, cm.draws, cm.draws / frames, fallback_total, fallback_total / frames,
+                reasons.empty() ? "" : ":", reasons);
+  }
+  cm.draws = 0;
+  std::memset(cm.fallbacks, 0, sizeof(cm.fallbacks));
+  cm.next_log = now_tick + 10000;
+  cm.log_frame = g_prepass_frame;
+}
+
+#include "native_view.inc"  // native view (debug, dist native_view, default off)
+
+bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint32_t index_count,
+                                      IndexBufferInfo* index_buffer_info,
+                                      bool major_mode_explicit) {
+  g_exec.hit = g_exec.record = g_exec.verify = nullptr;
+  g_m3b_replay.pending = false;  // EXEC8 x8d
+  if (gpu_timer_category_ != kGpuTimeDrawDepthOnly &&
+      !(gpu_timer_category_ >= 0xC0 && gpu_timer_category_ < 0xF0)) {  // gpu_timing_draws sub-categories
+    GpuTimerSwitch(kGpuTimeDraw);
+  }
+  ++gpu_count_draws_;
+  ++stat_draws_;
+  ++ab_frame_draws_;
+  ++g_resolve_diag_draw_serial;
+  ++census_pass_draws_;
+  ++draws_in_submission_;
+  NvSlackProbeDraw();  // native_view.inc slack probe (dist cp_burn_<ns>, default off)
+#if XE_GPU_FINE_GRAINED_DRAW_SCOPES
+  SCOPE_profile_cpu_f("gpu");
+#endif  // XE_GPU_FINE_GRAINED_DRAW_SCOPES
+
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  const RegisterFile& regs = *register_file_;
+
+  NativeBridgeVerifyDraw(primitive_type, index_count, index_buffer_info != nullptr,
+                         index_buffer_info ? index_buffer_info->guest_base : 0,
+                         index_buffer_info && index_buffer_info->format == xenos::IndexFormat::kInt32
+                             ? uint32_t(4)
+                             : uint32_t(2),
+                         regs,
+                         active_vertex_shader(), active_pixel_shader());
+  NativeMetaOnDraw(regs);  // EXEC9: draw metadata v1 lookup + counters (diagnostic; one TLS load when unused)
+  // M3a (dist\native_frame_exec_verify): counts this draw's outcome when IssueDraw returns.
+  struct M3aScope {
+    ~M3aScope() {
+      if (g_m3a_cur.active) M3aFinish();
+    }
+  } m3a_scope;
+
+  xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (edram_mode == xenos::EdramMode::kCopy) {
+    // Special copy handling.
+    g_native_fast.valid = false; ++g_nexec_inval_gen;
+    g_native_fast.verify_pending = false;  // codexNV15 D2: no stale verification across copies
+    return IssueCopy();
+  }
+
+  // Native renderer slice 1 fast path (see NativeFastState).
+  {
+    NativeFastState& nf = g_native_fast;
+    const bool native_on_now = ab_active_ && ab_experiment_ == 0 ? ab_phase_ == 0 : native_enabled_;
+    bool fast_ok = nf.valid && native_on_now && !NativeFastOff();
+    if (fast_ok && (active_vertex_shader() != nf.vs || active_pixel_shader() != nf.ps_raw)) {
+      ++nf.misses_shader;
+      fast_ok = false;
+    }
+    if (fast_ok) {
+      for (size_t i = 0; i < kNativeFastKeyCount; ++i) {
+        if (regs[kNativeFastKeyRegs[i]] != nf.key[i]) {
+          fast_ok = false;
+          ++nf.misses_key;
+          break;
+        }
+      }
+    }
+    // AGENT_NATIVE29A NEXEC: the 1-entry state missed -> multi-entry native executor cache.
+    bool nexec_hit = false, nexec_rast = true, fast_verify_armed = false;
+    uint32_t nexec_ndc = 0, nexec_ncm = 0;
+    if (!fast_ok && native_on_now && !NativeFastOff()) {
+      NexecPoll();  // native path off = no NEXEC work at all
+      if (g_nexec.on) {
+        nexec_hit = NexecLoad(nf, regs, active_vertex_shader(), active_pixel_shader(), submission_current_,
+                              frame_current_, &nexec_ndc, &nexec_ncm, &nexec_rast);
+        fast_ok = nexec_hit;
+      }
+    }
+    if (fast_ok) {
+      LARGE_INTEGER t0;
+      QueryPerformanceCounter(&t0);
+      if (!BeginSubmission(true)) {
+        return false;
+      }
+      if (submission_current_ != nf.submission || frame_current_ != nf.frame) {
+        ++nf.misses_submission;
+        fast_ok = false;
+      }
+      if (fast_ok && nexec_hit) {
+        // NEXEC: another draw may have bound other render targets since the entry was learned -> the RT cache decides
+        // (fast path when unchanged; otherwise the same binding / ownership transfers the full path would do).
+        reg::RB_DEPTHCONTROL nexec_dc;
+        nexec_dc.value = nexec_ndc;
+        const uint64_t full0 = render_target_cache_->stat_update_full_;
+        if (!render_target_cache_->Update(nexec_rast, nexec_dc, nexec_ncm,
+                                          *static_cast<D3D12Shader*>(active_vertex_shader()))) {
+          return false;
+        }
+        if (render_target_cache_->stat_update_full_ != full0) ++g_nexec.rt_full;
+      }
+      PrimitiveProcessor::ProcessingResult ppr;
+      if (fast_ok) {
+        if (!primitive_processor_->Process(ppr)) {
+          return false;
+        }
+        if (!ppr.host_draw_vertex_count) {
+          return true;  // nothing to draw; the fast state stays valid
+        }
+        if (ppr.IsTessellated() || uint32_t(ppr.host_primitive_type) != nf.host_primitive_type ||
+            uint32_t(ppr.host_vertex_shader_type) != nf.host_vertex_shader_type ||
+            ppr.index_buffer_type == PrimitiveProcessor::ProcessedIndexBufferType::kNone) {
+          ++nf.misses_other;
+          fast_ok = false;
+        } else if (!nf.pipeline ||
+                   (ppr.index_buffer_type == PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA &&
+                    uint64_t(ppr.guest_index_base) +
+                            uint64_t(ppr.host_draw_vertex_count) *
+                                (ppr.host_index_format == xenos::IndexFormat::kInt16 ? 2u : 4u) >
+                        uint64_t(SharedMemory::kBufferSize))) {
+          // codexNV15 D3/D6: null remembered pipeline or an index range past the shared memory -> full path.
+          ++nf.misses_other;
+          fast_ok = false;
+        }
+      }
+      if (fast_ok) {
+        // Vertex buffer residency (the one vertex fetch constant the shader uses).
+        const uint32_t vfi = nf.vfetch_index;
+        const uint64_t vbit = uint64_t(1) << (vfi & 63);
+        xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(vfi);
+        if (!(vertex_buffers_in_sync_[vfi >> 6] & vbit)) {
+          if (vf.type != xenos::FetchConstantType::kVertex) {
+            ++nf.misses_other;
+            fast_ok = false;
+          } else {
+            VertexBufferState& state = vertex_buffer_states_[vfi];
+            if (state.address != vf.address || state.size != vf.size) {
+              if (!shared_memory_->RequestRange(vf.address << 2, vf.size << 2)) {
+                return false;
+              }
+              state.address = vf.address;
+              state.size = vf.size;
+            }
+            vertex_buffers_in_sync_[vfi >> 6] |= vbit;
+          }
+        }
+        if (fast_ok && (NativeFastVerify() || (nexec_hit && g_nexec.verify))) {
+          fast_verify_armed = true;
+          if (nexec_hit) ++g_nexec.verify_armed;
+          NativeFastConstants& v = nf.verify_nc;
+          v = nf.nc_template;
+          std::memcpy(v.c, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * 4], sizeof(v.c));
+          v.p0[1] = uint32_t(ppr.host_shader_index_endian);
+          v.p0[2] = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+          v.p0[3] = ppr.line_loop_closing_index;
+          v.p1[0] = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+          v.p1[1] = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+          v.p1[2] = vf.address << 2;
+          v.p1[3] = uint32_t(vf.endian);
+          nf.verify_count = ppr.host_draw_vertex_count;
+          nf.verify_index_base = ppr.guest_index_base;
+          nf.verify_index_type = uint32_t(ppr.index_buffer_type);
+          nf.verify_pending = true;
+          fast_ok = false;  // the full path draws; compared in its native block
+        }
+        if (fast_ok && gpu_timer_enabled_ && GpuDrawSplitOn()) {
+          GpuTimerSwitch(0xC0 + 16);  // gpu_timing_draws: native fast / fused depth draws
+          ++g_gds.draws[16];
+          g_gds.indices[16] += ppr.host_draw_vertex_count;
+        }
+        if (fast_ok && nf.fused_pipeline && g_pfuse.init_ok && !g_native_view.tap && PrepassFuseOn()) {
+          // Pre-pass fusion (see PrepassFuseState).
+          PrepassFuseState& pf = g_pfuse;
+          const bool idx32 = ppr.host_index_format != xenos::IndexFormat::kInt16;
+          if (nf.topology != uint32_t(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST) &&
+              nf.topology != uint32_t(D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP)) {
+            ++pf.inel_ib;  // padding by a repeated index is exact only for triangles (codexNV16)
+          } else if (ppr.index_buffer_type != PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA) {
+            ++pf.inel_ib;
+          } else if (ppr.host_primitive_reset_enabled) {
+            ++pf.inel_reset;
+          } else if (ppr.guest_index_base & (idx32 ? 3u : 1u)) {
+            ++pf.inel_align;
+          } else {
+            PrepassFuseDraw rec;
+            rec.nc = nf.nc_template;
+            std::memcpy(rec.nc.c, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * 4], sizeof(rec.nc.c));
+            rec.nc.p0[1] = uint32_t(ppr.host_shader_index_endian);
+            rec.nc.p0[2] = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+            rec.nc.p0[3] = ppr.line_loop_closing_index;
+            rec.nc.p1[0] = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+            rec.nc.p1[1] = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+            rec.nc.p1[2] = vf.address << 2;
+            rec.nc.p1[3] = uint32_t(vf.endian);
+            const uint32_t count = ppr.host_draw_vertex_count;
+            rec.p3[0] = ppr.guest_index_base;
+            rec.p3[1] = count;
+            // v6: strips are concatenated as lists too (see PrepassFuseState::strip_mode).
+            const bool strip_list = nf.topology == uint32_t(D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP) && pf.strip_mode != 0;
+            rec.p3[2] = (idx32 ? 1u : 0u) | (strip_list ? (pf.strip_mode == 2 ? 6u : 2u) : 0u);
+            rec.p3[3] = 0;
+            const uint32_t fused_topology =
+                strip_list ? uint32_t(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST) : nf.topology;
+            // The remembered draw's command list state, with the fused pipeline / root signature (the
+            // tracked setters record nothing when unchanged).
+            if (current_external_pipeline_ != nf.fused_pipeline) {
+              SetExternalPipeline(const_cast<ID3D12PipelineState*>(
+                  static_cast<const ID3D12PipelineState*>(nf.fused_pipeline)));
+            }
+            SetExternalGraphicsRootSignature(pf.root_signature);
+            if (uint32_t(primitive_topology_) != fused_topology) {
+              SetPrimitiveTopology(D3D12_PRIMITIVE_TOPOLOGY(fused_topology));
+            }
+            if (std::memcmp(&ff_viewport_, &nf.viewport, sizeof(nf.viewport)) ||
+                std::memcmp(&ff_scissor_, &nf.scissor, sizeof(nf.scissor)) || ff_viewport_update_needed_ ||
+                ff_scissor_update_needed_) {
+              SetViewport(nf.viewport);
+              SetScissorRect(nf.scissor);
+            }
+            if (ff_stencil_ref_ != nf.stencil_ref || ff_stencil_ref_update_needed_) {
+              SetStencilReference(nf.stencil_ref);  // AGENT_NATIVE29A
+            }
+            shared_memory_->UseForReading();
+            SubmitBarriers();
+            // Triangle lists are concatenated into one non-instanced draw (the VS finds its draw by binary search
+            // over the start offsets; each draw rounded down to whole triangles, as the IA drops the rest): no
+            // padding, any sizes. Strips are instanced (padding by the repeated last index, ratio bound).
+            const bool concat = fused_topology == uint32_t(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            const uint32_t fused_count =
+                strip_list ? (count >= 3 ? 3 * (count - 2) : 0) : (concat ? count - count % 3 : count);
+            const bool verify_capture =
+                nf.verify_fused_pipeline && nf.verify_plain_pipeline && PrepassFuseVerifyOn();
+            bool append = fused_count != 0 && pf.open && pf.concat == concat &&
+                          pf.submission == submission_current_ && pf.frame == frame_current_ &&
+                          pf.pipeline == nf.fused_pipeline &&
+                          pf.end_size == deferred_command_list_.GetCommandStreamSize();
+            if (!fused_count) {
+              ++pf.empty;  // fewer than 3 list indices: the IA draws nothing either
+            } else if (!append) {
+              if (pf.open) ++pf.split_state;
+            } else if (pf.count >= pf.cap) {
+              append = false;
+              ++pf.split_cap;
+            } else if (!concat && std::max(pf.max_vertices, count) > 2 * std::min(pf.min_vertices, count)) {
+              append = false;  // instanced padding bound: at most 2x the shortest draw of the batch
+              ++pf.split_ratio;
+            }
+            if (!fused_count) {
+              // Nothing to record (the open batch, if any, stays open: nothing was recorded after it).
+            } else if (append) {
+              rec.p3[3] = concat ? pf.total_vertices : 0;
+              pf.records[pf.count++] = rec;
+              if (concat) {
+                pf.total_vertices += fused_count;
+                pf.header[0] = pf.total_vertices;
+                pf.header[1] = 1;
+              } else {
+                pf.min_vertices = std::min(pf.min_vertices, count);
+                pf.max_vertices = std::max(pf.max_vertices, count);
+                pf.header[0] = pf.max_vertices;
+                pf.header[1] = pf.count;
+              }
+              pf.header_p3[0] = pf.count;
+              pf.max_batch = std::max<uint64_t>(pf.max_batch, pf.count);
+              if (verify_capture && !g_pfv.cur.records.empty()) {
+                g_pfv.cur.records.push_back(rec);
+                g_pfv.cur.draw_vertices = pf.header[0];
+                g_pfv.cur.draw_instances = pf.header[1];
+              }
+            } else {
+              if (pf.open) {
+                pf.padded_vertices += pf.concat ? uint64_t(pf.total_vertices) : uint64_t(pf.max_vertices) * pf.count;
+              }
+              pf.open = false;
+              D3D12_GPU_VIRTUAL_ADDRESS table_gpu;
+              uint8_t* mem = constant_buffer_pool_->Request(
+                  frame_current_, sizeof(PrepassFuseDraw) * (1 + kPrepassFuseMaxCap), 256, nullptr, nullptr,
+                  &table_gpu);
+              if (!mem) {
+                return false;
+              }
+              pf.header = reinterpret_cast<uint32_t*>(mem);
+              pf.header_p3 = reinterpret_cast<uint32_t*>(mem + kPrepassFuseHeaderP3Offset);
+              pf.records = reinterpret_cast<PrepassFuseDraw*>(mem) + 1;
+              rec.p3[3] = 0;
+              pf.records[0] = rec;
+              pf.count = 1;
+              pf.concat = concat;
+              pf.total_vertices = fused_count;
+              pf.min_vertices = pf.max_vertices = count;
+              pf.header[0] = concat ? fused_count : count;
+              pf.header[1] = 1;
+              pf.header_p3[0] = 1;
+              pf.header_p3[1] = concat ? 1u : 0u;
+              pf.header_p3[2] = 0;
+              pf.header_p3[3] = 0;
+              {
+                // prepass_fuse_verify: keep the largest batch of the submission.
+                PrepassFuseVerifyState& v = g_pfv;
+                if (v.cur.records.size() > v.best.records.size()) std::swap(v.cur, v.best);
+                v.cur.records.clear();
+                if (verify_capture) {
+                  v.cur.records.push_back(rec);
+                  v.cur.fused_pipeline = nf.verify_fused_pipeline;
+                  v.cur.plain_pipeline = nf.verify_plain_pipeline;
+                  v.cur.table_gpu = table_gpu;
+                  v.cur.draw_vertices = pf.header[0];
+                  v.cur.draw_instances = 1;
+                  v.cur.topology = nf.topology;
+                  v.cur.fused_topology = fused_topology;
+                  v.cur.stencil_ref = nf.stencil_ref;
+                  v.cur.depth_format = nf.depth_format;
+                  v.cur.samples = nf.samples;
+                  v.cur.viewport = nf.viewport;
+                  v.cur.scissor = nf.scissor;
+                }
+              }
+              deferred_command_list_.D3DSetGraphicsRootShaderResourceView(0, shared_memory_->GetGPUAddress());
+              deferred_command_list_.D3DSetGraphicsRootShaderResourceView(1, table_gpu);
+              const uint64_t header_address = uint64_t(reinterpret_cast<uintptr_t>(pf.header));
+              deferred_command_list_.D3DDrawInstanced(0xFFFFFFFFu, 0, uint32_t(header_address),
+                                                      uint32_t(header_address >> 32));
+              pf.open = true;
+              pf.submission = submission_current_;
+              pf.frame = frame_current_;
+              pf.pipeline = nf.fused_pipeline;
+              pf.end_size = deferred_command_list_.GetCommandStreamSize();
+              ++pf.batches;
+              if (concat) ++pf.concat_batches;
+              pf.max_batch = std::max<uint64_t>(pf.max_batch, 1);
+            }
+            ++pf.draws;
+            if (strip_list && fused_count) ++pf.strip_draws;
+            pf.source_vertices += count;
+            ++nf.fast_draws;
+            ++stat_native_draws_;
+            if (rex::graphics::g_owned_run_executing) ++g_own_native_draws;  // AGENT_NATIVE30A2
+            ++ab_frame_native_;
+            ++ab_frame_depth_;
+            ++gpu_count_depth_draws_;
+            LARGE_INTEGER t1;
+            QueryPerformanceCounter(&t1);
+            nf.fast_ticks += uint64_t(t1.QuadPart - t0.QuadPart);
+            if (nexec_hit) {
+              ++g_nexec.exec_draws;
+              g_nexec.exec_ticks += uint64_t(t1.QuadPart - t0.QuadPart);
+            }
+            return true;
+          }
+        }
+        if (fast_ok) {
+          D3D12_GPU_VIRTUAL_ADDRESS cb_address;
+          auto* nc = reinterpret_cast<NativeFastConstants*>(constant_buffer_pool_->Request(
+              frame_current_, sizeof(NativeFastConstants),
+              D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, nullptr, nullptr, &cb_address));
+          if (!nc) {
+            return false;
+          }
+          *nc = nf.nc_template;
+          std::memcpy(nc->c, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * 4], sizeof(nc->c));
+          nc->p0[1] = uint32_t(ppr.host_shader_index_endian);
+          nc->p0[2] = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+          nc->p0[3] = ppr.line_loop_closing_index;
+          nc->p1[0] = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+          nc->p1[1] = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+          nc->p1[2] = vf.address << 2;
+          nc->p1[3] = uint32_t(vf.endian);
+          // Re-apply the command list state of the remembered draw.
+          if (current_external_pipeline_ != nf.pipeline) {
+            ++nf.heal[0];
+            SetExternalPipeline(const_cast<ID3D12PipelineState*>(
+                static_cast<const ID3D12PipelineState*>(nf.pipeline)));
+          }
+          if (current_graphics_root_signature_ != native_root_signature_) {
+            ++nf.heal[1];
+          }
+          SetExternalGraphicsRootSignature(native_root_signature_);
+          deferred_command_list_.D3DSetGraphicsRootShaderResourceView(1, shared_memory_->GetGPUAddress());
+          if (uint32_t(primitive_topology_) != nf.topology) {
+            ++nf.heal[2];
+            SetPrimitiveTopology(D3D12_PRIMITIVE_TOPOLOGY(nf.topology));
+          }
+          if (std::memcmp(&ff_viewport_, &nf.viewport, sizeof(nf.viewport)) ||
+              std::memcmp(&ff_scissor_, &nf.scissor, sizeof(nf.scissor)) || ff_viewport_update_needed_ ||
+              ff_scissor_update_needed_) {
+            ++nf.heal[3];
+            SetViewport(nf.viewport);
+            SetScissorRect(nf.scissor);
+          }
+          if (ff_stencil_ref_ != nf.stencil_ref || ff_stencil_ref_update_needed_) {
+            ++nf.heal[4];
+            SetStencilReference(nf.stencil_ref);  // AGENT_NATIVE29A: setter also honours a pending update
+          }
+          deferred_command_list_.D3DSetGraphicsRootConstantBufferView(0, cb_address);
