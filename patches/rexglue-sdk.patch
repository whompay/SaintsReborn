+// The online_players cvar (MULTIPLAYER > PLAYERS): this game first, then
+// everyone else on the virtual LAN (imposters left out).
+void PublishPlayers() {
+  auto line = [](const std::string& flags, const std::string& name, const std::string& where) {
+    std::string n, w;
+    for (char c : name) n += (c == '|' || c == '\n') ? ' ' : c;
+    for (char c : where) w += (c == '|' || c == '\n') ? ' ' : c;
+    return flags + "|" + n + "|" + w + "\n";
+  };
+  std::string text = "#ready\n";
+  std::string my_name = rex::cvar::GetFlagByName("xam_player_name");
+  if (my_name.empty()) {
+    const char* env = std::getenv("USERNAME");
+    my_name = env && *env ? env : "Player";
+  }
+  std::string my_where = rex::cvar::GetFlagByName("online_session");
+  if (my_where.empty()) my_where = rex::cvar::GetFlagByName("online_activity");
+  text += line(std::string("s") + (rex::system::online::Modded() ? "m" : "") + (my_proof.empty() ? "" : "o"),
+               rex::system::online::SafeName(my_name), my_where);
+  std::vector<std::string> others;
+  for (EOS_ProductUserId m : members) {
+    auto it = peers.find(m);
+    if (it == peers.end() || it->second.imposter || it->second.name.empty()) continue;
+    const PeerInfo& pi = it->second;
+    others.push_back(line(std::string(pi.modded ? "m" : "") + (pi.owner ? "o" : ""), pi.name, pi.where));
+  }
+  std::sort(others.begin(), others.end(), [](const std::string& a, const std::string& b) {
+    return _stricmp(a.substr(a.find('|')).c_str(), b.substr(b.find('|')).c_str()) < 0;
+  });
+  for (const auto& o : others) text += o;
+  if (text != last_players) {
+    last_players = text;
+    rex::cvar::SetFlagByName("online_players", text);
+  }
+}
