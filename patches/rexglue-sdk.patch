+            const uint32_t ptr = GpuToCpu(CpuToGpu(rex::byte_swap(dwords[i + 1])));
+            const uint32_t length = rex::byte_swap(dwords[i + 2]) & 0xFFFFFu;
+            const uint64_t key = IbKey(ptr, length);
+            if (length && total + length * 4u < (64u << 20) && !snapshots->count(key)) {
+              const uint32_t* src = SelectGuestDataSource(ptr, length);
+              std::shared_ptr<uint32_t> copy = StreamBufferPool::Acquire(length + 1u);
+              std::memcpy(copy.get(), src, length * sizeof(uint32_t));
+              copy.get()[length] = 0;
+              total += length * 4u;
