+    float amp = sqrt(saturate(min(mn.g, 1.0 - mx.g) / max(mx.g, 1e-4)));
+    float wgt = amp * (-1.0 / lerp(8.0, 4.5, saturate(sharpen)));
+    c = saturate((c + (n + s + e + w) * wgt) * (1.0 / (1.0 + 4.0 * wgt)));
+  }
+  float3 lin = ToLinear(c);
+  // This frame's sky pixels (unsharpened, before any change) -> 1/8 res sky
+  // sums for the next frame's sky average.
+  if (flags & 16384u) g_sk[gi] = (inside && is_sky) ? float4(lin, 1.0) : 0.0.xxxx;
+  float yf = (float(p.y) + 0.5) * inv_size.y;
+  float2 uv = (float2(p) + 0.5) * inv_size;
+
+  // Sky colour reference (smoothed): scales the configured gradient so night
+  // skies stay dark; no sky seen yet -> no sky / void / haze changes.
+  float4 sky_avg = float4(t4.Load(int3(0, 0, 0)).r, t4.Load(int3(1, 0, 0)).r,
+                          t4.Load(int3(2, 0, 0)).r, t4.Load(int3(3, 0, 0)).r);
