+    if (msaa_rt_desc.SampleDesc.Count != 4 || msaa_x0 + msaa_host_width > msaa_rt_desc.Width ||
+        msaa_y0 + msaa_host_height > msaa_rt_desc.Height) {
+      return skip("0E93C000 outside render target");
+    }
+    const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+    ID3D12Device* device = provider.GetDevice();
+    if (!DirectMsaaEnsure(device, provider)) return skip("0E93C000 no shader");
