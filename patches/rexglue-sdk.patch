+  }
+  if (flags & (2u | 8192u)) {
+    // Blurred 1/8 res bloom + luma (previous frame), one bilinear sample.
+    uint2 bs;
+    t3.GetDimensions(bs.x, bs.y);
+    float4 bl = t3.SampleLevel(s0, (float2(p) + 0.5) / (8.0 * float2(bs)), 0.0);
+    if ((flags & 8192u) && z > 0.0) {
+      // Clarity: local contrast against the surrounding (blurred) brightness.
+      float ratio = clamp((Luma(lin) + 0.01) / (bl.a + 0.01), 0.5, 2.0);
+      lin *= exp2(clarity * log2(ratio));
