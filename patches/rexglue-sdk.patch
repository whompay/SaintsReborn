+static uint32_t M3MarkerHook(uint32_t id, uint32_t header, memory::RingBuffer* reader, uint32_t body_words,
+                             uint32_t* out, uint32_t max_words);
+
+static uint32_t M3Mode() {
+  const uint64_t now = GetTickCount64();
+  uint64_t next = g_m3.next_poll.load(std::memory_order_relaxed);
+  if (now >= next && g_m3.next_poll.compare_exchange_strong(next, now + 1000, std::memory_order_relaxed)) {
+    auto exists = [](const char* n) {
+      if (FILE* f = RexFlagFopen(n)) {
+        std::fclose(f);
+        return true;
+      }
+      return false;
+    };
+    uint32_t mode = 0;
+    if (!exists("native_m3.off")) {
+      if (exists("native_m3_replace")) {
+        mode = 2;
+      } else if (exists("native_m3_shadow")) {
+        mode = 1;
