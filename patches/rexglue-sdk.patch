+// Network calls logged at info level (first few of each), to follow what the
+// game's system link / multiplayer code does.
+static bool NetLogOnce(const char* what, int limit = 12) {
+  static std::mutex m;
+  static std::unordered_map<std::string, int> counts;
+  std::lock_guard<std::mutex> lock(m);
+  return counts[what]++ < limit;
+}
+// The guest call chain of the current import call (return address, then the
+// saved return addresses up the stack), to tell the game's callers apart.
+static std::string GuestChain() {
+  auto* ts = rex::runtime::ThreadState::Get();
+  if (!ts || !ts->context()) return "?";
+  auto* ctx = ts->context();
+  std::string out = fmt::format("{:08X}", uint32_t(ctx->lr));
+  auto* mem = REX_KERNEL_MEMORY();
+  auto rd = [&](uint32_t a) -> uint32_t {
+    const uint8_t* p = mem->TranslateVirtual<const uint8_t*>(a);
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+  };
+  uint32_t sp = ctx->r1.u32;
+  for (int i = 0; i < 6; ++i) {
+    if (sp < 0x10000 || (sp & 3)) break;
+    const uint32_t back = rd(sp);
+    if (back <= sp || back - sp > 0x40000) break;
+    out += fmt::format("<{:08X}", rd(back - 8));
+    sp = back;
+  }
+  return out;
+}
+// Logs a call site (key + call chain) the first time it is seen (at most
+// `limit` different sites per key).
+static bool NetLogSite(const char* key, const std::string& chain, int limit = 24) {
+  static std::mutex m;
+  static std::unordered_map<std::string, int> per_key;
+  static std::unordered_map<std::string, bool> seen;
+  std::lock_guard<std::mutex> lock(m);
+  const std::string k = std::string(key) + "|" + chain;
+  if (seen.count(k)) return false;
+  if (per_key[key] >= limit) return false;
+  per_key[key]++;
+  seen[k] = true;
+  return true;
+}
+static uint16_t g_system_link_port = 0;
