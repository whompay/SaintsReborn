+  D3D12_CPU_DESCRIPTOR_HANDLE color_srv;      // non-shader-visible SRV
+  ID3D12Resource* depth;                      // host depth render target (may be null)
+  D3D12_CPU_DESCRIPTOR_HANDLE depth_srv;      // non-shader-visible depth SRV
+  uint32_t x, y, width, height;               // region in host pixels (scaled)
+  uint32_t scale;                             // draw resolution scale (1, 2, 3)
