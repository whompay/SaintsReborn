+      msaa_bad = "0E93C000 sig dest offset";
+    } else if (msaa_dest_coords.pitch_aligned_div_32 != 20) {
+      msaa_bad = "0E93C000 sig dest pitch";
+    } else if (resolve_info.IsClearingColor() || resolve_info.IsClearingDepth()) {
