index 0000000..7cfbe5a
--- /dev/null
+++ b/src/graphics/d3d12/native_frame_bridge_verify.inc
@@ -0,0 +1,2491 @@
+// Native-frame engine bridge, verification only (included by d3d12/command_processor.cpp inside
+// namespace rex::graphics::d3d12). Accepting or matching a record never changes, skips or replaces the
+// emulated draw.
+//
+// v2 (AGENT_FRAME 2026-10-23, replaces the v1 block of AGENT_GAME_FIX / AGENT_GPU_FIX):
+// * The game submits one record per actual draw packet of every hooked engine draw writer (825D2478,
+//   825D1680, 825D1B78, 825D2070, 825D15D0, 825D7620, resolve 825D8490, clear 825E49C0), keyed by the
+//   guest address just past the DRAW_INDX / DRAW_INDX_2 packet in its command buffer.
+//   CommandProcessor::ExecutePacketType3Draw publishes the same address (g_native_bridge_packet_end) for
+//   the packet it executes, so every CP draw maps to exactly one record: no state search, no
+//   ambiguity. v1 matched pass-8 records by state inside (primitive, count) buckets; the bench br4
+//   steady state had 367 main-colour CP draws per frame without a record (= thread A HUD / sprites /
+//   mesh passes 0, 3, 10 / 82249C3C / thread B 8251Bxxx sky, which the game did not record because
+//   only pass 8 was in scope) and 664 "ambiguous" matches per frame (the same mesh in consecutive frames,
+//   because the CP trails the engine by about a frame).
+// * Each matched record is then checked field by field against the register file at IssueDraw:
+//   primitive, count, index buffer (+start), base vertex, shaders, render-target state, the float
+//   constants the translated VS / PS actually read (per group of 4) and the fetch constants they use
+//   (texture slots + vertex fetches). That is the per-draw data an engine-fed executor (M3) needs.
+// * All draws are verified (main colour pass, depth pre-pass, copies, other), reported per class.
+// Cost when dist\native_bridge_verify is absent: the cached gate check per draw / shader load.
+// The v1 export still works (records without a packet address are counted, not matched).
+
+struct NativeBridgeRecord {
+  RexNativeDrawRecordV2 r;
+  // Record v3 (RexNativeRendererSubmitDrawRecordV3): float-constant values of the groups in vmask (VS groups
+  // ascending, then PS groups ascending, 16 words each). Empty for v2 records.
+  uint64_t vmask[2] = {};
+  uint32_t mask_generation = 0;
+  uint32_t draw_header = 0;  // v3: type-3 header of the DRAW packet the record stands for (0 = unknown)
+  std::vector<uint32_t> values;
+  // Record v4 (AGENT_NATIVE29A session 29, 'capture v4-full'): ext fields, checked at IssueDraw by NativeBridgeCheckV4.
+  bool v4 = false;
+  uint32_t fetch_units[3] = {};
+  std::vector<uint32_t> fetch_values;  // 2 words per unit of fetch_units, ascending
+  std::vector<uint32_t> state_values;  // 64 words with REG_VALUES, else empty
+  uint32_t draw_packet_words = 0;
+  uint32_t draw_packet[8] = {};
+};
+
+// Values of float-constant group g (16 words) of stage 0 (VS) / 1 (PS) in a v3 record, nullptr if absent.
+static inline const uint32_t* NativeBridgeRecordGroup(const uint64_t* vmask, const std::vector<uint32_t>& values,
+                                                      uint32_t stage, uint32_t g) {
+  if (!((vmask[stage] >> g) & 1)) return nullptr;
+  const uint32_t before = (stage ? uint32_t(std::popcount(vmask[0])) : 0u) +
+                          uint32_t(std::popcount(vmask[stage] & ((uint64_t(1) << g) - 1)));
+  const size_t off = size_t(before) * 16;
+  return off + 16 <= values.size() ? values.data() + off : nullptr;
+}
+
+enum NativeBridgeClass : uint32_t { kNbMain = 0, kNbPrepass, kNbCopy, kNbOther, kNbClassCount };
+enum NativeBridgeField : uint32_t {
+  kNbFPrim = 0, kNbFCount, kNbFIb, kNbFBase, kNbFShader, kNbFRt, kNbFVsConst, kNbFPsConst, kNbFFetch,
+  kNbFState, kNbFieldCount
+};
+static const char* const kNbClassName[kNbClassCount] = {"main", "prepass", "copy", "other"};
+static const char* const kNbFieldName[kNbFieldCount] = {"prim", "count", "ib",  "base", "shader",
+                                                        "rt",   "vsc",   "psc", "fetch", "state"};
+
+struct NativeBridgeWindow {  // counters of the current 10 s log window
+  uint64_t submitted = 0, submitted_no_packet = 0, v1_records = 0;
+  uint64_t submitted_path[REX_NATIVE_PATH_COUNT] = {};
+  uint64_t cp_draws[kNbClassCount] = {}, matched[kNbClassCount] = {}, no_key[kNbClassCount] = {},
+           no_record[kNbClassCount] = {};
+  uint64_t matched_path[REX_NATIVE_PATH_COUNT] = {};
+  uint64_t stale_path[REX_NATIVE_PATH_COUNT] = {};
+  uint64_t addr_reuse = 0, addr_offset_hits[3] = {};
+  uint64_t field_mismatch[kNbFieldCount] = {};
+  uint64_t exact = 0;  // matched with every checked field equal
+  uint64_t vs_groups = 0, ps_groups = 0, fetch_units = 0, vs_groups_bad = 0, ps_groups_bad = 0,
+           fetch_units_bad = 0;
+  uint64_t bad_size = 0, bad_version = 0, bad_flags = 0, dropped_full = 0;
+  // M3 diagnostics (matched main-class draws): per float-constant group of 4, checked / mismatched.
+  uint32_t vs_g_checked[64] = {}, vs_g_bad[64] = {}, ps_g_checked[64] = {}, ps_g_bad[64] = {};
+  uint64_t main_matched_state = 0, main_const_only_bad = 0;
+  // M3 render state (records with REX_NATIVE_DRAW_FLAG_STREAM_STATE): checked / bad, known registers summed.
+  uint64_t state_checked = 0, state_bad = 0, state_known_regs = 0, state_full = 0, main_exact_all = 0,
+           main_with_state = 0;
+  std::string examples_unmatched, examples_field, examples_stale;
+  uint32_t n_unmatched = 0, n_field = 0, n_stale = 0;
+  // Expected (CP register file) vs recorded examples per mismatch class (rt / vsc / psc / fetch / state).
+  std::vector<std::string> ex[kNbFieldCount];
+  // Record v3 intake.
+  uint64_t v3_records = 0, v3_with_values = 0, v3_value_words = 0, v3_bad = 0, v3_hash_bad_groups = 0,
+           v3_stale_masks = 0, v3_no_values = 0, v3_dropped_bytes = 0;
+  uint64_t v3_batches = 0, v3_batch_records = 0;  // EXEC8 x8c batch intake
+  // Record v4 intake + per-field verify (AGENT_NATIVE29A session 29), per class kNbMain..kNbOther.
+  uint64_t v4_batches = 0, v4_records = 0, v4_bad = 0, v4_reg_values = 0, v4_self = 0;
+  uint64_t v4_checked[4] = {}, v4_exact[4] = {}, v4_self_checked[4] = {}, v4_self_exact[4] = {};
+  uint64_t v4_state_checked = 0, v4_state_bad_draws = 0, v4_state_bad_regs = 0, v4_fetch_units = 0,
+           v4_fetch_units_bad = 0, v4_fetch_missing = 0, v4_const_missing = 0, v4_self_incomplete = 0,
+           v4_draw_packet_bad = 0;
+  uint32_t v4_reg_bad[64] = {};
+  std::string v4_examples;
+  uint32_t v4_n_examples = 0;
+  // v3 draw_header vs the DRAW packet header the CP executed (matched records with draw_header != 0).
+  uint64_t hdr_checked = 0, hdr_bad = 0, hdr_pred_bad = 0;
+  // NATIVE7 dry mode (g_nb_dry).
+  uint64_t dry_taken = 0, dry_with_values = 0, dry_full_state = 0, dry_hdr_bad = 0, dry_masks_published = 0;
+  std::string hdr_examples;
+  uint32_t n_hdr_examples = 0;
+};
+
+// M3b (verification only, dist\native_frame_exec_verify): marker records (RexNativeRendererSubmitOwnedDrawRecordV3) and
+// the CP NOP markers that name them. Nothing is drawn natively yet: at a marker the record is looked up by id and its
+// draw entry probed (M3a L2); the record is then checked against the original draw that follows it in the stream.
+struct NativeMarkerRecord {
+  NativeBridgeRecord rec;
+  uint64_t submit_swap = 0, last_exec_swap = 0;
+  uint32_t execs = 0;
+};
+struct NativeMarkerWindow {
+  uint64_t submitted = 0, owned_refused = 0, refused_novalues = 0, refused_stale = 0, refused_state = 0,
+           refused_header = 0, refused_full = 0, refused_bad = 0;
+  uint64_t markers = 0, id_hit = 0, id_miss = 0, replays = 0, pred_bad = 0, marker_no_draw = 0, draws_after = 0,
+           back_checked = 0, back_other_draw = 0, back_no_draw = 0,
+           exact = 0, entry_ready = 0, entry_missing = 0, entry_same = 0, entry_other = 0, retired = 0, expired = 0;
+  uint64_t field_bad[kNbFieldCount] = {};
+  std::string examples;
+  uint32_t n_examples = 0;
+};
+
+struct NativeBridgeState {
+  std::mutex mutex;
+  // key = physical address just past the draw packet
+  std::unordered_map<uint32_t, std::vector<NativeBridgeRecord>> pending;
+  size_t pending_count = 0;
+  size_t pending_value_bytes = 0;  // v3 values held in pending (budget kNativeBridgeMaxValueBytes)
+  // M3b marker records by id (verify only).
+  std::unordered_map<uint32_t, NativeMarkerRecord> markers;
+  size_t marker_value_bytes = 0;
+  uint32_t next_marker_id = 1;
+  uint64_t cp_swaps = 0;
+  NativeMarkerWindow mw;
+  std::atomic<bool> enabled{false};
+  std::atomic<uint64_t> next_enable_poll{0};
+  uint64_t newest_frame = 0;
+  uint64_t last_log_tick = 0;
+  NativeBridgeWindow w;
+};
+static NativeBridgeState g_native_bridge;
+static inline uint32_t NativeBridgePhys(uint32_t address) { return address & 0x1FFFFFFFu; }
+// Engine-side (CPU virtual) address -> GPU physical, the way the game converts its own command buffer,
+// index buffer and DMA addresses (825D2478: 0xE0000000-range pages carry +0x1000).
+static inline uint32_t NativeBridgeGpu(uint32_t address) {
+  return (address & 0x1FFFFFFFu) + (address >= 0xE0000000u ? 0x1000u : 0u);
+}
+static std::unordered_map<const Shader*, uint32_t> g_native_bridge_shader_guest;
+static constexpr size_t kNativeBridgeMaxPending = 65536;
+static constexpr size_t kNativeBridgeMaxValueBytes = size_t(64) << 20;
+static constexpr size_t kNativeMarkerMaxRecords = 16384;
+
+// M3a "would execute natively" verify (native_frame_exec_verify.inc): on while dist\native_frame_exec_verify
+// AND dist\native_bridge_verify exist. g_m3a_cur = the current CP draw's matched record (CP thread only).
+static std::atomic<bool> g_m3a_on{false};
+// NATIVE7 s2 (M3b step 1 = Codex codex7_m3b_exec step 1+2): dist\native_frame_exec_dry WITHOUT native_bridge_verify = the
+// production-like record path. Records are taken by packet address at IssueDraw (oldest first, as in verify) and only
+// counted; constant masks are published from the active shaders (the game then sends v3 values, as an executor would
+// need); nothing is compared, nothing is drawn natively. Measures what the record path itself costs. Default off.
+static std::atomic<bool> g_nb_dry{false};
+struct NbDryMask {
+  const Shader* vs = nullptr;
+  const Shader* ps = nullptr;
+  uint64_t vsm = 0, psm = 0;
+  uint32_t fu[3] = {};  // AGENT_NATIVE30A: used fetch units (vertex fetches + 3 units per texture fetch constant)
+  bool published = false;
+};
+static std::unordered_map<uint64_t, NbDryMask> g_nb_dry_masks;  // CP thread, bridge mutex
+struct NativeBridgeM3aCur {
+  bool active = false;   // M3a on for this IssueDraw
+  bool matched = false;  // r valid
+  bool done = false;     // compared at the vertex-buffer stage
+  uint32_t stage = 0;    // IssueDraw progress (see M3aFinish)
+  uint32_t cls = 0;
+  uint32_t bad = 0;      // NativeBridgeCheck mismatch mask
+  uint32_t outcome = 0;  // 0 no key, 1 no record, 2 matched
+  uint32_t ib_depth = 0; // INDIRECT_BUFFER nesting depth of the draw packet
+  uint32_t hdr_state = 0; // EXEC8 x8d: record draw_header 0 = equals the executed DRAW header, 1 missing, 2 differs
+  RexNativeDrawRecordV2 r;
+  bool has_values = false;  // record v3 with float-constant values
+  uint64_t vmask[2] = {};
+  std::vector<uint32_t> values;
+};
+static NativeBridgeM3aCur g_m3a_cur;
+// Record v3: the values are complete for the record's group masks (REX_NATIVE_DRAW_FLAG_CONST_VALUES).
+static constexpr uint32_t kNbFlagConstValues = REX_NATIVE_DRAW_FLAG_CONST_VALUES;
+// M3b marker of the current CP draw (CP thread only): set by the marker NOP, consumed by the next IssueDraw.
+struct NativeMarkerPending {
+  bool active = false;
+  uint32_t id = 0, header = 0;
+  NativeBridgeRecord rec;
+  bool entry_found = false;   // M3a L2 draw entry existed for the record at the marker
+  uint64_t entry_hash = 0;
+  bool compare_entry = false; // set for the draw that follows: M3aCompare compares its entry hash
+};
+static NativeMarkerPending g_m3b;
+// NATIVE7 s1: the last CP draw seen by NativeBridgeVerifyDraw (CP thread, bridge mutex). VERIFY_ONLY markers are
+// APPENDED after the writer call's packets (game frame6e) and refer BACK to this draw: at the marker the record is
+// checked against it (register file unchanged since: only bin-mask / event packets follow the DRAW).
+struct NativeBridgeLastDraw {
+  bool valid = false;
+  uint32_t packet_end = 0, header = 0;
+  xenos::PrimitiveType prim{};
+  uint32_t index_count = 0, ib_base = 0, index_size = 0;
+  bool has_ib = false;
+  const Shader* vs = nullptr;
+  const Shader* ps = nullptr;
+  bool entry_valid = false;  // M3a L2 entry hash of this draw's record (set by M3aCompare)
+  uint64_t entry_hash = 0;
+};
+static NativeBridgeLastDraw g_nb_last;
+
+// Used float-constant group masks per (record VS address, record PS address, vertex declaration), published by
+// the CP thread (M3a, single writer) under a per-slot seqlock and read lock-free by the game
+// (RexNativeRendererGetConstantMasks) to decide which groups' values a v3 record carries. Masks only grow.
+struct NativeBridgeMaskSlot {
+  std::atomic<uint32_t> seq{0};
+  std::atomic<uint32_t> vs{0}, ps{0}, decl{0}, gen{0};
+  std::atomic<uint64_t> vsm{0}, psm{0};
+  std::atomic<uint32_t> fu[3];  // AGENT_NATIVE30A (static storage = zero): used fetch units, published for RexNativeRendererGetDrawMasksV2
+};
+static constexpr uint32_t kNbMaskSlots = 4096, kNbMaskProbe = 32;
+static NativeBridgeMaskSlot g_nb_masks[kNbMaskSlots];
+static std::atomic<uint32_t> g_nb_mask_gen{0};
+static std::atomic<uint64_t> g_nb_mask_published{0}, g_nb_mask_full{0}, g_nb_mask_queries{0},
+    g_nb_mask_hits{0};
+static inline uint32_t NativeBridgeMaskHash(uint32_t vs, uint32_t ps, uint32_t decl) {
+  uint64_t h = (uint64_t(vs) << 32 | ps) ^ (uint64_t(decl) * 0x9E3779B97F4A7C15ull);
+  h ^= h >> 29;
+  h *= 0xBF58476D1CE4E5B9ull;
+  h ^= h >> 32;
+  return uint32_t(h) & (kNbMaskSlots - 1);
+}
+// CP thread only. vs / ps already physical (& 0x1FFFFFFF), decl as in the record.
+static void NativeBridgePublishMasks(uint32_t vs, uint32_t ps, uint32_t decl, uint64_t vsm, uint64_t psm,
+                                     const uint32_t* fu = nullptr) {
+  uint32_t i = NativeBridgeMaskHash(vs, ps, decl);
+  for (uint32_t probe = 0; probe < kNbMaskProbe; ++probe, i = (i + 1) & (kNbMaskSlots - 1)) {
+    NativeBridgeMaskSlot& sl = g_nb_masks[i];
+    const bool used = sl.gen.load(std::memory_order_relaxed) != 0;
+    if (used && (sl.vs.load(std::memory_order_relaxed) != vs || sl.ps.load(std::memory_order_relaxed) != ps ||
+                 sl.decl.load(std::memory_order_relaxed) != decl)) {
+      continue;
+    }
+    const uint64_t ov = used ? sl.vsm.load(std::memory_order_relaxed) : 0;
+    const uint64_t op = used ? sl.psm.load(std::memory_order_relaxed) : 0;
+    uint32_t of[3] = {}, nf[3] = {};
+    bool fu_same = true;
+    for (uint32_t k = 0; k < 3; ++k) {
+      of[k] = used ? sl.fu[k].load(std::memory_order_relaxed) : 0;
+      nf[k] = of[k] | (fu ? fu[k] : 0u);
+      fu_same = fu_same && nf[k] == of[k];
+    }
+    if (used && (ov | vsm) == ov && (op | psm) == op && fu_same) return;
+    const uint32_t q = sl.seq.load(std::memory_order_relaxed);
+    sl.seq.store(q + 1, std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_release);
+    sl.vs.store(vs, std::memory_order_relaxed);
+    sl.ps.store(ps, std::memory_order_relaxed);
+    sl.decl.store(decl, std::memory_order_relaxed);
+    sl.vsm.store(ov | vsm, std::memory_order_relaxed);
+    sl.psm.store(op | psm, std::memory_order_relaxed);
+    for (uint32_t k = 0; k < 3; ++k) sl.fu[k].store(nf[k], std::memory_order_relaxed);
+    sl.gen.store(g_nb_mask_gen.fetch_add(1, std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+    sl.seq.store(q + 2, std::memory_order_release);
+    g_nb_mask_published.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  g_nb_mask_full.fetch_add(1, std::memory_order_relaxed);
+}
+// Any thread. 1 = published (out_masks[0] VS, [1] PS), 0 = not (yet) published.
+static int NativeBridgeGetMasks(uint32_t vs, uint32_t ps, uint32_t decl, uint64_t* out_masks,
+                                uint32_t* out_generation, uint32_t* out_fetch_units = nullptr) {
+  if (!out_masks) return -1;
+  g_nb_mask_queries.fetch_add(1, std::memory_order_relaxed);
+  vs = NativeBridgePhys(vs);
+  ps = NativeBridgePhys(ps);
+  uint32_t i = NativeBridgeMaskHash(vs, ps, decl);
+  for (uint32_t probe = 0; probe < kNbMaskProbe; ++probe, i = (i + 1) & (kNbMaskSlots - 1)) {
+    const NativeBridgeMaskSlot& sl = g_nb_masks[i];
+    bool stable = false, match = false, empty = false;
+    uint64_t vm = 0, pm = 0;
+    uint32_t gen = 0, fu[3] = {};
+    for (int tries = 0; tries < 16 && !stable; ++tries) {
+      const uint32_t q0 = sl.seq.load(std::memory_order_acquire);
+      if (q0 & 1) continue;
+      gen = sl.gen.load(std::memory_order_relaxed);
+      const uint32_t a = sl.vs.load(std::memory_order_relaxed), b = sl.ps.load(std::memory_order_relaxed),
+                     d = sl.decl.load(std::memory_order_relaxed);
+      vm = sl.vsm.load(std::memory_order_relaxed);
+      pm = sl.psm.load(std::memory_order_relaxed);
+      for (uint32_t k = 0; k < 3; ++k) fu[k] = sl.fu[k].load(std::memory_order_relaxed);
+      std::atomic_thread_fence(std::memory_order_acquire);
+      if (sl.seq.load(std::memory_order_relaxed) != q0) continue;
+      stable = true;
+      empty = gen == 0;
+      match = !empty && a == vs && b == ps && d == decl;
+    }
+    if (!stable || empty) return 0;
+    if (match) {
+      out_masks[0] = vm;
+      out_masks[1] = pm;
+      if (out_generation) *out_generation = gen;
+      if (out_fetch_units) std::memcpy(out_fetch_units, fu, sizeof(fu));
+      g_nb_mask_hits.fetch_add(1, std::memory_order_relaxed);
+      return 1;
+    }
+  }
+  return 0;
+}
+
+// Mismatch examples: the register file of the previous CP draw, so an example can say whether the record holds
+// the previous draw's value ("=prev"); one draw later the next draw's values are checked too ("next").
+static constexpr uint32_t kNbExamplesPerField = 3;
+struct NativeBridgeSnap {
+  bool valid = false;
+  uint32_t c[512 * 4];
+  uint32_t f[96 * 2];
+  uint32_t st[REX_NATIVE_STATE_REG_COUNT];
+  uint32_t rt[4];
+};
+static NativeBridgeSnap g_nb_prev;
+struct NativeBridgeNextCheck {
+  uint32_t field = 0, example = 0;
+  uint32_t first_reg = 0, words = 0, rec_hash = 0;  // const group / fetch unit
+  uint64_t known = 0;                               // state: known registers; rt: differing registers
+  uint32_t cur[REX_NATIVE_STATE_REG_COUNT] = {};    // state: this draw's values; rt: recorded values
+};
+static std::vector<NativeBridgeNextCheck> g_nb_next;
+static const uint32_t kNbRtRegs[4] = {XE_GPU_REG_RB_SURFACE_INFO, XE_GPU_REG_RB_COLOR_MASK,
+                                      XE_GPU_REG_RB_DEPTHCONTROL, XE_GPU_REG_RB_MODECONTROL};
+static const char* const kNbRtName[4] = {"surf", "cmask", "depth", "mode"};
+// Examples (and the per-draw register snapshot / packet trace they need) are on with the verify switches unless
+// dist\native_bridge_examples.off exists (to measure their cost).
+static std::atomic<bool> g_nb_examples_on{true};
+
+// Register-write attribution (CP thread, via rex::graphics::g_native_packet_hook after every packet while examples
+// are wanted): for the 64 render-state registers the last two values and the packet that wrote each.
+struct NativeBridgeRegWrite {
+  uint32_t value = 0, header = 0, address = 0, depth = 0;
+  bool valid = false;
+};
+struct NativeBridgeRegTrace {
+  bool valid = false;
+  uint32_t shadow[REX_NATIVE_STATE_REG_COUNT] = {};
+  NativeBridgeRegWrite last[REX_NATIVE_STATE_REG_COUNT], before[REX_NATIVE_STATE_REG_COUNT];
+  uint64_t packets = 0;
+};
+static NativeBridgeRegTrace g_nb_trace;
+static const RegisterFile* g_nb_trace_regs = nullptr;  // the CP's register file (set by NativeBridgeVerifyDraw)
+static void NativePacketHook(uint32_t header, uint32_t address, uint32_t depth) {
+  static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+  const RegisterFile* rf = g_nb_trace_regs;
+  if (!rf) return;
+  NativeBridgeRegTrace& t = g_nb_trace;
+  ++t.packets;
+  if (!t.valid) {
+    for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) t.shadow[i] = (*rf)[kRegs[i]];
+    t.valid = true;
+    return;
+  }
+  for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+    const uint32_t v = (*rf)[kRegs[i]];
+    if (v == t.shadow[i]) continue;
+    t.before[i] = t.last[i];
+    t.last[i] = {v, header, address, depth, true};
+    t.shadow[i] = v;
+  }
+}
+static std::string NativeBridgeWriterText(const NativeBridgeRegWrite& wr) {
+  if (!wr.valid) return std::string("?");
+  const uint32_t type = wr.header >> 30;
+  const std::string what = type == 0   ? fmt::format("t0 {:04X}", wr.header & 0x7FFF)
+                           : type == 3 ? fmt::format("t3 op {:02X}{}", (wr.header >> 8) & 0x7F, wr.header & 1 ? " pred" : "")
+                                       : fmt::format("t{}", type);
+  return fmt::format("{:08X} by {} @{:08X} d{}", wr.value, what, wr.address, wr.depth);
+}
+
+static void NativeMarkerHook(uint32_t id, uint32_t packet_header);
+// =====================================================================================================================
+// AGENT_NATIVE30A2 (session 30) EXECUTOR STEP 2 = OWNED RUNS (record-driven execution, the run's emulated packets are gone).
+// Contract: 29A 18:30 proposal + 29B/30B exe side (project/src native_capture_full.inc 'STEP 2'): the exe submits a run's
+// records in ONE RexNativeRendererSubmitDrawRecordsV4Batch call (all v4, OWNED | REG_VALUES | SELF_SUFFICIENT, v2.reserved0 =
+// run_id with bit 31, v2.sequence = index) and rewrites the run's PM4 region as NOP {'NRN4', run_id, n} + coalesced restore
+// ONLY when the call returned n. At the marker the generic CP (command_processor.cpp ExecutePacketType3_NOP) asks
+// NativeOwnRunHook for the steps and executes them (register diffs, record shaders, DRAW packet -> IssueDraw).
+// dist 'native_exec_own' (polled with native_bridge_verify; needs it): keys (record VS, PS, vertex decl) become EXECUTABLE
+// (RexNativeRendererGetDrawMasksV2 flags bit 2) after kOwnProve exact v4-verified draws that all ran with the SAME translated
+// shader objects (that pair is what the run executes with) - only the native depth family (no PS, city depth VS hashes)
+// unless dist 'native_exec_own_all' also exists. OWNED batches are all-or-nothing (n or 0).
+// Log 'NATIVE OWN RUNS (30A2, 10 s)'.
+// =====================================================================================================================
+}  // namespace rex::graphics::d3d12
+namespace rex::graphics {
+struct RexOwnedRunStep {
+  const uint32_t* pairs;
+  uint32_t pair_count;
+  Shader* vs;
+  Shader* ps;
+  const uint32_t* draw;
+  uint32_t draw_words;
+};
+typedef uint32_t (*RexOwnedRunHook)(uint32_t run_id, uint32_t n, const RexOwnedRunStep** out_steps);
+extern std::atomic<RexOwnedRunHook> g_owned_run_hook;
+extern thread_local bool g_owned_run_executing;
+}  // namespace rex::graphics
+namespace rex::graphics::d3d12 {
+static constexpr uint32_t kOwnProve = 16;
+static constexpr uint32_t kOwnHintSlots = 8192, kOwnHintProbe = 64;
+static std::atomic<bool> g_own_on{false}, g_own_all{false};
+// MAIN31: dist native_exec_own_anyps = a depth-family key whose VS object matches but PS object differs is NOT a conflict
+// (IssueDraw drops the PS of depth-only draws). Game-thread mask-query counters (published / bit-2 hint hits).
+static std::atomic<bool> g_own_anyps{false};
+static std::atomic<bool> g_own_pred{false};  // MAIN31: dist native_exec_own_pred
+static std::atomic<bool> g_own_dry{false};  // MAIN31: dist native_exec_own_dry (own runs in native_frame_exec_dry mode)
+static std::atomic<uint64_t> g_own_q_pub{0}, g_own_q_hit{0};
+static std::atomic<uint64_t> g_own_hint[kOwnHintSlots];  // executable keys (0 empty, 1 tombstone), lock-free for the game
+struct NbOwnKey {
+  const Shader* vs = nullptr;
+  const Shader* ps = nullptr;
+  uint32_t exact = 0;
+  bool conflict = false, exec = false;
+};
+struct NbOwnRec {
+  uint32_t pair_begin = 0, pair_count = 0;
+  Shader* vs = nullptr;
+  Shader* ps = nullptr;
+  uint32_t draw[9] = {};  // guest byte order + spare dword
+  uint32_t draw_words = 0;
+};
+struct NbOwnRun {
+  std::vector<uint32_t> pairs;
+  std::vector<NbOwnRec> recs;
+  uint64_t submit_swap = 0, last_exec_swap = 0;
+  uint32_t execs = 0;
+};
+struct NbOwnStats {
+  uint64_t batches = 0, accepted_runs = 0, accepted_draws = 0, refused_runs = 0, refused_draws = 0;
+  uint64_t why[8] = {};  // refusal reasons
+  uint64_t exec_runs = 0, exec_draws = 0, reexec_runs = 0, holes = 0, hole_draws = 0, expired = 0;
+  uint64_t keys_exec = 0, keys_conflict = 0, pairs = 0;
+  uint64_t conf_vs = 0, conf_ps = 0, ps_tolerated = 0;  // MAIN31 (cumulative)
+};
+static const char* const kOwnWhyName[8] = {"off", "malformed", "mixed", "not-self-sufficient", "bad-draw-packet",
+                                           "key-not-executable", "masks-not-covered", "run-ids"};
+static std::unordered_map<uint64_t, NbOwnKey> g_own_keys;                   // bridge mutex
+static std::unordered_map<uint32_t, std::shared_ptr<NbOwnRun>> g_own_runs;  // bridge mutex
+static NbOwnStats g_own_st;                                                 // bridge mutex
+static uint64_t g_own_native_draws = 0;  // CP thread: owned draws that IssueDraw drew natively (NEXEC / native fast)
+
+static inline uint64_t NativeOwnKey(uint32_t vs, uint32_t ps, uint32_t decl) {
+  const uint64_t k = ((uint64_t(NativeBridgePhys(vs)) << 32) | NativeBridgePhys(ps)) ^ (uint64_t(decl) * 0x9E3779B97F4A7C15ull);
+  return k < 2 ? k + 2 : k;
+}
+static inline uint32_t NativeOwnHintSlot(uint64_t k) {
+  uint64_t h = k ^ (k >> 31);
+  h *= 0xBF58476D1CE4E5B9ull;
+  return uint32_t(h >> 40) & (kOwnHintSlots - 1);
+}
+static void NativeOwnHintSet(uint64_t k, bool on) {
+  uint32_t i = NativeOwnHintSlot(k);
+  for (uint32_t p = 0; p < kOwnHintProbe; ++p, i = (i + 1) & (kOwnHintSlots - 1)) {
+    const uint64_t v = g_own_hint[i].load(std::memory_order_relaxed);
+    if (v == k) {
+      if (!on) g_own_hint[i].store(1, std::memory_order_release);
+      return;
+    }
+    if (v == 0) {
+      if (on) g_own_hint[i].store(k, std::memory_order_release);
+      return;
+    }
+  }
+}
+// Any thread, lock-free.
+static bool NativeOwnHint(uint32_t vs, uint32_t ps, uint32_t decl) {
+  if (!g_own_on.load(std::memory_order_relaxed)) return false;
+  const uint64_t k = NativeOwnKey(vs, ps, decl);
+  uint32_t i = NativeOwnHintSlot(k);
+  for (uint32_t p = 0; p < kOwnHintProbe; ++p, i = (i + 1) & (kOwnHintSlots - 1)) {
+    const uint64_t v = g_own_hint[i].load(std::memory_order_acquire);
+    if (v == k) return true;
+    if (v == 0) return false;
+  }
+  return false;
+}
+// Scope limiter only (any key is exact by construction: IssueDraw runs on the record state). VS hash = the native depth
+// family (NativeShaderFor); the raw PS is not checked (IssueDraw drops it for depth-only draws itself).
+static bool NativeOwnDepthFamily(const Shader* vs, const Shader* /*ps*/) {
+  if (!vs) return false;
+  switch (vs->ucode_data_hash()) {
+    case 0x56532B4CC70CFBA4ull:
+    case 0xE68A5DAFE68EDB9Dull:
+    case 0x139392D599EB4A31ull:
+    case 0x153C1F0F3197CCE7ull:
+    case 0x254CEA85F505D6CAull:
+    case 0x154771C771CC1A5Cull:
+      return true;
+  }
+  return false;
+}
+// CP thread, bridge mutex held: a v4 record matched a draw and every v3 + v4 field was equal.
+static void NativeOwnLearn(const NativeBridgeRecord& rec, const Shader* vs, const Shader* ps) {
+  if (!g_own_on.load(std::memory_order_relaxed)) return;
+  const RexNativeDrawRecordV2& r = rec.r;
+  if (!r.vertex_shader_guest || !vs || !(r.flags & REX_NATIVE_DRAW_FLAG_SELF_SUFFICIENT) ||
+      rec.state_values.size() != REX_NATIVE_STATE_REG_COUNT) {
+    return;
+  }
+  const uint64_t k = NativeOwnKey(r.vertex_shader_guest, r.pixel_shader_guest, r.vertex_decl_guest);
+  NbOwnKey& e = g_own_keys[k];
+  if (e.conflict) return;
+  if (!e.exact) {
+    e.vs = vs;
+    e.ps = ps;
+  } else if (e.vs != vs || e.ps != ps) {
+    if (e.vs == vs && g_own_anyps.load(std::memory_order_relaxed) && NativeOwnDepthFamily(vs, ps)) {
+      ++g_own_st.ps_tolerated;  // MAIN31: PS-only difference on a depth-family key
+    } else {
+      ++(e.vs != vs ? g_own_st.conf_vs : g_own_st.conf_ps);
+      e.conflict = true;
+      ++g_own_st.keys_conflict;
+      if (e.exec) {
+        e.exec = false;
+        NativeOwnHintSet(k, false);
+      }
+      return;
+    }
+  }
+  ++e.exact;
+  if (!e.exec && e.exact >= kOwnProve && (g_own_all.load(std::memory_order_relaxed) || NativeOwnDepthFamily(vs, ps))) {
+    e.exec = true;
+    ++g_own_st.keys_exec;
+    NativeOwnHintSet(k, true);
+  }
+}
+// Game thread (SubmitV4Batch): an all-OWNED batch = one run. Returns n when stored, 0 when refused.
+// MAIN31: build one run (records [0, n) of recs), no lock. Returns 8 when ok, else the refusal reason.
+static uint32_t NativeOwnBuild(const NativeBridgeRecord* recs, uint32_t n, std::shared_ptr<NbOwnRun>& run, uint32_t& run_id) {
+  uint32_t own_pred_bit = 0;  // MAIN31
+  uint32_t why = 8;
+  auto refuse = [&](uint32_t w) {
+    if (why == 8) why = w;
+  };
+  if (!g_own_on.load(std::memory_order_relaxed)) refuse(0);
+  run_id = n ? recs[0].r.reserved0 : 0;
+  if (!n || !(run_id & 0x80000000u)) refuse(7);
+  static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+  run = std::make_shared<NbOwnRun>();
+  run->recs.resize(n);
+  run->pairs.reserve(size_t(n) * 2 * 200);
+  for (uint32_t i = 0; i < n && why == 8; ++i) {
+    const NativeBridgeRecord& rec = recs[i];
+    const RexNativeDrawRecordV2& r = rec.r;
+    if (!rec.v4 || !(r.flags & REX_NATIVE_DRAW_FLAG_OWNED)) {
+      refuse(2);
+      break;
+    }
+    if (r.reserved0 != run_id || r.sequence != i) {
+      refuse(7);
+      break;
+    }
+    if (!(r.flags & REX_NATIVE_DRAW_FLAG_SELF_SUFFICIENT) || !(r.flags & REX_NATIVE_DRAW_FLAG_REG_VALUES) ||
+        rec.state_values.size() != REX_NATIVE_STATE_REG_COUNT) {
+      refuse(3);
+      break;
+    }
+    const uint32_t h = rec.draw_packet[0], op = (h >> 8) & 0x7Fu;
+    // MAIN31: predicated DRAWs allowed with dist native_exec_own_pred when every draw of the run has the same predicate
+    // bit (the exe writes the run marker with that bit; the generic CP applies predication before the NOP handler).
+    if (i == 0) own_pred_bit = h & 1u;
+    const bool pred_bad = (h & 1u) && (!g_own_pred.load(std::memory_order_relaxed) || (h & 1u) != own_pred_bit);
+    const bool pred_mix = !(h & 1u) && own_pred_bit;
+    if (rec.draw_packet_words < 2 || rec.draw_packet_words > 8 || (h >> 30) != 3u || pred_bad || pred_mix ||
+        (op != 0x22u && op != 0x36u) || ((h >> 16) & 0x3FFFu) + 2u != rec.draw_packet_words) {
+      refuse(4);
+      break;
+    }
+    NbOwnRec& o = run->recs[i];
+    o.draw_words = rec.draw_packet_words;
+    for (uint32_t j = 0; j < o.draw_words; ++j) o.draw[j] = rex::byte_swap(rec.draw_packet[j]);
+    o.pair_begin = uint32_t(run->pairs.size() / 2);
+    for (uint32_t j = 0; j < REX_NATIVE_STATE_REG_COUNT; ++j) {
+      run->pairs.push_back(kRegs[j]);
+      run->pairs.push_back(rec.state_values[j]);
+    }
+    size_t v = 0;
+    for (uint32_t stage = 0; stage < 2; ++stage) {
+      const uint32_t first = stage ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X;
+      for (uint32_t g = 0; g < 64; ++g) {
+        if (!((rec.vmask[stage] >> g) & 1)) continue;
+        for (uint32_t w = 0; w < 16 && v < rec.values.size(); ++w, ++v) {
+          run->pairs.push_back(first + g * 16 + w);
+          run->pairs.push_back(rec.values[v]);
+        }
+      }
+    }
+    size_t f = 0;
+    for (uint32_t u = 0; u < 96; ++u) {
+      if (!((rec.fetch_units[u >> 5] >> (u & 31)) & 1)) continue;
+      for (uint32_t w = 0; w < 2 && f < rec.fetch_values.size(); ++w, ++f) {
+        run->pairs.push_back(XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + u * 2 + w);
+        run->pairs.push_back(rec.fetch_values[f]);
+      }
+    }
+    o.pair_count = uint32_t(run->pairs.size() / 2) - o.pair_begin;
+    // The published masks of the key (what the translated pair reads) must be covered by the record.
+    uint64_t gm[2] = {};
+    uint32_t gen = 0, fu[3] = {};
+    if (NativeBridgeGetMasks(r.vertex_shader_guest, r.pixel_shader_guest, r.vertex_decl_guest, gm, &gen, fu) != 1 ||
+        (gm[0] & ~rec.vmask[0]) || (gm[1] & ~rec.vmask[1]) || (fu[0] & ~rec.fetch_units[0]) ||
+        (fu[1] & ~rec.fetch_units[1]) || (fu[2] & ~rec.fetch_units[2])) {
+      refuse(6);
+      break;
+    }
+  }
+  return why;
+}
+// MAIN31: an all-OWNED batch = one or more runs (each starts at sequence 0). All runs accepted or none (the exe rewrites
+// the regions only when the call returned the batch's record count). One mutex acquisition per batch.
+static int NativeOwnIntake(std::vector<NativeBridgeRecord>& recs) {
+  struct Seg {
+    uint32_t b = 0, n = 0, run_id = 0;
+    std::shared_ptr<NbOwnRun> run;
+  };
+  thread_local std::vector<Seg> segs;
+  segs.clear();
+  const uint32_t total = uint32_t(recs.size());
+  uint32_t why = total ? 8u : 7u;
+  for (uint32_t i = 0; i < total && why == 8;) {
+    uint32_t j = i + 1;
+    while (j < total && recs[j].r.sequence != 0) ++j;
+    Seg sg;
+    sg.b = i;
+    sg.n = j - i;
+    why = NativeOwnBuild(recs.data() + i, sg.n, sg.run, sg.run_id);
+    segs.push_back(std::move(sg));
+    i = j;
+  }
+  std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+  ++g_own_st.batches;
+  for (size_t si = 0; si < segs.size() && why == 8; ++si) {
+    Seg& sg = segs[si];
+    for (uint32_t i = 0; i < sg.n; ++i) {
+      const RexNativeDrawRecordV2& r = recs[sg.b + i].r;
+      auto it = g_own_keys.find(NativeOwnKey(r.vertex_shader_guest, r.pixel_shader_guest, r.vertex_decl_guest));
+      if (it == g_own_keys.end() || !it->second.exec) {
+        why = 5;
+        break;
+      }
+      sg.run->recs[i].vs = const_cast<Shader*>(it->second.vs);
+      sg.run->recs[i].ps = const_cast<Shader*>(it->second.ps);
+    }
+  }
+  if (why != 8) {
+    g_own_st.refused_runs += segs.empty() ? 1 : segs.size();
+    g_own_st.refused_draws += total;
+    ++g_own_st.why[why];
+    segs.clear();
+    return 0;
+  }
+  for (Seg& sg : segs) {
+    sg.run->submit_swap = g_native_bridge.cp_swaps;
+    g_own_st.pairs += sg.run->pairs.size() / 2;
+    g_own_runs[sg.run_id] = std::move(sg.run);
+    ++g_own_st.accepted_runs;
+    g_own_st.accepted_draws += sg.n;
+  }
+  segs.clear();
+  return int(total);
+}
+// CP thread, at the NRN4 marker.
+static uint32_t NativeOwnRunHook(uint32_t run_id, uint32_t n, const rex::graphics::RexOwnedRunStep** out_steps) {
+  thread_local std::shared_ptr<NbOwnRun> held;
+  thread_local std::vector<rex::graphics::RexOwnedRunStep> steps;
+  *out_steps = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+    auto it = g_own_runs.find(run_id);
+    if (it == g_own_runs.end() || it->second->recs.size() != n) {
+      ++g_own_st.holes;
+      g_own_st.hole_draws += n;
+      return 0;
+    }
+    held = it->second;
+    if (held->execs++) ++g_own_st.reexec_runs;
+    held->last_exec_swap = g_native_bridge.cp_swaps;
+    ++g_own_st.exec_runs;
+    g_own_st.exec_draws += n;
+  }
+  steps.resize(n);
+  for (uint32_t i = 0; i < n; ++i) {
+    const NbOwnRec& o = held->recs[i];
+    rex::graphics::RexOwnedRunStep& s = steps[i];
+    s.pairs = held->pairs.data() + size_t(o.pair_begin) * 2;
+    s.pair_count = o.pair_count;
+    s.vs = o.vs;
+    s.ps = o.ps;
+    s.draw = o.draw;
+    s.draw_words = o.draw_words;
+  }
+  *out_steps = steps.data();
+  return n;
+}
+// IssueSwap (bridge mutex held): executed runs live until 8 swaps after their last execution (re-executed buffers),
+// unexecuted ones 16 swaps.
+static void NativeOwnOnSwap() {
+  for (auto it = g_own_runs.begin(); it != g_own_runs.end();) {
+    const NbOwnRun& r = *it->second;
+    const bool drop = r.execs ? r.last_exec_swap + 8 < g_native_bridge.cp_swaps
+                              : r.submit_swap + 16 < g_native_bridge.cp_swaps;
+    if (drop) {
+      if (!r.execs) ++g_own_st.expired;
+      it = g_own_runs.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+// Bridge mutex held, every 10 s with the bridge log.
+static void NativeOwnLog(double seconds) {
+  if (!g_own_on.load(std::memory_order_relaxed) && !g_own_st.batches && !g_own_st.exec_runs) return;
+  NbOwnStats& s = g_own_st;
+  std::string why;
+  for (uint32_t i = 0; i < 8; ++i) {
+    if (s.why[i]) why += fmt::format(" {} {}", kOwnWhyName[i], s.why[i]);
+  }
+  REXLOG_INFO("NATIVE OWN RUNS (30A2, 10 s){}: batches {} | accepted runs {} draws {} | refused runs {} draws {} ({}) | "
+              "EXECUTED runs {} draws {} ({:.0f} draws/s; drawn natively {} = {:.1f} %) re-executed runs {} | HOLES runs {} "
+              "draws {} | expired {} | keys executable {} conflict {} (known {}) | pairs/draw {:.0f} | runs pending {}",
+              g_own_on.load(std::memory_order_relaxed) ? (g_own_all.load(std::memory_order_relaxed) ? " ON all keys" : " ON depth family")
+                                                       : " off",
+              s.batches, s.accepted_runs, s.accepted_draws, s.refused_runs, s.refused_draws, why.empty() ? "-" : why.c_str() + 1,
+              s.exec_runs, s.exec_draws, seconds > 0 ? double(s.exec_draws) / seconds : 0.0, g_own_native_draws,
+              s.exec_draws ? 100.0 * double(g_own_native_draws) / double(s.exec_draws) : 0.0, s.reexec_runs, s.holes,
+              s.hole_draws, s.expired, s.keys_exec, s.keys_conflict, g_own_keys.size(),
+              s.accepted_draws ? double(s.pairs) / double(s.accepted_draws) : 0.0, g_own_runs.size());
+  {  // MAIN31
+    uint64_t live = 0, exact_draws_live = 0;
+    for (const auto& kv : g_own_keys) {
+      if (kv.second.exec) {
+        ++live;
+        exact_draws_live += kv.second.exact;
+      }
+    }
+    REXLOG_INFO("NATIVE OWN KEYS (MAIN31, cumulative): live executable {} (their exact draws {}) | conflicts VS {} PS-only {} | "
+                "PS-only tolerated {} (anyps {}) | game mask queries (10 s): published {} bit-2 set {}",
+                live, exact_draws_live, s.conf_vs, s.conf_ps, s.ps_tolerated, g_own_anyps.load(std::memory_order_relaxed) ? 1 : 0,
+                g_own_q_pub.exchange(0, std::memory_order_relaxed), g_own_q_hit.exchange(0, std::memory_order_relaxed));
+  }
+  const uint64_t ke = s.keys_exec, kc = s.keys_conflict, cv = s.conf_vs, cp = s.conf_ps, pt = s.ps_tolerated;
+  s = NbOwnStats{};
+  s.keys_exec = ke;
+  s.keys_conflict = kc;
+  s.conf_vs = cv;
+  s.conf_ps = cp;
+  s.ps_tolerated = pt;
+  g_own_native_draws = 0;
+}
