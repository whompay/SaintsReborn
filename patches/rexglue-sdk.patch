+void Activate(const char* why);
+bool AcceptPendingInvite();
+
+// Starts the virtual LAN once (the first time the game asks for its address).
+// Returns true when EOS is available (the virtual IP is then valid at once,
+// even while logging in).
+bool Start() {
+  static std::mutex m;
+  std::lock_guard<std::mutex> lock(m);
+  if (started) return state != State::Off;
+  started = true;
+  if (!FindSdk()) {
+    // MULTIPLAYER > PLAYERS says why there is no list.
+    rex::cvar::SetFlagByName("online_players", "#nosdk\n");
+    return false;
+  }
+  // Virtual IP 10.77.x.y, random per run.
+  LARGE_INTEGER t;
+  QueryPerformanceCounter(&t);
+  uint32_t x = uint32_t(t.QuadPart) ^ (GetCurrentProcessId() * 2654435761u) ^ uint32_t(GetTickCount64());
+  x ^= x >> 13;
+  x *= 0x5bd1e995u;
+  x ^= x >> 15;
+  uint32_t lo = (x & 0xFFFF);
+  if ((lo & 0xFF) == 0 || (lo & 0xFF) == 255) lo ^= 0x21;
+  if ((lo >> 8) == 255) lo ^= 0x2100;
+  my_ip = (10u << 24) | (77u << 16) | lo;
+  // Loopback helper that hands received packets to the game's sockets.
+  helper = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (helper != INVALID_SOCKET) {
+    sockaddr_in a{};
+    a.sin_family = AF_INET;
+    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    a.sin_port = 0;
+    bind(helper, (sockaddr*)&a, sizeof(a));
+    int len = sizeof(a);
+    getsockname(helper, (sockaddr*)&a, &len);
+    helper_port = ntohs(a.sin_port);
+  }
+  // Epic itself starts only when System Link is used (Activate): the co-op
+  // mod's online play runs its own EOS platform, and two platforms ticked
+  // from two threads in one process corrupt the heap (crash on Host Co-op).
+  state = State::Idle;
+  // The game asks for the online player list when MULTIPLAYER opens
+  // (cvar online_wanted); the state for that list goes to online_players.
+  std::thread([] {
+    State shown = State::Off;
+    while (true) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(250));
+      if (state == State::Idle && rex::cvar::GetFlagByName("online_wanted") == "true") Activate("MULTIPLAYER opened");
+      {
+        const std::string add = rex::cvar::GetFlagByName("online_friend_add");
+        if (!add.empty()) {
+          rex::cvar::SetFlagByName("online_friend_add", "");
+          std::lock_guard<std::mutex> il(invite_mutex);
+          pending_add = add;
+          if (state == State::Idle) rex::cvar::SetFlagByName("online_wanted", "true");
+        }
+      }
+      if (rex::cvar::GetFlagByName("online_invite_accept") == "true") {
+        rex::cvar::SetFlagByName("online_invite_accept", "false");
+        AcceptPendingInvite();
+      }
+      {
+        std::lock_guard<std::mutex> il(invite_mutex);
+        const int64_t t = int64_t(std::time(nullptr));
+        if (has_pending && t - pending_invite.at > kInviteSeconds) has_pending = false;
+        if (has_pending_friend && t - pending_friend.at > 600) has_pending_friend = false;
+        if (!has_pending && !has_pending_friend && !rex::cvar::GetFlagByName("online_invite_from").empty())
+          rex::cvar::SetFlagByName("online_invite_from", "");
+      }
+      const State now = state.load();
+      if (now == shown) continue;
+      shown = now;
+      if (now == State::Ready) continue;  // the worker publishes the list itself
+      const char* s = now == State::Failed ? "#failed"
+                      : now == State::Lent   ? "#coop"
+                      : now == State::Idle   ? "#off"
+                                             : "#connecting";
+      rex::cvar::SetFlagByName("online_players", std::string(s) + "\n");
+    }
+  }).detach();
+  REXSYS_INFO("EOS LAN: virtual IP {}.{}.{}.{} (Epic login when System Link is used)", my_ip >> 24,
+              (my_ip >> 16) & 255, (my_ip >> 8) & 255, my_ip & 255);
+  return true;
+}
+
+// Logs in to Epic and joins the LAN lobby, once, when System Link is first
+// used. Stays off when something else in the game (the co-op mod playing
+// online) already uses the EOS DLL.
+void Activate(const char* why) {
+  std::lock_guard<std::mutex> lock(activate_mutex);
+  if (!started || state != State::Idle || worker_running) return;
+  if (lent_out) { state = State::Lent; return; }
+  if (!sdk_loaded_here && !ever_lent && GetModuleHandleA("EOSSDK-Win64-Shipping.dll")) {
+    // An older co-op mod (without SrEosLend) already has Epic.
+    REXSYS_WARN("EOS LAN: not started ({}): co-op online already uses Epic in this game run; restart the game "
+                "for System Link over the internet", why);
+    state = State::Failed;
+    return;
+  }
+  std::string ini;
+  if (!LoadSdk(ini)) { state = State::Failed; return; }
+  state = State::Starting;
+  worker_running = true;
+  worker = std::thread(Worker, ini);
+  worker.detach();
+  REXSYS_INFO("EOS LAN: starting ({}), virtual IP {}.{}.{}.{}", why, my_ip >> 24, (my_ip >> 16) & 255,
+              (my_ip >> 8) & 255, my_ip & 255);
+}
+
+bool Enabled() { return started && state != State::Off; }
+uint32_t VirtualIp() { return Enabled() ? my_ip : 0; }
+bool IsVirtual(uint32_t ip) { return (ip >> 16) == ((10u << 8) | 77u) || ip == 0xFFFFFFFFu; }
+uint16_t HelperPort() { return helper_port; }
+
+// Xbox Live session adverts (see ApplyAdvert). Empty = no hosted session.
+void SetLiveAdvert(const std::string& text) {
+  if (!text.empty()) Activate("Xbox Live session hosted");
+  std::lock_guard<std::mutex> l(advert_mutex);
+  my_advert = text.substr(0, kAdvertParts * kAdvertPart);
+}
+// The other players' adverts; waits up to wait_ms for Epic to be ready and a
+// fresh member refresh (used by XSessionSearch).
+std::vector<LiveAdvertEntry> LiveAdverts(uint32_t wait_ms) {
+  Activate("Xbox Live session search");
+  const auto until = std::chrono::steady_clock::now() + std::chrono::milliseconds(wait_ms);
+  const uint32_t start = refresh_count.load();
+  while (std::chrono::steady_clock::now() < until) {
+    if (state == State::Failed || state == State::Off || state == State::Idle || state == State::Lent) break;
+    if (state == State::Ready && refresh_count.load() != start) break;
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+  }
+  std::lock_guard<std::mutex> l(advert_mutex);
+  return others_adverts;
+}
+bool LiveReady() { return state == State::Ready; }
+
+uint64_t XuidForPuid(const std::string& puid) { return XuidFromPuid(puid); }
+
+static std::string KidHex(const uint8_t kid[8]) {
+  static const char* d = "0123456789abcdef";
+  std::string s;
+  for (int i = 0; i < 8; ++i) { s += d[kid[i] >> 4]; s += d[kid[i] & 15]; }
+  return s;
+}
+// XNetQosListen(SET_DATA) on the host: publish the data for its session id.
+// Up to 4 sessions (newest first): the party lobby keeps its data while a
+// match session publishes its own, so a player invited back into the same
+// lobby still gets the lobby's data. data == nullptr removes that session.
+void SetQosData(const uint8_t kid[8], const uint8_t* data, size_t n) {
+  static const char* d = "0123456789abcdef";
+  static std::vector<std::pair<std::string, std::string>> entries;  // under invite_mutex
+  std::string hex;
+  for (size_t i = 0; data && i < n && i < 100; ++i) { hex += d[data[i] >> 4]; hex += d[data[i] & 15]; }
+  std::lock_guard<std::mutex> il(invite_mutex);
+  const std::string k = KidHex(kid);
+  for (auto it = entries.begin(); it != entries.end();) it = it->first == k ? entries.erase(it) : it + 1;
+  if (data && n) entries.insert(entries.begin(), {k, hex});
+  if (entries.size() > 4) entries.resize(4);
+  my_qos.clear();
+  for (const auto& e : entries) {
+    if (!my_qos.empty()) my_qos += ';';
+    my_qos += e.first + ":" + e.second;
+  }
+  if (data && n) REXSYS_INFO("EOS LAN: QoS data for session {} published ({} byte(s), {} session(s))", k, n, entries.size());
+  else REXSYS_INFO("EOS LAN: QoS data for session {} removed", k);
+}
+// XNetQosLookup on the joiner: the host's data for that session id.
+bool QosData(const uint8_t kid[8], std::vector<uint8_t>& out) {
+  std::lock_guard<std::mutex> il(invite_mutex);
+  auto it = qos_by_kid.find(KidHex(kid));
+  if (it == qos_by_kid.end()) return false;
+  out = it->second;
+  return true;
+}
+
+// The game's friends list (lobby > INVITE): friends (both ways) online or
+// not, then players this one played with recently who are online now.
+std::vector<OnlinePlayer> FriendsList() {
+  std::lock_guard<std::mutex> il(invite_mutex);
+  LoadFriendsLocked();
+  const int64_t t = int64_t(std::time(nullptr));
+  std::vector<OnlinePlayer> out;
+  for (const auto& f : friends) {
+    if (f.puid.rfind("code:", 0) == 0) continue;
+    const OnlinePlayer* live = nullptr;
+    if (state == State::Ready)
+      for (const auto& p : players_snapshot) if (p.puid == f.puid) live = &p;
+    const bool recent_ok = f.recent && live && t - f.seen_at < 30 * 86400;
+    if (!f.mutual && !recent_ok) continue;
+    OnlinePlayer op = live ? *live : OnlinePlayer{};
+    op.puid = f.puid;
+    op.xuid = XuidFromPuid(f.puid);
+    if (op.name.empty()) op.name = f.name.empty() ? std::string("Player") : f.name;
+    op.online = live != nullptr;
+    op.mutual = f.mutual;
+    if (!op.online) op.where.clear();
+    out.push_back(op);
+  }
+  std::stable_sort(out.begin(), out.end(), [](const OnlinePlayer& a, const OnlinePlayer& b) {
+    if (a.online != b.online) return a.online;
+    if (a.mutual != b.mutual) return a.mutual;
+    return _stricmp(a.name.c_str(), b.name.c_str()) < 0;
+  });
+  return out;
+}
+
+// The session this game hosts (is_host) or joined (info = the host's
+// XSESSION_INFO); nullptr + false when it left.
+void SetSessionHost(const uint8_t* info, bool is_host) {
+  if (is_host) {
+    session_host_ip = my_ip;
+    session_active = true;
+  } else if (info) {
+    auto be32 = [&](int at) { return uint32_t(info[at]) << 24 | uint32_t(info[at + 1]) << 16 | uint32_t(info[at + 2]) << 8 | info[at + 3]; };
+    const uint32_t ina = be32(8), online = be32(12);
+    session_host_ip = IsVirtual(ina) ? ina : IsVirtual(online) ? online : ina;
+    session_active = true;
+  } else {
+    session_host_ip = 0;
+    session_active = false;
+    blocked_host_ip = 0;
+  }
+}
+
+// The host's lobby settings name map `id` (found = this game has a map with
+// that id). False: missing or another version -> this game stops listening
+// to the host (the game goes back to the menu when the host is lost).
+bool CheckHostMap(uint16_t id, bool found) {
+  const uint32_t host = session_host_ip.load();
+  if (!host || host == my_ip) return true;  // hosting, or not in a Live / System Link session over Epic
+  std::string why, pack, host_name;
+  {
+    std::lock_guard<std::mutex> il(invite_mutex);
+    ComputeMapsLocked();
+    auto mine = my_maps.find(id);
+    auto hit = maps_by_ip.find(host);
+    auto nit = name_by_ip.find(host);
+    host_name = nit != name_by_ip.end() && !nit->second.empty() ? nit->second : std::string("The host");
+    if (mine != my_maps.end()) pack = my_map_pack[id];
+    if (!found) {
+      why = "missing";
+    } else if (hit != maps_by_ip.end()) {
+      auto theirs = hit->second.find(id);
+      if (theirs != hit->second.end() && (mine == my_maps.end() || mine->second != theirs->second)) why = "version";
+      else if (theirs == hit->second.end() && mine != my_maps.end()) why = "version";  // their base map, our pack
+    }
+  }
+  if (why.empty()) return true;
+  if (blocked_host_ip.exchange(host) != host) {
+    REXSYS_WARN("EOS LAN: host picked map id {} - {} here{}; leaving that host", id,
+                why == "missing" ? "not installed" : "a different version",
+                pack.empty() ? std::string() : " (pack '" + pack + "')");
+    rex::system::online::Notice(
+        why == "missing"
+            ? host_name + " picked a map you don't have. You left the lobby so the game doesn't break. Get the map pack from them and join again."
+            : host_name + " picked a map that is a different version from yours" +
+                  (pack.empty() ? std::string() : " ('" + pack + "')") +
+                  ". You left the lobby so the game doesn't break. Get the same map pack and join again.");
+  }
+  return false;
+}
+
+std::vector<OnlinePlayer> OnlinePlayers() {
+  std::lock_guard<std::mutex> il(invite_mutex);
+  return state == State::Ready ? players_snapshot : std::vector<OnlinePlayer>();
+}
+
+// The Live lobby this game hosts or is in (XSESSION_INFO, 60 bytes); nullptr
+// when it leaves (its invites are withdrawn).
+void SetInviteSession(const uint8_t* info) {
+  static const char* d = "0123456789abcdef";
+  std::lock_guard<std::mutex> il(invite_mutex);
+  my_session_hex.clear();
+  if (info)
+    for (int i = 0; i < 60; ++i) { my_session_hex += d[info[i] >> 4]; my_session_hex += d[info[i] & 15]; }
+  if (!info) my_invite.clear();
+}
+
+// XInviteSend: returns how many of the xuids are Saints Reborn players online
+// (-1: this game is in no lobby to invite to).
+int SendInvites(const std::vector<uint64_t>& xuids) {
+  std::lock_guard<std::mutex> il(invite_mutex);
+  if (my_session_hex.size() != 120) return -1;
+  std::string list;
+  std::string names;
+  int n = 0;
+  for (uint64_t x : xuids) {
+    for (const auto& p : players_snapshot) {
+      if (p.xuid != x || list.size() + p.puid.size() + 1 > 220) continue;
+      if (!list.empty()) { list += ','; names += ", "; }
+      list += p.puid;
+      names += p.name;
+      ++n;
+    }
+  }
+  if (!n) return 0;
+  my_invite = std::to_string(int64_t(std::time(nullptr))) + "|" + list;
+  my_invite_session = my_session_hex;
+  REXSYS_INFO("EOS LAN: invite sent to {}", names);
+  rex::system::online::Notice("Invite sent to " + names + ".");
+  return n;
+}
+
+bool AcceptPendingInvite() {
+  {
+    std::lock_guard<std::mutex> il(invite_mutex);
+    const int64_t t = int64_t(std::time(nullptr));
+    const bool invite_ok = has_pending && t - pending_invite.at <= kInviteSeconds;
+    if (has_pending_friend && (!invite_ok || pending_friend.at >= pending_invite.at)) {
+      // F10 on a friend request: friends both ways.
+      has_pending_friend = false;
+      LoadFriendsLocked();
+      Friend& f = FriendEntryLocked(pending_friend.puid, pending_friend.name);
+      f.added = true;
+      f.mutual = true;
+      f.added_at = t;
+      SaveFriendsLocked();
+      rex::cvar::SetFlagByName("online_invite_from", has_pending ? pending_invite.name : std::string());
+      REXSYS_INFO("EOS LAN: friend request from '{}' accepted", pending_friend.name);
+      rex::system::online::Notice(pending_friend.name + " is now your friend.");
+      return true;
+    }
+    if (!invite_ok) return false;
+    accepted_invite = pending_invite;
+    has_accepted = true;
+    has_pending = false;
+    rex::cvar::SetFlagByName("online_invite_from", has_pending_friend ? pending_friend.name : std::string());
+    REXSYS_INFO("EOS LAN: invite from '{}' accepted", accepted_invite.name);
+    rex::system::online::Notice("Joining " + accepted_invite.name + "...");
+  }
+  // XN_LIVE_INVITE_ACCEPTED (param: user index); the game then calls
+  // XInviteGetAcceptedInfo (xlivebase 0x58023).
+  if (auto* ks = REX_KERNEL_STATE()) ks->BroadcastNotification(0x02000002, 0);
+  return true;
+}
+
+// XInviteGetAcceptedInfo: the inviter and the host's session info.
+bool AcceptedInvite(uint64_t& inviter_xuid, uint8_t info[60]) {
+  std::lock_guard<std::mutex> il(invite_mutex);
+  if (!has_accepted) return false;
+  const std::vector<uint8_t> v = UnhexBytes(accepted_invite.session_hex);
+  if (v.size() != 60) return false;
+  std::memcpy(info, v.data(), 60);
+  inviter_xuid = accepted_invite.xuid;
+  return true;
+}
+
+// In a Private Party (hosted or joined) modded and unmodded games play
+// together; everywhere else game packets only flow between unmodded games.
+void SetPrivateSession(bool on) {
+  if (private_session.exchange(on) != on)
+    REXSYS_INFO("EOS LAN: {}", on ? "Private Party - mods allowed" : "public play - unmodded games only");
+}
+
+// A packet from the game (host-order address / ports).
+void Send(uint32_t dst_ip, uint16_t dst_port, uint16_t src_port, const uint8_t* data, size_t len) {
+  if (!Enabled() || !IsVirtual(dst_ip)) return;
+  Activate("first System Link packet");
+  std::lock_guard<std::mutex> l(out_mutex);
+  if (out_queue.size() > 2048) return;
+  out_queue.push_back(Out{dst_ip, src_port, dst_port, std::vector<uint8_t>(data, data + len)});
+}
+
+}  // namespace rex::system::eoslan
+
+// The co-op mod (WhompaysCoop, eos_link.h) borrows Epic for co-op online:
+// SrEosLend makes this layer leave the LAN lobby and release its platform
+// (waits up to timeout_ms, 1 = done), SrEosReturn gives it back after co-op;
+// the LAN / PLAYERS list then log in again when wanted.
+extern "C" __declspec(dllexport) int SrEosLend(int timeout_ms) {
+  using namespace rex::system::eoslan;
+  {
+    std::lock_guard<std::mutex> lock(activate_mutex);
+    lent_out = true;
+    ever_lent = true;
+    if (!worker_running) {
+      if (state != State::Off) state = State::Lent;
+      return 1;
+    }
+    release_wanted = true;
+  }
+  const auto until = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+  while (worker_running && std::chrono::steady_clock::now() < until)
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  return worker_running ? 0 : 1;
+}
+
+extern "C" __declspec(dllexport) void SrEosReturn() {
+  using namespace rex::system::eoslan;
+  std::lock_guard<std::mutex> lock(activate_mutex);
+  if (!lent_out) return;
+  lent_out = false;
+  if (state == State::Lent && !worker_running) state = State::Idle;
+  REXSYS_INFO("EOS LAN: Epic back from co-op online");
+}
+
+// Exe (project/src/online_players.cpp): the host's lobby settings named
+// multiplayer map `id`; found = this game has a map with that id. Returns 0
+// when this game must not use it (see CheckHostMap).
+extern "C" __declspec(dllexport) int SrMapCheck(uint32_t id, int found) {
+  return rex::system::eoslan::CheckHostMap(uint16_t(id), found != 0) ? 1 : 0;
+}
+
+// Chat for the exe (project/src/chat.cpp).
+namespace {
+std::vector<uint32_t> ChatTargets() {
+  using namespace rex::system::eoslan;
+  std::vector<uint32_t> out;
+  if (state != State::Ready) return out;
+  const auto now = std::chrono::steady_clock::now();
+  std::lock_guard<std::mutex> cl(chat_mutex);
+  for (auto& [ip, seen] : session_peer_seen)
+    if (now - seen < std::chrono::seconds(60)) out.push_back(ip);
+  const uint32_t host = session_host_ip.load();
+  if (host && host != my_ip && std::find(out.begin(), out.end(), host) == out.end()) out.push_back(host);
+  return out;
+}
+}  // namespace
+// Number of players a message would reach now (0 = not in a lobby / match with anyone).
+extern "C" __declspec(dllexport) int SrChatAvailable() { return int(ChatTargets().size()); }
+// 1 while this game is in a lobby / match (hosting or joined), even alone.
+extern "C" __declspec(dllexport) int SrChatInSession() { return rex::system::eoslan::session_active.load() ? 1 : 0; }
+// Sends a line to everyone in this game's lobby / match. Returns the number of players.
+extern "C" __declspec(dllexport) int SrChatSend(const char* text) {
+  using namespace rex::system::eoslan;
+  if (!text || !*text) return 0;
+  const auto targets = ChatTargets();
+  if (targets.empty()) return 0;
+  std::string name = rex::cvar::GetFlagByName("xam_player_name");
+  if (name.empty()) {
+    const char* env = std::getenv("USERNAME");
+    name = env && *env ? env : "Player";
+  }
+  name = rex::system::online::SafeName(name.substr(0, 15));
+  std::vector<uint8_t> d = {'S', 'R', 'C', '1'};
+  uint32_t id;
+  {
+    std::lock_guard<std::mutex> cl(chat_mutex);
+    id = chat_next_id++;
+  }
+  for (int i = 3; i >= 0; --i) d.push_back(uint8_t(my_ip >> (i * 8)));
+  for (int i = 3; i >= 0; --i) d.push_back(uint8_t(id >> (i * 8)));
+  d.insert(d.end(), name.begin(), name.end());
+  d.push_back(0);
+  for (const char* c = text; *c && d.size() < 900; ++c) d.push_back(uint8_t(*c));
+  d.push_back(0);
+  for (uint32_t ip : targets) QueueOut(ip, kChatPort, d);
+  return int(targets.size());
+}
+// Next received line as "name\ttext" (UTF-8); 0 = none.
+extern "C" __declspec(dllexport) int SrChatPoll(char* out, int size) {
+  using namespace rex::system::eoslan;
+  if (!out || size <= 1) return 0;
+  std::lock_guard<std::mutex> cl(chat_mutex);
+  if (chat_in.empty()) return 0;
+  const std::string line = chat_in.front();
+  chat_in.pop_front();
+  const int n = std::min<int>(int(line.size()), size - 1);
+  std::memcpy(out, line.data(), size_t(n));
+  out[n] = 0;
+  return n;
+}
