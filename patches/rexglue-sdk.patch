+// Full resolution, 8x8 groups. t1 depth, t2 blurred occlusion, t3 bloom (1/8
+// res, blurred), t4 sky average. Colour: SP_INPLACE = read + write the colour
+// render target itself through u0 (typed UAV load, each pixel reads only its
+// own group's original colours, kept in groupshared memory before any write);
+// else t0 = colour SRV and u0 = the separate output (copied back afterwards).
+// u1 = 1/8 res bright pass of this frame for the next frame's bloom.
+groupshared float3 g_col[64];
+groupshared float4 g_bl[64];
+groupshared float4 g_sk[64];
+[numthreads(8, 8, 1)]
+void final_main(uint3 id : SV_DispatchThreadID, uint3 gt : SV_GroupThreadID,
+                uint3 gid : SV_GroupID, uint gi : SV_GroupIndex) {
+  bool inside = all(id.xy < size);
+  int2 p = min(int2(id.xy), int2(size) - 1);
+  int3 rp = int3(int2(origin) + p, 0);
+#ifdef SP_INPLACE
+  float4 c4 = u0[rp.xy];
+#else
+  float4 c4 = t0.Load(rp);
+#endif
+  float3 c = c4.rgb;
+  g_col[gi] = c;
+  GroupMemoryBarrierWithGroupSync();
+  float d = t1.Load(rp).r;
+  float z = d > 1e-6 ? LinZ(d) : 0.0;
+  bool is_void = z <= 0.0 && Luma(c) <= 0.03;
+  bool is_sky = z <= 0.0 && !is_void;
+  // Contrast-adaptive sharpening (geometry only; the sky stays smooth). The
+  // neighbours come from this group; at a group edge the opposite neighbour
+  // stands in (mirror), so no pixel of another group is needed.
+  if ((flags & 2048u) && z > 0.0) {
+    float3 n = g_col[gt.y > 0u ? gi - 8u : gi + 8u];
+    float3 s = g_col[gt.y < 7u ? gi + 8u : gi - 8u];
+    float3 e = g_col[gt.x < 7u ? gi + 1u : gi - 1u];
+    float3 w = g_col[gt.x > 0u ? gi - 1u : gi + 1u];
