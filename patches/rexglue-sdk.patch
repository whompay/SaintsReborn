+u32 XamUserCreateStatsEnumerator_entry(u32 title_id, u32 type, u64 pivot, u32 num_rows,
+                                       u32 num_specs, ppc_ptr_t<X_USER_STATS_SPEC> specs,
+                                       mapped_u32 buffer_size_ptr, mapped_u32 handle_ptr) {
+  if (!num_specs || num_specs > 64 || !specs || !handle_ptr) return X_ERROR_INVALID_PARAMETER;
+  std::vector<uint32_t> views;
+  std::string desc;
+  for (uint32_t i = 0; i < num_specs; ++i) {
+    const auto& spec = specs[i];
+    views.push_back(spec.view_id);
+    desc += fmt::format(" [view {} cols", uint32_t(spec.view_id));
+    for (uint32_t c = 0; c < std::min<uint32_t>(spec.num_column_ids, 64); ++c)
+      desc += fmt::format(" {}", uint16_t(spec.column_ids[c]));
+    desc += "]";
+  }
+  REXLOG_INFO("LIVE XUserCreateStatsEnumerator(title {:08X}, {} {:X}, {} rows):{}", uint32_t(title_id),
+              type ? "rank" : "xuid", uint64_t(pivot), uint32_t(num_rows), desc);
+  if (buffer_size_ptr) *buffer_size_ptr = XStatsEnumerator::SizeFor(views.size());
+  auto e = object_ref<XStatsEnumerator>(new XStatsEnumerator(REX_KERNEL_STATE(), std::move(views)));
+  auto result = e->Initialize(0xFF, 0xFB, 0xB0021, 0xB0022, 0);
+  if (XFAILED(result)) return result;
+  *handle_ptr = e->handle();
+  return X_ERROR_SUCCESS;
+}
