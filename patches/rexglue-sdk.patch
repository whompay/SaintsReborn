+constexpr uint32_t kPipelineBudgetPerFrame = 12;
+
+static uint64_t PairKey(uint64_t vs, uint64_t ps) { return vs ^ ((ps << 29) | (ps >> 35)) ^ (ps * 7); }
+
+static void NoteHist(std::unordered_map<uint64_t, uint64_t>& hist, uint64_t vs, uint64_t ps) {
+  const uint64_t key = PairKey(vs, ps);
+  if (++hist[key] == 1) g_state.pair_names.emplace(key, std::make_pair(vs, ps));
+}
+
+static void Poll(uint64_t now_tick) {
+  State& s = g_state;
+  if (now_tick >= s.next_poll) {
+    s.next_poll = now_tick + 1000;
+    s.tint = Perf5FileExists("native_view_tint");
+    s.ports_off = Perf5FileExists("native_view_ports.off");
+    s.fallback_off = Perf5FileExists("native_view_fallback.off");
+    s.city_main_off = Perf5FileExists("native_view_city_main.off");
+    s.fallback_nodepth = Perf5FileExists("native_view_fallback_nodepth");
+    s.nodepth_ports = Perf5FileExists("native_view_nodepth_ports");
+    s.nodepth_world = Perf5FileExists("native_view_nodepth_world");
+    s.solid = Perf5FileExists("native_view_fallback_solid");
+    s.ports_unverified = Perf5FileExists("native_view_ports_unverified");
+    for (uint32_t i = 0; i < kPortCount; ++i) {
+      const std::string file = std::string("native_view_port_") + std::string(kPorts[i].name, 4);
+      s.port_enabled[i] = kPortVerified[i] || s.ports_unverified || Perf5FileExists(file.c_str());
+    }
+  }
+  if (now_tick < s.next_log) return;
+  uint64_t total = 0;
+  for (uint64_t n : s.kind_draws) total += n;
+  if (s.next_log && total) {
+    const double frames = double(std::max<uint64_t>(1, g_prepass_frame - s.log_frame));
+    std::string kinds;
+    for (uint32_t i = 0; i < kKindCount; ++i) {
+      if (!s.kind_draws[i] && i != kKindCityMain && i != kKindFallback && i != kKindFalse) continue;
+      kinds += fmt::format(" | {} {} ({:.1f}/frame, {:.1f} %)", KindName(i), s.kind_draws[i],
+                           s.kind_draws[i] / frames, 100.0 * double(s.kind_draws[i]) / double(total));
+    }
+    std::string reasons;
+    for (uint32_t i = 0; i < kFrCount; ++i) {
+      if (s.false_reasons[i]) reasons += fmt::format(" {} {}", kFalseReasonNames[i], s.false_reasons[i]);
+    }
+    auto top_text = [&](const std::unordered_map<uint64_t, uint64_t>& hist) {
+      std::vector<std::pair<uint64_t, uint64_t>> top;
+      top.reserve(hist.size());
+      for (const auto& [key, n] : hist) top.emplace_back(n, key);
+      std::sort(top.rbegin(), top.rend());
+      std::string text;
+      for (size_t i = 0; i < top.size() && i < 10; ++i) {
+        const auto names = s.pair_names[top[i].second];
+        text += fmt::format(" {:016X}/{:016X}:{:.1f}", names.first, names.second, top[i].first / frames);
+      }
+      return text;
+    };
+    REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): last 10 s {:.0f} frames, {} main-pass draws ({:.1f}/frame){}{}{}",
+                frames, total, total / frames, kinds, reasons.empty() ? "" : " | false reasons:", reasons);
+    REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): top fallback pairs (draws/frame):{}",
+                top_text(s.pair_hist_fallback));
+    if (!s.pair_hist_false.empty()) {
+      REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): top returned-false pairs (draws/frame):{}",
+                  top_text(s.pair_hist_false));
+    }
+  }
+  std::memset(s.kind_draws, 0, sizeof(s.kind_draws));
+  std::memset(s.false_reasons, 0, sizeof(s.false_reasons));
+  s.pair_hist_fallback.clear();
+  s.pair_hist_false.clear();
+  s.pair_names.clear();
+  s.next_log = now_tick + 10000;
+  s.log_frame = g_prepass_frame;
+}
+
+// Number of guest float constants the translated VS reads (UINT32_MAX = dynamic addressing).
+static uint32_t VsFloatCount(const Shader& vs) {
+  const Shader::ConstantRegisterMap& map = vs.constant_register_map();
+  if (map.float_dynamic_addressing) return UINT32_MAX;
+  uint32_t n = 0;
+  for (uint32_t i = 0; i < 4; ++i) n += uint32_t(std::popcount(map.float_bitmap[i]));
+  return n;
+}
+
+// --- Ported pairs ----------------------------------------------------------------------------------
+
+static bool PortInitialize(uint32_t index) {
+  PortState& p = g_state.ports[index];
+  const PortDesc& d = kPorts[index];
+  p.vs.assign(d.vs, d.vs + d.vs_size);
+  p.ps.assign(d.ps, d.ps + d.ps_size);
+  const uint32_t ps_imprecise = NativeStripPreciseFlags(p.ps);
+  const bool vs_cleared = NativeClearRefactoringFlag(p.vs);
+  const bool ps_cleared = NativeClearRefactoringFlag(p.ps);
+  REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): port {} initialized (VS {} bytes, refactoring flag {}; PS {} bytes, "
+              "refactoring flag {}, precise masks cleared {})",
+              d.name, p.vs.size(), vs_cleared ? "cleared" : "NOT FOUND", p.ps.size(),
+              ps_cleared ? "cleared" : "NOT FOUND", ps_imprecise);
+  return vs_cleared && ps_cleared;
+}
+
+static bool FloatMapMatches(const Shader& shader, const uint8_t* floats, uint32_t count) {
+  const Shader::ConstantRegisterMap& map = shader.constant_register_map();
+  if (count == kDynamicFloats) return map.float_dynamic_addressing;
+  if (map.float_dynamic_addressing) return false;
+  uint64_t expected[4] = {};
+  for (uint32_t i = 0; i < count; ++i) expected[floats[i] >> 6] |= uint64_t(1) << (floats[i] & 63);
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (map.float_bitmap[i] != expected[i]) return false;
+  }
+  return true;
+}
+
+static bool PortPairOk(uint32_t index, const D3D12Shader& vs, const D3D12Shader& ps, bool vs_native) {
+  PortState& p = g_state.ports[index];
+  const uint64_t key = uint64_t(reinterpret_cast<uintptr_t>(&vs)) * 31 ^ uint64_t(reinterpret_cast<uintptr_t>(&ps));
+  auto it = p.pair_ok.find(key);
+  if (it != p.pair_ok.end()) return it->second;
+  const PortDesc& d = kPorts[index];
+  bool ok = true;
+  std::string why;
+  if (vs_native && !FloatMapMatches(vs, d.vs_floats, d.vs_float_count)) {
+    ok = false;
+    why += " vs-floats";
+  }
+  if (!FloatMapMatches(ps, d.ps_floats, d.ps_float_count)) {
+    ok = false;
+    why += " ps-floats";
+  }
+  const auto& textures = ps.GetTextureBindingsAfterTranslation();
+  const auto& samplers = ps.GetSamplerBindingsAfterTranslation();
+  for (uint32_t b = 0; b < d.binding_count; ++b) {
+    const uint32_t* e = d.bindings[b];
+    bool found_unsigned = false, found_signed = false, found_sampler = false;
+    for (const auto& t : textures) {
+      const xenos::FetchOpDimension expected_dimension = ((kPortCubeFetchMask[index] >> (e[0] & 31)) & 1)
+                                                              ? xenos::FetchOpDimension::kCube
+                                                              : xenos::FetchOpDimension::k2D;
+      if (t.fetch_constant != e[0] || t.dimension != expected_dimension) continue;
+      if (t.is_signed) {
+        found_signed |= t.bindless_descriptor_index == e[3];
+      } else {
+        found_unsigned |= t.bindless_descriptor_index == e[2];
+      }
+    }
+    for (const auto& sb : samplers) {
+      found_sampler |= sb.fetch_constant == e[0] && sb.bindless_descriptor_index == e[1];
+    }
+    if (!found_unsigned || !found_signed || !found_sampler) {
+      ok = false;
+      why += fmt::format(" tf{}", e[0]);
+    }
+  }
+  std::string text;
+  for (const auto& t : textures) {
+    text += fmt::format(" t[{}]=tf{}{}{}", t.bindless_descriptor_index, t.fetch_constant, t.is_signed ? "s" : "u",
+                        t.dimension == xenos::FetchOpDimension::k2D ? "" : "(not 2D)");
+  }
+  for (const auto& sb : samplers) {
+    text += fmt::format(" s[{}]=tf{}", sb.bindless_descriptor_index, sb.fetch_constant);
+  }
+  REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): port {} ({}, VS {:016X}) bindings {}{}; translated:{}", d.name,
+              vs_native ? "VS + PS" : "PS only", vs.ucode_data_hash(),
+              ok ? "OK" : "MISMATCH (fallback shader instead), differs:", why, text);
+  p.pair_ok.emplace(key, ok);
+  return ok;
+}
+
+// --- Fallback pixel shader -------------------------------------------------------------------------
+
+typedef HRESULT(WINAPI* NativeViewD3DCompile)(LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name,
+                                              const D3D_SHADER_MACRO* defines, ID3DInclude* include,
+                                              LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+                                              ID3DBlob** code, ID3DBlob** error_msgs);
+
+static const char kFallbackPsSource[] = R"(
+cbuffer xe_system_cbuffer : register(b0, space0) {
+  uint xe_flags : packoffset(c0.x);
+  uint4 xe_texture_swizzled_signs[2] : packoffset(c11);
+  float xe_alpha_test_reference : packoffset(c13.w);
+  float4 xe_color_exp_bias : packoffset(c15);
+};
+cbuffer xe_descriptor_indices_cbuffer : register(b4, space0) {
+  uint4 xe_descriptor_indices[64];
+};
+#if NV_TEXTURE
+SamplerState xe_samplers[] : register(s0, space0);
+Texture2DArray<float4> xe_textures_2d[] : register(t0, space1);
+#endif
+struct PsIn {
+#if NV_INTERPOLATORS
+  float4 i[NV_INTERPOLATORS] : TEXCOORD0;
+#endif
+#if NV_POINT
+  float2 pc : XESPRITETEXCOORD;
+#endif
+  float4 pos : SV_Position;
+};
+struct PsOut {
+#if NV_RT0
+  float4 c0 : SV_Target0;
+#endif
+#if NV_RT1
+  float4 c1 : SV_Target1;
+#endif
+#if NV_RT2
+  float4 c2 : SV_Target2;
+#endif
+#if NV_RT3
+  float4 c3 : SV_Target3;
+#endif
+};
+uint NvSlot(uint slot) { return xe_descriptor_indices[slot >> 2][slot & 3]; }
+// Per target: gamma conversion when the translated PS would do it (kSysFlag_ConvertColor0ToGamma = bit 10),
+// then the colour exponent bias scale.
+float4 NvOut(float4 color, uint rt, float exp_bias) {
+  if (((xe_flags >> (10u + rt)) & 1u) != 0u) {
+    color.rgb = sqrt(saturate(color.rgb));
+  }
+  color.rgb *= exp_bias;
+  return color;
+}
+PsOut main(PsIn input) {
+#if NV_SOLID
+  float4 color = float4(1.0, 0.0, 1.0, 1.0);
+#elif NV_TEXTURE
+  // One texture sample (the material's first 2D texture at its own coordinates), alpha test, nothing else.
+  float2 uv = float2(input.i[NV_UV_TC][NV_UV_X], input.i[NV_UV_TC][NV_UV_Y]);
+  float4 color = xe_textures_2d[NvSlot(NV_TEX_SLOT)].Sample(xe_samplers[NvSlot(NV_SAMPLER_SLOT)], float3(uv, 0.0));
+  uint signs = (xe_texture_swizzled_signs[NV_FETCH >> 4u][(NV_FETCH >> 2u) & 3u] >> ((NV_FETCH & 3u) * 8u)) & 0xFFu;
+  if ((signs & 3u) == 3u) {
+    color.rgb *= color.rgb;  // gamma texture, approximate to-linear
+  }
+  uint alpha_func = (xe_flags >> 7u) & 7u;
+  if (alpha_func != 7u) {
+    bool passed = (((alpha_func & 1u) != 0u) && color.a < xe_alpha_test_reference) ||
+                  (((alpha_func & 2u) != 0u) && color.a == xe_alpha_test_reference) ||
+                  (((alpha_func & 4u) != 0u) && color.a > xe_alpha_test_reference);
+    if (!passed) discard;
+  }
+#else
+  // No usable texture: grey, shaded by the screen-space depth slope so shapes stay readable.
+  float2 dz = float2(ddx(input.pos.z), ddy(input.pos.z)) * 3000.0;
+  float shade = 0.40 + 0.60 * saturate(dot(normalize(float3(-dz.x, dz.y, 1.0)), float3(0.45, 0.55, 0.70)));
+  float4 color = float4(0.62 * shade, 0.62 * shade, 0.60 * shade, 1.0);
+#endif
+#if NV_TINT
+  color.rgb = lerp(color.rgb, float3(1.0, 0.0, 1.0), 0.35);
+#endif
+  PsOut o;
+#if NV_RT0
+  o.c0 = NvOut(color, 0u, xe_color_exp_bias.x);
+#endif
+#if NV_RT1
+  o.c1 = NvOut(color, 1u, xe_color_exp_bias.y);
+#endif
+#if NV_RT2
+  o.c2 = NvOut(color, 2u, xe_color_exp_bias.z);
+#endif
+#if NV_RT3
+  o.c3 = NvOut(color, 3u, xe_color_exp_bias.w);
+#endif
+  return o;
+}
+)";
+
+static const std::vector<uint8_t>* FallbackPs(const FallbackKey& k) {
+  State& s = g_state;
+  const uint64_t key = k.Pack();
+  auto found = s.fallback_ps.find(key);
+  if (found != s.fallback_ps.end()) return &found->second;
+  if (s.fallback_failed.count(key)) return nullptr;
+  if (!s.compiler_tried) {
+    s.compiler_tried = true;
+    HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+    s.compile = compiler ? reinterpret_cast<void*>(GetProcAddress(compiler, "D3DCompile")) : nullptr;
+    if (!s.compile) {
+      REXGPU_ERROR("NATIVE VIEW COLOR (COLOR13): d3dcompiler_47.dll / D3DCompile not available");
+    }
+  }
+  if (!s.compile) {
+    s.fallback_failed.insert(key);
+    return nullptr;
+  }
+  std::string values[13] = {
+      std::to_string(k.interpolator_count), std::to_string(k.point_coordinates ? 1 : 0),
+      std::to_string(k.has_texture ? 1 : 0), std::to_string(k.texture_slot),
+      std::to_string(k.sampler_slot),        std::to_string(k.fetch_constant) + "u",
+      std::to_string(k.uv_texcoord),         std::to_string(k.uv_x),
+      std::to_string(k.uv_y),                std::to_string((k.color_targets >> 0) & 1),
+      std::to_string((k.color_targets >> 1) & 1),
+      std::to_string(k.tint ? 1 : 0),        std::to_string(k.solid ? 1 : 0)};
+  std::string rt2 = std::to_string((k.color_targets >> 2) & 1);
+  std::string rt3 = std::to_string((k.color_targets >> 3) & 1);
+  const D3D_SHADER_MACRO defines[] = {{"NV_INTERPOLATORS", values[0].c_str()},
+                                      {"NV_POINT", values[1].c_str()},
+                                      {"NV_TEXTURE", values[2].c_str()},
+                                      {"NV_TEX_SLOT", values[3].c_str()},
+                                      {"NV_SAMPLER_SLOT", values[4].c_str()},
+                                      {"NV_FETCH", values[5].c_str()},
+                                      {"NV_UV_TC", values[6].c_str()},
+                                      {"NV_UV_X", values[7].c_str()},
+                                      {"NV_UV_Y", values[8].c_str()},
+                                      {"NV_RT0", values[9].c_str()},
+                                      {"NV_RT1", values[10].c_str()},
+                                      {"NV_RT2", rt2.c_str()},
+                                      {"NV_RT3", rt3.c_str()},
+                                      {"NV_TINT", values[11].c_str()},
+                                      {"NV_SOLID", values[12].c_str()},
+                                      {nullptr, nullptr}};
+  // D3DCOMPILE_OPTIMIZATION_LEVEL3 (1 << 15) | D3DCOMPILE_ENABLE_UNBOUNDED_DESCRIPTOR_TABLES (1 << 20).
+  constexpr UINT kFlags = (1u << 15) | (1u << 20);
+  ID3DBlob* code = nullptr;
+  ID3DBlob* errors = nullptr;
+  HRESULT hr = reinterpret_cast<NativeViewD3DCompile>(s.compile)(
+      kFallbackPsSource, sizeof(kFallbackPsSource) - 1, "native_view_fallback_ps", defines, nullptr, "main",
+      "ps_5_1", kFlags, 0, &code, &errors);
+  if (errors) {
+    REXGPU_ERROR("NATIVE VIEW COLOR (COLOR13): fallback PS compiler output: {}",
+                 std::string(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize()));
+    errors->Release();
+  }
+  if (FAILED(hr) || !code) {
+    REXGPU_ERROR("NATIVE VIEW COLOR (COLOR13): fallback PS compile failed (0x{:08X}), key {:016X}", uint32_t(hr),
+                 key);
+    if (code) code->Release();
+    s.fallback_failed.insert(key);
+    return nullptr;
+  }
+  std::vector<uint8_t> bytes(static_cast<const uint8_t*>(code->GetBufferPointer()),
+                             static_cast<const uint8_t*>(code->GetBufferPointer()) + code->GetBufferSize());
+  code->Release();
+  auto inserted = s.fallback_ps.emplace(key, std::move(bytes)).first;
+  if (s.fallback_ps.size() <= 64 || (s.fallback_ps.size() & 63) == 0) {
+    REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): fallback PS variant {} compiled (key {:016X}, {} bytes; "
+                "interpolators {}, texture {} tf{} slot {} sampler {} tc{}.{}{})",
+                s.fallback_ps.size(), key, inserted->second.size(), k.interpolator_count, k.has_texture ? 1 : 0,
+                k.fetch_constant, k.texture_slot, k.sampler_slot, k.uv_texcoord, "xyzw"[k.uv_x], "xyzw"[k.uv_y]);
+  }
+  return &inserted->second;
+}
+
+// Fills the fallback key from the translated PS and the pixel shader modification. Texture: among the 2D
+// fetches whose coordinates come straight from an interpolator register, the one most likely to be the base
+// colour map (ported materials: tf0 = base colour, tf14 = screen-space clip mask, tf15 = shadow map, others
+// detail / normal / mask maps, often fetched first): lowest score wins, score =
+//   fetch constant (tf0 best) | +64 tf14/tf15 | +32 fewer than 3 colour components used (normal / mask map)
+//   | +128 texel offsets (shadow PCF taps) | +16 predicated fetch. Best score >= 32 = no colour map: untextured grey.
+static void BuildFallbackKey(const D3D12Shader& ps, const D3D12Shader::D3D12Translation& ps_tr, bool tint,
+                             bool solid, FallbackKey& k, std::string* candidates = nullptr) {
+  const DxbcShaderTranslator::Modification mod(ps_tr.modification());
+  const uint32_t interpolator_mask = mod.pixel.interpolator_mask;
+  k = FallbackKey();
+  k.interpolator_count = uint32_t(std::popcount(interpolator_mask));
+  k.point_coordinates = mod.pixel.param_gen_point != 0;
+  k.color_targets = ps.writes_color_targets() & 0xF;
+  if (!k.color_targets) k.color_targets = 1;
+  k.tint = tint;
+  k.solid = solid;
+  if (solid) return;
+  const auto& dxbc_textures = ps.GetTextureBindingsAfterTranslation();
+  const auto& dxbc_samplers = ps.GetSamplerBindingsAfterTranslation();
+  uint32_t best_score = UINT32_MAX;
+  for (const Shader::TextureBinding& tb : ps.texture_bindings()) {
+    const ParsedTextureFetchInstruction& f = tb.fetch_instr;
+    if (f.opcode != ucode::FetchOpcode::kTextureFetch || f.dimension != xenos::FetchOpDimension::k2D ||
+        f.attributes.unnormalized_coordinates || f.operand_count < 1) {
+      continue;
+    }
+    uint32_t score = tb.fetch_constant & 31;
+    if (tb.fetch_constant >= 14) score += 64;
+    if (std::popcount(f.result.GetUsedResultComponents() & 0x7u) < 3) score += 32;
+    if (f.attributes.offset_x != 0.0f || f.attributes.offset_y != 0.0f) score += 128;
+    if (f.is_predicated) score += 16;
+    if (candidates) {
+      *candidates += fmt::format(" tf{}(score {}, comps {:X})", tb.fetch_constant, score,
+                                 f.result.GetUsedResultComponents());
+    }
+    if (score >= best_score) continue;
+    const InstructionOperand& op = f.operands[0];
+    if (op.storage_source != InstructionStorageSource::kRegister ||
+        op.storage_addressing_mode != InstructionStorageAddressingMode::kAbsolute || op.storage_index >= 16 ||
+        !(interpolator_mask & (uint32_t(1) << op.storage_index))) {
+      continue;
+    }
+    if (mod.pixel.param_gen_enable && mod.pixel.param_gen_interpolator == op.storage_index) continue;
+    const uint32_t cx = uint32_t(op.GetComponent(0)), cy = uint32_t(op.GetComponent(1));
+    if (cx > 3 || cy > 3) continue;
+    uint32_t texture_slot = UINT32_MAX, sampler_slot = UINT32_MAX;
+    for (const auto& t : dxbc_textures) {
+      if (t.fetch_constant == tb.fetch_constant && t.dimension == xenos::FetchOpDimension::k2D && !t.is_signed) {
+        texture_slot = t.bindless_descriptor_index;
+        break;
+      }
+    }
+    for (const auto& sb : dxbc_samplers) {
+      if (sb.fetch_constant == tb.fetch_constant) {
+        sampler_slot = sb.bindless_descriptor_index;
+        break;
+      }
+    }
+    if (texture_slot >= 256 || sampler_slot >= 256) continue;
+    best_score = score;
+    k.has_texture = true;
+    k.texture_slot = texture_slot;
+    k.sampler_slot = sampler_slot;
+    k.fetch_constant = tb.fetch_constant & 31;
+    k.uv_texcoord = uint32_t(std::popcount(interpolator_mask & ((uint32_t(1) << op.storage_index) - 1)));
+    k.uv_x = cx;
+    k.uv_y = cy;
+  }
+  // Only normal / mask / single-channel maps (score >= 32: fewer than 3 colour components, tf14/15, PCF taps):
+  // they look white / red-green as colour, the shaded untextured grey is closer to the lit material.
+  if (k.has_texture && best_score >= 32) {
+    k.has_texture = false;
+    k.texture_slot = k.sampler_slot = k.fetch_constant = 0;
+    k.uv_texcoord = k.uv_x = k.uv_y = 0;
+  }
+}
+
+// Per-frame limit on new material pipelines (creation is synchronous on the CP thread).
+static bool PipelineBudget(void* pipeline_handle, uint32_t id) {
+  State& s = g_state;
+  const uintptr_t key = reinterpret_cast<uintptr_t>(pipeline_handle) | id;
+  if (s.known_pipelines.count(key)) return true;
+  if (s.budget_frame != g_prepass_frame) {
+    s.budget_frame = g_prepass_frame;
+    s.budget_used = 0;
+  }
+  if (s.budget_used >= kPipelineBudgetPerFrame) return false;
+  ++s.budget_used;
+  s.known_pipelines.insert(key);
+  return true;
+}
+
+// The selection itself. Returns the PSO to bind for the native draw (same root signature and root
+// arguments as the emulated draw), or nullptr = not handled (the caller re-issues the emulated PSO).
+static ID3D12PipelineState* Select(PipelineCache& pipeline_cache, void* pipeline_handle,
+                                   const D3D12Shader* vertex_shader, const D3D12Shader* pixel_shader, D3D12Shader::D3D12Translation* vs_tr,
+                                   D3D12Shader::D3D12Translation* ps_tr, bool bindless, bool host_render_targets,
+                                   bool memexport, bool tessellated, bool depth_test, bool depth_write,
+                                   uint32_t vertex_count) {
+  State& s = g_state;
+  Poll(GetTickCount64());
+  const uint64_t vs_hash = vertex_shader ? vertex_shader->ucode_data_hash() : 0;
+  const uint64_t ps_hash = pixel_shader ? pixel_shader->ucode_data_hash() : 0;
+  auto fail = [&](FalseReason reason) -> ID3D12PipelineState* {
+    ++s.kind_draws[kKindFalse];
+    ++s.false_reasons[reason];
+    NoteHist(s.pair_hist_false, vs_hash, ps_hash);
+    return nullptr;
+  };
+  if (!pipeline_handle || !vertex_shader || !vs_tr) return fail(kFrState);
+  if (!pixel_shader || !ps_tr) return fail(kFrNoPs);
+  if (!bindless || !host_render_targets || memexport || tessellated) return fail(kFrState);
+  const bool modification_ff = vs_tr->modification() == 0xFF && ps_tr->modification() == 0xFF;
+
+  // 1. city_main: the pair (VS + PS native, id 1 = CityMain mode 1) or the city PS with another translated VS
+  //    (PS only, id 3 = CityMain mode 3; same 8-interpolator interface, modification 0xFF).
+  if (ps_hash == 0xD21BBFA693592F65ull && !s.city_main_off && modification_ff) {
+    const bool vs_native = vs_hash == 0xB910C2C14CFA4FFCull;
+    CityMainState& cm = g_city_main;
+    if (!cm.init_tried) {
+      cm.init_tried = true;
+      cm.init_ok = CityMainInitialize();
+    }
+    if (cm.init_ok) {
+      auto bindings_it = cm.ps_bindings_ok.find(pixel_shader);
+      if (bindings_it == cm.ps_bindings_ok.end()) {
+        bindings_it = cm.ps_bindings_ok.emplace(pixel_shader, CityMainBindingsOk(*pixel_shader)).first;
+      }
+      if (bindings_it->second) {
+        const uint32_t id = vs_native ? 1 : 3;
+        if (!PipelineBudget(pipeline_handle, id)) return fail(kFrBudget);
+        uint32_t failure = 0;
+        ID3D12PipelineState* pso = pipeline_cache.GetNativeMaterialPipeline(
+            pipeline_handle, vs_tr, ps_tr, vs_native ? cm.vs.data() : nullptr, cm.vs.size(), cm.ps.data(),
+            cm.ps.size(), id, &failure);
+        if (pso) {
+          ++s.kind_draws[vs_native ? kKindCityMain : kKindCityMainPs];
+          return pso;
+        }
+        if (failure == 1) {
+          s.known_pipelines.erase(reinterpret_cast<uintptr_t>(pipeline_handle) | id);
+          return fail(kFrPsoNotReady);
+        }
+        // PSO failed: fall through to the fallback shader.
+      }
+    }
+  }
+
+  // 2. Ported pairs (VS + PS), or the ported PS with another translated VS of the same interface (PS only).
+  //    Both need the port's interpolator interface in the translation modifications.
+  if (!s.ports_off) {
+    uint32_t selected = kPortCount;
+    for (uint32_t j = 0; j < kPortCount; ++j) {
+      if (kPorts[j].ps_hash != ps_hash) continue;
+      if (kPorts[j].vs_hash == vs_hash) {
+        selected = j;
+        break;
+      }
+      if (selected == kPortCount) selected = j;
+    }
+    for (uint32_t i = selected; i < kPortCount; ++i) {
+      const PortDesc& d = kPorts[i];
+      if (ps_hash != d.ps_hash) continue;
+      if (d.nodepth_gated && !s.nodepth_ports) break;
+      if (!s.port_enabled[i]) break;
+      const bool vs_native = vs_hash == d.vs_hash && (kPortVsVerified[i] || s.ports_unverified);
+      PortState& p = s.ports[i];
+      const DxbcShaderTranslator::Modification vs_mod(vs_tr->modification()), ps_mod(ps_tr->modification());
+      if (vs_mod.vertex.interpolator_mask != d.interpolator_mask ||
+          ps_mod.pixel.interpolator_mask != d.interpolator_mask || ps_mod.pixel.param_gen_enable) {
+        if (p.modification_logs < 4) {
+          ++p.modification_logs;
+          REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): port {} skipped for VS {:016X}: modifications VS {:016X} PS {:016X} "
+                      "(port interface mask {:X})",
+                      d.name, vs_hash, vs_tr->modification(), ps_tr->modification(), d.interpolator_mask);
+        }
+        break;
+      }
+      if (!p.init_tried) {
+        p.init_tried = true;
+        p.init_ok = PortInitialize(i);
+      }
+      if (!p.init_ok || !PortPairOk(i, *vertex_shader, *pixel_shader, vs_native)) break;
+      if (!PipelineBudget(pipeline_handle, 4)) return fail(kFrBudget);
+      uint32_t failure = 0;
+      ID3D12PipelineState* pso = pipeline_cache.GetNativeMaterialPipeline(
+          pipeline_handle, vs_tr, ps_tr, vs_native ? p.vs.data() : nullptr, p.vs.size(), p.ps.data(), p.ps.size(),
+          4, &failure);
+      if (pso) {
+        ++s.kind_draws[(vs_native ? kKindPort0 : kKindPortPs0) + i];
+        return pso;
+      }
+      if (failure == 1) {
+        s.known_pipelines.erase(reinterpret_cast<uintptr_t>(pipeline_handle) | 4);
+        return fail(kFrPsoNotReady);
+      }
+      break;  // PSO failed: fallback shader
+    }
+  }
+
+  // 3. Fallback: translated VS + our PS. Draws without a depth test (full-screen passes, HUD) are left out
+  //    unless dist\native_view_fallback_nodepth: a full-screen pass with its first texture drawn as colour covers
+  //    the whole city (v12k: a noise / normal texture over the native half).
+  if (s.fallback_off) return fail(kFrDisabled);
+  if (!depth_test && !s.fallback_nodepth) {
+    const uint32_t vs_floats = VsFloatCount(*vertex_shader);
+    if (s.nodepth_logged.size() < 48 && s.nodepth_logged.insert(PairKey(vs_hash, ps_hash)).second) {
+      REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): no-depth pair {:016X}/{:016X}: VS float constants {}, PS fetches {}, "
+                  "colour targets {:X}, depth write {}, vertices {}",
+                  vs_hash, ps_hash, vs_floats == UINT32_MAX ? std::string("dynamic") : std::to_string(vs_floats),
+                  pixel_shader->texture_bindings().size(), pixel_shader->writes_color_targets(), depth_write ? 1 : 0,
+                  vertex_count);
+    }
+    // World-space no-depth passes (sky dome etc.: the VS reads at least a 4x4 transform) under
+    // dist\native_view_nodepth_world; screen-space passes (no transform: full-screen quads, HUD) never.
+    if (!s.nodepth_world || vs_floats < 4 || vertex_count <= 6 || depth_write) return fail(kFrNoDepth);
+  }
+  FallbackKey key;
+  const bool describe =
+      s.fallback_logged.size() < 128 && s.fallback_logged.insert(PairKey(vs_hash, ps_hash)).second;
+  std::string candidates;
+  BuildFallbackKey(*pixel_shader, *ps_tr, s.tint, s.solid, key, describe ? &candidates : nullptr);
+  if (describe) {
+    REXLOG_INFO("NATIVE VIEW COLOR (COLOR13): fallback pair {:016X}/{:016X} uses {} (tc{}.{}{}); fetches:{}", vs_hash,
+                ps_hash, key.has_texture ? fmt::format("tf{}", key.fetch_constant) : std::string("no texture"),
+                key.uv_texcoord, "xyzw"[key.uv_x & 3], "xyzw"[key.uv_y & 3], candidates);
+  }
+  const uint32_t id = s.solid ? 7 : s.tint ? 6 : 5;
+  if (!PipelineBudget(pipeline_handle, id)) return fail(kFrBudget);
+  const std::vector<uint8_t>* ps_bytes = FallbackPs(key);
+  if (!ps_bytes) return fail(kFrCompile);
+  uint32_t failure = 0;
+  ID3D12PipelineState* pso = pipeline_cache.GetNativeMaterialPipeline(
+      pipeline_handle, vs_tr, ps_tr, nullptr, 0, ps_bytes->data(), ps_bytes->size(), id, &failure);
+  if (!pso) {
+    if (failure == 1) {
+      s.known_pipelines.erase(reinterpret_cast<uintptr_t>(pipeline_handle) | id);
+      return fail(kFrPsoNotReady);
+    }
+    return fail(kFrPsoFailed);
+  }
+  ++s.kind_draws[kKindFallback];
+  NoteHist(s.pair_hist_fallback, vs_hash, ps_hash);
+  return pso;
+}
+
+}  // namespace native_view_color
+
+// Pipeline selection without recording (VIEW12's batched replay binds and draws it): our PSO for this draw
+// (same root signature + root arguments as the emulated draw), or nullptr = not handled.
+#define NATIVE_VIEW_COLOR_HAS_PIPELINE 1
+static ID3D12PipelineState* NativeViewColorPipeline(const NativeViewDrawCtx& ctx) {
+  if (!ctx.cp || !ctx.pipeline_cache || !ctx.pipeline_handle || !ctx.ppr || ctx.native_shader) {
+    native_view_color::Poll(GetTickCount64());
+    ++native_view_color::g_state.kind_draws[native_view_color::kKindFalse];
+    ++native_view_color::g_state.false_reasons[native_view_color::kFrState];
+    return nullptr;
+  }
+  return native_view_color::Select(
+      *ctx.pipeline_cache, ctx.pipeline_handle, ctx.vs, ctx.ps, ctx.vs_translation, ctx.ps_translation,
+      ctx.bindless, true, false, ctx.ppr->IsTessellated(),
+      ctx.depth_control.z_enable != 0 && ctx.depth_control.zfunc != xenos::CompareFunction::kAlways,
+      ctx.depth_control.z_enable != 0 && ctx.depth_control.z_write_enable != 0, ctx.vertex_count);
+}
+
+// Per-draw path (dist\native_view_nobatch): called with the native targets bound and the emulated draw's root
+// signature + root arguments still bound. Binds our PSO and re-issues the draw; false = not handled.
+static bool NativeViewColorDraw(const NativeViewDrawCtx& ctx) {
+  ID3D12PipelineState* pso = NativeViewColorPipeline(ctx);
+  if (!pso) return false;
+  ctx.cp->SetExternalPipeline(pso);
+  if (ctx.indexed) {
+    ctx.cl->D3DDrawIndexedInstanced(ctx.vertex_count, 1, ctx.start_index, 0, 0);
+  } else {
+    ctx.cl->D3DDrawInstanced(ctx.vertex_count, 1, 0, 0);
+  }
+  return true;
+}
