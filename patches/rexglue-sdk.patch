+    if (len == 4) { uint32_t v; std::memcpy(&v, tmp.data(), 4); *reinterpret_cast<rex::be<uint32_t>*>(static_cast<void*>(optval_ptr)) = v; }
+    else std::memcpy(optval_ptr, tmp.data(), size_t(len));
+    *optlen_ptr = uint32_t(len);
+  }
+  return 0;
+}
