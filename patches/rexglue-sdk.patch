+// Perf round 5 (2026-10-23): host thread priority tuning helpers used by
+// rex::system (xthread.cpp). Matches thread descriptions (names) by substring.
+namespace sched5 {
+
+typedef HRESULT (*GetThreadDescriptionFn)(HANDLE hThread, PWSTR* ppszThreadDescription);
+
+void ApplyThreadPriorities(const std::vector<std::pair<std::string, int>>& rules,
+                           std::vector<std::string>* applied) {
+  static auto get_desc = (GetThreadDescriptionFn)GetProcAddress(
+      GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription");
+  if (!get_desc || rules.empty()) {
+    return;
+  }
+  const DWORD pid = GetCurrentProcessId();
+  HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+  if (snap == INVALID_HANDLE_VALUE) {
+    return;
+  }
+  THREADENTRY32 te{};
+  te.dwSize = sizeof(te);
+  for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+    if (te.th32OwnerProcessID != pid) {
+      continue;
+    }
+    HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION | THREAD_SET_LIMITED_INFORMATION, FALSE,
+                          te.th32ThreadID);
+    if (!h) {
+      continue;
+    }
+    PWSTR wdesc = nullptr;
+    if (SUCCEEDED(get_desc(h, &wdesc)) && wdesc) {
+      char name[256];
+      int n = WideCharToMultiByte(CP_UTF8, 0, wdesc, -1, name, sizeof(name), nullptr, nullptr);
+      LocalFree(wdesc);
+      if (n > 0) {
+        const std::string_view sv(name);
+        for (const auto& rule : rules) {
+          if (!rule.first.empty() && sv.find(rule.first) != std::string_view::npos) {
+            const int current = GetThreadPriority(h);
+            if (current != rule.second && current != THREAD_PRIORITY_ERROR_RETURN) {
+              if (SetThreadPriority(h, rule.second) && applied) {
+                applied->push_back(std::string(sv) + " -> " + std::to_string(rule.second));
+              }
+            }
+            break;
+          }
+        }
+      }
+    }
+    CloseHandle(h);
+  }
+  CloseHandle(snap);
+}
+
+void DisableProcessPriorityBoost() {
+  SetProcessPriorityBoost(GetCurrentProcess(), TRUE);
+}
+
+void SetCurrentThreadPriority(int priority) {
+  SetThreadPriority(GetCurrentThread(), priority);
+}
+
+void YieldSleep0() {
+  ::Sleep(0);
+}
+
+uint32_t ProcessLogicalProcessorCount() {
+  DWORD_PTR process_mask = 0, system_mask = 0;
+  if (!GetProcessAffinityMask(GetCurrentProcess(), &process_mask, &system_mask)) {
+    return 0;
+  }
+  uint32_t count = 0;
+  for (; process_mask; process_mask &= process_mask - 1) {
+    ++count;
+  }
+  return count;
+}
