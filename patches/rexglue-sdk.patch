+std::string SpecViews(const std::vector<StatsSpec>& specs, char sep) {
+  std::string s;
+  for (const auto& sp : specs) {
+    if (!s.empty()) s += sep;
+    s += std::to_string(sp.view);
+  }
+  return s;
+}
