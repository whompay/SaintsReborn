+  kNvSkipNoClass,     // draw outside the tapped classes
+  kNvSkipOtherMode,   // class not shown by the current mode (split/native: main only, depth: pre-pass only)
+  kNvSkipNotNative,   // no native shader for it (and no native_view_reissue_all)
+  kNvSkipSeedDraw,    // first main draw of the frame: used to seed the native depth, not replayed
+  kNvSkipCount
+};
+static const char* const kNvSkipNames[kNvSkipCount] = {"path",       "rt_invalid", "slot_gap",  "create",
