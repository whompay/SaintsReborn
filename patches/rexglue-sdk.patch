+  uint32_t n_examples = 0;
+};
+
+struct M3State {
+  std::mutex mutex;
+  std::unordered_map<uint32_t, M3Record> recs;
+  size_t word_bytes = 0;
+  uint32_t next_id = 1;
+  std::unordered_map<uint64_t, M3Key> keys;
+  uint64_t swaps = 0;
+  M3Window w;
+  uint64_t last_log = 0, qpc0 = 0, tsc0 = 0;
