+}  // namespace
+
+bool Enabled(uint64_t frame) {
+  if (frame < g_next_check_frame) return g_enabled;
+  g_next_check_frame = frame + 120;
+  std::string text;
+  bool on = false;
+  if (ReadFile("scene_post", text)) {
+    std::string unused;
+    on = !ReadFile("scene_post.off", unused);
+  }
+  if (on != g_enabled || (on && text != g_file_text)) {
+    g_file_text = text;
+    ParseOptions(text, g_options);
+    g_apply_index = 0;
+    g_history_reset = true;
+    const Options& o = g_options;
+    if (on) {
+      REXLOG_INFO(
+          "Scene post: ON ao {} (radius {} strength {} max {} px samples {} div {} fov {}) bloom {} "
+          "(threshold {} strength {} radius {}) tonemap {} (exposure {} contrast {} saturation {} "
+          "vibrance {} filmic {} split {} temperature {} tint {} shoulder {} white {} lift {} black "
+          "{} vignette {} sharpen {}) sky {} {} (horizon {} top {}/{}/{} horizon {}/{}/{}) void {} "
+          "{} haze {} {} ({}..{}) ao_color {} skylight {} clarity {} uav {} ao_split {} ao_fused {} sky_sums {} lag {} ao_lag1 {} ao_far {} v15 {} debug {} dest {:08X}",
+          o.ao, o.ao_radius, o.ao_strength, o.ao_max_px, o.ao_samples, o.ao_div, o.fov, o.bloom,
+          o.bloom_threshold, o.bloom_strength, o.bloom_radius, o.tonemap, o.exposure, o.contrast,
+          o.saturation, o.vibrance, o.filmic, o.split, o.temperature, o.tint, o.shoulder, o.white,
+          o.lift, o.black, o.vignette, o.sharpen, o.sky_on, o.sky, o.horizon, o.sky_top[0],
+          o.sky_top[1], o.sky_top[2], o.sky_horizon[0], o.sky_horizon[1], o.sky_horizon[2],
+          o.void_on, o.void_level, o.haze_on, o.haze, o.haze_start, o.haze_end, o.ao_color, o.skylight,
+          o.clarity, o.uav, o.ao_split, o.ao_fused, o.sky_sums, o.lag, o.ao_lag1, o.ao_far, o.v15, o.debug, o.dest);
+    } else {
+      REXLOG_INFO("Scene post: off");
+    }
+  }
+  const bool report = (g_checks % 8) == 0;
+  if (on && g_frames && report) {
+    std::string skips;
+    for (const auto& skip : g_skips) skips += fmt::format(" | skipped {}x: {}", skip.second, skip.first);
+    REXLOG_INFO("Scene post: applied {} times in {} frames, scene resolves/frame {} ({} changes){}",
+                g_applied, g_frames, g_count_previous, g_count_changes, skips);
+    REXLOG_INFO(
+        "Scene post: picker (MAIN20) {} | frames picked by signature {} by count {} | NOT picked {} | "
+        "picked too early (another scene resolve after it) {} | signature {:08X}",
+        g_options.count_pick ? "count (option)" : "signature", g_pick_sig, g_pick_count, g_pick_none,
+        g_pick_early, g_sig_pred);
+  }
+  // Trace the scene resolves of one frame for the first few reports.
+  g_trace_left = (on && report && g_checks < 8 * 4) ? 3 : 0;
+  ++g_checks;
+  if (report) {
+    g_skips.clear();
+    g_applied = g_frames = 0;
+    g_count_changes = 0;
+    g_pick_sig = g_pick_count = g_pick_none = g_pick_early = 0;
+  }
+  g_enabled = on;
+  return on;
+}
+
+uint32_t SceneDestAddress() { return g_options.dest; }
+
+bool WantsTrace() { return g_trace_left != 0; }
+
+void Trace(const std::string& line) {
+  if (!g_trace_left) return;
+  --g_trace_left;
+  REXLOG_INFO("Scene post: resolve {}", line);
+}
+
+void NoteSkip(const char* reason) {
+  for (auto& skip : g_skips) {
+    if (skip.first == reason || std::strcmp(skip.first, reason) == 0) {
+      ++skip.second;
+      return;
+    }
+  }
+  if (g_skips.size() < 8) g_skips.emplace_back(reason, 1u);
+}
+
+bool IsLastSceneResolve(uint64_t frame, uint32_t prev_dest, bool clearing_color) {
+  if (frame != g_count_frame) {
+    if (g_count_frame != UINT64_MAX) {
+      // Learn the signature of the completed frame's final scene resolve.
+      const uint32_t learned = g_frame_last_clear ? 0u : g_frame_last_pred;
+      g_sig_ok = learned != 0 && learned == g_sig_pred;
+      g_sig_pred = learned;
+      if (!g_frame_picked) ++g_pick_none;
+      // The completed frame had another number of scene resolves than the
+      // one its apply was chosen with: with the index picker that apply may
+      // have seen an incomplete scene, so nothing it wrote is valid history.
+      // (The signature picker does not depend on the count.)
+      if (g_count != g_count_previous) {
+        ++g_count_changes;
+        if (!g_frame_sig) g_history_reset = true;
+      }
+      g_count_previous = g_count;
+    }
+    g_count_frame = frame;
+    g_count = 0;
+    ++g_frames;
+    g_frame_sig = g_sig_ok && !g_options.count_pick;
+    g_frame_picked = false;
+  }
+  ++g_count;
+  // A scene resolve after the picked one: the apply came too early.
+  if (g_frame_picked) ++g_pick_early;
+  g_frame_last_pred = prev_dest;
+  g_frame_last_clear = clearing_color;
+  bool last;
+  if (g_frame_sig) {
+    last = !g_frame_picked && !clearing_color && prev_dest == g_sig_pred;
+    if (last) ++g_pick_sig;
+  } else {
+    last = !g_frame_picked && g_count == g_count_previous;
+    if (last) ++g_pick_count;
+  }
+  if (last) g_frame_picked = true;
+  // A gap (frames without a successful apply) invalidates the history; the
+  // apply frame itself is recorded by NoteApplyResult.
+  if (last && frame != g_last_apply_frame + 1) g_history_reset = true;
+  return last;
+}
+
+void NoteApplyResult(uint64_t frame, bool applied) {
+  if (applied) {
+    g_last_apply_frame = frame;
+  } else {
+    g_history_reset = true;
+  }
+}
+
+void Shutdown() {
+  // Releases everything created on the old device; the next Apply starts
+  // over (initialization, textures, history).
+  delete g_state;
+  g_state = nullptr;
+  g_history_reset = true;
+  g_last_apply_frame = UINT64_MAX - 1;
+  g_apply_index = 0;
+  g_count_frame = UINT64_MAX;
+  g_count = g_count_previous = 0;
+  g_sig_pred = 0;
+  g_sig_ok = g_frame_sig = g_frame_picked = false;
+}
+
+bool WantsUavRenderTargets() {
+  // Decided once (render targets are created early and live long): the
+  // switch file must exist at the first call; "nouav" in it keeps the plain
+  // render targets (copy-back path).
+  static int wants = -1;
+  if (wants < 0) {
+    std::string text, unused;
+    wants = ReadFile("scene_post", text) && !ReadFile("scene_post.off", unused) ? 1 : 0;
+    if (wants) {
+      Options o;
+      ParseOptions(text, o);
+      wants = o.uav ? 1 : 0;
+    }
+    REXLOG_INFO("Scene post: plain 8888 colour render targets {} UAV access", wants ? "with" : "without");
+  }
+  return wants != 0;
+}
+
+bool Apply(D3D12CommandProcessor& cp, const Target& target, D3D12_RESOURCE_STATES& color_state) {
+  if (!g_state) g_state = new State();
+  State& s = *g_state;
+  if (!s.init_tried) {
+    s.init_tried = true;
+    s.init_ok = Initialize(cp, s);
+  }
+  if (!s.init_ok || !target.color || !target.depth || !target.width || !target.height) return false;
+  const Options& o = g_options;
+
+  // Free textures replaced by a size change once the GPU is done with them.
+  const uint64_t completed = cp.GetCompletedSubmission();
+  s.retired.erase(std::remove_if(s.retired.begin(), s.retired.end(),
+                                 [&](const auto& r) { return r.first <= completed; }),
+                  s.retired.end());
+
+  const D3D12_RESOURCE_DESC color_desc = target.color->GetDesc();
+  const bool in_place = o.uav && s.in_place_ok &&
+                        (color_desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) &&
+                        color_desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM;
+  if (!s.logged_path) {
+    s.logged_path = true;
+    REXLOG_INFO("Scene post: final pass {}", in_place ? "in place (colour UAV, no copy back)"
+                                                      : "into a copy (copied back)");
+  }
+
+  const uint32_t w = target.width, h = target.height;
+  const uint32_t ao_div =
+      uint32_t(std::clamp(o.ao_div ? o.ao_div : int(2 * std::max(1u, target.scale)), 1, 8));
+  const uint32_t aw = (w + ao_div - 1) / ao_div, ah = (h + ao_div - 1) / ao_div;
+  // 1/8 res bloom = one texel per 8x8 final group.
+  const uint32_t ew = (w + 7) / 8, eh = (h + 7) / 8;
+  const DXGI_FORMAT f16 = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  bool any_created = false, sky_created = false, lut_created = false;
+  bool ok = EnsureTexture(cp, s, s.ao_raw, aw, ah, f16, &any_created) &&
+            (in_place || EnsureTexture(cp, s, s.out, w, h, DXGI_FORMAT_R8G8B8A8_UNORM)) &&
+            EnsureTexture(cp, s, s.lut, kLutSize, kLutSize, f16, &lut_created, kLutSize);
+  for (int i = 0; i < 2 && ok; ++i) {
+    ok = EnsureTexture(cp, s, s.ao[i], aw, ah, f16, &any_created) &&
+         EnsureTexture(cp, s, s.bright[i], ew, eh, f16, &any_created) &&
+         EnsureTexture(cp, s, s.blur[i], ew, eh, f16, &any_created) &&
+         EnsureTexture(cp, s, s.sum[i], ew, eh, f16, &any_created) &&
+         EnsureTexture(cp, s, s.sky[i], 4, 1, DXGI_FORMAT_R32_FLOAT, &sky_created);
+  }
+  if (!ok) {
+    REXLOG_ERROR("Scene post: could not create its textures; switched off");
+    s.init_ok = false;
+    return false;
+  }
+  if (sky_created || any_created || g_history_reset) g_apply_index = 0;
+  if (lut_created) s.lut_valid = false;
+  if (any_created || sky_created || g_history_reset) s.streak = 0;
+  g_history_reset = false;
+  const uint32_t cur = s.parity, prv = cur ^ 1u;
+
+  // Descriptors (one-use, shader visible). Pairs: +0 / +1 = [0] / [1].
+  enum {
+    kSrvColor, kSrvDepth, kSrvAoRaw, kSrvAo, kSrvAo1, kSrvBright, kSrvBright1, kSrvBlur, kSrvBlur1,
+    kSrvSum, kSrvSum1, kSrvSky, kSrvSky1, kSrvLut,
+    kUavAoRaw, kUavAo, kUavAo1, kUavBright, kUavBright1, kUavBlur, kUavBlur1, kUavSum, kUavSum1,
+    kUavSky, kUavSky1, kUavOut, kUavLut,
+    kDescriptorCount
+  };
+  ui::d3d12::util::DescriptorCpuGpuHandlePair hd[kDescriptorCount];
+  if (!cp.RequestOneUseSingleViewDescriptors(kDescriptorCount, hd)) return false;
+  s.last_submission = cp.GetCurrentSubmission();
+  ID3D12Device* device = cp.GetD3D12Provider().GetDevice();
+  device->CopyDescriptorsSimple(1, hd[kSrvColor].first, target.color_srv,
+                                D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  device->CopyDescriptorsSimple(1, hd[kSrvDepth].first, target.depth_srv,
+                                D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  auto srv = [&](Texture& t, int index) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC d = {};
+    d.Format = t.resource->GetDesc().Format;
+    d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    d.Texture2D.MipLevels = 1;
+    device->CreateShaderResourceView(t.resource.Get(), &d, hd[index].first);
+  };
+  auto uav = [&](ID3D12Resource* r, DXGI_FORMAT format, int index) {
+    D3D12_UNORDERED_ACCESS_VIEW_DESC d = {};
+    d.Format = format;
+    d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    device->CreateUnorderedAccessView(r, nullptr, &d, hd[index].first);
+  };
+  auto uavt = [&](Texture& t, int index) { uav(t.resource.Get(), t.resource->GetDesc().Format, index); };
+  srv(s.ao_raw, kSrvAoRaw);
+  uavt(s.ao_raw, kUavAoRaw);
+  for (int i = 0; i < 2; ++i) {
+    srv(s.ao[i], kSrvAo + i);
+    srv(s.bright[i], kSrvBright + i);
+    srv(s.blur[i], kSrvBlur + i);
+    srv(s.sum[i], kSrvSum + i);
+    srv(s.sky[i], kSrvSky + i);
+    uavt(s.ao[i], kUavAo + i);
+    uavt(s.bright[i], kUavBright + i);
+    uavt(s.blur[i], kUavBlur + i);
+    uavt(s.sum[i], kUavSum + i);
+    uavt(s.sky[i], kUavSky + i);
+  }
+  {
+    D3D12_SHADER_RESOURCE_VIEW_DESC d = {};
+    d.Format = f16;
+    d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE3D;
+    d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    d.Texture3D.MipLevels = 1;
+    device->CreateShaderResourceView(s.lut.resource.Get(), &d, hd[kSrvLut].first);
+    D3D12_UNORDERED_ACCESS_VIEW_DESC u = {};
+    u.Format = f16;
+    u.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE3D;
+    u.Texture3D.WSize = kLutSize;
+    device->CreateUnorderedAccessView(s.lut.resource.Get(), nullptr, &u, hd[kUavLut].first);
+  }
+  if (in_place) {
+    uav(target.color, DXGI_FORMAT_R8G8B8A8_UNORM, kUavOut);
+  } else {
+    uavt(s.out, kUavOut);
+  }
+
+  const bool debug_ao = o.debug == 1, debug_depth = o.debug == 2;
+  const bool debug_logz = o.debug == 3, debug_haze = o.debug == 4;
+  const bool debug_any = o.debug != 0;
+  const bool do_ao = (o.ao && o.ao_strength > 0.0f && !debug_depth && !debug_logz && !debug_haze) || debug_ao;
+  const bool do_bloom = o.bloom && !debug_any && o.bloom_strength > 0.0f;
+  const bool do_clarity = o.clarity > 0.0f && !debug_any;
+  // The 1/8 res bright pass + luma of the previous frame (bloom, clarity).
+  const bool do_lowpass = do_bloom || do_clarity;
+  const bool do_sky = o.sky_on && o.sky > 0.0f;
+  const bool do_void = o.void_on && o.void_level > 0.0f;
+  const bool do_haze = o.haze_on && o.haze > 0.0f;
+  const bool need_sky_avg = do_sky || do_void || do_haze;
+  // Separate AO blur unless lag (one stage) or ao_fused is asked for.
+  const bool ao_split = do_ao && (o.ao_split || (!o.lag && !o.ao_fused));
+  // Sky average straight from the colour target (no sums written by final);
+  // lag needs the sums (its sky pass runs next to final).
+  const bool sky_direct = need_sky_avg && !o.lag && !o.sky_sums;
+  const bool tonemap = o.tonemap && !debug_any;
+  const bool bake_lut = tonemap && (!s.lut_valid || s.lut_text != g_file_text);
+  // History: the previous apply must have produced the same kinds of outputs.
+  const uint32_t key = (do_ao ? 1u : 0u) | (do_lowpass ? 2u : 0u) | (need_sky_avg ? 4u : 0u) |
+                       (in_place ? 8u : 0u) | (uint32_t(ao_div) << 4);
+  if (key != s.history_key) s.streak = 0;
+  s.history_key = key;
+  const bool hist1 = s.streak >= 1;  // [prv] = valid outputs of the previous apply
+  // Lag mode: ONE barrier stage. AO, sky average and bloom blur of this apply
+  // run next to final, which uses the previous apply's results ([prv]).
+  const bool lag = o.lag && s.streak >= 2 && !bake_lut && !ao_split && !debug_any;
+  // MAIN20: bright pass of THIS frame (own pass before the blur) unless
+  // bloom_prev / lag or its pipeline is missing.
+  const bool bright_cur =
+      do_lowpass && !o.bloom_prev && !lag && s.pipelines[kPassBright].Get() != nullptr;
+  // blur bright[prv] (or bright[cur]) -> blur[cur]
+  const bool do_bloom_blur = do_lowpass && (hist1 || bright_cur);
+  // final reads blur[cur] (normal) or blur[prv] (lag, valid since streak >= 2).
+  const bool use_bloom = do_lowpass && (lag || hist1 || bright_cur);
+  // ao_lag1: needs the split AO path and a valid previous blurred AO.
+  const bool ao_lag1 = o.ao_lag1 && ao_split && hist1 && !lag && !debug_any;
+  Constants k = {};
+  k.origin[0] = target.x;
+  k.origin[1] = target.y;
+  k.size[0] = w;
+  k.size[1] = h;
+  k.inv_size[0] = 1.0f / float(w);
+  k.inv_size[1] = 1.0f / float(h);
+  k.focal = 0.5f * float(h) / std::tan(o.fov * 0.5f * 3.14159265f / 180.0f);
+  k.ao_radius = o.ao_radius;
+  k.ao_strength = o.ao_strength;
+  k.ao_max_px = o.ao_max_px * float(target.scale);
+  k.bloom_threshold = o.bloom_threshold;
+  k.bloom_strength = o.bloom_strength;
+  k.exposure = o.exposure;
+  k.saturation = o.saturation;
+  k.contrast = o.contrast;
+  k.shoulder = o.shoulder;
+  k.white = o.white;
+  k.lift = o.lift;
+  k.scale = float(target.scale);
+  k.ao_samples = uint32_t(o.ao_samples);
+  k.ao_div = ao_div;
+  k.frame = g_apply_index;
+  k.vibrance = o.vibrance;
+  k.filmic = o.filmic;
+  k.split = o.split;
+  k.temperature = o.temperature;
+  k.tint = o.tint;
+  k.vignette = o.vignette;
+  k.sharpen = o.sharpen;
+  k.black = o.black;
+  k.sky = o.sky;
+  k.horizon = o.horizon;
+  for (int i = 0; i < 3; ++i) {
+    k.sky_top[i] = o.sky_top[i];
+    k.sky_hor[i] = o.sky_horizon[i];
+  }
+  k.void_level = o.void_level;
+  k.haze = o.haze;
+  k.haze_log_start = std::log2(o.haze_start);
+  k.haze_log_inv_range = 1.0f / std::max(1e-3f, std::log2(o.haze_end) - std::log2(o.haze_start));
+  k.ao_color = o.ao_color;
+  k.skylight = o.skylight;
+  k.clarity = o.clarity;
+  k.ao_far = o.ao_far;
+  k.ao_rel = o.ao_rel;
+  k.flags = (o.ao && !debug_any && do_ao ? kFlagAo : 0) |
+            (use_bloom && do_bloom ? kFlagBloom : 0) | (use_bloom && do_clarity ? kFlagClarity : 0) |
+            (do_lowpass && !bright_cur ? kFlagBloomOut : 0) |
+            (tonemap ? kFlagTonemap : 0) | (debug_ao ? kFlagDebugAo : 0) |
+            (debug_depth ? kFlagDebugDepth : 0) | (debug_logz ? kFlagDebugLogZ : 0) |
+            (debug_haze ? kFlagDebugHaze | kFlagHaze : 0) |
+            (!debug_any && do_sky ? kFlagSky : 0) | (!debug_any && do_void ? kFlagVoid : 0) |
+            (!debug_any && do_haze ? kFlagHaze : 0) |
+            (!debug_any && o.sharpen > 0.0f ? kFlagSharpen : 0) |
+            (need_sky_avg && !sky_direct ? kFlagSkyOut : 0) | (need_sky_avg && hist1 ? kFlagSkyIn : 0) |
+            (sky_direct ? kFlagSkyDirect : 0) | ((lag || ao_lag1) && do_ao ? kFlagAoLag : 0);
+
+  DeferredCommandList& list = cp.GetDeferredCommandList();
+  // Stage timestamps (dist\gpu_timing): a free ring slot or no timing this apply.
+  int tq = -1;
+  if (s.tq_on) {
+    TqHarvest(cp, s);
+    if (!s.tq_busy[s.tq_next]) {
+      tq = int(s.tq_next);
+      s.tq_next = (s.tq_next + 1) % State::kTqSlots;
+    }
+  }
+  auto tq_mark = [&](uint32_t m) {
+    if (tq >= 0) list.D3DEndQuery(s.tq_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, uint32_t(tq) * State::kTqMarks + m);
+  };
+  tq_mark(0);
+  list.D3DSetComputeRootSignature(s.root_signature.Get());
+  auto pass = [&](Pass p, int t0, int t1, int t2, int t3, int t4, int u0, int u1, uint32_t gx,
+                  uint32_t gy, uint32_t ow, uint32_t oh, float step, uint32_t gz = 1,
+                  int u2 = kUavLut) {
+    Constants c = k;
+    c.out_size[0] = ow;
+    c.out_size[1] = oh;
+    c.step = step;
+    list.D3DSetComputeRoot32BitConstants(0, sizeof(Constants) / 4, &c, 0);
+    list.D3DSetComputeRootDescriptorTable(1, hd[t0].second);
+    list.D3DSetComputeRootDescriptorTable(2, hd[t1].second);
+    list.D3DSetComputeRootDescriptorTable(3, hd[t2].second);
+    list.D3DSetComputeRootDescriptorTable(4, hd[t3].second);
+    list.D3DSetComputeRootDescriptorTable(5, hd[t4].second);
+    list.D3DSetComputeRootDescriptorTable(6, hd[kSrvLut].second);
+    list.D3DSetComputeRootDescriptorTable(7, hd[u0].second);
+    list.D3DSetComputeRootDescriptorTable(8, hd[u1].second);
+    list.D3DSetComputeRootDescriptorTable(9, hd[u2].second);
+    cp.SetExternalPipeline(s.pipelines[p].Get());
+    cp.SubmitBarriers();
+    list.D3DDispatch(gx, gy, gz);
+  };
+  const int c = kSrvColor;
+  const int u_dummy = kUavBright + int(cur);  // bound where a pass has no second UAV
+  auto pass2d = [&](Pass p, int t0, int t1, int t2, int t3, int t4, int u0, uint32_t ow, uint32_t oh,
+                    float step) {
+    pass(p, t0, t1, t2, t3, t4, u0, u_dummy, (ow + 7) / 8, (oh + 7) / 8, ow, oh, step);
+  };
+  const auto uav_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  const auto srv_state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  // Normal: two dependency stages, each one barrier batch followed by
+  // independent dispatches: (1) AO + its blur (one fused pass) -> ao[cur], sky
+  // average (sky sums [prv] -> sky[cur]), blur of the previous bright pass
+  // (bright[prv] -> blur[cur]), LUT bake; (2) final reading ao/sky/blur[cur],
+  // writing bright[cur] and sum[cur]. ao_split = the old separate AO blur
+  // stage in between. Lag: everything in ONE stage, final reads [prv].
+  const uint32_t rd = lag ? prv : cur;  // the set final reads
+  if (bright_cur) {
+    Transition(cp, s.bright[cur], uav_state);
+    pass(kPassBright, c, c, c, c, c, kUavBright + int(cur), u_dummy, ew, eh, w, h, 0.0f);
+    Transition(cp, s.bright[cur], srv_state);
+  }
+  if (bake_lut) Transition(cp, s.lut, uav_state);
+  if (do_ao) Transition(cp, s.ao[cur], uav_state);
+  if (ao_split) Transition(cp, s.ao_raw, uav_state);
+  if (need_sky_avg) {
+    Transition(cp, s.sky[cur], uav_state);
+    Transition(cp, s.sky[prv], srv_state);
+    if (!sky_direct) Transition(cp, s.sum[prv], srv_state);
+  }
+  if (do_bloom_blur) {
+    if (!bright_cur) Transition(cp, s.bright[prv], srv_state);
+    Transition(cp, s.blur[cur], uav_state);
+  }
+  if (lag) {
+    // Everything final needs is already final-ready; its outputs too.
+    if (do_ao) Transition(cp, s.ao[prv], srv_state);
+    if (use_bloom) Transition(cp, s.blur[prv], srv_state);
+    if (do_lowpass) Transition(cp, s.bright[cur], uav_state);
+    if (need_sky_avg) Transition(cp, s.sum[cur], uav_state);
+    if (in_place) cp.PushTransitionBarrier(target.color, srv_state, uav_state);
+    else Transition(cp, s.out, uav_state);
+  }
+  const Pass ao_pass = o.v15 && s.pipelines[kPassAoOld].Get() != nullptr ? kPassAoOld : kPassAo;
+  if (ao_split) pass2d(ao_pass, kSrvDepth, c, c, c, c, kUavAoRaw, aw, ah, 0.0f);
+  if (do_ao && !ao_split) {
+    pass(kPassAoFused, kSrvDepth, c, c, c, c, kUavAo + int(cur), u_dummy, (aw + 15) / 16,
+         (ah + 15) / 16, aw, ah, 0.0f);
+  }
+  if (need_sky_avg) {
+    pass(kPassSky, sky_direct ? c : kSrvSum + int(prv), kSrvDepth, kSrvSky + int(prv), c, c, kUavSky + int(cur), u_dummy,
+         1, 1, 4, 1, 0.0f);
+  }
+  if (do_bloom_blur) {
+    pass2d(kPassBloomBlur, kSrvBright + int(bright_cur ? cur : prv), c, c, c, c, kUavBlur + int(cur), ew, eh,
+           0.9f * o.bloom_radius);
+  }
+  if (bake_lut) {
+    pass(kPassLut, c, c, c, c, c, kUavSky + int(cur), u_dummy, kLutSize / 4, kLutSize / 4, kLutSize,
+         kLutSize, 0.0f, kLutSize / 4);
+    Transition(cp, s.lut, srv_state);
+    s.lut_valid = true;
+    s.lut_text = g_file_text;
+  }
+  tq_mark(1);
+  if (ao_split && !ao_lag1) {
+    Transition(cp, s.ao_raw, srv_state);
+    pass2d(kPassAoBlur, kSrvAoRaw, c, c, c, c, kUavAo + int(cur), aw, ah, 0.0f);
+  }
+  if (!ao_lag1) tq_mark(2);
+  if (ao_lag1) {
+    // The AO blur of this apply runs in final's barrier batch; final reads
+    // the previous apply's blurred AO.
+    Transition(cp, s.ao_raw, srv_state);
+    Transition(cp, s.ao[prv], srv_state);
+  }
+  if (!lag) {
+    if (do_ao && !ao_lag1) Transition(cp, s.ao[cur], srv_state);
+    if (need_sky_avg) {
+      Transition(cp, s.sky[cur], srv_state);
+      if (!sky_direct) Transition(cp, s.sum[cur], uav_state);
+    }
+    if (use_bloom) Transition(cp, s.blur[cur], srv_state);
+    if (do_lowpass && !bright_cur) Transition(cp, s.bright[cur], uav_state);
+    if (in_place) {
+      cp.PushTransitionBarrier(target.color, srv_state, uav_state);
+    } else {
+      Transition(cp, s.out, uav_state);
+    }
+  }
+  if (ao_lag1) {
+    pass2d(kPassAoBlur, kSrvAoRaw, c, c, c, c, kUavAo + int(cur), aw, ah, 0.0f);
+    tq_mark(2);
+  }
+  // Debug views and v15 = final_main; else the LIGHT19 final2_main.
+  const bool final_old = debug_any || o.v15;
+  const Pass final_pass = in_place ? (debug_any ? kPassFinalInPlaceDebug : final_old ? kPassFinalInPlace : kPassFinal2InPlace)
+                                   : (debug_any ? kPassFinalDebug : final_old ? kPassFinal : kPassFinal2);
+  pass(final_pass, kSrvColor, kSrvDepth, do_ao ? kSrvAo + int(ao_lag1 ? prv : rd) : c,
+       use_bloom ? kSrvBlur + int(rd) : c, need_sky_avg ? kSrvSky + int(rd) : c, kUavOut,
+       kUavBright + int(cur), (w + 7) / 8, (h + 7) / 8, w, h, 0.0f, 1, kUavSum + int(cur));
+  if (!s.logged_lag && lag) {
+    s.logged_lag = true;
+    REXLOG_INFO("Scene post: lag mode active (one barrier stage)");
+  }
+  ++s.streak;
+  s.parity ^= 1u;
+  if (in_place) {
+    // The resolve that follows transitions it from here (tracked state).
+    color_state = uav_state;
+  } else {
+    Transition(cp, s.out, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    cp.PushTransitionBarrier(target.color, srv_state, D3D12_RESOURCE_STATE_COPY_DEST);
+    cp.SubmitBarriers();
+    D3D12_TEXTURE_COPY_LOCATION dst = {}, src = {};
+    dst.pResource = target.color;
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = s.out.resource.Get();
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box = {0, 0, 0, w, h, 1};
+    list.D3DCopyTextureRegion(&dst, target.x, target.y, 0, &src, &box);
+    // s.out stays in COPY_SOURCE; it goes back to UAV in the next final batch.
+    color_state = D3D12_RESOURCE_STATE_COPY_DEST;
+  }
+  tq_mark(3);
+  if (tq >= 0) {
+    list.D3DResolveQueryData(s.tq_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, uint32_t(tq) * State::kTqMarks,
+                             State::kTqMarks, s.tq_readback.Get(),
+                             sizeof(uint64_t) * uint32_t(tq) * State::kTqMarks);
+    s.tq_submission[tq] = cp.GetCurrentSubmission();
+    s.tq_busy[tq] = true;
+  }
+  if (need_sky_avg) ++g_apply_index;
+  ++g_applied;
+  return true;
+}
+
+}  // namespace scene_post
+}  // namespace rex::graphics::d3d12
diff --git a/src/graphics/d3d12/scene_post.h b/src/graphics/d3d12/scene_post.h
new file mode 100644
index 0000000..a4b27ec
--- /dev/null
+++ b/src/graphics/d3d12/scene_post.h
@@ -0,0 +1,89 @@
+/**
+ * Scene post-process (pre-HUD): screen-space ambient occlusion, bloom and a
+ * highlight-shoulder tonemap / grade, applied to the host colour render target
+ * of the main scene right before its final resolve to the scene texture, so
+ * the HUD (drawn later) is untouched. Reads the host depth render target
+ * (reversed-Z float depth, near = 1).
+ *
+ * Switch: file "scene_post" next to the exe (content = optional options, see
+ * scene_post.cpp); "scene_post.off" wins. Re-checked every ~2 s. Default off.
+ *
+ * @modified    whompay, 2026
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include <rex/ui/d3d12/d3d12_api.h>
+
+namespace rex::graphics::d3d12 {
+
+class D3D12CommandProcessor;
+
+namespace scene_post {
+
+// Cheap per-resolve gate: one cached flag, the switch files are re-read every
+// ~120 frames. Returns true when the effect is on.
+bool Enabled(uint64_t frame);
+
+// Guest address of the resolve destination that receives the finished scene.
+uint32_t SceneDestAddress();
+
+// Counts the qualifying scene resolves of the current frame; returns true for
+// the one that finishes the scene (gets the post-process). MAIN20 picker: the
+// final scene resolve is recognised by its signature - the destination of the
+// resolve right before it (the end of the game's bloom chain) and no colour
+// clear - learned from the previous frames, so a changing number of scene
