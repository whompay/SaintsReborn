diff --git a/src/graphics/d3d12/native_clear.h b/src/graphics/d3d12/native_clear.h
new file mode 100644
index 0000000..eee3692
--- /dev/null
+++ b/src/graphics/d3d12/native_clear.h
@@ -0,0 +1,57 @@
+// NATIVE CLEAR (whompay): the XDK clear rectangle (VS 0A6D1DD7767FDF27 + PS 2E372EA28CC404B7 - a window-coordinate
+// rectangle with a constant colour taken from its vertices; depth / stencil written through ALWAYS) is executed as
+// ClearDepthStencilView / ClearRenderTargetView over exactly the host pixels the rectangle covers, instead of a
+// full-screen draw through the translated shaders.
+// Opt-in: dist\native_clear (on), dist\native_clear_verify (no skip: draw, then clear on top and compare read back
+// bits: before-draw vs after-draw outside the rectangle, after-draw vs after-clear inside), dist\native_clear.off wins.
+// Log 'NATIVE CLEAR' every 10 s.
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::d3d12 {
+
+struct NativeClearPlan {
+  bool valid = false;          // command_processor.cpp: this draw passed all register / vertex gates
+  bool depth = false;          // clear depth of the bound depth target
+  bool stencil = false;        // clear stencil of the bound depth target
+  float depth_value = 0.0f;    // host depth value (float24 targets: [0, 2) -> [0, 1) remap applied)
+  uint32_t stencil_value = 0;
+  uint32_t color_mask = 0;     // bit k: colour target k is cleared
+  float color[4] = {};
+  int32_t rect[4] = {};        // host pixels left, top, right, bottom (exclusive), not yet clamped to the targets
+  bool done = false;           // render_target_cache.cpp: the clears were recorded -> the draw is skipped
+  bool verify_pending = false; // verify mode: NativeClearVerifyAfterDraw after the draw
+};
+
+enum NativeClearReason : uint32_t {
+  kNclrOk,
+  kNclrPrim,        // not a 3-vertex auto-indexed rectangle list / memexport / no rasterization
+  kNclrFetch,       // vertex fetch layout or memory
+  kNclrValues,      // NaN / colour or depth differs between the vertices
+  kNclrShape,       // not an axis-aligned rectangle with integer host edges
+  kNclrState,       // cull, polygon offset, clipping, AA mask, window offset, VTE, EDRAM mode, alpha test, kill
+  kNclrDepthFunc,   // depth test other than ALWAYS
+  kNclrStencil,     // stencil not expressible as a clear (partial write mask, other ops / functions)
+  kNclrColorMask,   // partial colour write mask
+  kNclrBlend,       // blending
+  kNclrFormat,      // colour format other than 8_8_8_8 / 2_10_10_10, exponent bias
+  kNclrMsaa,        // multisampled target
+  kNclrDepthMap,    // viewport depth mapping not exact (or float24 conversion in the pixel shader)
+  kNclrEmpty,       // nothing to clear / empty rectangle
+  kNclrNoTarget,    // the needed target is not bound
+  kNclrVerifyBusy,  // verify mode: previous compare still in flight
+  kNclrReasons
+};
+
+extern NativeClearPlan g_nclr;
+// 0 off, 1 on, 2 verify. Re-reads the dist files at most once per second.
+int NativeClearPoll();
+void NativeClearReject(uint32_t reason);
+// kNclrPrim detail (diag): key = primitive type | vertex count << 8 (capped 255) | indexed << 16 | no raster << 17 |
+// memexport << 18; the most frequent keys are logged with the reasons.
+void NativeClearRejectPrim(uint32_t key);
+// Verify mode, command_processor.cpp right after the draw: copy, clear on top, copy (compared once completed).
+void NativeClearRunAfterDraw();
+
+}  // namespace rex::graphics::d3d12
diff --git a/src/graphics/d3d12/native_frame_bridge_verify.inc b/src/graphics/d3d12/native_frame_bridge_verify.inc
