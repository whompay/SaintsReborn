+// Saints Reborn: Xbox Live sessions over Epic Online Services (included by
+// xgi_app.cpp; only active with the cvar xam_signed_in_to_live).
+//
+// Hosting (XSessionCreate with HOST + presence/matchmaking): the XSESSION_INFO
+// is filled by xam_net.cpp (id, this PC's EOS LAN address, key) and an advert
+// with it, the slot counts and the host's contexts / properties goes into the
+// host's member attributes of the shared EOS LAN lobby (eos_lan.cpp).
+// XSessionSearch* returns every other player's advert whose contexts match the
+// search's contexts (a context only counts when both sides have it). Joining
+// then runs over the EOS LAN like System Link.
+//
+// Advert (hex text): version 2 | XSESSION_INFO 60 | open public, open private,
+// filled public, filled private (u8 each) | u8 contexts, (u32 id, u32 value)*
+// | u8 properties, (u32 id, u8 size, size bytes)* | u8 name length, name
+// | u8 flags (1 modded host, 2 ranked, 4 matchmaking, 8 private party).
+// Version 1 (older games) counts as modded.
+//
+// Fair play (online_identity.cpp): mods, trainers and cheat tools only work
+// in a Private Party (a session whose slots are all invite-only). Public
+// matches (Player and Ranked) and System Link are for unmodded games: a
+// modded game is not advertised and finds no public sessions, and game
+// packets outside a Private Party only flow between unmodded games
+// (eos_lan.cpp SetPrivateSession). Story co-op by join code has no such rule.
+
+REXCVAR_DECLARE(std::string, xam_player_name);
+
+namespace rex::system::eoslan {
+struct LiveAdvertEntry {
+  std::string text;
+  bool modded = true;
+  std::string name;
+};
+void SetLiveAdvert(const std::string& text);
+std::vector<LiveAdvertEntry> LiveAdverts(uint32_t wait_ms);
+void SetPrivateSession(bool on);
+void SetInviteSession(const uint8_t* info);  // lobby invites (xlivebase_app.cpp)
+void SetSessionHost(const uint8_t* info, bool is_host);  // map check (eos_lan.cpp)
+}  // namespace rex::system::eoslan
+namespace rex::system::online {
+std::string SafeName(const std::string& wanted);
+bool Modded();
+std::string ModdedReason();
+void Notice(const std::string& text);
+}  // namespace rex::system::online
+
+namespace {
+
+struct LiveState {
+  std::mutex mutex;
+  std::map<uint32_t, uint32_t> contexts;                  // XUserSetContext (user 0)
+  std::map<uint32_t, std::vector<uint8_t>> properties;    // XUserSetProperty (user 0), big-endian bytes
+  // Created sessions (party, matchmaking, match ...), told apart by the nonce
+  // XSessionCreate hands out and XSessionDelete passes back; the game deletes
+  // them in any order. The newest hosted one is the one advertised.
+  struct Session {
+    uint64_t nonce = 0;
+    bool host = false;
+    uint8_t info[60] = {};
+    uint32_t flags = 0, public_slots = 0, private_slots = 0;
+  };
+  std::vector<Session> sessions;
+  uint64_t next_nonce = 0;
+  bool hosting = false;
+  uint32_t flags = 0;  // XSessionCreate flags of the hosted session
+  uint8_t info[60] = {};
+  uint32_t public_slots = 0, private_slots = 0;
+} g_live;
+std::atomic<int> g_session_depth{0};  // sessions open (any kind), for the map check
+
+std::string Hex(const std::vector<uint8_t>& v) {
+  static const char* d = "0123456789abcdef";
+  std::string s;
+  for (uint8_t b : v) { s += d[b >> 4]; s += d[b & 15]; }
+  return s;
+}
+std::vector<uint8_t> Unhex(const std::string& s) {
+  std::vector<uint8_t> v;
+  auto nib = [](char c) -> int { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; };
+  for (size_t i = 0; i + 1 < s.size(); i += 2) {
+    const int a = nib(s[i]), b = nib(s[i + 1]);
+    if (a < 0 || b < 0) return {};
+    v.push_back(uint8_t(a << 4 | b));
+  }
+  return v;
+}
+void Put32(std::vector<uint8_t>& v, uint32_t x) {
+  for (int i = 3; i >= 0; --i) v.push_back(uint8_t(x >> (i * 8)));
+}
+
+constexpr uint32_t kContextGameType = 0x800A;  // X_CONTEXT_GAME_TYPE: 0 ranked, 1 standard
+constexpr uint32_t kFlagMatchmaking = 0x8, kFlagArbitration = 0x10;
+
+// Needs g_live.mutex.
+bool HostingRankedLocked() {
+  auto it = g_live.contexts.find(kContextGameType);
+  return (g_live.flags & kFlagArbitration) || (it != g_live.contexts.end() && it->second == 0);
+}
+
+// Needs g_live.mutex.
+void PublishAdvertLocked() {
+  const bool modded = rex::system::online::Modded();
+  if (!g_live.hosting) {
+    rex::system::eoslan::SetLiveAdvert("");
+    if (g_live.sessions.empty()) rex::cvar::SetFlagByName("online_session", "");
+    return;
+  }
+  const bool ranked = HostingRankedLocked();
+  const bool priv = !ranked && g_live.public_slots == 0 && g_live.private_slots > 0;
+  rex::system::eoslan::SetPrivateSession(priv);
+  if (modded && !priv) {
+    static std::string told;
+    const std::string reason = rex::system::online::ModdedReason();
+    if (told != reason) {
+      told = reason;
+      rex::system::online::Notice("Public matches need an unmodded game, so nobody can find this one. Turn off: " +
+                                  reason + ". Mods work in a Private Party with invited friends.");
+    }
+    REXLOG_INFO("LIVE: not advertised ({} public / {} private slots; modded games only host Private Parties)",
+                g_live.public_slots, g_live.private_slots);
+    rex::system::eoslan::SetLiveAdvert("");
+    return;
+  }
+  rex::cvar::SetFlagByName("online_session", priv     ? "Hosting a Private Party"
+                                             : ranked ? "Hosting a Ranked Match"
+                                                      : "Hosting a Player Match");
+  std::vector<uint8_t> v;
+  v.push_back(2);
+  v.insert(v.end(), g_live.info, g_live.info + 60);
+  const uint32_t filled = 1;
+  v.push_back(uint8_t(std::min<uint32_t>(g_live.public_slots > filled ? g_live.public_slots - filled : 0, 255)));
+  v.push_back(uint8_t(std::min<uint32_t>(g_live.private_slots, 255)));
+  v.push_back(uint8_t(filled));
+  v.push_back(0);
+  v.push_back(uint8_t(std::min<size_t>(g_live.contexts.size(), 16)));
+  size_t n = 0;
+  for (auto& [id, value] : g_live.contexts) {
+    if (n++ >= 16) break;
+    Put32(v, id);
+    Put32(v, value);
+  }
+  std::vector<std::pair<uint32_t, std::vector<uint8_t>>> props;
+  for (auto& [id, bytes] : g_live.properties)
+    if (bytes.size() <= 8 && props.size() < 16) props.push_back({id, bytes});
+  v.push_back(uint8_t(props.size()));
+  for (auto& [id, bytes] : props) {
+    Put32(v, id);
+    v.push_back(uint8_t(bytes.size()));
+    v.insert(v.end(), bytes.begin(), bytes.end());
+  }
+  std::string name = rex::cvar::GetFlagByName("xam_player_name");
+  if (name.empty()) {
+    const char* env = std::getenv("USERNAME");
+    name = env && *env ? env : "Player";
+  }
+  name = rex::system::online::SafeName(name);
+  v.push_back(uint8_t(name.size()));
+  v.insert(v.end(), name.begin(), name.end());
+  v.push_back(uint8_t((modded ? 1 : 0) | (ranked ? 2 : 0) | ((g_live.flags & kFlagMatchmaking) ? 4 : 0) |
+                     (priv ? 8 : 0)));
+  rex::system::eoslan::SetLiveAdvert(Hex(v));
+}
+
+struct Advert {
+  uint8_t info[60];
+  uint8_t open_pub, open_priv, filled_pub, filled_priv;
+  std::vector<std::pair<uint32_t, uint32_t>> contexts;
+  std::vector<std::pair<uint32_t, std::vector<uint8_t>>> properties;
+  std::string name;
+  bool modded = true, ranked = false, priv = false;
+};
+bool ParseAdvert(const std::string& text, Advert& a) {
+  const auto v = Unhex(text);
+  size_t p = 0;
+  auto need = [&](size_t n) { return p + n <= v.size(); };
+  auto get32 = [&]() { uint32_t x = uint32_t(v[p]) << 24 | uint32_t(v[p + 1]) << 16 | uint32_t(v[p + 2]) << 8 | v[p + 3]; p += 4; return x; };
+  if (!need(1 + 60 + 4 + 1) || (v[0] != 1 && v[0] != 2)) return false;
+  p = 1;
+  std::memcpy(a.info, &v[p], 60);
+  p += 60;
+  a.open_pub = v[p++]; a.open_priv = v[p++]; a.filled_pub = v[p++]; a.filled_priv = v[p++];
+  const uint8_t nc = v[p++];
+  if (!need(nc * 8u + 1)) return false;
+  for (uint8_t i = 0; i < nc; ++i) { const uint32_t id = get32(); a.contexts.push_back({id, get32()}); }
+  const uint8_t np = v[p++];
+  for (uint8_t i = 0; i < np; ++i) {
+    if (!need(5)) return false;
+    const uint32_t id = get32();
+    const uint8_t size = v[p++];
+    if (size > 8 || !need(size)) return false;
+    a.properties.push_back({id, std::vector<uint8_t>(v.begin() + p, v.begin() + p + size)});
+    p += size;
+  }
+  if (need(1)) {
+    const uint8_t nn = v[p++];
+    if (need(nn)) { a.name.assign(reinterpret_cast<const char*>(&v[p]), nn); p += nn; }
+  }
+  a.modded = false;  // version 1: an older game (no fair-play flag): allowed, else updated players never find it
+  if (v[0] == 2 && need(1)) {
+    const uint8_t f = v[p++];
+    a.modded = f & 1;
+    a.ranked = f & 2;
+    a.priv = f & 8;
+  }
+  return true;
+}
+
+// Fills XSESSION_SEARCHRESULT_HEADER + results (92 bytes each: XSESSION_INFO
+// 60, open/filled public/private slots, property / context counts and
+// pointers) + their XUSER_PROPERTY (24 bytes, value at +8) and XUSER_CONTEXT
+// (8 bytes) arrays at the end of the buffer. Returns the number written.
+template <class Mem>
+uint32_t FillSearchResults(Mem* memory, uint32_t results_ptr, uint32_t buffer_size,
+                           uint32_t max_results, uint32_t num_ctx, uint32_t ctx_ptr, const char* what,
+                           const uint8_t* session_id = nullptr) {
+  const auto texts = rex::system::eoslan::LiveAdverts(3000);
+  std::vector<Advert> found;
+  std::vector<std::pair<uint32_t, uint32_t>> wanted;
+  for (uint32_t i = 0; ctx_ptr && i < num_ctx && i < 32; ++i) {
+    auto* c = memory->TranslateVirtual<uint8_t*>(ctx_ptr + i * 8);
+    wanted.push_back({rex::memory::load_and_swap<uint32_t>(c), rex::memory::load_and_swap<uint32_t>(c + 4)});
+  }
+  const bool me_modded = rex::system::online::Modded();
+  if (me_modded && !session_id) {
+    static std::string told;
+    const std::string reason = rex::system::online::ModdedReason();
+    if (told != reason) {
+      told = reason;
+      rex::system::online::Notice("Public matches need an unmodded game. Turn off: " + reason +
+                                  ". Mods work in a Private Party with invited friends.");
+    }
+  }
+  uint32_t other_kind = 0;
+  for (const auto& t : texts) {
+    Advert a;
+    if (!ParseAdvert(t.text, a)) continue;
+    a.modded = a.modded || t.modded;  // the host's own published state counts too
+    if (session_id) {
+      // XSessionSearchByID: exactly that session (the match an invited / party
+      // player follows the host into); no lobby filters.
+      if (std::memcmp(a.info, session_id, 8) == 0) found.push_back(std::move(a));
+      continue;
+    }
+    bool ok = true;
+    for (auto& [id, value] : wanted)
+      for (auto& [aid, avalue] : a.contexts)
+        if (aid == id && avalue != value) ok = false;
+    if (!ok) continue;
+    // Public matches are unmodded games only; Private Parties are joined by
+    // invite (XSessionSearchByID above), never found by a search.
+    if (me_modded || a.modded || a.priv) {
+      ++other_kind;
+      continue;
+    }
+    found.push_back(std::move(a));
+  }
+  if (other_kind)
+    REXLOG_INFO("LIVE {}: {} session(s) hidden (this game is {}; public matches are unmodded games only, private "
+                "parties are joined by invite)", what, other_kind, me_modded ? "modded" : "unmodded");
+  std::string wanted_text;
+  for (auto& [id, value] : wanted) wanted_text += fmt::format(" {:X}={}", id, value);
+  REXLOG_INFO("LIVE {}: {} advert(s) online, {} match (search contexts:{}; this game {})", what, texts.size(),
+              found.size(), wanted_text, me_modded ? "modded" : "unmodded");
+  if (!results_ptr || buffer_size < 8) return 0;
+  uint8_t* base = memory->TranslateVirtual<uint8_t*>(results_ptr);
+  std::memset(base, 0, buffer_size);
+  uint32_t count = 0;
+  uint32_t tail = buffer_size;  // extra arrays grow down from the end
+  for (const auto& a : found) {
+    if (count >= max_results) break;
+    const uint32_t at = 8 + count * 92;
+    const uint32_t extra = uint32_t(a.properties.size() * 24 + a.contexts.size() * 8);
+    const uint32_t extra_at = (tail >= extra ? tail - extra : 0) & ~7u;
+    if (at + 92 > extra_at) break;
+    uint8_t* r = base + at;
+    std::memcpy(r, a.info, 60);
+    rex::memory::store_and_swap<uint32_t>(r + 60, a.open_pub);
+    rex::memory::store_and_swap<uint32_t>(r + 64, a.open_priv);
+    rex::memory::store_and_swap<uint32_t>(r + 68, a.filled_pub);
+    rex::memory::store_and_swap<uint32_t>(r + 72, a.filled_priv);
+    rex::memory::store_and_swap<uint32_t>(r + 76, uint32_t(a.properties.size()));
+    rex::memory::store_and_swap<uint32_t>(r + 80, uint32_t(a.contexts.size()));
+    uint32_t cursor = extra_at;
+    rex::memory::store_and_swap<uint32_t>(r + 84, a.properties.empty() ? 0 : results_ptr + cursor);
+    for (auto& [id, bytes] : a.properties) {
+      uint8_t* pr = base + cursor;
+      rex::memory::store_and_swap<uint32_t>(pr, id);
+      pr[8] = uint8_t(id >> 28);  // XUSER_DATA type is the property id's top nibble
+      std::memcpy(pr + 16, bytes.data(), bytes.size());  // XUSER_DATA value (big endian) at +8 of XUSER_DATA
+      cursor += 24;
+    }
+    rex::memory::store_and_swap<uint32_t>(r + 88, a.contexts.empty() ? 0 : results_ptr + cursor);
+    for (auto& [id, value] : a.contexts) {
+      rex::memory::store_and_swap<uint32_t>(base + cursor, id);
+      rex::memory::store_and_swap<uint32_t>(base + cursor + 4, value);
+      cursor += 8;
+    }
+    tail = extra_at;
+    REXLOG_INFO("LIVE {}: result {} = {} ({}.{}.{}.{}), {} open slot(s)", what, count, a.name, a.info[8], a.info[9],
+                a.info[10], a.info[11], a.open_pub);
+    ++count;
+  }
+  rex::memory::store_and_swap<uint32_t>(base + 0, count);
+  rex::memory::store_and_swap<uint32_t>(base + 4, count ? results_ptr + 8 : 0);
+  return count;
+}
+
+// The host's advert for this session id says it is a Private Party (joining).
+bool AdvertIsPrivate(const uint8_t* info) {
+  for (const auto& t : rex::system::eoslan::LiveAdverts(0)) {
+    Advert a;
+    if (ParseAdvert(t.text, a) && std::memcmp(a.info, info, 8) == 0) return a.priv;
+  }
+  return false;
+}
