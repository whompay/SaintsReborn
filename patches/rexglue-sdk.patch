+}  // namespace
+
+namespace rex::kernel::xam {
+// For XNetQosLookup (xam_net.cpp) when the host's QoS data (SRQOS) hasn't
+// arrived: does that session take public joins? 1 yes, 0 a Private Party
+// (invite-only slots), -1 no advert for it.
+int LiveSessionPublic(const uint8_t kid[8]) {
+  for (const auto& t : rex::system::eoslan::LiveAdverts(0)) {
+    Advert a;
+    if (!ParseAdvert(t.text, a) || std::memcmp(a.info, kid, 8) != 0) continue;
+    if (a.priv) return 0;
+    return (a.open_pub + a.filled_pub) > 0 ? 1 : (a.open_priv + a.filled_priv) > 0 ? 0 : 1;
+  }
+  return -1;
+}
+}  // namespace rex::kernel::xam
+
+// Matchmaking merge (game: coop_menu.cpp, every 2 s while this game hosts a
+// matchmaking session on the matchmaking screen). The game searches once,
+// then hosts and waits. Two players who search within a few seconds of each
+// other don't see each other's advert yet (1-3 s to show up), so both host
+// and both sit on "Finding matches" alone for good. A host still alone moves
+// into another host waiting in matchmaking for the same match type and mode:
+// to the one with more players, and between two lone hosts only the one with
+// the higher session id moves, so exactly one of them does. It joins the way
+// an accepted invite does. 1 = a join was started.
+extern "C" __declspec(dllexport) int SrMatchmakingMerge() {
+  uint8_t mine[60];
+  std::map<uint32_t, uint32_t> ctx;
+  bool alone = false;
+  {
+    std::lock_guard<std::mutex> l(g_live.mutex);
+    alone = g_live.hosting && (g_live.flags & kFlagMatchmaking) && g_live.remote == 0 && g_live.public_slots > 0;
+    std::memcpy(mine, g_live.info, 60);
+    ctx = g_live.contexts;
+  }
+  static std::string session, target;
+  static std::chrono::steady_clock::time_point since, next_try;
+  static int tries = 0, seen = 0;
+  if (!alone) {
+    session.clear();
+    return 0;
+  }
+  const std::string my_hex = Hex(std::vector<uint8_t>(mine, mine + 60));
+  const auto now = std::chrono::steady_clock::now();
+  if (my_hex != session) {
+    session = my_hex;
+    since = now;
+    next_try = {};
+    tries = 0;
+    seen = 0;
+    target.clear();
+  }
+  // Our own advert needs a moment to reach the others too, and a failed move
+  // isn't repeated at once.
+  if (now - since < std::chrono::seconds(5) || now < next_try || tries >= 3) return 0;
+  if (rex::system::online::Modded()) return 0;
+  const std::string my_id = my_hex.substr(0, 16);
+  std::string best_hex, best_name;
+  uint32_t best_filled = 0;
+  for (const auto& t : rex::system::eoslan::LiveAdverts(0)) {
+    Advert a;
+    if (!ParseAdvert(t.text, a)) continue;
+    if (a.modded || t.modded || a.priv || !a.mm || a.open_pub == 0) continue;
+    if (std::memcmp(a.info, mine, 8) == 0) continue;
+    bool same = true;
+    for (uint32_t id : {0x800Au, 0x800Bu}) {
+      auto mi = ctx.find(id);
+      bool has = false;
+      for (auto& [aid, av] : a.contexts)
+        if (aid == id) {
+          has = true;
+          same = same && mi != ctx.end() && av == mi->second;
+        }
+      same = same && has && mi != ctx.end();
+    }
+    if (!same || HostActivity(a) != "Searching for players") continue;
+    const uint32_t filled = std::max<uint32_t>(1, a.filled_pub + a.filled_priv);
+    const std::string hex = Hex(std::vector<uint8_t>(a.info, a.info + 60));
+    if (filled <= 1 && hex.substr(0, 16) > my_id) continue;  // the other lone host moves to us
+    if (best_hex.empty() || filled > best_filled || (filled == best_filled && hex < best_hex)) {
+      best_hex = hex;
+      best_filled = filled;
+      best_name = a.name.empty() ? t.name : a.name;
+    }
+  }
+  if (best_hex.empty()) {
+    seen = 0;
+    target.clear();
+    return 0;
+  }
+  // Seen on two polls in a row (2 s apart): not a host that is just leaving.
+  if (best_hex != target) {
+    target = best_hex;
+    seen = 1;
+    return 0;
+  }
+  if (++seen < 2) return 0;
+  ++tries;
+  next_try = now + std::chrono::seconds(20);
+  REXLOG_INFO("LIVE matchmaking: alone as host; {} waits for the same match with {} player(s) - joining them (try {})",
+              best_name, best_filled, tries);
+  return rex::system::eoslan::JoinAdvertisedSession(best_hex, best_name) ? 1 : 0;
+}
+
+// MULTIPLAYER > LOBBIES (game: online_players.cpp). SrPublicLobbies: first line
+// "#ready" / "#connecting" / "#modded" / "#off", then one line per public
+// lobby another unmodded game hosts:
+//   <XSESSION_INFO hex 120>|<host name>|<r = ranked, else s>|<mode (context
+//   0x800B: 0 GB, 1 TGB, 2 BAC, 3 TBAC, 4 BOR, 5 PTP, 6 Co-op, -1 unknown)>|
+//   <players>|<max players>|<0 = in the lobby (joinable), 1 = a match is running,
+//   2 = searching for players / anything else (joins only work in the lobby)>
+// Private Parties and modded games never show (fair play, as in the search).
+extern "C" __declspec(dllexport) int SrPublicLobbies(char* out, int size) {
+  if (!out || size <= 1) return 0;
+  std::string text;
+  const auto adverts = rex::system::eoslan::LiveAdverts(0);  // also starts Epic
+  if (rex::system::online::Modded()) text = "#modded\n";
+  else if (!rex::system::eoslan::LiveReady()) text = "#connecting\n";
+  else {
+    text = "#ready\n";
+    for (const auto& t : adverts) {
+      Advert a;
+      if (!ParseAdvert(t.text, a)) continue;
+      if (a.modded || t.modded || a.priv) continue;
+      int mode = -1;
+      for (auto& [id, value] : a.contexts)
+        if (id == 0x800B) mode = int(value);
+      std::string puid;
+      const std::string where = rex::system::eoslan::SessionHostWhere(a.info, puid);
+      // The host's activity (SRACT; older games only have SRWHERE, which says
+      // "Hosting a Player Match" whether it is in its lobby, searching or in
+      // a match - those count as joinable: a try beats a row that never works).
+      // Before 2026-10-17 every hosted lobby fell through to "searching", so
+      // A on any row only said "searching, not joined".
+      int state = 0;
+      if (where.find("lobby") != std::string::npos || where.rfind("Hosting", 0) == 0) state = 0;
+      else if (where.find("match") != std::string::npos) state = 1;
+      else if (!where.empty()) state = 2;
+      std::string name = a.name.empty() ? t.name : a.name;
+      for (char& c : name)
+        if (c == '|' || c == '\n' || c == '\r') c = ' ';
+      const uint32_t filled = a.filled_pub + a.filled_priv;
+      const uint32_t total = filled + a.open_pub + a.open_priv;
+      text += Hex(std::vector<uint8_t>(a.info, a.info + 60)) + "|" + name + "|" + (a.ranked ? "r" : "s") + "|" +
+              std::to_string(mode) + "|" + std::to_string(std::max<uint32_t>(filled, 1)) + "|" +
+              std::to_string(std::max<uint32_t>(total, 1)) + "|" +
+              std::to_string(state) + "\n";
+    }
+  }
+  const int n = std::min<int>(int(text.size()), size - 1);
+  std::memcpy(out, text.data(), size_t(n));
+  out[n] = 0;
+  return n;
+}
+// A on a lobby in MULTIPLAYER > LOBBIES: join that host's session.
+extern "C" __declspec(dllexport) int SrJoinLobby(const char* session_hex) {
+  if (!session_hex) return 0;
+  const std::string want(session_hex);
+  if (want.size() != 120) return 0;
+  for (const auto& t : rex::system::eoslan::LiveAdverts(0)) {
+    Advert a;
+    if (!ParseAdvert(t.text, a) || a.modded || t.modded || a.priv) continue;
+    if (Hex(std::vector<uint8_t>(a.info, a.info + 60)) != want) continue;
+    return rex::system::eoslan::JoinAdvertisedSession(want, a.name.empty() ? t.name : a.name) ? 1 : 0;
+  }
+  rex::system::online::Notice("That lobby is gone.");
+  return 0;
+}
