+                                                 D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        entry->state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+      } else {
+        command_processor_.PushUAVBarrier(entry->texture.Get());
+      }
+      target = entry->texture.Get();
+    } else {
+      target = texture_cache.BeginDirectResolve(
+          resolve_info.copy_dest_base, resolve_info.copy_dest_extent_start, resolve_info.copy_dest_extent_length,
+          msaa_width, msaa_height, msaa_dest_coords.pitch_aligned_div_32, xenos::TextureFormat::k_8_8_8_8,
