+void D3D12SharedMemory::CloseUploadSegment() {
+  upload_batch_open_ = false;
+  for (uint32_t block : segment_touched_blocks_) {
+    segment_used_pages_[block] = 0;
+    segment_uploaded_pages_[block] = 0;
+    segment_block_touched_[block] = 0;
+  }
+  segment_touched_blocks_.clear();
+}
+
+void D3D12SharedMemory::MarkSegmentPages(std::vector<uint64_t>& bits, uint32_t page_first,
+                                         uint32_t page_count) {
+  if (!page_count) {
+    return;
+  }
+  uint32_t page_last = page_first + page_count - 1;
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6) && block < bits.size();
+       ++block) {
+    uint64_t mask = UINT64_MAX;
+    if (block == (page_first >> 6)) {
+      mask &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    bits[block] |= mask;
+    if (!segment_block_touched_[block]) {
+      segment_block_touched_[block] = 1;
+      segment_touched_blocks_.push_back(block);
+    }
+  }
+}
+
+bool D3D12SharedMemory::SegmentPagesSet(const std::vector<uint64_t>& bits, uint32_t page_first,
+                                        uint32_t page_count) const {
+  if (!page_count) {
+    return false;
+  }
+  uint32_t page_last = page_first + page_count - 1;
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6) && block < bits.size();
+       ++block) {
+    uint64_t mask = UINT64_MAX;
+    if (block == (page_first >> 6)) {
+      mask &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if (bits[block] & mask) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void D3D12SharedMemory::OnRangesUsed(const std::pair<uint32_t, uint32_t>* ranges, size_t count) {
+  if (!upload_batching_ || !upload_batch_open_) {
+    // Nothing moved before this point in the current segment yet: reads before
+    // the segment's first upload are before its batch anyway.
+    return;
+  }
+  for (size_t i = 0; i < count; ++i) {
+    if (!ranges[i].second) {
+      continue;
+    }
+    uint32_t page_first = ranges[i].first >> page_size_log2();
+    uint32_t page_last = (ranges[i].first + ranges[i].second - 1) >> page_size_log2();
+    MarkSegmentPages(segment_used_pages_, page_first, page_last - page_first + 1);
+  }
+}
+
 bool D3D12SharedMemory::UploadRanges(
     const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) {
+  D3D12CommandProcessor::GpuTimeScope gpu_time_scope(command_processor_, D3D12CommandProcessor::kGpuTimeUpload);
   if (upload_page_ranges.empty()) {
     return true;
   }
+  ++command_processor_.gpu_count_uploads_;
+  ++stat_uploads_;
+  {
+    // Every 10 s: how many uploads went into how many batches (each batch is
+    // one COPY_DEST transition pair; before batching each upload was one).
+    auto now = std::chrono::steady_clock::now();
+    if (stat_since_ == std::chrono::steady_clock::time_point()) {
+      stat_since_ = now;
+      stat_barrier_batches_last_ = command_processor_.gpu_count_barrier_batches_;
+    }
+    double seconds = std::chrono::duration<double>(now - stat_since_).count();
+    if (seconds >= 10.0) {
+      uint64_t barrier_batches = command_processor_.gpu_count_barrier_batches_;
+      REXLOG_INFO(
+          "UPLOADS {:.0f}/s in {:.0f} batches/s (batching {}) | barrier batches {:.0f}/s | content "
+          "check {}: {:.0f} pages/s checked, {:.0f}/s unchanged (not uploaded)",
+          stat_uploads_ / seconds, stat_batches_ / seconds, upload_batching_ ? "on" : "off",
+          (barrier_batches - stat_barrier_batches_last_) / seconds, content_check_ ? "on" : "off",
+          content_check_pages_ / seconds, content_check_skipped_ / seconds);
+      REXLOG_INFO("UNTRACKED WRITES: {:.0f} pages/s changed without a write fault, by 64 KB region:{}",
+                  content_check_changed_known_ / seconds, TakeUntrackedWriteReport());
+      content_check_pages_ = content_check_skipped_ = content_check_changed_known_ = 0;
+      stat_uploads_ = stat_batches_ = 0;
+      stat_barrier_batches_last_ = barrier_batches;
+      stat_since_ = now;
+    }
+  }
+  for (auto& r : upload_page_ranges) command_processor_.gpu_count_upload_bytes_ += uint64_t(r.second) << page_size_log2();
+  if (upload_batching_) {
+    if (segment_used_pages_.empty()) {
+      size_t blocks = size_t(((kBufferSize >> page_size_log2()) + 63) >> 6);
+      segment_used_pages_.assign(blocks, 0);
+      segment_uploaded_pages_.assign(blocks, 0);
+      segment_block_touched_.assign(blocks, 0);
+    }
+    uint64_t submission = command_processor_.GetCurrentSubmission();
+    if (submission != upload_batch_submission_) {
+      // A new deferred command list: the old batch index is gone.
+      CloseUploadSegment();
+      upload_batch_submission_ = submission;
+    }
+    auto& command_list = command_processor_.GetDeferredCommandList();
+    for (auto upload_range : upload_page_ranges) {
+      uint32_t upload_range_start = upload_range.first;
+      uint32_t upload_range_length = upload_range.second;
+      if (upload_batch_open_ &&
+          (SegmentPagesSet(segment_used_pages_, upload_range_start, upload_range_length) ||
+           SegmentPagesSet(segment_uploaded_pages_, upload_range_start, upload_range_length))) {
+        // Read (or uploaded) earlier in this segment: moving this upload before
+        // those reads would change what they see. Start a new segment here.
+        CloseUploadSegment();
+      }
+      if (!upload_batch_open_) {
+        // Pending barriers go into the list first, so the batch knows the
+        // buffer's state at its place in the list.
+        command_processor_.SubmitBarriers();
+        upload_batch_index_ = command_list.BeginUploadBatch(buffer_, buffer_state_);
+        ++stat_batches_;
+        upload_batch_open_ = true;
+      }
+      MarkSegmentPages(segment_uploaded_pages_, upload_range_start, upload_range_length);
+      while (upload_range_length != 0) {
+        ID3D12Resource* upload_buffer;
+        size_t upload_buffer_offset, upload_buffer_size;
+        uint8_t* upload_buffer_mapping = upload_buffer_pool_->RequestPartial(
+            command_processor_.GetCurrentSubmission(), upload_range_length << page_size_log2(),
+            size_t(1) << page_size_log2(), &upload_buffer, &upload_buffer_offset,
+            &upload_buffer_size, nullptr);
+        if (upload_buffer_mapping == nullptr) {
+          REXGPU_ERROR("Shared memory: Failed to get an upload buffer");
+          return false;
+        }
+        MakeRangeValid(upload_range_start << page_size_log2(), uint32_t(upload_buffer_size), false);
+        std::memcpy(upload_buffer_mapping,
+                    memory().TranslatePhysical(upload_range_start << page_size_log2()),
+                    upload_buffer_size);
+        command_list.AddUploadCopy(upload_batch_index_, upload_buffer,
+                                   UINT64(upload_buffer_offset),
+                                   UINT64(upload_range_start) << page_size_log2(),
+                                   UINT64(upload_buffer_size));
+        uint32_t upload_buffer_pages = uint32_t(upload_buffer_size >> page_size_log2());
+        upload_range_start += upload_buffer_pages;
+        upload_range_length -= upload_buffer_pages;
+      }
+    }
+    return true;
+  }
   CommitUAVWritesAndTransitionBuffer(D3D12_RESOURCE_STATE_COPY_DEST);
   command_processor_.SubmitBarriers();
   auto& command_list = command_processor_.GetDeferredCommandList();
