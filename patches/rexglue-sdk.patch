+uint64_t D3D12CommandProcessor::BarrierStatKey(ID3D12Resource* resource, uint32_t kind,
+                                               uint32_t before, uint32_t after) {
+  // Resource class: 1 shared memory, 2 other buffer, 3 texture.
+  uint32_t resource_class = 3;
+  if (resource && shared_memory_ && resource == shared_memory_->GetBuffer()) {
+    resource_class = 1;
+  } else if (resource && resource->GetDesc().Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) {
+    resource_class = 2;
+  } else if (!resource) {
+    resource_class = 0;
+  }
+  return (uint64_t(kind) << 60) | (uint64_t(resource_class) << 56) |
+         (uint64_t(before & 0xFFFFFFF) << 28) | uint64_t(after & 0xFFFFFFF);
+}
