+                      pf.batches ? double(pf.draws) / double(pf.batches) : 0.0, pf.max_batch,
+                      pf.source_vertices / frames, padded / frames,
+                      pf.source_vertices ? 100.0 * (double(padded) - double(pf.source_vertices)) /
+                                               double(pf.source_vertices)
+                                         : 0.0,
+                      pf.split_state / frames, pf.split_ratio / frames, pf.split_cap / frames, pf.cap,
+                      pf.inel_ib / frames, pf.inel_reset / frames, pf.inel_align / frames,
+                      pf.concat_batches / frames, pf.empty / frames, pf.strip_draws / frames, pf.strip_mode);
+        }
+        pf.draws = pf.batches = pf.source_vertices = pf.padded_vertices = pf.max_batch = 0;
+        pf.concat_batches = pf.empty = pf.strip_draws = 0;
+        PrepassFuseVerifyState& v = g_pfv;
+        PrepassFuseVerifyHarvest(submission_completed_);
+        if (v.tests || v.skipped) {
+          REXLOG_INFO("PREPASS FUSE VERIFY: {} tests ({:.1f} instances each) | EXACT {} of {} | samples differ: depth {}, "
+                      "stencil {} | covered samples {} | skipped {}",
+                      v.tests, v.tests ? double(v.instances) / double(v.tests) : 0.0, v.exact, v.tests,
