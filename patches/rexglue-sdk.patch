+// EXEC9: draw metadata v1 (production engine metadata, advisory; native_frame_bridge.h). Intake on the submitting
+// thread, bound to its next SubmitCommandStream (generic command_processor.cpp), looked up at IssueDraw by the
+// executed packet_end. Verification/diagnostics only: nothing here changes a draw.
+static int NativeMetaSubmit(const void* batch, uint32_t batch_size) {
+  using rex::graphics::NativeMetaBatch;
+  rex::graphics::g_native_meta_seen.store(true, std::memory_order_relaxed);
+  auto b = std::make_shared<NativeMetaBatch>();
+  int result = 0;
+  RexNativeDrawMetaBatchV1 h{};
+  if (!batch || batch_size < sizeof(h)) {
+    result = -1;
+  } else {
+    std::memcpy(&h, batch, sizeof(h));
+    b->kick_epoch = h.kick_epoch;
+    b->stream_base = h.stream_base;
+    b->stream_dwords = h.stream_dwords;
+    b->flags = h.flags;
+    if (h.version != REX_NATIVE_DRAW_META_VERSION_1 || h.record_size != REX_NATIVE_DRAW_META_RECORD_SIZE ||
+        h.record_count > (1u << 20) || h.size != batch_size ||
+        uint64_t(h.size) != uint64_t(REX_NATIVE_DRAW_META_BATCH_HEADER_SIZE) +
+                                uint64_t(h.record_count) * REX_NATIVE_DRAW_META_RECORD_SIZE) {
+      result = -1;
+    } else if (h.reserved0) {
+      result = -2;
+    } else {
+      b->recs.resize(h.record_count);
+      if (h.record_count) {
+        std::memcpy(b->recs.data(), static_cast<const uint8_t*>(batch) + REX_NATIVE_DRAW_META_BATCH_HEADER_SIZE,
+                    size_t(h.record_count) * REX_NATIVE_DRAW_META_RECORD_SIZE);
+      }
+      for (const RexNativeDrawMetaRecordV1& r : b->recs) {
+        if (r.reserved0 || r.reserved1) result = -2;
+      }
+      if (!result) {
+        std::sort(b->recs.begin(), b->recs.end(),
+                  [](const RexNativeDrawMetaRecordV1& x, const RexNativeDrawMetaRecordV1& y) {
+                    return x.packet_end < y.packet_end;
+                  });
+        size_t o = 0;
+        for (size_t i = 0; i < b->recs.size(); ++i) {
+          if (o && b->recs[o - 1].packet_end == b->recs[i].packet_end) {
+            if (std::memcmp(&b->recs[o - 1], &b->recs[i], sizeof(RexNativeDrawMetaRecordV1))) result = -3;
+            continue;  // identical duplicate: keep one
+          }
+          b->recs[o++] = b->recs[i];
+        }
+        b->recs.resize(o);
+      }
+    }
+  }
+  if (result < 0) {
+    b->poisoned = true;
+    b->recs.clear();
+  }
+  if (rex::graphics::g_native_meta_pending) {
+    rex::graphics::g_native_meta_claim_stat[3].fetch_add(1, std::memory_order_relaxed);
+  }
+  rex::graphics::g_native_meta_pending = std::move(b);
+  return result < 0 ? result : int(h.record_count);
+}
+
+struct NativeMetaWindow {
+  uint64_t draws[kNbClassCount] = {}, hit[kNbClassCount] = {}, miss[kNbClassCount] = {};
+  uint64_t no_batch = 0, poisoned = 0, nested = 0, nested_hit = 0, tile = 0, no_key = 0;
+  uint64_t v3_compared = 0, v3_exact = 0, field_bad[6] = {};  // pass mesh instance caller path args
+  uint64_t path_hist[REX_NATIVE_PATH_COUNT + 1] = {};
+  uint64_t next_log = 0;
+};
+static NativeMetaWindow g_nm;
+
+// IssueDraw (CP thread), right after NativeBridgeVerifyDraw: default path = one thread-local load.
+static inline void NativeMetaOnDraw(const RegisterFile& regs) {
+  const rex::graphics::NativeMetaBatch* b = rex::graphics::g_native_meta_active;
+  if (!b && !rex::graphics::g_native_meta_seen.load(std::memory_order_relaxed)) return;
+  NativeMetaWindow& w = g_nm;
+  const NativeBridgeClass cls = NativeBridgeClassify(regs);
+  ++w.draws[cls];
+  const uint32_t depth = rex::graphics::g_native_bridge_ib_depth;
+  if (depth) ++w.nested;
+  if (!b) {
+    ++w.no_batch;
+  } else if (b->poisoned) {
+    ++w.poisoned;
+  } else {
+    if (b->flags & REX_NATIVE_DRAW_META_BATCH_TILE_CONTROL) ++w.tile;
+    const uint32_t pe = rex::graphics::g_native_bridge_packet_end;
+    if (!pe) {
+      ++w.no_key;
+    } else {
+      const uint32_t key = NativeBridgePhys(pe);
+      auto it = std::lower_bound(b->recs.begin(), b->recs.end(), key,
+                                 [](const RexNativeDrawMetaRecordV1& r, uint32_t k) { return r.packet_end < k; });
+      if (it == b->recs.end() || it->packet_end != key) {
+        ++w.miss[cls];
+      } else {
+        ++w.hit[cls];
+        if (depth) ++w.nested_hit;
+        ++w.path_hist[std::min<uint32_t>(it->path_id, REX_NATIVE_PATH_COUNT)];
+        // Compare with the verify-path record of the same draw (only while native_bridge_verify +
+        // native_frame_exec_verify run).
+        const NativeBridgeM3aCur& c = g_m3a_cur;
+        if (NativeBridgeEnabled() && c.active && c.matched) {
+          ++w.v3_compared;
+          const RexNativeDrawRecordV2& r = c.r;
+          const bool bad[6] = {it->pass_id != r.pass_id, it->mesh_guest != r.mesh_guest,
+                               it->instance_guest != r.instance_guest, it->caller != r.caller,
+                               uint32_t(it->path_id) != r.path_id,
+                               (it->flags & REX_NATIVE_DRAW_META_FLAG_ENGINE_ARGS_VALID) &&
+                                   (it->base_vertex != r.base_vertex || it->start_index != r.start_index ||
+                                    it->engine_count != r.index_count)};
+          bool any = false;
+          for (int i = 0; i < 6; ++i) {
+            w.field_bad[i] += bad[i];
+            any |= bad[i];
+          }
+          if (!any) ++w.v3_exact;
+        }
+      }
+    }
+  }
+  const uint64_t now = GetTickCount64();
+  if (now < w.next_log) return;
+  if (w.next_log) {
+    auto ld = [](std::atomic<uint64_t>& a) { return a.exchange(0, std::memory_order_relaxed); };
+    std::string per, paths;
+    for (uint32_t i = 0; i < kNbClassCount; ++i) {
+      per += fmt::format(" {} {}/{}/{}", kNbClassName[i], w.draws[i], w.hit[i], w.miss[i]);
+    }
+    for (uint32_t i = 0; i <= REX_NATIVE_PATH_COUNT; ++i) {
+      if (w.path_hist[i]) paths += fmt::format(" {}:{}", i, w.path_hist[i]);
+    }
+    REXLOG_INFO("NATIVE EXEC draw-meta (EXEC9, 10 s): batches claimed {} root-mismatch {} streams without batch {} "
+                "replaced {} | draws/hit/miss:{} | no batch {} poisoned {} no key {} nested {} (hit {}) tile-control {} "
+                "| hit paths:{} | vs v3 record: compared {} exact {} bad pass {} mesh {} instance {} caller {} path {} "
+                "args {}",
+                ld(rex::graphics::g_native_meta_claim_stat[0]), ld(rex::graphics::g_native_meta_claim_stat[1]),
+                ld(rex::graphics::g_native_meta_claim_stat[2]), ld(rex::graphics::g_native_meta_claim_stat[3]), per,
+                w.no_batch, w.poisoned, w.no_key, w.nested, w.nested_hit, w.tile, paths.empty() ? " none" : paths,
+                w.v3_compared, w.v3_exact, w.field_bad[0], w.field_bad[1], w.field_bad[2], w.field_bad[3],
+                w.field_bad[4], w.field_bad[5]);
+  }
+  w = NativeMetaWindow{};
+  w.next_log = now + 10000;
+}
+
+extern "C" __declspec(dllexport) int RexNativeRendererSubmitDrawMetadataV1Batch(const void* batch,
+                                                                                uint32_t batch_size) {
+  return NativeMetaSubmit(batch, batch_size);
+}
+
+// C linkage export (declared inside the namespace; the name is not mangled).
+extern "C" __declspec(dllexport) int RexNativeRendererSubmitDrawRecordV2(const void* record,
+                                                                          uint32_t record_size) {
+  return NativeBridgeSubmitV2(record, record_size);
+}
+
+// Record v3 (v2 + used float-constant values), verification intake (VERIFY_ONLY v3 records only).
+extern "C" __declspec(dllexport) int RexNativeRendererSubmitDrawRecordV3(const void* record,
+                                                                          uint32_t record_size) {
+  return NativeBridgeSubmitV3(record, record_size);
+}
+
+// Used float-constant group masks of (record VS, record PS, vertex declaration): 1 = published (out_masks[0] VS,
+// out_masks[1] PS; bit g = constants 4g..4g+3), 0 = not published yet.
+// M3b marker record (v3): 1 + nonzero *out_record_id when stored, 0 = not ready (call the original writer).
+extern "C" __declspec(dllexport) int RexNativeRendererSubmitOwnedDrawRecordV3(const void* record,
+                                                                               uint32_t record_size,
+                                                                               uint32_t* out_record_id) {
+  // NATIVE23A2: record v4 (M3 executor: shadow / owned) -> native_m3_exec.inc.
+  if (record && record_size >= 8) {
+    uint32_t version = 0;
+    std::memcpy(&version, static_cast<const uint8_t*>(record) + 4, sizeof(version));
+    if (version == 4) return M3Submit(record, record_size, out_record_id);
+  }
+  return NativeMarkerSubmit(record, record_size, out_record_id);
+}
+
+// NATIVE23A2 M3: masks v2 (float groups + fetch units + SHADOW / OWNABLE flags) of (record VS, PS, vertex declaration).
+// 1 = published, 0 = not (yet), -1 = bad pointer. out is a RexNativeDrawMasksV2 (40 bytes).
+extern "C" __declspec(dllexport) int RexNativeRendererGetDrawMasksV2(uint32_t vs_guest, uint32_t ps_guest,
+                                                                      uint32_t vertex_decl_guest, void* out) {
+  return M3GetMasksExport(vs_guest, ps_guest, vertex_decl_guest, out);
+}
+
+// NATIVE23A2 M3: capabilities of this SDK build (bit 0 = v4 CALL_WORDS shadow intake, bit 1 = OWNED NOP-span execution).
+// The game turns its M3 path off when this export is missing; the dist switches still gate every mode.
+extern "C" __declspec(dllexport) uint32_t RexNativeRendererM3CapsV1() { return 3u; }
+
+// AGENT_NATIVE29A (session 29): batch of v3 / v4 VERIFY_ONLY records ('capture v4-full', 29B), V3Batch framing.
+extern "C" __declspec(dllexport) int RexNativeRendererSubmitDrawRecordsV4Batch(const void* blob, uint32_t bytes,
+                                                                               uint32_t count) {
+  return NativeBridgeSubmitV4Batch(blob, bytes, count);
+}
+// EXEC8 x8c: batch of v3 records (see NativeBridgeSubmitV3Batch), one bridge mutex acquire per batch.
+extern "C" __declspec(dllexport) int RexNativeRendererSubmitDrawRecordsV3Batch(const void* blob, uint32_t bytes,
+                                                                               uint32_t count) {
+  return NativeBridgeSubmitV3Batch(blob, bytes, count);
+}
+
+extern "C" __declspec(dllexport) int RexNativeRendererGetConstantMasks(uint32_t vs_guest, uint32_t ps_guest,
+                                                                        uint32_t vertex_decl_guest,
+                                                                        uint64_t* out_masks,
+                                                                        uint32_t* out_generation) {
+  return NativeBridgeGetMasks(vs_guest, ps_guest, vertex_decl_guest, out_masks, out_generation);
+}
diff --git a/src/graphics/d3d12/native_frame_exec_verify.inc b/src/graphics/d3d12/native_frame_exec_verify.inc
new file mode 100644
index 0000000..747f7c4
--- /dev/null
+++ b/src/graphics/d3d12/native_frame_exec_verify.inc
@@ -0,0 +1,1075 @@
+// Native frame executor M3a: "would this draw execute natively?" (verification only, counters only).
+// Included by d3d12/command_processor.cpp right after native_frame_bridge_verify.inc (namespace
+// rex::graphics::d3d12). Nothing here changes, skips or replaces the emulated draw.
+//
+// Switch: dist\native_frame_exec_verify, only read while dist\native_bridge_verify exists (the poll is part of
+// NativeBridgeEnabled). Off: IssueDraw tests one static bool (g_m3a_cur.active).
+//
+// For every CP draw whose bridge record was matched by packet address, the "draw entry" of the M3 executor is
+// looked up by RECORD DATA ONLY:
+//   L1 (shader pair) key = record VS guest address, PS guest address, vertex declaration
+//      -> learned: the Shader objects the CP really used (VS ucode is patched per declaration by 825DC108 /
+//         825DB738 and arrives by IM_LOAD_IMMEDIATE, so this checks that (VS, decl) names one translation),
+//         used float-constant groups (the mask the SDK would publish to the game), used fetch units.
+//   L2 (draw entry) key = L1 + record render-state hash (64 registers) and known-register mask + surface /
+//      colour mask / depth / mode control + primitive + draw initiator + record fetch hashes of the used units
+//      -> learned from IssueDraw on a miss: translations, bound pipeline, root signature, render-target formats,
+//         used textures, descriptor bindings, system constants, bool/loop constants, viewport/scissor, vertex
+//         buffer ranges, host primitive / index buffer kind.
+// On a hit every learned value is compared with what IssueDraw computes for this draw; per-draw values (index
+// base and count) are derived from the record and compared with the primitive processor result.
+// Reasons a draw would not execute natively are counted. Log "NATIVE EXEC M3a" every 10 s.
+
+enum M3aField : uint32_t {
+  kM3aFL1Shader = 0, kM3aFPsEff, kM3aFTrans, kM3aFPso, kM3aFRootSig, kM3aFRt, kM3aFTexMask, kM3aFTextures,
+  kM3aFDesc, kM3aFSys, kM3aFBoolLoop, kM3aFViewport, kM3aFVb, kM3aFPrim, kM3aFIbType, kM3aFIb, kM3aFCount,
+  kM3aFConsts, kM3aFLayout, kM3aFieldCount
+};
+static const char* const kM3aFieldName[kM3aFieldCount] = {
+    "l1shader", "pseff", "trans", "pso", "rootsig", "rt", "texmask", "textures", "desc", "sys",
+    "boolloop", "vp", "vb", "prim", "ibtype", "ib", "count", "consts", "layout"};
+
+enum M3aReason : uint32_t {
+  kM3aRNotExact = 0,  // a bridge verify field differs (record != register file)
+  kM3aRCopy,          // edram copy (resolve) - not a draw
+  kM3aREarlyFast,     // returned before the full path (slice-1 fast path, ...)
+  kM3aREarlyNoDraw,   // no effect / pre-pass skip / nothing to draw
+  kM3aREarlyPipe,     // pipeline pending / failed
+  kM3aREarlyBind,     // returned between pipeline bind and vertex buffers (bindings failed)
+  kM3aRNative1,       // slice-1 native depth pipeline
+  kM3aRMemexport,
+  kM3aRViz,           // PA_SC_VIZ_QUERY enabled
+  kM3aRTess,
+  kM3aRNoBindless,
+  kM3aRPrimProc,      // indices need the primitive processor (not a plain guest DMA list / count differs)
+  kM3aRLoopHi,        // shader reads loop constants 8..31 (not in the record's state list)
+  kM3aRNoState,       // record without full stream state (render-state key incomplete)
+  kM3aRNoShaderAddr,  // record without VS address
+  kM3aRTex3D,         // textures not cacheable (3D)
+  kM3aRMiss,          // draw entry not yet known (executor would fall back once)
+  kM3aRDiff,          // draw entry known but a learned value differs (key incomplete)
+  kM3aRNoKey,         // CP has no packet address for the draw (primary ring)
+  kM3aRNoRecord,      // packet address known, no engine record (capture miss)
+  kM3aRNestedIb,      // no record and the packet is in a nested INDIRECT_BUFFER (depth >= 2): not a capture miss
+  kM3aRNoValues,      // record without float-constant values (v2) or a used constant missing from the v3 masks
+  kM3aRValueBad,      // record v3 value != the register-file value UpdateBindings packed
+  kM3aRHeader,        // EXEC8 x8d: record draw_header missing or != the executed DRAW header (predicate bit!)
+  kM3aReasonCount
+};
+static const char* const kM3aReasonName[kM3aReasonCount] = {
+    "notexact", "copy", "early_fast", "early_nodraw", "early_pipe", "early_bind", "native1", "memexport",
+    "viz", "tess", "nobindless", "primproc", "loophi", "nostate", "noshaderaddr", "tex3d", "miss", "diff", "nokey", "norecord", "nested_ib", "novalues", "valuebad", "header"};
+
+static inline uint64_t M3aHashBytes(const void* data, size_t size, uint64_t h = 0xCBF29CE484222325ull) {
+  const uint8_t* p = static_cast<const uint8_t*>(data);
+  for (size_t i = 0; i < size; ++i) {
+    h = (h ^ p[i]) * 0x100000001B3ull;
+  }
+  return h;
+}
+static inline uint64_t M3aMix(uint64_t h, uint64_t v) {
+  h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+  return h * 0x100000001B3ull;
+}
+
+struct M3aL1 {
+  uint32_t vs_guest = 0, ps_guest = 0, decl = 0;
+  uint64_t id_vs = 0, id_ps = 0;  // EXEC8 x8b: ucode hashes of the CP's VS / effective PS (identity key)
+  const Shader* vs = nullptr;
+  const Shader* ps = nullptr;  // effective pixel shader (after IsPixelShaderNeededWithRasterization)
+  uint32_t units[3] = {};      // fetch units (2-word) the pair reads: texture slots of both + VS vertex fetches
+  uint32_t vunits[3] = {};     // NATIVE7: the VS vertex-fetch units among them (dynamic VB addresses)
+  uint64_t vs_groups = 0, ps_groups = 0;  // float-constant groups of 4 read (the mask to publish)
+  uint32_t vs_float_count = 0, ps_float_count = 0;
+  bool loop_hi = false, dynamic = false;
+  uint64_t pub_vs = 0, pub_ps = 0;  // union of the groups of every shader pair seen (published to the game)
+  bool published = false;
+};
+
+// Everything IssueDraw computed for this draw that an executor would have to reproduce.
+struct M3aDrawInfo {
+  const Shader* vs = nullptr;
+  const Shader* ps_raw = nullptr;
+  const Shader* ps_eff = nullptr;
+  const void* vs_tr = nullptr;
+  const void* ps_tr = nullptr;
+  const void* pso = nullptr;
+  const void* rootsig = nullptr;
+  uint32_t rt_bits = 0;
+  uint32_t rt_formats[1 + xenos::kMaxColorRenderTargets] = {};
+  uint32_t tex_mask = 0;
+  bool tex_ok = true;
+  std::vector<void*> textures;
+  uint64_t desc_hash = 0, sys_hash = 0, bl_hash = 0, vp_hash = 0, vb_hash = 0;
+  std::vector<uint32_t> sys;  // system constants as uploaded (diagnostics: first differing dword)
+  uint32_t host_prim = 0, host_vs_type = 0, ib_type = 0, ib_format = 0, ib_base = 0, host_count = 0;
+  bool native1 = false, memexport = false, tess = false, bindless = true, viz = false, exec_hit = false;
+  bool guest_dma = false;
+  uint64_t tex_gen = 0;
+  // EXEC8 x8a: the vertex buffers IssueDraw made resident (VS vertex_fetch_bitmap order), as values.
+  struct Vb {
+    uint32_t index, address, size, endian;
+    bool operator==(const Vb& o) const {
+      return index == o.index && address == o.address && size == o.size && endian == o.endian;
+    }
+  };
+  std::vector<Vb> vbs;
+};
+
+struct M3aEntry {
+  std::vector<uint32_t> key;
+  M3aDrawInfo v;
+  uint64_t hits = 0;
+};
+
+struct M3aWindow {
+  uint64_t cp_draws[kNbClassCount] = {}, matched[kNbClassCount] = {}, exact[kNbClassCount] = {},
+           would[kNbClassCount] = {}, would_given_consts[kNbClassCount] = {};
+  uint64_t reasons[kNbClassCount][kM3aReasonCount] = {};
+  uint64_t field_diff[kNbClassCount][kM3aFieldCount] = {};
+  uint64_t l2_hits = 0, l2_misses = 0, l2_flushes = 0, l1_new = 0, l1_mask_changes = 0;
+  // NATIVE7: misses that are the draw's only reason, and those whose static key (no vertex-fetch units) was seen.
+  uint64_t miss_only[kNbClassCount] = {}, miss_vb_only[kNbClassCount] = {};
+  uint64_t main_vs_groups = 0, main_ps_groups = 0, main_counted = 0, ps_eff_null = 0;
+  uint64_t ib_types[8] = {};
+  // Draws whose record has the full 64-register stream state (render-state key complete).
+  uint64_t full_state[kNbClassCount] = {}, would_if_state[kNbClassCount] = {};
+  uint64_t field_diff_full[kNbClassCount][kM3aFieldCount] = {}, reasons_full[kNbClassCount][kM3aReasonCount] = {};
+  uint64_t no_stream_flag = 0, state_partial = 0, unknown_reg[REX_NATIVE_STATE_REG_COUNT] = {};
+  std::string l1_examples;
+  uint32_t n_l1_examples[kNbClassCount] = {};
+  uint64_t depth_matched[6] = {}, depth_unmatched[6] = {};  // by INDIRECT_BUFFER depth
+  std::string examples;
+  uint32_t n_examples = 0;
+  // Record v3 values vs the register file (used constants only, per Shader float_bitmap).
+  uint64_t val_records = 0, val_consts = 0, val_missing = 0, val_bad = 0, val_bad_records = 0,
+           val_missing_records = 0;
+  std::string val_examples;
+  uint32_t n_val_examples = 0;
+  // EXEC8 x8a: entry split (static entry, VB = per-draw binding) and the M3b dry executor.
+  uint64_t hits_vb_other = 0;         // L2 hits whose vertex buffers differ from the entry's first draw
+  uint64_t hits_vb_other_clean = 0;   //   ... and no other entry field differs (the split works for them)
+  uint64_t sys_diff_hits = 0;         // L2 hits whose system constants differ from the entry's (don't-care masked)
+  uint64_t sys_dontcare_hits = 0;     // L2 hits whose system constants differ only in don't-care dwords
+  uint64_t hits_material_only = 0;    // L2 hits whose only entry diffs are textures / descriptors (material dynamic)
+  uint32_t sys_dword_diff[256] = {};  // which system-constant dwords differ (index < 256)
+  uint64_t dry_cand[kNbClassCount] = {}, dry_ready[kNbClassCount] = {};
+  uint64_t dry_fail[16] = {};
+  uint64_t dry_ticks_lookup = 0, dry_ticks_build = 0, dry_ticks_xxh = 0, dry_ticks_max = 0;
+  uint64_t dry_bytes = 0, dry_vbs = 0, dry_key_words = 0;
+  std::string dry_examples;
+  uint32_t n_dry_examples = 0;
+  // EXEC8 x8d: dry REPLAY = the real preparation helpers run again for a READY draw after IssueDraw issued it,
+  // with the final Draw*Instanced suppressed (command_processor.cpp end of IssueDraw). TSC ticks per stage.
+  uint64_t rp_n = 0, rp_fail = 0, rp_ticks[8] = {};
+  uint64_t qpc0 = 0, tsc0 = 0;  // window start (TSC -> us calibration)
+};
+
+struct M3aState {
+  std::unordered_map<uint64_t, M3aL1> l1;
+  std::unordered_map<uint64_t, std::unique_ptr<M3aEntry>> l2;
+  // NATIVE7: hashes of the L2 keys WITHOUT the vertex-fetch units (a "static" entry with dynamic VB binding).
+  std::unordered_map<uint64_t, uint32_t> l2s;
+  // EXEC8 x8b: float-group masks published to the game per RECORD address key (union over every identity seen).
+  std::unordered_map<uint64_t, std::pair<uint64_t, uint64_t>> pub;
+  uint64_t tex_gen = ~uint64_t(0);
+  uint64_t last_log_tick = 0;
+  M3aWindow w;
+  M3aDrawInfo info;  // filled at the pipeline / vertex-buffer stages of the current IssueDraw
+};
+static M3aState g_m3a;
+// EXEC8 x8d: L2 key hash = XXH3 (was the byte-wise FNV M3aHashBytes: 0.3 us of the 0.37 us lookup).
+static inline uint64_t M3aKeyHash(const std::vector<uint32_t>& key) {
+  return XXH3_64bits(key.data(), key.size() * sizeof(uint32_t));
+}
+// EXEC8 x8d: dry replay hand-off (CP thread): M3bDryBuild sets it for a READY draw; IssueDraw's tail consumes it.
+// dist\native_frame_exec_dryreplay.off = no replay (A/B its cost).
+struct M3bReplay {
+  bool pending = false;
+  const M3aEntry* entry = nullptr;
+  // EXEC9: bounded replay (codex12_review_x8d): per-frame cap + session latch after the first helper failure.
+  bool latched = false;
+  uint64_t frame = ~uint64_t(0);
+  uint32_t in_frame = 0;
+};
+static constexpr uint32_t kM3bReplayPerFrame = 64;
+static M3bReplay g_m3b_replay;
+static std::atomic<bool> g_m3b_replay_on{true};
+// EXEC8 x8a: dist\native_frame_exec_drybuild (with native_bridge_verify + native_frame_exec_verify): for every
+// would-execute draw build everything a native draw needs (entry lookup, constants, system constants, bool/loop,
+// VB list from the CP register file, IB view, texture freshness) WITHOUT issuing it, compare each part with what
+// IssueDraw produced, time it. Polled with the M3a log (10 s). Off: one relaxed load per would-execute draw.
+static std::atomic<bool> g_m3b_dry_on{false};
+
+// Count the outcome of the current draw (called once per IssueDraw while active).
+static void M3aCount(uint32_t reasons, uint32_t diffs, bool full_state) {
+  NativeBridgeM3aCur& c = g_m3a_cur;
+  M3aWindow& w = g_m3a.w;
+  const uint32_t cls = c.cls;
+  const uint32_t value_bits = (1u << kM3aRNoValues) | (1u << kM3aRValueBad);
+  if (!(reasons & ~((1u << kM3aRNoState) | value_bits))) ++w.would_if_state[cls];
+  if (full_state) {
+    ++w.full_state[cls];
+    for (uint32_t i = 0; i < kM3aReasonCount; ++i) {
+      if (reasons & (1u << i)) ++w.reasons_full[cls][i];
+    }
+    for (uint32_t f = 0; f < kM3aFieldCount; ++f) {
+      if (diffs & (1u << f)) ++w.field_diff_full[cls][f];
+    }
+  }
+  for (uint32_t i = 0; i < kM3aReasonCount; ++i) {
+    if (reasons & (1u << i)) ++w.reasons[cls][i];
+  }
+  for (uint32_t f = 0; f < kM3aFieldCount; ++f) {
+    if (diffs & (1u << f)) ++w.field_diff[cls][f];
+  }
+  // would-execute: nothing blocking, the record carries every used float constant's value (v3) and they equal
+  // what UpdateBindings packed. "given const values" = the same ignoring the values.
+  if (!(reasons & ~value_bits)) ++w.would_given_consts[cls];
+  if (!reasons) ++w.would[cls];
+}
+
+// IssueDraw ended before the vertex-buffer stage, or ended normally: count it.
+static void M3aFinish() {
+  NativeBridgeM3aCur& c = g_m3a_cur;
+  c.active = false;
+  M3aWindow& w = g_m3a.w;
+  ++w.cp_draws[c.cls];
+  const uint32_t depth = c.ib_depth < 5 ? c.ib_depth : 5;
+  if (!c.matched) {
+    ++w.depth_unmatched[depth];
+    const uint32_t why = c.outcome == 0 ? kM3aRNoKey : c.ib_depth >= 2 ? kM3aRNestedIb : kM3aRNoRecord;
+    ++w.reasons[c.cls][why];
+    return;
+  }
+  ++w.depth_matched[depth];
+  ++w.matched[c.cls];
+  if (!c.bad) ++w.exact[c.cls];
+  if (c.done) return;
+  uint32_t reasons = c.bad ? (1u << kM3aRNotExact) : 0;
+  switch (c.stage) {
+    case 0: reasons |= 1u << (c.cls == kNbCopy ? kM3aRCopy : kM3aREarlyFast); break;
+    case 1: reasons |= 1u << kM3aREarlyNoDraw; break;
+    case 2: reasons |= 1u << kM3aREarlyPipe; break;
+    default: reasons |= 1u << kM3aREarlyBind; break;
+  }
+  M3aCount(reasons, 0, false);
+}
+
+static inline uint64_t M3aL1Key(uint32_t vs_a, uint32_t ps_a, uint32_t decl) {
+  return (uint64_t(vs_a) << 32 | ps_a) ^ (uint64_t(decl) * 0x9E3779B97F4A7C15ull);
+}
+
+// EXEC8 x8b: shader IDENTITY key (codex8_ucode_identity, SDK-derived as AGENT_FRAME8 asked): L1 = (ucode hash of the
+// CP's active VS, ucode hash of the effective PS or 0, record vertex declaration). The executor runs at IssueDraw
+// with PM4 still executing, so the active Shader objects (LoadShader at IM_LOAD time) are known without the record
+// naming them: reused VS addresses (8223E864 / 0E3B3C00, ucode patched per declaration) and path-6
+// IM_LOAD_IMMEDIATE shaders (no address) get unique keys. Default ON with M3a; dist\native_frame_exec_addrkey =
+// old record-address key (A/B). Polled with the M3a log.
+static std::atomic<bool> g_m3a_id_key{true};
+struct M3aL1Id {
+  uint32_t vs_a = 0, ps_a = 0, decl = 0;
+  uint64_t id_vs = 0, id_ps = 0;
+};
+static inline M3aL1Id M3aMakeL1Id(const RexNativeDrawRecordV2& r, const Shader* vs, const Shader* ps_eff) {
+  M3aL1Id id;
+  id.vs_a = NativeBridgePhys(r.vertex_shader_guest);
+  id.ps_a = NativeBridgePhys(r.pixel_shader_guest);
+  id.decl = r.vertex_decl_guest;
+  id.id_vs = vs ? vs->ucode_data_hash() : 0;
+  id.id_ps = ps_eff ? ps_eff->ucode_data_hash() : 0;
+  return id;
+}
+static inline uint64_t M3aL1KeyOf(const M3aL1Id& id) {
+  if (!g_m3a_id_key.load(std::memory_order_relaxed)) return M3aL1Key(id.vs_a, id.ps_a, id.decl);
+  uint64_t h = M3aMix(0x51ED270B27A1F3C5ull, id.id_vs);
+  h = M3aMix(h, id.id_ps);
+  return M3aMix(h, id.decl);
+}
+static inline bool M3aL1Matches(const M3aL1& l, const M3aL1Id& id) {
+  if (l.decl != id.decl) return false;
+  if (!g_m3a_id_key.load(std::memory_order_relaxed)) return l.vs_guest == id.vs_a && l.ps_guest == id.ps_a;
+  return l.id_vs == id.id_vs && l.id_ps == id.id_ps;
+}
+// Words of the L2 key before the fetch units (13 with addresses, 15 with the two 64-bit identities).
+static inline size_t M3aL2PrefixWords() { return g_m3a_id_key.load(std::memory_order_relaxed) ? 15 : 13; }
+
+// L2 key = record data only (shader pair, 64-register state hash + known mask, RT fields, primitive, initiator,
+// fetch hashes of the units the pair reads).
+// NATIVE7 s3: the VS vertex-fetch units (vertex buffer addresses) are NOT part of the key by default: an executor binds
+// the vertex buffers per draw (from the record / CP register file), the entry holds only the static part.
+// dist\native_frame_exec_vbkey = old key with the vertex-fetch units (A/B); polled with the log (every 10 s).
+static std::atomic<bool> g_m3a_vb_in_key{false};
+static void M3aBuildL2Key(const RexNativeDrawRecordV2& r, const M3aL1& l1, std::vector<uint32_t>& key) {
+  const bool vb_in_key = g_m3a_vb_in_key.load(std::memory_order_relaxed);
+  key.clear();
+  key.reserve(24 + 96);
+  if (g_m3a_id_key.load(std::memory_order_relaxed)) {
+    key.push_back(uint32_t(l1.id_vs));
+    key.push_back(uint32_t(l1.id_vs >> 32));
+    key.push_back(uint32_t(l1.id_ps));
+    key.push_back(uint32_t(l1.id_ps >> 32));
+  } else {
+    key.push_back(NativeBridgePhys(r.vertex_shader_guest));
+    key.push_back(NativeBridgePhys(r.pixel_shader_guest));
+  }
+  key.push_back(r.vertex_decl_guest);
+  key.push_back(r.reserved1);
+  key.push_back(r.reserved2[0]);
+  key.push_back(r.reserved2[1]);
+  key.push_back(r.surface_info);
+  key.push_back(r.color_mask);
+  key.push_back(r.depth_control);
+  key.push_back(r.mode_control);
+  key.push_back(r.primitive_type);
+  // Draw initiator: primitive, source select, index size (bits 0-5, 6-7, 11), not the count.
+  key.push_back(r.draw_initiator & 0x0000FFFFu);
+  key.push_back(r.flags & (REX_NATIVE_DRAW_FLAG_INDEXED | REX_NATIVE_DRAW_FLAG_STATE |
+                           REX_NATIVE_DRAW_FLAG_STREAM_STATE));
+  for (uint32_t u = 0; u < 96; ++u) {
+    if ((l1.units[u >> 5] & (1u << (u & 31))) && (vb_in_key || !(l1.vunits[u >> 5] & (1u << (u & 31))))) {
+      key.push_back(u);
+      key.push_back(r.fetch_hash[u]);
+    }
+  }
+}
+
+// M3b marker (CP thread): would the executor find a draw entry for this record? (L1 by record shaders, L2 by key.)
+static void M3aMarkerProbe(NativeMarkerPending& pm) {
+  const RexNativeDrawRecordV2& r = pm.rec.r;
+  NativeMarkerWindow& mw = g_native_bridge.mw;
+  pm.entry_found = false;
+  pm.entry_hash = 0;
+  // x8b: with the identity key the marker (no Shader objects at hand) cannot look the entry up -> counted missing.
+  if (g_m3a_id_key.load(std::memory_order_relaxed)) {
+    ++mw.entry_missing;
+    return;
+  }
+  const uint32_t vs_a = NativeBridgePhys(r.vertex_shader_guest), ps_a = NativeBridgePhys(r.pixel_shader_guest);
+  auto l1_it = g_m3a.l1.find(M3aL1Key(vs_a, ps_a, r.vertex_decl_guest));
+  if (l1_it == g_m3a.l1.end() || l1_it->second.vs_guest != vs_a || l1_it->second.ps_guest != ps_a ||
+      l1_it->second.decl != r.vertex_decl_guest) {
+    ++mw.entry_missing;
+    return;
+  }
+  std::vector<uint32_t> key;
+  M3aBuildL2Key(r, l1_it->second, key);
+  const uint64_t h = M3aKeyHash(key);
+  auto it = g_m3a.l2.find(h);
+  if (it == g_m3a.l2.end() || it->second->key != key) {
+    ++mw.entry_missing;
+    return;
+  }
+  ++mw.entry_ready;
+  pm.entry_found = true;
+  pm.entry_hash = h;
+}
+
+// EXEC8 x8a: system constants equal except don't-care dwords. UpdateSystemConstantValues writes the point sizes
+// only for point lists, so every other draw carries the last point draw's values (sticky, never read).
+static bool M3aSysEqual(const std::vector<uint32_t>& a, const std::vector<uint32_t>& b, uint32_t prim) {
+  if (a.size() != b.size()) return false;
+  if (prim == uint32_t(xenos::PrimitiveType::kPointList)) return a == b;
+  using SC = DxbcShaderTranslator::SystemConstants;
+  const size_t p0 = offsetof(SC, point_vertex_diameter_min) / 4, p1 = offsetof(SC, point_vertex_diameter_max) / 4,
+               p2 = offsetof(SC, point_constant_diameter) / 4,
+               p4 = offsetof(SC, point_screen_diameter_to_ndc_radius) / 4;
+  for (size_t i = 0; i < a.size(); ++i) {
+    if (a[i] != b[i] && i != p0 && i != p1 && i != p2 && i != p2 + 1 && i != p4 && i != p4 + 1) return false;
+  }
+  return true;
+}
+
+// ---- EXEC8 x8a: M3b dry executor (verification only, dist\native_frame_exec_drybuild) ----
+enum M3bDryFail : uint32_t {
+  kM3bFLookup = 0,   // the record-only entry lookup did not find the entry M3a hit
+  kM3bFNoVs,         // entry without a vertex shader
+  kM3bFTexOutdated,  // a texture of the entry must be reloaded (or the entry's textures are not cacheable)
+  kM3bFVbInvalid,    // a vertex fetch constant of the VS is not of vertex type
+  kM3bFVbBad,        // VB list built from the register file != the one IssueDraw made resident
+  kM3bFVsConsts,     // VS float constants packed from the record values != IssueDraw's upload (register file)
+  kM3bFPsConsts,     // same for the effective PS
+  kM3bFSys,          // entry system constants != the ones IssueDraw computed for this draw
+  kM3bFIb,           // index buffer view from the record != primitive processor result
+  kM3bFPso,          // entry pipeline / root signature != bound
+  kM3bFailCount
+};
+static const char* const kM3bFailName[kM3bFailCount] = {"lookup", "novs",   "tex_outdated", "vb_invalid", "vb_bad",
+                                                        "vs_consts", "ps_consts", "sys", "ib", "pso"};
+struct M3bDryScratch {
+  std::vector<uint32_t> key;
+  std::vector<uint8_t> vsc, psc;
+  std::vector<uint32_t> sys;
+  uint32_t bl[8 + 32] = {};
+  std::vector<M3aDrawInfo::Vb> vbs;
+};
+static M3bDryScratch g_m3b_dry;
+// x8d: TSC (~20 cycles) instead of QPC; converted with the per-window TSC/QPC calibration in the log.
+static inline uint64_t M3bTicks() { return __rdtsc(); }
+// Float constants of s packed in float_bitmap order (as UpdateBindings uploads them) from the record's v3 values.
+static bool M3bPackRecordFloats(const Shader* s, uint32_t stage, const NativeBridgeM3aCur& c,
+                                std::vector<uint8_t>& out) {
+  out.clear();
+  if (!s || !s->is_ucode_analyzed()) return true;
+  const Shader::ConstantRegisterMap& map = s->constant_register_map();
+  uint32_t n = 0;
+  for (uint32_t i = 0; i < 4; ++i) n += uint32_t(std::popcount(map.float_bitmap[i]));
+  out.resize(size_t(std::max(n, 1u)) * 16);
+  uint8_t* dst = out.data();
+  const uint64_t gm = c.vmask[stage];
+  const uint32_t before_stage = stage ? uint32_t(std::popcount(c.vmask[0])) : 0u;
+  uint32_t cur_g = ~0u;
+  const uint32_t* gp = nullptr;
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t bits = map.float_bitmap[i];
+    while (bits) {
+      const uint32_t k = (i << 6) + uint32_t(std::countr_zero(bits));
+      bits &= bits - 1;
+      const uint32_t g = k >> 2;
+      if (g != cur_g) {
+        cur_g = g;
+        if (!((gm >> g) & 1)) return false;
+        const size_t off = size_t(before_stage + uint32_t(std::popcount(gm & ((uint64_t(1) << g) - 1)))) * 16;
+        if (off + 16 > c.values.size()) return false;
+        gp = c.values.data() + off;
+      }
+      std::memcpy(dst, gp + (k & 3) * 4, 16);
+      dst += 16;
+    }
+  }
+  return true;
+}
+// Packed buffer == the register-file constants in bitmap order (what UpdateBindings uploaded for this draw).
+static bool M3bCheckFloats(const Shader* s, uint32_t stage, const RegisterFile& regs, const std::vector<uint8_t>& buf) {
+  if (!s || !s->is_ucode_analyzed()) return true;
+  const Shader::ConstantRegisterMap& map = s->constant_register_map();
+  const uint32_t first = stage ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X;
+  const uint8_t* p = buf.data();
+  const uint8_t* end = buf.data() + buf.size();
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t bits = map.float_bitmap[i];
+    while (bits) {
+      const uint32_t k = (i << 6) + uint32_t(std::countr_zero(bits));
+      bits &= bits - 1;
+      if (p + 16 > end || std::memcmp(p, &regs[first + k * 4], 16)) return false;
+      p += 16;
+    }
+  }
+  return true;
+}
+
+// A would-execute draw (L2 hit, no blocking reason): build the native draw from the static entry e, the record
+// (shaders, constants, index buffer) and the register file (vertex buffers, bool/loop: PM4 still executes), without
+// issuing it; then compare every part with d = what IssueDraw produced for this draw.
+static void M3bDryBuild(const RegisterFile& regs, const M3aEntry& e, const M3aDrawInfo& d) {
+  NativeBridgeM3aCur& c = g_m3a_cur;
+  M3aWindow& w = g_m3a.w;
+  M3bDryScratch& x = g_m3b_dry;
+  const RexNativeDrawRecordV2& r = c.r;
+  ++w.dry_cand[c.cls];
+  uint32_t fail = 0;
+  // (1) entry lookup by record data only, as the executor does it.
+  const uint64_t t0 = M3bTicks();
+  const M3aEntry* found = nullptr;
+  {
+    // The executor knows the CP's active VS / effective PS at IssueDraw (identity key) - here d's.
+    const M3aL1Id id = M3aMakeL1Id(r, d.vs, d.ps_eff);
+    auto l1_it = g_m3a.l1.find(M3aL1KeyOf(id));
+    if (l1_it != g_m3a.l1.end() && M3aL1Matches(l1_it->second, id)) {
+      M3aBuildL2Key(r, l1_it->second, x.key);
+      auto it = g_m3a.l2.find(M3aKeyHash(x.key));
+      if (it != g_m3a.l2.end() && it->second->key == x.key) found = it->second.get();
+    }
+  }
+  const uint64_t t1 = M3bTicks();
+  // x8d: the lookup itself uses XXH3 now; this is the old byte-wise FNV of the same key, for comparison.
+  volatile uint64_t xh = M3aHashBytes(x.key.data(), x.key.size() * sizeof(uint32_t));
+  (void)xh;
+  const uint64_t t2 = M3bTicks();
+  if (found != &e) fail |= 1u << kM3bFLookup;
+  // (2) build.
+  const M3aDrawInfo& v = e.v;
+  if (!v.vs) fail |= 1u << kM3bFNoVs;
+  if (!v.tex_ok || D3D12TextureCache::ExecAnyTextureOutdated(v.textures.data(), v.textures.size())) {
+    fail |= 1u << kM3bFTexOutdated;
+  }
+  const bool vs_ok = M3bPackRecordFloats(v.vs, 0, c, x.vsc);
+  const bool ps_ok = M3bPackRecordFloats(v.ps_eff, 1, c, x.psc);
+  x.sys.assign(v.sys.begin(), v.sys.end());
+  std::memcpy(x.bl, &regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], sizeof(x.bl));
+  x.vbs.clear();
+  bool vb_invalid = false;
+  if (v.vs && v.vs->is_ucode_analyzed()) {
+    const auto& vfb = v.vs->constant_register_map().vertex_fetch_bitmap;
+    for (uint32_t i = 0; i < uint32_t(sizeof(vfb) / sizeof(vfb[0])); ++i) {
+      uint32_t bits = vfb[i];
+      while (bits) {
+        const uint32_t idx = i * 32 + uint32_t(std::countr_zero(bits));
+        bits &= bits - 1;
+        const xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(idx);
+        if (vf.type != xenos::FetchConstantType::kVertex) vb_invalid = true;
+        x.vbs.push_back(M3aDrawInfo::Vb{idx, uint32_t(vf.address), uint32_t(vf.size), uint32_t(vf.endian)});
+      }
+    }
+  }
+  uint32_t ib_addr = 0, ib_bytes = 0;
+  if (v.guest_dma) {
+    const uint32_t isz = v.ib_format ? 4u : 2u;
+    const uint32_t rec_ib = (r.flags & REX_NATIVE_DRAW_FLAG_PM4_GEOMETRY) ? r.dma_base
+                                                                         : r.index_buffer_guest + r.start_index * isz;
+    ib_addr = NativeBridgeGpu(rec_ib) & ~(isz - 1);
+    ib_bytes = r.index_count * isz;
+  }
+  const uint64_t t3 = M3bTicks();
+  // (3) compare with IssueDraw (not timed).
+  if (vb_invalid) fail |= 1u << kM3bFVbInvalid;
+  if (!(x.vbs == d.vbs)) fail |= 1u << kM3bFVbBad;
+  if (!vs_ok || !M3bCheckFloats(v.vs, 0, regs, x.vsc) || v.vs != d.vs) fail |= 1u << kM3bFVsConsts;
+  if (!ps_ok || !M3bCheckFloats(v.ps_eff, 1, regs, x.psc) || v.ps_eff != d.ps_eff) fail |= 1u << kM3bFPsConsts;
+  if (!M3aSysEqual(x.sys, d.sys, r.primitive_type)) fail |= 1u << kM3bFSys;
+  if (v.guest_dma != d.guest_dma || v.ib_type != d.ib_type ||
+      (v.guest_dma && (ib_addr != (d.ib_base & 0x1FFFFFFFu) || r.index_count != d.host_count))) {
+    fail |= 1u << kM3bFIb;
+  }
+  if (v.pso != d.pso || v.rootsig != d.rootsig) fail |= 1u << kM3bFPso;
+  const uint64_t lookup = t1 - t0, build = t3 - t2;
+  w.dry_ticks_lookup += lookup;
+  w.dry_ticks_xxh += t2 - t1;
+  w.dry_ticks_build += build;
+  if (lookup + build > w.dry_ticks_max) w.dry_ticks_max = lookup + build;
+  w.dry_bytes += x.vsc.size() + x.psc.size() + x.sys.size() * 4 + sizeof(x.bl);
+  (void)ib_bytes;
+  w.dry_vbs += x.vbs.size();
+  w.dry_key_words += x.key.size();
+  if (!fail) {
+    ++w.dry_ready[c.cls];
+    if (g_m3b_replay_on.load(std::memory_order_relaxed)) {
+      g_m3b_replay.pending = true;
+      g_m3b_replay.entry = &e;
+    }
+    return;
+  }
+  std::string f;
+  for (uint32_t i = 0; i < kM3bFailCount; ++i) {
+    if (fail & (1u << i)) {
+      ++w.dry_fail[i];
+      f += fmt::format("{}{}", f.empty() ? "" : ",", kM3bFailName[i]);
+    }
+  }
+  if (w.n_dry_examples < 4) {
+    ++w.n_dry_examples;
+    std::string sysd;
+    if (fail & (1u << kM3bFSys)) {
+      for (size_t i = 0; i < x.sys.size() && i < d.sys.size(); ++i) {
+        if (x.sys[i] != d.sys[i]) {
+          sysd += fmt::format(" sys[{}] {:08X}->{:08X}", i, x.sys[i], d.sys[i]);
+          if (sysd.size() > 100) break;
+        }
+      }
+    }
+    w.dry_examples += fmt::format(" [{} path {} caller {:08X} vs {:08X} | {}{} | vbs {}/{}]", kNbClassName[c.cls],
+                                  r.path_id, r.caller, NativeBridgePhys(r.vertex_shader_guest), f, sysd,
+                                  x.vbs.size(), d.vbs.size());
+  }
+}
+
+// Vertex-buffer stage reached: build the draw entry from the record and compare (g_m3a.info is complete).
+static void M3aCompare(const RegisterFile& regs) {
+  (void)regs;
+  NativeBridgeM3aCur& c = g_m3a_cur;
+  c.done = true;
+  if (!c.matched) return;
+  const RexNativeDrawRecordV2& r = c.r;
+  M3aDrawInfo& d = g_m3a.info;
+  M3aWindow& w = g_m3a.w;
+  uint32_t reasons = c.bad ? (1u << kM3aRNotExact) : 0, diffs = 0;
+  if (d.native1) reasons |= 1u << kM3aRNative1;
+  if (d.memexport) reasons |= 1u << kM3aRMemexport;
+  if (d.viz) reasons |= 1u << kM3aRViz;
+  if (d.tess) reasons |= 1u << kM3aRTess;
+  if (!d.bindless) reasons |= 1u << kM3aRNoBindless;
+  if (!d.tex_ok) reasons |= 1u << kM3aRTex3D;
+  ++w.ib_types[d.ib_type & 7];
+  // Plain guest DMA lists and auto-indexed (non-indexed) draws need no primitive processor.
+  const bool plain_geometry =
+      (d.guest_dma || d.ib_type == uint32_t(PrimitiveProcessor::ProcessedIndexBufferType::kNone)) &&
+      d.host_count == r.index_count;
+  if (!plain_geometry) reasons |= 1u << kM3aRPrimProc;
+  const uint64_t known = uint64_t(r.reserved2[0]) | (uint64_t(r.reserved2[1]) << 32);
+  if (!(r.flags & REX_NATIVE_DRAW_FLAG_STATE) || !(r.flags & REX_NATIVE_DRAW_FLAG_STREAM_STATE) ||
+      known != ~0ull) {
+    reasons |= 1u << kM3aRNoState;
+    if (!(r.flags & REX_NATIVE_DRAW_FLAG_STREAM_STATE)) {
+      ++w.no_stream_flag;
+    } else {
+      ++w.state_partial;
+      for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+        if (!((known >> i) & 1)) ++w.unknown_reg[i];
+      }
+    }
+  }
+  const bool full_state = !(reasons & (1u << kM3aRNoState));
+  // x8b: the record's VS address only matters for the address key.
+  if (!r.vertex_shader_guest && !g_m3a_id_key.load(std::memory_order_relaxed)) reasons |= 1u << kM3aRNoShaderAddr;
+
+  // Per-draw values from the record: index base and count (plain guest DMA lists only).
+  if (d.guest_dma) {
+    const uint32_t isz = d.ib_format ? 4u : 2u;
+    const uint32_t rec_ib = (r.flags & REX_NATIVE_DRAW_FLAG_PM4_GEOMETRY)
+                                ? r.dma_base
+                                : r.index_buffer_guest + r.start_index * isz;
+    if ((NativeBridgeGpu(rec_ib) & ~(isz - 1)) != (d.ib_base & 0x1FFFFFFFu)) diffs |= 1u << kM3aFIb;
+    if (r.index_count != d.host_count) diffs |= 1u << kM3aFCount;
+  }
+  // Float constants: the record has group hashes, verified equal by the bridge check (vsc/psc).
+  if (c.bad & ((1u << kNbFVsConst) | (1u << kNbFPsConst))) diffs |= 1u << kM3aFConsts;
+
+  // L1: shader pair by record addresses + declaration.
+  const uint32_t vs_a = NativeBridgePhys(r.vertex_shader_guest), ps_a = NativeBridgePhys(r.pixel_shader_guest);
+  const M3aL1Id l1_id = M3aMakeL1Id(r, d.vs, d.ps_eff);
+  const uint64_t l1_key = M3aL1KeyOf(l1_id);
+  M3aL1 learned;
+  {
+    learned.id_vs = l1_id.id_vs;
+    learned.id_ps = l1_id.id_ps;
+    learned.vs_guest = vs_a;
+    learned.ps_guest = ps_a;
+    learned.decl = r.vertex_decl_guest;
+    learned.vs = d.vs;
+    // The effective PS (nullptr when IsPixelShaderNeededWithRasterization says no, e.g. the depth pre-pass,
+    // whose records carry PS 0 while the CP's active PS is whatever the previous draw left).
+    learned.ps = d.ps_eff;
+    auto add_shader = [&](const Shader* s, uint64_t& groups, uint32_t& float_count) {
+      if (!s || !s->is_ucode_analyzed()) return;
+      const Shader::ConstantRegisterMap& map = s->constant_register_map();
+      for (uint32_t g = 0; g < 64; ++g) {
+        if (map.float_dynamic_addressing || ((map.float_bitmap[g >> 4] >> ((g & 15) * 4)) & 0xF)) {
+          groups |= uint64_t(1) << g;
+        }
+      }
+      float_count = map.float_count;
+      learned.dynamic |= map.float_dynamic_addressing;
+      learned.loop_hi |= (map.loop_bitmap >> 8) != 0;
+      for (const auto& t : s->texture_bindings()) {
+        const uint32_t slot = t.fetch_constant & 31;
+        for (uint32_t u = slot * 3; u < slot * 3 + 3; ++u) learned.units[u >> 5] |= 1u << (u & 31);
+      }
+    };
+    add_shader(d.vs, learned.vs_groups, learned.vs_float_count);
+    add_shader(d.ps_eff, learned.ps_groups, learned.ps_float_count);
+    if (d.vs && d.vs->is_ucode_analyzed()) {
+      const auto& vf = d.vs->constant_register_map().vertex_fetch_bitmap;
+      for (uint32_t i = 0; i < 3; ++i) {
+        learned.units[i] |= vf[i];
+        learned.vunits[i] |= vf[i];
+      }
+    }
+  }
+  if (learned.loop_hi) reasons |= 1u << kM3aRLoopHi;
+  if (c.hdr_state) reasons |= 1u << kM3aRHeader;  // x8d
+  // Record v3 values: every float constant the translated shaders read (bitmap order, as UpdateBindings packs
+  // them from the register file) must be in the record and equal.
+  if (!c.has_values) {
+    reasons |= 1u << kM3aRNoValues;
+  } else {
+    ++w.val_records;
+    bool missing = false, bad_value = false;
+    auto check_values = [&](const Shader* s, uint32_t stage) {
+      if (!s || !s->is_ucode_analyzed()) return;
+      const Shader::ConstantRegisterMap& map = s->constant_register_map();
+      const uint32_t first = stage ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X;
+      for (uint32_t k = 0; k < 256; ++k) {
+        if (!((map.float_bitmap[k >> 6] >> (k & 63)) & 1)) continue;
+        ++w.val_consts;
+        const uint32_t* rv = NativeBridgeRecordGroup(c.vmask, c.values, stage, k >> 2);
+        if (!rv) {
+          missing = true;
+          ++w.val_missing;
+          continue;
+        }
+        const uint32_t* cw = &regs[first + k * 4];
+        rv += (k & 3) * 4;
+        if (std::memcmp(rv, cw, 16) != 0) {
+          bad_value = true;
+          ++w.val_bad;
+          if (w.n_val_examples < 4) {
+            ++w.n_val_examples;
+            w.val_examples += fmt::format(
+                " [{} path {} caller {:08X} c{} rec {:08X} {:08X} {:08X} {:08X} cp {:08X} {:08X} {:08X} {:08X}]",
+                kNbClassName[c.cls], r.path_id, r.caller, stage * 256 + k, rv[0], rv[1], rv[2], rv[3], cw[0], cw[1],
+                cw[2], cw[3]);
+          }
+        }
+      }
+    };
+    check_values(d.vs, 0);
+    check_values(d.ps_eff, 1);
+    if (missing) {
+      reasons |= 1u << kM3aRNoValues;
+      ++w.val_missing_records;
+    }
+    if (bad_value) {
+      reasons |= 1u << kM3aRValueBad;
+      ++w.val_bad_records;
+    }
+  }
+  auto l1_it = g_m3a.l1.find(l1_key);
+  if (l1_it == g_m3a.l1.end() || !M3aL1Matches(l1_it->second, l1_id)) {
+    if (l1_it != g_m3a.l1.end()) g_m3a.l1.erase(l1_it);
+    l1_it = g_m3a.l1.emplace(l1_key, learned).first;
+    ++w.l1_new;
+  } else {
+    const M3aL1& l = l1_it->second;
+    if (l.vs != d.vs || l.ps != d.ps_eff) {
+      diffs |= 1u << kM3aFL1Shader;
+      if (w.n_l1_examples[c.cls] < 2) {
+        ++w.n_l1_examples[c.cls];
+        auto sh = [](const Shader* s) {
+          return s ? fmt::format("{:016X}/{}", s->ucode_data_hash(),
+                                 s->is_ucode_analyzed() ? s->constant_register_map().float_count : 0u)
+                   : std::string("none");
+        };
+        w.l1_examples += fmt::format(" [{} path {} caller {:08X} vs {:08X} ps {:08X} decl {:08X} | vs {} -> {} | ps {} -> {}]",
+                                     kNbClassName[c.cls], r.path_id, r.caller, vs_a, ps_a, r.vertex_decl_guest,
+                                     sh(l.vs), sh(d.vs), sh(l.ps), sh(d.ps_eff));
+      }
+    }
+    if (l.vs_groups != learned.vs_groups || l.ps_groups != learned.ps_groups) ++w.l1_mask_changes;
+  }
+  {
+    // Masks only grow: union over every shader pair seen for this record key, published for the game.
+    // x8b: the game asks by RECORD addresses -> union per address key, independent of the L1 key form.
+    M3aL1& lm = l1_it->second;
+    auto pit = g_m3a.pub.try_emplace(M3aL1Key(vs_a, ps_a, r.vertex_decl_guest), std::pair<uint64_t, uint64_t>(0, 0));
+    const uint64_t uv = pit.first->second.first | learned.vs_groups, up = pit.first->second.second | learned.ps_groups;
+    if (uv != pit.first->second.first || up != pit.first->second.second || pit.second) {
+      pit.first->second = {uv, up};
+      NativeBridgePublishMasks(vs_a, ps_a, r.vertex_decl_guest, uv, up);
+    }
+    lm.published = true;
+    lm.pub_vs |= learned.vs_groups;
+    lm.pub_ps |= learned.ps_groups;
+    lm.units[0] |= learned.units[0];
+    lm.units[1] |= learned.units[1];
+    lm.units[2] |= learned.units[2];
+    lm.vunits[0] |= learned.vunits[0];
+    lm.vunits[1] |= learned.vunits[1];
+    lm.vunits[2] |= learned.vunits[2];
+  }
+  const M3aL1& l1 = l1_it->second;
+  if (c.cls == kNbMain) {
+    ++w.main_counted;
+    w.main_vs_groups += uint64_t(std::popcount(l1.vs_groups));
+    w.main_ps_groups += uint64_t(std::popcount(l1.ps_groups));
+  }
+  if (!d.ps_eff) ++w.ps_eff_null;
+
+  // L2: draw entry by record data only.
+  std::vector<uint32_t> key;
+  M3aBuildL2Key(r, l1, key);
+  if (d.tex_gen != g_m3a.tex_gen || g_m3a.l2.size() > 131072) {
+    if (!g_m3a.l2.empty()) ++w.l2_flushes;
+    g_m3a.l2.clear();
+    g_m3a.l2s.clear();
+    g_m3a.tex_gen = d.tex_gen;
+  }
+  const uint64_t h = M3aKeyHash(key);
+  g_nb_last.entry_valid = true;  // NATIVE7: refer-back markers compare with this
+  g_nb_last.entry_hash = h;
+  if (g_m3b.compare_entry) {
+    // M3b: the entry the marker's record found vs the one this (original) draw's record keys to.
+    g_m3b.compare_entry = false;
+    NativeMarkerWindow& mw = g_native_bridge.mw;
+    if (g_m3b.entry_found && g_m3b.entry_hash == h) {
+      ++mw.entry_same;
+    } else {
+      ++mw.entry_other;
+    }
+  }
+  // NATIVE7: static key hash (record key without the VS vertex-fetch units).
+  uint64_t hs = 0xCBF29CE484222325ull;
+  for (size_t i = 0, n = M3aL2PrefixWords(); i < n && i < key.size(); ++i) hs = M3aMix(hs, key[i]);
+  for (uint32_t u = 0; u < 96; ++u) {
+    if ((l1.units[u >> 5] & (1u << (u & 31))) && !(l1.vunits[u >> 5] & (1u << (u & 31)))) {
+      hs = M3aMix(hs, u);
+      hs = M3aMix(hs, r.fetch_hash[u]);
+    }
+  }
+  const bool static_seen = g_m3a.l2s.find(hs) != g_m3a.l2s.end();
+  if (!static_seen) g_m3a.l2s[hs] = 1;
+  const M3aEntry* hit_entry = nullptr;  // EXEC8 x8a
+  auto it = g_m3a.l2.find(h);
+  if (it == g_m3a.l2.end() || it->second->key != key) {
+    ++w.l2_misses;
+    if (!reasons) {
+      ++w.miss_only[c.cls];
+      if (static_seen) ++w.miss_vb_only[c.cls];
+    }
+    reasons |= 1u << kM3aRMiss;
+    auto e = std::make_unique<M3aEntry>();
+    e->key = std::move(key);
+    e->v = d;
+    g_m3a.l2[h] = std::move(e);
+  } else {
+    ++w.l2_hits;
+    M3aEntry& e = *it->second;
+    ++e.hits;
+    const M3aDrawInfo& v = e.v;
+    if (v.ps_eff != d.ps_eff) diffs |= 1u << kM3aFPsEff;
+    if (v.vs_tr != d.vs_tr || v.ps_tr != d.ps_tr) diffs |= 1u << kM3aFTrans;
+    if (v.pso != d.pso) diffs |= 1u << kM3aFPso;
+    if (v.rootsig != d.rootsig) diffs |= 1u << kM3aFRootSig;
+    if (v.rt_bits != d.rt_bits || std::memcmp(v.rt_formats, d.rt_formats, sizeof(d.rt_formats))) {
+      diffs |= 1u << kM3aFRt;
+    }
+    if (v.tex_mask != d.tex_mask) diffs |= 1u << kM3aFTexMask;
+    if (v.tex_ok != d.tex_ok || v.textures != d.textures) diffs |= 1u << kM3aFTextures;
+    if (v.desc_hash != d.desc_hash) diffs |= 1u << kM3aFDesc;
+    if (v.sys_hash != d.sys_hash && !M3aSysEqual(v.sys, d.sys, r.primitive_type)) diffs |= 1u << kM3aFSys;
+    if (v.bl_hash != d.bl_hash) diffs |= 1u << kM3aFBoolLoop;
+    if (v.vp_hash != d.vp_hash) diffs |= 1u << kM3aFViewport;
+    if (v.vb_hash != d.vb_hash) diffs |= 1u << kM3aFVb;
+    if (v.host_prim != d.host_prim || v.host_vs_type != d.host_vs_type) diffs |= 1u << kM3aFPrim;
+    if (v.ib_type != d.ib_type || v.ib_format != d.ib_format) diffs |= 1u << kM3aFIbType;
+    if (l1.vs_float_count != learned.vs_float_count || l1.ps_float_count != learned.ps_float_count) {
+      diffs |= 1u << kM3aFLayout;
+    }
+    // EXEC8 x8a: entry split stats - hits that reuse the static entry with other vertex buffers, and which system
+    // constant dwords differ between the entry's first draw and this one.
+    hit_entry = &e;
+    if (v.vb_hash != d.vb_hash) {
+      ++w.hits_vb_other;
+      if (!(diffs & ~((1u << kM3aFVb) | (1u << kM3aFIb) | (1u << kM3aFCount) | (1u << kM3aFConsts)))) {
+        ++w.hits_vb_other_clean;
+      }
+    }
+    if (v.sys != d.sys && M3aSysEqual(v.sys, d.sys, r.primitive_type)) ++w.sys_dontcare_hits;
+    if (diffs & (1u << kM3aFSys)) {
+      ++w.sys_diff_hits;
+      for (size_t i = 0; i < v.sys.size() && i < d.sys.size() && i < 256; ++i) {
+        if (v.sys[i] != d.sys[i]) ++w.sys_dword_diff[i];
+      }
+    }
+    // Per-draw values, not entry state: index base/count, constants, and (s3, VB not in the key) the vertex buffers.
+    const uint32_t entry_diffs =
+        diffs & ~((1u << kM3aFIb) | (1u << kM3aFCount) | (1u << kM3aFConsts) |
+                  (g_m3a_vb_in_key.load(std::memory_order_relaxed) ? 0u : (1u << kM3aFVb)));
+    if (entry_diffs && !(entry_diffs & ~((1u << kM3aFTextures) | (1u << kM3aFDesc) | (1u << kM3aFTexMask)))) {
+      ++w.hits_material_only;
+    }
+    if (entry_diffs) {
+      reasons |= 1u << kM3aRDiff;
+      if (full_state && w.n_examples < 6 && (c.cls == kNbMain || w.n_examples < 3)) {
+        ++w.n_examples;
+        std::string f;
+        for (uint32_t i = 0; i < kM3aFieldCount; ++i) {
+          if (entry_diffs & (1u << i)) f += fmt::format("{}{}", f.empty() ? "" : ",", kM3aFieldName[i]);
+        }
+        std::string sysd;
+        if (entry_diffs & (1u << kM3aFSys)) {
+          for (size_t i = 0; i < v.sys.size() && i < d.sys.size(); ++i) {
+            if (v.sys[i] != d.sys[i]) {
+              sysd += fmt::format(" sys[{}] {:08X}->{:08X}", i, v.sys[i], d.sys[i]);
+              if (sysd.size() > 120) break;
+            }
+          }
+        }
+        w.examples += fmt::format(" [{} path {} caller {:08X} vs {:08X} ps {:08X} decl {:08X} entry hits {} | {}{}]",
+                                  kNbClassName[c.cls], r.path_id, r.caller, vs_a, ps_a, r.vertex_decl_guest, e.hits,
+                                  f, sysd);
+      }
+    }
+  }
+  if (hit_entry && !reasons && g_m3b_dry_on.load(std::memory_order_relaxed)) M3bDryBuild(regs, *hit_entry, d);
+  M3aCount(reasons, diffs, full_state);
+}
+
+static void M3aMaybeLog() {
+  // x8d: M3a switched off -> drop the learned tables (and the per-address mask union) so they cannot grow while unused.
+  static bool s_was_on = false;
+  if (!g_m3a_on.load(std::memory_order_relaxed)) {
+    if (s_was_on) {
+      s_was_on = false;
+      g_m3a.l1.clear();
+      g_m3a.l2.clear();
+      g_m3a.l2s.clear();
+      g_m3a.pub.clear();
+      g_m3a.last_log_tick = 0;
+      g_m3a.w = M3aWindow{};
+    }
+    return;
+  }
+  s_was_on = true;
+  const uint64_t now = GetTickCount64();
+  if (now < g_m3a.last_log_tick + 10000) return;
+  {
+    FILE* f = RexFlagFopen("native_frame_exec_vbkey");
+    const bool vb = f != nullptr;
+    if (f) std::fclose(f);
+    if (vb != g_m3a_vb_in_key.load(std::memory_order_relaxed)) {
+      g_m3a_vb_in_key.store(vb, std::memory_order_relaxed);
+      g_m3a.l2.clear();  // keys change form
+      g_m3a.l2s.clear();
+      g_m3a.pub.clear();
+    }
+    REXLOG_INFO("NATIVE EXEC M3a L2 key: vertex buffers {}", vb ? "IN the key (native_frame_exec_vbkey)"
+                                                                 : "per-draw binding (not in the key, s3)");
+    {
+      FILE* fa = RexFlagFopen("native_frame_exec_addrkey");
+      const bool id_key = fa == nullptr;
+      if (fa) std::fclose(fa);
+      if (id_key != g_m3a_id_key.load(std::memory_order_relaxed)) {
+        g_m3a_id_key.store(id_key, std::memory_order_relaxed);
+        g_m3a.l1.clear();  // keys change form
+        g_m3a.l2.clear();
+        g_m3a.l2s.clear();
+        g_m3a.pub.clear();
+      }
+      if (g_m3a.pub.size() > 65536) g_m3a.pub.clear();  // x8d bound (masks are republished on the next draws)
+      REXLOG_INFO("NATIVE EXEC M3a L1 key: {}", id_key ? "shader identity (ucode hashes of the CP's VS / effective PS, x8b)"
+                                                       : "record shader addresses (native_frame_exec_addrkey)");
+    }
+    {
+      FILE* fr = RexFlagFopen("native_frame_exec_dryreplay.off");
+      g_m3b_replay_on.store(fr == nullptr, std::memory_order_relaxed);
+      if (fr) std::fclose(fr);
+    }
+    FILE* fd = RexFlagFopen("native_frame_exec_drybuild");
+    g_m3b_dry_on.store(fd != nullptr, std::memory_order_relaxed);
+    if (fd) std::fclose(fd);
+  }
+  const bool first = g_m3a.last_log_tick == 0;
+  g_m3a.last_log_tick = now;
+  M3aWindow& w = g_m3a.w;
+  if (!first) {
+    std::string classes;
+    for (uint32_t cl = 0; cl < kNbClassCount; ++cl) {
+      std::string rs, fs;
+      for (uint32_t i = 0; i < kM3aReasonCount; ++i) {
+        if (w.reasons[cl][i]) rs += fmt::format(" {} {}", kM3aReasonName[i], w.reasons[cl][i]);
+      }
+      for (uint32_t f = 0; f < kM3aFieldCount; ++f) {
+        if (w.field_diff[cl][f]) fs += fmt::format(" {} {}", kM3aFieldName[f], w.field_diff[cl][f]);
+      }
+      std::string rfs, ffs;
+      for (uint32_t i = 0; i < kM3aReasonCount; ++i) {
+        if (w.reasons_full[cl][i]) rfs += fmt::format(" {} {}", kM3aReasonName[i], w.reasons_full[cl][i]);
+      }
+      for (uint32_t f = 0; f < kM3aFieldCount; ++f) {
+        if (w.field_diff_full[cl][f]) ffs += fmt::format(" {} {}", kM3aFieldName[f], w.field_diff_full[cl][f]);
+      }
+      classes += fmt::format(" | {}: FULL-STATE {} would-execute-if-state {} reasons:{} diffs:{}", kNbClassName[cl],
+                             w.full_state[cl], w.would_if_state[cl], rfs.empty() ? " none" : rfs,
+                             ffs.empty() ? " none" : ffs);
+      classes += fmt::format(" | {}: draws {} matched {} exact {} would-execute {} (given const values {}) "
+                             "reasons:{} diffs:{}",
+                             kNbClassName[cl], w.cp_draws[cl], w.matched[cl], w.exact[cl], w.would[cl],
+                             w.would_given_consts[cl], rs.empty() ? " none" : rs, fs.empty() ? " none" : fs);
+    }
+    REXLOG_INFO("NATIVE EXEC M3a misses (NATIVE7): draws whose only reason is an L2 miss / of them the key without "
+                "vertex-fetch units was seen before (dynamic VB only): main {}/{} prepass {}/{} other {}/{} | static keys {}",
+                w.miss_only[kNbMain], w.miss_vb_only[kNbMain], w.miss_only[kNbPrepass], w.miss_vb_only[kNbPrepass],
+                w.miss_only[kNbOther], w.miss_vb_only[kNbOther], g_m3a.l2s.size());
+    REXLOG_INFO(
+        "NATIVE EXEC M3a (10 s): entries L1 {} (new {}, group-mask changes {}) L2 {} hits {} misses {} flushes {} | "
+        "main used const groups avg vs {:.1f} ps {:.1f} | no effective PS {} | ib types none/dma/conv/builtin "
+        "{}/{}/{}/{} | IB depth 0-5 matched {}/{}/{}/{}/{}/{} unmatched {}/{}/{}/{}/{}/{}{}",
+        g_m3a.l1.size(), w.l1_new, w.l1_mask_changes, g_m3a.l2.size(), w.l2_hits, w.l2_misses, w.l2_flushes,
+        w.main_counted ? double(w.main_vs_groups) / double(w.main_counted) : 0.0,
+        w.main_counted ? double(w.main_ps_groups) / double(w.main_counted) : 0.0, w.ps_eff_null, w.ib_types[0],
+        w.ib_types[1], w.ib_types[2], w.ib_types[3] + w.ib_types[4], w.depth_matched[0], w.depth_matched[1],
+        w.depth_matched[2], w.depth_matched[3], w.depth_matched[4], w.depth_matched[5], w.depth_unmatched[0],
+        w.depth_unmatched[1], w.depth_unmatched[2], w.depth_unmatched[3], w.depth_unmatched[4],
+        w.depth_unmatched[5], classes);
+    if (!w.examples.empty()) REXLOG_INFO("NATIVE EXEC M3a entry differences (full state):{}", w.examples);
+    {
+      // EXEC8 x8a: entry split + dry executor.
+      std::string sysd;
+      uint32_t counts[256];
+      std::memcpy(counts, w.sys_dword_diff, sizeof(counts));
+      for (int n = 0; n < 8; ++n) {
+        int best = -1;
+        for (int i = 0; i < 256; ++i) {
+          if (counts[i] && (best < 0 || counts[i] > counts[best])) best = i;
+        }
+        if (best < 0) break;
+        sysd += fmt::format(" [{}]:{}", best, counts[best]);
+        counts[best] = 0;
+      }
+      REXLOG_INFO("NATIVE EXEC M3a entry split (EXEC8): L2 hits {} with other vertex buffers {} (no other entry diff {}) "
+                  "| hits with other system constants {} (+ only don't-care point dwords {}), dwords:{} | hits whose only entry "
+                  "diffs are textures/descriptors {}",
+                  w.l2_hits, w.hits_vb_other, w.hits_vb_other_clean, w.sys_diff_hits, w.sys_dontcare_hits,
+                  sysd.empty() ? " none" : sysd, w.hits_material_only);
+      if (g_m3b_dry_on.load(std::memory_order_relaxed)) {
+        LARGE_INTEGER fq, qn;
+        QueryPerformanceFrequency(&fq);
+        QueryPerformanceCounter(&qn);
+        const uint64_t tn = __rdtsc();
+        const double win_us = fq.QuadPart && w.qpc0 ? double(uint64_t(qn.QuadPart) - w.qpc0) * 1e6 / double(fq.QuadPart)
+                                                    : 0.0;
+        const double tsc_per_us = win_us > 0.0 ? double(tn - w.tsc0) / win_us : 0.0;
+        uint64_t cand = 0;
+        for (uint32_t cl = 0; cl < kNbClassCount; ++cl) cand += w.dry_cand[cl];
+        const double us = cand && tsc_per_us > 0.0 ? 1.0 / tsc_per_us / double(cand) : 0.0;
+        const double rus = w.rp_n && tsc_per_us > 0.0 ? 1.0 / tsc_per_us / double(w.rp_n) : 0.0;
+        static const char* const kRpName[7] = {"rt_update", "textures", "viewport+sys", "uploads+bindings",
+                                               "vb_residency", "ib+topology", "barriers"};
+        std::string rp;
+        double rp_total = 0.0;
+        for (uint32_t i = 0; i < 7; ++i) {
+          rp += fmt::format(" {} {:.3f}", kRpName[i], double(w.rp_ticks[i]) * rus);
+          rp_total += double(w.rp_ticks[i]) * rus;
+        }
+        REXLOG_INFO("NATIVE EXEC M3b dry REPLAY (EXEC9: warmed post-draw replay of the real helpers, Draw suppressed, "
+                    "<= 64/frame): draws {} failed {} | us/draw total {:.3f} |{}{}{}",
+                    w.rp_n, w.rp_fail, rp_total, rp,
+                    g_m3b_replay_on.load(std::memory_order_relaxed) ? "" : " (native_frame_exec_dryreplay.off)",
+                    g_m3b_replay.latched ? " LATCHED OFF after a helper failure" : "");
+        std::string fs;
+        for (uint32_t i = 0; i < kM3bFailCount; ++i) {
+          if (w.dry_fail[i]) fs += fmt::format(" {} {}", kM3bFailName[i], w.dry_fail[i]);
+        }
+        REXLOG_INFO("NATIVE EXEC M3b dry executor (EXEC8 x8d): candidates main {} prepass {} other {} | READY main {} "
+                    "prepass {} other {} | fails:{} | us/draw lookup {:.3f} (xxh3; old fnv key hash {:.3f}) build {:.3f} max {:.1f} us "
+                    "| avg bytes {:.0f} vbs {:.2f} key words {:.1f}{}{}",
+                    w.dry_cand[kNbMain], w.dry_cand[kNbPrepass], w.dry_cand[kNbOther], w.dry_ready[kNbMain],
+                    w.dry_ready[kNbPrepass], w.dry_ready[kNbOther], fs.empty() ? " none" : fs,
+                    double(w.dry_ticks_lookup) * us, double(w.dry_ticks_xxh) * us, double(w.dry_ticks_build) * us,
+                    tsc_per_us > 0.0 ? double(w.dry_ticks_max) / tsc_per_us : 0.0,
+                    cand ? double(w.dry_bytes) / double(cand) : 0.0, cand ? double(w.dry_vbs) / double(cand) : 0.0,
+                    cand ? double(w.dry_key_words) / double(cand) : 0.0,
+                    w.dry_examples.empty() ? "" : " | examples:", w.dry_examples);
+      }
+    }
+    REXLOG_INFO("NATIVE EXEC M3a record values: records with values {} used constants checked {} missing {} bad {} "
+                "| records missing {} bad {}{}",
+                w.val_records, w.val_consts, w.val_missing, w.val_bad, w.val_missing_records, w.val_bad_records,
+                w.val_examples);
+    if (!w.l1_examples.empty()) REXLOG_INFO("NATIVE EXEC M3a L1 shader differences:{}", w.l1_examples);
+    {
+      static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+      std::string top;
+      uint64_t counts[REX_NATIVE_STATE_REG_COUNT];
+      std::memcpy(counts, w.unknown_reg, sizeof(counts));
+      for (int n = 0; n < 16; ++n) {
+        int best = -1;
+        for (int i = 0; i < int(REX_NATIVE_STATE_REG_COUNT); ++i) {
+          if (counts[i] && (best < 0 || counts[i] > counts[best])) best = i;
+        }
+        if (best < 0) break;
+        top += fmt::format(" {:04X}:{}", kRegs[best], counts[best]);
+        counts[best] = 0;
+      }
+      REXLOG_INFO("NATIVE EXEC M3a render-state key: records without stream state {}, partial {}; unknown registers:{}",
+                  w.no_stream_flag, w.state_partial, top.empty() ? " none" : top);
+    }
+  }
+  w = M3aWindow{};
+  {
+    LARGE_INTEGER q0;
+    QueryPerformanceCounter(&q0);
+    w.qpc0 = uint64_t(q0.QuadPart);
+    w.tsc0 = __rdtsc();
+  }
+}
