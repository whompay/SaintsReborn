+}
+// The captured frame, once ready: sink(rgba8, width, height, user) is called with it (then it's
+// dropped) and 1 is returned; 0 = nothing yet.
+extern "C" __declspec(dllexport) int RexCaptureTake(void (*sink)(const uint8_t*, int, int, void*), void* user) {
+  using namespace rex::graphics::d3d12;
+  std::lock_guard<std::mutex> lock(g_capture_mutex);
+  if (!g_capture_ready || !sink) return 0;
+  g_capture_ready = false;
+  sink(g_capture_pixels.data(), int(g_capture_w), int(g_capture_h), user);
+  std::vector<uint8_t>().swap(g_capture_pixels);
+  return 1;
+}
