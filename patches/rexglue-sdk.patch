+struct Texture {
+  ComPtr<ID3D12Resource> resource;
+  D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  uint32_t width = 0, height = 0, depth = 1;
+};
+
+struct State {
+  bool init_tried = false, init_ok = false;
+  bool in_place_ok = false;  // in-place final compiled + typed UAV loads of RGBA8 supported
+  // Ping-pong history ([parity] = written this apply, [parity ^ 1] = the
+  // previous apply's). streak = consecutive applies with the same feature set
+  // and textures: >= 1 -> [prev] holds valid outputs, >= 2 -> also the blur of
+  // the bloom pass from two applies ago (lag mode).
+  uint32_t parity = 0, streak = 0, history_key = ~0u;
+  bool logged_path = false;
+  bool logged_lag = false;
+  ComPtr<ID3D12RootSignature> root_signature;
+  ComPtr<ID3D12PipelineState> pipelines[kPassCount];
+  // ao: blurred AO (ao_raw only for ao_split); bright: 1/8 res bright pass
+  // written by final; blur: its blurred version; sum: 1/8 res sky sums
+  // written by final; sky: the smoothed sky average (4 x 1).
+  Texture ao_raw, ao[2], bright[2], blur[2], sum[2], sky[2], out, lut;
+  std::string lut_text;   // options text the LUT was baked for
+  bool lut_valid = false;
+  uint64_t last_submission = 0;
+  std::vector<std::pair<uint64_t, ComPtr<ID3D12Resource>>> retired;
+  // GPU timestamps of the stages (only with dist\gpu_timing): per apply 4
+  // marks (start | after stage 1 | after the AO blur | after final) in one
+  // of kTqSlots ring slots, read back once the submission has completed.
+  static constexpr uint32_t kTqSlots = 8, kTqMarks = 4;
+  bool tq_on = false;
+  ComPtr<ID3D12QueryHeap> tq_heap;
+  ComPtr<ID3D12Resource> tq_readback;
+  const uint64_t* tq_mapping = nullptr;
+  uint64_t tq_frequency = 0;
+  uint64_t tq_submission[kTqSlots] = {};
+  bool tq_busy[kTqSlots] = {};
+  uint32_t tq_next = 0;
+  double tq_sum[3] = {};
+  uint32_t tq_count = 0, tq_lines = 0;
+  std::chrono::steady_clock::time_point tq_last_log = std::chrono::steady_clock::now();
+};
+State* g_state = nullptr;  // freed by Shutdown (render target cache shutdown)
+
+bool Initialize(D3D12CommandProcessor& cp, State& s) {
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile = compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile"))
+                          : nullptr;
+  if (!compile) {
+    REXLOG_ERROR("Scene post: D3DCompile not available");
+    return false;
+  }
+  D3D12_DESCRIPTOR_RANGE ranges[kSrvCount + kUavCount] = {};
+  D3D12_ROOT_PARAMETER parameters[1 + kSrvCount + kUavCount] = {};
+  parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  parameters[0].Constants.Num32BitValues = sizeof(Constants) / 4;
+  parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  for (uint32_t i = 0; i < kSrvCount + kUavCount; ++i) {
+    ranges[i].RangeType = i < kSrvCount ? D3D12_DESCRIPTOR_RANGE_TYPE_SRV : D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    ranges[i].NumDescriptors = 1;
+    ranges[i].BaseShaderRegister = i < kSrvCount ? i : i - kSrvCount;
+    parameters[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameters[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+    parameters[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    parameters[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_STATIC_SAMPLER_DESC sampler = {};
+  sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+  sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.MaxLOD = D3D12_FLOAT32_MAX;
+  sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 1 + kSrvCount + kUavCount;
+  desc.pParameters = parameters;
+  desc.NumStaticSamplers = 1;
+  desc.pStaticSamplers = &sampler;
+  s.root_signature.Attach(ui::d3d12::util::CreateRootSignature(cp.GetD3D12Provider(), desc));
+  if (!s.root_signature) {
+    REXLOG_ERROR("Scene post: could not create the root signature");
+    return false;
+  }
+  ID3D12Device* device = cp.GetD3D12Provider().GetDevice();
+  // Typed UAV loads of R8G8B8A8_UNORM (the in-place final pass reads the
+  // colour render target through its UAV).
+  bool typed_load = false;
+  {
+    D3D12_FEATURE_DATA_D3D12_OPTIONS options = {};
+    if (SUCCEEDED(device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS, &options,
+                                              sizeof(options))) &&
+        options.TypedUAVLoadAdditionalFormats) {
+      D3D12_FEATURE_DATA_FORMAT_SUPPORT fs = {DXGI_FORMAT_R8G8B8A8_UNORM};
+      typed_load = SUCCEEDED(device->CheckFeatureSupport(D3D12_FEATURE_FORMAT_SUPPORT, &fs,
+                                                         sizeof(fs))) &&
+                   (fs.Support2 & D3D12_FORMAT_SUPPORT2_UAV_TYPED_LOAD) &&
+                   (fs.Support2 & D3D12_FORMAT_SUPPORT2_UAV_TYPED_STORE);
+    }
+  }
+  const D3D_SHADER_MACRO in_place_defines[] = {{"SP_INPLACE", "1"}, {nullptr, nullptr}};
+  const D3D_SHADER_MACRO debug_defines[] = {{"SP_DEBUG", "1"}, {nullptr, nullptr}};
+  const D3D_SHADER_MACRO in_place_debug_defines[] = {
+      {"SP_INPLACE", "1"}, {"SP_DEBUG", "1"}, {nullptr, nullptr}};
+  const D3D_SHADER_MACRO old_defines[] = {{"SP_OLD", "1"}, {nullptr, nullptr}};
+  for (uint32_t i = 0; i < kPassCount; ++i) {
+    const bool in_place_variant =
+        i == kPassFinalInPlace || i == kPassFinalInPlaceDebug || i == kPassFinal2InPlace;
+    // The v15 A/B variants are optional too (missing -> the new ones).
+    const bool optional = in_place_variant || i == kPassAoOld || i == kPassBright;
+    if (in_place_variant && !typed_load) continue;
+    const D3D_SHADER_MACRO* defines = i == kPassFinalInPlace        ? in_place_defines
+                                      : i == kPassFinalDebug        ? debug_defines
+                                      : i == kPassFinalInPlaceDebug ? in_place_debug_defines
+                                      : i == kPassFinal2InPlace     ? in_place_defines
+                                      : i == kPassAoOld             ? old_defines
+                                                                    : nullptr;
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(kShaders, sizeof(kShaders) - 1, "scene_post",
+                         defines, nullptr, kEntryPoints[i], "cs_5_1",
+                         1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXLOG_ERROR("Scene post: {}{}: {}", kEntryPoints[i], optional ? " (in place)" : "",
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()),
+                               errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) {
+      if (code) code->Release();
+      REXLOG_ERROR("Scene post: failed to compile {}{} (0x{:08X})", kEntryPoints[i],
+                   optional ? " (in place)" : "", uint32_t(hr));
+      if (optional) continue;
+      return false;
+    }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pso = {};
+    pso.pRootSignature = s.root_signature.Get();
+    pso.CS.pShaderBytecode = code->GetBufferPointer();
+    pso.CS.BytecodeLength = code->GetBufferSize();
+    hr = device->CreateComputePipelineState(&pso, IID_PPV_ARGS(&s.pipelines[i]));
+    code->Release();
+    if (FAILED(hr)) {
+      REXLOG_ERROR("Scene post: failed to create the {} pipeline (0x{:08X})", kEntryPoints[i],
+                   uint32_t(hr));
+      s.pipelines[i].Reset();
+      if (optional) continue;
+      return false;
+    }
+  }
+  s.in_place_ok = s.pipelines[kPassFinalInPlace].Get() != nullptr &&
+                  s.pipelines[kPassFinalInPlaceDebug].Get() != nullptr &&
+                  s.pipelines[kPassFinal2InPlace].Get() != nullptr;
+  {
+    // Stage timing (dist\gpu_timing, like the command processor's timer).
+    std::string unused;
+    ID3D12CommandQueue* queue = cp.GetD3D12Provider().GetDirectQueue();
+    if (ReadFile("gpu_timing", unused) && queue && SUCCEEDED(queue->GetTimestampFrequency(&s.tq_frequency)) &&
+        s.tq_frequency) {
+      D3D12_QUERY_HEAP_DESC qd = {};
+      qd.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+      qd.Count = State::kTqSlots * State::kTqMarks;
+      D3D12_RESOURCE_DESC bd;
+      ui::d3d12::util::FillBufferResourceDesc(bd, sizeof(uint64_t) * qd.Count, D3D12_RESOURCE_FLAG_NONE);
+      void* mapping = nullptr;
+      D3D12_RANGE read_range = {0, sizeof(uint64_t) * qd.Count};
+      if (SUCCEEDED(device->CreateQueryHeap(&qd, IID_PPV_ARGS(&s.tq_heap))) &&
+          SUCCEEDED(device->CreateCommittedResource(
+              &ui::d3d12::util::kHeapPropertiesReadback, cp.GetD3D12Provider().GetHeapFlagCreateNotZeroed(), &bd,
+              D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&s.tq_readback))) &&
+          SUCCEEDED(s.tq_readback->Map(0, &read_range, &mapping))) {
+        s.tq_mapping = static_cast<const uint64_t*>(mapping);
+        s.tq_on = true;
+      } else {
+        s.tq_heap.Reset();
+        s.tq_readback.Reset();
+      }
+    }
+  }
+  REXLOG_INFO("Scene post: initialized (in-place final pass {}, typed UAV loads {})",
+              s.in_place_ok ? "available" : "NOT available", typed_load);
+  return true;
+}
+
+bool EnsureTexture(D3D12CommandProcessor& cp, State& s, Texture& t, uint32_t width, uint32_t height,
+                   DXGI_FORMAT format, bool* created = nullptr, uint32_t depth = 1) {
+  if (t.resource && t.width == width && t.height == height && t.depth == depth) return true;
+  if (t.resource) {
+    s.retired.emplace_back(s.last_submission, std::move(t.resource));
+    t.resource.Reset();
+  }
+  D3D12_RESOURCE_DESC d = {};
+  d.Dimension = depth > 1 ? D3D12_RESOURCE_DIMENSION_TEXTURE3D : D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  d.Width = width;
+  d.Height = height;
+  d.DepthOrArraySize = UINT16(depth);
+  d.MipLevels = 1;
+  d.Format = format;
+  d.SampleDesc.Count = 1;
+  d.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+  d.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  if (FAILED(provider.GetDevice()->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesDefault, provider.GetHeapFlagCreateNotZeroed(), &d,
+          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, nullptr, IID_PPV_ARGS(&t.resource)))) {
+    t.resource.Reset();
+    return false;
+  }
+  t.state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  t.width = width;
+  t.height = height;
+  t.depth = depth;
+  if (created) *created = true;
+  return true;
+}
+
+void Transition(D3D12CommandProcessor& cp, Texture& t, D3D12_RESOURCE_STATES state) {
+  if (t.state == state) return;
+  cp.PushTransitionBarrier(t.resource.Get(), t.state, state);
+  t.state = state;
+}
+
+// Stage timing: collect the slots whose submission has completed, log the
+// averages every 10 s.
+void TqHarvest(D3D12CommandProcessor& cp, State& s) {
+  const uint64_t completed = cp.GetCompletedSubmission();
+  for (uint32_t i = 0; i < State::kTqSlots; ++i) {
+    if (!s.tq_busy[i] || s.tq_submission[i] > completed) continue;
+    s.tq_busy[i] = false;
+    const uint64_t* m = s.tq_mapping + i * State::kTqMarks;
+    if (!(m[0] <= m[1] && m[1] <= m[2] && m[2] <= m[3]) || m[3] - m[0] > s.tq_frequency) continue;
+    for (int k = 0; k < 3; ++k) s.tq_sum[k] += double(m[k + 1] - m[k]) / double(s.tq_frequency);
+    ++s.tq_count;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (now - s.tq_last_log < std::chrono::seconds(10)) return;
+  s.tq_last_log = now;
+  if (s.tq_count && s.tq_lines < 400) {
+    ++s.tq_lines;
+    const double f = 1000.0 / double(s.tq_count);
+    REXLOG_INFO("Scene post GPU ({} applies timed): stage 1 (AO, sky, bloom blur, LUT) {:.3f} ms | AO blur "
+                "{:.3f} | final + output {:.3f} | total {:.3f}",
+                s.tq_count, s.tq_sum[0] * f, s.tq_sum[1] * f, s.tq_sum[2] * f,
+                (s.tq_sum[0] + s.tq_sum[1] + s.tq_sum[2]) * f);
+  }
+  s.tq_sum[0] = s.tq_sum[1] = s.tq_sum[2] = 0.0;
+  s.tq_count = 0;
+}
