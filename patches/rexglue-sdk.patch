+    return;
+  }
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!g_dd.result) {
+    D3D12_HEAP_PROPERTIES heap = {};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    desc.Width = uint64_t(kDirectDepthSlots) * 32;
+    desc.Height = 1;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_dd.result)))) {
+      ++g_dd.fail_alloc;
+      return;
+    }
+    g_dd.result_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    heap.Type = D3D12_HEAP_TYPE_READBACK;
+    desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST,
+                                               nullptr, IID_PPV_ARGS(&g_dd.readback)))) {
+      g_dd.result.Reset();
+      ++g_dd.fail_alloc;
+      return;
+    }
+    // Zero source for the per-compare result slot (codex19 #3: default heap contents are undefined).
+    heap.Type = D3D12_HEAP_TYPE_UPLOAD;
+    desc.Width = 256;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_GENERIC_READ,
+                                               nullptr, IID_PPV_ARGS(&g_dd.zero_upload)))) {
+      g_dd.result.Reset();
+      g_dd.readback.Reset();
+      ++g_dd.fail_alloc;
+      return;
+    }
+    void* zero_mapping = nullptr;
+    D3D12_RANGE zero_read = {0, 0};
+    if (FAILED(g_dd.zero_upload->Map(0, &zero_read, &zero_mapping))) {
+      g_dd.result.Reset();
+      g_dd.readback.Reset();
+      g_dd.zero_upload.Reset();
+      ++g_dd.fail_alloc;
+      return;
+    }
+    std::memset(zero_mapping, 0, 256);
+    g_dd.zero_upload->Unmap(0, nullptr);
+    g_dd.result_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  }
+  const uint32_t slot = g_dd.next_slot;
+  if (g_dd.slot_pending[slot]) DirectDepthHarvest(cp);
+  if (g_dd.slot_pending[slot]) {
+    ++g_dd.fail_ring;
+    return;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!cp.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    ++g_dd.fail_desc;
+    return;
+  }
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv = {};
+  srv.Format = DXGI_FORMAT_R32_FLOAT;
+  srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv.Texture2D.MipLevels = 1;
+  device->CreateShaderResourceView(entry.texture.Get(), &srv, descriptors[0].first);
+  device->CreateShaderResourceView(loaded, &srv, descriptors[1].first);
+  if (entry.state != D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE) {
+    cp.PushTransitionBarrier(entry.texture.Get(), entry.state, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    entry.state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  }
+  DeferredCommandList& list = cp.GetDeferredCommandList();
+  if (g_dd.result_state != D3D12_RESOURCE_STATE_COPY_DEST) {
+    cp.PushTransitionBarrier(g_dd.result.Get(), g_dd.result_state, D3D12_RESOURCE_STATE_COPY_DEST);
+    g_dd.result_state = D3D12_RESOURCE_STATE_COPY_DEST;
+  }
+  cp.SubmitBarriers();
+  list.D3DCopyBufferRegion(g_dd.result.Get(), uint64_t(slot) * 32, g_dd.zero_upload.Get(), 0, 32);
+  cp.PushTransitionBarrier(g_dd.result.Get(), D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  g_dd.result_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  const uint32_t constants[5] = {0, 0, entry.host_width, entry.host_height, 0};
+  cp.SetExternalPipeline(g_dd.compare.Get());
+  list.D3DSetComputeRootSignature(g_dd.root.Get());
+  list.D3DSetComputeRoot32BitConstants(0, 5, constants, 0);
+  list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+  list.D3DSetComputeRootDescriptorTable(2, descriptors[1].second);
+  list.D3DSetComputeRootUnorderedAccessView(4, g_dd.result->GetGPUVirtualAddress() + uint64_t(slot) * 32);
+  cp.SubmitBarriers();
+  list.D3DDispatch((entry.host_width + 7) / 8, (entry.host_height + 7) / 8, 1);
+  cp.PushTransitionBarrier(g_dd.result.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                           D3D12_RESOURCE_STATE_COPY_SOURCE);
+  g_dd.result_state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  cp.SubmitBarriers();
+  g_dd.next_slot = (slot + 1) % kDirectDepthSlots;
+  list.D3DCopyBufferRegion(g_dd.readback.Get(), uint64_t(slot) * 32, g_dd.result.Get(), uint64_t(slot) * 32, 20);
+  g_dd.slot_submission[slot] = cp.GetCurrentSubmission();
+  g_dd.slot_used[slot] = true;
+  g_dd.slot_pending[slot] = true;
+  g_dd.slot_base[slot] = entry.base;
+  g_dd.slot_w[slot] = entry.width;
+  g_dd.slot_h[slot] = entry.height;
+  g_dd.slot_frame[slot] = entry.last_frame;
+  ++g_dd.compares;
+  g_dd.texels += uint64_t(entry.host_width) * entry.host_height;
+}
+
+// Dedicated bit-exact direct colour resolve for the observed 0E93C000 prepass texture.
+// The normal resolve sources used to generate the SDK bytecode are resolve.xesli (MSAA accumulation and bias order)
+// and pixel_formats.xesli XePackR8G8B8A8UNorm (saturate * 255 + 0.5, then float-to-uint truncation).
+static const char kDirectMsaaCS[] = R"(
+Texture2DMS<float4, 4> source_msaa : register(t0);
+Texture2D<uint4> direct_texture : register(t1);
+Texture2D<uint4> loaded_texture : register(t2);
+RWTexture2D<uint4> dest : register(u0);
+RWByteAddressBuffer result : register(u1);
+cbuffer constants : register(b0) {
+  uint2 origin;
+  uint2 size;
+  uint2 fill_first;
+};
+uint PackRGBA8(uint4 value) {
+  return value.x | (value.y << 8) | (value.z << 16) | (value.w << 24);
+}
+[numthreads(8, 8, 1)]
+void pack_main(uint3 id : SV_DispatchThreadID) {
+  if (id.x >= size.x || id.y >= size.y) return;
+  uint2 source_coord = origin + max(id.xy, fill_first);
+  // Match XeResolveLoad*RGBAColors: accumulate selected samples, halve the
+  // exponent factor at each averaging level, multiply once, then swap R/B.
+  precise float4 color = source_msaa.Load(source_coord, 0);
+  precise float exp_bias = 1.0f;
+  exp_bias *= 0.5f;
+  color += source_msaa.Load(source_coord, 1);
+  exp_bias *= 0.5f;
+  color += source_msaa.Load(source_coord, 2);
+  color += source_msaa.Load(source_coord, 3);
+  color *= exp_bias;
+  color = color.bgra;
+  // XePackR8G8B8A8UNorm: round half up via +0.5 followed by truncation.
+  dest[id.xy] = uint4(saturate(color) * 255.0f + 0.5f);
+}
+[numthreads(8, 8, 1)]
+void compare_main(uint3 id : SV_DispatchThreadID) {
+  if (id.x >= size.x || id.y >= size.y) return;
+  uint4 expected = loaded_texture.Load(int3(id.xy, 0));
+  uint4 actual = direct_texture.Load(int3(id.xy, 0));
+  if (any(expected != actual)) {
+    uint previous;
+    result.InterlockedAdd(0, 1u, previous);
+    uint4 difference = uint4(abs(int4(expected) - int4(actual)));
+    uint maximum = max(max(difference.x, difference.y), max(difference.z, difference.w));
+    result.InterlockedMax(4, maximum);
+    if (previous == 0u) {
+      result.Store3(8, uint3(id.x | (id.y << 16), PackRGBA8(expected), PackRGBA8(actual)));
+    }
+    if (id.x < fill_first.x || id.y < fill_first.y) {
+      result.InterlockedAdd(20, 1u, previous);
+    }
+  }
+}
+)";
+
+namespace {
+void DirectMsaaPoll() {
+  const uint64_t now = GetTickCount64();
+  if (now - g_dm.poll_tick < 500) return;
+  g_dm.poll_tick = now;
+  const bool verify = RexFlagExistsW(L"direct_resolve_msaa_verify");
+  // Default ON since n18e (verify 13162 compares BAD 0, -0.15 ms GPU); dist direct_resolve_msaa.off = old path.
+  const bool on = !verify && !RexFlagExistsW(L"direct_resolve_msaa.off");
+  if (on != g_dm.on || verify != g_dm.verify) {
+    REXLOG_INFO("Direct MSAA resolve: {}", verify ? "VERIFY (compare only)" : on ? "ON" : "off");
+  }
+  g_dm.on = on;
+  g_dm.verify = verify;
+  if (!verify) g_dm.entry.pending = false;
+}
+
+bool DirectMsaaEnsure(ID3D12Device* device, const ui::d3d12::D3D12Provider& provider) {
+  if (g_dm.ready) return true;
+  if (g_dm.init_tried) return false;
+  g_dm.init_tried = true;
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2, ID3DBlob** code,
+      ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  struct CompilerModule {
+    HMODULE module;
+    ~CompilerModule() {
+      if (module) FreeLibrary(module);
+    }
+  } compiler_module{compiler};
+  auto compile = compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile")) : nullptr;
+  if (!compile) {
+    REXLOG_ERROR("Direct MSAA resolve: D3DCompile not available");
+    return false;
+  }
+  D3D12_DESCRIPTOR_RANGE ranges[4] = {};
+  ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[0].NumDescriptors = 1;
+  ranges[0].BaseShaderRegister = 0;
+  ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[1].NumDescriptors = 1;
+  ranges[1].BaseShaderRegister = 1;
+  ranges[2].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[2].NumDescriptors = 1;
+  ranges[2].BaseShaderRegister = 2;
+  ranges[3].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  ranges[3].NumDescriptors = 1;
+  ranges[3].BaseShaderRegister = 0;
+  D3D12_ROOT_PARAMETER parameters[6] = {};
+  parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  parameters[0].Constants.Num32BitValues = 6;
+  parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  for (int i = 0; i < 4; ++i) {
+    parameters[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameters[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+    parameters[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    parameters[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  parameters[5].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV;
+  parameters[5].Descriptor.ShaderRegister = 1;
+  parameters[5].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 6;
+  desc.pParameters = parameters;
+  g_dm.root.Attach(ui::d3d12::util::CreateRootSignature(provider, desc));
+  if (!g_dm.root) {
+    REXLOG_ERROR("Direct MSAA resolve: failed to create the root signature");
+    return false;
+  }
+  const char* entries[2] = {"pack_main", "compare_main"};
+  for (int i = 0; i < 2; ++i) {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(kDirectMsaaCS, sizeof(kDirectMsaaCS) - 1, "direct_msaa", nullptr, nullptr, entries[i],
+                         "cs_5_1", 1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXLOG_ERROR("Direct MSAA resolve: shader compiler output: {}",
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) {
+      REXLOG_ERROR("Direct MSAA resolve: failed to compile {} (0x{:08X})", entries[i], uint32_t(hr));
+      return false;
+    }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pso = {};
+    pso.pRootSignature = g_dm.root.Get();
+    pso.CS.pShaderBytecode = code->GetBufferPointer();
+    pso.CS.BytecodeLength = code->GetBufferSize();
+    if (i) {
+      hr = device->CreateComputePipelineState(&pso, IID_PPV_ARGS(&g_dm.compare));
+    } else {
+      hr = device->CreateComputePipelineState(&pso, IID_PPV_ARGS(&g_dm.pack));
+    }
+    code->Release();
+    if (FAILED(hr)) {
+      REXLOG_ERROR("Direct MSAA resolve: failed to create the {} pipeline (0x{:08X})", entries[i], uint32_t(hr));
+      return false;
+    }
+  }
+  g_dm.ready = true;
+  REXLOG_INFO("Direct MSAA resolve: shaders ready");
+  return true;
+}
+
+void DirectMsaaHarvest(D3D12CommandProcessor& cp) {
+  if (!g_dm.readback) return;
+  const uint64_t completed = cp.GetCompletedSubmission();
+  bool any = false;
+  for (uint32_t i = 0; i < kDirectMsaaSlots; ++i) {
+    if (g_dm.slot_pending[i] && g_dm.slot_submission[i] <= completed) any = true;
+  }
+  if (!any) return;
+  D3D12_RANGE range = {0, size_t(kDirectMsaaSlots) * 32};
+  void* mapping = nullptr;
+  if (FAILED(g_dm.readback->Map(0, &range, &mapping))) return;
+  for (uint32_t i = 0; i < kDirectMsaaSlots; ++i) {
+    if (!g_dm.slot_pending[i] || g_dm.slot_submission[i] > completed) continue;
+    g_dm.slot_pending[i] = false;
+    uint32_t r[6];
+    std::memcpy(r, static_cast<const uint8_t*>(mapping) + size_t(i) * 32, sizeof(r));
+    ++g_dm.checked;
+    if (r[0]) {
+      ++g_dm.bad;
+      g_dm.bad_texels += r[0];
+      g_dm.max_diff = std::max<uint64_t>(g_dm.max_diff, r[1]);
+      g_dm.border_bad += r[5];
+      if (!g_dm.have_first_bad) {
+        g_dm.have_first_bad = true;
+        g_dm.first_x = r[2] & 0xFFFFu;
+        g_dm.first_y = r[2] >> 16;
+        g_dm.first_expected = r[3];
+        g_dm.first_actual = r[4];
+      }
+    }
+  }
+  D3D12_RANGE written = {0, 0};
+  g_dm.readback->Unmap(0, &written);
+}
+
+void DirectMsaaMaybeLog(D3D12CommandProcessor& cp) {
+  DirectMsaaHarvest(cp);
+  const uint64_t now = GetTickCount64();
+  if (!g_dm.log_tick) g_dm.log_tick = now;
+  if (now - g_dm.log_tick < 10000) return;
+  g_dm.log_tick = now;
+  if (g_dm.verify) {
+    const uint32_t e = g_dm.first_expected, a = g_dm.first_actual;
+    REXLOG_INFO(
+        "DIRECT MSAA RESOLVE (VERIFY, 10 s): compares checked {} BAD {} mismatching texels {} max |byte diff| {} "
+        "first bad {},{} exp {},{},{},{} act {},{},{},{} | border mismatches {}",
+        g_dm.checked, g_dm.bad, g_dm.bad_texels, g_dm.max_diff,
+        g_dm.have_first_bad ? g_dm.first_x : 0u, g_dm.have_first_bad ? g_dm.first_y : 0u,
+        e & 0xFFu, (e >> 8) & 0xFFu, (e >> 16) & 0xFFu, e >> 24,
+        a & 0xFFu, (a >> 8) & 0xFFu, (a >> 16) & 0xFFu, a >> 24, g_dm.border_bad);
+  }
+  g_dm.checked = g_dm.bad = g_dm.bad_texels = g_dm.max_diff = g_dm.border_bad = 0;
+  g_dm.have_first_bad = false;
+}
+}  // namespace
