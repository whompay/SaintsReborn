+bool D3D12TextureCache::ExecGatherActiveTextures(uint32_t used_texture_mask,
+                                                 std::vector<void*>& textures) const {
+  textures.clear();
+  uint32_t remaining = used_texture_mask;
+  uint32_t index;
+  while (rex::bit_scan_forward(remaining, &index)) {
+    remaining &= ~(uint32_t(1) << index);
+    const TextureBinding* binding = GetValidTextureBinding(index);
+    if (!binding) {
+      continue;
+    }
+    if (binding->key.dimension == xenos::DataDimension::k3D) {
+      return false;
+    }
+    if (binding->texture) {
+      textures.push_back(static_cast<void*>(binding->texture));
+    }
+    if (binding->texture_signed) {
+      textures.push_back(static_cast<void*>(binding->texture_signed));
+    }
+  }
+  return true;
