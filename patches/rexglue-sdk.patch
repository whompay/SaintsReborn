+void D3D12CommandProcessor::NoteBarrier(uint64_t key) {
+  if (!D3D12PerfDiag()) return;  // hash map update per barrier otherwise
+  ++barrier_stat_count_[key];
+  if (barriers_.size() == 1) {
+    barrier_stat_first_key_ = key;
+  }
+}
+
+void D3D12CommandProcessor::MaybeLogBarrierStats() {
+  const uint64_t now = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                    std::chrono::steady_clock::now().time_since_epoch())
+                                    .count());
+  if (!barrier_stat_last_log_) {
+    barrier_stat_last_log_ = now;
+    return;
+  }
+  if (now - barrier_stat_last_log_ < 10000) {
+    return;
+  }
+  const double seconds = double(now - barrier_stat_last_log_) / 1000.0;
+  barrier_stat_last_log_ = now;
+  auto describe = [](uint64_t key) {
+    static const char* kKinds[] = {"transition", "uav", "aliasing", "?"};
+    static const char* kClasses[] = {"null", "shared-memory", "buffer", "texture"};
+    auto states = [](uint32_t s) {
+      if (s == 0) return std::string("COMMON/PRESENT");
+      static const std::pair<uint32_t, const char*> kNames[] = {
+          {0x1, "VB/CB"}, {0x2, "INDEX"}, {0x4, "RT"}, {0x8, "UAV"}, {0x10, "DEPTH_W"},
+          {0x20, "DEPTH_R"}, {0x40, "NONPS_SRV"}, {0x80, "PS_SRV"}, {0x100, "SO"},
+          {0x200, "INDIRECT"}, {0x400, "COPY_DST"}, {0x800, "COPY_SRC"}, {0x1000, "RESOLVE_DST"},
+          {0x2000, "RESOLVE_SRC"}};
+      std::string r;
+      for (const auto& n : kNames) {
+        if (s & n.first) {
+          if (!r.empty()) r += "+";
+          r += n.second;
+        }
+      }
+      return r.empty() ? std::to_string(s) : r;
+    };
+    uint32_t kind = uint32_t(key >> 60) & 3;
+    std::string text = std::string(kKinds[kind]) + " " + kClasses[(key >> 56) & 3];
+    if (kind == 0) {
+      text += " " + states(uint32_t(key >> 28) & 0xFFFFFFF) + ">" +
+              states(uint32_t(key) & 0xFFFFFFF);
+    }
+    return text;
+  };
+  auto top = [&](std::unordered_map<uint64_t, uint64_t>& map) {
+    std::vector<std::pair<uint64_t, uint64_t>> v(map.begin(), map.end());
+    std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second > b.second; });
+    std::string out;
+    for (size_t i = 0; i < v.size() && i < 12; ++i) {
+      char num[32];
+      std::snprintf(num, sizeof(num), "%.0f", double(v[i].second) / seconds);
+      out += " [" + describe(v[i].first) + " " + num + "/s]";
+    }
+    map.clear();
+    return out;
+  };
+  const double frames = stat_frames_ ? double(stat_frames_) : 1.0;
+  REXLOG_INFO(
+      "DRAWSTATS per frame: draws {:.0f}, memexport draws {:.1f}, copies/resolves {:.1f}, "
+      "pipeline binds {:.0f}, submissions {:.1f} ({:.1f} fps) | GPU thread: waited for the GPU "
+      "{:.2f} ms/frame ({:.1f} waits), ending submissions (D3D12 recording + submit) {:.2f} "
+      "ms/frame",
+      stat_draws_ / frames, stat_memexport_draws_ / frames, stat_copies_ / frames,
+      stat_pipeline_binds_ / frames, stat_submissions_ / frames, frames / seconds,
+      stat_fence_wait_us_ / 1000.0 / frames, stat_fence_waits_ / frames,
+      stat_end_submission_us_ / 1000.0 / frames);
+  REXLOG_INFO("REPLAY thread {}: {:.2f} ms/frame translating + submitting, command thread waited "
+              "{:.2f} ms/frame for it at swaps",
+              replay_thread_enabled_ ? "on" : "off",
+              stat_replay_us_.exchange(0) / 1000.0 / frames, stat_replay_drain_us_ / 1000.0 / frames);
+  stat_replay_drain_us_ = 0;
+  stat_fence_wait_us_ = stat_fence_waits_ = stat_end_submission_us_ = 0;
+  {
+    std::vector<std::pair<uint64_t, std::array<uint64_t, 2>>> v(census_.begin(), census_.end());
+    std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second[0] > b.second[0]; });
+    std::string out;
+    for (size_t i = 0; i < v.size() && i < 14; ++i) {
+      char part[128];
+      if (v[i].first == UINT64_MAX) {
+        std::snprintf(part, sizeof(part), " [to screen: %.0f draws]", v[i].second[0] / frames);
+      } else {
+        std::snprintf(part, sizeof(part), " [%08X+%X: %.0f draws, %.1f resolves]",
+                      uint32_t(v[i].first >> 32), uint32_t(v[i].first), v[i].second[0] / frames,
+                      v[i].second[1] / frames);
+      }
+      out += part;
+    }
+    census_.clear();
+    REXLOG_INFO("PASSES per frame (by resolve target, most draws first):{}", out);
+  }
+  LogShaderCensus(frames);
+  LogCpTime(frames);
+  if (stat_prepass_skipped_) {
+    REXLOG_INFO("PREPASS skipped: {:.0f} draws/frame", stat_prepass_skipped_ / frames);
+    stat_prepass_skipped_ = 0;
+  }
+  if (native_enabled_ || stat_native_draws_ || stat_native_fallbacks_) {
+    std::vector<std::pair<uint32_t, uint64_t>> passes(native_pass_stats_.begin(),
+                                                      native_pass_stats_.end());
+    std::sort(passes.begin(), passes.end(),
+              [](auto& a, auto& b) { return a.second > b.second; });
+    std::string pass_text;
+    for (size_t i = 0; i < passes.size() && i < 12; ++i) {
+      const uint32_t k = passes[i].first;
+      if (k & 0x80000000u) {
+        pass_text += fmt::format(" [emulated colour VS B910: pitch {} msaa {} zfunc {} zwrite {} "
+                                 "stencil {}: {:.0f}]",
+                                 k & 0x3FFF, (k >> 14) & 3, (k >> 16) & 7, (k >> 19) & 1,
+                                 (k >> 20) & 1, passes[i].second / frames);
+        continue;
+      }
+      pass_text += fmt::format(
+          " [pitch {} msaa {} zfunc {} zwrite {} stencil {} polyoffset {} {} cull {}{}: {:.0f}]",
+          k & 0x3FFF, (k >> 14) & 3, (k >> 16) & 7, (k >> 19) & 1, (k >> 20) & 1, (k >> 21) & 1,
+          ((k >> 22) & 1) ? "D24FS8" : "D24S8", ((k >> 23) & 1) ? "F" : "",
+          ((k >> 24) & 1) ? "B" : "", passes[i].second / frames);
+    }
+    native_pass_stats_.clear();
+    REXLOG_INFO(
+        "NATIVE per frame: mode {} ({}), native draws {:.0f}, fallbacks to emulation {:.0f}; "
+        "CPU per draw: native {:.2f} us, emulated {:.2f} us;{}",
+        native_mode_, native_init_ok_ ? "ready" : "not initialized", stat_native_draws_ / frames,
+        stat_native_fallbacks_ / frames,
+        stat_native_draws_ ? double(stat_native_ticks_) * 1e6 / double(stat_qpc_freq_) /
+                                 double(stat_native_draws_)
+                           : 0.0,
+        stat_emulated_timed_draws_ ? double(stat_emulated_ticks_) * 1e6 /
+                                         double(stat_qpc_freq_) /
+                                         double(stat_emulated_timed_draws_)
+                                   : 0.0,
+        pass_text);
+    {
+      NativeFastState& nf = g_native_fast;
+      REXLOG_INFO("NATIVE FAST per frame: {:.0f} fast draws ({:.2f} us each) | full native draws {:.0f} | "
+                  "fast path missed: registers {:.0f}, shader {:.0f}, submission {:.0f}, other {:.0f}{}",
+                  nf.fast_draws / frames,
+                  nf.fast_draws ? double(nf.fast_ticks) * 1e6 / double(stat_qpc_freq_) / double(nf.fast_draws) : 0.0,
+                  (stat_native_draws_ - nf.fast_draws) / frames, nf.misses_key / frames,
+                  nf.misses_shader / frames, nf.misses_submission / frames, nf.misses_other / frames,
+                  NativeFastOff() ? " (native_fast_off)" : "");
+      {
+        NexecState& x = g_nexec;
+        if (x.on || x.lookups || x.exec_draws) {
+          const double all_draws = double(stat_draws_) / frames;
+          REXLOG_INFO(
+              "NEXEC per frame (AGENT_NATIVE29A executor step 1{}): executed natively from the cache {:.1f} ({:.2f} us "
+              "each) | not a learned VS {:.1f} | lookups {:.1f}: hit {:.1f}, no entry {:.1f}, stale {:.1f} | learned {:.1f}, evicted {:.1f} | RT "
+              "full updates on hits {:.1f} | verify armed {:.1f} | NATIVE SHARE: {:.0f} of {:.0f} draws = {:.1f} % "
+              "(translation skipped for {:.0f} = {:.1f} %)",
+              x.verify ? ", VERIFY" : "", x.exec_draws / frames,
+              x.exec_draws ? double(x.exec_ticks) * 1e6 / double(stat_qpc_freq_) / double(x.exec_draws) : 0.0,
+              x.filtered / frames, x.lookups / frames, x.hits / frames, x.miss_none / frames, x.miss_stale / frames, x.stores / frames,
+              x.evictions / frames, x.rt_full / frames, x.verify_armed / frames, stat_native_draws_ / frames,
+              all_draws, all_draws > 0 ? 100.0 * (stat_native_draws_ / frames) / all_draws : 0.0,
+              nf.fast_draws / frames, all_draws > 0 ? 100.0 * (nf.fast_draws / frames) / all_draws : 0.0);
+        }
+        x.filtered = 0;
+        x.lookups = x.hits = x.miss_none = x.miss_stale = x.stores = x.evictions = x.rt_full = 0;
+        x.exec_draws = x.exec_ticks = x.verify_armed = 0;
+      }
+      if (nf.verify_checked) {
+        REXLOG_INFO("NATIVE FAST VERIFY: {} draws compared | mismatches: c4..c7 {}, ndc {}, p0 {}, p1 {}, p2 {}, "
+                    "PIPELINE {}, index count {}, index buffer {}{}",
+                    nf.verify_checked, nf.verify_bad[0], nf.verify_bad[1], nf.verify_bad[2], nf.verify_bad[3],
+                    nf.verify_bad[4], nf.verify_bad[5], nf.verify_bad[6], nf.verify_bad[7], nf.verify_example);
+        nf.verify_checked = 0;
+        for (auto& b : nf.verify_bad) b = 0;
+        nf.verify_example.clear();
+      }
+      if (nf.fast_draws)
+        REXLOG_INFO("NATIVE FAST re-applied state: pipeline {}, root signature {}, topology {}, viewport/scissor {}, "
+                    "stencil ref {} (of {} fast draws)",
+                    nf.heal[0], nf.heal[1], nf.heal[2], nf.heal[3], nf.heal[4], nf.fast_draws);
+      for (auto& h : nf.heal) h = 0;
+      {
+        PrepassFuseState& pf = g_pfuse;
