+  name->sin_family = 2;
+  name->sin_port = ntohs(a.sin_port);
+  name->sin_addr = a.sin_addr.s_addr ? ntohl(a.sin_addr.s_addr) : LanAddress();
+  std::memset(name->x_sin_zero, 0, sizeof(name->x_sin_zero));
+  if (namelen) *namelen = sizeof(XSOCKADDR_IN);
+  return 0;
