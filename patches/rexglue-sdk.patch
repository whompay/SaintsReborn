diff --git a/src/graphics/d3d12/flag_files.h b/src/graphics/d3d12/flag_files.h
new file mode 100644
index 0000000..da9404b
--- /dev/null
+++ b/src/graphics/d3d12/flag_files.h
@@ -0,0 +1,119 @@
+// AGENT_NATIVE27A (session 27): cached existence checks for the dist switch files.
+// The renderer polls dozens of optional switch files ("cp_pipe_key", "native_clear", ...) every
+// 0.5-1 s, mostly on the GPU command thread, with std::fopen(name, "rb") / GetFileAttributesW; almost
+// none exist, and each failed check is a full file-system call (filter drivers, Desktop folder):
+// perf_profile at dtc showed ~2 % of the CP thread in _sopen_s / ZwCreateFile.
+// RexFlagFopen(name) == std::fopen(name, "rb") and RexFlagExistsW(name) == (GetFileAttributesW(name)
+// != INVALID_FILE_ATTRIBUTES), except that a name already found MISSING is answered from a cache with
+// no system call until a file name in the current directory changes (FindFirstChangeNotification,
+// re-armed before the cache is dropped; an insert is refused if the cache was dropped or the handle is
+// signalled meanwhile) -> exact: a switch file created / renamed at any time is seen at the next poll.
+// Names with a path separator always go to the file system.
+// OPT-IN (session 28, codexNV21): the cache is active only while dist file "flag_cache" exists at the first
+// check (raw GetFileAttributesW, read once); absent = every check goes to the file system as before.
+#pragma once
+// Needs the Win32 declarations (<windows.h>): include after the D3D12 / platform headers.
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cwchar>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+
+namespace rex_flagfile {
+struct State {
+  std::mutex mutex;
+  std::unordered_set<std::string> missing;
+  std::unordered_set<std::wstring> missing_w;
+  void* change = nullptr;  // HANDLE; nullptr = no cache
+  bool init = false;
+  uint64_t gen = 0;  // bumped whenever the cache is dropped
+  std::atomic<uint64_t> calls{0}, cached{0}, real{0}, real_ticks{0};
+};
+inline State& Get() {
+  static State s;
+  return s;
+}
+// Under s.mutex: init once, drop the cache when the directory changed. Returns the generation.
+inline uint64_t Refresh(State& s) {
+  if (!s.init) {
+    s.init = true;
+    if (GetFileAttributesW(L"flag_cache") != INVALID_FILE_ATTRIBUTES) {
+      HANDLE h = FindFirstChangeNotificationW(L".", FALSE, FILE_NOTIFY_CHANGE_FILE_NAME);
+      if (h != INVALID_HANDLE_VALUE) s.change = h;
+    }
+  }
+  if (s.change && WaitForSingleObject(HANDLE(s.change), 0) == WAIT_OBJECT_0) {
+    // Re-arm first, then drop the cache: a change after the re-arm signals again.
+    if (!FindNextChangeNotification(HANDLE(s.change))) {
+      FindCloseChangeNotification(HANDLE(s.change));
+      s.change = nullptr;
+    }
+    s.missing.clear();
+    s.missing_w.clear();
+    ++s.gen;
+  }
+  return s.gen;
+}
+// Under s.mutex: may a miss seen at generation gen be cached now?
+inline bool MayInsert(State& s, uint64_t gen) {
+  return s.change && s.gen == gen && WaitForSingleObject(HANDLE(s.change), 0) != WAIT_OBJECT_0;
+}
+template <typename Clock>
+inline void CountReal(State& s, Clock a) {
+  LARGE_INTEGER b;
+  QueryPerformanceCounter(&b);
+  s.real.fetch_add(1, std::memory_order_relaxed);
+  s.real_ticks.fetch_add(uint64_t(b.QuadPart - a.QuadPart), std::memory_order_relaxed);
+}
+}  // namespace rex_flagfile
+
+inline FILE* RexFlagFopen(const char* name) {
+  rex_flagfile::State& s = rex_flagfile::Get();
+  s.calls.fetch_add(1, std::memory_order_relaxed);
+  const bool plain = name && !std::strpbrk(name, "/\\:");
+  uint64_t gen = 0;
+  if (plain) {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    gen = rex_flagfile::Refresh(s);
+    if (s.change && s.missing.count(name)) {
+      s.cached.fetch_add(1, std::memory_order_relaxed);
+      return nullptr;
+    }
+  }
+  LARGE_INTEGER a;
+  QueryPerformanceCounter(&a);
+  FILE* f = std::fopen(name, "rb");
+  rex_flagfile::CountReal(s, a);
+  if (!f && plain) {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    if (rex_flagfile::MayInsert(s, gen)) s.missing.insert(name);
+  }
+  return f;
+}
+
+inline bool RexFlagExistsW(const wchar_t* name) {
+  rex_flagfile::State& s = rex_flagfile::Get();
+  s.calls.fetch_add(1, std::memory_order_relaxed);
+  const bool plain = name && !std::wcspbrk(name, L"/\\:");
+  uint64_t gen = 0;
+  if (plain) {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    gen = rex_flagfile::Refresh(s);
+    if (s.change && s.missing_w.count(name)) {
+      s.cached.fetch_add(1, std::memory_order_relaxed);
+      return false;
+    }
+  }
+  LARGE_INTEGER a;
+  QueryPerformanceCounter(&a);
+  const bool exists = GetFileAttributesW(name) != INVALID_FILE_ATTRIBUTES;
+  rex_flagfile::CountReal(s, a);
+  if (!exists && plain) {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    if (rex_flagfile::MayInsert(s, gen)) s.missing_w.insert(name);
+  }
+  return exists;
+}
