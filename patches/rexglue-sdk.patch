+// NATIVE7 dry mode (bridge mutex held): take this draw's record like the verify path, count, publish masks.
+static void NativeBridgePublishMasksForDraw(const RexNativeDrawRecordV2& r, const Shader* vertex_shader,
+                                            const Shader* pixel_shader);  // MAIN31 fwd
+static void NativeBridgeDryTake(uint32_t packet_end, NativeBridgeClass cls, NativeBridgeWindow& w,
+                                const Shader* vertex_shader, const Shader* pixel_shader) {
+  ++w.cp_draws[cls];
+  if (!packet_end) {
+    ++w.no_key[cls];
+    return;
+  }
+  const uint32_t key = NativeBridgePhys(packet_end);
+  auto it = g_native_bridge.pending.find(key);
+  if (it == g_native_bridge.pending.end() || it->second.empty()) {
+    ++w.no_record[cls];
+    return;
+  }
+  std::vector<NativeBridgeRecord>& list = it->second;
+  size_t best = 0;
+  if (list.size() > 1) {
+    ++w.addr_reuse;
+    for (size_t i = 1; i < list.size(); ++i) {
+      const RexNativeDrawRecordV2& a = list[i].r;
+      const RexNativeDrawRecordV2& b = list[best].r;
+      if (a.frame_id < b.frame_id || (a.frame_id == b.frame_id && a.sequence < b.sequence)) best = i;
+    }
+  }
+  {
+    const NativeBridgeRecord& rec = list[best];
+    const RexNativeDrawRecordV2& r = rec.r;
+    ++w.matched[cls];
+    ++w.matched_path[r.path_id < REX_NATIVE_PATH_COUNT ? r.path_id : 0];
+    ++w.dry_taken;
+    if (r.flags & kNbFlagConstValues) ++w.dry_with_values;
+    const uint64_t known = uint64_t(r.reserved2[0]) | (uint64_t(r.reserved2[1]) << 32);
+    if ((r.flags & REX_NATIVE_DRAW_FLAG_STATE) && (r.flags & REX_NATIVE_DRAW_FLAG_STREAM_STATE) && known == ~0ull) {
+      ++w.dry_full_state;
+    }
+    if (rec.draw_header && rec.draw_header != rex::graphics::g_native_bridge_packet_header) {
+      ++w.dry_hdr_bad;
+    } else if (rec.v4 && g_own_dry.load(std::memory_order_relaxed)) {
+      // MAIN31: production-like learning (dist native_exec_own_dry): no field compare here - V4 VERIFY has been exact on
+      // tens of millions of records; the key still needs kOwnProve draws with the same translated shader objects.
+      NativeOwnLearn(rec, vertex_shader, pixel_shader);
+    }
+    // MAIN31: same publisher as verify mode (adds the used FETCH UNITS; the old dry copy published const groups only ->
+    // capture v4 never self-sufficient in dry mode, n31d not-ss 100 %).
+    NativeBridgePublishMasksForDraw(r, vertex_shader, pixel_shader);
+  }
+  g_native_bridge.pending_value_bytes -= list[best].values.size() * 4;
+  if (best + 1 != list.size()) list[best] = std::move(list.back());
+  list.pop_back();
+  --g_native_bridge.pending_count;
+  if (list.empty()) g_native_bridge.pending.erase(key);
+}
+
+// AGENT_NATIVE29A (session 29, 29B ask 1): publish the used float-constant group masks of the matched record's key in
+// VERIFY mode too (before: only native_frame_exec_dry did), so the game can send v3/v4 const values. Same logic as the dry
+// block above (union per (VS, PS, decl) key; republished only when the masks grow).
+static void NativeBridgePublishMasksForDraw(const RexNativeDrawRecordV2& r, const Shader* vertex_shader,
+                                            const Shader* pixel_shader) {
+  if (!r.vertex_shader_guest) return;
+  const uint32_t vs_a = NativeBridgePhys(r.vertex_shader_guest), ps_a = NativeBridgePhys(r.pixel_shader_guest);
+  const uint64_t mk = ((uint64_t(vs_a) << 32) | ps_a) ^ (uint64_t(r.vertex_decl_guest) * 0x9E3779B97F4A7C15ull);
+  NbDryMask& m = g_nb_dry_masks[mk];
+  if (m.vs == vertex_shader && m.ps == pixel_shader) return;
+  const bool ready = (!vertex_shader || vertex_shader->is_ucode_analyzed()) &&
+                     (!pixel_shader || pixel_shader->is_ucode_analyzed());
+  uint64_t vsm = m.vsm, psm = m.psm;
+  auto groups = [](const Shader* s, uint64_t& g) {
+    if (!s || !s->is_ucode_analyzed()) return;
+    const Shader::ConstantRegisterMap& map = s->constant_register_map();
+    for (uint32_t i = 0; i < 64; ++i) {
+      if (map.float_dynamic_addressing || ((map.float_bitmap[i >> 4] >> ((i & 15) * 4)) & 0xF)) {
+        g |= uint64_t(1) << i;
+      }
+    }
+  };
+  groups(vertex_shader, vsm);
+  groups(pixel_shader, psm);
+  // AGENT_NATIVE30A (29B ask b): used fetch units of the translated pair = VS vertex fetches + 3 units per texture fetch
+  // constant (same rule as the v4 coverage check in NativeBridgeCheckV4).
+  uint32_t fu[3] = {m.fu[0], m.fu[1], m.fu[2]};
+  auto add_textures = [&fu](const Shader* shader) {
+    if (!shader || !shader->is_ucode_analyzed()) return;
+    for (const auto& t : shader->texture_bindings()) {
+      const uint32_t sidx = t.fetch_constant & 31;
+      for (uint32_t u = sidx * 3; u < sidx * 3 + 3; ++u) fu[u >> 5] |= 1u << (u & 31);
+    }
+  };
+  add_textures(vertex_shader);
+  add_textures(pixel_shader);
+  if (vertex_shader && vertex_shader->is_ucode_analyzed()) {
+    const auto& vf = vertex_shader->constant_register_map().vertex_fetch_bitmap;
+    for (uint32_t i = 0; i < 3; ++i) fu[i] |= vf[i];
+  }
+  const bool fu_changed = fu[0] != m.fu[0] || fu[1] != m.fu[1] || fu[2] != m.fu[2];
+  if (ready) {
+    m.vs = vertex_shader;
+    m.ps = pixel_shader;
+  }
+  if (vsm != m.vsm || psm != m.psm || fu_changed || !m.published) {
+    m.vsm = vsm;
+    m.psm = psm;
+    std::memcpy(m.fu, fu, sizeof(fu));
+    m.published = true;
+    NativeBridgePublishMasks(vs_a, ps_a, r.vertex_decl_guest, vsm, psm, fu);
+  }
+}
+
+// Record v4 per-field verify (AGENT_NATIVE29A session 29): state_values vs the register file, fetch values vs the fetch
+// registers, coverage of what the translated pair reads (const groups, fetch units), DRAW packet header. Returns true when
+// every v4 field is equal (coverage gaps do not make it unequal; they make SELF_SUFFICIENT records 'incomplete').
+static bool NativeBridgeCheckV4(const NativeBridgeRecord& rec, NativeBridgeClass cls, const RegisterFile& regs,
+                                const Shader* vertex_shader, const Shader* pixel_shader, NativeBridgeWindow& w,
+                                uint32_t v3_bad) {
+  static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+  bool ok = true;
+  std::string why;
+  if (rec.state_values.size() == REX_NATIVE_STATE_REG_COUNT) {
+    ++w.v4_state_checked;
+    uint32_t nbad = 0;
+    for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+      if (rec.state_values[i] != regs[kRegs[i]]) {
+        ++nbad;
+        ++w.v4_reg_bad[i];
+        if (nbad <= 2) why += fmt::format(" reg {:04X} rec {:08X} cp {:08X}", kRegs[i], rec.state_values[i], regs[kRegs[i]]);
+      }
+    }
+    if (nbad) {
+      ++w.v4_state_bad_draws;
+      w.v4_state_bad_regs += nbad;
+      ok = false;
+    }
+  }
+  // Fetch values.
+  uint32_t k = 0;
+  for (uint32_t u = 0; u < 96; ++u) {
+    if (!(rec.fetch_units[u >> 5] & (1u << (u & 31)))) continue;
+    ++w.v4_fetch_units;
+    if (k + 2 <= rec.fetch_values.size() &&
+        (rec.fetch_values[k] != regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + u * 2] ||
+         rec.fetch_values[k + 1] != regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + u * 2 + 1])) {
+      ++w.v4_fetch_units_bad;
+      if (ok || why.size() < 200) why += fmt::format(" fetch unit {}", u);
+      ok = false;
+    }
+    k += 2;
+  }
+  // Coverage: what the translated pair reads must be in the record.
+  bool incomplete = false;
+  {
+    uint32_t units[3] = {};
+    auto add_textures = [&](const Shader* shader) {
+      if (!shader || !shader->is_ucode_analyzed()) return;
+      for (const auto& t : shader->texture_bindings()) {
+        const uint32_t s = t.fetch_constant & 31;
+        for (uint32_t u = s * 3; u < s * 3 + 3; ++u) units[u >> 5] |= 1u << (u & 31);
+      }
+    };
+    add_textures(vertex_shader);
+    add_textures(pixel_shader);
+    if (vertex_shader && vertex_shader->is_ucode_analyzed()) {
+      const auto& vf = vertex_shader->constant_register_map().vertex_fetch_bitmap;
+      for (uint32_t i = 0; i < 3; ++i) units[i] |= vf[i];
+    }
+    for (uint32_t i = 0; i < 3; ++i) {
+      if (units[i] & ~rec.fetch_units[i]) {
+        ++w.v4_fetch_missing;
+        incomplete = true;
+        break;
+      }
+    }
+    auto groups_of = [](const Shader* shader) -> uint64_t {
+      if (!shader || !shader->is_ucode_analyzed()) return 0;
+      const Shader::ConstantRegisterMap& map = shader->constant_register_map();
+      if (map.float_dynamic_addressing) return ~0ull;
+      uint64_t m = 0;
+      for (uint32_t g = 0; g < 64; ++g) {
+        if (((map.float_bitmap[g >> 4] >> ((g & 15) * 4)) & 0xF) != 0) m |= uint64_t(1) << g;
+      }
+      return m;
+    };
+    if ((groups_of(vertex_shader) & ~rec.vmask[0]) || (groups_of(pixel_shader) & ~rec.vmask[1])) {
+      ++w.v4_const_missing;
+      incomplete = true;
+    }
+  }
+  if (rec.draw_packet_words && rec.draw_packet[0] != rex::graphics::g_native_bridge_packet_header) {
+    ++w.v4_draw_packet_bad;
+    why += fmt::format(" draw hdr rec {:08X} cp {:08X}", rec.draw_packet[0], rex::graphics::g_native_bridge_packet_header);
+    ok = false;
+  }
+  const bool exact = ok && !v3_bad;
+  ++w.v4_checked[cls];
+  if (exact) ++w.v4_exact[cls];
+  if (rec.r.flags & REX_NATIVE_DRAW_FLAG_SELF_SUFFICIENT) {
+    ++w.v4_self_checked[cls];
+    if (incomplete) ++w.v4_self_incomplete;
+    if (exact && !incomplete) ++w.v4_self_exact[cls];
+  }
+  if (!exact && w.v4_n_examples < 6) {
+    ++w.v4_n_examples;
+    w.v4_examples += fmt::format(" [{} path {} caller {:08X} v3bad {:X}{}]", kNbClassName[cls], rec.r.path_id,
+                                 rec.r.caller, v3_bad, why);
+  }
+  return exact;
+}
+
+static void NativeBridgeVerifyDraw(xenos::PrimitiveType primitive_type, uint32_t index_count,
+                                   bool has_index_buffer, uint32_t index_buffer_guest_base,
+                                   uint32_t index_size, const RegisterFile& regs,
+                                   const Shader* vertex_shader, const Shader* pixel_shader) {
+  if (!NativeBridgeEnabled()) return;
+  const uint32_t packet_end = rex::graphics::g_native_bridge_packet_end;
+  const NativeBridgeClass cls = NativeBridgeClassify(regs);
+  NativeBridgeM3aCur& m3a = g_m3a_cur;
+  m3a.active = g_m3a_on.load(std::memory_order_relaxed);
+  m3a.matched = m3a.done = false;
+  m3a.stage = 0;
+  m3a.cls = cls;
+  m3a.bad = 0;
+  m3a.hdr_state = 0;
+  m3a.outcome = 0;
+  m3a.ib_depth = rex::graphics::g_native_bridge_ib_depth;
+  std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+  NativeBridgeWindow& w = g_native_bridge.w;
+  if (g_nb_dry.load(std::memory_order_relaxed)) {
+    NativeBridgeDryTake(packet_end, cls, w, vertex_shader, pixel_shader);
+    return;
+  }
+  g_nb_trace_regs = &regs;
+  g_nb_last.valid = true;
+  g_nb_last.packet_end = packet_end;
+  g_nb_last.header = rex::graphics::g_native_bridge_packet_header;
+  g_nb_last.prim = primitive_type;
+  g_nb_last.index_count = index_count;
+  g_nb_last.has_ib = has_index_buffer;
+  g_nb_last.ib_base = index_buffer_guest_base;
+  g_nb_last.index_size = index_size;
+  g_nb_last.vs = vertex_shader;
+  g_nb_last.ps = pixel_shader;
+  g_nb_last.entry_valid = false;
+  if (!g_nb_next.empty()) NativeBridgeEvalNext(regs, w);
+  // Snapshot of this draw's registers for the next draw's examples (only while examples are wanted).
+  struct SnapAtExit {
+    const RegisterFile& regs;
+    NativeBridgeWindow& w;
+    ~SnapAtExit() {
+      if (NativeBridgeExamplesWanted(w)) {
+        NativeBridgeSnapPrev(regs);
+      } else {
+        g_nb_prev.valid = false;
+      }
+    }
+  } snap_at_exit{regs, w};
+  ++w.cp_draws[cls];
+  g_m3b.compare_entry = false;
+  if (g_m3b.active) {
+    // M3b: the marker's record against the original draw that follows the marker.
+    g_m3b.active = false;
+    g_m3b.compare_entry = true;
+    NativeMarkerWindow& mw = g_native_bridge.mw;
+    ++mw.draws_after;
+    static NativeBridgeWindow scratch;  // NativeBridgeCheck's own counters are not wanted here
+    const uint32_t mbad = NativeBridgeCheck(g_m3b.rec.r, primitive_type, index_count, has_index_buffer,
+                                            index_buffer_guest_base, index_size, regs, vertex_shader,
+                                            pixel_shader, scratch);
+    if (!mbad) ++mw.exact;
+    for (uint32_t f = 0; f < kNbFieldCount; ++f) {
+      if (mbad & (1u << f)) ++mw.field_bad[f];
+    }
+    if ((g_m3b.header & 1) != (rex::graphics::g_native_bridge_packet_header & 1)) ++mw.pred_bad;
+    if (mbad && mw.n_examples < 4) {
+      ++mw.n_examples;
+      std::string f;
+      for (uint32_t i = 0; i < kNbFieldCount; ++i) {
+        if (mbad & (1u << i)) f += fmt::format("{}{}", f.empty() ? "" : ",", kNbFieldName[i]);
+      }
+      mw.examples += fmt::format(" [id {} path {} caller {:08X} {} | draw end {:08X} hdr {:08X}]", g_m3b.id,
+                                 g_m3b.rec.r.path_id, g_m3b.rec.r.caller, f, packet_end,
+                                 rex::graphics::g_native_bridge_packet_header);
+    }
+  }
+  if (!packet_end) {
+    ++w.no_key[cls];
+    return;
+  }
+  // Same GPU address is expected; the +-0x1000 retries are diagnostics for a different 0xE0000000-range
+  // convention (counted, so the log shows which form the addresses take).
+  // (AGENT_FRAME 2026-10-24: only the exact address; the +-0x1000 retries of the first version matched
+  // unrelated records - every "+1000" hit in bench br5v was a count mismatch.)
+  std::vector<NativeBridgeRecord>* list = nullptr;
+  uint32_t key = 0;
+  for (int i = 0; i < 1 && !list; ++i) {
+    key = NativeBridgePhys(packet_end);
+    auto it = g_native_bridge.pending.find(key);
+    if (it != g_native_bridge.pending.end() && !it->second.empty()) {
+      list = &it->second;
+      ++w.addr_offset_hits[i];
+    }
+  }
+  if (!list) {
+    m3a.outcome = 1;
+    ++w.no_record[cls];
+    if (w.n_unmatched < 8 && (cls == kNbMain || w.n_unmatched < 4)) {
+      ++w.n_unmatched;
+      w.examples_unmatched += fmt::format(" [{} end {:08X} prim {} n {} ib {} {:08X} surf {:08X}]",
+                                          kNbClassName[cls], packet_end, uint32_t(primitive_type),
+                                          index_count, has_index_buffer ? 1 : 0, index_buffer_guest_base,
+                                          regs[XE_GPU_REG_RB_SURFACE_INFO]);
+    }
+    return;
+  }
+  // The same packet address can come back while an older record for it is pending (command buffer
+  // memory reused): the oldest record belongs to this execution.
+  size_t best = 0;
+  if (list->size() > 1) {
+    ++w.addr_reuse;
+    for (size_t i = 1; i < list->size(); ++i) {
+      const RexNativeDrawRecordV2& a = (*list)[i].r;
+      const RexNativeDrawRecordV2& b = (*list)[best].r;
+      if (a.frame_id < b.frame_id || (a.frame_id == b.frame_id && a.sequence < b.sequence)) best = i;
+    }
+  }
+  const NativeBridgeRecord& rec = (*list)[best];
+  const RexNativeDrawRecordV2& r = rec.r;
+  ++w.matched[cls];
+  if (rec.draw_header) {
+    const uint32_t hdr = rex::graphics::g_native_bridge_packet_header;
+    ++w.hdr_checked;
+    if (rec.draw_header != hdr) {
+      ++w.hdr_bad;
+      if ((rec.draw_header & 1) != (hdr & 1)) ++w.hdr_pred_bad;
+      if (w.n_hdr_examples < 4) {
+        ++w.n_hdr_examples;
+        w.hdr_examples += fmt::format(" [path {} caller {:08X} end {:08X} rec {:08X} cp {:08X}]", r.path_id, r.caller,
+                                      r.packet_end, rec.draw_header, hdr);
+      }
+    }
+  }
+  ++w.matched_path[r.path_id < REX_NATIVE_PATH_COUNT ? r.path_id : 0];
+  const uint32_t bad = NativeBridgeCheck(r, primitive_type, index_count, has_index_buffer,
+                                         index_buffer_guest_base, index_size, regs, vertex_shader,
+                                         pixel_shader, w);
+  if (rec.v4) {  // AGENT_NATIVE29A
+    const bool v4ok = NativeBridgeCheckV4(rec, cls, regs, vertex_shader, pixel_shader, w, bad);
+    if (v4ok && !bad) NativeOwnLearn(rec, vertex_shader, pixel_shader);  // AGENT_NATIVE30A2 step 2
+  }
+  NativeBridgePublishMasksForDraw(r, vertex_shader, pixel_shader);  // AGENT_NATIVE29A: masks in verify mode (29B ask 1)
+  if (cls == kNbMain && (r.flags & REX_NATIVE_DRAW_FLAG_STREAM_STATE)) {
+    ++w.main_with_state;
+    if (!bad) ++w.main_exact_all;
+  }
+  if (cls == kNbMain && (r.flags & REX_NATIVE_DRAW_FLAG_STATE)) {
+    ++w.main_matched_state;
+    const uint32_t const_bits = (1u << kNbFVsConst) | (1u << kNbFPsConst);
+    if (bad && !(bad & ~const_bits)) ++w.main_const_only_bad;
+  }
+  if (m3a.active) {
+    std::memcpy(&m3a.r, &r, sizeof(r));
+    m3a.bad = bad;
+    m3a.hdr_state = !rec.draw_header ? 1u
+                    : rec.draw_header != rex::graphics::g_native_bridge_packet_header ? 2u
+                                                                                       : 0u;
+    m3a.matched = true;
+    m3a.outcome = 2;
+    m3a.has_values = (r.flags & kNbFlagConstValues) != 0;
+    m3a.vmask[0] = rec.vmask[0];
+    m3a.vmask[1] = rec.vmask[1];
+    if (m3a.has_values) m3a.values.assign(rec.values.begin(), rec.values.end());
+  }
+  if ((bad & ~((1u << kNbFRt) - 1)) && NativeBridgeExamplesWanted(w)) {
+    NativeBridgeExamples(rec, bad, cls, regs, vertex_shader, pixel_shader, w);
+  }
+  if (!bad) {
+    ++w.exact;
+  } else {
+    for (uint32_t f = 0; f < kNbFieldCount; ++f) {
+      if (bad & (1u << f)) ++w.field_mismatch[f];
+    }
+    if (w.n_field < 6) {
+      ++w.n_field;
+      std::string fields;
+      for (uint32_t f = 0; f < kNbFieldCount; ++f) {
+        if (bad & (1u << f)) fields += fmt::format("{}{}", fields.empty() ? "" : ",", kNbFieldName[f]);
+      }
+      w.examples_field += fmt::format(
+          " [{} path {} caller {:08X} pass {:X} {} | rec prim {} n {} ib {:08X}+{} base {} surf {:08X} | cp prim "
+          "{} n {} ib {:08X} base {} surf {:08X}]",
+          kNbClassName[cls], r.path_id, r.caller, r.pass_id, fields, r.primitive_type, r.index_count,
+          r.index_buffer_guest, r.start_index, r.base_vertex, r.surface_info, uint32_t(primitive_type),
+          index_count, index_buffer_guest_base, regs.Get<reg::VGT_INDX_OFFSET>().indx_offset,
+          regs[XE_GPU_REG_RB_SURFACE_INFO]);
+    }
+  }
+  g_native_bridge.pending_value_bytes -= (*list)[best].values.size() * 4;
+  if (best + 1 != list->size()) (*list)[best] = std::move(list->back());
+  list->pop_back();
+  --g_native_bridge.pending_count;
+  if (list->empty()) g_native_bridge.pending.erase(key);
+}
