@@ -0,0 +1,2338 @@
+// Native view (debug): our own D3D12 draws into separate native render targets, shown at present.
+// Switch: dist\native_view, contents  off | split | native | depth | splitdepth  [optional 2nd word: depth
+// view range in stops (log2), default 16; 3rd word: native frame every N frames, default 1]; missing file = off. Bench aliases: empty files native_view_split / _native /
+// _depth / _splitdepth (used only while dist\native_view is absent). Polled at IssueSwap (every 30 frames), latched per frame.
+//   split      : left half = emulated frame, right half = native colour (main colour pass), yellow divider
+//   native     : full native colour
+//   depth      : native depth (city pre-pass, 4x MSAA sample 0; main-pass depth if no pre-pass this frame)
+//   splitdepth : left emulated, right native depth
+// Render-both: the emulated targets, the emulated frame and everything the game reads stay authoritative and
+// untouched; the native targets are owned by this file and only read by the compositor. Off = one relaxed bool
+// test per draw + one file poll every 30 frames, nothing else.
+// Draw classes (live RB_SURFACE_INFO / RB_DEPTH_INFO):
+//   kNvClassPrepass : surface pitch 640, 4x MSAA, depth base 768 (city depth pre-pass + its mask draws)
+//   kNvClassMain    : surface pitch 1280, 1x, depth base 720 (main colour pass)
+// Each class has its own native set (depth + colour slots) cloned from the bound host render targets (same
+// size, format, sample count), so the emulated PSO of the draw can be re-issued unchanged into it.
+// Main-class native depth is seeded once per frame from the emulated depth at the first main-pass draw (the
+// main pass depth-tests against the pre-pass result; a native pre-pass -> main depth path is a later step).
+// CP thread only. Log 'NATIVE VIEW (VIEW12)' every 10 s while on.
+//
+// ======================= INTERFACE for the native colour code (native_view_color.inc) ======================
+// static bool NativeViewColorDraw(const NativeViewDrawCtx& ctx);
+// Called for every kNvClassMain draw with colour writes (ctx.color_mask != 0), AFTER the emulated draw was
+// recorded and AFTER the native targets of the class were bound (OMSetRenderTargets with ctx.color_rtv[0 ..
+// color_count-1] and ctx.depth_dsv when has_depth). Still bound on the command list: the emulated draw's PSO
+// (ctx.pipeline), root signature (ctx.root_signature) and ALL its root arguments (CBVs, descriptor tables,
+// shared memory SRV), index buffer, topology, viewport, scissor, stencil ref, blend factor.
+// Return true = it drew this draw into the native targets itself (the plain re-issue is skipped);
+// false = nothing recorded, the plain re-issue of the emulated PSO runs.
+// Rules:
+//  - Record only into ctx.cp->GetDeferredCommandList() (ctx.cl).
+//  - Change PSO / root signature only via ctx.cp->SetExternalPipeline / SetExternalGraphicsRootSignature (they
+//    invalidate the CP binding caches, so the next emulated draw rebinds everything); topology via
+//    ctx.cp->SetPrimitiveTopology, viewport / scissor via ctx.cp->SetViewport / SetScissorRect (restore them
+//    to ctx.viewport / ctx.scissor before returning if changed).
+//  - If an index buffer is set: *ctx.ib_cache_invalid = true (the CP whole-shared-memory IB view cache).
+//  - Never touch render targets / OMSetRenderTargets / the native resources' states: VIEW12 restores the
+//    emulated render targets right after the call.
+//  - No descriptor heap / RequestOneUse* / constant upload that could switch heaps without asking VIEW12.
+//  - The re-issued draw args: indexed ? DrawIndexedInstanced(vertex_count, 1, start_index, 0, 0)
+//                                     : DrawInstanced(vertex_count, 1, 0, 0) (as the emulated draw).
+// ==============================================================================================================
+enum NativeViewClass : uint32_t { kNvClassNone = 0, kNvClassPrepass = 1, kNvClassMain = 2, kNvClassCount = 3 };
+static const char* const kNvClassNames[kNvClassCount] = {"other", "prepass", "main"};
+
+// Complete graphics state of one emulated draw (bindless guest root layout), captured at the call site so the
+// draw can be replayed later in a batch (one native target switch per pass instead of two per draw).
+struct NvSnap {
+  void* pso_handle = nullptr;                 // guest pipeline handle (SetPipelineStateHandle) or
+  ID3D12PipelineState* pso = nullptr;         // an external pipeline
+  ID3D12RootSignature* rs = nullptr;
+  const void* sampler_heap = nullptr;         // the batch is flushed when this changes
+  uint32_t root_count = 0;
+  uint8_t root_index[12] = {};
+  uint8_t root_table[12] = {};                // 0 = root CBV, 1 = descriptor table
+  uint64_t root_value[12] = {};
+  bool indexed = false;
+  D3D12_INDEX_BUFFER_VIEW ibv = {};
+  D3D12_VIEWPORT vp = {};
+  D3D12_RECT sc = {};
+  D3D_PRIMITIVE_TOPOLOGY topo = D3D_PRIMITIVE_TOPOLOGY_UNDEFINED;
+  uint32_t stencil_ref = 0;
+  float blend[4] = {};
+};
+
+struct NativeViewDrawCtx {
+  D3D12CommandProcessor* cp = nullptr;
+  DeferredCommandList* cl = nullptr;
+  const RegisterFile* regs = nullptr;
+  uint32_t draw_class = kNvClassNone;
+  // Native targets of the class (bound when NativeViewColorDraw is called).
+  uint32_t color_count = 0;                         // contiguous slots 0..color_count-1
+  D3D12_CPU_DESCRIPTOR_HANDLE color_rtv[4] = {};
+  DXGI_FORMAT color_format[4] = {};                 // RTV (draw) formats, same as the emulated PSO's
+  ID3D12Resource* color_resource[4] = {};
+  bool has_depth = false;
+  D3D12_CPU_DESCRIPTOR_HANDLE depth_dsv = {};
+  DXGI_FORMAT depth_format = DXGI_FORMAT_UNKNOWN;   // DSV format
+  ID3D12Resource* depth_resource = nullptr;
+  uint32_t width = 0, height = 0, samples = 1;      // host pixels (resolution scale included)
+  uint32_t scale_x = 1, scale_y = 1;                // draw resolution scale
+  // The emulated draw.
+  const D3D12Shader* vs = nullptr;
+  const D3D12Shader* ps = nullptr;                  // null = depth only
+  uint64_t vs_ucode_hash = 0, ps_ucode_hash = 0;
+  D3D12Shader::D3D12Translation* vs_translation = nullptr;  // null on the native fast path
+  D3D12Shader::D3D12Translation* ps_translation = nullptr;
+  uint32_t native_shader = 0;                       // D3D12CommandProcessor::kNativeShaderCity* or 0
+  ID3D12PipelineState* pipeline = nullptr;          // bound PSO (emulated, or the native depth PSO)
+  void* pipeline_handle = nullptr;                  // PipelineCache handle of the emulated PSO (null on native paths)
+  PipelineCache* pipeline_cache = nullptr;          // the CP's pipeline cache
+  bool bindless = false;                            // bindless_resources_used_
+  ID3D12RootSignature* root_signature = nullptr;    // bound graphics root signature
+  uint32_t rt_bits = 0;                             // GetLastUpdateBoundRenderTargets bits (1 depth, 2<<i colour)
+  uint32_t rt_formats[1 + xenos::kMaxColorRenderTargets] = {};
+  reg::RB_DEPTHCONTROL depth_control = {};
+  uint32_t color_mask = 0;                          // normalized colour mask
+  const PrimitiveProcessor::ProcessingResult* ppr = nullptr;
+  D3D_PRIMITIVE_TOPOLOGY topology = D3D_PRIMITIVE_TOPOLOGY_UNDEFINED;
+  bool indexed = false;
+  uint32_t vertex_count = 0;                        // host_draw_vertex_count
+  uint32_t start_index = 0;                         // StartIndexLocation of the emulated draw
+  D3D12_VIEWPORT viewport = {};
+  D3D12_RECT scissor = {};
+  uint32_t stencil_ref = 0;
+  bool* ib_cache_invalid = nullptr;
+  // Batching (VIEW12 internal): snapshot of the emulated draw, valid on the bindless guest path.
+  bool snap_valid = false;
+  NvSnap snap;
+  void (*invalidate)(D3D12CommandProcessor*) = nullptr;  // CP binding trackers -> unknown (after a replay)
+  void (*prepare)(D3D12CommandProcessor*) = nullptr;     // shared memory readable before a replay
+  void (*restore)(D3D12CommandProcessor*) = nullptr;     // VIEW13: re-emit the CP's tracked state (mid-draw replay)
+};
+
+#include "native_view_color.inc"
+
+#ifndef NATIVE_VIEW_COLOR_HAS_PIPELINE
+// Pipeline selection without recording (batched replay). native_view_color.inc may define it itself (then it
+// defines NATIVE_VIEW_COLOR_HAS_PIPELINE); this default uses its selector directly.
+static ID3D12PipelineState* NativeViewColorPipeline(const NativeViewDrawCtx& ctx) {
+  if (!ctx.cp || !ctx.pipeline_cache || !ctx.pipeline_handle || !ctx.ppr || ctx.native_shader) return nullptr;
+  return native_view_color::Select(*ctx.pipeline_cache, ctx.pipeline_handle, ctx.vs, ctx.ps, ctx.vs_translation,
+                                   ctx.ps_translation, ctx.bindless, true, false, ctx.ppr->IsTessellated());
+}
+#endif
+
+// ---- VIEW13: flush before resource mutation (codex27 P0) + GPU timing bucket ----
+// A queued draw references shared memory / textures / render targets by address, so anything that rewrites them
+// before the batched replay flushes the queue first. Callers (shared_memory.cpp, texture_cache.cpp,
+// render_target_cache.cpp, the sampler heap switch in command_processor.cpp) only test g_native_view_queued.
+// The flush can run in the middle of a draw's setup, so after it the command list state is re-emitted from the
+// CP's trackers (ctx.restore) instead of invalidating them.
+bool g_native_view_queued = false;      // a native-view queue holds draws (and a restore function is known)
+bool g_native_view_mark_pages = false;  // native frame being tapped: shared memory reads are marked
+static constexpr uint32_t kNvPageShift = 16;  // 64 KB granularity of the read marks
+static constexpr uint32_t kNvPageWords = uint32_t(((uint64_t(512) << 20) >> kNvPageShift) / 64);
+static uint64_t g_nv_pages[kNvPageWords];
+static bool g_nv_pages_any = false;
+enum NvMutation : uint32_t {
+  kNvMutUpload,
+  kNvMutTexture,
+  kNvMutRtTransfer,
+  kNvMutSamplerHeap,
+  kNvMutMemexport,
+  kNvMutCount
+};
+static const char* const kNvMutNames[kNvMutCount] = {"upload", "texture", "rt_transfer", "sampler_heap", "memexport"};
+// Replays / seeds / compose / diff count in their own GPU timer bucket (logged as 'native view').
+static constexpr uint8_t kNvGpuTimeCategory = uint8_t(D3D12CommandProcessor::kGpuTimeCategoryCount);
+static double g_nv_gpu_seconds = 0.0;
+
+void NativeViewMarkPagesUsed(uint32_t first_byte, uint32_t length) {
+  if (!length) return;
+  const uint64_t last = std::min<uint64_t>(uint64_t(first_byte) + length - 1, (uint64_t(512) << 20) - 1);
+  if (first_byte > last) return;
+  for (uint32_t p = first_byte >> kNvPageShift, e = uint32_t(last >> kNvPageShift); p <= e; ++p) {
+    g_nv_pages[p >> 6] |= uint64_t(1) << (p & 63);
+  }
+  g_nv_pages_any = true;
+}
+bool NativeViewPagesOverlap(uint32_t first_byte, uint32_t length) {
+  if (!length || !g_nv_pages_any) return false;
+  const uint64_t last = std::min<uint64_t>(uint64_t(first_byte) + length - 1, (uint64_t(512) << 20) - 1);
+  if (first_byte > last) return false;
+  for (uint32_t p = first_byte >> kNvPageShift, e = uint32_t(last >> kNvPageShift); p <= e; ++p) {
+    if (g_nv_pages[p >> 6] & (uint64_t(1) << (p & 63))) return true;
+  }
+  return false;
+}
+static void NativeViewClearPages() {
+  if (!g_nv_pages_any) return;
+  std::memset(g_nv_pages, 0, sizeof(g_nv_pages));
+  g_nv_pages_any = false;
+}
+void NativeViewFlushBeforeMutation(uint32_t reason);  // after NativeViewFlushAll
