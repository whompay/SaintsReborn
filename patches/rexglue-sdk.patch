+static const char kNativeViewComposeShader[] = R"(
+cbuffer NvConstants : register(b0) {
+  uint2 out_size;
+  uint2 src_size;
+  uint mode;
+  uint split_x;
+  float depth_pow;
+  uint flags;
+};
+RWTexture2D<unorm float4> dst : register(u0);
+#if defined(NV_DEPTH_MS)
+Texture2DMS<float> src : register(t0);
+#elif defined(NV_DEPTH)
+Texture2D<float> src : register(t0);
+#else
+Texture2D<float4> src : register(t0);
+#endif
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= out_size)) return;
+  uint x0 = (mode == 1u || mode == 4u) ? split_x : 0u;
+  if (x0 != 0u) {
+    if (id.x + 2u < x0) return;
+    if (id.x <= x0 + 1u) { dst[id.xy] = float4(1.0, 0.85, 0.1, 1.0); return; }
+  }
+  uint2 s = min(uint2((float2(id.xy) + 0.5) * float2(src_size) / float2(out_size)), src_size - 1u);
+#if defined(NV_DEPTH_MS) || defined(NV_DEPTH)
+#if defined(NV_DEPTH_MS)
+  float d = src.Load(int2(s), 0);
+#else
+  float d = src.Load(int3(s, 0));
+#endif
+  float3 c;
+  if (d >= 1.0) {
+    c = float3(0.12, 0.0, 0.22);
+  } else if (d <= 0.0) {
+    c = float3(0.22, 0.0, 0.0);
+  } else {
+    // Log scale over depth_pow stops: near bright, far dark. Reversed Z (this game: far = 0) by default,
+    // flags bit 0 = conventional Z (far = 1).
+    float r = (flags & 1u) ? (1.0 - d) : d;
+    float g = 1.0 - saturate(-log2(max(r, 1e-12)) / depth_pow);
+    c = g.xxx;
+  }
+  dst[id.xy] = float4(c, 1.0);
+#else
+  float4 v = src.Load(int3(s, 0));
+  dst[id.xy] = float4(saturate(v.rgb), 1.0);
+#endif
+}
+)";
+
+static bool NativeViewInitialize(D3D12CommandProcessor& cp) {
+  NativeViewState& nv = g_native_view;
+  ID3D12Device* device = cp.GetD3D12Provider().GetDevice();
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile")) : nullptr;
+  if (!compile) {
+    REXLOG_ERROR("NATIVE VIEW (VIEW12): D3DCompile not available");
+    return false;
+  }
+  D3D12_DESCRIPTOR_HEAP_DESC hd = {};
+  hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+  hd.NumDescriptors = kNvClassCount * 4;
+  if (FAILED(device->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&nv.rtv_heap)))) return false;
+  hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV;
+  hd.NumDescriptors = kNvClassCount;
+  if (FAILED(device->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&nv.dsv_heap)))) return false;
+  nv.rtv_size = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+  nv.dsv_size = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_DSV);
+  D3D12_DESCRIPTOR_RANGE ranges[2] = {};
+  ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  ranges[0].NumDescriptors = 1;
+  ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[1].NumDescriptors = 1;
+  D3D12_ROOT_PARAMETER params[3] = {};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants.Num32BitValues = 8;
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  for (int i = 0; i < 2; ++i) {
+    params[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+    params[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    params[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 3;
+  desc.pParameters = params;
+  nv.root_signature.Attach(ui::d3d12::util::CreateRootSignature(cp.GetD3D12Provider(), desc));
+  if (!nv.root_signature) {
+    REXLOG_ERROR("NATIVE VIEW (VIEW12): root signature creation failed");
+    return false;
+  }
+  auto build = [&](const char* define, Microsoft::WRL::ComPtr<ID3D12PipelineState>& out) {
+    const D3D_SHADER_MACRO defines[] = {{define, "1"}, {nullptr, nullptr}};
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(kNativeViewComposeShader, sizeof(kNativeViewComposeShader) - 1, "native_view",
+                         defines, nullptr, "main", "cs_5_1", 1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXLOG_ERROR("NATIVE VIEW (VIEW12): {} compiler output: {}", define,
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) {
+      REXLOG_ERROR("NATIVE VIEW (VIEW12): compiling {} failed (0x{:08X})", define, uint32_t(hr));
+      return false;
+    }
+    out.Attach(ui::d3d12::util::CreateComputePipeline(device, code->GetBufferPointer(), code->GetBufferSize(),
+                                                      nv.root_signature.Get()));
+    code->Release();
+    return out != nullptr;
+  };
+  if (!build("NV_COLOR", nv.pso_color) || !build("NV_DEPTH", nv.pso_depth) ||
+      !build("NV_DEPTH_MS", nv.pso_depth_ms)) {
+    return false;
+  }
+  REXLOG_INFO("NATIVE VIEW (VIEW12): initialized");
+  return true;
+}
+
+// IssueSwap start: frame boundary, mode poll, counters log, retired resource release.
+static void NativeViewOnSwap(D3D12CommandProcessor& cp, bool host_render_targets) {
+  NativeViewState& nv = g_native_view;
+  ++nv.frame;
+  if (!nv.retired.empty()) {
+    const uint64_t done = cp.GetCompletedSubmission();
+    size_t keep = 0;
+    for (size_t i = 0; i < nv.retired.size(); ++i) {
+      if (nv.retired[i].first > done) nv.retired[keep++] = std::move(nv.retired[i]);
+    }
+    nv.retired.resize(keep);
+  }
+  if (++nv.poll_frames >= 30) {
+    nv.poll_frames = 0;
+    uint32_t mode = 0;
+    float depth_pow = 16.0f;
+    uint32_t interval = 1;
+    if (FILE* f = RexFlagFopen("native_view")) {
+      char text[64] = {};
+      const size_t n = std::fread(text, 1, sizeof(text) - 1, f);
+      std::fclose(f);
+      text[n] = 0;
+      char word[16] = {};
+      float p = 0.0f;
+      unsigned iv = 1;
+      const int got = std::sscanf(text, "%15s %f %u", word, &p, &iv);
+      if (got >= 3 && iv >= 1 && iv <= 600) interval = iv;
+      const std::string w = got >= 1 ? std::string(word) : std::string();
+      mode = w == "split" ? 1 : w == "native" ? 2 : w == "depth" ? 3 : w == "splitdepth" ? 4 : 0;
+      if (got >= 2 && p > 0.0f && p < 100000.0f) depth_pow = p;
+    } else {
+      // Empty-file aliases for the benchmark jobs (they create empty files).
+      static const char* const kAlias[] = {"native_view_split", "native_view_native", "native_view_depth",
+                                           "native_view_splitdepth"};
+      for (uint32_t i = 0; i < 4 && !mode; ++i) {
+        if (FILE* a = RexFlagFopen(kAlias[i])) {
+          std::fclose(a);
+          mode = i + 1;
+        }
+      }
+    }
+    if (FILE* f = RexFlagFopen("native_view_interval")) {  // bench helper: interval from its own file
+      unsigned iv = 0;
+      if (std::fscanf(f, "%u", &iv) == 1 && iv >= 1 && iv <= 600) interval = iv;
+      std::fclose(f);
+    }
+    bool nodraw = false;
+    if (FILE* f = RexFlagFopen("native_view_nodraw")) {
+      std::fclose(f);
+      nodraw = true;
+    }
+    bool batch = true;
+    if (FILE* f = RexFlagFopen("native_view_nobatch")) {
+      std::fclose(f);
+      batch = false;
+    }
+    if (batch != nv.batch) {
+      nv.batch = batch;
+      REXLOG_INFO("NATIVE VIEW (VIEW12): batched replay {}", batch ? "on" : "OFF (per draw)");
+    }
+    nv.prepass_family_only = Perf5FileExists("native_view_prepass_family");
+    nv.seed_f32 = Perf5FileExists("native_view_seed_f32");
+    nv.verify = Perf5FileExists("native_view_verify");
+    nv.verify_nodepth = Perf5FileExists("native_view_verify_nodepth");
+    nv.main_depthonly = !Perf5FileExists("native_view_main_depthonly.off");
+    nv.main_clear = !Perf5FileExists("native_view_clearquad.off");
+    nv.seed_swap12 = Perf5FileExists("native_view_seed_swap12");
+    {
+      uint32_t rows = 48;
+      if (FILE* f = RexFlagFopen("native_view_seed_rows")) {
+        unsigned r = 0;
+        if (std::fscanf(f, "%u", &r) == 1 && r <= 256) rows = r;
+        std::fclose(f);
+      }
+      nv.seed_rows = rows;
+    }
+    {
+      uint32_t dd = 0;
+      if (FILE* f = RexFlagFopen("native_view_depthdiff")) {
+        char w[16] = {};
+        dd = 1;
+        if (std::fscanf(f, "%15s", w) == 1 && std::string(w) == "end") dd = 2;
+        std::fclose(f);
+      } else if (Perf5FileExists("native_view_depthdiff_end")) {  // empty-file alias for the bench jobs
+        dd = 2;
+      }
+      if (dd != nv.depthdiff) {
+        nv.depthdiff = dd;
+        REXLOG_INFO("NATIVE VIEW (VIEW13): depth differential {}", dd == 0 ? "off" : dd == 1 ? "at the main depth seed"
+                                                                                  : "at the end of the main pass");
+      }
+    }
+    const bool seed_emulated = Perf5FileExists("native_view_seed_emulated");
+    nv.main_seed = seed_emulated ? 1u : Perf5FileExists("native_view_seed_prepass") ? 2u : 0u;
+    if (seed_emulated != nv.seed_emulated) {
+      nv.seed_emulated = seed_emulated;
+      REXLOG_INFO("NATIVE VIEW (VIEW12): main depth seeded from {}", seed_emulated ? "the EMULATED depth"
+                                                                                 : "our native pre-pass depth");
+    }
+    bool reissue_all = false;
+    if (FILE* f = RexFlagFopen("native_view_reissue_all")) {
+      std::fclose(f);
+      reissue_all = true;
+    }
+    if (reissue_all != nv.reissue_all) {
+      nv.reissue_all = reissue_all;
+      REXLOG_INFO("NATIVE VIEW (VIEW12): plain re-issue of non-native draws {}", reissue_all ? "ON" : "off");
+    }
+    if (nodraw != nv.nodraw) {
+      nv.nodraw = nodraw;
+      REXLOG_INFO("NATIVE VIEW (VIEW12): diagnostic nodraw {}", nodraw ? "ON (targets switched, no re-issue)" : "off");
+    }
+    if (mode != nv.mode || depth_pow != nv.depth_pow || interval != nv.interval) {
+      nv.interval = interval;
+      static const char* const names[] = {"off", "split", "native", "depth", "splitdepth"};
+      REXLOG_INFO("NATIVE VIEW (VIEW12): mode {} (depth contrast {}, native frame every {})", names[mode], depth_pow,
+                  interval);
+      nv.mode = mode;
+      nv.depth_pow = depth_pow;
+    }
+  }
+  nv.active = nv.mode != 0;
+  if (nv.active && !host_render_targets) {
+    ++nv.skips[kNvSkipPath];
+    nv.active = false;
+  }
+  // Frames that are presented now: the one that just ended (nv.frame - 1). Draw the next one natively?
+  nv.shown_native = nv.native_frame;
+  NativeViewClearPages();  // the swap flush ran before: nothing is queued (codex29 P2)
+  nv.tap = nv.active && (nv.interval <= 1 || nv.frame % nv.interval == 0);
+  if (nv.tap) nv.native_frame = nv.frame;
+  g_native_view_mark_pages = nv.tap && nv.batch;
+  for (auto& r : nv.diff_rb) {
+    if (!r.busy || !r.buffer || r.submission > cp.GetCompletedSubmission()) continue;
+    void* m = nullptr;
+    D3D12_RANGE rr = {0, 64};
+    if (SUCCEEDED(r.buffer->Map(0, &rr, &m)) && m) {
+      const uint32_t* u = static_cast<const uint32_t*>(m);
+      for (uint32_t i = 0; i < 7; ++i) nv.diff_acc[i] += u[i];
+      nv.diff_max_ulp = std::max<uint64_t>(nv.diff_max_ulp, u[10]);
+      ++nv.diff_samples;
+      D3D12_RANGE wr = {0, 0};
+      r.buffer->Unmap(0, &wr);
+    }
+    r.busy = false;
+  }
+  for (auto& r : nv.verify_rb) {
+    if (!r.busy || !r.buffer || r.submission > cp.GetCompletedSubmission()) continue;
+    void* m = nullptr;
+    D3D12_RANGE rr = {0, r.has_q ? SIZE_T(512) : SIZE_T(64)};
+    if (SUCCEEDED(r.buffer->Map(0, &rr, &m)) && m) {
+      const uint32_t* u = static_cast<const uint32_t*>(m);
+      NativeViewState::VerifyPair& p = nv.verify_pairs[r.vs ^ (r.ps * 0x9E3779B97F4A7C15ull)];
+      std::memcpy(p.ext, r.ext, sizeof(p.ext));
+      if (r.has_q) {
+        const D3D12_QUERY_DATA_PIPELINE_STATISTICS* qs = reinterpret_cast<const D3D12_QUERY_DATA_PIPELINE_STATISTICS*>(
+            static_cast<const uint8_t*>(m) + 256);
+        ++p.q_runs;
+        p.a_ia += qs[0].IAPrimitives;
+        p.a_cprim += qs[0].CPrimitives;
+        p.a_ps += qs[0].PSInvocations;
+        p.b_cprim += qs[1].CPrimitives;
+        p.b_ps += qs[1].PSInvocations;
+      }
+      p.vs = r.vs;
+      p.ps = r.ps;
+      p.dc = r.dc;
+      p.cmask = r.cmask;
+      p.rt_bits = r.rt_bits;
+      p.stencil_ref = r.stencil_ref;
+      ++p.runs;
+      p.written += u[0];
+      p.differ += u[1];
+      p.coverage += u[2];
+      p.a_only += u[4];
+      if (!p.has_sample && u[7] != 0) {
+        p.has_sample = true;
+        p.sample_a = u[5];
+        p.sample_b = u[6];
+      }
+      p.maxd = std::max<uint64_t>(p.maxd, u[3]);
+      if (u[0] != 0) {
+        ++p.nonempty_runs;
+        if (u[1] == 0 && u[2] == 0) ++p.exact_runs;
+      }
+      D3D12_RANGE wr = {0, 0};
+      r.buffer->Unmap(0, &wr);
+    }
+    r.busy = false;
+  }
+  const uint64_t now = GetTickCount64();
+  if (now >= nv.next_log) {
+    if (nv.next_log && (nv.mode || nv.composed || nv.tapped[kNvClassMain] || nv.tapped[kNvClassPrepass])) {
+      const double frames = double(std::max<uint64_t>(1, nv.frame - nv.log_frame));
+      std::string skips;
+      for (uint32_t i = 0; i < kNvSkipCount; ++i) {
+        if (nv.skips[i]) skips += fmt::format(" {} {:.1f}", kNvSkipNames[i], nv.skips[i] / frames);
+      }
+      std::string sets;
+      for (uint32_t c = 1; c < kNvClassCount; ++c) {
+        const NvSet& s = nv.set[c];
+        if (!s.depth.res && !s.color[0].res) continue;
+        const NvTarget& t = s.color[0].res ? s.color[0] : s.depth;
+        sets += fmt::format(" | {} {}x{} x{} colours {} depth {} (dxgi c0 {} d {}) content {}x{}", kNvClassNames[c],
+                            uint32_t(t.desc.Width), t.desc.Height, t.desc.SampleDesc.Count, s.color_count,
+                            s.has_depth ? 1 : 0, uint32_t(s.color[0].view_format), uint32_t(s.depth.view_format),
+                            s.content_w, s.content_h);
+      }
+      REXLOG_INFO("NATIVE VIEW (VIEW12): mode {}, {:.0f} frames; per frame: tapped prepass {:.1f} main {:.1f}, "
+                  "re-issued prepass {:.1f} main {:.1f}, colour hook {:.1f}, fast path {:.1f}, depth seeded {:.2f} (from our pre-pass {:.2f}), "
+                  "composed {:.2f} (no source {:.2f}, no descriptors {:.2f}), recreated {}, batches {:.1f} ({:.0f} draws "
+                  "each); skips:{}{}",
+                  nv.mode, frames, nv.tapped[kNvClassPrepass] / frames, nv.tapped[kNvClassMain] / frames,
+                  nv.reissued[kNvClassPrepass] / frames, nv.reissued[kNvClassMain] / frames, nv.color_hook / frames,
+                  nv.fast_path / frames, nv.depth_seeded / frames, nv.seed_native / frames, nv.composed / frames,
+                  nv.compose_no_source / frames, nv.compose_no_descriptors / frames, nv.recreated, nv.flushes / frames,
+                  nv.flushes ? double(nv.flushed_draws) / double(nv.flushes) : 0.0, skips.empty() ? " none" : skips, sets);
+      // VIEW13 diagnostics.
+      static const char* const kZf[9] = {"never", "less", "equal", "lequal", "greater", "notequal", "gequal", "always", "off"};
+      std::string zt, zn;
+      for (uint32_t i = 0; i < 9; ++i) {
+        if (nv.zfunc_taken[i]) zt += fmt::format(" {} {:.1f}", kZf[i], nv.zfunc_taken[i] / frames);
+        if (nv.zfunc_not[i]) zn += fmt::format(" {} {:.1f}", kZf[i], nv.zfunc_not[i] / frames);
+      }
+      REXLOG_INFO("NATIVE VIEW (VIEW13): mutation flushes/frame upload {:.2f} texture {:.2f} rt_transfer {:.2f} "
+                  "sampler_heap {:.2f} memexport {:.2f}, early (before target change) {:.2f}; seed {}{} rows {}; main re-issued with the "
+                  "emulated PSO: depth/stencil-only {:.1f}{} clear quad {:.1f}{}; main zfunc drawn:{} | not drawn:{}",
+                  nv.mut_flushes[kNvMutUpload] / frames, nv.mut_flushes[kNvMutTexture] / frames,
+                  nv.mut_flushes[kNvMutRtTransfer] / frames, nv.mut_flushes[kNvMutSamplerHeap] / frames,
+                  nv.mut_flushes[kNvMutMemexport] / frames,
+                  nv.early_flushes / frames,
+                  nv.main_seed == 0 ? "none (cleared far)" : nv.main_seed == 1 ? "emulated" : nv.seed_f32 ? "pre-pass f32" : "pre-pass f24",
+                  nv.seed_swap12 ? " swap12" : "",
+                  nv.seed_rows, nv.reissued_depthonly / frames, nv.main_depthonly ? "" : " (OFF)",
+                  nv.reissued_clear / frames, nv.main_clear ? "" : " (OFF)", zt.empty() ? " none" : zt,
+                  zn.empty() ? " none" : zn);
+      if (!nv.not_native_pairs.empty()) {
+        std::vector<const NvPairStat*> v;
+        v.reserve(nv.not_native_pairs.size());
+        for (const auto& kv : nv.not_native_pairs) v.push_back(&kv.second);
+        const size_t n = std::min<size_t>(12, v.size());
+        std::partial_sort(v.begin(), v.begin() + n, v.end(),
+                          [](const NvPairStat* a, const NvPairStat* b) { return a->count > b->count; });
+        std::string o;
+        for (size_t i = 0; i < n; ++i) {
+          reg::RB_DEPTHCONTROL dc;
+          dc.value = v[i]->depth_control;
+          o += fmt::format(" {:016X}/{:016X}:{:.1f}({}{} z{:.0f}% {} w{} st{})", v[i]->vs, v[i]->ps, v[i]->count / frames,
+                           (v[i]->reasons & 1) ? "nocol" : "", (v[i]->reasons & 2) ? "nopso" : "",
+                           100.0 * double(v[i]->z_on) / double(std::max<uint64_t>(1, v[i]->count)),
+                           kZf[uint32_t(dc.zfunc) & 7], uint32_t(dc.z_write_enable), uint32_t(dc.stencil_enable));
+        }
+        REXLOG_INFO("NATIVE VIEW (VIEW13): main draws not drawn natively, top pairs (draws/frame):{}", o);
+      }
+      if (nv.verify && !nv.verify_pairs.empty()) {
+        std::vector<const NativeViewState::VerifyPair*> v;
+        uint64_t exact_pairs = 0;
+        std::string exact_list;
+        for (const auto& kv : nv.verify_pairs) {
+          v.push_back(&kv.second);
+          if (kv.second.nonempty_runs && kv.second.exact_runs == kv.second.nonempty_runs) {
+            ++exact_pairs;
+            if (exact_pairs <= 48) {
+              exact_list += fmt::format(" {:08X}/{:08X}({})", uint32_t(kv.second.vs >> 32), uint32_t(kv.second.ps >> 32),
+                                        kv.second.nonempty_runs);
+            }
+          }
+        }
+        std::sort(v.begin(), v.end(), [](const NativeViewState::VerifyPair* a, const NativeViewState::VerifyPair* b) {
+          const double fa = double(a->differ + a->coverage) / double(std::max<uint64_t>(1, a->written));
+          const double fb = double(b->differ + b->coverage) / double(std::max<uint64_t>(1, b->written));
+          return fa != fb ? fa > fb : a->runs > b->runs;
+        });
+        std::string o;
+        for (size_t i = 0; i < std::min<size_t>(24, v.size()); ++i) {
+          o += fmt::format(" {:016X}/{:016X}: {} runs ({} exact) px {} differ {:.2f}% coverage {:.2f}% max {}/255 |",
+                           v[i]->vs, v[i]->ps, v[i]->runs, v[i]->exact_runs, v[i]->written,
+                           100.0 * double(v[i]->differ) / double(std::max<uint64_t>(1, v[i]->written)),
+                           100.0 * double(v[i]->coverage) / double(std::max<uint64_t>(1, v[i]->written)), v[i]->maxd);
+        }
+        REXLOG_INFO("NATIVE VIEW VERIFY (VIEW13): emulated PSO vs colour-code PSO, {} pairs ({} bit-exact in every run that "
+                    "wrote pixels:{}), {} runs, {} skipped (not RGBA8 / no target); worst first ((N exact) = runs that wrote "
+                    "pixels with no difference):{}",
+                    nv.verify_pairs.size(), exact_pairs, exact_list, nv.verify_runs, nv.verify_skipped, o);
+        // VIEW14: the line above is cut by the logger after ~24 pairs: one line per pair as well (all pairs).
+        auto rgba = [](bool has, uint32_t c) {
+          return has ? fmt::format("{},{},{},{}", c & 0xFF, (c >> 8) & 0xFF, (c >> 16) & 0xFF, c >> 24) : std::string("-");
+        };
+        for (size_t i = 0; i < v.size(); ++i) {
+          REXLOG_INFO("NATIVE VIEW VERIFY PAIR (VIEW14) {:016X}/{:016X}: runs {} nonempty {} exact {} px {} differ {:.2f}% "
+                      "coverage {:.2f}% (A only {} px, B only {} px) max {}/255 | dc {:08X} cmask {:04X} rt {:02X} sref {:02X} | first diff A rgba {} B rgba {} | "
+                      "bc0 {:08X} colctl {:08X} srm {:08X}/{:08X} vtx {} sc {},{},{},{} vp {},{},{},{} zt {} | stats runs {} "
+                      "A ia {} cprim {} ps {} B cprim {} ps {}",
+                      v[i]->vs, v[i]->ps, v[i]->runs, v[i]->nonempty_runs, v[i]->exact_runs, v[i]->written,
+                      100.0 * double(v[i]->differ) / double(std::max<uint64_t>(1, v[i]->written)),
+                      100.0 * double(v[i]->coverage) / double(std::max<uint64_t>(1, v[i]->written)), v[i]->a_only,
+                      v[i]->coverage - std::min(v[i]->coverage, v[i]->a_only), v[i]->maxd,
+                      v[i]->dc, v[i]->cmask, v[i]->rt_bits, v[i]->stencil_ref, rgba(v[i]->has_sample, v[i]->sample_a),
+                      rgba(v[i]->has_sample, v[i]->sample_b), v[i]->ext[0], v[i]->ext[1], v[i]->ext[2], v[i]->ext[3],
+                      v[i]->ext[4], int32_t(v[i]->ext[5]), int32_t(v[i]->ext[6]), int32_t(v[i]->ext[7]),
+                      int32_t(v[i]->ext[8]), int32_t(v[i]->ext[9]), int32_t(v[i]->ext[10]), int32_t(v[i]->ext[11]),
+                      int32_t(v[i]->ext[12]), v[i]->ext[13], v[i]->q_runs, v[i]->a_ia, v[i]->a_cprim, v[i]->a_ps,
+                      v[i]->b_cprim, v[i]->b_ps);
+        }
+      }
+      if (nv.diff_samples) {
+        const double total = double(std::max<uint64_t>(1, nv.diff_acc[0] + nv.diff_acc[1] + nv.diff_acc[2] +
+                                                              nv.diff_acc[3] + nv.diff_acc[4] + nv.diff_acc[5] +
+                                                              nv.diff_acc[6]));
+        REXLOG_INFO("NATIVE VIEW DEPTH DIFF (VIEW13, {}): {} compares ({} run); pixels % exact {:.3f} | both far {:.3f} | "
+                    "native far only (missing) {:.3f} | emulated far only {:.3f} | within 16 ulp {:.3f} | native nearer "
+                    "{:.3f} | native farther {:.3f} | max ulp {}",
+                    nv.depthdiff == 2 ? "end of main" : "at seed", nv.diff_samples, nv.diff_runs,
+                    100.0 * nv.diff_acc[0] / total, 100.0 * nv.diff_acc[1] / total, 100.0 * nv.diff_acc[2] / total,
+                    100.0 * nv.diff_acc[3] / total, 100.0 * nv.diff_acc[4] / total, 100.0 * nv.diff_acc[5] / total,
+                    100.0 * nv.diff_acc[6] / total, nv.diff_max_ulp);
+      }
+    }
+    std::memset(nv.mut_flushes, 0, sizeof(nv.mut_flushes));
+    nv.early_flushes = 0;
+    nv.reissued_depthonly = nv.reissued_clear = 0;
+    std::memset(nv.zfunc_taken, 0, sizeof(nv.zfunc_taken));
+    std::memset(nv.zfunc_not, 0, sizeof(nv.zfunc_not));
+    nv.not_native_pairs.clear();
+    std::memset(nv.diff_acc, 0, sizeof(nv.diff_acc));
+    nv.diff_samples = nv.diff_runs = nv.diff_max_ulp = 0;
+    std::memset(nv.tapped, 0, sizeof(nv.tapped));
+    std::memset(nv.reissued, 0, sizeof(nv.reissued));
+    std::memset(nv.skips, 0, sizeof(nv.skips));
+    nv.color_hook = nv.fast_path = nv.depth_seeded = nv.composed = nv.compose_no_source = nv.compose_no_descriptors =
+        nv.recreated = nv.flushes = nv.flushed_draws = nv.seed_native = 0;
+    nv.next_log = now + 10000;
+    nv.log_frame = nv.frame;
+  }
+}
+
+// (Re)creates native target t: same format / sample count / flags as the emulated host render target
+// `source`, sized to the class's active extent (w x h, clamped to the source). Sets *recreated.
+static bool NativeViewEnsureTarget(D3D12CommandProcessor& cp, NvTarget& t, ID3D12Resource* source,
+                                   bool is_depth, DXGI_FORMAT view_format, DXGI_FORMAT srv_format,
+                                   D3D12_CPU_DESCRIPTOR_HANDLE view_handle, uint32_t w, uint32_t h,
+                                   bool* recreated) {
+  // Normalized description (the emulated targets of one class differ in alignment / extra flags, which must not
+  // make the native target flip between variants every draw).
+  D3D12_RESOURCE_DESC d = source->GetDesc();
+  d.Alignment = 0;
+  d.MipLevels = 1;
+  d.DepthOrArraySize = 1;
+  d.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+  d.Flags = is_depth ? D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL : D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+  d.Width = std::min<UINT64>(d.Width, std::max<uint32_t>(1, w));
+  d.Height = std::min<UINT>(d.Height, std::max<uint32_t>(1, h));
+  if (t.res && t.view_format == view_format && t.srv_format == srv_format &&
+      t.desc.Width == d.Width && t.desc.Height == d.Height && t.desc.Format == d.Format &&
+      t.desc.SampleDesc.Count == d.SampleDesc.Count && t.desc.SampleDesc.Quality == d.SampleDesc.Quality &&
+      t.desc.Flags == d.Flags) {  // field-wise: D3D12_RESOURCE_DESC has padding (memcmp failed every draw in v12h)
+    return true;
+  }
+  // Safety: a target that keeps changing would allocate every draw (seen in v12h) - at most 8 per frame.
+  if (g_native_view.recreate_frame != g_native_view.frame) {
+    g_native_view.recreate_frame = g_native_view.frame;
+    g_native_view.recreates_in_frame = 0;
+  }
+  if (++g_native_view.recreates_in_frame > 8) return false;
+  NativeViewRetire(cp, t);
+  *recreated = true;
+  ++g_native_view.recreated;
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  const D3D12_RESOURCE_STATES initial =
+      is_depth ? D3D12_RESOURCE_STATE_DEPTH_WRITE : D3D12_RESOURCE_STATE_RENDER_TARGET;
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                             provider.GetHeapFlagCreateNotZeroed(), &d, initial, nullptr,
+                                             IID_PPV_ARGS(&t.res)))) {
+    REXLOG_ERROR("NATIVE VIEW (VIEW12): could not create a {}x{} x{} {} target (format {})", uint32_t(d.Width),
+                 d.Height, d.SampleDesc.Count, is_depth ? "depth" : "colour", uint32_t(d.Format));
+    t = NvTarget();
+    return false;
+  }
+  t.desc = d;
+  t.state = initial;
+  t.view_format = view_format;
+  t.srv_format = srv_format;
+  const bool ms = d.SampleDesc.Count > 1;
+  if (is_depth) {
+    D3D12_DEPTH_STENCIL_VIEW_DESC v = {};
+    v.Format = view_format;
+    v.ViewDimension = ms ? D3D12_DSV_DIMENSION_TEXTURE2DMS : D3D12_DSV_DIMENSION_TEXTURE2D;
+    device->CreateDepthStencilView(t.res.Get(), &v, view_handle);
+  } else {
+    D3D12_RENDER_TARGET_VIEW_DESC v = {};
+    v.Format = view_format;
+    v.ViewDimension = ms ? D3D12_RTV_DIMENSION_TEXTURE2DMS : D3D12_RTV_DIMENSION_TEXTURE2D;
+    device->CreateRenderTargetView(t.res.Get(), &v, view_handle);
+  }
+  REXLOG_INFO("NATIVE VIEW (VIEW12): created native {} target {}x{} x{} resource format {} view format {}",
+              is_depth ? "depth" : "colour", uint32_t(d.Width), d.Height, d.SampleDesc.Count, uint32_t(d.Format),
+              uint32_t(view_format));
+  return true;
+}
+
+static bool NativeViewTransition(D3D12CommandProcessor& cp, NvTarget& t, D3D12_RESOURCE_STATES s) {
+  if (t.res && t.state != s) {
+    cp.PushTransitionBarrier(t.res.Get(), t.state, s);
+    t.state = s;
+    return true;
+  }
+  return false;
+}
+
+// Main-pass depth seed: a full-screen draw writing SV_Depth from the emulated depth (the emulated main pass
+// depth-tests against the pre-pass result). Replaces the CopyResource of v12a-f, so the native depth can be
+// content-sized and keeps its compression / HiZ.
+// v12n: by default the source is OUR native 4x pre-pass depth (ps_prepass), mapped by EDRAM sample address:
+// main 1x guest pixel (x, y) = pre-pass guest sample (x, y - 48) (depth bases 720 / 768, 48 tiles = 48 sample
+// rows at pitch 1280), i.e. pre-pass pixel (x >> 1, (y - 48) >> 1), sample ((y - 48) & 1) * 2 + (x & 1); with the
+// draw resolution scale s every guest pixel is s x s host pixels holding the same samples.
+static const char kNativeViewSeedShader[] = R"(
+cbuffer SeedConstants : register(b0) {
+  uint scale_x;
+  uint scale_y;
+  uint row_offset;   // guest sample rows (48)
+  uint src_height;   // host pixels of the pre-pass depth
+  uint seed_flags;   // bit 0: float24 round trip (truncating), bit 1: swap host samples 1 and 2
+  uint3 seed_pad;
+};
+// Host depth -> guest float24 (20e4, truncating, as the EDRAM dump) -> host depth (the destination of a depth
+// ownership transfer without a host depth source gets exactly this).
+uint SeedPackFloat20e4(uint f32) {
+  uint f24;
+  if (f32 < 0x38000000u) {
+    uint shift = min(112u - (f32 >> 23), 24u);
+    f24 = ((f32 & 0x7FFFFFu) | 0x800000u) >> shift;
+  } else {
+    f24 = f32 + 0xC8800000u;
+  }
+  return (f24 >> 3) & 0xFFFFFFu;
+}
+uint SeedDecodeFloat20e4(uint f24) {
+  if (f24 == 0u) return 0u;
+  uint mantissa = f24 & 0xFFFFFu;
+  uint exponent = f24 >> 20;
+  if (exponent == 0u) {
+    uint shift = (31u - firstbithigh(mantissa)) - 11u;
+    exponent = 1u - shift;
+    mantissa = (mantissa << shift) & 0xFFFFFu;
+  }
+  return (exponent << 23) + 0x38000000u + (mantissa << 3);
+}
+float SeedToFloat24(float h) { return asfloat(SeedDecodeFloat20e4(SeedPackFloat20e4(asuint(h)))) * 0.5; }
+#ifdef SEED_PREPASS
+Texture2DMS<float> src_ms : register(t0);
+#else
+Texture2D<float> src : register(t0);
+#endif
+float4 vs_main(uint id : SV_VertexID) : SV_Position {
+  float2 uv = float2((id << 1) & 2, id & 2);
+  return float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+}
+#ifdef SEED_PREPASS
+float ps_main(float4 pos : SV_Position) : SV_Depth {
+  uint2 h = uint2(pos.xy);
+  uint gx = h.x / scale_x, sx = h.x % scale_x;
+  int gy = int(h.y / scale_y) - int(row_offset);
+  uint sy = h.y % scale_y;
+  if (gy < 0) return 0.0;  // above the pre-pass: far (reversed Z)
+  uint2 p = uint2((gx >> 1) * scale_x + sx, (uint(gy) >> 1) * scale_y + sy);
+  if (p.y >= src_height) return 0.0;
+  uint sample_index = ((uint(gy) & 1u) << 1) | (gx & 1u);
+  if ((seed_flags & 2u) != 0u && (sample_index == 1u || sample_index == 2u)) sample_index ^= 3u;
+  float d = src_ms.Load(int2(p), sample_index);
+  if ((seed_flags & 1u) != 0u) d = SeedToFloat24(d);
+  return d;
+}
+#else
+float ps_main(float4 pos : SV_Position) : SV_Depth {
+  return src.Load(int3(int2(pos.xy), 0));
+}
+#endif
+)";
+
+static bool NativeViewSeedInit(D3D12CommandProcessor& cp) {
+  NativeViewState& nv = g_native_view;
+  if (nv.seed_init_tried) return nv.seed_root_signature != nullptr;
+  nv.seed_init_tried = true;
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile")) : nullptr;
+  if (!compile) return false;
+  auto build = [&](const char* entry, const char* target, std::vector<uint8_t>& out, bool prepass = false) {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    const D3D_SHADER_MACRO defines[] = {{"SEED_PREPASS", "1"}, {nullptr, nullptr}};
+    HRESULT hr = compile(kNativeViewSeedShader, sizeof(kNativeViewSeedShader) - 1, "native_view_seed",
+                         prepass ? defines : nullptr, nullptr, entry, target, 1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXLOG_ERROR("NATIVE VIEW (VIEW12): seed {} compiler output: {}", entry,
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) return false;
+    const uint8_t* p = static_cast<const uint8_t*>(code->GetBufferPointer());
+    out.assign(p, p + code->GetBufferSize());
+    code->Release();
+    return true;
+  };
+  if (!build("vs_main", "vs_5_1", nv.seed_vs) || !build("ps_main", "ps_5_1", nv.seed_ps) ||
+      !build("ps_main", "ps_5_1", nv.seed_ps_prepass, true)) {
+    return false;
+  }
+  D3D12_DESCRIPTOR_RANGE range = {};
+  range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  range.NumDescriptors = 1;
+  D3D12_ROOT_PARAMETER param[2] = {};
+  param[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  param[0].DescriptorTable.NumDescriptorRanges = 1;
+  param[0].DescriptorTable.pDescriptorRanges = &range;
+  param[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  param[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  param[1].Constants.Num32BitValues = 8;
+  param[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 2;
+  desc.pParameters = param;
+  nv.seed_root_signature.Attach(ui::d3d12::util::CreateRootSignature(cp.GetD3D12Provider(), desc));
+  return nv.seed_root_signature != nullptr;
+}
+
+static ID3D12PipelineState* NativeViewSeedPipeline(D3D12CommandProcessor& cp, DXGI_FORMAT dsv_format,
+                                                   bool prepass) {
+  NativeViewState& nv = g_native_view;
+  const uint32_t key = uint32_t(dsv_format) | (prepass ? 0x10000u : 0u);
+  auto it = nv.seed_pipelines.find(key);
+  if (it != nv.seed_pipelines.end()) return it->second.Get();
+  D3D12_GRAPHICS_PIPELINE_STATE_DESC d = {};
+  d.pRootSignature = nv.seed_root_signature.Get();
+  d.VS.pShaderBytecode = nv.seed_vs.data();
+  d.VS.BytecodeLength = nv.seed_vs.size();
+  d.PS.pShaderBytecode = prepass ? nv.seed_ps_prepass.data() : nv.seed_ps.data();
+  d.PS.BytecodeLength = prepass ? nv.seed_ps_prepass.size() : nv.seed_ps.size();
+  d.SampleMask = UINT_MAX;
+  d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+  d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+  d.RasterizerState.DepthClipEnable = FALSE;
+  d.DepthStencilState.DepthEnable = TRUE;
+  d.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ALL;
+  d.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+  d.DSVFormat = dsv_format;
+  d.NumRenderTargets = 0;
+  d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+  d.SampleDesc.Count = 1;
+  Microsoft::WRL::ComPtr<ID3D12PipelineState> p;
+  if (FAILED(cp.GetD3D12Provider().GetDevice()->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&p)))) {
+    REXLOG_ERROR("NATIVE VIEW (VIEW12): depth seed pipeline creation failed (DSV format {})", uint32_t(dsv_format));
+  }
+  nv.seed_pipelines[key] = p;
+  return p.Get();
+}
+
+// VIEW13 depth differential: native main depth vs emulated main depth (same host coordinates), image + counters.
+// Image: grey = bit-exact (brightness = depth), dark blue = both far, magenta = native far only (missing), cyan =
+// emulated far only, yellow = within 16 ulp, green = native nearer, red = native farther.
+static const char kNativeViewDiffShader[] = R"(
+cbuffer DiffConstants : register(b0) {
+  uint2 size;
+  uint ulp_tolerance;
+  uint pad;
+};
+Texture2D<float> native_depth : register(t0);
+Texture2D<float> emulated_depth : register(t1);
+RWTexture2D<unorm float4> image : register(u0);
+RWByteAddressBuffer stats : register(u1);
+groupshared uint g_count[8];
+groupshared uint g_max;
+[numthreads(64, 1, 1)]
+void clear_main(uint3 id : SV_DispatchThreadID) {
+  if (id.x < 16u) stats.Store(id.x * 4u, 0u);
+}
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex) {
+  if (gi < 8u) g_count[gi] = 0u;
+  if (gi == 0u) g_max = 0u;
+  GroupMemoryBarrierWithGroupSync();
+  if (all(id.xy < size)) {
+    uint a = asuint(native_depth.Load(int3(id.xy, 0)));
+    uint b = asuint(emulated_depth.Load(int3(id.xy, 0)));
+    uint cat;
+    float3 c;
+    if (a == b) {
+      cat = a == 0u ? 1u : 0u;
+      float g = 0.12 + 0.45 * saturate(1.0 + log2(max(asfloat(a) * 2.0, 1e-12)) / 16.0);
+      c = a == 0u ? float3(0.02, 0.02, 0.08) : g.xxx;
+    } else if (a == 0u) {
+      cat = 2u;
+      c = float3(1.0, 0.0, 1.0);
+    } else if (b == 0u) {
+      cat = 3u;
+      c = float3(0.0, 1.0, 1.0);
+    } else {
+      uint d = a > b ? a - b : b - a;
+      InterlockedMax(g_max, d);
+      if (d <= ulp_tolerance) {
+        cat = 4u;
+        c = float3(1.0, 1.0, 0.0);
+      } else if (a > b) {
+        cat = 5u;
+        c = float3(0.0, 1.0, 0.0);
+      } else {
+        cat = 6u;
+        c = float3(1.0, 0.0, 0.0);
+      }
+    }
+    image[id.xy] = float4(c, 1.0);
+    InterlockedAdd(g_count[cat], 1u);
+  }
+  GroupMemoryBarrierWithGroupSync();
+  if (gi < 7u && g_count[gi] != 0u) stats.InterlockedAdd(gi * 4u, g_count[gi]);
+  if (gi == 0u && g_max != 0u) stats.InterlockedMax(40u, g_max);
+}
+)";
+
+static bool NativeViewDiffInit(D3D12CommandProcessor& cp) {
+  NativeViewState& nv = g_native_view;
+  if (nv.diff_init_tried) return nv.diff_pso && nv.diff_clear_pso && nv.diff_stats;
+  nv.diff_init_tried = true;
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile")) : nullptr;
+  if (!compile) return false;
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  D3D12_DESCRIPTOR_RANGE ranges[4] = {};
+  ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[0].NumDescriptors = 1;
+  ranges[0].BaseShaderRegister = 0;
+  ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[1].NumDescriptors = 1;
+  ranges[1].BaseShaderRegister = 1;
+  ranges[2].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  ranges[2].NumDescriptors = 1;
+  ranges[2].BaseShaderRegister = 0;
+  ranges[3].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  ranges[3].NumDescriptors = 1;
+  ranges[3].BaseShaderRegister = 1;
+  D3D12_ROOT_PARAMETER params[5] = {};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants.Num32BitValues = 4;
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  for (int i = 0; i < 4; ++i) {
+    params[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+    params[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    params[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 5;
+  desc.pParameters = params;
+  nv.diff_root_signature.Attach(ui::d3d12::util::CreateRootSignature(provider, desc));
+  if (!nv.diff_root_signature) return false;
+  auto build = [&](const char* entry, Microsoft::WRL::ComPtr<ID3D12PipelineState>& out) {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(kNativeViewDiffShader, sizeof(kNativeViewDiffShader) - 1, "native_view_diff", nullptr,
+                         nullptr, entry, "cs_5_1", 1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXLOG_ERROR("NATIVE VIEW (VIEW13): diff {} compiler output: {}", entry,
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) return false;
+    out.Attach(ui::d3d12::util::CreateComputePipeline(device, code->GetBufferPointer(), code->GetBufferSize(),
+                                                      nv.diff_root_signature.Get()));
+    code->Release();
+    return out != nullptr;
+  };
+  if (!build("main", nv.diff_pso) || !build("clear_main", nv.diff_clear_pso)) return false;
+  D3D12_RESOURCE_DESC bd;
+  ui::d3d12::util::FillBufferResourceDesc(bd, 256, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                             provider.GetHeapFlagCreateNotZeroed(), &bd,
+                                             D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                             IID_PPV_ARGS(&nv.diff_stats)))) {
+    return false;
+  }
+  nv.diff_stats_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  ui::d3d12::util::FillBufferResourceDesc(bd, 256, D3D12_RESOURCE_FLAG_NONE);
+  for (auto& r : nv.diff_rb) {
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                               provider.GetHeapFlagCreateNotZeroed(), &bd,
+                                               D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&r.buffer)))) {
+      return false;
+    }
+  }
+  REXLOG_INFO("NATIVE VIEW (VIEW13): depth differential initialized");
+  return true;
+}
+
+// emulated_depth must be the bound emulated main depth (DEPTH_WRITE).
+static void NativeViewDepthDiff(D3D12CommandProcessor& cp, NvSet& main, ID3D12Resource* emulated_depth) {
+  NativeViewState& nv = g_native_view;
+  if (!emulated_depth || !main.has_depth || !main.depth.res || main.depth.desc.SampleDesc.Count != 1) return;
+  const uint32_t w = main.content_w, h = main.content_h;
+  if (!w || !h || !NativeViewDiffInit(cp)) return;
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!nv.diff_img.res || nv.diff_img.desc.Width != w || nv.diff_img.desc.Height != h) {
+    NativeViewRetire(cp, nv.diff_img);
+    D3D12_RESOURCE_DESC d = {};
+    d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    d.Width = w;
+    d.Height = h;
+    d.DepthOrArraySize = 1;
+    d.MipLevels = 1;
+    d.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    d.SampleDesc.Count = 1;
+    d.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    d.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                               provider.GetHeapFlagCreateNotZeroed(), &d,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&nv.diff_img.res)))) {
+      nv.diff_img = NvTarget();
+      return;
+    }
+    nv.diff_img.desc = d;
+    nv.diff_img.state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    nv.diff_img.view_format = nv.diff_img.srv_format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair hd[4];
+  if (!cp.RequestOneUseSingleViewDescriptors(4, hd)) return;
+  D3D12_SHADER_RESOURCE_VIEW_DESC s = {};
+  s.Format = main.depth.srv_format;
+  s.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  s.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  s.Texture2D.MipLevels = 1;
+  device->CreateShaderResourceView(main.depth.res.Get(), &s, hd[0].first);
+  device->CreateShaderResourceView(emulated_depth, &s, hd[1].first);
+  D3D12_UNORDERED_ACCESS_VIEW_DESC u = {};
+  u.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  u.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  device->CreateUnorderedAccessView(nv.diff_img.res.Get(), nullptr, &u, hd[2].first);
+  ui::d3d12::util::CreateBufferRawUAV(device, hd[3].first, nv.diff_stats.Get(), 256);
+  const uint8_t prev_timer = cp.GpuTimerSwitch(kNvGpuTimeCategory);
+  NativeViewTransition(cp, main.depth, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  cp.PushTransitionBarrier(emulated_depth, D3D12_RESOURCE_STATE_DEPTH_WRITE,
+                           D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  NativeViewTransition(cp, nv.diff_img, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  if (nv.diff_stats_state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+    cp.PushTransitionBarrier(nv.diff_stats.Get(), nv.diff_stats_state, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    nv.diff_stats_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  }
+  cp.SubmitBarriers();
+  DeferredCommandList& cl = cp.GetDeferredCommandList();
+  cl.D3DSetComputeRootSignature(nv.diff_root_signature.Get());
+  const uint32_t k[4] = {w, h, 16u, 0u};
+  cl.D3DSetComputeRoot32BitConstants(0, 4, k, 0);
+  for (uint32_t i = 0; i < 4; ++i) cl.D3DSetComputeRootDescriptorTable(1 + i, hd[i].second);
+  cp.SetExternalPipeline(nv.diff_clear_pso.Get());
+  cl.D3DDispatch(1, 1, 1);
+  cp.PushUAVBarrier(nv.diff_stats.Get());
+  cp.SubmitBarriers();
+  cp.SetExternalPipeline(nv.diff_pso.Get());
+  cl.D3DDispatch((w + 7) / 8, (h + 7) / 8, 1);
+  cp.PushTransitionBarrier(emulated_depth, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                           D3D12_RESOURCE_STATE_DEPTH_WRITE);
+  for (auto& r : nv.diff_rb) {
+    if (r.busy || !r.buffer) continue;
+    cp.PushTransitionBarrier(nv.diff_stats.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                             D3D12_RESOURCE_STATE_COPY_SOURCE);
+    nv.diff_stats_state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    cp.SubmitBarriers();
+    cl.D3DCopyBufferRegion(r.buffer.Get(), 0, nv.diff_stats.Get(), 0, 64);
+    r.submission = cp.GetCurrentSubmission();
+    r.busy = true;
+    break;
+  }
+  cp.SubmitBarriers();
+  cp.GpuTimerSwitch(prev_timer);
+  nv.diff_frame = nv.frame;
+  ++nv.diff_runs;
+}
+
+static const char kNativeViewVerifyShader[] = R"(
+cbuffer VerifyConstants : register(b0) {
+  uint2 size;
+  uint sentinel_bits;
+  uint pad;
+};
+Texture2D<float4> a_tex : register(t0);
+Texture2D<float4> b_tex : register(t1);
+RWTexture2D<unorm float4> image : register(u0);
+RWByteAddressBuffer stats : register(u1);
+groupshared uint g_c[4];
+groupshared uint g_m;
+uint Pack8(float4 v) {
+  uint4 u = uint4(round(saturate(v) * 255.0));
+  return u.x | (u.y << 8) | (u.z << 16) | (u.w << 24);
+}
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex) {
+  if (gi < 4u) g_c[gi] = 0u;
+  if (gi == 0u) g_m = 0u;
+  GroupMemoryBarrierWithGroupSync();
+  if (all(id.xy < size)) {
+    float4 a = a_tex.Load(int3(id.xy, 0));
+    float4 b = b_tex.Load(int3(id.xy, 0));
+    uint pa = Pack8(a), pb = Pack8(b);
+    bool wa = pa != sentinel_bits, wb = pb != sentinel_bits;
+    float3 c = float3(0.04, 0.04, 0.04);
+    if (wa || wb) {
+      InterlockedAdd(g_c[0], 1u);
+      if (wa != wb) {
+        InterlockedAdd(g_c[2], 1u);
+        if (wa) InterlockedAdd(g_c[3], 1u);  // VIEW14: A (emulated) only
+        c = float3(1.0, 0.0, 1.0);
+      } else if (pa != pb) {
+        InterlockedAdd(g_c[1], 1u);
+        uint first_prev;  // VIEW14: one sample of a differing pixel per run (A at 20, B at 24, flag at 28)
+        stats.InterlockedCompareExchange(28u, 0u, 1u, first_prev);
+        if (first_prev == 0u) {
+          stats.Store(20u, pa);
+          stats.Store(24u, pb);
+        }
+        uint4 ua = uint4(pa, pa >> 8, pa >> 16, pa >> 24) & 0xFFu;
+        uint4 ub = uint4(pb, pb >> 8, pb >> 16, pb >> 24) & 0xFFu;
+        uint4 d = uint4(abs(int4(ua) - int4(ub)));
+        InterlockedMax(g_m, max(max(d.x, d.y), max(d.z, d.w)));
+        c = float3(1.0, 0.0, 0.0);
+      } else {
+        c = a.rgb;
+      }
+    }
+    image[id.xy] = float4(c, 1.0);
+  }
+  GroupMemoryBarrierWithGroupSync();
+  if (gi < 3u && g_c[gi] != 0u) stats.InterlockedAdd(gi * 4u, g_c[gi]);
+  if (gi == 3u && g_c[3] != 0u) stats.InterlockedAdd(16u, g_c[3]);
+  if (gi == 0u && g_m != 0u) stats.InterlockedMax(12u, g_m);
+}
+)";
+static const float kNvVerifySentinel[4] = {64.0f / 255.0f, 128.0f / 255.0f, 192.0f / 255.0f, 32.0f / 255.0f};
+static uint32_t NativeViewVerifySentinelBits() {
+  uint32_t bits = 0;
+  for (uint32_t i = 0; i < 4; ++i) bits |= uint32_t(kNvVerifySentinel[i] * 255.0f + 0.5f) << (8 * i);
+  return bits;
+}
+
+static bool NativeViewVerifyInit(D3D12CommandProcessor& cp) {
+  NativeViewState& nv = g_native_view;
+  if (nv.verify_init_tried) return nv.verify_pso != nullptr && nv.verify_stats != nullptr;
+  nv.verify_init_tried = true;
+  if (!NativeViewDiffInit(cp)) return false;  // shares the diff root signature + clear pass
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile")) : nullptr;
+  if (!compile) return false;
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  ID3DBlob* code = nullptr;
+  ID3DBlob* errors = nullptr;
+  HRESULT hr = compile(kNativeViewVerifyShader, sizeof(kNativeViewVerifyShader) - 1, "native_view_verify", nullptr,
+                       nullptr, "main", "cs_5_1", 1u << 15, 0, &code, &errors);
+  if (errors) {
+    REXLOG_ERROR("NATIVE VIEW (VIEW13): verify compiler output: {}",
+                 std::string(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize()));
+    errors->Release();
+  }
+  if (FAILED(hr) || !code) return false;
+  nv.verify_pso.Attach(ui::d3d12::util::CreateComputePipeline(device, code->GetBufferPointer(), code->GetBufferSize(),
+                                                             nv.diff_root_signature.Get()));
+  code->Release();
+  if (!nv.verify_pso) return false;
+  D3D12_RESOURCE_DESC bd;
+  ui::d3d12::util::FillBufferResourceDesc(bd, 256, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                             provider.GetHeapFlagCreateNotZeroed(), &bd,
+                                             D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                             IID_PPV_ARGS(&nv.verify_stats)))) {
+    return false;
+  }
+  ui::d3d12::util::FillBufferResourceDesc(bd, 512, D3D12_RESOURCE_FLAG_NONE);
+  {
+    D3D12_QUERY_HEAP_DESC qd = {};
+    qd.Type = D3D12_QUERY_HEAP_TYPE_PIPELINE_STATISTICS;
+    qd.Count = 2;
+    if (FAILED(device->CreateQueryHeap(&qd, IID_PPV_ARGS(&nv.verify_qheap)))) nv.verify_qheap.Reset();
+  }
+  for (auto& r : nv.verify_rb) {
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                               provider.GetHeapFlagCreateNotZeroed(), &bd,
+                                               D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&r.buffer)))) {
+      return false;
+    }
+  }
+  REXLOG_INFO("NATIVE VIEW (VIEW13): GPU differential verify initialized");
+  return true;
+}
+
+// Scratch target with the description `like` (colour: RTV in slot `slot` of the class-0 RTV range; depth: the class-0
+// DSV). Returns false if it cannot exist.
+static bool NativeViewVerifyTarget(D3D12CommandProcessor& cp, NvTarget& t, const NvTarget& like, bool is_depth,
+                                   uint32_t slot, D3D12_RESOURCE_FLAGS extra_flags) {
+  NativeViewState& nv = g_native_view;
+  D3D12_RESOURCE_DESC d = like.desc;
+  d.Flags |= extra_flags;
+  if (t.res && t.desc.Width == d.Width && t.desc.Height == d.Height && t.desc.Format == d.Format &&
+      t.desc.SampleDesc.Count == d.SampleDesc.Count && t.desc.Flags == d.Flags && t.view_format == like.view_format) {
+    return true;
+  }
+  NativeViewRetire(cp, t);
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  const D3D12_RESOURCE_STATES initial =
+      is_depth ? D3D12_RESOURCE_STATE_DEPTH_WRITE : D3D12_RESOURCE_STATE_RENDER_TARGET;
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                             provider.GetHeapFlagCreateNotZeroed(), &d, initial, nullptr,
+                                             IID_PPV_ARGS(&t.res)))) {
+    t = NvTarget();
+    return false;
+  }
+  t.desc = d;
+  t.state = initial;
+  t.view_format = like.view_format;
+  t.srv_format = like.srv_format;
+  if (is_depth) {
+    D3D12_DEPTH_STENCIL_VIEW_DESC v = {};
+    v.Format = like.view_format;
+    v.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+    device->CreateDepthStencilView(t.res.Get(), &v, nv.dsv_heap->GetCPUDescriptorHandleForHeapStart());
+  } else {
+    D3D12_RENDER_TARGET_VIEW_DESC v = {};
+    v.Format = like.view_format;
+    v.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2D;
+    D3D12_CPU_DESCRIPTOR_HANDLE h = nv.rtv_heap->GetCPUDescriptorHandleForHeapStart();
+    h.ptr += SIZE_T(slot) * nv.rtv_size;
+    device->CreateRenderTargetView(t.res.Get(), &v, h);
+  }
+  return true;
+}
+
+// Inside NativeViewFlushSet, right before queued draw q is replayed (all its state already emitted, native targets
+// bound): draws it into verify A (emulated PSO) and B (q.override_pso) and rebinds the native targets.
+static void NativeViewVerifyTwin(D3D12CommandProcessor& cp, NvSet& set, const NvQueued& q,
+                                 const D3D12_CPU_DESCRIPTOR_HANDLE* rtv, const D3D12_CPU_DESCRIPTOR_HANDLE* dsv) {
+  NativeViewState& nv = g_native_view;
+  DeferredCommandList& cl = cp.GetDeferredCommandList();
+  const NvTarget& c0 = set.color[0];
+  if (!NativeViewVerifyTarget(cp, nv.verify_a, c0, false, 0, D3D12_RESOURCE_FLAG_NONE) ||
+      !NativeViewVerifyTarget(cp, nv.verify_b, c0, false, 1, D3D12_RESOURCE_FLAG_NONE) ||
+      (set.has_depth && !NativeViewVerifyTarget(cp, nv.verify_depth, set.depth, true, 0, D3D12_RESOURCE_FLAG_NONE))) {
+    ++nv.verify_skipped;
+    return;
+  }
+  D3D12_CPU_DESCRIPTOR_HANDLE va = nv.rtv_heap->GetCPUDescriptorHandleForHeapStart(), vb = va;
+  vb.ptr += nv.rtv_size;
+  const D3D12_CPU_DESCRIPTOR_HANDLE vd = nv.dsv_heap->GetCPUDescriptorHandleForHeapStart();
+  auto copy_depth = [&]() {
+    if (!set.has_depth) return;
+    NativeViewTransition(cp, set.depth, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    NativeViewTransition(cp, nv.verify_depth, D3D12_RESOURCE_STATE_COPY_DEST);
+    cp.SubmitBarriers();
+    cl.D3DCopyResource(nv.verify_depth.res.Get(), set.depth.res.Get());
+    NativeViewTransition(cp, nv.verify_depth, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+    NativeViewTransition(cp, set.depth, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+    cp.SubmitBarriers();
+  };
+  auto draw = [&]() {
+    if (q.s.indexed) {
+      cl.D3DDrawIndexedInstanced(q.vertex_count, 1, q.start_index, 0, 0);
+    } else {
+      cl.D3DDrawInstanced(q.vertex_count, 1, 0, 0);
+    }
+  };
+  NativeViewTransition(cp, nv.verify_a, D3D12_RESOURCE_STATE_RENDER_TARGET);
+  NativeViewTransition(cp, nv.verify_b, D3D12_RESOURCE_STATE_RENDER_TARGET);
+  cp.SubmitBarriers();
+  cl.D3DClearRenderTargetView(va, kNvVerifySentinel, 0, nullptr);
+  cl.D3DClearRenderTargetView(vb, kNvVerifySentinel, 0, nullptr);
+  // A: translated guest shaders (the emulated PSO of the draw).
+  const bool twin_depth = set.has_depth && !nv.verify_nodepth;
+  copy_depth();
+  cl.D3DOMSetRenderTargets(1, &va, FALSE, twin_depth ? &vd : nullptr);
+  if (q.s.pso) {
+    cl.D3DSetPipelineState(q.s.pso);
+  } else {
+    cl.SetPipelineStateHandle(q.s.pso_handle);
+  }
+  ID3D12QueryHeap* qh = nv.verify_qheap.Get();
+  if (qh) cl.D3DBeginQuery(qh, D3D12_QUERY_TYPE_PIPELINE_STATISTICS, 0);
+  draw();
+  if (qh) cl.D3DEndQuery(qh, D3D12_QUERY_TYPE_PIPELINE_STATISTICS, 0);
+  // B: the colour code's pipeline.
+  copy_depth();
+  cl.D3DOMSetRenderTargets(1, &vb, FALSE, twin_depth ? &vd : nullptr);
+  cl.D3DSetPipelineState(q.override_pso);
+  if (qh) cl.D3DBeginQuery(qh, D3D12_QUERY_TYPE_PIPELINE_STATISTICS, 1);
+  draw();
+  if (qh) cl.D3DEndQuery(qh, D3D12_QUERY_TYPE_PIPELINE_STATISTICS, 1);
+  nv.verify_q_used = qh != nullptr;
+  nv.verify_ext[0] = q.bc0;
+  nv.verify_ext[1] = q.colctl;
+  nv.verify_ext[2] = q.srm;
+  nv.verify_ext[3] = q.srm_bf;
+  nv.verify_ext[4] = q.vertex_count;
+  nv.verify_ext[5] = uint32_t(q.s.sc.left);
+  nv.verify_ext[6] = uint32_t(q.s.sc.top);
+  nv.verify_ext[7] = uint32_t(q.s.sc.right);
+  nv.verify_ext[8] = uint32_t(q.s.sc.bottom);
+  nv.verify_ext[9] = uint32_t(int32_t(q.s.vp.TopLeftX));
+  nv.verify_ext[10] = uint32_t(int32_t(q.s.vp.TopLeftY));
+  nv.verify_ext[11] = uint32_t(int32_t(q.s.vp.Width));
+  nv.verify_ext[12] = uint32_t(int32_t(q.s.vp.Height));
+  nv.verify_ext[13] = twin_depth ? 1u : 0u;
+  // Back to the native targets; the replay loop's PSO for q is q.override_pso (bound now).
+  cl.D3DOMSetRenderTargets(set.color_count, set.color_count ? rtv : nullptr, FALSE, set.has_depth ? dsv : nullptr);
+  nv.verify_pending = true;
+  nv.verify_vs = q.vs_hash;
+  nv.verify_ps = q.ps_hash;
+  nv.verify_dc = q.dc;
+  nv.verify_cmask = q.cmask;
+  nv.verify_rt_bits = q.rt_bits;
+  nv.verify_stencil_ref = q.s.stencil_ref;
+  nv.verify_frame = nv.frame;
+  ++nv.verify_runs;
+}
+
+// After the replay loop: compare A and B, copy the counters to a free readback slot. Does not touch the CP's
+// pipeline trackers (the caller's restore / invalidate runs afterwards).
+static void NativeViewVerifyCompare(D3D12CommandProcessor& cp) {
+  NativeViewState& nv = g_native_view;
+  if (!nv.verify_pending) return;
+  nv.verify_pending = false;
+  NativeViewState::VerifyReadback* slot = nullptr;
+  for (auto& r : nv.verify_rb) {
+    if (!r.busy && r.buffer) {
+      slot = &r;
+      break;
+    }
+  }
+  if (!slot) {
+    ++nv.verify_skipped;
+    return;
+  }
+  const uint32_t w = uint32_t(nv.verify_a.desc.Width), h = nv.verify_a.desc.Height;
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!nv.verify_img.res || nv.verify_img.desc.Width != w || nv.verify_img.desc.Height != h) {
+    NativeViewRetire(cp, nv.verify_img);
+    D3D12_RESOURCE_DESC d = {};
+    d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    d.Width = w;
+    d.Height = h;
+    d.DepthOrArraySize = 1;
+    d.MipLevels = 1;
+    d.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    d.SampleDesc.Count = 1;
+    d.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                               provider.GetHeapFlagCreateNotZeroed(), &d,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&nv.verify_img.res)))) {
+      nv.verify_img = NvTarget();
+      ++nv.verify_skipped;
+      return;
+    }
+    nv.verify_img.desc = d;
+    nv.verify_img.state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    nv.verify_img.view_format = nv.verify_img.srv_format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair hd[4];
+  if (!cp.RequestOneUseSingleViewDescriptors(4, hd)) {
+    ++nv.verify_skipped;
+    return;
+  }
+  D3D12_SHADER_RESOURCE_VIEW_DESC s = {};
+  s.Format = nv.verify_a.srv_format;
+  s.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  s.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  s.Texture2D.MipLevels = 1;
+  device->CreateShaderResourceView(nv.verify_a.res.Get(), &s, hd[0].first);
+  device->CreateShaderResourceView(nv.verify_b.res.Get(), &s, hd[1].first);
+  D3D12_UNORDERED_ACCESS_VIEW_DESC u = {};
+  u.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  u.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  device->CreateUnorderedAccessView(nv.verify_img.res.Get(), nullptr, &u, hd[2].first);
+  ui::d3d12::util::CreateBufferRawUAV(device, hd[3].first, nv.verify_stats.Get(), 256);
+  NativeViewTransition(cp, nv.verify_a, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  NativeViewTransition(cp, nv.verify_b, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  NativeViewTransition(cp, nv.verify_img, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  if (nv.verify_stats_state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+    cp.PushTransitionBarrier(nv.verify_stats.Get(), nv.verify_stats_state, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    nv.verify_stats_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  }
+  cp.SubmitBarriers();
+  DeferredCommandList& cl = cp.GetDeferredCommandList();
+  cl.D3DSetComputeRootSignature(nv.diff_root_signature.Get());
+  const uint32_t k[4] = {w, h, NativeViewVerifySentinelBits(), 0u};
+  cl.D3DSetComputeRoot32BitConstants(0, 4, k, 0);
+  for (uint32_t i = 0; i < 4; ++i) cl.D3DSetComputeRootDescriptorTable(1 + i, hd[i].second);
+  cl.D3DSetPipelineState(nv.diff_clear_pso.Get());
+  cl.D3DDispatch(1, 1, 1);
+  cp.PushUAVBarrier(nv.verify_stats.Get());
+  cp.SubmitBarriers();
+  cl.D3DSetPipelineState(nv.verify_pso.Get());
+  cl.D3DDispatch((w + 7) / 8, (h + 7) / 8, 1);
+  cp.PushTransitionBarrier(nv.verify_stats.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                           D3D12_RESOURCE_STATE_COPY_SOURCE);
+  nv.verify_stats_state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  cp.SubmitBarriers();
+  cl.D3DCopyBufferRegion(slot->buffer.Get(), 0, nv.verify_stats.Get(), 0, 64);
+  slot->has_q = nv.verify_q_used;
+  if (nv.verify_q_used) {
+    cl.D3DResolveQueryData(nv.verify_qheap.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS, 0, 2, slot->buffer.Get(), 256);
+    nv.verify_q_used = false;
+  }
+  std::memcpy(slot->ext, nv.verify_ext, sizeof(slot->ext));
+  slot->submission = cp.GetCurrentSubmission();
+  slot->busy = true;
+  slot->vs = nv.verify_vs;
+  slot->dc = nv.verify_dc;
+  slot->cmask = nv.verify_cmask;
+  slot->rt_bits = nv.verify_rt_bits;
+  slot->stencil_ref = nv.verify_stencil_ref;
+  slot->ps = nv.verify_ps;
+}
+
+// Batched replay of the queued draws of one class: one native target bind, every draw with its complete
+// captured state, one restore of the emulated targets, then the CP binding trackers are invalidated (the command
+// list state is the last replayed draw's). Called at resolves (IssueCopy), before a submission ends, at swap and
+// when the bound emulated targets / sampler heap of the class change.
+static void NativeViewFlushSet(D3D12CommandProcessor& cp, D3D12RenderTargetCache& rtc, uint32_t cls,
+                               void (*prepare)(D3D12CommandProcessor*),
+                               void (*invalidate)(D3D12CommandProcessor*)) {
+  NativeViewState& nv = g_native_view;
+  NvSet& set = nv.set[cls];
+  if (set.queue.empty()) return;
+  if (set.frame != nv.frame || (set.has_depth && !set.depth.res)) {  // targets gone / stale: drop
+    set.queue.clear();
+    return;
+  }
+  const uint8_t nv_prev_timer = cp.GpuTimerSwitch(kNvGpuTimeCategory);
+  DeferredCommandList& cl = cp.GetDeferredCommandList();
+  D3D12_CPU_DESCRIPTOR_HANDLE rtv[4] = {};
+  bool barriers = false;
+  for (uint32_t i = 0; i < set.color_count; ++i) {
+    rtv[i] = nv.rtv_heap->GetCPUDescriptorHandleForHeapStart();
+    rtv[i].ptr += SIZE_T(cls * 4 + i) * nv.rtv_size;
+    barriers |= NativeViewTransition(cp, set.color[i], D3D12_RESOURCE_STATE_RENDER_TARGET);
+  }
+  D3D12_CPU_DESCRIPTOR_HANDLE dsv = {};
+  if (set.has_depth) {
+    dsv = nv.dsv_heap->GetCPUDescriptorHandleForHeapStart();
+    dsv.ptr += SIZE_T(cls) * nv.dsv_size;
+    barriers |= NativeViewTransition(cp, set.depth, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+  }
+  if (prepare) prepare(&cp);
+  cp.SubmitBarriers();
+  cl.D3DOMSetRenderTargets(set.color_count, set.color_count ? rtv : nullptr, FALSE, set.has_depth ? &dsv : nullptr);
+  // VIEW13 verify: choose this flush's draw (main, once per frame, the least verified pair the colour code took).
+  const NvQueued* verify_q = nullptr;
+  if (nv.verify && cls == kNvClassMain && nv.verify_frame != nv.frame && set.color_count &&
+      set.color[0].desc.SampleDesc.Count == 1 &&
+      (set.color[0].view_format == DXGI_FORMAT_R8G8B8A8_UNORM ||
+       set.color[0].view_format == DXGI_FORMAT_B8G8R8A8_UNORM) &&
+      (nv.verify_init_tried ? nv.verify_pso != nullptr : NativeViewVerifyInit(cp))) {
+    uint64_t best_runs = UINT64_MAX;
+    for (const NvQueued& q : set.queue) {
+      if (!q.override_pso || (!q.s.pso && !q.s.pso_handle)) continue;
+      auto it = nv.verify_pairs.find(q.vs_hash ^ (q.ps_hash * 0x9E3779B97F4A7C15ull));
+      const uint64_t runs = it == nv.verify_pairs.end() ? 0 : it->second.runs;
+      if (runs < best_runs) {
+        best_runs = runs;
+        verify_q = &q;
+        if (!runs) break;
+      }
+    }
+    // NATIVE15: rotate through the chosen pair's draws of this flush (its first draw is often off screen or fully
+    // covered, which left pairs such as 889D/8841/A2BB at 'nonempty 0' in every run).
+    if (verify_q && best_runs) {
+      uint32_t n = 0;
+      for (const NvQueued& q : set.queue) {
+        if (q.override_pso && (q.s.pso || q.s.pso_handle) && q.vs_hash == verify_q->vs_hash &&
+            q.ps_hash == verify_q->ps_hash) {
+          ++n;
+        }
+      }
+      if (n > 1) {
+        uint32_t pick = uint32_t(best_runs % n);
+        for (const NvQueued& q : set.queue) {
+          if (q.override_pso && (q.s.pso || q.s.pso_handle) && q.vs_hash == verify_q->vs_hash &&
+              q.ps_hash == verify_q->ps_hash && !pick--) {
+            verify_q = &q;
+            break;
+          }
+        }
+      }
+    }
+  }
+  // Emit only what changes between consecutive replayed draws.
+  const NvSnap* last = nullptr;
+  ID3D12PipelineState* last_override = nullptr;
+  bool bound_no_color = false;
+  for (const NvQueued& q : set.queue) {
+    if (q.no_color != bound_no_color && set.has_depth) {
+      if (q.no_color) {
+        cl.D3DOMSetRenderTargets(0, nullptr, FALSE, &dsv);
+      } else {
+        cl.D3DOMSetRenderTargets(set.color_count, set.color_count ? rtv : nullptr, FALSE, &dsv);
+      }
+      bound_no_color = q.no_color;
+    }
+    if (q.no_color && !set.has_depth) continue;
+    const NvSnap& s = q.s;
+    const bool rs_changed = !last || last->rs != s.rs;
+    if (rs_changed) cl.D3DSetGraphicsRootSignature(s.rs);
+    for (uint32_t i = 0; i < s.root_count; ++i) {
+      if (!rs_changed && last->root_count == s.root_count && last->root_index[i] == s.root_index[i] &&
+          last->root_value[i] == s.root_value[i]) {
+        continue;
+      }
+      if (s.root_table[i]) {
+        D3D12_GPU_DESCRIPTOR_HANDLE h;
+        h.ptr = s.root_value[i];
+        cl.D3DSetGraphicsRootDescriptorTable(s.root_index[i], h);
+      } else {
+        cl.D3DSetGraphicsRootConstantBufferView(s.root_index[i], D3D12_GPU_VIRTUAL_ADDRESS(s.root_value[i]));
+      }
+    }
+    if (!last || q.override_pso != last_override || last->pso != s.pso || last->pso_handle != s.pso_handle) {
+      if (q.override_pso) {
+        cl.D3DSetPipelineState(q.override_pso);
+      } else if (s.pso) {
+        cl.D3DSetPipelineState(s.pso);
+      } else {
+        cl.SetPipelineStateHandle(s.pso_handle);
+      }
+    }
+    if (s.indexed && (!last || !last->indexed || std::memcmp(&last->ibv, &s.ibv, sizeof(s.ibv)))) {
+      cl.D3DIASetIndexBuffer(&s.ibv);
+    }
+    if (!last || last->topo != s.topo) cl.D3DIASetPrimitiveTopology(s.topo);
+    if (!last || std::memcmp(&last->vp, &s.vp, sizeof(s.vp))) cl.RSSetViewport(s.vp);
+    if (!last || std::memcmp(&last->sc, &s.sc, sizeof(s.sc))) cl.RSSetScissorRect(s.sc);
+    if (!last || last->stencil_ref != s.stencil_ref) cl.D3DOMSetStencilRef(s.stencil_ref);
+    if (!last || std::memcmp(last->blend, s.blend, sizeof(s.blend))) cl.D3DOMSetBlendFactor(s.blend);
+    if (&q == verify_q) NativeViewVerifyTwin(cp, set, q, rtv, set.has_depth ? &dsv : nullptr);
+    if (s.indexed) {
+      cl.D3DDrawIndexedInstanced(q.vertex_count, 1, q.start_index, 0, 0);
+    } else {
+      cl.D3DDrawInstanced(q.vertex_count, 1, 0, 0);
+    }
+    last = &s;
+    last_override = q.override_pso;
+  }
+  NativeViewVerifyCompare(cp);
+  ++nv.flushes;
+  set.replayed_frame = nv.frame;
+  if (cls == kNvClassPrepass && !nv.mutation_flush) nv.prepass_done_frame = nv.frame;
+  nv.flushed_draws += set.queue.size();
+  nv.reissued[cls] += set.queue.size();
+  set.queue.clear();
+  rtc.NativeViewRestoreRenderTargets();
+  if (invalidate) invalidate(&cp);
+  cp.GpuTimerSwitch(nv_prev_timer);
+}
+
+static bool NativeViewPending() { return g_native_view.pending; }
+
+static void NativeViewFlushAll(D3D12CommandProcessor& cp, D3D12RenderTargetCache& rtc,
+                               void (*prepare)(D3D12CommandProcessor*),
+                               void (*invalidate)(D3D12CommandProcessor*)) {
+  NativeViewState& nv = g_native_view;
+  if (!nv.pending) return;
+  nv.pending = false;
+  NativeViewFlushSet(cp, rtc, kNvClassPrepass, prepare, invalidate);
+  NvSet& main = nv.set[kNvClassMain];
+  const bool main_queued = !main.queue.empty();
+  NativeViewFlushSet(cp, rtc, kNvClassMain, prepare, invalidate);
+  // A mutation flush may have emptied the pre-pass queue earlier: the pre-pass still counts as replayed.
+  if (nv.set[kNvClassPrepass].replayed_frame == nv.frame) nv.prepass_done_frame = nv.frame;
+  g_native_view_queued = false;
+  NativeViewClearPages();
+  if (nv.depthdiff == 2 && main_queued && main.has_depth && main.queue_bound[0] &&
+      rtc.NativeViewBoundResource(0) == main.queue_bound[0]) {
+    NativeViewDepthDiff(cp, main, main.queue_bound[0]);
+  }
+}
+
+// VIEW13 (codex27 P0): something a queued draw reads is about to be rewritten (shared memory upload over pages
+// read this native frame, texture reload, render target ownership transfer, sampler heap switch). Replays the
+// queues now and re-emits the CP's tracked state (mid-draw safe). Pre-pass completion is not signalled by it.
+void NativeViewFlushBeforeMutation(uint32_t reason) {
+  NativeViewState& nv = g_native_view;
+  g_native_view_queued = false;
+  if (!nv.mut_cp || !nv.mut_rtc || !nv.mut_restore) return;
+  if (nv.set[kNvClassPrepass].queue.empty() && nv.set[kNvClassMain].queue.empty()) return;
+  ++nv.mut_flushes[std::min<uint32_t>(reason, kNvMutCount - 1)];
+  nv.mutation_flush = true;
+  NativeViewFlushSet(*nv.mut_cp, *nv.mut_rtc, kNvClassPrepass, nv.mut_prepare, nv.mut_restore);
+  NativeViewFlushSet(*nv.mut_cp, *nv.mut_rtc, kNvClassMain, nv.mut_prepare, nv.mut_restore);
+  nv.mutation_flush = false;
+}
+
+static void NativeViewNoteNotNative(const NativeViewDrawCtx& ctx, uint32_t reason_bit) {
+  NativeViewState& nv = g_native_view;
+  ++nv.zfunc_not[ctx.depth_control.z_enable ? (uint32_t(ctx.depth_control.zfunc) & 7u) : 8u];
+  const uint64_t key = ctx.vs_ucode_hash ^ (ctx.ps_ucode_hash * 0x9E3779B97F4A7C15ull);
+  auto it = nv.not_native_pairs.find(key);
+  if (it == nv.not_native_pairs.end()) {
+    if (nv.not_native_pairs.size() >= 4096) return;
+    it = nv.not_native_pairs.emplace(key, NvPairStat()).first;
+    it->second.vs = ctx.vs_ucode_hash;
+    it->second.ps = ctx.ps_ucode_hash;
+  }
+  NvPairStat& p = it->second;
+  ++p.count;
+  p.reasons |= reason_bit;
+  p.depth_control = ctx.depth_control.value;
+  if (ctx.depth_control.z_enable) ++p.z_on;
+}
+
+// The tap: called right after the emulated draw was recorded (ctx carries the emulated draw).
+// Default policy (v12h): split / native modes tap only the main colour pass and draw only what the native colour
+// code (native_view_color.inc) handles; depth modes tap only the pre-pass and replay only the city depth family.
+// dist\native_view_reissue_all: also plain re-issue every other draw of the tapped class (v12a-f behaviour).
+static void NativeViewTap(D3D12RenderTargetCache& rtc, NativeViewDrawCtx& ctx, bool fast_path) {
+  NativeViewState& nv = g_native_view;
+  D3D12CommandProcessor& cp = *ctx.cp;
+  const uint32_t cls = NativeViewClassify(*ctx.regs);
+  if (cls == kNvClassNone) {
+    ++nv.skips[kNvSkipNoClass];
+    return;
+  }
+  const bool depth_mode = nv.mode == 3 || nv.mode == 4;
+  // Depth modes show the pre-pass only; colour modes draw the pre-pass too (it seeds the main depth) unless
+  // the main depth is seeded from the emulated one.
+  if (cls == kNvClassMain ? depth_mode : (!depth_mode && nv.main_seed != 2)) {
+    ++nv.skips[kNvSkipOtherMode];
+    return;
+  }
+  NvSet& set = nv.set[cls];
+  if (fast_path) {
+    // The fast path only runs with the render targets of the previous full-path draw unchanged.
+    ctx.rt_bits = set.last_bits;
+    std::memcpy(ctx.rt_formats, set.last_formats, sizeof(ctx.rt_formats));
+  } else {
+    set.last_bits = ctx.rt_bits;
+    std::memcpy(set.last_formats, ctx.rt_formats, sizeof(set.last_formats));
+  }
+  // Which draws this class replays. Main: the colour code decides (called below); without reissue_all, draws
+  // it does not take are skipped before any target switch only when they cannot be taken at all (no colour).
+  // Pre-pass: depth modes replay only the city depth family; colour modes replay the whole pre-pass (the main
+  // pass depth-tests against it) unless dist native_view_prepass_family.
+  if (cls == kNvClassPrepass && !nv.reissue_all && !ctx.native_shader && (depth_mode || nv.prepass_family_only)) {
+    ++nv.skips[kNvSkipNotNative];
+    return;
+  }
+  if (cls == kNvClassMain && !nv.reissue_all && !ctx.color_mask && set.frame == nv.frame && !nv.main_depthonly) {
+    ++nv.skips[kNvSkipNotNative];
+    NativeViewNoteNotNative(ctx, 1);
+    return;
+  }
+  ++nv.tapped[cls];
+  if (fast_path) ++nv.fast_path;
+  if (!nv.init_tried) {
+    nv.init_tried = true;
+    nv.init_ok = NativeViewInitialize(cp);
+  }
+  if (!nv.init_ok) {
+    ++nv.skips[kNvSkipCreate];
+    return;
+  }
+  // Native targets: formats / samples of the bound emulated ones, size = the class's active extent.
+  ID3D12Resource* bound[1 + 4] = {};
+  for (uint32_t i = 0; i < 1 + 4; ++i) bound[i] = rtc.NativeViewBoundResource(i);
+  const bool want_depth = (ctx.rt_bits & 1u) != 0;
+  uint32_t color_count = 0;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (ctx.rt_bits & (2u << i)) {
+      if (color_count != i) {
+        ++nv.skips[kNvSkipGap];
+        return;
+      }
+      color_count = i + 1;
+    }
+  }
+  if ((want_depth && !bound[0]) || !(want_depth || color_count)) {
+    ++nv.skips[kNvSkipRtInvalid];
+    return;
+  }
+  for (uint32_t i = 0; i < color_count; ++i) {
+    if (!bound[1 + i]) {
+      ++nv.skips[kNvSkipRtInvalid];
+      return;
+    }
+  }
+  // codex27 P1: replay what is queued for the old targets BEFORE they can be recreated / re-cleared below.
+  if (nv.batch && ctx.snap_valid && !set.queue.empty() &&
+      (std::memcmp(set.queue_bound, bound, sizeof(bound)) || set.queue_bits != ctx.rt_bits ||
+       set.queue_sampler_heap != ctx.snap.sampler_heap)) {
+    ++nv.early_flushes;
+    NativeViewFlushSet(cp, rtc, cls, ctx.prepare, ctx.invalidate);
+  }
+  const uint32_t ext_w = (cls == kNvClassMain ? 1280u : 640u) * std::max<uint32_t>(1, ctx.scale_x);
+  const uint32_t ext_h = (cls == kNvClassMain ? 720u : 384u) * std::max<uint32_t>(1, ctx.scale_y);
+  D3D12_CPU_DESCRIPTOR_HANDLE rtv[4], dsv;
+  for (uint32_t i = 0; i < 4; ++i) {
+    rtv[i] = nv.rtv_heap->GetCPUDescriptorHandleForHeapStart();
+    rtv[i].ptr += SIZE_T(cls * 4 + i) * nv.rtv_size;
+  }
+  dsv = nv.dsv_heap->GetCPUDescriptorHandleForHeapStart();
+  dsv.ptr += SIZE_T(cls) * nv.dsv_size;
+  bool recreated = false;
+  const auto depth_format = xenos::DepthRenderTargetFormat(ctx.rt_formats[0]);
+  if (want_depth &&
+      !NativeViewEnsureTarget(cp, set.depth, bound[0], true, D3D12RenderTargetCache::GetDepthDSVDXGIFormat(depth_format),
+                              D3D12RenderTargetCache::GetDepthSRVDepthDXGIFormat(depth_format), dsv, ext_w, ext_h,
+                              &recreated)) {
+    ++nv.skips[kNvSkipCreate];
+    return;
+  }
+  for (uint32_t i = 0; i < color_count; ++i) {
+    const DXGI_FORMAT f = rtc.GetColorDrawDXGIFormat(xenos::ColorRenderTargetFormat(ctx.rt_formats[1 + i]));
+    if (!NativeViewEnsureTarget(cp, set.color[i], bound[1 + i], false, f, f, rtv[i], ext_w, ext_h, &recreated)) {
+      ++nv.skips[kNvSkipCreate];
+      return;
+    }
+  }
+  if (recreated) set.frame = UINT64_MAX;  // fresh resources: clear / seed again
+  set.color_count = color_count;
+  set.has_depth = want_depth;
+  DeferredCommandList& cl = cp.GetDeferredCommandList();
+  const NvTarget& any = color_count ? set.color[0] : set.depth;
+  const uint32_t tw = uint32_t(any.desc.Width), th = any.desc.Height;
+  // First draw of the class this frame: clear colour (dark blue) and depth (pre-pass: 0 = far, reversed Z as the
+  // game clears it; main: seeded from the emulated depth below, this draw is then not replayed).
+  bool seed_depth = false;
+  bool barriers = false;
+  if (set.frame != nv.frame) {
+    set.frame = nv.frame;
+    set.content_w = std::min(tw, ext_w);
+    set.content_h = std::min(th, ext_h);
+    for (uint32_t i = 0; i < color_count; ++i) {
+      barriers |= NativeViewTransition(cp, set.color[i], D3D12_RESOURCE_STATE_RENDER_TARGET);
+    }
+    if (want_depth) {
+      barriers |= NativeViewTransition(cp, set.depth, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+      seed_depth = cls == kNvClassMain && nv.main_seed != 0 && set.depth.desc.SampleDesc.Count == 1 &&
+                   NativeViewSeedInit(cp);
+    }
+    if (barriers) cp.SubmitBarriers();
+    barriers = false;
+    static const float kClear[4] = {0.02f, 0.03f, 0.10f, 1.0f};
+    for (uint32_t i = 0; i < color_count; ++i) cl.D3DClearRenderTargetView(rtv[i], kClear, 0, nullptr);
+    if (want_depth) {
+      cl.D3DClearDepthStencilView(dsv, D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL,
+                                  (cls == kNvClassPrepass || nv.main_seed == 0) ? 0.0f : 1.0f, 0, 0, nullptr);
+    }
+  }
+  // The first main-class draws of a frame can come before the pre-pass: seed again from our pre-pass once it
+  // has been replayed (its resolve flushed it).
+  if (!seed_depth && cls == kNvClassMain && want_depth && nv.main_seed == 2 && set.seed_native_frame != nv.frame &&
+      nv.prepass_done_frame == nv.frame && set.depth.desc.SampleDesc.Count == 1 && NativeViewSeedInit(cp)) {
+    NativeViewFlushSet(cp, rtc, kNvClassMain, ctx.prepare, ctx.invalidate);  // keep the draw order
+    seed_depth = true;
+  }
+  if (seed_depth) {
+    // Source: our native pre-pass depth of this frame (flushed first), else the emulated main depth.
+    NvSet& pre = nv.set[kNvClassPrepass];
+    if (!nv.seed_emulated) NativeViewFlushSet(cp, rtc, kNvClassPrepass, ctx.prepare, ctx.invalidate);
+    const bool from_prepass = !nv.seed_emulated && pre.frame == nv.frame && pre.has_depth && pre.depth.res &&
+                              pre.depth.desc.SampleDesc.Count == 4 && pre.depth.srv_format == set.depth.srv_format;
+    ID3D12PipelineState* seed_pso = NativeViewSeedPipeline(cp, set.depth.view_format, from_prepass);
+    ui::d3d12::util::DescriptorCpuGpuHandlePair h;
+    if (seed_pso && cp.RequestOneUseSingleViewDescriptors(1, &h)) {
+      D3D12_SHADER_RESOURCE_VIEW_DESC s = {};
+      s.Format = set.depth.srv_format;
+      s.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+      if (from_prepass) {
+        s.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DMS;
+        cp.GetD3D12Provider().GetDevice()->CreateShaderResourceView(pre.depth.res.Get(), &s, h.first);
+        NativeViewTransition(cp, pre.depth, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        ++nv.seed_native;
+        set.seed_native_frame = nv.frame;
+      } else {
+        s.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        s.Texture2D.MipLevels = 1;
+        cp.GetD3D12Provider().GetDevice()->CreateShaderResourceView(bound[0], &s, h.first);
+        cp.PushTransitionBarrier(bound[0], D3D12_RESOURCE_STATE_DEPTH_WRITE,
+                                 D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+      }
+      cp.SubmitBarriers();
+      cl.D3DOMSetRenderTargets(0, nullptr, FALSE, &dsv);
+      cp.SetExternalGraphicsRootSignature(nv.seed_root_signature.Get());
+      cl.D3DSetGraphicsRootDescriptorTable(0, h.second);
+      const uint32_t seed_k[8] = {std::max<uint32_t>(1, ctx.scale_x), std::max<uint32_t>(1, ctx.scale_y),
+                                  nv.seed_rows, from_prepass ? pre.depth.desc.Height : 0u,
+                                  ((nv.seed_f32 || xenos::DepthRenderTargetFormat(ctx.rt_formats[0]) !=
+                                                        xenos::DepthRenderTargetFormat::kD24FS8)
+                                       ? 0u
+                                       : 1u) |
+                                      (nv.seed_swap12 ? 2u : 0u),
+                                  0u, 0u, 0u};
+      cl.D3DSetGraphicsRoot32BitConstants(1, 8, seed_k, 0);
+      cp.SetExternalPipeline(seed_pso);
+      cp.SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+      D3D12_VIEWPORT vp = {0.0f, 0.0f, float(set.content_w), float(set.content_h), 0.0f, 1.0f};
+      D3D12_RECT sc = {0, 0, LONG(set.content_w), LONG(set.content_h)};
+      cp.SetViewport(vp);
+      cp.SetScissorRect(sc);
+      const uint8_t nv_seed_prev_timer = cp.GpuTimerSwitch(kNvGpuTimeCategory);
+      cl.D3DDrawInstanced(3, 1, 0, 0);
+      cp.GpuTimerSwitch(nv_seed_prev_timer);
+      cp.SetViewport(ctx.viewport);
+      cp.SetScissorRect(ctx.scissor);
+      cp.SetPrimitiveTopology(ctx.topology);
+      if (!from_prepass) {
+        cp.PushTransitionBarrier(bound[0], D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+                                 D3D12_RESOURCE_STATE_DEPTH_WRITE);
+      }
+      ++nv.depth_seeded;
+      if (nv.depthdiff == 1 && bound[0] && (from_prepass || nv.seed_emulated)) NativeViewDepthDiff(cp, set, bound[0]);
+      rtc.NativeViewRestoreRenderTargets();
+      if (!(nv.batch && ctx.snap_valid)) {
+        // Per-draw replay: the emulated root signature / arguments of this draw are gone, so it is not replayed
+        // (the next emulated draw rebinds everything because the root signature changed).
+        ++nv.skips[kNvSkipSeedDraw];
+        return;
+      }
+    } else {
+      ++nv.skips[kNvSkipCreate];
+    }
+  }
+  if (nv.batch && ctx.snap_valid) {
+    // Batched: decide the pipeline now (no recording), queue the draw with its captured state.
+    if (!set.queue.empty() && (std::memcmp(set.queue_bound, bound, sizeof(bound)) || set.queue_bits != ctx.rt_bits ||
+                               set.queue_sampler_heap != ctx.snap.sampler_heap)) {
+      NativeViewFlushSet(cp, rtc, cls, ctx.prepare, ctx.invalidate);
+    }
+    ID3D12PipelineState* override_pso = nullptr;
+    if (cls == kNvClassMain && ctx.color_mask && color_count && !nv.nodraw) {
+      override_pso = NativeViewColorPipeline(ctx);
+      if (override_pso) {
+        ++nv.color_hook;
+        ++nv.zfunc_taken[ctx.depth_control.z_enable ? (uint32_t(ctx.depth_control.zfunc) & 7u) : 8u];
+      }
+    }
+    const bool nv_clear_quad = cls == kNvClassMain && nv.main_clear && ctx.vs_ucode_hash == 0x0A6D1DD7767FDF27ull;
+    const bool nv_depth_only = cls == kNvClassMain && nv.main_depthonly && !ctx.color_mask;
+    const bool replay = cls == kNvClassPrepass || nv.reissue_all || (!override_pso && (nv_clear_quad || nv_depth_only));
+    if (!override_pso && replay && cls == kNvClassMain) {
+      if (nv_clear_quad) {
+        ++nv.reissued_clear;
+      } else {
+        ++nv.reissued_depthonly;
+      }
+    }
+    if (nv.nodraw || (!override_pso && !replay)) {
+      ++nv.skips[kNvSkipNotNative];
+      if (cls == kNvClassMain && !nv.nodraw) NativeViewNoteNotNative(ctx, ctx.color_mask ? 2u : 1u);
+      return;
+    }
+    if (set.queue.empty()) {
+      std::memcpy(set.queue_bound, bound, sizeof(bound));
+      set.queue_bits = ctx.rt_bits;
+      set.queue_sampler_heap = ctx.snap.sampler_heap;
+      set.queue.reserve(2048);
+    }
+    NvQueued q;
+    q.s = ctx.snap;
+    q.override_pso = override_pso;
+    q.vertex_count = ctx.vertex_count;
+    q.start_index = ctx.start_index;
+    q.vs_hash = ctx.vs_ucode_hash;
+    q.ps_hash = ctx.ps_ucode_hash;
+    q.no_color = !override_pso && nv_clear_quad && ctx.color_mask != 0;
+    q.dc = ctx.depth_control.value;
+    q.cmask = ctx.color_mask;
+    q.rt_bits = ctx.rt_bits;
+    if (nv.verify && ctx.regs) {
+      const RegisterFile& vr = *ctx.regs;
+      q.bc0 = uint32_t(vr[reg::RB_BLENDCONTROL::rt_register_indices[0]]);
+      q.colctl = uint32_t(vr[XE_GPU_REG_RB_COLORCONTROL]);
+      q.srm = uint32_t(vr[XE_GPU_REG_RB_STENCILREFMASK]);
+      q.srm_bf = uint32_t(vr[XE_GPU_REG_RB_STENCILREFMASK_BF]);
+    }
+    set.queue.push_back(q);
+    nv.pending = true;
+    if (ctx.restore) {  // mutation flushes possible (VIEW13)
+      nv.mut_cp = &cp;
+      nv.mut_rtc = &rtc;
+      nv.mut_prepare = ctx.prepare;
+      nv.mut_restore = ctx.restore;
+      g_native_view_queued = true;
+    }
+    return;
+  }
+  // Same state every time (the composite of the previous frame left them as shader resources).
+  for (uint32_t i = 0; i < color_count; ++i) {
+    barriers |= NativeViewTransition(cp, set.color[i], D3D12_RESOURCE_STATE_RENDER_TARGET);
+  }
+  if (want_depth) barriers |= NativeViewTransition(cp, set.depth, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+  if (barriers) cp.SubmitBarriers();
+  ctx.cl = &cl;
+  ctx.draw_class = cls;
+  ctx.color_count = color_count;
+  for (uint32_t i = 0; i < color_count; ++i) {
+    ctx.color_rtv[i] = rtv[i];
+    ctx.color_format[i] = set.color[i].view_format;
+    ctx.color_resource[i] = set.color[i].res.Get();
+  }
+  ctx.has_depth = want_depth;
+  ctx.depth_dsv = dsv;
+  ctx.depth_format = want_depth ? set.depth.view_format : DXGI_FORMAT_UNKNOWN;
+  ctx.depth_resource = want_depth ? set.depth.res.Get() : nullptr;
+  ctx.width = tw;
+  ctx.height = th;
+  ctx.samples = any.desc.SampleDesc.Count;
+  cl.D3DOMSetRenderTargets(color_count, color_count ? rtv : nullptr, FALSE, want_depth ? &dsv : nullptr);
+  bool drawn = false;
+  if (cls == kNvClassMain && ctx.color_mask && color_count && !nv.nodraw) {
+    drawn = NativeViewColorDraw(ctx);
+    if (drawn) ++nv.color_hook;
+  }
+  const bool replay = cls == kNvClassPrepass || nv.reissue_all ||
+                      (cls == kNvClassMain && ((nv.main_clear && ctx.vs_ucode_hash == 0x0A6D1DD7767FDF27ull) ||
+                                               (nv.main_depthonly && !ctx.color_mask)));
+  if (!drawn && replay && !nv.nodraw) {
+    if (ctx.indexed) {
+      cl.D3DDrawIndexedInstanced(ctx.vertex_count, 1, ctx.start_index, 0, 0);
+    } else {
+      cl.D3DDrawInstanced(ctx.vertex_count, 1, 0, 0);
+    }
+    ++nv.reissued[cls];
+  } else if (!drawn) {
+    ++nv.skips[kNvSkipNotNative];
+  }
+  // Back to the emulated render targets (the RT cache believes they are still bound; the native fast path
+  // draws without an RT cache update).
+  rtc.NativeViewRestoreRenderTargets();
+}
+
+// Presenter callback (RefreshGuestOutput), after the emulated frame is final in guest_output.
+static void NativeViewCompose(D3D12CommandProcessor& cp, ID3D12Resource* guest_output, uint32_t width,
+                              uint32_t height) {
+  NativeViewState& nv = g_native_view;
+  if (!nv.active || !guest_output || !width || !height || !nv.init_ok) return;
+  const bool want_depth = nv.mode == 3 || nv.mode == 4;
+  // NativeViewOnSwap (start of IssueSwap) already advanced nv.frame: the frame being presented is nv.frame - 1.
+  const uint64_t shown = nv.shown_native;
+  NvTarget* src = nullptr;
+  uint32_t cw = 0, ch = 0;
+  if (want_depth) {
+    for (uint32_t c : {uint32_t(kNvClassPrepass), uint32_t(kNvClassMain)}) {
+      NvSet& s = nv.set[c];
+      if (s.frame == shown && s.has_depth && s.depth.res) {
+        src = &s.depth;
+        cw = s.content_w;
+        ch = s.content_h;
+        break;
+      }
+    }
+  } else if (nv.depthdiff && nv.diff_frame == shown && nv.diff_img.res) {
+    src = &nv.diff_img;
+    cw = uint32_t(nv.diff_img.desc.Width);
+    ch = nv.diff_img.desc.Height;
+  } else {
+    NvSet& s = nv.set[kNvClassMain];
+    if (s.frame == shown && s.color_count && s.color[0].res && s.color[0].desc.SampleDesc.Count == 1) {
+      src = &s.color[0];
+      cw = s.content_w;
+      ch = s.content_h;
+    }
+  }
+  if (!src) {
+    ++nv.compose_no_source;
+    return;
+  }
+  cw = std::min<uint32_t>(cw ? cw : uint32_t(src->desc.Width), uint32_t(src->desc.Width));
+  ch = std::min<uint32_t>(ch ? ch : src->desc.Height, src->desc.Height);
+  ui::d3d12::util::DescriptorCpuGpuHandlePair h[2];
+  if (!cp.RequestOneUseSingleViewDescriptors(2, h)) {
+    ++nv.compose_no_descriptors;
+    return;
+  }
+  ID3D12Device* device = cp.GetD3D12Provider().GetDevice();
+  D3D12_UNORDERED_ACCESS_VIEW_DESC u = {};
+  u.Format = ui::d3d12::D3D12Presenter::kGuestOutputFormat;
+  u.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  device->CreateUnorderedAccessView(guest_output, nullptr, &u, h[0].first);
+  const bool ms = src->desc.SampleDesc.Count > 1;
+  D3D12_SHADER_RESOURCE_VIEW_DESC s = {};
+  s.Format = src->srv_format;
+  s.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  if (ms) {
+    s.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DMS;
+  } else {
+    s.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    s.Texture2D.MipLevels = 1;
+  }
+  device->CreateShaderResourceView(src->res.Get(), &s, h[1].first);
+  NativeViewTransition(cp, *src, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  const D3D12_RESOURCE_STATES out_state = ui::d3d12::D3D12Presenter::kGuestOutputInternalState;
+  cp.PushTransitionBarrier(guest_output, out_state, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  struct {
+    uint32_t out_size[2], src_size[2], mode, split_x;
+    float depth_pow;
+    uint32_t flags;
+  } k = {{width, height}, {cw, ch}, nv.mode, width / 2, nv.depth_pow, 0};
+  DeferredCommandList& cl = cp.GetDeferredCommandList();
+  cl.D3DSetComputeRootSignature(nv.root_signature.Get());
+  cl.D3DSetComputeRoot32BitConstants(0, 8, &k, 0);
+  cl.D3DSetComputeRootDescriptorTable(1, h[0].second);
+  cl.D3DSetComputeRootDescriptorTable(2, h[1].second);
+  cp.SetExternalPipeline(!want_depth ? nv.pso_color.Get() : ms ? nv.pso_depth_ms.Get() : nv.pso_depth.Get());
+  cp.SubmitBarriers();
+  const uint8_t nv_prev_timer = cp.GpuTimerSwitch(kNvGpuTimeCategory);
+  cl.D3DDispatch((width + 7) / 8, (height + 7) / 8, 1);
+  cp.GpuTimerSwitch(nv_prev_timer);
+  cp.PushTransitionBarrier(guest_output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, out_state);
+  ++nv.composed;
+}
+
+// ======================= Slack probe (diagnostic, default off) =======================
+// Measures how much frame time a CPU saving on the command processor thread or on the replay thread would buy:
+// adds a known busy spin there, so an A/B (off vs probe) gives the FPS slope of that thread directly.
+// Empty dist files (read once at start): cp_burn_<n>  = n ns per IssueDraw on the CP thread (n = 100 200 400 800 1600),
+//                                         replay_burn_<n> = n us per replay job on the replay thread (n = 50 100 200 400 800).
+// Missing files = off: one load of a static per draw / per replay job.
+struct NvSlackProbe {
+  uint32_t cp_ns = 0;
+  uint32_t replay_us = 0;
+};
+static const NvSlackProbe& NvSlackProbeConfig() {
+  static const NvSlackProbe cfg = [] {
+    NvSlackProbe c;
+    static const uint32_t kCpNs[] = {100, 200, 400, 800, 1600};
+    static const uint32_t kReplayUs[] = {50, 100, 200, 400, 800};
+    char name[32];
+    for (uint32_t v : kCpNs) {
+      std::snprintf(name, sizeof(name), "cp_burn_%u", v);
+      if (Perf5FileExists(name)) c.cp_ns = v;
+    }
+    for (uint32_t v : kReplayUs) {
+      std::snprintf(name, sizeof(name), "replay_burn_%u", v);
+      if (Perf5FileExists(name)) c.replay_us = v;
+    }
+    if (c.cp_ns || c.replay_us) {
+      REXLOG_INFO("SLACK PROBE (NATIVE17): CP thread +{} ns per draw, replay thread +{} us per job", c.cp_ns,
+                  c.replay_us);
+    }
+    return c;
+  }();
+  return cfg;
+}
+static void NvSlackSpin(uint64_t ns) {
+  const auto t0 = std::chrono::steady_clock::now();
+  while (uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0)
+                      .count()) < ns) {
+    _mm_pause();
+  }
+}
+static inline void NvSlackProbeDraw() {
+  if (const uint32_t ns = NvSlackProbeConfig().cp_ns) NvSlackSpin(ns);
+}
+static void NvSlackProbeReplayJob() {
+  if (const uint32_t us = NvSlackProbeConfig().replay_us) NvSlackSpin(uint64_t(us) * 1000);
+}
