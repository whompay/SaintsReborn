+// Finds the EOS DLL and eos.ini (nothing is loaded yet).
+std::string g_dll_path, g_ini_path;
+bool FindSdk() {
+  const std::string dir = ExeDir();
+  if (FILE* f = std::fopen((dir + "lan_mode.txt").c_str(), "rb")) {
+    char m[16] = {};
+    std::fread(m, 1, sizeof(m) - 1, f);
+    std::fclose(f);
+    if (_strnicmp(m, "lan", 3) == 0) { REXSYS_INFO("EOS LAN: off (lan_mode.txt = lan)"); return false; }
+  }
+  // Co-op's copy is shared when present (one EOS in the process); mods\ is
+  // where co-op lived before it was built in.
+  const std::string candidates[][2] = {
+      {dir + "core\\WhompaysCoop\\eos\\EOSSDK-Win64-Shipping.dll", dir + "core\\WhompaysCoop\\eos.ini"},
+      {dir + "mods\\WhompaysCoop\\eos\\EOSSDK-Win64-Shipping.dll", dir + "mods\\WhompaysCoop\\eos.ini"},
+      {dir + "eos\\EOSSDK-Win64-Shipping.dll", dir + "eos.ini"}};
+  for (const auto& c : candidates) {
+    if (GetFileAttributesA(c[0].c_str()) == INVALID_FILE_ATTRIBUTES) continue;
+    g_dll_path = c[0];
+    g_ini_path = c[1];
+    return true;
+  }
+  REXSYS_INFO("EOS LAN: no EOS SDK DLL found, System Link uses the real LAN");
+  return false;
+}
