+// Writes XUSER_STATS_READ_RESULTS for specs at guest address base (host data,
+// size bytes). Views come back in spec order; rows that don't fit are dropped.
+void FillStats(uint32_t base, uint8_t* data, uint32_t size, const std::vector<StatsSpec>& specs,
+               const std::vector<StatsView>& answer, uint32_t max_rows) {
+  const uint32_t nviews = uint32_t(specs.size());
+  if (size < 8 + 16 * nviews) return;
+  std::memset(data, 0, size);
+  memory::store_and_swap<uint32_t>(data + 0, nviews);
+  memory::store_and_swap<uint32_t>(data + 4, nviews ? base + 8 : 0);
+  uint32_t free_at = 8 + 16 * nviews;
+  for (uint32_t i = 0; i < nviews; ++i) {
+    const StatsSpec& spec = specs[i];
+    uint8_t* v = data + 8 + i * 16;
+    memory::store_and_swap<uint32_t>(v + 0, spec.view);
+    const StatsView* found = nullptr;
+    for (const auto& a : answer)
+      if (a.view == spec.view) { found = &a; break; }
+    if (!found) continue;
+    memory::store_and_swap<uint32_t>(v + 4, found->total);
+    const uint32_t ncols = uint32_t(spec.columns.size());
+    const bool has_name = std::find(spec.columns.begin(), spec.columns.end(), kColGamertag) != spec.columns.end();
+    const uint32_t per_row = 48 + 24 * ncols + (has_name ? 32 : 0);
+    uint32_t n = std::min<uint32_t>(uint32_t(found->rows.size()), max_rows);
+    if (free_at + uint64_t(n) * per_row > size) n = (size - free_at) / per_row;
+    const uint32_t rows_at = free_at;
+    uint32_t cols_at = rows_at + 48 * n;
+    uint32_t text_at = cols_at + 24 * ncols * n;
+    memory::store_and_swap<uint32_t>(v + 8, n);
+    memory::store_and_swap<uint32_t>(v + 12, n ? base + rows_at : 0);
+    for (uint32_t r = 0; r < n; ++r) {
+      const StatsRow& src = found->rows[r];
+      uint8_t* row = data + rows_at + r * 48;
+      memory::store_and_swap<uint64_t>(row + 0, src.xuid);
+      memory::store_and_swap<uint32_t>(row + 8, src.rank);
+      memory::store_and_swap<uint64_t>(row + 16, uint64_t(src.rating));
+      std::memcpy(row + 24, src.name.data(), std::min<size_t>(src.name.size(), 15));
+      memory::store_and_swap<uint32_t>(row + 40, ncols);
+      memory::store_and_swap<uint32_t>(row + 44, ncols ? base + cols_at : 0);
+      for (uint32_t c = 0; c < ncols; ++c) {
+        uint8_t* col = data + cols_at + c * 24;
+        const uint16_t id = spec.columns[c];
+        memory::store_and_swap<uint16_t>(col + 0, id);
+        if (id == kColGamertag) {
+          const std::string& nm = src.name;
+          const uint32_t chars = uint32_t(std::min<size_t>(nm.size(), 15));
+          for (uint32_t k = 0; k < chars; ++k)
+            memory::store_and_swap<uint16_t>(data + text_at + k * 2, uint16_t(uint8_t(nm[k])));
+          col[8] = kDataUnicode;
+          memory::store_and_swap<uint32_t>(col + 16, (chars + 1) * 2);
+          memory::store_and_swap<uint32_t>(col + 20, base + text_at);
+          continue;
+        }
+        int64_t value = 0;
+        uint8_t type = kDataInt32;
+        if (id == kColRank) {
+          value = src.rank;
+        } else if (id == kColRating) {
+          value = src.rating;
+          type = kDataInt64;
+        }
+        auto it = src.columns.find(id);
+        if (it != src.columns.end()) {
+          value = it->second.first;
+          type = it->second.second;
+        }
+        col[8] = type;
+        if (type == kDataInt64) memory::store_and_swap<uint64_t>(col + 16, uint64_t(value));
+        else memory::store_and_swap<uint32_t>(col + 16, uint32_t(int32_t(value)));
+      }
+      cols_at += 24 * ncols;
+      if (has_name) text_at += 32;
+    }
+    free_at = text_at;
+  }
+}
