+// XUserReadStats (xgi_app.cpp, message 0xB0021: friends / own rows).
+// Results: XUSER_STATS_READ_RESULTS {num_views, views*} -> XUSER_STATS_VIEW
+// {view_id, total_rows, num_rows, rows*} -> XUSER_STATS_ROW (48 B: xuid, rank
+// @8, rating i64 @16, gamertag[16] @24, num_columns @40, columns* @44) ->
+// XUSER_STATS_COLUMN (24 B: column id u16, XUSER_DATA @8: type u8 @8, value @16).
+// The title library sizes buffers as 8 + views * (16 + rows * 52) + rows *
+// columns * 28 (sub_827169A0), so the 48 / 24 byte records always fit.
+//
+// Writing: XSessionWriteStats (xgi_app.cpp, message 0xB0025) ->
+// LiveStatsWrite: XSESSION_VIEW_PROPERTIES {view, num props, props*} ->
+// XUSER_PROPERTY (24 B: id, XUSER_DATA @8). Sent in the background.
+struct X_USER_STATS_SPEC {
+  rex::be<uint32_t> view_id;
+  rex::be<uint32_t> num_column_ids;
+  rex::be<uint16_t> column_ids[64];
+};
+static_assert(sizeof(X_USER_STATS_SPEC) == 136, "XUSER_STATS_SPEC");
