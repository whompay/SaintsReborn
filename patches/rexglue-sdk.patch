+// gpu_timing_stats (AGENT_NATIVE26A, diag, dist file next to gpu_timing; 25B request c): one D3D12 PIPELINE_STATISTICS
+// query per GPU-timer interval (same intervals as the timestamps), summed per timer category. Log 'GPU PIPE STATS per
+// frame' (PS invocations = shaded pixels incl. overdraw, clipper invocations / primitives, IA primitives) and the
+// same numbers per gpu_timing_draws bucket in 'GPU DRAW SPLIT'. Diag only (adds a query per interval).
+struct GpuPipeStats {
+  bool on = false;
+  Microsoft::WRL::ComPtr<ID3D12QueryHeap> heap;
+  Microsoft::WRL::ComPtr<ID3D12Resource> readback;
+  const D3D12_QUERY_DATA_PIPELINE_STATISTICS* map = nullptr;
+  bool open = false, closing = false;
+  uint32_t open_index = 0;
+  double ps[256] = {}, cinv[256] = {}, cprim[256] = {}, ia[256] = {}, vs[256] = {};
+};
+static GpuPipeStats g_gps;
+
+void D3D12CommandProcessor::InitializeGpuTimer() {
+  gpu_timer_enabled_ = false;
+  if (FILE* f = RexFlagFopen("gpu_timing")) {
+    std::fclose(f);
+  } else {
+    return;
+  }
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  ID3D12CommandQueue* queue = GetD3D12Provider().GetDirectQueue();
+  if (!device || !queue || FAILED(queue->GetTimestampFrequency(&gpu_timer_frequency_)) ||
+      !gpu_timer_frequency_) {
+    return;
+  }
+  D3D12_QUERY_HEAP_DESC heap_desc = {};
+  heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  heap_desc.Count = kGpuTimerQueries;
+  if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&gpu_timer_heap_)))) {
+    return;
+  }
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buffer_desc, sizeof(uint64_t) * kGpuTimerQueries,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                             GetD3D12Provider().GetHeapFlagCreateNotZeroed(),
+                                             &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&gpu_timer_readback_)))) {
+    gpu_timer_heap_.Reset();
+    return;
+  }
+  D3D12_RANGE read_range = {0, sizeof(uint64_t) * kGpuTimerQueries};
+  void* mapping = nullptr;
+  if (FAILED(gpu_timer_readback_->Map(0, &read_range, &mapping))) {
+    gpu_timer_readback_.Reset();
+    gpu_timer_heap_.Reset();
+    return;
+  }
+  gpu_timer_mapping_ = reinterpret_cast<uint64_t*>(mapping);
+  gpu_timer_enabled_ = true;
+  if (FILE* fs = RexFlagFopen("gpu_timing_stats")) {
+    std::fclose(fs);
+    D3D12_QUERY_HEAP_DESC sd = {};
+    sd.Type = D3D12_QUERY_HEAP_TYPE_PIPELINE_STATISTICS;
+    sd.Count = kGpuTimerQueries;
+    D3D12_RESOURCE_DESC sb;
+    ui::d3d12::util::FillBufferResourceDesc(sb, sizeof(D3D12_QUERY_DATA_PIPELINE_STATISTICS) * kGpuTimerQueries,
+                                            D3D12_RESOURCE_FLAG_NONE);
+    void* smap = nullptr;
+    D3D12_RANGE srange = {0, sizeof(D3D12_QUERY_DATA_PIPELINE_STATISTICS) * kGpuTimerQueries};
+    if (SUCCEEDED(device->CreateQueryHeap(&sd, IID_PPV_ARGS(&g_gps.heap))) &&
+        SUCCEEDED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                                  GetD3D12Provider().GetHeapFlagCreateNotZeroed(), &sb,
+                                                  D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                                  IID_PPV_ARGS(&g_gps.readback))) &&
+        SUCCEEDED(g_gps.readback->Map(0, &srange, &smap))) {
+      g_gps.map = reinterpret_cast<const D3D12_QUERY_DATA_PIPELINE_STATISTICS*>(smap);
+      g_gps.on = true;
+      REXLOG_INFO("GPU pipeline statistics enabled (gpu_timing_stats)");
+    } else {
+      g_gps.heap.Reset();
+      g_gps.readback.Reset();
+    }
+  }
+  REXLOG_INFO("GPU timing enabled (timestamp frequency {})", gpu_timer_frequency_);
+}
+
+void D3D12CommandProcessor::GpuTimerWrite() {
+  const uint32_t ts_index = gpu_timer_cursor_;
+  deferred_command_list_.D3DEndQuery(gpu_timer_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     gpu_timer_cursor_++);
+  gpu_timer_intervals_.push_back(gpu_timer_category_);
+  if (g_gps.on) {  // gpu_timing_stats: the statistics query with this index covers the interval it starts
+    if (g_gps.open) {
+      deferred_command_list_.D3DEndQuery(g_gps.heap.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS, g_gps.open_index);
+      g_gps.open = false;
+    }
+    if (!g_gps.closing) {
+      deferred_command_list_.D3DBeginQuery(g_gps.heap.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS, ts_index);
+      g_gps.open = true;
+      g_gps.open_index = ts_index;
+    }
+  }
+}
