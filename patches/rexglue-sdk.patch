+    uint64_t q_runs = 0, a_ia = 0, a_cprim = 0, a_ps = 0, b_cprim = 0, b_ps = 0;  // NATIVE16: pipeline statistics sums
+  };
+  std::unordered_map<uint64_t, VerifyPair> verify_pairs;  // since start
+  uint64_t verify_runs = 0, verify_skipped = 0;
+};
+static NativeViewState g_native_view;
+
+static uint32_t NativeViewClassify(const RegisterFile& regs) {
+  const auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto di = regs.Get<reg::RB_DEPTH_INFO>();
+  if (si.surface_pitch == 640 && si.msaa_samples == xenos::MsaaSamples::k4X && di.depth_base == 768) {
+    return kNvClassPrepass;
+  }
+  if (si.surface_pitch == 1280 && si.msaa_samples == xenos::MsaaSamples::k1X && di.depth_base == 720) {
+    return kNvClassMain;
+  }
+  return kNvClassNone;
+}
+
+static void NativeViewRetire(D3D12CommandProcessor& cp, NvTarget& t) {
+  if (t.res) g_native_view.retired.emplace_back(cp.GetCurrentSubmission(), std::move(t.res));
+  t = NvTarget();
+}
+
+static void NativeViewShutdown() {
+  NativeViewState& nv = g_native_view;
+  for (NvSet& s : nv.set) {
+    s.depth = NvTarget();
+    for (NvTarget& c : s.color) c = NvTarget();
+    s.frame = UINT64_MAX;
+    s.queue.clear();
+  }
+  nv.pending = false;
+  nv.retired.clear();
+  nv.rtv_heap.Reset();
+  nv.dsv_heap.Reset();
+  nv.pso_color.Reset();
+  nv.pso_depth.Reset();
+  nv.pso_depth_ms.Reset();
+  nv.root_signature.Reset();
+  nv.init_tried = nv.init_ok = false;
+  nv.seed_pipelines.clear();
+  nv.seed_root_signature.Reset();
+  nv.seed_init_tried = false;
+  g_native_view_queued = false;
+  g_native_view_mark_pages = false;
+  NativeViewClearPages();
+  nv.mut_cp = nullptr;
+  nv.mut_rtc = nullptr;
+  nv.diff_img = NvTarget();
+  nv.diff_stats.Reset();
+  for (auto& r : nv.diff_rb) r = NativeViewState::DiffReadback();
+  nv.diff_pso.Reset();
+  nv.diff_clear_pso.Reset();
+  nv.diff_root_signature.Reset();
+  nv.diff_init_tried = false;
+  nv.verify_a = NvTarget();
+  nv.verify_b = NvTarget();
+  nv.verify_depth = NvTarget();
+  nv.verify_img = NvTarget();
+  nv.verify_stats.Reset();
+  for (auto& r : nv.verify_rb) r = NativeViewState::VerifyReadback();
+  nv.verify_pso.Reset();
+  nv.verify_qheap.Reset();
+  nv.verify_init_tried = false;
+  nv.verify_pending = false;
+}
