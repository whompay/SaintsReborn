+/**
+ * EOS virtual LAN (Saints Reborn): the game's System Link traffic carried over
+ * Epic Online Services P2P, so System Link works over the internet with no VPN.
+ *
+ * - Every player logs in anonymously (device ID) and joins one shared EOS
+ *   lobby, "saintsreborn-lan1" (created by whoever comes first; host migration
+ *   on). Its members form the "LAN".
+ * - Each game gets a virtual IP 10.77.x.y (random per run). It is what
+ *   XNetGetTitleXnAddr reports, so the game's own session info carries it.
+ * - A UDP packet the game sends to 255.255.255.255 goes to every LAN member;
+ *   one sent to a 10.77.x.y address goes to that player (learned from the
+ *   packets they send). Header: source / destination virtual IP and port,
+ *   fragment info (EOS packets are at most 1170 bytes).
+ * - Received packets are handed to the game's socket by sending them over
+ *   loopback UDP (127.0.0.1:port) from a helper socket with a small header;
+ *   XSocket::RecvFrom strips it and reports the real sender (virtual IP and
+ *   port). Blocking receives and select() keep working that way.
+ *
+ * Off when the EOS DLL / eos.ini aren't found, or with dist\lan_mode.txt = "lan"
+ * (then the real LAN address is used as before).
+ */
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/system/kernel_state.h>
+
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <set>
+
+#include <atomic>
