+  bool port_enabled[kPortCount] = {};
+  // No-depth pairs already described in the log.
+  std::unordered_set<uint64_t> nodepth_logged;
+  // Fallback pairs whose texture choice was described in the log.
+  std::unordered_set<uint64_t> fallback_logged;
+  // Fallback compiler.
+  bool compiler_tried = false;
+  void* compile = nullptr;  // D3DCompile
+  std::unordered_map<uint64_t, std::vector<uint8_t>> fallback_ps;  // by FallbackKey::Pack
+  std::unordered_set<uint64_t> fallback_failed;
+  PortState ports[kPortCount];
+  // Material pipelines already requested (pipeline handle | id): new ones are limited per frame.
