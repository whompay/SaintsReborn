+// The presenter's end of a guest output refresh runs on the replay thread (set
+// on the first swap while the replay thread is on; file "swap_drain" next to the
+// exe = the old wait at every swap).
+static std::atomic<bool> g_swap_finish_on_replay_thread{false};
+
+void D3D12CommandProcessor::StartReplayThread() {
+  replay_thread_enabled_ = true;
+  if (FILE* f = std::fopen("replay_thread.off", "rb")) {
+    std::fclose(f);
+    replay_thread_enabled_ = false;
+  }
+  REXLOG_INFO("D3D12 replay thread {}", replay_thread_enabled_ ? "on" : "off");
+  if (!replay_thread_enabled_) {
+    return;
+  }
+  replay_thread_exit_ = false;
+  replay_thread_ = std::thread([this]() { ReplayThreadMain(); });
+}
+
+void D3D12CommandProcessor::StopReplayThread() {
+  if (!replay_thread_.joinable()) {
+    return;
+  }
+  if (g_swap_finish_on_replay_thread.exchange(false) && graphics_system_ &&
+      graphics_system_->presenter()) {
+    graphics_system_->presenter()->SetGuestOutputFinishExecutor(nullptr);
+  }
+  DrainReplay();
+  {
+    std::lock_guard<std::mutex> lock(replay_mutex_);
+    replay_thread_exit_ = true;
+  }
+  replay_cv_.notify_all();
+  replay_thread_.join();
+  replay_thread_enabled_ = false;
+  replay_free_lists_.clear();
+}
+
+void D3D12CommandProcessor::DrainReplay() {
+  if (!replay_thread_enabled_) {
+    return;
+  }
+  const auto start = std::chrono::steady_clock::now();
+  std::unique_lock<std::mutex> lock(replay_mutex_);
+  replay_done_cv_.wait(lock, [this]() { return replay_done_ >= replay_enqueued_; });
+  stat_replay_drain_us_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                        std::chrono::steady_clock::now() - start)
+                                        .count());
+}
+
+void D3D12CommandProcessor::ReplayThreadMain() {
+#ifdef _WIN32
+  SetThreadDescription(GetCurrentThread(), L"GPU Replay");
+#endif
+  ID3D12CommandQueue* direct_queue = GetD3D12Provider().GetDirectQueue();
+  for (;;) {
+    ReplayJob job;
+    {
+      std::unique_lock<std::mutex> lock(replay_mutex_);
+      replay_cv_.wait(lock, [this]() { return replay_thread_exit_ || !replay_queue_.empty(); });
+      if (replay_queue_.empty()) {
+        return;
+      }
+      job = std::move(replay_queue_.front());
+      replay_queue_.pop_front();
+    }
+    if (!job.list) {
+      if (job.closure) job.closure();
+      continue;
+    }
+    const auto start = std::chrono::steady_clock::now();
+    job.command_allocator->Reset();
+    command_list_->Reset(job.command_allocator, nullptr);
+    job.list->Execute(command_list_, command_list_1_);
+    command_list_->Close();
+    ID3D12CommandList* execute_command_lists[] = {command_list_};
+    direct_queue->ExecuteCommandLists(1, execute_command_lists);
+    direct_queue->Signal(submission_fence_, job.fence_value);
+    stat_replay_us_.fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                           std::chrono::steady_clock::now() - start)
+                                           .count()),
+                              std::memory_order_relaxed);
+    job.list->Reset();
+    {
+      std::lock_guard<std::mutex> lock(replay_mutex_);
+      replay_free_lists_.push_back(std::move(job.list));
+      replay_done_ = job.fence_value;
+    }
+    replay_done_cv_.notify_all();
+  }
+}
