+    std::vector<uint32_t*> free[kClasses];
+    size_t cached_bytes = 0;
+  };
+  // Never destroyed: queued streams can release buffers during shutdown.
+  static State& GetState() {
+    static State* state = new State;
+    return *state;
+  }
+  static void Release(uint32_t* data, uint32_t cls) {
