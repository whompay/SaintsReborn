+  // too, as deep as execution goes), while they still hold this stream's data.
+  std::shared_ptr<IbSnapshots> snapshots;
+  // Predicated tiling (SET_BIN_* packets): D3D replays its tiling command
+  // buffers per tile and recycles them right after the kick (CPU-written
+  // fences), so a queued replay can read a buffer that is already being
+  // rewritten (packet overflows, rainbow garbage, broken resolves writing into
+  // textures, freezes - seen in the Friendly Fire shop). Such streams run in
+  // step with the game, as with no queue. File "tiling_sync.off" disables.
+  bool tiling = false;
+  static const bool tiling_sync = [] {
+    FILE* f = std::fopen("tiling_sync.off", "rb");
+    if (f) std::fclose(f);
+    return f == nullptr;
+  }();
+  if (!REXCVAR_GET(gpu_async_submit) &&
+      (REXCVAR_GET(gpu_async_depth) > 0 || g_rex_ab_queue_depth.load(std::memory_order_relaxed) > 0)) {
+    snapshots = std::make_shared<IbSnapshots>();
+    size_t total = 0;
+    std::function<void(const uint32_t*, uint32_t, int)> scan = [&](const uint32_t* dwords, uint32_t n,
+                                                                   int depth) {
+      uint32_t i = 0;
+      while (i < n) {
+        const uint32_t header = rex::byte_swap(dwords[i]);
+        const uint32_t type = header >> 30;
+        if (type == 0) {
+          i += ((header >> 16) & 0x3FFFu) + 2u;
+        } else if (type == 1) {
+          i += 3u;
+        } else if (type == 2) {
+          i += 1u;
+        } else {
+          const uint32_t opcode = (header >> 8) & 0x7Fu;
+          const uint32_t count = ((header >> 16) & 0x3FFFu) + 1u;
+          // Real tiling selects a different bin per tile; a constant select
+          // (sent every frame in single-pass rendering too) is not tiling.
+          if ((opcode == PM4_SET_BIN_SELECT || opcode == PM4_SET_BIN_SELECT_LO) && i + 1 < n) {
+            static std::atomic<uint32_t> last_select{0xFFFFFFFFu};
+            const uint32_t select = rex::byte_swap(dwords[i + 1]);
+            const uint32_t previous = last_select.exchange(select, std::memory_order_relaxed);
+            if (previous != 0xFFFFFFFFu && previous != select) tiling = true;
+          }
+          if ((opcode == PM4_INDIRECT_BUFFER || opcode == PM4_INDIRECT_BUFFER_PFD) && count >= 2 &&
