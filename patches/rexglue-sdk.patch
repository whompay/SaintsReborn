+  for (uint8_t i = 0; i < np; ++i) {
+    if (!need(5)) return false;
+    const uint32_t id = get32();
+    const uint8_t size = v[p++];
+    if (size > 8 || !need(size)) return false;
+    a.properties.push_back({id, std::vector<uint8_t>(v.begin() + p, v.begin() + p + size)});
+    p += size;
+  }
+  if (need(1)) {
+    const uint8_t nn = v[p++];
+    if (need(nn)) { a.name.assign(reinterpret_cast<const char*>(&v[p]), nn); p += nn; }
+  }
+  a.modded = false;  // version 1: an older game (no fair-play flag): allowed, else updated players never find it
+  if (v[0] == 2 && need(1)) {
+    const uint8_t f = v[p++];
+    a.modded = f & 1;
+    a.ranked = f & 2;
+    a.priv = f & 8;
+    a.mm = f & 4;
+  }
+  return true;
+}
+
+// What the advert's host is doing (its SRACT, see online_players.cpp), empty
+// when unknown (an older game, or its details not in yet).
+std::string HostActivity(const Advert& a) {
+  std::string puid;
+  return rex::system::eoslan::SessionHostWhere(a.info, puid);
+}
+
+// Fills XSESSION_SEARCHRESULT_HEADER + results (92 bytes each: XSESSION_INFO
+// 60, open/filled public/private slots, property / context counts and
+// pointers) + their XUSER_PROPERTY (24 bytes, value at +8) and XUSER_CONTEXT
+// (8 bytes) arrays at the end of the buffer. Returns the number written.
+// Matchmaking level filter (game sub_823630B0, loop at 0x82363440, for each
+// search result): the host's level id (property 0x10000035, low 16 bits) must
+// be a level of the search's mode [0x827AD2F0] in this game's level table
+// (sub_82373788: counts [[0x83074B1C] + slot * 4], records [[0x83074B20] +
+// slot * 4], 60 bytes, id at +36; slot = (mode + 243) & 0xFF) and, when this
+// game's own level setting [0x83A20830] is above 1, in this game's playlist
+// for the mode with its flag set (sub_82373930: 0x8307B0C8 + slot * 4 count,
+// + (slot + 7) * 4 id array, + (slot + 14) * 4 flag array). A result that
+// fails is skipped without a word and the game hosts its own lobby instead:
+// with map packs (public lobbies switch their levels off), Zombies, or a level
+// left over from a custom lobby, players found each other's lobby over and
+// over and all kept hosting - "Finding matches" forever (2026-10-28).
+template <class Mem>
+bool LevelPassesFilter(Mem* memory, int32_t id) {
+  auto r32 = [&](uint32_t a) { return rex::memory::load_and_swap<uint32_t>(memory->template TranslateVirtual<uint8_t*>(a)); };
+  auto r16 = [&](uint32_t a) { return rex::memory::load_and_swap<uint16_t>(memory->template TranslateVirtual<uint8_t*>(a)); };
+  auto r8 = [&](uint32_t a) { return *memory->template TranslateVirtual<uint8_t*>(a); };
+  const uint32_t mode = r32(0x827AD2F0u);
+  if (mode < 13 || mode >= 20 || int16_t(id) == -1) return false;
+  const uint32_t slot = (mode + 243) & 0xFF;
+  const uint32_t counts = r32(0x83074B1Cu), records = r32(0x83074B20u);
+  if (counts < 0x40000000u || records < 0x40000000u) return false;
+  const uint32_t n = r32(counts + slot * 4), recs = r32(records + slot * 4);
+  if (recs < 0x40000000u) return false;
+  bool found = false;
+  for (uint32_t i = 0; i < n && i < 256 && !found; ++i) found = int16_t(r16(recs + i * 60 + 36)) == int16_t(id);
+  if (!found) return false;
+  if (int32_t(r32(0x83A20830u)) <= 1) return true;
+  const uint32_t pl = 0x8307B0C8u;
+  const uint32_t pn = r32(pl + slot * 4), ids = r32(pl + (slot + 7) * 4), flags = r32(pl + (slot + 14) * 4);
+  if (ids < 0x40000000u || flags < 0x40000000u) return false;
+  for (uint32_t i = 0; i < pn && i < 256; ++i)
+    if (int16_t(r16(ids + i * 2)) == int16_t(id)) return r8(flags + i) != 0;
+  return false;
+}
+// A level id this game's filter takes for the lobby of a host on a disc map
+// (ids below 1000: every game has them): its own level setting if that
+// passes, else the first level of the mode that does. -1 = none.
+template <class Mem>
+int32_t LevelForFilter(Mem* memory) {
+  auto r32 = [&](uint32_t a) { return rex::memory::load_and_swap<uint32_t>(memory->template TranslateVirtual<uint8_t*>(a)); };
+  auto r16 = [&](uint32_t a) { return rex::memory::load_and_swap<uint16_t>(memory->template TranslateVirtual<uint8_t*>(a)); };
+  const int32_t own = int32_t(r32(0x83A20830u));
+  if (own > 1 && LevelPassesFilter(memory, own)) return own;
+  const uint32_t mode = r32(0x827AD2F0u);
+  if (mode < 13 || mode >= 20) return -1;
+  const uint32_t slot = (mode + 243) & 0xFF;
+  const uint32_t counts = r32(0x83074B1Cu), records = r32(0x83074B20u);
+  if (counts < 0x40000000u || records < 0x40000000u) return -1;
+  const uint32_t n = r32(counts + slot * 4), recs = r32(records + slot * 4);
+  if (recs < 0x40000000u) return -1;
+  for (uint32_t i = 0; i < n && i < 256; ++i) {
+    const int32_t id = int16_t(r16(recs + i * 60 + 36));
+    if (id >= 0 && id < 1000 && LevelPassesFilter(memory, id)) return id;
+  }
+  return -1;
+}
+
+template <class Mem>
+uint32_t FillSearchResults(Mem* memory, uint32_t results_ptr, uint32_t buffer_size,
+                           uint32_t max_results, uint32_t num_ctx, uint32_t ctx_ptr, const char* what,
+                           const uint8_t* session_id = nullptr) {
+  const auto texts = rex::system::eoslan::LiveAdverts(3000);
+  std::vector<Advert> found;
+  std::vector<std::pair<uint32_t, uint32_t>> wanted;
+  for (uint32_t i = 0; ctx_ptr && i < num_ctx && i < 32; ++i) {
+    auto* c = memory->TranslateVirtual<uint8_t*>(ctx_ptr + i * 8);
+    wanted.push_back({rex::memory::load_and_swap<uint32_t>(c), rex::memory::load_and_swap<uint32_t>(c + 4)});
+  }
+  const bool me_modded = rex::system::online::Modded();
+  if (me_modded && !session_id) {
+    static std::string told;
+    const std::string reason = rex::system::online::ModdedReason();
+    if (told != reason) {
+      told = reason;
+      rex::system::online::Notice("Public matches need an unmodded game. Turn off: " + reason +
+                                  ". Mods work in a Private Party with invited friends.");
+    }
+  }
+  uint32_t other_kind = 0, busy = 0;
+  for (const auto& t : texts) {
+    Advert a;
+    if (!ParseAdvert(t.text, a)) continue;
+    a.modded = a.modded || t.modded;  // the host's own published state counts too
+    if (session_id) {
+      // XSessionSearchByID: exactly that session (the match an invited / party
+      // player follows the host into); no lobby filters.
+      if (std::memcmp(a.info, session_id, 8) == 0) found.push_back(std::move(a));
+      continue;
+    }
+    bool ok = true;
+    for (auto& [id, value] : wanted)
+      for (auto& [aid, avalue] : a.contexts)
+        if (aid == id && avalue != value) ok = false;
+    if (!ok) continue;
+    // Public matches are unmodded games only; Private Parties are joined by
+    // invite (XSessionSearchByID above), never found by a search.
+    if (me_modded || a.modded || a.priv) {
+      ++other_kind;
+      continue;
+    }
+    // Full lobbies and matches already running can't take a matchmaking
+    // join: the game tried them anyway (results came in lobby-member order),
+    // the join failed and the player ended up hosting alone on "Finding
+    // matches". Hosts waiting in matchmaking come first, the fullest first.
+    const std::string act = HostActivity(a);
+    if (a.open_pub == 0 || act == "In a multiplayer match") {
+      ++busy;
+      continue;
+    }
+    a.rank = act == "Searching for players" ? 0 : 1;
+    found.push_back(std::move(a));
+  }
+  if (!session_id)
+    std::stable_sort(found.begin(), found.end(), [](const Advert& x, const Advert& y) {
+      if (x.rank != y.rank) return x.rank < y.rank;
+      return x.filled_pub + x.filled_priv > y.filled_pub + y.filled_priv;
+    });
+  if (busy) REXLOG_INFO("LIVE {}: {} full or already playing, left out", what, busy);
+  if (other_kind)
+    REXLOG_INFO("LIVE {}: {} session(s) hidden (this game is {}; public matches are unmodded games only, private "
+                "parties are joined by invite)", what, other_kind, me_modded ? "modded" : "unmodded");
+  std::string wanted_text;
+  for (auto& [id, value] : wanted) wanted_text += fmt::format(" {:X}={}", id, value);
+  REXLOG_INFO("LIVE {}: {} advert(s) online, {} match (search contexts:{}; this game {})", what, texts.size(),
+              found.size(), wanted_text, me_modded ? "modded" : "unmodded");
+  if (!results_ptr || buffer_size < 8) return 0;
+  uint8_t* base = memory->TranslateVirtual<uint8_t*>(results_ptr);
+  std::memset(base, 0, buffer_size);
+  uint32_t count = 0;
+  uint32_t tail = buffer_size;  // extra arrays grow down from the end
+  for (const auto& a : found) {
+    if (count >= max_results) break;
+    const uint32_t at = 8 + count * 92;
+    const uint32_t extra = uint32_t(a.properties.size() * 24 + a.contexts.size() * 8);
+    const uint32_t extra_at = (tail >= extra ? tail - extra : 0) & ~7u;
+    if (at + 92 > extra_at) break;
+    uint8_t* r = base + at;
+    std::memcpy(r, a.info, 60);
+    rex::memory::store_and_swap<uint32_t>(r + 60, a.open_pub);
+    rex::memory::store_and_swap<uint32_t>(r + 64, a.open_priv);
+    rex::memory::store_and_swap<uint32_t>(r + 68, a.filled_pub);
+    rex::memory::store_and_swap<uint32_t>(r + 72, a.filled_priv);
+    rex::memory::store_and_swap<uint32_t>(r + 76, uint32_t(a.properties.size()));
+    rex::memory::store_and_swap<uint32_t>(r + 80, uint32_t(a.contexts.size()));
+    uint32_t cursor = extra_at;
+    rex::memory::store_and_swap<uint32_t>(r + 84, a.properties.empty() ? 0 : results_ptr + cursor);
+    for (auto& [id, bytes] : a.properties) {
+      uint8_t* pr = base + cursor;
+      rex::memory::store_and_swap<uint32_t>(pr, id);
+      pr[8] = uint8_t(id >> 28);  // XUSER_DATA type is the property id's top nibble
+      std::vector<uint8_t> value = bytes;
+      // The host's level for the game's lobby filter (see LevelPassesFilter):
+      // a lobby on a disc map is always joinable - the match itself is played
+      // on the host's level, the filter only decides whether to try.
+      if (!session_id && id == 0x10000035u && value.size() == 4) {
+        const int32_t theirs = int32_t(uint32_t(value[0]) << 24 | uint32_t(value[1]) << 16 | uint32_t(value[2]) << 8 | value[3]);
+        const int32_t level = int16_t(theirs);
+        if (false && level < 1000 && !LevelPassesFilter(memory, level)) {  // OFF: ids < 1000 are not always disc maps (map packs use them too) - a player joined a map he did not have and got a black void
+          const int32_t use = LevelForFilter(memory);
+          if (use >= 0) {
+            for (int k = 0; k < 4; ++k) value[k] = uint8_t(uint32_t(use) >> (24 - 8 * k));
+            REXLOG_INFO("LIVE {}: {}'s lobby is on level {}, which this game's lobby filter skips - shown as level {} so "
+                        "it can be joined", what, a.name, level, use);
+          }
+        }
+      }
+      std::memcpy(pr + 16, value.data(), value.size());  // XUSER_DATA value (big endian) at +8 of XUSER_DATA
+      cursor += 24;
+    }
+    rex::memory::store_and_swap<uint32_t>(r + 88, a.contexts.empty() ? 0 : results_ptr + cursor);
+    for (auto& [id, value] : a.contexts) {
+      rex::memory::store_and_swap<uint32_t>(base + cursor, id);
+      rex::memory::store_and_swap<uint32_t>(base + cursor + 4, value);
+      cursor += 8;
+    }
+    tail = extra_at;
+    REXLOG_INFO("LIVE {}: result {} = {} ({}.{}.{}.{}), {} open slot(s)", what, count, a.name, a.info[8], a.info[9],
+                a.info[10], a.info[11], a.open_pub);
+    ++count;
+  }
+  rex::memory::store_and_swap<uint32_t>(base + 0, count);
+  rex::memory::store_and_swap<uint32_t>(base + 4, count ? results_ptr + 8 : 0);
+  return count;
+}
+
+// XSessionJoinRemote / XSessionLeaveRemote: players in a session this game
+// created. For the hosted (advertised) one the advert's player count follows.
+void LiveCountRemote(uint32_t obj, int delta) {
+  std::lock_guard<std::mutex> l(g_live.mutex);
+  for (auto& e : g_live.sessions) {
+    if (e.obj != obj) continue;
+    e.remote = std::clamp(e.remote + delta, 0, 64);
+    if (g_live.hosting && g_live.obj == obj && g_live.remote != e.remote) {
+      g_live.remote = e.remote;
+      PublishAdvertLocked();
+      REXLOG_INFO("LIVE: hosted session now has {} player(s)", 1 + g_live.remote);
+    }
+    return;
+  }
+}
+
+// The host's advert for this session id says it is a Private Party (joining).
+bool AdvertIsPrivate(const uint8_t* info) {
+  for (const auto& t : rex::system::eoslan::LiveAdverts(0)) {
+    Advert a;
+    if (ParseAdvert(t.text, a) && std::memcmp(a.info, info, 8) == 0) return a.priv;
+  }
+  return false;
+}
