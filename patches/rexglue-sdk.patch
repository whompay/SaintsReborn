+  std::string r;
+  for (uint32_t i = 1; i < kNclrReasons; ++i) {
+    if (g_nc.reasons[i]) r += fmt::format(" [{} {:.1f}/s]", kNames[i], g_nc.reasons[i] / seconds);
+  }
+  std::string t;
+  for (const auto& [k, v] : g_nc.per_target) t += fmt::format(" [{} {:.1f}/s]", k, v / seconds);
+  if (!g_nc.prim_keys.empty()) {
+    std::vector<std::pair<uint64_t, uint32_t>> pk;
+    for (const auto& [k, v] : g_nc.prim_keys) pk.emplace_back(v, k);
+    std::sort(pk.begin(), pk.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+    r += " | prim detail:";
+    for (size_t i = 0; i < pk.size() && i < 6; ++i) {
+      const uint32_t k = pk[i].second;
+      r += fmt::format(" [type {} verts {} idx {} noraster {} memexport {}: {:.1f}/s]", k & 0xFF, (k >> 8) & 0xFF,
+                       (k >> 16) & 1, (k >> 17) & 1, (k >> 18) & 1, pk[i].first / seconds);
+    }
+    g_nc.prim_keys.clear();
+  }
+  REXLOG_INFO(
+      "NATIVE CLEAR ({}, {:.0f} s): candidates {:.1f}/s, native clears {:.1f}/s (depth {:.1f} stencil {:.1f} colour "
+      "{:.1f}, {:.0f} host px each) | rejected:{} | targets:{} | verify: compares {} checked {} BAD {} (pixels "
+      "inside {} outside {}) unknown plane formats {} failures {} aborted {} | since start checked {} BAD {}{}{}",
+      g_nc.mode == 2 ? "VERIFY" : (g_nc.mode ? "ON" : "off"), seconds, g_nc.candidates / seconds,
+      g_nc.cleared / seconds, g_nc.c_depth / seconds, g_nc.c_stencil / seconds, g_nc.c_color / seconds,
+      g_nc.cleared ? double(g_nc.pixels) / double(g_nc.cleared) : 0.0, r.empty() ? " none" : r,
+      t.empty() ? " none" : t, g_nc.v_captured, g_nc.v_checked, g_nc.v_bad, g_nc.v_bad_in, g_nc.v_bad_out,
+      g_nc.v_unknown, g_nc.v_fail, g_nc.v_aborted, g_nc.t_checked, g_nc.t_bad, g_nc.fmts, g_nc.first_bad);
+  g_nc.candidates = g_nc.cleared = g_nc.c_depth = g_nc.c_stencil = g_nc.c_color = g_nc.pixels = 0;
+  std::memset(g_nc.reasons, 0, sizeof(g_nc.reasons));
+  g_nc.per_target.clear();
+  g_nc.v_captured = g_nc.v_checked = g_nc.v_bad = g_nc.v_bad_in = g_nc.v_bad_out = g_nc.v_unknown = g_nc.v_fail =
+      g_nc.v_aborted = 0;
+}
+
+void NclrRecordClears(D3D12CommandProcessor& cp, NclrTarget* t, uint32_t n) {
+  DeferredCommandList& list = cp.GetDeferredCommandList();
+  for (uint32_t i = 0; i < n; ++i) {
+    cp.PushTransitionBarrier(t[i].resource, t[i].set_state(t[i].draw_state), t[i].draw_state);
+    cp.SubmitBarriers();
+    if (t[i].depth) {
+      list.D3DClearDepthStencilView(t[i].view, t[i].flags, g_nclr.depth_value, UINT8(g_nclr.stencil_value), 1,
+                                    &t[i].rect);
+    } else {
+      list.D3DClearRenderTargetView(t[i].view, g_nclr.color, 1, &t[i].rect);
+    }
+  }
+}
+
+void NclrCopy(D3D12CommandProcessor& cp, NclrTarget& t, uint32_t copy_index) {
+  cp.PushTransitionBarrier(t.resource, t.set_state(D3D12_RESOURCE_STATE_COPY_SOURCE),
+                           D3D12_RESOURCE_STATE_COPY_SOURCE);
+  cp.SubmitBarriers();
+  DeferredCommandList& list = cp.GetDeferredCommandList();
+  for (uint32_t p = 0; p < t.planes; ++p) {
+    D3D12_TEXTURE_COPY_LOCATION dst = {}, src = {};
+    dst.pResource = g_nc.readback.Get();
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint = t.fp[p];
+    dst.PlacedFootprint.Offset += t.base + copy_index * t.bytes;
+    src.pResource = t.resource;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.SubresourceIndex = p;
+    list.D3DCopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+  }
+  cp.PushTransitionBarrier(t.resource, t.set_state(t.draw_state), t.draw_state);
+}
+
+// Inside the rectangle: after-draw == after-clear (values); outside: before-draw == after-draw (coverage).
+void NclrHarvest() {
+  if (!g_nc.in_flight || !g_nc.cp || g_nc.submission > g_nc.cp->GetCompletedSubmission()) return;
+  g_nc.in_flight = false;
+  void* mapping = nullptr;
+  D3D12_RANGE range = {0, size_t(g_nc.readback_size)};
+  if (FAILED(g_nc.readback->Map(0, &range, &mapping))) {
+    ++g_nc.v_fail;
+    return;
+  }
+  const uint8_t* mem = static_cast<const uint8_t*>(mapping);
+  bool bad = false;
+  uint64_t bad_in = 0, bad_out = 0;
+  for (uint32_t i = 0; i < g_nc.vt_count; ++i) {
+    const NclrTarget& t = g_nc.vt[i];
+    for (uint32_t p = 0; p < t.planes; ++p) {
+      const D3D12_SUBRESOURCE_FOOTPRINT& f = t.fp[p].Footprint;
+      const uint32_t eb = NclrElemBytes(f.Format);
+      if (g_nc.fmts.size() < 160 && g_nc.fmts.find(fmt::format(" {}:{}", i, p)) == std::string::npos) {
+        g_nc.fmts += fmt::format(" | plane {}:{} fmt {} {}x{} pitch {}", i, p, uint32_t(f.Format), f.Width, f.Height,
+                                 f.RowPitch);
+      }
+      if (!eb) {
+        ++g_nc.v_unknown;
+        continue;
+      }
+      // D24 depth plane: the X8 byte is undefined.
+      const uint32_t mask = (p == 0 && t.d24 && eb == 4) ? 0x00FFFFFFu : 0xFFFFFFFFu;
+      const uint8_t* c0 = mem + t.base + t.fp[p].Offset;
+      const uint8_t* c1 = c0 + t.bytes;
+      const uint8_t* c2 = c1 + t.bytes;
+      const uint32_t l = uint32_t(std::min<LONG>(t.rect.left, LONG(f.Width)));
+      const uint32_t r = uint32_t(std::min<LONG>(t.rect.right, LONG(f.Width)));
+      for (uint32_t y = 0; y < f.Height && y < t.rows[p]; ++y) {
+        const size_t o = size_t(y) * f.RowPitch;
+        const bool yin = LONG(y) >= t.rect.top && LONG(y) < t.rect.bottom;
+        auto compare = [&](const uint8_t* a, const uint8_t* b, uint32_t x0, uint32_t x1, bool inside) {
+          if (x0 >= x1) return;
+          if (mask == 0xFFFFFFFFu && !std::memcmp(a + size_t(x0) * eb, b + size_t(x0) * eb, size_t(x1 - x0) * eb)) {
+            return;
+          }
+          for (uint32_t x = x0; x < x1; ++x) {
+            for (uint32_t w = 0; w < eb; w += 4) {
+              uint32_t va = 0, vb = 0;
+              const uint32_t n = std::min<uint32_t>(4, eb - w);
+              std::memcpy(&va, a + size_t(x) * eb + w, n);
+              std::memcpy(&vb, b + size_t(x) * eb + w, n);
+              if ((va ^ vb) & mask) {
+                if (inside) {
+                  ++bad_in;
+                } else {
+                  ++bad_out;
+                }
+                if (g_nc.first_bad.empty()) {
+                  g_nc.first_bad = fmt::format(
+                      " | first bad: {} plane {} at {},{} {} {:08X} vs draw {:08X} | rect {},{}-{},{} depth {} "
+                      "stencil {} colour {} {} {} {}",
+                      t.name, p, x, y, inside ? "clear" : "before", va, vb, t.rect.left, t.rect.top,
+                      t.rect.right, t.rect.bottom, g_nc.plan.depth_value, g_nc.plan.stencil_value, g_nc.plan.color[0],
+                      g_nc.plan.color[1], g_nc.plan.color[2], g_nc.plan.color[3]);
+                }
+                break;
+              }
+            }
+          }
+        };
+        if (yin) {
+          compare(c0 + o, c1 + o, 0, l, false);
+          compare(c2 + o, c1 + o, l, r, true);
+          compare(c0 + o, c1 + o, r, f.Width, false);
+        } else {
+          compare(c0 + o, c1 + o, 0, f.Width, false);
+        }
+      }
+    }
+  }
+  D3D12_RANGE written = {0, 0};
+  g_nc.readback->Unmap(0, &written);
+  bad = bad_in || bad_out;
+  ++g_nc.v_checked;
+  ++g_nc.t_checked;
+  g_nc.v_bad_in += bad_in;
+  g_nc.v_bad_out += bad_out;
+  if (bad) {
+    ++g_nc.v_bad;
+    ++g_nc.t_bad;
+  }
+}
+
+// Verify mode: copy 0 now (targets bound, before the draw); the draw runs; NativeClearRunAfterDraw does the rest.
+bool NclrCapture(D3D12CommandProcessor& cp, NclrTarget* t, uint32_t n) {
+  ID3D12Device* device = cp.GetD3D12Provider().GetDevice();
+  uint64_t total = 0;
+  for (uint32_t i = 0; i < n; ++i) {
+    D3D12_FEATURE_DATA_FORMAT_INFO fi = {t[i].desc.Format, 0};
+    t[i].planes = 1;
+    if (SUCCEEDED(device->CheckFeatureSupport(D3D12_FEATURE_FORMAT_INFO, &fi, sizeof(fi)))) {
+      t[i].planes = std::min<uint32_t>(std::max<uint32_t>(fi.PlaneCount, 1), 2);
+    }
+    UINT64 bytes = 0;
+    UINT64 row_sizes[2];
+    UINT rows[2];
+    device->GetCopyableFootprints(&t[i].desc, 0, t[i].planes, 0, t[i].fp, rows, row_sizes, &bytes);
+    if (bytes == UINT64(-1) || !bytes) return false;
+    t[i].rows[0] = rows[0];
+    t[i].rows[1] = t[i].planes > 1 ? rows[1] : 0;
+    t[i].bytes = (bytes + 511) & ~UINT64(511);
+    t[i].base = total;
+    total += t[i].bytes * 3;
+  }
+  if (total > (UINT64(512) << 20)) return false;
+  if (total > g_nc.readback_size) {
+    g_nc.readback.Reset();
+    g_nc.readback_size = 0;
+    D3D12_HEAP_PROPERTIES heap = {};
+    heap.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    desc.Width = total;
+    desc.Height = 1;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_UNKNOWN;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST,
+                                               nullptr, IID_PPV_ARGS(&g_nc.readback)))) {
+      return false;
+    }
+    g_nc.readback_size = total;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    g_nc.vt[i] = t[i];
+    NclrCopy(cp, g_nc.vt[i], 0);
+  }
+  g_nc.vt_count = n;
+  g_nc.plan = g_nclr;
+  g_nc.captured = true;
+  ++g_nc.v_captured;
+  return true;
+}
+
+void NclrExecute(D3D12CommandProcessor& cp, NclrTarget* t, uint32_t n) {
+  g_nc.cp = &cp;
+  if (g_nc.mode == 2) {
+    NclrHarvest();
+    if (g_nc.captured) {  // the previous captured draw never reached NativeClearRunAfterDraw
+      g_nc.captured = false;
+      ++g_nc.v_aborted;
+    }
+    if (g_nc.in_flight || GetTickCount64() < g_nc.next_capture_tick) {
+      ++g_nc.reasons[kNclrVerifyBusy];
+    } else if (!NclrCapture(cp, t, n)) {
+      ++g_nc.v_fail;
+      g_nc.next_capture_tick = GetTickCount64() + 1000;
+    } else {
+      g_nclr.verify_pending = true;
+    }
+    NclrMaybeLog();
+    return;  // verify mode always draws
+  }
+  NclrRecordClears(cp, t, n);
+  g_nclr.done = true;
+  ++g_nc.cleared;
+  if (g_nclr.depth) ++g_nc.c_depth;
+  if (g_nclr.stencil) ++g_nc.c_stencil;
+  if (g_nclr.color_mask) ++g_nc.c_color;
+  g_nc.pixels += uint64_t(t[0].rect.right - t[0].rect.left) * uint64_t(t[0].rect.bottom - t[0].rect.top);
+  for (uint32_t i = 0; i < n; ++i) ++g_nc.per_target[t[i].name];
+  NclrMaybeLog();
+}
+}  // namespace
+
+int NativeClearPoll() {
+  const uint64_t now = GetTickCount64();
+  if (now >= g_nc.poll_tick) {
+    g_nc.poll_tick = now + 1000;
+    int mode = 0;
+    if (RexFlagExistsW(L"native_clear.off")) {
+      mode = 0;
+    } else if (RexFlagExistsW(L"native_clear_verify")) {
+      mode = 2;
+    } else if (RexFlagExistsW(L"native_clear")) {
+      mode = 1;
+    }
+    if (mode != g_nc.mode) {
+      REXLOG_INFO("NATIVE CLEAR: {}", mode == 2 ? "VERIFY (draw + read back compare)" : (mode ? "ON" : "off"));
+    }
+    g_nc.mode = mode;
+  }
+  if (g_nc.mode) ++g_nc.candidates;
+  return g_nc.mode;
+}
+
+void NativeClearRejectPrim(uint32_t key) {
+  ++g_nc.prim_keys[key];
+  NativeClearReject(kNclrPrim);
+}
+
+void NativeClearReject(uint32_t reason) {
+  if (reason < kNclrReasons) ++g_nc.reasons[reason];
+  NclrMaybeLog();
+}
+
+void NativeClearRunAfterDraw() {
+  if (!g_nc.captured || !g_nc.cp) return;
+  D3D12CommandProcessor& cp = *g_nc.cp;
+  g_nc.captured = false;
+  for (uint32_t i = 0; i < g_nc.vt_count; ++i) NclrCopy(cp, g_nc.vt[i], 1);
+  NclrRecordClears(cp, g_nc.vt, g_nc.vt_count);
+  for (uint32_t i = 0; i < g_nc.vt_count; ++i) NclrCopy(cp, g_nc.vt[i], 2);
+  cp.SubmitBarriers();
+  g_nc.in_flight = true;
+  g_nc.submission = cp.GetCurrentSubmission();
+  g_nc.next_capture_tick = GetTickCount64() + 300;
+}
