+// Native view (command_processor.cpp native_view.inc, VIEW13): flush queued native draws before data they read changes.
+extern bool g_native_view_queued;
+extern bool g_native_view_mark_pages;
+
+// DEAD RESOLVE SKIP (AGENT_NATIVE24A, opt-in dist file direct_resolve_skip_dead; .off wins): a direct resolve
+// written straight into its consumer texture whose content is never loaded by anything (no texture load request
+// for that address before the next write to it) is skipped once that is learned for its (destination, ordinal in
+// the frame) key over kDlLearn consecutive writes. The consumer keeps the older content; MarkRangeAsResolved still
+// outdates the texture, so any later load request hits the texture cache and is reported here (DlNoteRead): a load
+// after a skipped write = stale read -> that key is never skipped again (worst case one stale frame, like the
+// memory skip). Log 'DEAD RESOLVE SKIP' every 10 s. texture_cache.cpp calls DlNoteRead from
+// TryLoadFromDirectResolve (every load request of a scaled resolve address).
+static constexpr uint32_t kDlLearn = 120;
+struct DlKey {
+  uint32_t dead_streak = 0;
+  bool never = false;
+  uint64_t skipped = 0, executed = 0;
+};
+struct DlBase {
+  uint64_t frame = ~uint64_t(0);
+  uint32_t ordinal = 0;
+  bool has_last = false, last_skipped = false, read = false;
+  uint64_t last_key = 0;
+};
+static std::unordered_map<uint64_t, DlKey> g_dl_keys;
+static std::unordered_map<uint32_t, DlBase> g_dl_bases;
+static uint64_t g_dl_stale = 0, g_dl_log_tick = 0, g_dl_next_check = 0;
+static bool g_dl_on = false;
+void DlNoteRead(uint32_t base) {
+  auto it = g_dl_bases.find(base);
+  if (it != g_dl_bases.end()) it->second.read = true;
+}
+static bool DlOn() {
+  const uint64_t now = GetTickCount64();
+  if (now >= g_dl_next_check) {
+    g_dl_next_check = now + 1000;
+    bool on = false;
+    if (FILE* f = RexFlagFopen("direct_resolve_skip_dead")) {
+      on = true;
+      std::fclose(f);
+    }
+    if (FILE* f = RexFlagFopen("direct_resolve_skip_dead.off")) {
+      on = false;
+      std::fclose(f);
+    }
+    g_dl_on = on;
+  }
+  return g_dl_on;
+}
+// Learning + decision for one resolve into `base` that is about to take the memory-skip path.
+static bool DlDecide(uint32_t base, uint64_t frame) {
+  DlBase& b = g_dl_bases[base];
+  if (b.frame != frame) {
+    b.frame = frame;
+    b.ordinal = 0;
+  }
+  const uint64_t key = uint64_t(base) * 8 + std::min<uint32_t>(b.ordinal++, 7);
+  if (b.has_last) {
+    DlKey& last = g_dl_keys[b.last_key];
+    if (b.read) {
+      if (b.last_skipped) {
+        last.never = true;
+        ++g_dl_stale;
+        REXLOG_WARN("DEAD RESOLVE SKIP: {:08X} #{} was loaded after a skipped write - never skipped again",
+                    uint32_t(b.last_key / 8), uint32_t(b.last_key % 8));
+      }
+      last.dead_streak = 0;
+    } else if (last.dead_streak < 0x7FFFFFFF) {
+      ++last.dead_streak;
+    }
+  }
+  DlKey& k = g_dl_keys[key];
+  const bool skip = DlOn() && !k.never && k.dead_streak >= kDlLearn;
+  if (skip) ++k.skipped; else ++k.executed;
+  b.has_last = true;
+  b.last_key = key;
+  b.last_skipped = skip;
+  b.read = false;
+  const uint64_t now = GetTickCount64();
+  if (!g_dl_log_tick) g_dl_log_tick = now;
+  if (now - g_dl_log_tick >= 10000) {
+    const double sec = double(now - g_dl_log_tick) / 1000.0;
+    g_dl_log_tick = now;
+    std::string line;
+    for (auto& [kk, v] : g_dl_keys) {
+      if (v.dead_streak >= kDlLearn || v.skipped || v.never) {
+        line += fmt::format(" [{:08X} #{}: skipped {:.1f}/s, executed {:.1f}/s, dead streak {}{}]", uint32_t(kk / 8),
+                            uint32_t(kk % 8), v.skipped / sec, v.executed / sec, v.dead_streak,
+                            v.never ? ", NEVER" : "");
+      }
+      v.skipped = v.executed = 0;
+    }
+    REXLOG_INFO("DEAD RESOLVE SKIP ({}): stale reads {} | dead keys:{}", g_dl_on ? "ON" : "learning only",
+                g_dl_stale, line);
+  }
+  return skip;
+}
