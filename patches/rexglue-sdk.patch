+  // Session ids of the address targets (apxnkid[i] -> XNKID), for the data.
+  std::vector<std::array<uint8_t, 8>> kids(count);
+  std::vector<bool> has_kid(count, false);
+  for (uint32_t i = 0; i < count && i < uint32_t(cxna); ++i) {
+    if (!apxnkid) break;
+    const uint32_t kid_ptr = rex::memory::load_and_swap<uint32_t>(REX_KERNEL_MEMORY()->TranslateVirtual(uint32_t(apxnkid) + i * 4));
+    if (!kid_ptr) continue;
+    std::memcpy(kids[i].data(), REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(kid_ptr), 8);
+    has_kid[i] = true;
+  }
+  // Fills one target; false = no data yet.
+  auto fill = [qos_guest, count, n_probes, kids, has_kid](uint32_t i, bool last_chance) {
+    auto* base = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(qos_guest);
+    XNQOSINFO& info = *reinterpret_cast<XNQOSINFO*>(base + 8 + i * 24);
+    std::vector<uint8_t> data;
+    const bool got = has_kid[i] && rex::system::eoslan::QosData(kids[i].data(), data);
+    if (!got && !last_chance && has_kid[i]) return false;
+    // The host's data never arrived: make it up from its advert. Byte 0 bit 0
+    // is what the joiner goes by (sub_8236CBD0): 1 = join a public slot, 0 =
+    // a private (invite) slot. Always 0 before 2026-10-17, so a join to a
+    // public lobby whose data was late asked the host for a private slot,
+    // the host refused, and the player got "Host Disconnected" until a
+    // later try (by then the data was there).
+    int pub = -1;
+    if (!got) {
+      pub = has_kid[i] ? LiveSessionPublic(kids[i].data()) : -1;
+      data.assign(1, pub == 1 ? 1 : 0);
+    }
+    const uint32_t n = std::min<uint32_t>(uint32_t(data.size()), kDataRoom);
+    const uint32_t data_guest = qos_guest + 8 + 24 * std::max<uint32_t>(count, 1) + i * kDataRoom;
+    std::memcpy(base + (data_guest - qos_guest), data.data(), n);
+    info.data_ptr = data_guest;
+    info.data_len = uint16_t(n);
+    info.probes_xmit = n_probes;
+    info.probes_recv = n_probes;
+    info.rtt_min_in_msecs = 30;
+    info.rtt_med_in_msecs = 40;
+    info.up_bits_per_sec = 4000000;
+    info.down_bits_per_sec = 4000000;
+    info.flags = 0x01 | 0x02 | 0x08;  // COMPLETE | TARGET_CONTACTED | DATA_RECEIVED
+    REXKRNL_INFO("NET XNetQosLookup target {}: {} byte(s) of QoS data{}", i, n,
+                 got ? " from the host"
+                     : pub == 1 ? " (host's data not found: public lobby by its advert)"
+                     : pub == 0 ? " (host's data not found: Private Party by its advert)"
+                                : " (host's data not found, no advert: default)");
+    return true;
+  };
+  uint32_t pending = 0;
+  std::vector<bool> done(count, false);
+  for (uint32_t i = 0; i < count; ++i) {
+    done[i] = fill(i, false);
+    if (!done[i]) ++pending;
+  }
+  qos->count_pending = pending;
+  if (ppqos) rex::memory::store_and_swap<uint32_t>(REX_KERNEL_MEMORY()->TranslateVirtual(uint32_t(ppqos)), qos_guest);
+  if (pending) {
+    auto async = std::make_shared<QosAsyncLookup>();
+    {
+      auto& lookups = GetQosAsyncLookups();
+      std::lock_guard<std::mutex> lock(lookups.mutex);
+      lookups.by_address[qos_guest] = async;
+    }
+    // The host's data can still be on its way over Epic (member attributes):
+    // answer the rest within 4 s, like a probe that takes a moment.
+    std::thread([qos_guest, count, done, fill, event_handle, async]() mutable {
+      for (int tick = 0; tick <= 40; ++tick) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        if (async->released.load(std::memory_order_acquire)) break;
+        uint32_t left = 0;
+        for (uint32_t i = 0; i < count; ++i) {
+          if (!done[i]) done[i] = fill(i, tick == 40);
+          if (!done[i]) ++left;
+        }
+        auto* q2 = REX_KERNEL_MEMORY()->TranslateVirtual<XNQOS*>(qos_guest);
+        q2->count_pending = left;
+        if (!left) break;
+      }
+      if (!async->released.load(std::memory_order_acquire) && event_handle) {
+        if (auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle)) ev->Set(0, false);
+      }
+      bool free_released = false;
+      {
+        auto& lookups = GetQosAsyncLookups();
+        std::lock_guard<std::mutex> lock(lookups.mutex);
+        auto it = lookups.by_address.find(qos_guest);
+        if (it != lookups.by_address.end() && it->second == async) {
+          free_released = async->released.load(std::memory_order_acquire);
+          lookups.by_address.erase(it);
+        }
+      }
+      if (free_released) {
+        REX_KERNEL_MEMORY()->SystemHeapFree(qos_guest);
+        REXKRNL_INFO("NET XNetQosLookup cancelled and freed {:08X}", qos_guest);
+      }
+    }).detach();
+  } else if (event_handle) {
+    if (auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle)) ev->Set(0, false);
+  }
+  if (NetLogOnce("XNetQosLookup", 20))
+    REXKRNL_INFO("NET XNetQosLookup {} address(es) + {} IP(s), {} probes, flags {:X}: all reported contacted [{}]",
+                 uint32_t(cxna), uint32_t(cina), uint32_t(probes), uint32_t(flags), GuestChain());
+  return 0;  // (targets without the host's data yet are answered by the thread above)
