+// space with; nullptr = none. Lets the backend use the frame's exact view-projection.
+extern "C" __declspec(dllexport) void RexWorldMeshSetCamera(const float* cam) {
+  using namespace rex::graphics::d3d12;
+  std::lock_guard<std::mutex> lock(g_world_beam_mutex);
