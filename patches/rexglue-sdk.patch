+// ---------------------------------------------------------------------------
+// World beams (see command_processor.h)
+// ---------------------------------------------------------------------------
+
+namespace {
+std::mutex g_world_beam_mutex;
+std::vector<float> g_world_beams;  // 10 floats per beam: start, end, width, rgb
+// Perf round 5: set with g_world_beams under the mutex; the per-draw beam check
+// skips the mutex while there are no beams.
+std::atomic<bool> g_world_beams_any{false};
+float g_world_beam_camera[12] = {};  // position, right, up, forward (game thread)
+// v0.4.1 (Skateboarding): the camera the world meshes were put into camera space with
+// (same layout, under g_world_beam_mutex). With it the meshes are drawn with the frame's
+// exact view-projection (beam_vp_) instead of that camera + the projection terms, so they
+// sit where the world is even when the drawn camera isn't exactly the camera the game
+// thread read (the board was drawn ~0.4 m towards the camera, over the rider's legs).
+std::atomic<bool> g_world_mesh_cam_any{false};
+float g_world_mesh_camera[12] = {};
+std::atomic<int> g_world_mesh_exact_frames{0}, g_world_mesh_fallback_frames{0};
+std::atomic<float> g_world_vp_wpos{0.0f};
+std::chrono::steady_clock::time_point g_world_beam_time{};
+}  // namespace
+
+static const char kBeamShader[] = R"(
+cbuffer BeamConstants : register(b0) {
+  float4 proj;           // x scale (signed), y scale, x shift, y shift (per unit depth)
+  float4 proj_z;         // z = x * w + y
+  float4 unused0[2];
+  float4 ndc_scale;
+  float4 ndc_offset;
+  uint4 flags;           // x: 1 W not 1/W, 2 XY/W, 4 Z/W; y: beam count
+  float4 cam;
+  float4 beam_start[8];  // w = half width (m)
+  float4 beam_end[8];
+  float4 beam_color[8];
+};
+struct VSOut {
+  float4 pos : SV_Position;
+  float2 uv : TEXCOORD0;
+  nointerpolation uint beam : TEXCOORD1;
+};
+VSOut vs_main(uint vid : SV_VertexID) {
+  VSOut o;
+  uint b = vid / 6u;
+  uint k = vid % 6u;
+  float2 corner[6] = {float2(0, -1), float2(1, -1), float2(0, 1), float2(0, 1), float2(1, -1), float2(1, 1)};
+  float2 c = corner[k];
+  o.uv = c;
+  o.beam = b;
+  float3 s = beam_start[b].xyz;
+  float3 e = beam_end[b].xyz;
+  float3 dir = e - s;
+  float len = length(dir);
+  if (b >= flags.y || len < 0.001) {
+    o.pos = float4(0, 0, -2, 1);
+    return o;
+  }
+  dir /= len;
+  o.uv.x = c.x * len;  // metres from the start
+  float3 p = lerp(s, e, c.x);
+  float3 tocam = normalize(cam.xyz - p);
+  float3 side = cross(dir, tocam);
+  float sl = length(side);
+  side = sl > 1e-4 ? side / sl : float3(0, 1, 0);
+  p += side * (c.y * beam_start[b].w);
+  // p is in camera space: x right, y up, z forward (depth).
+  float4 pos = float4(proj.x * p.x + proj.z * p.z, proj.y * p.y + proj.w * p.z,
+                      proj_z.x * p.z + proj_z.y, p.z);
+  if ((flags.x & 1u) == 0u) pos.w = 1.0 / pos.w;
+  if ((flags.x & 2u) != 0u) pos.xy *= pos.w;
+  if ((flags.x & 4u) != 0u) pos.z *= pos.w;
+  pos.xyz = pos.xyz * ndc_scale.xyz;
+  pos.xyz = mad(ndc_offset.xyz, pos.www, pos.xyz);
+  o.pos = pos;
+  return o;
+}
+float4 ps_main(VSOut i) : SV_Target0 {
+  float v = i.uv.y;
+  float glow = exp(-v * v * 3.0);
+  float core = exp(-v * v * 45.0);
+  float3 col = beam_color[i.beam].rgb * glow * 1.4 + core * float3(1.0, 0.9, 0.85) * 1.2;
+  // Solid from the eye (user 2026-10-03: attached to the eyes); 1 cm fade
+  // only so the end cap isn't a hard edge.
+  col *= saturate(i.uv.x / 0.01);
+  return float4(col, 0.0);
+}
+)";
+
+bool D3D12CommandProcessor::BeamInitialize() {
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile"))
+               : nullptr;
+  if (!compile) {
+    REXGPU_ERROR("World beams: d3dcompiler_47.dll / D3DCompile not available");
+    return false;
+  }
+  auto build = [&](const char* entry, const char* target, std::vector<uint8_t>& out) {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(kBeamShader, sizeof(kBeamShader) - 1, "world_beams", nullptr, nullptr,
+                         entry, target, 1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXGPU_ERROR("World beams: {} compiler output: {}", entry,
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()),
+                               errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) {
+      REXGPU_ERROR("World beams: failed to compile {} (0x{:08X})", entry, uint32_t(hr));
+      return false;
+    }
+    out.assign(static_cast<const uint8_t*>(code->GetBufferPointer()),
+               static_cast<const uint8_t*>(code->GetBufferPointer()) + code->GetBufferSize());
+    code->Release();
+    return true;
+  };
+  if (!build("vs_main", "vs_5_1", beam_vs_) || !build("ps_main", "ps_5_1", beam_ps_)) {
+    return false;
+  }
+  D3D12_ROOT_PARAMETER parameter = {};
+  parameter.ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+  parameter.Descriptor.ShaderRegister = 0;
+  parameter.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 1;
+  desc.pParameters = &parameter;
+  beam_root_signature_ = ui::d3d12::util::CreateRootSignature(GetD3D12Provider(), desc);
+  if (!beam_root_signature_) {
+    REXGPU_ERROR("World beams: failed to create the root signature");
+    return false;
+  }
+  REXGPU_INFO("World beams: initialized");
+  return true;
+}
+
+// A main colour pass draw: its projection, viewport transform and pass.
+void D3D12CommandProcessor::BeamCapture(uint32_t zfunc) {
+  const RegisterFile& regs = *register_file_;
+  float c[4][4];
+  std::memcpy(c, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * 4], sizeof(c));
+  std::memcpy(beam_c_, c, sizeof(c));
+  for (uint32_t i = 0; i < 3; ++i) {
+    beam_ndc_scale_[i] = system_constants_.ndc_scale[i];
+    beam_ndc_offset_[i] = system_constants_.ndc_offset[i];
+  }
+  const uint32_t sys_flags = system_constants_.flags;
+  beam_flags_ = ((sys_flags & DxbcShaderTranslator::kSysFlag_WNotReciprocal) ? 1u : 0u) |
+                ((sys_flags & DxbcShaderTranslator::kSysFlag_XYDividedByW) ? 2u : 0u) |
+                ((sys_flags & DxbcShaderTranslator::kSysFlag_ZDividedByW) ? 4u : 0u);
+  beam_zfunc_ = zfunc;
+  beam_main_pitch_ = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+  beam_c_valid_ = true;
+  ++beam_main_draws_;
+  BeamCheckExact();
+}
+
+// World-space geometry (no model rotation / offset): c4..c7 is the frame's
+// view-projection. Recognised by its W row matching the camera (forward and
+// position), so the beams line up with the frame being drawn.
+void D3D12CommandProcessor::BeamCheckExact() {
+  const RegisterFile& regs = *register_file_;
+  float c[4][4];
+  std::memcpy(c, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * 4], sizeof(c));
+  float cam[12];
+  const bool beams_on = g_world_beams_any.load(std::memory_order_relaxed);
+  if (!beams_on && !g_world_mesh_cam_any.load(std::memory_order_relaxed)) return;
+  {
+    std::lock_guard<std::mutex> lock(g_world_beam_mutex);
+    if (beams_on && !g_world_beams.empty()) std::memcpy(cam, g_world_beam_camera, sizeof(cam));
+    else if (g_world_mesh_cam_any.load(std::memory_order_relaxed)) std::memcpy(cam, g_world_mesh_camera, sizeof(cam));
+    else return;
+  }
+  const float wl = std::sqrt(c[3][0] * c[3][0] + c[3][1] * c[3][1] + c[3][2] * c[3][2]);
+  if (wl < 1e-4f) return;
+  const float dotf = (c[3][0] * cam[9] + c[3][1] * cam[10] + c[3][2] * cam[11]) / wl;
+  const float wpos = (c[3][0] * cam[0] + c[3][1] * cam[1] + c[3][2] * cam[2] + c[3][3]) / wl;
+  if (dotf > 0.999f && std::fabs(wpos) < 3.0f) {
+    std::memcpy(beam_vp_, c, sizeof(c));
+    beam_vp_exact_ = true;
+    g_world_vp_wpos.store(wpos, std::memory_order_relaxed);
+  }
+  // Diagnostics (file world_beams.log next to the exe, first frames with beams).
+  if (false) {
+    ++beam_diag_frame_;
+    if (FILE* f = std::fopen("world_beams.log", beam_diag_lines_ ? "a" : "w")) {
+      std::fprintf(f, "frame %llu main %u: c4 %.4f %.4f %.4f %.3f | c5 %.4f %.4f %.4f %.3f | c6 %.5f %.5f %.5f %.4f | "
+                      "c7 %.4f %.4f %.4f %.3f | dotF %.5f wpos %.3f | cam %.2f %.2f %.2f F %.4f %.4f %.4f U %.4f %.4f %.4f\n",
+                   (unsigned long long)beam_stat_frames_, beam_main_draws_, c[0][0], c[0][1], c[0][2], c[0][3],
+                   c[1][0], c[1][1], c[1][2], c[1][3], c[2][0], c[2][1], c[2][2], c[2][3], c[3][0], c[3][1],
+                   c[3][2], c[3][3], dotf, wpos, cam[0], cam[1], cam[2], cam[9], cam[10], cam[11], cam[6],
+                   cam[7], cam[8]);
+      std::fclose(f);
+    }
+    ++beam_diag_lines_;
+  }
+}
+
+void D3D12CommandProcessor::BeamDraw() {
+  if (beam_drawn_this_frame_ || !beam_c_valid_) return;
+  auto skip = [&](uint32_t why) {
+    ++beam_stat_skip_;
+    beam_last_skip_ = why;
+  };
+  std::vector<float> beams;
+  float cam[12];
+  {
+    std::lock_guard<std::mutex> lock(g_world_beam_mutex);
+    if (g_world_beams.empty() ||
+        std::chrono::steady_clock::now() - g_world_beam_time > std::chrono::milliseconds(150)) {
+      return;
+    }
+    beams = g_world_beams;
+    std::memcpy(cam, g_world_beam_camera, sizeof(cam));
+  }
+  // Only the resolve that ends the main colour pass.
+  if (beam_main_draws_ < 20) return skip(1);
+  const RegisterFile& regs = *register_file_;
+  const auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  if (si.surface_pitch != beam_main_pitch_) return skip(2);
+  if (si.msaa_samples != xenos::MsaaSamples::k1X) return skip(3);
+  if (render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) return skip(4);
+  uint32_t formats[1 + xenos::kMaxColorRenderTargets];
+  const uint32_t bits = render_target_cache_->GetLastUpdateBoundRenderTargets(formats);
+  if ((bits & 3u) != 3u) return skip(5);
+  if (!beam_init_tried_) {
+    beam_init_tried_ = true;
+    beam_init_ok_ = BeamInitialize();
+  }
+  if (!beam_init_ok_) return skip(6);
+
+  // Depth test direction from the projection itself (the main pass's own
+  // compare function is for its equal-depth pass and says nothing about which
+  // way is nearer): does depth grow or shrink with distance?
+  bool depth_grows = true;
+  {
+    const float(*c)[4] = beam_c_;
+    auto dot3 = [](const float* a, const float* b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; };
+    const float w2 = std::max(1e-8f, dot3(c[3], c[3]));
+    const float a = dot3(c[2], c[3]) / w2, b = (c[2][3] - a * c[3][3]) / std::sqrt(w2);
+    auto ndc_z = [&](float w) { return ((a * w + b) / w) * beam_ndc_scale_[2] + beam_ndc_offset_[2]; };
+    depth_grows = ndc_z(100.0f) > ndc_z(2.0f);
+  }
+  // Right Ctrl + B cycles the depth test for testing: 0 = automatic from the
+  // projection, 1 = the other way round, 2 = off (whole beam always visible).
+  static int depth_mode = 0;  // automatic (LESS_EQUAL here): the one that hides the beam behind the head
+  static bool f10_was = false;
+  const bool f10 = (GetAsyncKeyState(VK_RCONTROL) & 0x8000) != 0 && (GetAsyncKeyState('B') & 0x8000) != 0;
+  if (f10 && !f10_was) {
+    depth_mode = (depth_mode + 1) % 3;
+    REXLOG_INFO("World beams: depth test mode {} ({})", depth_mode,
+                depth_mode == 0 ? "automatic" : depth_mode == 1 ? "reversed" : "off");
+  }
+  f10_was = f10;
+  bool nearer_is_less = depth_grows;
+  if (depth_mode == 1) nearer_is_less = !nearer_is_less;
+  const uint32_t depth_func = depth_mode == 2 ? uint32_t(D3D12_COMPARISON_FUNC_ALWAYS)
+                              : nearer_is_less ? uint32_t(D3D12_COMPARISON_FUNC_LESS_EQUAL)
+                                               : uint32_t(D3D12_COMPARISON_FUNC_GREATER_EQUAL);
+  // Pipeline for these render target formats.
+  uint64_t key = uint64_t(bits) | (uint64_t(depth_func) << 8);
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    key = key * 0x100000001B3ull ^ formats[i];
+  }
+  ID3D12PipelineState* pipeline = nullptr;
+  auto found = beam_pipelines_.find(key);
+  if (found != beam_pipelines_.end()) {
+    pipeline = found->second;
+  } else {
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC d = {};
+    d.pRootSignature = beam_root_signature_;
+    d.VS.pShaderBytecode = beam_vs_.data();
+    d.VS.BytecodeLength = beam_vs_.size();
+    d.PS.pShaderBytecode = beam_ps_.data();
+    d.PS.BytecodeLength = beam_ps_.size();
+    d.SampleMask = UINT_MAX;
+    d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    d.RasterizerState.DepthClipEnable = TRUE;
+    d.DepthStencilState.DepthEnable = TRUE;
+    d.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+    d.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC(depth_func);
+    d.DSVFormat = D3D12RenderTargetCache::GetDepthDSVDXGIFormat(
+        xenos::DepthRenderTargetFormat(formats[0]));
+    d.BlendState.IndependentBlendEnable = TRUE;
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (!(bits & (2u << i))) continue;
+      d.NumRenderTargets = i + 1;
+      d.RTVFormats[i] = render_target_cache_->GetColorDrawDXGIFormat(
+          xenos::ColorRenderTargetFormat(formats[1 + i]));
+      D3D12_RENDER_TARGET_BLEND_DESC& blend = d.BlendState.RenderTarget[i];
+      if (i == 0) {
+        blend.BlendEnable = TRUE;
+        blend.SrcBlend = D3D12_BLEND_ONE;
+        blend.DestBlend = D3D12_BLEND_ONE;
+        blend.BlendOp = D3D12_BLEND_OP_ADD;
+        blend.SrcBlendAlpha = D3D12_BLEND_ZERO;
+        blend.DestBlendAlpha = D3D12_BLEND_ONE;
+        blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+        blend.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_RED | D3D12_COLOR_WRITE_ENABLE_GREEN |
+                                      D3D12_COLOR_WRITE_ENABLE_BLUE;
+      } else {
+        blend.RenderTargetWriteMask = 0;
+      }
+    }
+    d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    d.SampleDesc.Count = 1;
+    ID3D12Device* device = GetD3D12Provider().GetDevice();
+    if (FAILED(device->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&pipeline)))) {
+      pipeline = nullptr;
+    }
+    beam_pipelines_[key] = pipeline;
+    REXGPU_INFO("World beams: pipeline {} (RT0 format {}, depth format {}, zfunc {})",
+                pipeline ? "created" : "FAILED", formats[1], formats[0], beam_zfunc_);
+  }
+  if (!pipeline) return skip(7);
+
+  // Projection: the frame's own view-projection when a world-space draw had
+  // it, otherwise the camera the beams came with plus the projection terms of
+  // the last main pass draw (x / y scale and the depth mapping z = A w + B).
+  struct BeamConstants {
+    float proj[4];
+    float proj_z[4];
+    float unused0[2][4];
+    float ndc_scale[4];
+    float ndc_offset[4];
+    uint32_t flags[4];
+    float cam[4];
+    float start[8][4];
+    float end[8][4];
+    float color[8][4];
+  };
+  D3D12_GPU_VIRTUAL_ADDRESS cb_address;
+  auto* bc = reinterpret_cast<BeamConstants*>(constant_buffer_pool_->Request(
+      frame_current_, sizeof(BeamConstants), D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, nullptr,
+      nullptr, &cb_address));
+  if (!bc) return skip(8);
+  std::memset(bc, 0, sizeof(*bc));
+  {
+    // The projection of the frame being drawn (from the last main pass draw:
+    // its c4..c7 = projection * view * model; model has no scale, so the
+    // rows split into scale, shift along the view direction, and depth).
+    const float(*c)[4] = beam_c_;
+    auto dot3 = [](const float* a, const float* b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; };
+    const float w2 = std::max(1e-8f, dot3(c[3], c[3]));
+    const float kx = dot3(c[0], c[3]) / w2, ky = dot3(c[1], c[3]) / w2, a = dot3(c[2], c[3]) / w2;
+    float px[3], py[3];
+    for (int k = 0; k < 3; ++k) { px[k] = c[0][k] - kx * c[3][k]; py[k] = c[1][k] - ky * c[3][k]; }
+    const float wl = std::sqrt(w2);
+    const float sx = std::sqrt(dot3(px, px)) / wl, sy = std::sqrt(dot3(py, py)) / wl;
+    // Camera-space x is up x forward (see RexWorldBeamsCamera); the sign of
+    // the projection's x axis relative to that.
+    const float cross[3] = {py[1] * c[3][2] - py[2] * c[3][1], py[2] * c[3][0] - py[0] * c[3][2],
+                            py[0] * c[3][1] - py[1] * c[3][0]};
+    const float sgn = dot3(px, cross) >= 0.0f ? 1.0f : -1.0f;
+    bc->proj[0] = sgn * sx;
+    bc->proj[1] = sy;
+    bc->proj[2] = kx;
+    bc->proj[3] = ky;
+    bc->proj_z[0] = a;
+    bc->proj_z[1] = (c[2][3] - a * c[3][3]) / wl;
+  }
+  for (int k = 0; k < 3; ++k) {
+    bc->ndc_scale[k] = beam_ndc_scale_[k];
+    bc->ndc_offset[k] = beam_ndc_offset_[k];
+    bc->cam[k] = 0.0f;  // beams are in camera space
+  }
+  const uint32_t count = uint32_t(std::min<size_t>(8, beams.size() / 10));
+  bc->flags[0] = beam_flags_;
+  bc->flags[1] = count;
+  for (uint32_t i = 0; i < count; ++i) {
+    const float* s = &beams[i * 10];
+    for (int k = 0; k < 3; ++k) {
+      bc->start[i][k] = s[k];
+      bc->end[i][k] = s[3 + k];
+      bc->color[i][k] = s[7 + k];
+    }
+    bc->start[i][3] = std::max(0.005f, s[6] * 0.01f);  // half width in metres
+  }
+  SetExternalPipeline(pipeline);
+  SetExternalGraphicsRootSignature(beam_root_signature_);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(0, cb_address);
+  SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  deferred_command_list_.D3DDrawInstanced(count * 6, 1, 0, 0);
+  beam_drawn_this_frame_ = true;
+  ++beam_stat_drawn_;
+}
+
+// ---------------------------------------------------------------------------
+// World meshes (see command_processor.h)
+// ---------------------------------------------------------------------------
+
+namespace {
+std::mutex g_world_mesh_mutex;
+// Stored per vertex (v0.4): 8 floats = camera-space position, 1, rgb, 0 (24 per triangle).
+// The 12-float API (one colour per triangle) is expanded on arrival; the V2 API has a
+// colour per corner, so the board can be smooth-shaded.
+std::vector<float> g_world_mesh;
+std::chrono::steady_clock::time_point g_world_mesh_time{};
+// Shadows (v0.3): same layout, the first colour value is the darkening (alpha); blended, no depth write.
+std::vector<float> g_world_shadow;
+std::chrono::steady_clock::time_point g_world_shadow_time{};
+// v0.4.4: depth-only occluders (drawn first, no colour): stand-ins for things the game drew
+// without leaving their depth for us (the rider's legs - the board was drawn over them).
+std::vector<float> g_world_occluder;
+std::chrono::steady_clock::time_point g_world_occluder_time{};
+// skate v0.9.4: body capsules tested per pixel in the board's shader (camera space, 8 floats each:
+// a.xyz r, b.xyz 0) - nothing written to depth, so nothing the game draws later is hidden by them.
+constexpr int kMaxWorldCapsules = 24;
+std::vector<float> g_world_capsules;
+std::chrono::steady_clock::time_point g_world_capsules_time{};
+// 0 = colours are gamma-space and turned linear for float (HDR) colour targets, 1 = always
+// linearised, 2 = never (RexWorldMeshOptions). Last main-pass RT0 format, -1 = none yet.
+std::atomic<int> g_world_mesh_colour_mode{0};
+std::atomic<int> g_world_mesh_rt0_format{-1};
+void WorldTrisStore(std::vector<float>& dst, const float* data, int count, bool per_corner) {
+  dst.clear();
+  if (!data || count <= 0 || count > 8192) return;
+  dst.resize(size_t(count) * 24);
+  for (int t = 0; t < count; ++t) {
+    const float* s = data + size_t(t) * (per_corner ? 18 : 12);
+    float* o = dst.data() + size_t(t) * 24;
+    for (int k = 0; k < 3; ++k) {
+      o[k * 8 + 0] = s[k * 3]; o[k * 8 + 1] = s[k * 3 + 1]; o[k * 8 + 2] = s[k * 3 + 2]; o[k * 8 + 3] = 1.0f;
+      for (int c = 0; c < 3; ++c) o[k * 8 + 4 + c] = per_corner ? s[9 + k * 3 + c] : s[9 + c];
+      o[k * 8 + 7] = 0.0f;
+    }
+  }
+}
+}  // namespace
+
+static const char kMeshShader[] = R"(
+cbuffer MeshConstants : register(b0) {
+  float4 proj;
+  float4 proj_z;
+  float4 ndc_scale;
+  float4 ndc_offset;
+  uint4 flags;           // x: W / XY / Z flags, y: 1 = linear colour target, z: 1 = exact matrix m
+  float4 m[4];           // camera space -> the frame's clip space (exact view-projection)
+  uint4 cap_count;       // x: body capsules in caps
+  float4 caps[48];       // per capsule: (a, r), (b, 0) in camera space
+};
+StructuredBuffer<float4> tris : register(t0);  // per vertex: (position, 1), (rgb, 0)
+struct VSOut {
+  float4 pos : SV_Position;
+  float3 col : COLOR0;
+  float3 cp : TEXCOORD0;  // camera-space position (eye at 0)
+};
+// Distance along the unit ray (from the eye) to a capsule, -1 = missed (iq's capsule intersection).
+float CapsuleHit(float3 rd, float3 pa, float3 pb, float r) {
+  float3 ba = pb - pa;
+  float3 oa = -pa;
+  float baba = dot(ba, ba);
+  float bard = dot(ba, rd);
+  float baoa = dot(ba, oa);
+  float rdoa = dot(rd, oa);
+  float oaoa = dot(oa, oa);
+  float qa = baba - bard * bard;
+  float qb = baba * rdoa - baoa * bard;
+  float qc = baba * oaoa - baoa * baoa - r * r * baba;
+  float h = qb * qb - qa * qc;
+  float result = -1.0;
+  if (h >= 0.0) {
+    float y = -1.0;
+    bool body = false;
+    if (qa > 1e-6) {
+      float t = (-qb - sqrt(h)) / qa;
+      y = baoa + t * bard;
+      if (y > 0.0 && y < baba) { result = t; body = true; }
+    }
+    if (!body) {
+      float3 oc = (y <= 0.0) ? oa : -pb;
+      float cb = dot(rd, oc);
+      float cc = dot(oc, oc) - r * r;
+      float ch = cb * cb - cc;
+      if (ch > 0.0) result = -cb - sqrt(ch);
+    }
+  }
+  return result;
+}
+VSOut vs_main(uint vid : SV_VertexID) {
+  VSOut o;
+  float4 a = tris[vid * 2u];
+  o.col = tris[vid * 2u + 1u].rgb;
+  float3 p = a.xyz;
+  float4 pos = float4(proj.x * p.x + proj.z * p.z, proj.y * p.y + proj.w * p.z,
+                      proj_z.x * p.z + proj_z.y, p.z);
+  if ((flags.z & 1u) != 0u) {
+    float4 p1 = float4(p, 1.0);
+    pos = float4(dot(m[0], p1), dot(m[1], p1), dot(m[2], p1), dot(m[3], p1));
+  }
+  if ((flags.x & 1u) == 0u) pos.w = 1.0 / pos.w;
+  if ((flags.x & 2u) != 0u) pos.xy *= pos.w;
+  if ((flags.x & 4u) != 0u) pos.z *= pos.w;
+  pos.xyz = pos.xyz * ndc_scale.xyz;
+  pos.xyz = mad(ndc_offset.xyz, pos.www, pos.xyz);
+  if (p.z < 0.05) pos = float4(0, 0, -2, 1);
+  o.pos = pos;
+  o.cp = p;
+  return o;
+}
+float4 ps_main(VSOut i) : SV_Target0 {
+  float dist = length(i.cp);
+  float3 rd = i.cp / max(dist, 1e-4);
+  uint ncap = min(cap_count.x, 24u);
+  bool hidden = false;
+  [loop] for (uint k = 0u; k < ncap; ++k) {
+    float4 c0 = caps[k * 2u];
+    float4 c1 = caps[k * 2u + 1u];
+    float t = CapsuleHit(rd, c0.xyz, c1.xyz, c0.w);
+    if (t > 0.0 && t < dist - 0.005) hidden = true;  // the body is in front of the board here
+  }
+  if (hidden) discard;
+  float3 c = saturate(i.col);
+  if ((flags.y & 1u) != 0u) c = pow(max(c, 0.0), 2.2);  // linear (HDR) colour target
+  return float4(c, 1.0);
+}
+float4 ps_shadow(VSOut i) : SV_Target0 {
+  return float4(0.0, 0.0, 0.0, saturate(i.col.r));
+}
+)";
+
+bool D3D12CommandProcessor::MeshInitialize() {
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile"))
+               : nullptr;
+  if (!compile) {
+    REXGPU_ERROR("World meshes: d3dcompiler_47.dll / D3DCompile not available");
+    return false;
+  }
+  auto build = [&](const char* entry, const char* target, std::vector<uint8_t>& out) {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(kMeshShader, sizeof(kMeshShader) - 1, "world_meshes", nullptr, nullptr,
+                         entry, target, 1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXGPU_ERROR("World meshes: {} compiler output: {}", entry,
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()),
+                               errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) {
+      REXGPU_ERROR("World meshes: failed to compile {} (0x{:08X})", entry, uint32_t(hr));
+      return false;
+    }
+    out.assign(static_cast<const uint8_t*>(code->GetBufferPointer()),
+               static_cast<const uint8_t*>(code->GetBufferPointer()) + code->GetBufferSize());
+    code->Release();
+    return true;
+  };
+  if (!build("vs_main", "vs_5_1", mesh_vs_) || !build("ps_main", "ps_5_1", mesh_ps_) ||
+      !build("ps_shadow", "ps_5_1", mesh_shadow_ps_)) {
+    return false;
+  }
+  D3D12_ROOT_PARAMETER parameters[2] = {};
+  parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+  parameters[0].Descriptor.ShaderRegister = 0;
+  parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  parameters[1].Descriptor.ShaderRegister = 0;
+  parameters[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 2;
+  desc.pParameters = parameters;
+  mesh_root_signature_ = ui::d3d12::util::CreateRootSignature(GetD3D12Provider(), desc);
+  if (!mesh_root_signature_) {
+    REXGPU_ERROR("World meshes: failed to create the root signature");
+    return false;
+  }
+  REXGPU_INFO("World meshes: initialized");
+  return true;
+}
+
+void D3D12CommandProcessor::MeshDraw() {
+  if (mesh_drawn_this_frame_ || !beam_c_valid_) return;
+  std::vector<float> tris, shadow, occluder, capsules;
+  {
+    std::lock_guard<std::mutex> lock(g_world_mesh_mutex);
+    const auto now = std::chrono::steady_clock::now();
+    if (!g_world_capsules.empty() && now - g_world_capsules_time <= std::chrono::milliseconds(150)) capsules = g_world_capsules;
+    if (!g_world_occluder.empty() && now - g_world_occluder_time <= std::chrono::milliseconds(150)) occluder = g_world_occluder;
+    if (!g_world_mesh.empty() && now - g_world_mesh_time <= std::chrono::milliseconds(150)) tris = g_world_mesh;
+    if (!g_world_shadow.empty() && now - g_world_shadow_time <= std::chrono::milliseconds(150)) shadow = g_world_shadow;
+    if (tris.empty() && shadow.empty()) return;  // (occluders alone are not drawn)
+  }
+  // The resolve that ends the main colour pass only (as the beams).
+  if (beam_main_draws_ < 20) return;
+  const RegisterFile& regs = *register_file_;
+  const auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  if (si.surface_pitch != beam_main_pitch_) return;
+  if (si.msaa_samples != xenos::MsaaSamples::k1X) return;
+  if (render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) return;
+  uint32_t formats[1 + xenos::kMaxColorRenderTargets];
+  const uint32_t bits = render_target_cache_->GetLastUpdateBoundRenderTargets(formats);
+  if ((bits & 3u) != 3u) return;
+  if (!mesh_init_tried_) {
+    mesh_init_tried_ = true;
+    mesh_init_ok_ = MeshInitialize();
+  }
+  if (!mesh_init_ok_) return;
+  bool depth_grows = true;
+  {
+    const float(*c)[4] = beam_c_;
+    auto dot3 = [](const float* a, const float* b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; };
+    const float w2 = std::max(1e-8f, dot3(c[3], c[3]));
+    const float a = dot3(c[2], c[3]) / w2, b = (c[2][3] - a * c[3][3]) / std::sqrt(w2);
+    auto ndc_z = [&](float w) { return ((a * w + b) / w) * beam_ndc_scale_[2] + beam_ndc_offset_[2]; };
+    depth_grows = ndc_z(100.0f) > ndc_z(2.0f);
+  }
+  const uint32_t depth_func = depth_grows ? uint32_t(D3D12_COMPARISON_FUNC_LESS_EQUAL)
+                                          : uint32_t(D3D12_COMPARISON_FUNC_GREATER_EQUAL);
+  auto get_pipeline = [&](bool shadow_pass, bool occluder_pass = false) -> ID3D12PipelineState* {
+  uint64_t key = uint64_t(bits) | (uint64_t(depth_func) << 8) | (shadow_pass ? (1ull << 40) : 0ull) | (occluder_pass ? (1ull << 41) : 0ull);
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    key = key * 0x100000001B3ull ^ formats[i];
+  }
+  ID3D12PipelineState* pipeline = nullptr;
+  auto found = mesh_pipelines_.find(key);
+  if (found != mesh_pipelines_.end()) {
+    pipeline = found->second;
+  } else {
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC d = {};
+    d.pRootSignature = mesh_root_signature_;
+    d.VS.pShaderBytecode = mesh_vs_.data();
+    d.VS.BytecodeLength = mesh_vs_.size();
+    const std::vector<uint8_t>& ps = shadow_pass ? mesh_shadow_ps_ : mesh_ps_;
+    d.PS.pShaderBytecode = ps.data();
+    d.PS.BytecodeLength = ps.size();
+    d.SampleMask = UINT_MAX;
+    d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    d.RasterizerState.DepthClipEnable = TRUE;
+    d.DepthStencilState.DepthEnable = TRUE;
+    d.DepthStencilState.DepthWriteMask = shadow_pass ? D3D12_DEPTH_WRITE_MASK_ZERO : D3D12_DEPTH_WRITE_MASK_ALL;
+    d.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC(depth_func);
+    d.DSVFormat = D3D12RenderTargetCache::GetDepthDSVDXGIFormat(
+        xenos::DepthRenderTargetFormat(formats[0]));
+    d.BlendState.IndependentBlendEnable = TRUE;
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (!(bits & (2u << i))) continue;
+      d.NumRenderTargets = i + 1;
+      d.RTVFormats[i] = render_target_cache_->GetColorDrawDXGIFormat(
+          xenos::ColorRenderTargetFormat(formats[1 + i]));
+      D3D12_RENDER_TARGET_BLEND_DESC& blend = d.BlendState.RenderTarget[i];
+      blend.RenderTargetWriteMask =
+          (i == 0 && !occluder_pass) ? (D3D12_COLOR_WRITE_ENABLE_RED | D3D12_COLOR_WRITE_ENABLE_GREEN |
+                                        D3D12_COLOR_WRITE_ENABLE_BLUE)
+                                     : 0;
+      if (i == 0 && shadow_pass) {
+        blend.BlendEnable = TRUE;
+        blend.SrcBlend = D3D12_BLEND_SRC_ALPHA;
+        blend.DestBlend = D3D12_BLEND_INV_SRC_ALPHA;
+        blend.BlendOp = D3D12_BLEND_OP_ADD;
+        blend.SrcBlendAlpha = D3D12_BLEND_ZERO;
+        blend.DestBlendAlpha = D3D12_BLEND_ONE;
+        blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+      }
+    }
+    d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    d.SampleDesc.Count = 1;
+    ID3D12Device* device = GetD3D12Provider().GetDevice();
+    if (FAILED(device->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&pipeline)))) {
+      pipeline = nullptr;
+    }
+    mesh_pipelines_[key] = pipeline;
+    REXGPU_INFO("World meshes: {} pipeline {} (RT0 format {}, depth format {})", shadow_pass ? "shadow" : "solid",
+                pipeline ? "created" : "FAILED", formats[1], formats[0]);
+  }
+  return pipeline;
+  };
+  struct MeshConstants {
+    float proj[4];
+    float proj_z[4];
+    float ndc_scale[4];
+    float ndc_offset[4];
+    uint32_t flags[4];
+    float m[4][4];
+    uint32_t cap_count[4];
+    float caps[kMaxWorldCapsules * 2][4];
+  };
+  D3D12_GPU_VIRTUAL_ADDRESS cb_address;
+  auto* mc = reinterpret_cast<MeshConstants*>(constant_buffer_pool_->Request(
+      frame_current_, sizeof(MeshConstants), D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, nullptr,
+      nullptr, &cb_address));
+  if (!mc) return;
+  std::memset(mc, 0, sizeof(*mc));
+  {
+    const float(*c)[4] = beam_c_;
+    auto dot3 = [](const float* a, const float* b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; };
+    const float w2 = std::max(1e-8f, dot3(c[3], c[3]));
+    const float kx = dot3(c[0], c[3]) / w2, ky = dot3(c[1], c[3]) / w2, a = dot3(c[2], c[3]) / w2;
+    float px[3], py[3];
+    for (int k = 0; k < 3; ++k) { px[k] = c[0][k] - kx * c[3][k]; py[k] = c[1][k] - ky * c[3][k]; }
+    const float wl = std::sqrt(w2);
+    const float sx = std::sqrt(dot3(px, px)) / wl, sy = std::sqrt(dot3(py, py)) / wl;
+    const float cross[3] = {py[1] * c[3][2] - py[2] * c[3][1], py[2] * c[3][0] - py[0] * c[3][2],
+                            py[0] * c[3][1] - py[1] * c[3][0]};
+    const float sgn = dot3(px, cross) >= 0.0f ? 1.0f : -1.0f;
+    mc->proj[0] = sgn * sx;
+    mc->proj[1] = sy;
+    mc->proj[2] = kx;
+    mc->proj[3] = ky;
+    mc->proj_z[0] = a;
+    mc->proj_z[1] = (c[2][3] - a * c[3][3]) / wl;
+  }
+  for (int k = 0; k < 3; ++k) {
+    mc->ndc_scale[k] = beam_ndc_scale_[k];
+    mc->ndc_offset[k] = beam_ndc_offset_[k];
+  }
+  mc->flags[0] = beam_flags_;
+  {
+    const size_t n = std::min<size_t>(kMaxWorldCapsules, capsules.size() / 8);
+    mc->cap_count[0] = uint32_t(n);
+    std::memcpy(mc->caps, capsules.data(), n * 8 * sizeof(float));
+  }
+  {
+    // Exact: clip = VP * (eye + x right + y up + z forward), normalised like the
+    // projection terms (w = depth in metres).
+    float cam[12];
+    bool have_cam = false;
+    if (beam_vp_exact_ && g_world_mesh_cam_any.load(std::memory_order_relaxed)) {
+      std::lock_guard<std::mutex> lock(g_world_beam_mutex);
+      std::memcpy(cam, g_world_mesh_camera, sizeof(cam));
+      have_cam = true;
+    }
+    const float(*v)[4] = beam_vp_;
+    const float wl = std::sqrt(v[3][0] * v[3][0] + v[3][1] * v[3][1] + v[3][2] * v[3][2]);
+    if (have_cam && wl > 1e-6f) {
+      const float* E = cam;
+      const float* U = cam + 6;
+      const float* F = cam + 9;
+      const float X[3] = {U[1] * F[2] - U[2] * F[1], U[2] * F[0] - U[0] * F[2], U[0] * F[1] - U[1] * F[0]};
+      for (int i = 0; i < 4; ++i) {
+        const float* r = v[i];
+        mc->m[i][0] = (r[0] * X[0] + r[1] * X[1] + r[2] * X[2]) / wl;
+        mc->m[i][1] = (r[0] * U[0] + r[1] * U[1] + r[2] * U[2]) / wl;
+        mc->m[i][2] = (r[0] * F[0] + r[1] * F[1] + r[2] * F[2]) / wl;
+        mc->m[i][3] = (r[0] * E[0] + r[1] * E[1] + r[2] * E[2] + r[3]) / wl;
+      }
+      mc->flags[2] = 1u;
+      g_world_mesh_exact_frames.fetch_add(1, std::memory_order_relaxed);
+    } else {
+      g_world_mesh_fallback_frames.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  {
+    const uint32_t f = formats[1];
+    g_world_mesh_rt0_format.store(int(f), std::memory_order_relaxed);
+    const bool float_rt = f == uint32_t(xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT) ||
+                          f == uint32_t(xenos::ColorRenderTargetFormat::k_16_16_FLOAT) ||
+                          f == uint32_t(xenos::ColorRenderTargetFormat::k_16_16_16_16_FLOAT) ||
+                          f == uint32_t(xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT_AS_16_16_16_16) ||
+                          f == uint32_t(xenos::ColorRenderTargetFormat::k_32_FLOAT) ||
+                          f == uint32_t(xenos::ColorRenderTargetFormat::k_32_32_FLOAT);
+    const int mode = g_world_mesh_colour_mode.load(std::memory_order_relaxed);
+    mc->flags[1] = (mode == 1 || (mode == 0 && float_rt)) ? 1u : 0u;
+  }
+  auto draw = [&](const std::vector<float>& list, bool shadow_pass, bool occluder_pass = false) {
+    const uint32_t count = uint32_t(std::min<size_t>(8192, list.size() / 24));
+    if (!count) return;
+    ID3D12PipelineState* pipeline = get_pipeline(shadow_pass, occluder_pass);
+    if (!pipeline) return;
+    D3D12_GPU_VIRTUAL_ADDRESS tri_address;
+    auto* td = reinterpret_cast<float*>(constant_buffer_pool_->Request(
+        frame_current_, size_t(count) * 96, 256, nullptr, nullptr, &tri_address));
+    if (!td) return;
+    std::memcpy(td, list.data(), size_t(count) * 96);
+    SetExternalPipeline(pipeline);
+    SetExternalGraphicsRootSignature(mesh_root_signature_);
+    deferred_command_list_.D3DSetGraphicsRootConstantBufferView(0, cb_address);
+    deferred_command_list_.D3DSetGraphicsRootShaderResourceView(1, tri_address);
+    SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    deferred_command_list_.D3DDrawInstanced(count * 3, 1, 0, 0);
+  };
+  draw(occluder, false, true);
+  draw(tris, false);
+  draw(shadow, true);
+  mesh_drawn_this_frame_ = true;
+  const uint32_t count = uint32_t(tris.size() / 24);
+  if (mesh_stat_drawn_++ == 0) REXGPU_INFO("World meshes: first mesh drawn ({} triangles)", count);
+}
+
 }  // namespace rex::graphics::d3d12
