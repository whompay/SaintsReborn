+}  // namespace rex::graphics::d3d12
+// In-run A/B test "skipmem" (command_processor.cpp AbOnSwap): while >= 0,
+// overrides the direct_resolve_skip_memory file.
+std::atomic<int32_t> g_rex_ab_skipmem{-1};
+namespace rex::graphics::d3d12 {
+
+bool D3D12TextureCache::IsDirectResolveMemorySkipEnabled() {
+  const int32_t ab = g_rex_ab_skipmem.load(std::memory_order_relaxed);
+  if (ab >= 0) return ab == 1 && IsDirectResolveEnabled();
+  static std::atomic<int> enabled{0};
+  static std::atomic<uint64_t> next_check{0};
+  const uint64_t now = GetTickCount64();
+  if (now >= next_check.load(std::memory_order_relaxed)) {
+    next_check.store(now + 500, std::memory_order_relaxed);
+    const bool on = GetFileAttributesW(L"direct_resolve_skip_memory") != INVALID_FILE_ATTRIBUTES;
+    if (enabled.exchange(on ? 1 : 0) != (on ? 1 : 0)) {
+      REXLOG_INFO("Direct resolve memory skip {}", on ? "ON" : "off");
+    }
+  }
+  return enabled.load(std::memory_order_relaxed) == 1 && IsDirectResolveEnabled();
+}
+
+bool D3D12TextureCache::CanSkipResolveMemory(uint32_t base) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (const auto& e : direct_resolves_) {
+    if (e.base == base) {
+      return e.consumer && !e.never_skip && e.consumer_streak >= 3;
+    }
+  }
+  return false;
+}
+
+void D3D12TextureCache::SetDirectResolveMemorySkipped(uint32_t base, bool skipped) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (auto& e : direct_resolves_) {
+    if (e.base == base) {
+      e.memory_stale = skipped;
+      if (skipped) ++direct_resolve_stat_memory_skips_;
+    }
+  }
+}
+
+void D3D12TextureCache::ForgetDirectResolveTexture(const void* texture) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (auto& e : direct_resolves_) {
+    if (e.consumer == texture) {
+      e.consumer = nullptr;
+      if (e.written_to_consumer) e.valid = false;
+      e.written_to_consumer = false;
+    }
+  }
+}
+
+void D3D12TextureCache::OnScaledResolveRangeWrittenByCpu(uint32_t address_first,
+                                                         uint32_t address_last) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (auto& e : direct_resolves_) {
+    if (e.valid && address_first < e.extent_end && e.extent_start <= address_last) {
+      e.valid = false;
+      ++direct_resolve_stat_cpu_invalidated_;
+    }
+  }
+}
