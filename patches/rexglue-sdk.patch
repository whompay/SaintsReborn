+// ---------------------------------------------------------------------------
+// Photo mode capture
+// ---------------------------------------------------------------------------
+namespace {
+std::atomic<bool> g_capture_requested{false};
+std::mutex g_capture_mutex;
+std::vector<uint8_t> g_capture_pixels;  // RGBA8, rows top to bottom
+uint32_t g_capture_w = 0, g_capture_h = 0;
+bool g_capture_ready = false;
+}  // namespace
+
+void D3D12CommandProcessor::CaptureApply(ID3D12Resource* guest_output, uint32_t width, uint32_t height) {
+  // A copy from an earlier frame that the GPU has finished: to RGBA8 (the frame is R10G10B10A2).
+  if (capture_pending_ && submission_completed_ >= capture_submission_) {
+    capture_pending_ = false;
+    void* mapping = nullptr;
+    D3D12_RANGE read_range = {0, SIZE_T(capture_pitch_) * capture_height_};
+    if (capture_readback_ && SUCCEEDED(capture_readback_->Map(0, &read_range, &mapping))) {
+      std::vector<uint8_t> px(size_t(capture_width_) * capture_height_ * 4);
+      for (uint32_t y = 0; y < capture_height_; ++y) {
+        const uint32_t* row = reinterpret_cast<const uint32_t*>(static_cast<const uint8_t*>(mapping) + size_t(y) * capture_pitch_);
+        uint8_t* o = px.data() + size_t(y) * capture_width_ * 4;
+        for (uint32_t x = 0; x < capture_width_; ++x) {
+          const uint32_t v = row[x];
+          o[x * 4 + 0] = uint8_t((v & 1023u) >> 2);
+          o[x * 4 + 1] = uint8_t(((v >> 10) & 1023u) >> 2);
+          o[x * 4 + 2] = uint8_t(((v >> 20) & 1023u) >> 2);
+          o[x * 4 + 3] = 255;
+        }
+      }
+      D3D12_RANGE no_write = {0, 0};
+      capture_readback_->Unmap(0, &no_write);
+      std::lock_guard<std::mutex> lock(g_capture_mutex);
+      g_capture_pixels.swap(px);
+      g_capture_w = capture_width_;
+      g_capture_h = capture_height_;
+      g_capture_ready = true;
+      REXGPU_INFO("Photo mode: frame captured ({}x{})", capture_width_, capture_height_);
+    }
+    capture_readback_.Reset();
+  }
+  if (capture_pending_ || !guest_output || !width || !height || !g_capture_requested.load()) return;
+  g_capture_requested.store(false);
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  const D3D12_RESOURCE_DESC td = guest_output->GetDesc();
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp = {};
+  UINT rows = 0;
+  UINT64 row_size = 0, total = 0;
+  device->GetCopyableFootprints(&td, 0, 1, 0, &fp, &rows, &row_size, &total);
+  D3D12_RESOURCE_DESC bd;
+  ui::d3d12::util::FillBufferResourceDesc(bd, total, D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                             GetD3D12Provider().GetHeapFlagCreateNotZeroed(), &bd,
+                                             D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&capture_readback_)))) {
+    REXGPU_ERROR("Photo mode: could not create the capture buffer");
+    return;
+  }
+  const D3D12_RESOURCE_STATES out_state = ui::d3d12::D3D12Presenter::kGuestOutputInternalState;
+  PushTransitionBarrier(guest_output, out_state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION dst = {}, src = {};
+  dst.pResource = capture_readback_.Get();
+  dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  dst.PlacedFootprint = fp;
+  src.pResource = guest_output;
+  src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  src.SubresourceIndex = 0;
+  deferred_command_list_.D3DCopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+  PushTransitionBarrier(guest_output, D3D12_RESOURCE_STATE_COPY_SOURCE, out_state);
+  capture_submission_ = submission_current_;
+  capture_pending_ = true;
+  capture_width_ = std::min<uint32_t>(width, uint32_t(fp.Footprint.Width));
+  capture_height_ = std::min<uint32_t>(height, fp.Footprint.Height);
+  capture_pitch_ = fp.Footprint.RowPitch;
+}
