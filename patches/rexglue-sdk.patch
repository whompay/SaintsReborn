+void Online() {
+  // Direct player-to-player connections first; Epic's relay only for a
+  // player a direct connection can't be made to (Epic's default,
+  // AllowRelays: it falls back to the relay by itself when NAT traversal
+  // fails, e.g. the Steam Deck networks where direct P2P never connects).
+  // 2026-10-23 every connection was forced through the relay instead: the
+  // extra hop and the relay's packet loss put other players' positions far
+  // behind in matches (shot by players nowhere near on screen).
+  // mp_force_relay.on next to the exe still forces the relay.
+  const bool force_relay = [] {
+    if (FILE* f = std::fopen((ExeDir() + "mp_force_relay.on").c_str(), "rb")) {
+      std::fclose(f);
+      return true;
+    }
+    return false;
+  }();
+  EOS_P2P_SetRelayControlOptions relay{};
+  relay.ApiVersion = EOS_P2P_SETRELAYCONTROL_API_LATEST;
+  relay.RelayControl = force_relay ? EOS_ERelayControl::EOS_RC_ForceRelays : EOS_ERelayControl::EOS_RC_AllowRelays;
+  REXSYS_INFO("EOS LAN: Epic relay {}: {}", force_relay ? "forced (mp_force_relay.on)" : "only when a direct connection fails",
+              R(p_EOS_P2P_SetRelayControl(p2p_if, &relay)));
+  EOS_P2P_AddNotifyPeerConnectionRequestOptions n{};
+  n.ApiVersion = EOS_P2P_ADDNOTIFYPEERCONNECTIONREQUEST_API_LATEST;
+  n.LocalUserId = me;
+  n.SocketId = &socket_id;
+  p_EOS_P2P_AddNotifyPeerConnectionRequest(p2p_if, &n, nullptr,
+                                           [](const EOS_P2P_OnIncomingConnectionRequestInfo* i) { AcceptFrom(i->RemoteUserId); });
+  EOS_P2P_AddNotifyPeerConnectionEstablishedOptions en{};
+  en.ApiVersion = EOS_P2P_ADDNOTIFYPEERCONNECTIONESTABLISHED_API_LATEST;
+  en.LocalUserId = me;
+  en.SocketId = &socket_id;
+  p_EOS_P2P_AddNotifyPeerConnectionEstablished(
+      p2p_if, &en, nullptr, [](const EOS_P2P_OnPeerConnectionEstablishedInfo* i) {
+        auto pit = peers.find(i->RemoteUserId);
+        const std::string who = pit != peers.end() ? pit->second.name + " " + pit->second.puid : PuidString(i->RemoteUserId);
+        REXSYS_INFO("EOS LAN: connection to {} established ({})", who,
+                    i->NetworkType == EOS_ENetworkConnectionType::EOS_NCT_RelayedConnection ? "Epic relay" : "direct");
+      });
+  // Why Epic dropped a player-to-player connection (players losing the host
+  // mid-match: was it a timeout, the other side closing, ...). Sending to that
+  // player again opens a new one.
+  EOS_P2P_AddNotifyPeerConnectionClosedOptions cn{};
+  cn.ApiVersion = EOS_P2P_ADDNOTIFYPEERCONNECTIONCLOSED_API_LATEST;
+  cn.LocalUserId = me;
+  cn.SocketId = &socket_id;
+  p_EOS_P2P_AddNotifyPeerConnectionClosed(p2p_if, &cn, nullptr, [](const EOS_P2P_OnRemoteConnectionClosedInfo* i) {
+    auto pit = peers.find(i->RemoteUserId);
+    const std::string who = pit != peers.end() ? pit->second.name + " " + pit->second.puid : PuidString(i->RemoteUserId);
+    REXSYS_WARN("EOS LAN: connection to {} closed by Epic (reason {})", who, int(i->Reason));
+  });
+  JoinOrCreate();
+}
+void OnLogin(const EOS_Connect_LoginCallbackInfo* d) {
+  if (d->ResultCode == EOS_EResult::EOS_Success) { me = d->LocalUserId; Online(); return; }
+  if (d->ResultCode == EOS_EResult::EOS_InvalidUser && d->ContinuanceToken) {
+    EOS_Connect_CreateUserOptions c{};
+    c.ApiVersion = EOS_CONNECT_CREATEUSER_API_LATEST;
+    c.ContinuanceToken = d->ContinuanceToken;
+    p_EOS_Connect_CreateUser(connect_if, &c, nullptr, [](const EOS_Connect_CreateUserCallbackInfo* u) {
+      if (u->ResultCode != EOS_EResult::EOS_Success) {
+        REXSYS_WARN("EOS LAN: creating the player: {} - trying again in 15 s", R(u->ResultCode));
+        state = State::Failed;
+        rejoin_at = std::chrono::steady_clock::now() + std::chrono::seconds(15);
+        return;
+      }
+      me = u->LocalUserId;
+      Online();
+    });
+    return;
+  }
+  REXSYS_WARN("EOS LAN: login failed: {} - trying again in 15 s", R(d->ResultCode));
+  state = State::Failed;
+  rejoin_at = std::chrono::steady_clock::now() + std::chrono::seconds(15);
+}
+void Login() {
+  state = State::LoggingIn;
+  EOS_Connect_CreateDeviceIdOptions c{};
+  c.ApiVersion = EOS_CONNECT_CREATEDEVICEID_API_LATEST;
+  c.DeviceModel = "PC";
+  p_EOS_Connect_CreateDeviceId(connect_if, &c, nullptr, [](const EOS_Connect_CreateDeviceIdCallbackInfo* d) {
+    if (d->ResultCode != EOS_EResult::EOS_Success && d->ResultCode != EOS_EResult::EOS_DuplicateNotAllowed) {
+      REXSYS_WARN("EOS LAN: device ID: {}", R(d->ResultCode));
+      state = State::Failed;
+      return;
+    }
+    static EOS_Connect_Credentials cred{};
+    cred.ApiVersion = EOS_CONNECT_CREDENTIALS_API_LATEST;
+    cred.Token = nullptr;
+    cred.Type = EOS_EExternalCredentialType::EOS_ECT_DEVICEID_ACCESS_TOKEN;
+    static EOS_Connect_UserLoginInfo info{};
+    info.ApiVersion = EOS_CONNECT_USERLOGININFO_API_LATEST;
+    static std::string name;
+    char user[64] = {};
+    DWORD n = sizeof(user);
+    name = rex::cvar::GetFlagByName("xam_player_name");
+    if (name.empty()) name = GetUserNameA(user, &n) ? std::string(user).substr(0, 30) : "Player";
+    name = rex::system::online::SafeName(name);
+    if (name.empty()) name = "Player";
+    info.DisplayName = name.c_str();
+    EOS_Connect_LoginOptions l{};
+    l.ApiVersion = EOS_CONNECT_LOGIN_API_LATEST;
+    l.Credentials = &cred;
+    l.UserLoginInfo = &info;
+    p_EOS_Connect_Login(connect_if, &l, nullptr, [](const EOS_Connect_LoginCallbackInfo* r) { OnLogin(r); });
+  });
+}
