+              (pf.open ? (pf.concat ? uint64_t(pf.total_vertices) : uint64_t(pf.max_vertices) * pf.count) : 0);
+          REXLOG_INFO("PREPASS FUSE per frame: {:.0f} draws in {:.0f} calls ({:.1f} per call, max {}) | indices "
+                      "{:.0f} padded to {:.0f} (+{:.1f} %, closed batches) | new call because: other command "
+                      "{:.0f}, size ratio {:.0f}, cap {:.0f} (cap {}) | not fused: index buffer type {:.0f}, "
+                      "primitive reset {:.0f}, alignment {:.0f} | concatenated calls {:.0f}, empty draws {:.0f} | v6 strips as "
+                      "lists {:.0f} (mode {})",
