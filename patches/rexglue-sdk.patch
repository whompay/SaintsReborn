+  // the emulated 4x -> 1x depth ownership transfer without a host depth source); dist native_view_seed_f32 = raw
+  // float32 copy (v12p); native_view_seed_swap12 = swap host samples 1 and 2; native_view_seed_rows (text) = rows.
+  bool seed_f32 = false;
+  bool seed_swap12 = false;
