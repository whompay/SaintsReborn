+static bool NativeBridgeEnabled() {
+  const uint64_t now = GetTickCount64();
+  uint64_t next = g_native_bridge.next_enable_poll.load(std::memory_order_relaxed);
+  if (now >= next && g_native_bridge.next_enable_poll.compare_exchange_strong(
+                         next, now + 1000, std::memory_order_relaxed)) {
+    FILE* file = RexFlagFopen("native_bridge_verify");
+    bool dry = false;
+    if (!file) {
+      if (FILE* fd = RexFlagFopen("native_frame_exec_dry")) {
+        std::fclose(fd);
+        dry = true;
+      }
+    }
+    g_nb_dry.store(dry, std::memory_order_relaxed);
+    g_native_bridge.enabled.store(file != nullptr || dry, std::memory_order_release);
+    bool m3a = false;
+    if (file) {
+      std::fclose(file);
+      if (FILE* f2 = RexFlagFopen("native_frame_exec_verify")) {
+        std::fclose(f2);
+        m3a = true;
+      }
+    }
+    g_m3a_on.store(m3a, std::memory_order_relaxed);
+    {  // AGENT_NATIVE30A2 step 2: dist native_exec_own (+ native_exec_own_all), only with native_bridge_verify.
+      // MAIN31: or in dry mode with dist native_exec_own_dry (learning in NativeBridgeDryTake).
+      bool own = false, own_all = false, own_dry = false;
+      if (!file && dry) {
+        if (FILE* fy = RexFlagFopen("native_exec_own_dry")) {
+          std::fclose(fy);
+          own_dry = true;
+        }
+      }
+      g_own_dry.store(own_dry, std::memory_order_relaxed);
+      if (file || own_dry) {
+        if (FILE* fo = RexFlagFopen("native_exec_own")) {
+          std::fclose(fo);
+          own = true;
+          if (FILE* fa = RexFlagFopen("native_exec_own_all")) {
+            std::fclose(fa);
+            own_all = true;
+          }
+        }
+      }
+      if (own != g_own_on.load(std::memory_order_relaxed) || own_all != g_own_all.load(std::memory_order_relaxed)) {
+        REXLOG_INFO("NATIVE OWN RUNS (AGENT_NATIVE30A2 executor step 2): {}", own ? (own_all ? "ON (all proven keys)" : "ON (depth family)") : "off");
+      }
+      g_own_on.store(own, std::memory_order_relaxed);
+      g_own_all.store(own_all, std::memory_order_relaxed);
+      {  // MAIN31
+        bool anyps = false;
+        if (own) {
+          if (FILE* fp = RexFlagFopen("native_exec_own_anyps")) {
+            std::fclose(fp);
+            anyps = true;
+          }
+        }
+        g_own_anyps.store(anyps, std::memory_order_relaxed);
+        bool pred = false;
+        if (own) {
+          if (FILE* fq = RexFlagFopen("native_exec_own_pred")) {
+            std::fclose(fq);
+            pred = true;
+          }
+        }
+        g_own_pred.store(pred, std::memory_order_relaxed);
+      }
+      // Installed once and kept: markers already written by the exe must still be executed after a switch-off.
+      if (own) rex::graphics::g_owned_run_hook.store(&NativeOwnRunHook, std::memory_order_relaxed);
+    }
+    rex::graphics::g_native_marker_hook.store(m3a ? &NativeMarkerHook : nullptr, std::memory_order_relaxed);
+    bool examples = file != nullptr;
+    if (examples) {
+      if (FILE* f3 = RexFlagFopen("native_bridge_examples.off")) {
+        std::fclose(f3);
+        examples = false;
+      }
+    }
+    g_nb_examples_on.store(examples, std::memory_order_relaxed);
+    rex::graphics::g_native_packet_hook.store(examples ? &NativePacketHook : nullptr, std::memory_order_relaxed);
+    rex::graphics::g_native_alu_src_check.store(file != nullptr, std::memory_order_relaxed);
+    if (!examples) g_nb_trace.valid = false;
+  }
+  return g_native_bridge.enabled.load(std::memory_order_acquire);
+}
