+    std::vector<ResolveCopyDumpRectangle> rectangles;
+    GetResolveCopyRectanglesToDump(dump_base, dump_row_length_used, dump_rows, dump_pitch, rectangles);
+    if (rectangles.size() != 1) {
+      return skip(rectangles.empty() ? "0E93C000 no render target" : "0E93C000 several render targets");
+    }
+    auto& msaa_rt = *static_cast<D3D12RenderTarget*>(rectangles[0].render_target);
+    const RenderTargetKey msaa_rt_key = msaa_rt.key();
+    if (msaa_rt_key.is_depth || msaa_rt_key.base_tiles != 0 ||
+        msaa_rt_key.msaa_samples != xenos::MsaaSamples::k4X ||
+        xenos::ColorRenderTargetFormat(msaa_rt_key.resource_format) !=
+            xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+        msaa_rt_key.pitch_tiles_at_32bpp != msaa_edram.pitch_tiles) {
+      return skip("0E93C000 render target");
+    }
+    const uint32_t msaa_pitch = msaa_edram.pitch_tiles;
+    const uint32_t msaa_delta =
+        (msaa_edram.base_tiles - msaa_rt_key.base_tiles) & (xenos::kEdramTileCount - 1);
+    const uint32_t msaa_x0 =
+        ((msaa_delta % msaa_pitch) * (xenos::kEdramTileWidthSamples >> 1) +
+         resolve_info.coordinate_info.edram_offset_x_div_8 * 8) *
+        msaa_scale_x;
+    const uint32_t msaa_y0 =
+        ((msaa_delta / msaa_pitch) * (xenos::kEdramTileHeightSamples >> 1) +
