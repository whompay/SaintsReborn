+static int NativeBridgeSubmitV2(const void* data, uint32_t size) {
+  if (!NativeBridgeEnabled()) return 0;
+  NativeBridgeWindow& w = g_native_bridge.w;
+  if (!data || size != sizeof(RexNativeDrawRecordV2)) {
+    std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
