+// What the fallback PS needs to know about the translated PS + pipeline (one entry per variant key).
+struct FallbackKey {
+  uint32_t interpolator_count;  // TEXCOORD count of the translated PS input signature
+  bool point_coordinates;       // XESPRITETEXCOORD present
+  bool has_texture;
+  uint32_t texture_slot, sampler_slot;  // xe_descriptor_indices slots
+  uint32_t fetch_constant;              // for the sign/gamma bits
+  uint32_t uv_texcoord;                 // TEXCOORD index holding the coordinates
+  uint32_t uv_x, uv_y;                  // components 0..3
+  uint32_t color_targets;               // SV_Target mask (translated PS writes)
+  bool tint;
+  bool solid;
+  uint64_t Pack() const {
+    return uint64_t(interpolator_count) | (uint64_t(point_coordinates) << 5) |
+           (uint64_t(has_texture) << 6) | (uint64_t(texture_slot & 0xFF) << 7) |
+           (uint64_t(sampler_slot & 0xFF) << 15) | (uint64_t(fetch_constant & 0x1F) << 23) |
+           (uint64_t(uv_texcoord & 0x1F) << 28) | (uint64_t(uv_x & 3) << 33) | (uint64_t(uv_y & 3) << 35) |
+           (uint64_t(color_targets & 0xF) << 37) | (uint64_t(tint) << 41) |
+           (uint64_t(solid) << 42);
+  }
+};
