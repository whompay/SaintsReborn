+};
+static const char* const kM3CallBadName[kM3CCount] = {"length", "packet", "op", "nodraw", "drawnotlast", "twodraws",
+                                                      "drawtail"};
+
+struct M3Window {
+  uint64_t sub_shadow = 0, sub_owned = 0, acc_shadow = 0, acc_owned = 0, refused[kM3RCount] = {},
+           call_bad[kM3CCount] = {};
+  uint64_t markers = 0, id_zero = 0, id_miss = 0, holes = 0, shadow_markers = 0, shadow_exact = 0, shadow_diff = 0,
+           shadow_short = 0, shadow_body = 0, owned_markers = 0, owned_exact = 0, owned_diff = 0, owned_len = 0,
+           replays = 0, replay_words = 0, retired = 0, expired = 0, ownable_new = 0, revoked = 0;
+  uint64_t hook_ticks = 0;
