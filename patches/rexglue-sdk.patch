+    // 15 at most), like the online layer uses, instead of "User".
+    const char* env = std::getenv("USERNAME");
+    for (const char* c = env ? env : ""; *c && n.size() < 15; ++c)
+      if ((*c >= 'A' && *c <= 'Z') || (*c >= 'a' && *c <= 'z') || (*c >= '0' && *c <= '9') || *c == ' ' ||
+          *c == '_' || *c == '-' || *c == '.')
+        n += *c;
+  }
