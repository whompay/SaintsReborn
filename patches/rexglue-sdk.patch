+// Per-pair notes for main-pass draws the native view does not draw (VIEW13 diagnosis of missing colour).
+struct NvPairStat {
+  uint64_t vs = 0, ps = 0;
+  uint64_t count = 0;
+  uint32_t reasons = 0;   // bit 0 no colour writes, bit 1 colour code returned no pipeline
+  uint32_t depth_control = 0;  // last RB_DEPTHCONTROL
+  uint64_t z_on = 0;
+};
