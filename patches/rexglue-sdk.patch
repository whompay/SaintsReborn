+               msaa_dest.copy_dest_exp_bias != 0) {
+      msaa_bad = "0E93C000 sig dest format";
+    } else if (msaa_dest.copy_dest_array || msaa_dest.copy_dest_slice || msaa_dest_coords.offset_x_div_8 ||
