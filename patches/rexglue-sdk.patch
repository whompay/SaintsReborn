+bool DirectMsaaVerifyOn() { return g_dm.verify; }
+
+int DirectMsaaVerifyWanted(uint32_t base, uint32_t width, uint32_t height) {
+  if (!g_dm.verify || !g_dm.entry.pending) return -1;
+  return g_dm.entry.base == base && g_dm.entry.width == width && g_dm.entry.height == height ? 0 : -1;
+}
+
+// The normally loaded texture is already in NON_PIXEL_SHADER_RESOURCE.
+void DirectMsaaVerifyCompare(D3D12CommandProcessor& cp, int entry_index, ID3D12Resource* loaded) {
+  if (entry_index != 0) return;
+  DirectMsaaVerifyEntry& entry = g_dm.entry;
+  entry.pending = false;
+  ++g_dm.compare_attempts;
+  if (!g_dm.ready || !entry.texture) {
+    ++g_dm.fail_alloc;
+    return;
+  }
+  const D3D12_RESOURCE_DESC loaded_desc = loaded->GetDesc();
+  if (loaded_desc.Width < entry.host_width || loaded_desc.Height < entry.host_height ||
+      loaded_desc.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS) {
+    ++g_dm.size_differs;
+    return;
+  }
+  const ui::d3d12::D3D12Provider& provider = cp.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!g_dm.result) {
+    D3D12_HEAP_PROPERTIES heap = {};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    desc.Width = uint64_t(kDirectMsaaSlots) * 32;
+    desc.Height = 1;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_dm.result)))) {
+      ++g_dm.fail_alloc;
+      return;
+    }
+    g_dm.result_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    heap.Type = D3D12_HEAP_TYPE_READBACK;
+    desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                               D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                               IID_PPV_ARGS(&g_dm.readback)))) {
+      g_dm.result.Reset();
+      ++g_dm.fail_alloc;
+      return;
+    }
+    heap.Type = D3D12_HEAP_TYPE_UPLOAD;
+    desc.Width = 256;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                               D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+                                               IID_PPV_ARGS(&g_dm.zero_upload)))) {
+      g_dm.result.Reset();
+      g_dm.readback.Reset();
+      ++g_dm.fail_alloc;
+      return;
+    }
+    void* zero_mapping = nullptr;
+    D3D12_RANGE zero_read = {0, 0};
+    if (FAILED(g_dm.zero_upload->Map(0, &zero_read, &zero_mapping))) {
+      g_dm.result.Reset();
+      g_dm.readback.Reset();
+      g_dm.zero_upload.Reset();
+      ++g_dm.fail_alloc;
+      return;
+    }
+    std::memset(zero_mapping, 0, 256);
+    g_dm.zero_upload->Unmap(0, nullptr);
+  }
+  const uint32_t slot = g_dm.next_slot;
+  if (g_dm.slot_pending[slot]) DirectMsaaHarvest(cp);
+  if (g_dm.slot_pending[slot]) {
+    ++g_dm.fail_ring;
+    return;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!cp.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    ++g_dm.fail_desc;
+    return;
+  }
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv = {};
+  srv.Format = DXGI_FORMAT_R8G8B8A8_UINT;
+  srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv.Texture2D.MipLevels = 1;
+  device->CreateShaderResourceView(entry.texture.Get(), &srv, descriptors[0].first);
+  device->CreateShaderResourceView(loaded, &srv, descriptors[1].first);
+  if (entry.state != D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE) {
+    cp.PushTransitionBarrier(entry.texture.Get(), entry.state, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    entry.state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  }
+  DeferredCommandList& list = cp.GetDeferredCommandList();
+  if (g_dm.result_state != D3D12_RESOURCE_STATE_COPY_DEST) {
+    cp.PushTransitionBarrier(g_dm.result.Get(), g_dm.result_state, D3D12_RESOURCE_STATE_COPY_DEST);
+    g_dm.result_state = D3D12_RESOURCE_STATE_COPY_DEST;
+  }
+  cp.SubmitBarriers();
+  list.D3DCopyBufferRegion(g_dm.result.Get(), uint64_t(slot) * 32, g_dm.zero_upload.Get(), 0, 32);
+  cp.PushTransitionBarrier(g_dm.result.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                           D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  g_dm.result_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  const uint32_t constants[6] = {0, 0, entry.host_width, entry.host_height, entry.fill_x, entry.fill_y};
+  cp.SetExternalPipeline(g_dm.compare.Get());
+  list.D3DSetComputeRootSignature(g_dm.root.Get());
+  list.D3DSetComputeRoot32BitConstants(0, 6, constants, 0);
+  list.D3DSetComputeRootDescriptorTable(2, descriptors[0].second);
+  list.D3DSetComputeRootDescriptorTable(3, descriptors[1].second);
+  list.D3DSetComputeRootUnorderedAccessView(5, g_dm.result->GetGPUVirtualAddress() + uint64_t(slot) * 32);
+  cp.SubmitBarriers();
+  list.D3DDispatch((entry.host_width + 7) / 8, (entry.host_height + 7) / 8, 1);
+  cp.PushTransitionBarrier(g_dm.result.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                           D3D12_RESOURCE_STATE_COPY_SOURCE);
+  g_dm.result_state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  cp.SubmitBarriers();
+  g_dm.next_slot = (slot + 1) % kDirectMsaaSlots;
+  list.D3DCopyBufferRegion(g_dm.readback.Get(), uint64_t(slot) * 32, g_dm.result.Get(), uint64_t(slot) * 32, 24);
+  g_dm.slot_submission[slot] = cp.GetCurrentSubmission();
+  g_dm.slot_pending[slot] = true;
+  ++g_dm.compares;
+}
+
+bool D3D12RenderTargetCache::SnapshotDirectResolve(const draw_util::ResolveInfo& resolve_info,
+                                                   D3D12TextureCache& texture_cache) {
+  if (!texture_cache.IsDirectResolveEnabled()) return false;
+  auto skip = [&](const char* reason) {
+    texture_cache.CountDirectResolveSkip(resolve_info.copy_dest_base, reason);
+    return false;
+  };
+  if (resolve_info.IsCopyingDepth()) {
+    DirectDepthPoll();
+    if (!g_dd.on && !g_dd.verify) return skip("depth");
+    const draw_util::ResolveEdramInfo depth_edram = resolve_info.depth_edram_info;
+    if (depth_edram.msaa_samples != xenos::MsaaSamples::k1X) return skip("depth msaa");
+    // codex19 #1: half-pixel offset fill is reproduced in the pack shader (first covered host pixel, NATIVE17).
+    if (xenos::DepthRenderTargetFormat(depth_edram.format) != xenos::DepthRenderTargetFormat::kD24FS8) {
+      return skip("depth not float24");
+    }
+    const reg::RB_COPY_DEST_INFO depth_dest_info = resolve_info.copy_dest_info;
+    if (depth_dest_info.copy_dest_array || depth_dest_info.copy_dest_slice) return skip("3d dest");
+    if (uint32_t(depth_dest_info.copy_dest_endian) > 3) return skip("128-bit endian");
+    const draw_util::ResolveCopyDestCoordinateInfo depth_dest_coords = resolve_info.copy_dest_coordinate_info;
+    if (depth_dest_coords.offset_x_div_8 || depth_dest_coords.offset_y_div_8) return skip("dest offset");
+    if (resolve_info.copy_dest_base & 0xFFF) return skip("dest not page aligned");
+    uint32_t depth_dump_base, depth_dump_row_length_used, depth_dump_rows, depth_dump_pitch;
+    resolve_info.GetCopyEdramTileSpan(depth_dump_base, depth_dump_row_length_used, depth_dump_rows,
+                                      depth_dump_pitch);
+    std::vector<ResolveCopyDumpRectangle> depth_rectangles;
+    GetResolveCopyRectanglesToDump(depth_dump_base, depth_dump_row_length_used, depth_dump_rows, depth_dump_pitch,
+                                   depth_rectangles);
+    if (depth_rectangles.size() != 1) {
+      return skip(depth_rectangles.empty() ? "no render target" : "several render targets");
+    }
+    auto& depth_rt = *static_cast<D3D12RenderTarget*>(depth_rectangles[0].render_target);
+    const RenderTargetKey depth_rt_key = depth_rt.key();
+    if (!depth_rt_key.is_depth || depth_rt_key.msaa_samples != xenos::MsaaSamples::k1X ||
+        depth_rt_key.GetDepthFormat() != xenos::DepthRenderTargetFormat::kD24FS8) {
+      return skip("render target not 1x float24 depth");
+    }
+    if (depth_rt_key.pitch_tiles_at_32bpp != depth_edram.pitch_tiles) return skip("pitch differs");
+    const uint32_t depth_pitch = depth_edram.pitch_tiles;
+    const uint32_t depth_delta = (depth_edram.base_tiles - depth_rt_key.base_tiles) & (xenos::kEdramTileCount - 1);
+    const uint32_t depth_scale_x = draw_resolution_scale_x(), depth_scale_y = draw_resolution_scale_y();
+    const uint32_t depth_x0 = ((depth_delta % depth_pitch) * xenos::kEdramTileWidthSamples +
+                               resolve_info.coordinate_info.edram_offset_x_div_8 * 8) * depth_scale_x;
+    const uint32_t depth_y0 = ((depth_delta / depth_pitch) * xenos::kEdramTileHeightSamples +
+                               resolve_info.coordinate_info.edram_offset_y_div_8 * 8) * depth_scale_y;
+    const uint32_t depth_width = resolve_info.coordinate_info.width_div_8 * 8;
+    const uint32_t depth_height = resolve_info.height_div_8 * 8;
+    const uint32_t depth_host_width = depth_width * depth_scale_x, depth_host_height = depth_height * depth_scale_y;
+    const D3D12_RESOURCE_DESC depth_rt_desc = depth_rt.resource()->GetDesc();
+    if (depth_x0 + depth_host_width > depth_rt_desc.Width || depth_y0 + depth_host_height > depth_rt_desc.Height) {
+      return skip("outside the render target");
+    }
+    const ui::d3d12::D3D12Provider& depth_provider = command_processor_.GetD3D12Provider();
+    ID3D12Device* depth_device = depth_provider.GetDevice();
+    if (!DirectDepthEnsure(depth_device, depth_provider)) return skip("no depth shader");
+    DirectDepthMaybeLog(command_processor_);
+    ID3D12Resource* depth_target = nullptr;
+    DirectDepthVerifyEntry* depth_entry = nullptr;
+    if (g_dd.verify) {
+      // One private texture per destination (least recently used one replaced).
+      for (DirectDepthVerifyEntry& e : g_dd.entries) {
+        if (e.texture && e.base == resolve_info.copy_dest_base) depth_entry = &e;
+      }
+      if (!depth_entry) {
+        depth_entry = &g_dd.entries[0];
+        for (DirectDepthVerifyEntry& e : g_dd.entries) {
+          if (!e.texture || e.last_frame < depth_entry->last_frame) depth_entry = &e;
+          if (!e.texture) break;
+        }
+      }
+      if (depth_entry->pending) ++g_dd.not_loaded;
+      depth_entry->pending = false;
+      if (!depth_entry->texture || depth_entry->host_width != depth_host_width ||
+          depth_entry->host_height != depth_host_height) {
+        if (depth_entry->texture) {
+          g_dd.retired.emplace_back(command_processor_.GetCurrentSubmission(), std::move(depth_entry->texture));
+        }
+        D3D12_RESOURCE_DESC desc = {};
+        desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        desc.Width = depth_host_width;
+        desc.Height = depth_host_height;
+        desc.DepthOrArraySize = 1;
+        desc.MipLevels = 1;
+        desc.Format = DXGI_FORMAT_R32_FLOAT;
+        desc.SampleDesc.Count = 1;
+        desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+        desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+        D3D12_HEAP_PROPERTIES heap = {};
+        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+        if (FAILED(depth_device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                                         D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                                         IID_PPV_ARGS(&depth_entry->texture)))) {
+          return skip("no verify texture");
+        }
+        depth_entry->state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        depth_entry->host_width = depth_host_width;
+        depth_entry->host_height = depth_host_height;
+      }
+      if (depth_entry->state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+        command_processor_.PushTransitionBarrier(depth_entry->texture.Get(), depth_entry->state,
+                                                 D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        depth_entry->state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+      } else {
+        command_processor_.PushUAVBarrier(depth_entry->texture.Get());  // codex19 #11: WAW between dispatches
+      }
+      depth_target = depth_entry->texture.Get();
+    } else {
+      depth_target = texture_cache.BeginDirectResolve(
+          resolve_info.copy_dest_base, resolve_info.copy_dest_extent_start, resolve_info.copy_dest_extent_length,
+          depth_width, depth_height, depth_dest_coords.pitch_aligned_div_32, xenos::TextureFormat::k_24_8_FLOAT,
+          xenos::Endian(uint32_t(depth_dest_info.copy_dest_endian)), D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+      if (!depth_target) return skip("no snapshot texture");
+    }
+    ui::d3d12::util::DescriptorCpuGpuHandlePair depth_descriptors[2];
+    if (!command_processor_.RequestOneUseSingleViewDescriptors(2, depth_descriptors)) {
+      if (!g_dd.verify) {
+        texture_cache.InvalidateDirectResolves(resolve_info.copy_dest_extent_start,
+                                               resolve_info.copy_dest_extent_length);
+      }
+      return skip("no descriptors");
+    }
+    depth_device->CopyDescriptorsSimple(1, depth_descriptors[0].first, depth_rt.descriptor_srv().GetHandle(),
+                                        D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_UNORDERED_ACCESS_VIEW_DESC depth_uav_desc = {};
+    depth_uav_desc.Format = DXGI_FORMAT_R32_FLOAT;
+    depth_uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    depth_device->CreateUnorderedAccessView(depth_target, nullptr, &depth_uav_desc, depth_descriptors[1].first);
+    command_processor_.PushTransitionBarrier(
+        depth_rt.resource(), depth_rt.SetResourceState(D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE),
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    const uint32_t depth_constants[5] = {
+        depth_x0, depth_y0, depth_host_width, depth_host_height,
+        uint32_t(!depth_float24_convert_in_pixel_shader() && depth_float24_round()) |
+            (depth_edram.fill_half_pixel_offset ? (((depth_scale_x >> 1) & 0xFFu) << 8) | (((depth_scale_y >> 1) & 0xFFu) << 16)
+                                                : 0u)};
+    DeferredCommandList& depth_list = command_processor_.GetDeferredCommandList();
+    command_processor_.SetExternalPipeline(g_dd.pack.Get());
+    depth_list.D3DSetComputeRootSignature(g_dd.root.Get());
+    depth_list.D3DSetComputeRoot32BitConstants(0, 5, depth_constants, 0);
+    depth_list.D3DSetComputeRootDescriptorTable(1, depth_descriptors[0].second);
+    depth_list.D3DSetComputeRootDescriptorTable(3, depth_descriptors[1].second);
+    command_processor_.SubmitBarriers();
+    depth_list.D3DDispatch((depth_host_width + 7) / 8, (depth_host_height + 7) / 8, 1);
+    if (depth_entry) {
+      depth_entry->pending = true;
+      depth_entry->base = resolve_info.copy_dest_base;
+      depth_entry->extent_start = resolve_info.copy_dest_extent_start;
+      depth_entry->extent_length = resolve_info.copy_dest_extent_length;
+      depth_entry->width = depth_width;
+      depth_entry->height = depth_height;
+      depth_entry->last_frame = command_processor_.GetCurrentFrame();
+      ++g_dd.verify_resolves;
+      return false;  // not a snapshot: the normal path stays authoritative
+    }
+    ++g_dd.direct_writes;
+    return true;
+  }
+  // Keep this special case before the generic colour path's 1x-MSAA rejection.
+  DirectMsaaPoll();
+  if ((g_dm.on || g_dm.verify) && resolve_info.copy_dest_base == 0x0E93C000u) {
+    const draw_util::ResolveEdramInfo msaa_edram = resolve_info.color_edram_info;
+    const reg::RB_COPY_DEST_INFO msaa_dest = resolve_info.copy_dest_info;
+    const draw_util::ResolveCopyDestCoordinateInfo msaa_dest_coords = resolve_info.copy_dest_coordinate_info;
+    const uint32_t msaa_width = resolve_info.coordinate_info.width_div_8 * 8;
+    const uint32_t msaa_height = resolve_info.height_div_8 * 8;
+    const uint32_t msaa_scale_x = draw_resolution_scale_x(), msaa_scale_y = draw_resolution_scale_y();
+    const char* msaa_bad = nullptr;
+    if (resolve_info.copy_dest_extent_start != 0x0E93C000u || resolve_info.copy_dest_extent_length != 0x000F0000u) {
+      msaa_bad = "0E93C000 sig extent";
+    } else if (msaa_width != 640 || msaa_height != 384 || msaa_scale_x != 2 || msaa_scale_y != 2) {
+      msaa_bad = "0E93C000 sig size";
+    } else if (msaa_edram.base_tiles != 0 || msaa_edram.msaa_samples != xenos::MsaaSamples::k4X) {
+      msaa_bad = "0E93C000 sig edram base/msaa";
+    } else if (xenos::ColorRenderTargetFormat(msaa_edram.format) != xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+      msaa_bad = "0E93C000 sig rt format";
+    } else if (uint32_t(msaa_dest_coords.copy_sample_select) != 6) {
+      msaa_bad = "0E93C000 sig sample select";
+    } else if (msaa_dest.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 || uint32_t(msaa_dest.copy_dest_number) != 0 ||
