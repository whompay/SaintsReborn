+  uint64_t fetch_generation = 0;
+  uint64_t texture_generation = 0;
+  uint64_t sampler_generation = 0;
+  uint32_t root_up_to_date = 0;
+  bool shared_memory_is_uav = false;
+  D3D12_GPU_VIRTUAL_ADDRESS system_address = 0;
+  D3D12_GPU_VIRTUAL_ADDRESS float_vertex_address = 0;
+  D3D12_GPU_VIRTUAL_ADDRESS float_pixel_address = 0;
+  D3D12_GPU_VIRTUAL_ADDRESS bool_loop_address = 0;
+  D3D12_GPU_VIRTUAL_ADDRESS fetch_address = 0;
+  D3D12_GPU_VIRTUAL_ADDRESS descriptor_vertex_address = 0;
+  D3D12_GPU_VIRTUAL_ADDRESS descriptor_pixel_address = 0;
+  uint64_t hits = 0;
+  bool valid = false;
+};
+static CpBindingFastState g_cp_bind_fast;
+
+// Diagnostic (native_exec / native_exec_verify only): how often render state (context registers
+// 0x2000-0x3FFF) really changes value between draws, and which registers. The four registers every
+// draw packet writes (VGT_DMA_BASE/SIZE, VGT_DRAW_INITIATOR, VGT_INDX_OFFSET) don't count as a change.
+static bool g_ctx_diag = false;
+static uint64_t g_ctx_changes = 0, g_ctx_changes_seen = 0, g_ctx_draws_changed = 0, g_ctx_draws = 0;
+static std::unordered_map<uint32_t, uint64_t> g_ctx_change_hist;
+static inline bool CtxPerDrawRegister(uint32_t index) {
+  // VGT_EVENT_INITIATOR (0x21F9) is written by the EVENT_WRITE packet emitted
+  // for every draw too, so it doesn't delimit a reusable render-state run.
+  return index == 0x21F9 || index == 0x21FA || index == 0x21FB || index == 0x21FC ||
+         index == 0x2102;
+}
+// AGENT_NATIVE27A: WRITE REGS census (dist file "cp_wrm_census", diagnostic, default off = one counter
+// test per WriteRegistersFromMem call): calls / registers per path, context scan length, per frame.
+struct WrmCensus {
+  bool on = false;
+  uint64_t poll = 0, last_log = 0, frames0 = 0;
+  uint64_t calls[5] = {}, regs[5] = {};  // float, bool/loop, fetch, context, other
+  uint64_t ctx_scanned = 0, ctx_changed = 0, size_hist[6] = {};  // 1, 2-4, 5-16, 17-64, 65-256, >256
+};
+static WrmCensus g_wrm;  // CP thread only
+static void WrmNote(uint32_t start, uint32_t n) {
+  const uint32_t end = start + n - 1;
+  uint32_t k = 4;
+  if (start >= XE_GPU_REG_SHADER_CONSTANT_000_X && end <= XE_GPU_REG_SHADER_CONSTANT_511_W) k = 0;
+  else if (start >= XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 && end <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31) k = 1;
+  else if (start >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 && end <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) k = 2;
+  else if (start >= 0x2000 && end < XE_GPU_REG_SHADER_CONSTANT_000_X) k = 3;
+  ++g_wrm.calls[k];
+  g_wrm.regs[k] += n;
+  g_wrm.size_hist[n <= 1 ? 0 : n <= 4 ? 1 : n <= 16 ? 2 : n <= 64 ? 3 : n <= 256 ? 4 : 5]++;
+}
+// AGENT_NATIVE27A: context register writes in ONE pass (dist file "cp_ctx_merge", read once; default off):
+// the byte-swapping copy also finds whether a non-per-draw register changed (segments split around the
+// per-draw registers), instead of a compare pass before the copy. Same stored values, same generation bump.
+static bool CtxMergeOn() {
+  static const bool on = RexFlagExistsW(L"cp_ctx_merge");
+  return on;
+}
+static inline uint32_t CtxSwapCopyDiff(uint32_t* dst, const uint32_t* src, uint32_t n) {
+  uint32_t diff = 0;
+  for (uint32_t i = 0; i < n; ++i) {
+    uint32_t raw;
+    std::memcpy(&raw, src + i, sizeof(raw));
+    const uint32_t v = rex::byte_swap(raw);
+    diff |= v ^ dst[i];
+    dst[i] = v;
+  }
+  return diff;
+}
+// Copies [start, start + n) (all inside 0x2000-0x3FFF); returns true if a register other than the per-draw
+// ones (0x2102, 0x21F9-0x21FC, see CtxPerDrawRegister) changed value.
+static bool CtxMergedWrite(uint32_t* values, uint32_t start, const uint32_t* src, uint32_t n) {
+  static constexpr uint32_t kSkip[][2] = {{0x2102, 0x2102}, {0x21F9, 0x21FC}};
+  uint32_t diff = 0;
+  uint32_t i = start;
+  const uint32_t end = start + n;  // exclusive
+  for (const auto& sk : kSkip) {
+    if (i >= end) break;
+    if (sk[1] < i) continue;
+    const uint32_t seg_end = std::min(end, sk[0]);
+    if (seg_end > i) {
+      diff |= CtxSwapCopyDiff(values + i, src + (i - start), seg_end - i);
+      i = seg_end;
+    }
+    const uint32_t skip_end = std::min(end, sk[1] + 1);
+    if (skip_end > i) {
+      CtxSwapCopyDiff(values + i, src + (i - start), skip_end - i);  // stored, not counted
+      i = skip_end;
+    }
+  }
+  if (end > i) diff |= CtxSwapCopyDiff(values + i, src + (i - start), end - i);
+  return diff != 0;
+}
+static inline void CtxNoteChange(uint32_t index) {
+  ++g_ctx_change_hist[index];
+  if (!CtxPerDrawRegister(index)) {
+    ++g_ctx_changes;
+  }
+}
+// AGENT_GPU_FIX: the render-state histogram (an unordered_map update for every changed context register,
+// ~2M/10 s) is its own opt-in now - file "native_exec_ctxdiag" - instead of always running with native_exec.
+static bool g_ctx_diag_file = false;
+static int ExecMode() {  // 0 off, 1 on, 2 verify
+  static uint64_t next = 0;
+  static int mode = 0;
+  const uint64_t now = GetTickCount64();
+  if (now >= next) {
+    next = now + 1000;
+    mode = 0;
+    g_ctx_diag_file = Perf5FileExists("native_exec_ctxdiag");
+    if (Perf5FileExists("native_exec.off")) {
+      mode = 0;
+    } else if (Perf5FileExists("native_exec_verify")) {
+      mode = 2;
+    } else if (Perf5FileExists("native_exec")) {
+      mode = 1;
+    }
+  }
+  return mode;
+}
+static bool P5bSamplerCacheOn() {
+  static const bool on = !Perf5FileExists("cp_samplercache.off");
+  return on;
+}
+// Guest DMA index buffers: one view of the whole shared memory per index
+// format, the draw's offset goes into StartIndexLocation - no
+// IASetIndexBuffer per draw. File "cp_ibview.off" = a view per draw as before.
+struct P5bIbState {
+  D3D12_GPU_VIRTUAL_ADDRESS location = 0;
+  UINT size = 0;
+  DXGI_FORMAT format = DXGI_FORMAT_UNKNOWN;
+  bool valid = false;
+};
+static P5bIbState g_p5b_ib;  // CP thread only; state of the current command list
+static bool P5bIbViewOn() {
+  static const bool on = !Perf5FileExists("cp_ibview.off");
+  return on;
+}
+// Byte-swapping copy that also says whether any value changed.
+static bool P5bCopySwapChanged(uint32_t* dst, const uint32_t* src, uint32_t count) {
+  uint32_t diff = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t raw;
+    std::memcpy(&raw, src + i, sizeof(raw));
+    const uint32_t v = rex::byte_swap(raw);
+    diff |= v ^ dst[i];
+    dst[i] = v;
+  }
+  return diff != 0;
+}
