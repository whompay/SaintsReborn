+// DIRECT DEPTH RESOLVE (dist\direct_resolve_depth: float24 depth resolves of a whole 1x D24FS8 render target are
+// written straight into the texture that reads them, like the 8888 colour direct resolve above; dist
+// \direct_resolve_depth_verify: exactness test instead - the normal resolve and texture load stay, the direct result
+// goes into a private texture and is compared bit for bit with the loaded texture; both default off). The host depth
+// is packed exactly like the EDRAM dump (PreClampedDepthTo20e4 from [0, 0.5), same rounding) and decoded exactly like
+// the k_24_8_FLOAT texture load, so the texel bits are the ones the emulated path produces.
+static const char kDirectDepthCS[] = R"(
+Texture2D<float> source : register(t0);
+Texture2D<float> loaded : register(t1);
+RWTexture2D<float> dest : register(u0);
+RWByteAddressBuffer result : register(u1);
+cbuffer constants : register(b0) {
+  uint2 origin;
+  uint2 size;
+  uint round_to_nearest_even;  // bit 0: round; bits 8-15 / 16-23: first covered host pixel x / y (half-pixel offset fill)
+};
+uint PackFloat20e4(uint f32) {
+  uint f24;
+  if (f32 < 0x38000000u) {
+    uint shift = min(112u - (f32 >> 23), 24u);
+    f24 = ((f32 & 0x7FFFFFu) | 0x800000u) >> shift;
+  } else {
+    f24 = f32 + 0xC8800000u;
+  }
+  if ((round_to_nearest_even & 1u) != 0u) {
+    f24 = f24 + 3u + ((f24 >> 3) & 1u);
+  }
+  return (f24 >> 3) & 0xFFFFFFu;
+}
+uint DecodeFloat20e4(uint f24) {
+  if (f24 == 0u) return 0u;
+  uint mantissa = f24 & 0xFFFFFu;
+  uint exponent = f24 >> 20;
+  if (exponent == 0u) {
+    uint shift = (31u - firstbithigh(mantissa)) - 11u;
+    exponent = 1u - shift;
+    mantissa = (mantissa << shift) & 0xFFFFFu;
+  }
+  return (exponent << 23) + 0x38000000u + (mantissa << 3);
+}
+[numthreads(8, 8, 1)]
+void pack_main(uint3 id : SV_DispatchThreadID) {
+  if (id.x >= size.x || id.y >= size.y) return;
+  // Resolution scale + half-pixel offset: the resolve stretches the first surely covered host pixel over the left
+  // and top sides of the area (draw.cpp resolve_resolution_scale_fill_half_pixel_offset), same here.
+  uint2 fill_first = uint2((round_to_nearest_even >> 8) & 0xFFu, (round_to_nearest_even >> 16) & 0xFFu);
+  uint f32 = asuint(source.Load(int3(origin + max(id.xy, fill_first), 0)));
+  dest[id.xy] = asfloat(DecodeFloat20e4(PackFloat20e4(f32)));
+}
+[numthreads(8, 8, 1)]
+void compare_main(uint3 id : SV_DispatchThreadID) {
+  if (id.x >= size.x || id.y >= size.y) return;
+  uint direct = asuint(source.Load(int3(id.xy, 0)));
+  uint expected = asuint(loaded.Load(int3(id.xy, 0)));
+  if (expected != direct) {
+    uint previous;
+    result.InterlockedAdd(0, 1u, previous);
+    if (previous == 0u) result.Store3(8, uint3(id.x | (id.y << 16), expected, direct));
+    result.InterlockedMax(4, expected > direct ? expected - direct : direct - expected);
+  }
+}
+)";
+namespace {
+void DirectDepthPoll() {
+  const uint64_t now = GetTickCount64();
+  if (now - g_dd.poll_tick < 500) return;
+  g_dd.poll_tick = now;
+  const bool verify = RexFlagExistsW(L"direct_resolve_depth_verify");
+  // Default ON since n18a/n18b (verify BAD 0, air +6 %); dist direct_resolve_depth.off = old path.
+  const bool on = !verify && !RexFlagExistsW(L"direct_resolve_depth.off");
+  if (on != g_dd.on || verify != g_dd.verify) {
+    REXLOG_INFO("Direct depth resolve: {}", verify ? "VERIFY (compare only)" : on ? "ON" : "off");
+  }
+  g_dd.on = on;
+  g_dd.verify = verify;
