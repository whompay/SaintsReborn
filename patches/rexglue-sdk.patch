+static std::string KindName(uint32_t kind) {
+  if (kind == kKindCityMain) return "city_main";
+  if (kind == kKindCityMainPs) return "city_main PS (other VS)";
+  if (kind >= kKindPort0 && kind < kKindPort0 + kPortCount) return kPorts[kind - kKindPort0].name;
+  if (kind >= kKindPortPs0 && kind < kKindPortPs0 + kPortCount) {
+    return std::string(kPorts[kind - kKindPortPs0].name) + " PS (other VS)";
+  }
+  return kind == kKindFallback ? "fallback" : "returned false";
