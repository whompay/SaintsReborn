+uint32_t StatsBufferSize(const std::vector<StatsSpec>& specs, uint32_t rows) {
+  uint64_t size = 8;
+  for (const auto& s : specs) {
+    size += 16 + uint64_t(rows) * (52 + 28 * s.columns.size());
+    for (uint16_t c : s.columns)
+      if (c == kColGamertag) size += uint64_t(rows) * 32;  // the name as UTF-16
+  }
+  return uint32_t(std::min<uint64_t>(size, 0x00FFFFFF));
+}
