+uint64_t XuidFromPuid(const std::string& puid) {
+  uint64_t h = 1469598103934665603ull;
+  for (char c : puid) { h ^= uint8_t(c); h *= 1099511628211ull; }
+  return 0x0009000000000000ull | (h & 0x0000FFFFFFFFFFFFull);
+}
+std::vector<uint8_t> UnhexBytes(const std::string& s) {
+  std::vector<uint8_t> v;
+  auto nib = [](char c) -> int { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; };
+  for (size_t i = 0; i + 1 < s.size(); i += 2) {
+    const int a = nib(s[i]), b = nib(s[i + 1]);
+    if (a < 0 || b < 0) return {};
+    v.push_back(uint8_t(a << 4 | b));
+  }
+  return v;
+}
