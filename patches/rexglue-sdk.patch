+      const int c = std::fgetc(f);
+      m = c == '2' ? 2 : 1;
+      std::fclose(f);
+    }
+    mode.store(m, std::memory_order_relaxed);
+  }
+  return mode.load(std::memory_order_relaxed);
+}
