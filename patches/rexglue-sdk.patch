+// RT TRACE (dist\rt_trace, diagnostic only, default off = one bool test per draw): while the file exists, once
+// every 20 s, logs 3 consecutive frames of render target events - every binding change with its EDRAM ownership
+// transfers, the first draws after each binding (depth / stencil / colour state), resolves (source, destination,
+// clears) - to find transfers whose destination is fully overwritten before it is read.
+namespace {
+struct RtTraceState {
+  bool file = false;
+  uint64_t poll_tick = 0;
+  uint64_t last_start_tick = 0;
+  uint64_t start_frame = UINT64_MAX;
+  uint64_t frame = UINT64_MAX;
+  uint32_t seq = 0, seg_draws = 0, frame_draws = 0;
+  const void* bound[1 + xenos::kMaxColorRenderTargets] = {};
+};
+RtTraceState g_rtt;
+constexpr uint64_t kRtTraceFrames = 3;
+constexpr uint32_t kRtTraceDrawsPerBinding = 4;
+void RtTracePoll() {
+  const uint64_t now = GetTickCount64();
+  if (now - g_rtt.poll_tick < 500) return;
+  g_rtt.poll_tick = now;
+  g_rtt.file = RexFlagExistsW(L"rt_trace");
+  g_rt_trace_armed = g_rtt.file || g_rtt.start_frame != UINT64_MAX;
+}
+bool RtTraceActive(uint64_t frame) {
+  if (g_rtt.start_frame == UINT64_MAX) {
+    if (!g_rtt.file) return false;
+    const uint64_t now = GetTickCount64();
+    if (g_rtt.last_start_tick && now - g_rtt.last_start_tick < 20000) return false;
+    g_rtt.last_start_tick = now;
+    g_rtt.start_frame = frame + 1;
+    g_rtt.frame = UINT64_MAX;
+    return false;
+  }
+  if (frame < g_rtt.start_frame) return false;
+  if (frame >= g_rtt.start_frame + kRtTraceFrames) {
+    REXLOG_INFO("RT TRACE f{} done: {} draws | RT TRACE end", g_rtt.frame - g_rtt.start_frame, g_rtt.frame_draws);
+    g_rtt.start_frame = UINT64_MAX;
+    return false;
+  }
+  if (frame != g_rtt.frame) {
+    if (g_rtt.frame != UINT64_MAX) {
+      REXLOG_INFO("RT TRACE f{} done: {} draws", g_rtt.frame - g_rtt.start_frame, g_rtt.frame_draws);
+    }
+    g_rtt.frame = frame;
+    g_rtt.seq = 0;
+    g_rtt.frame_draws = 0;
+    REXLOG_INFO("RT TRACE f{} start (frame {})", frame - g_rtt.start_frame, frame);
+  }
+  return true;
+}
+}  // namespace
+
+// Called by IssueDraw after the render target update of a draw that is going to be drawn: returns the traced frame
+// index (and the event number) when this draw is to be logged, else -1.
+// Any other traced event (texture loads): the traced frame index and the event number, else -1.
+int64_t RtTraceEventSlot(uint64_t frame, uint32_t* seq_out) {
+  if (!RtTraceActive(frame)) return -1;
+  *seq_out = g_rtt.seq++;
+  return int64_t(frame - g_rtt.start_frame);
+}
+int64_t RtTraceDrawSlot(uint64_t frame, uint32_t* seq_out) {
+  if (!RtTraceActive(frame)) return -1;
+  ++g_rtt.frame_draws;
+  if (g_rtt.seg_draws++ >= kRtTraceDrawsPerBinding) return -1;
+  *seq_out = g_rtt.seq++;
+  return int64_t(frame - g_rtt.start_frame);
+}
