+  enqueue_us[seq % kEnqueueSlots].store(submit_start, std::memory_order_relaxed);
+  CallInThread([this, bytes, stream_dwords, size_bytes, seq, snapshots]() {
+    const uint64_t exec_start = NowUs();
+    memory::RingBuffer reader(reinterpret_cast<uint8_t*>(bytes.get()), stream_dwords * 4u);
+    reader.set_write_offset(size_bytes);
