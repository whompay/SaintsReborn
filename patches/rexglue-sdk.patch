+    }
+    slot->consumer = nullptr;
+  }
+  direct_resolve_last_wrote_consumer_ = false;
+  if (slot) {
+    slot->written_to_consumer = false;
+    slot->memory_stale = false;
+  }
+  if (!slot) {
+    if (direct_resolves_.size() >= 48) {
+      // Replace the least recently used one.
+      auto lru = std::min_element(direct_resolves_.begin(), direct_resolves_.end(),
+                                  [](const auto& a, const auto& b) {
+                                    return a.last_used_frame < b.last_used_frame;
+                                  });
+      direct_resolve_graveyard_.emplace_back(command_processor_.GetCurrentSubmission(),
+                                             std::move(lru->resource));
+      *lru = DirectResolveSnapshot();
+      slot = &*lru;
+    } else {
+      direct_resolves_.emplace_back();
+      slot = &direct_resolves_.back();
+    }
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = scaled_width;
+    desc.Height = scaled_height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = dxgi_format;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    D3D12_HEAP_PROPERTIES heap = {};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                               D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                               IID_PPV_ARGS(&slot->resource)))) {
+      REXLOG_ERROR("Direct resolve: failed to create a {}x{} snapshot texture", scaled_width,
+                   scaled_height);
+      *slot = DirectResolveSnapshot();
+      return nullptr;
+    }
+    slot->state = D3D12_RESOURCE_STATE_COPY_DEST;
+  }
+  slot->base = base;
+  slot->extent_start = extent_start;
+  slot->extent_end = extent_end;
+  slot->width = width;
+  slot->height = height;
+  slot->pitch_div_32 = pitch_div_32;
+  slot->format = format;
+  slot->endian = endian;
+  slot->dxgi_format = dxgi_format;
+  slot->valid = true;
+  slot->last_used_frame = direct_resolve_frame_;
+  if (slot->state != wanted_state) {
+    command_processor_.PushTransitionBarrier(slot->resource.Get(), slot->state, wanted_state);
+    slot->state = wanted_state;
+  }
+  ++direct_resolve_stat_snapshots_;
+  return slot->resource.Get();
+}
