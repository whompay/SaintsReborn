+u32 XamUserCreateStatsEnumerator_entry(u32 title_id, u32 type, u64 pivot, u32 num_rows,
+                                       u32 num_specs, ppc_ptr_t<X_USER_STATS_SPEC> specs,
+                                       mapped_u32 buffer_size_ptr, mapped_u32 handle_ptr) {
+  if (!num_specs || num_specs > 64 || !specs || !handle_ptr) return X_ERROR_INVALID_PARAMETER;
+  auto copied = CopySpecs(num_specs, &specs[0]);
+  const uint32_t rows = std::clamp<uint32_t>(num_rows, 1, 100);
+  uint64_t pivot64 = uint64_t(pivot);
+  // Export arguments arrive as 32 bits (ArgTranslator reads rN.u32), so an
+  // XUID pivot loses its upper half: the game asks around its own player, so
+  // put this player's multiplayer XUID back (the server also matches the low
+  // 32 bits when nothing else fits).
+  if (!type && !(pivot64 >> 32)) {
+    const uint64_t mine = rex::system::online::OnlineXuid();
+    const auto& profile = REX_KERNEL_STATE()->user_profile();
+    if (uint32_t(mine) == uint32_t(pivot64) || (profile && uint32_t(profile->xuid()) == uint32_t(pivot64)))
+      pivot64 = mine;
+  }
+  std::string request = type ? fmt::format("rank {} {} ", pivot64 ? pivot64 : 1, rows)
+                             : fmt::format("xuid {:016x} {} ", pivot64, rows);
+  request += SpecViews(copied, ' ');
+  std::string desc;
+  for (const auto& s : copied) {
+    desc += fmt::format(" [view {} cols", s.view);
+    for (uint16_t c : s.columns) desc += fmt::format(" {:X}", c);
+    desc += "]";
+  }
+  REXLOG_INFO("LIVE XUserCreateStatsEnumerator(title {:08X}, {} {:X}, {} rows):{}", uint32_t(title_id),
+              type ? "rank" : "xuid", uint64_t(pivot), uint32_t(num_rows), desc);
+  auto e = object_ref<XStatsEnumerator>(new XStatsEnumerator(REX_KERNEL_STATE(), std::move(copied), request, rows));
+  if (buffer_size_ptr) *buffer_size_ptr = e->size();
+  auto result = e->Initialize(0xFF, 0xFB, 0xB0021, 0xB0022, 0);
+  if (XFAILED(result)) return result;
+  *handle_ptr = e->handle();
+  return X_ERROR_SUCCESS;
+}
