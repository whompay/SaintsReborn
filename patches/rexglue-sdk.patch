+  }();
+  const int32_t max_lag = REXCVAR_GET(gpu_async_max_lag_us);
+  if (ok && depth > 0 && max_lag > 0) {
+    bool counted = false;
+    while (ok) {
+      const uint64_t oldest = done_seq.load(std::memory_order_acquire) + 1;
+      if (oldest > seq || seq - oldest >= kEnqueueSlots ||
+          NowUs() - enqueue_us[oldest % kEnqueueSlots].load(std::memory_order_relaxed) <=
