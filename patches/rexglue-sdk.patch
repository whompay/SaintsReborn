+  std::atomic<uint32_t> vs{0}, ps{0}, decl{0}, gen{0}, flags{0};
+};
+static constexpr uint32_t kM3MaskSlots = 8192, kM3MaskProbe = 32;
+static M3MaskSlot g_m3_masks[kM3MaskSlots];
