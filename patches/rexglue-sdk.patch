+    for (uint32_t ip : ips) if ((ip >> 24) == 26) return ip;  // Radmin VPN
+    for (uint32_t ip : ips) if ((ip >> 24) == 25) return ip;  // Hamachi
+    for (uint32_t ip : ips)
+      if ((ip >> 24) == 10 || (ip >> 16) == 0xC0A8 || (ip >> 20) == 0xAC1) return ip;  // private LANs
+    return ips.empty() ? 0x7F000001u : ips.front();
