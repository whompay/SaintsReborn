+namespace {
+
+constexpr uint16_t kColRank = 0xFFFF, kColRating = 0xFFFE, kColGamertag = 0xFFFD;
+constexpr uint8_t kDataInt32 = 1, kDataInt64 = 2, kDataUnicode = 4;
+
+struct StatsSpec {
+  uint32_t view = 0;
+  std::vector<uint16_t> columns;
+};
+struct StatsRow {
+  uint64_t xuid = 0;
+  uint32_t rank = 0;
+  int64_t rating = 0;
+  std::string name;
+  std::map<uint16_t, std::pair<int64_t, uint8_t>> columns;  // attribute -> value, XUSER_DATA type
+};
+struct StatsView {
+  uint32_t view = 0, total = 0;
+  std::vector<StatsRow> rows;
+};
+
+std::vector<StatsSpec> CopySpecs(uint32_t count, const X_USER_STATS_SPEC* specs) {
+  std::vector<StatsSpec> out;
+  for (uint32_t i = 0; i < count; ++i) {
+    StatsSpec s;
+    s.view = specs[i].view_id;
+    for (uint32_t c = 0; c < std::min<uint32_t>(specs[i].num_column_ids, 64); ++c)
+      s.columns.push_back(specs[i].column_ids[c]);
+    out.push_back(std::move(s));
+  }
+  return out;
+}
