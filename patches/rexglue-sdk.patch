+// XStorage for the game exe (its wrappers sub_8265C6E0 / sub_8265C400 are
+// replaced there, project/src/online_players.cpp). Xbox Live kept these files
+// (the multiplayer character, XSTORAGE:/3/MPStorage) on its servers; Saints
+// Reborn keeps them next to the profile settings:
+// <content>/<title>/profile/<player name>/storage/<facility>_<name>.
+namespace {
+std::filesystem::path StorageFile(uint32_t path_ptr) {
+  auto* ks = REX_KERNEL_STATE();
+  std::string name;
+  if (path_ptr) {
+    auto* p = ks->memory()->TranslateVirtual<const uint8_t*>(path_ptr);
+    for (uint32_t i = 0; i < 260; ++i) {
+      const char16_t c = char16_t(p[i * 2] << 8 | p[i * 2 + 1]);
+      if (!c) break;
+      name.push_back(c < 0x80 && (std::isalnum(int(c)) || c == '-' || c == '.') ? char(c) : '_');
+    }
+  }
+  const std::string prefix = "XSTORAGE__";  // "XSTORAGE:/" after the replacement above
+  if (name.rfind(prefix, 0) == 0) name = name.substr(prefix.size());
+  if (name.empty()) name = "unnamed";
+  return ks->content_manager()->ResolveGameUserContentPath() / "storage" / name;
+}
+uint32_t StorageFinish(uint32_t overlapped_ptr, uint32_t result, uint32_t length) {
+  if (!overlapped_ptr) return result;
+  REX_KERNEL_STATE()->CompleteOverlappedImmediateEx(overlapped_ptr, result, result ? result : 0, length);
+  return 997;  // ERROR_IO_PENDING, like the console
+}
+}  // namespace
+
+// XStorageUploadFromMemory(user, server path, size, buffer, XOVERLAPPED)
+extern "C" __declspec(dllexport) uint32_t SrStorageUpload(uint32_t user, uint32_t path_ptr, uint32_t size,
+                                                          uint32_t buffer_ptr, uint32_t overlapped_ptr) {
+  auto* ks = REX_KERNEL_STATE();
+  if (!ks || !buffer_ptr || size > (16u << 20)) return 1627;
+  const auto file = StorageFile(path_ptr);
+  std::error_code ec;
+  std::filesystem::create_directories(file.parent_path(), ec);
+  auto tmp = file;
+  tmp += ".tmp";
+  bool ok = false;
+  if (FILE* f = rex::filesystem::OpenFile(tmp, "wb")) {
+    ok = std::fwrite(ks->memory()->TranslateVirtual<const uint8_t*>(buffer_ptr), 1, size, f) == size;
+    ok = std::fclose(f) == 0 && ok;
+  }
+  if (ok) {
+    std::filesystem::rename(tmp, file, ec);
+    ok = !ec;
+  }
+  REXLOG_INFO("LIVE XStorageUpload(user {}, {} bytes) -> {}{}", user, size, rex::path_to_utf8(file),
+              ok ? "" : " FAILED");
+  return StorageFinish(overlapped_ptr, ok ? 0 : 1627, ok ? size : 0);
+}
+
+// XStorageDownloadToMemory(user, server path, buffer size, buffer, results
+// size, XSTORAGE_DOWNLOAD_TO_MEMORY_RESULTS {u32 bytes, u64 owner xuid,
+// u64 created filetime}, XOVERLAPPED). Nothing stored yet: fails at once
+// (1627), which the game treats as "no saved character" (defaults).
+extern "C" __declspec(dllexport) uint32_t SrStorageDownload(uint32_t user, uint32_t path_ptr, uint32_t size,
+                                                            uint32_t buffer_ptr, uint32_t results_size,
+                                                            uint32_t results_ptr, uint32_t overlapped_ptr) {
+  auto* ks = REX_KERNEL_STATE();
+  if (!ks || !buffer_ptr) return 1627;
+  const auto file = StorageFile(path_ptr);
+  std::vector<uint8_t> data;
+  if (FILE* f = rex::filesystem::OpenFile(file, "rb")) {
+    std::fseek(f, 0, SEEK_END);
+    const long n = std::ftell(f);
+    std::fseek(f, 0, SEEK_SET);
+    if (n > 0 && n <= long(16u << 20)) {
+      data.resize(size_t(n));
+      if (std::fread(data.data(), 1, data.size(), f) != data.size()) data.clear();
+    }
+    std::fclose(f);
+  }
+  if (data.empty()) {
+    REXLOG_INFO("LIVE XStorageDownload(user {}): {} not saved yet", user, rex::path_to_utf8(file));
+    return 1627;
+  }
+  const uint32_t n = uint32_t(std::min<size_t>(data.size(), size));
+  std::memcpy(ks->memory()->TranslateVirtual<uint8_t*>(buffer_ptr), data.data(), n);
+  if (results_ptr && results_size >= 20) {
+    auto* r = ks->memory()->TranslateVirtual<uint8_t*>(results_ptr);
+    std::memset(r, 0, results_size);
+    rex::memory::store_and_swap<uint32_t>(r + 0, n);
+    rex::memory::store_and_swap<uint64_t>(r + 4, ks->user_profile()->xuid());
+  }
+  REXLOG_INFO("LIVE XStorageDownload(user {}, {} of {} bytes) <- {}", user, n, data.size(), rex::path_to_utf8(file));
+  return StorageFinish(overlapped_ptr, 0, n);
+}
