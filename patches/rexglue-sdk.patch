+    return it->second;
+  }
+  if (cache.size() >= 8192) {
+    cache.clear();
+  }
+  TextureGuestLayout layout =
+      ComputeGuestTextureLayout(dimension, base_pitch_texels_div_32, width_texels, height_texels,
+                                depth_or_array_size, is_tiled, format, has_packed_levels, has_base,
+                                max_level);
+  cache.emplace(key, layout);
+  return layout;
+}
