+class XStatsEnumerator : public XEnumerator {
+ public:
+  XStatsEnumerator(KernelState* ks, std::vector<uint32_t> views)
+      : XEnumerator(ks, 1, 0), views_(std::move(views)) {}
+  static uint32_t SizeFor(size_t views) { return uint32_t(8 + 16 * views); }
+  uint32_t WriteItems(uint32_t buffer_ptr, uint8_t* buffer_data, uint32_t* written_count) override {
+    if (done_) return X_ERROR_NO_MORE_FILES;
+    done_ = true;
+    std::memset(buffer_data, 0, SizeFor(views_.size()));
+    memory::store_and_swap<uint32_t>(buffer_data + 0, uint32_t(views_.size()));
+    memory::store_and_swap<uint32_t>(buffer_data + 4, buffer_ptr + 8);
+    for (size_t i = 0; i < views_.size(); ++i) {
+      uint8_t* v = buffer_data + 8 + i * 16;
+      memory::store_and_swap<uint32_t>(v + 0, views_[i]);
+      // total rows 0, rows 0, rows pointer 0
+    }
+    if (written_count) *written_count = 1;
+    return X_ERROR_SUCCESS;
+  }
+
+ private:
+  std::vector<uint32_t> views_;
+  bool done_ = false;
+};
