+
+std::string SharedMemory::TakeUntrackedWriteReport() {
+  std::vector<std::pair<uint32_t, uint32_t>> v(content_check_untracked_regions_.begin(),
+                                               content_check_untracked_regions_.end());
+  content_check_untracked_regions_.clear();
+  std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second > b.second; });
+  std::string out;
+  char text[48];
+  for (size_t i = 0; i < v.size() && i < 16; ++i) {
+    std::snprintf(text, sizeof(text), " %08X:%u", v[i].first << 16, v[i].second);
+    out += text;
+  }
+  std::snprintf(text, sizeof(text), " (%zu regions)", v.size());
+  return out + text;
+}
+
+void SharedMemory::CommitUploadedPageHashes() {
+  auto global_lock = global_critical_region_.Acquire();
+  for (size_t i = 0; i < content_check_new_pages_.size(); ++i) {
+    const uint32_t page = content_check_new_pages_[i];
+    const uint64_t bit = uint64_t(1) << (page & 63);
+    // Only if nothing wrote to the page since it was protected before hashing:
+    // then the uploaded bytes are the hashed bytes.
+    if ((system_page_flags_valid_[page >> 6] & bit) &&
+        !(system_page_flags_valid_and_gpu_written_[page >> 6] & bit)) {
+      page_hashes_[page] = content_check_new_hashes_[i];
+      page_hash_known_[page >> 6] |= bit;
+    }
+  }
+  content_check_new_pages_.clear();
+  content_check_new_hashes_.clear();
