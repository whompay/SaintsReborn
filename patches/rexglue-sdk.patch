+void SharedMemory::VerifierThreadMain() {
+#ifdef _WIN32
+  SetThreadDescription(GetCurrentThread(), L"GPU Page Verify");
+#endif
+  const uint32_t log2 = page_size_log2_;
+  const size_t page_size = size_t(1) << log2;
+  uint64_t last_log = GetTickCount64();
+  std::vector<uint32_t> pages;
+  for (;;) {
+    {
+      std::unique_lock<std::mutex> lock(verifier_mutex_);
+      verifier_cv_.wait(lock, [this]() { return verifier_exit_ || verifier_busy_; });
+      if (verifier_exit_) {
+        return;
+      }
+      pages.swap(verifier_pages_);
+    }
+    for (const uint32_t page : pages) {
+      const uint64_t bit = uint64_t(1) << (page & 63);
+      uint64_t stored = 0;
+      {
+        auto global_lock = global_critical_region_.Acquire();
+        if (!(system_page_flags_valid_[page >> 6] & bit) ||
+            (system_page_flags_valid_and_gpu_written_[page >> 6] & bit) ||
+            !(page_hash_known_[page >> 6] & bit)) {
+          continue;
+        }
+        stored = page_hashes_[page];
+      }
+      const uint64_t hash = XXH3_64bits(memory().TranslatePhysical(page << log2), page_size);
+      verifier_checked_.fetch_add(1, std::memory_order_relaxed);
+      if (hash == stored) {
+        continue;
+      }
