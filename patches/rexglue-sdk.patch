+void D3D12CommandProcessor::AbOnSwap() {
+  LARGE_INTEGER now;
+  QueryPerformanceCounter(&now);
+  const uint64_t ticks = uint64_t(now.QuadPart);
+  const uint64_t frame_ticks = ab_last_swap_ticks_ ? ticks - ab_last_swap_ticks_ : 0;
+  ab_last_swap_ticks_ = ticks;
+  if (ab_active_) {
+    // Frames longer than 100 ms (loading, alt-tab) would swamp the average.
+    if (ab_phase_frame_ >= kAbWarmupFrames && frame_ticks &&
+        frame_ticks < stat_qpc_freq_ / 10) {
+      AbStats& s = ab_stats_[ab_phase_];
+      ++s.frames;
+      s.ticks += frame_ticks;
+      s.draws += ab_frame_draws_;
+      s.native_draws += ab_frame_native_;
+      s.binds += ab_frame_binds_;
+      s.depth_draws += ab_frame_depth_;
+      s.dups += ab_frame_dups_;
+    }
+    if (++ab_phase_frame_ >= kAbPhaseFrames) {
+      ab_phase_frame_ = 0;
+      ab_phase_ ^= 1;
+    }
+    g_rex_ab_queue_depth.store(ab_experiment_ == 2 && ab_phase_ == 0 ? ab_queue_depth_ : -1);
+    g_rex_ab_skipmem.store(ab_experiment_ == 3 ? (ab_phase_ == 0 ? 1 : 0) : -1);
+  } else {
+    g_rex_ab_queue_depth.store(-1);
+    g_rex_ab_skipmem.store(-1);
+  }
+  ab_frame_draws_ = ab_frame_native_ = ab_frame_binds_ = ab_frame_depth_ = ab_frame_dups_ = 0;
+  if (!ab_active_) return;
+  const uint64_t now_tick = GetTickCount64();
+  if (now_tick - ab_last_log_tick_ < 5000) return;
+  ab_last_log_tick_ = now_tick;
+  auto describe = [&](const AbStats& s) {
+    if (!s.frames) return std::string("no frames");
+    const double f = double(s.frames);
+    const double ms = double(s.ticks) * 1000.0 / double(stat_qpc_freq_) / f;
+    std::string t = fmt::format("{:.1f} fps ({:.2f} ms), {:.0f} draws ({:.0f} native), {:.0f} "
+                                "pipeline binds, {:.2f} us/draw frame time",
+                                1000.0 / ms, ms, s.draws / f, s.native_draws / f, s.binds / f,
+                                s.draws ? ms * 1000.0 / (s.draws / f) : 0.0);
+    if (s.gpu_seconds > 0.0) {
+      const double colour_draws = double(s.draws - s.depth_draws);
+      t += fmt::format(
+          ", GPU {:.2f} ms (draws {:.2f} ms = {:.2f} us/draw; depth-only {:.0f} draws {:.2f} ms = "
+          "{:.2f} us/draw; colour {:.0f} draws {:.2f} ms = {:.2f} us/draw)",
+          s.gpu_seconds * 1000.0 / f, s.gpu_draw_seconds * 1000.0 / f,
+          s.draws ? s.gpu_draw_seconds * 1e6 / double(s.draws) : 0.0, s.depth_draws / f,
+          s.gpu_depth_seconds * 1000.0 / f,
+          s.depth_draws ? s.gpu_depth_seconds * 1e6 / double(s.depth_draws) : 0.0,
+          colour_draws / f, (s.gpu_draw_seconds - s.gpu_depth_seconds) * 1000.0 / f,
+          colour_draws > 0 ? (s.gpu_draw_seconds - s.gpu_depth_seconds) * 1e6 / colour_draws
+                           : 0.0);
+    }
+    if (s.dups) t += fmt::format(", {:.0f} duplicated draws", s.dups / f);
+    return t;
+  };
+  auto raw = [](const AbStats& s) {
+    return fmt::format("{} {} {} {} {} {:.6f} {:.6f} {} {} {:.6f}", s.frames, s.ticks, s.draws,
+                       s.native_draws, s.binds, s.gpu_seconds, s.gpu_draw_seconds, s.depth_draws,
+                       s.dups, s.gpu_depth_seconds);
+  };
+  REXLOG_INFO("NATIVE A/B ({}) last 5 s: ON {} | OFF {} | raw qpc {} [{}] [{}]",
+              ab_experiment_ == 1   ? "dup"
+              : ab_experiment_ == 2 ? "queue"
+              : ab_experiment_ == 3 ? "skipmem"
+                                    : "native", describe(ab_stats_[0]),
+              describe(ab_stats_[1]), stat_qpc_freq_, raw(ab_stats_[0]), raw(ab_stats_[1]));
+  for (int i = 0; i < 2; ++i) {
+    AbStats& t = ab_total_[i];
+    const AbStats& s = ab_stats_[i];
+    t.frames += s.frames;
+    t.ticks += s.ticks;
+    t.draws += s.draws;
+    t.native_draws += s.native_draws;
+    t.binds += s.binds;
+    t.gpu_seconds += s.gpu_seconds;
+    t.gpu_draw_seconds += s.gpu_draw_seconds;
+    t.depth_draws += s.depth_draws;
+    t.dups += s.dups;
+    t.gpu_depth_seconds += s.gpu_depth_seconds;
+    ab_stats_[i] = AbStats();
+  }
+  REXLOG_INFO("NATIVE A/B since start: ON {} | OFF {}", describe(ab_total_[0]),
+              describe(ab_total_[1]));
+}
