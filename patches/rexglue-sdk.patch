+// XUserReadStats (xgi_app.cpp 0xB0021): rows of these players (friends board,
+// the player's own stats). The title library checked results_size already.
+uint32_t LiveStatsRead(uint32_t num_xuids, uint32_t xuids_ptr, uint32_t num_specs, uint32_t specs_ptr,
+                       uint32_t results_size, uint32_t results_ptr) {
+  if (!results_ptr || !specs_ptr || !num_specs || num_specs > 64) return X_E_INVALIDARG;
+  auto* mem = REX_KERNEL_MEMORY();
+  const auto specs = CopySpecs(num_specs, mem->TranslateVirtual<X_USER_STATS_SPEC*>(specs_ptr));
+  std::string request = "list " + SpecViews(specs, ',');
+  const uint32_t nx = std::min<uint32_t>(num_xuids, 100);
+  for (uint32_t i = 0; i < nx && xuids_ptr; ++i)
+    request += fmt::format(" {:016x}", memory::load_and_swap<uint64_t>(mem->TranslateVirtual(xuids_ptr + i * 8)));
+  // Reads that include a skill view (0xFFFFxxxx, TrueSkill: read when a Ranked
+  // match is set up, and on some STATISTICS pages) are answered here at once
+  // with a zero row per player for the other views - what the server answered
+  // before anyone had stats. 2026-10-28: once real stats came back (after a 1 s
+  // wait on the game thread) the host ended every Ranked match right after it
+  // started ("You lost").
+  bool skill = false;
+  for (const auto& s : specs) skill = skill || (s.view >> 16) == 0xFFFFu;
+  std::vector<StatsView> answer;
+  if (skill) {
+    for (const auto& s : specs) {
+      if ((s.view >> 16) == 0xFFFFu) continue;
+      StatsView v;
+      v.view = s.view;
+      for (uint32_t i = 0; i < nx && xuids_ptr; ++i) {
+        StatsRow r;
+        r.xuid = memory::load_and_swap<uint64_t>(mem->TranslateVirtual(xuids_ptr + i * 8));
+        v.rows.push_back(std::move(r));
+      }
+      answer.push_back(std::move(v));
+    }
+  } else {
+    answer = QueryStats(request);
+  }
+  FillStats(results_ptr, mem->TranslateVirtual<uint8_t*>(results_ptr), results_size, specs, answer, nx);
+  static std::atomic<int> told{0};
+  if (told++ < 40) REXLOG_INFO("LIVE XUserReadStats '{}':{}", request, DescribeAnswer(answer));
+  return X_E_SUCCESS;
+}
+
+// XSessionWriteStats (xgi_app.cpp 0xB0025): one player's results for some
+// views. session_flags / others / ranked: the session it was written in.
+// At match end the game writes one row per player back to back (all on the
+// same tick), and by then the session's remote count and the game's player
+// list are often already gone (others came out 0 in a 2-player Ranked match,
+// so the server refused it). So the rows of one session are collected for
+// ~1.5 s and posted together; others = at least (distinct XUIDs - 1).
+namespace {
+struct PendingStats {
+  uint32_t flags = 0;
+  int others = 0;
+  bool ranked = false;
+  std::vector<uint64_t> xuids;
+  std::string lines;
+};
+std::mutex g_pending_stats_mutex;
+std::map<uint32_t, PendingStats> g_pending_stats;
+}  // namespace
+
+void LiveStatsWrite(uint32_t session_obj, uint64_t xuid, uint32_t num_views, uint32_t views_ptr,
+                    uint32_t session_flags, int others, bool ranked) {
+  if (!REXCVAR_GET(xam_signed_in_to_live) || !views_ptr || !num_views) return;
+  auto* mem = REX_KERNEL_MEMORY();
+  std::string lines;
+  for (uint32_t i = 0; i < std::min<uint32_t>(num_views, 64); ++i) {
+    const uint8_t* v = mem->TranslateVirtual<uint8_t*>(views_ptr + i * 12);
+    const uint32_t view = memory::load_and_swap<uint32_t>(v + 0);
+    const uint32_t nprops = std::min<uint32_t>(memory::load_and_swap<uint32_t>(v + 4), 64);
+    const uint32_t props_ptr = memory::load_and_swap<uint32_t>(v + 8);
+    if (!props_ptr || !nprops) continue;
+    std::string line = fmt::format("W {:016x} {}", xuid, view);
+    for (uint32_t k = 0; k < nprops; ++k) {
+      const uint8_t* p = mem->TranslateVirtual<uint8_t*>(props_ptr + k * 24);
+      const uint32_t id = memory::load_and_swap<uint32_t>(p + 0);
+      const uint8_t type = p[8];
+      int64_t value = 0;
+      if (type == kDataInt32) value = int32_t(memory::load_and_swap<uint32_t>(p + 16));
+      else if (type == kDataInt64) value = int64_t(memory::load_and_swap<uint64_t>(p + 16));
+      else if (type == 3) {  // double
+        const uint64_t bits = memory::load_and_swap<uint64_t>(p + 16);
+        double d;
+        std::memcpy(&d, &bits, 8);
+        value = int64_t(d);
+      } else if (type == 5) {  // float
+        const uint32_t bits = memory::load_and_swap<uint32_t>(p + 16);
+        float f;
+        std::memcpy(&f, &bits, 4);
+        value = int64_t(f);
+      } else {
+        continue;
+      }
+      line += fmt::format(" {:x}={}", id, value);
+    }
+    lines += line + "\n";
+  }
+  static std::atomic<int> told{0};
+  if (told++ < 200)
+    REXLOG_INFO("LIVE XSessionWriteStats(session {:08X}, xuid {:016X}, {} views): {}", session_obj, xuid, num_views,
+                lines.empty() ? std::string("(no rows)") : lines.substr(0, 400));
+  if (lines.empty()) return;
+  bool first = false;
+  {
+    std::lock_guard<std::mutex> l(g_pending_stats_mutex);
+    auto it = g_pending_stats.find(session_obj);
+    first = it == g_pending_stats.end();
+    auto& b = g_pending_stats[session_obj];
+    b.flags = session_flags ? session_flags : b.flags;
+    b.others = std::max(b.others, others);
+    b.ranked = b.ranked || ranked;
+    if (std::find(b.xuids.begin(), b.xuids.end(), xuid) == b.xuids.end()) b.xuids.push_back(xuid);
+    b.lines += lines;
+  }
+  if (!first) return;
+  std::thread([session_obj]() {
+    std::this_thread::sleep_for(std::chrono::milliseconds(1500));
+    PendingStats b;
+    {
+      std::lock_guard<std::mutex> l(g_pending_stats_mutex);
+      auto it = g_pending_stats.find(session_obj);
+      if (it == g_pending_stats.end()) return;
+      b = std::move(it->second);
+      g_pending_stats.erase(it);
+    }
+    const int others = std::max(b.others, int(b.xuids.size()) - 1);
+    std::string body = fmt::format("S {:x} {} {} {}\n", b.flags, others, b.ranked ? 1 : 0,
+                                   rex::system::online::Modded() ? 1 : 0) + b.lines;
+    REXLOG_INFO("Leaderboards: posting {} player(s), others {}, ranked {}", b.xuids.size(), others, b.ranked ? 1 : 0);
+    rex::system::online::LiveStatsPostAsync("/lb/write", MyName(), std::move(body));
+  }).detach();
+}
