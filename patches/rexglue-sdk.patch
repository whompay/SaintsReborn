+// NATIVE11 M4 step 1 (codex19_present_hook_plan steps 1+3, codex18_native_prepass_plan step 1): native pre-pass TRACE
+// (dist\native_prepass_trace, default off = one int test per draw and per resolve). A CP-side state machine over the
+// 4x city depth pre-pass (RB_SURFACE_INFO pitch 640 4x, depth base 768), NO rendering and NO suppression: pass entry
+// (is the first draw the clear rectangle?), geometry draws (native city-depth family / alpha-tested with a PS /
+// other), the closing EDA62EA0/F759AB12 mask draws, the 0E93C000 resolve terminator and the touched scissor /
+// viewport extent (the 1280x720 vs 1280x816 backing question), logged every 10 s as 'NATIVE PREPASS TRACE'.
+int g_np_mode = 0;
+namespace {
+struct NativePrepassTrace {
+  int state = 0;  // 0 idle, 1 inside the 4x layout, 2 pass completed by the 0E93C000 resolve
+  uint32_t draws = 0, geom = 0, geom_native = 0, geom_ps = 0, mask = 0, other = 0;
+  uint32_t max_x = 0, max_y = 0;
+  float vp_max_x = 0.0f, vp_max_y = 0.0f;
+  bool first_is_clear = false;
+  uint64_t passes = 0, aborted = 0, w_draws = 0, w_clear = 0, w_geom = 0, w_native = 0, w_ps = 0, w_mask = 0,
+           w_other = 0, w_resolve_other = 0;
+  uint32_t w_max_x = 0, w_max_y = 0;
+  float w_vp_max_x = 0.0f, w_vp_max_y = 0.0f;
+  std::string abort_reason, mask_states;
+  std::map<std::tuple<uint64_t, uint64_t, uint32_t, uint32_t>, uint64_t> sigs;  // non-native draws
+  uint64_t poll_tick = 0, log_tick = 0;
+};
+NativePrepassTrace g_np;
+void NativePrepassPoll() {
+  const uint64_t now = GetTickCount64();
+  if (now - g_np.poll_tick < 500) return;
+  g_np.poll_tick = now;
+  const int mode = RexFlagExistsW(L"native_prepass_trace") ? 1 : 0;
+  if (mode != g_np_mode) {
+    REXLOG_INFO("Native pre-pass trace (NATIVE11 M4 step 1): {}", mode ? "ON" : "off");
+    g_np = NativePrepassTrace();
+    g_np.poll_tick = now;
+  }
+  g_np_mode = mode;
+}
+void NativePrepassTraceDraw(const RegisterFile& regs, uint64_t vs_hash, uint64_t ps_hash, bool native_family,
+                            reg::RB_DEPTHCONTROL dc, uint32_t cmask) {
+  const auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  const bool in4x = si.msaa_samples == xenos::MsaaSamples::k4X && si.surface_pitch == 640 &&
+                    depth_info.depth_base == 768;
+  if (!in4x) {
+    if (g_np.state == 1) {
+      ++g_np.aborted;
+      if (g_np.abort_reason.empty()) {
+        g_np.abort_reason = fmt::format("left the 4x layout after {} draws without the 0E93C000 resolve", g_np.draws);
+      }
+      g_np.state = 0;
+    }
+    return;
+  }
+  if (g_np.state != 1) {
+    g_np.state = 1;
+    g_np.draws = g_np.geom = g_np.geom_native = g_np.geom_ps = g_np.mask = g_np.other = 0;
+    g_np.max_x = g_np.max_y = 0;
+    g_np.vp_max_x = g_np.vp_max_y = 0.0f;
+    g_np.first_is_clear = false;
+  }
+  ++g_np.draws;
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  g_np.max_x = std::max(g_np.max_x, scissor.offset[0] + scissor.extent[0]);
+  g_np.max_y = std::max(g_np.max_y, scissor.offset[1] + scissor.extent[1]);
+  g_np.vp_max_x = std::max(g_np.vp_max_x, std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE)) +
+                                              regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE + 1));
+  g_np.vp_max_y = std::max(g_np.vp_max_y, std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE + 2)) +
+                                              regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE + 3));
+  const auto draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (g_np.draws == 1) {
+    g_np.first_is_clear = vs_hash == 0x0A6D1DD7767FDF27ull &&
+                          draw_initiator.prim_type == xenos::PrimitiveType::kRectangleList && dc.z_enable &&
+                          dc.z_write_enable && dc.zfunc == xenos::CompareFunction::kAlways;
+  }
+  bool record = false;
+  if (vs_hash == 0xEDA62EA0A7D033A6ull && ps_hash == 0xF759AB12AE1BBB82ull) {
+    ++g_np.mask;
+    if (g_np.mask_states.size() < 60) {
+      g_np.mask_states += fmt::format(" {:08X}/{:08X}", dc.value, uint32_t(regs[XE_GPU_REG_RB_STENCILREFMASK]));
+    }
+  } else if (!cmask && dc.z_enable) {
+    ++g_np.geom;
+    if (native_family) {
+      ++g_np.geom_native;
+    } else {
+      if (ps_hash) ++g_np.geom_ps;
+      record = true;
+    }
+  } else {
+    ++g_np.other;
+    record = true;
+  }
+  if (record && g_np.sigs.size() < 512) ++g_np.sigs[std::make_tuple(vs_hash, ps_hash, dc.value, cmask)];
+}
+void NativePrepassTraceResolve(const RegisterFile& regs) {
+  if (g_np.state == 1) {
+    const uint32_t dest = uint32_t(regs[XE_GPU_REG_RB_COPY_DEST_BASE]);
+    if (dest == 0x0E93C000u || (dest << 12) == 0x0E93C000u) {
+      ++g_np.passes;
+      g_np.w_draws += g_np.draws;
+      g_np.w_clear += g_np.first_is_clear ? 1 : 0;
+      g_np.w_geom += g_np.geom;
+      g_np.w_native += g_np.geom_native;
+      g_np.w_ps += g_np.geom_ps;
+      g_np.w_mask += g_np.mask;
+      g_np.w_other += g_np.other;
+      g_np.w_max_x = std::max(g_np.w_max_x, g_np.max_x);
+      g_np.w_max_y = std::max(g_np.w_max_y, g_np.max_y);
+      g_np.w_vp_max_x = std::max(g_np.w_vp_max_x, g_np.vp_max_x);
+      g_np.w_vp_max_y = std::max(g_np.w_vp_max_y, g_np.vp_max_y);
+      g_np.state = 2;
+    } else {
+      ++g_np.w_resolve_other;
+    }
+  }
+  const uint64_t now = GetTickCount64();
+  if (!g_np.log_tick) g_np.log_tick = now;
+  if (now - g_np.log_tick < 10000) return;
+  const double seconds = double(now - g_np.log_tick) / 1000.0;
+  g_np.log_tick = now;
+  const double n = g_np.passes ? double(g_np.passes) : 1.0;
+  std::vector<std::pair<uint64_t, std::tuple<uint64_t, uint64_t, uint32_t, uint32_t>>> top;
+  for (const auto& [k, v] : g_np.sigs) top.emplace_back(v, k);
+  std::sort(top.begin(), top.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+  std::string tops;
+  for (size_t i = 0; i < top.size() && i < 10; ++i) {
+    tops += fmt::format(" [{:016X}/{:016X} dc {:08X} cmask {:04X}: {:.1f}]", std::get<0>(top[i].second),
+                        std::get<1>(top[i].second), std::get<2>(top[i].second), std::get<3>(top[i].second),
+                        top[i].first / n);
+  }
+  REXLOG_INFO(
+      "NATIVE PREPASS TRACE (M4, {:.0f} s): passes {:.1f}/s aborted {} ({}) other resolves inside {} | per pass: draws "
+      "{:.1f}, first draw = clear rectangle {:.0f} % | geometry {:.1f} (native depth family {:.1f}, other with PS "
+      "{:.1f}) | mask draws {:.2f} (dc/stencil{}) | other draws {:.1f} | touched scissor max {}x{} viewport max "
+      "{:.0f}x{:.0f} | top non-native per pass:{}",
+      seconds, g_np.passes / seconds, g_np.aborted, g_np.abort_reason, g_np.w_resolve_other, g_np.w_draws / n,
+      100.0 * g_np.w_clear / n, g_np.w_geom / n, g_np.w_native / n, g_np.w_ps / n, g_np.w_mask / n, g_np.mask_states,
+      g_np.w_other / n, g_np.w_max_x, g_np.w_max_y, g_np.w_vp_max_x, g_np.w_vp_max_y, tops);
+  const int state = g_np.state;
+  const uint64_t poll_tick = g_np.poll_tick, log_tick = g_np.log_tick;
+  const uint32_t draws = g_np.draws, geom = g_np.geom, geom_native = g_np.geom_native, geom_ps = g_np.geom_ps,
+                 mask = g_np.mask, other = g_np.other, max_x = g_np.max_x, max_y = g_np.max_y;
+  const float vp_max_x = g_np.vp_max_x, vp_max_y = g_np.vp_max_y;
+  const bool first_is_clear = g_np.first_is_clear;
+  g_np = NativePrepassTrace();  // new window, keep the pass in progress
+  g_np.state = state;
+  g_np.poll_tick = poll_tick;
+  g_np.log_tick = log_tick;
+  g_np.draws = draws;
+  g_np.geom = geom;
+  g_np.geom_native = geom_native;
+  g_np.geom_ps = geom_ps;
+  g_np.mask = mask;
+  g_np.other = other;
+  g_np.max_x = max_x;
+  g_np.max_y = max_y;
+  g_np.vp_max_x = vp_max_x;
+  g_np.vp_max_y = vp_max_y;
+  g_np.first_is_clear = first_is_clear;
+}
