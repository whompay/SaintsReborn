+// DRAW SOURCES (native renderer research, 2026-09-27): which command buffers
+// the draws come from. Per indirect buffer (address, length, nesting depth):
+// how often it runs and how many draws it holds. Precompiled buffers show up
+// as the same address every frame. Logged every 10 s.
+namespace {
+struct DrawSourceStats {
+  uint32_t executions = 0, draws = 0, length = 0, depth = 0;
+};
+std::unordered_map<uint64_t, DrawSourceStats> g_draw_sources;
+uint64_t g_draw_sources_frame_draws[6] = {};
+// Per-draw / per-buffer statistics (DRAW SOURCES) cost a hash map update and a
+// clock read on every draw: only with the file "gpu_perf_diag" next to the exe.
+bool GpuPerfDiag() {
+  static const bool on = [] {
+    FILE* f = std::fopen("gpu_perf_diag", "rb");
+    if (f) std::fclose(f);
+    return f != nullptr;
+  }();
+  return on;
+}
+std::chrono::steady_clock::time_point g_draw_sources_next{};
+uint64_t DrawSourceKey(uint32_t ptr, int depth) { return (uint64_t(uint32_t(depth)) << 32) | ptr; }
+void LogDrawSources() {
+  const auto now = std::chrono::steady_clock::now();
+  if (g_draw_sources_next.time_since_epoch().count() == 0) g_draw_sources_next = now + std::chrono::seconds(10);
+  if (now < g_draw_sources_next) return;
+  g_draw_sources_next = now + std::chrono::seconds(10);
+  std::vector<std::pair<uint64_t, DrawSourceStats>> v(g_draw_sources.begin(), g_draw_sources.end());
+  std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) { return a.second.draws > b.second.draws; });
+  uint64_t total = 0;
+  for (auto d : g_draw_sources_frame_draws) total += d;
+  size_t with_draws = 0;
+  for (const auto& e : v) with_draws += e.second.draws != 0;
+  std::string line = fmt::format(
+      "DRAW SOURCES (10 s): draws {} | by depth: ring {} ib1 {} ib2 {} ib3+ {} | buffers {} ({} with draws) | top:",
+      total, g_draw_sources_frame_draws[0], g_draw_sources_frame_draws[1], g_draw_sources_frame_draws[2],
+      g_draw_sources_frame_draws[3] + g_draw_sources_frame_draws[4] + g_draw_sources_frame_draws[5], v.size(), with_draws);
+  for (size_t i = 0; i < v.size() && i < 25; ++i) {
+    const auto& e = v[i];
+    line += fmt::format(" [{:08X} d{} len {:X}: runs {} draws {}]", uint32_t(e.first), e.second.depth, e.second.length,
+                        e.second.executions, e.second.draws);
+  }
+  REXLOG_INFO("{}", line);
+  // How many distinct buffers ran with few runs (per-frame built) vs many (reused).
+  size_t reused = 0, reused_draws = 0;
+  for (const auto& e : v)
+    if (e.second.executions >= 100) { ++reused; reused_draws += e.second.draws; }
+  REXLOG_INFO("DRAW SOURCES: buffers run 100+ times in 10 s: {} holding {} draws", reused, reused_draws);
+  g_draw_sources.clear();
+  for (auto& d : g_draw_sources_frame_draws) d = 0;
+}
