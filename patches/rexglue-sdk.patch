+// prev_dest = guest destination of the resolve before this one (any kind).
+bool IsLastSceneResolve(uint64_t frame, uint32_t prev_dest, bool clearing_color);
+
+// Called by the hook for every resolve IsLastSceneResolve returned true for:
+// applied = Apply succeeded. A skipped or failed apply invalidates the
+// history (bloom, sky sums, lag), so nothing older than one frame is reused.
+void NoteApplyResult(uint64_t frame, bool applied);
