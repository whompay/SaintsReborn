+void OnLogin(const EOS_Connect_LoginCallbackInfo* d) {
+  if (d->ResultCode == EOS_EResult::EOS_Success) { me = d->LocalUserId; Online(); return; }
+  if (d->ResultCode == EOS_EResult::EOS_InvalidUser && d->ContinuanceToken) {
+    EOS_Connect_CreateUserOptions c{};
+    c.ApiVersion = EOS_CONNECT_CREATEUSER_API_LATEST;
+    c.ContinuanceToken = d->ContinuanceToken;
+    p_EOS_Connect_CreateUser(connect_if, &c, nullptr, [](const EOS_Connect_CreateUserCallbackInfo* u) {
+      if (u->ResultCode != EOS_EResult::EOS_Success) { REXSYS_WARN("EOS LAN: creating the player: {}", R(u->ResultCode)); state = State::Failed; return; }
+      me = u->LocalUserId;
+      Online();
+    });
+    return;
+  }
+  REXSYS_WARN("EOS LAN: login failed: {}", R(d->ResultCode));
+  state = State::Failed;
+}
+void Login() {
+  state = State::LoggingIn;
+  EOS_Connect_CreateDeviceIdOptions c{};
+  c.ApiVersion = EOS_CONNECT_CREATEDEVICEID_API_LATEST;
+  c.DeviceModel = "PC";
+  p_EOS_Connect_CreateDeviceId(connect_if, &c, nullptr, [](const EOS_Connect_CreateDeviceIdCallbackInfo* d) {
+    if (d->ResultCode != EOS_EResult::EOS_Success && d->ResultCode != EOS_EResult::EOS_DuplicateNotAllowed) {
+      REXSYS_WARN("EOS LAN: device ID: {}", R(d->ResultCode));
+      state = State::Failed;
+      return;
+    }
+    static EOS_Connect_Credentials cred{};
+    cred.ApiVersion = EOS_CONNECT_CREDENTIALS_API_LATEST;
+    cred.Token = nullptr;
+    cred.Type = EOS_EExternalCredentialType::EOS_ECT_DEVICEID_ACCESS_TOKEN;
+    static EOS_Connect_UserLoginInfo info{};
+    info.ApiVersion = EOS_CONNECT_USERLOGININFO_API_LATEST;
+    static std::string name;
+    char user[64] = {};
+    DWORD n = sizeof(user);
+    name = rex::cvar::GetFlagByName("xam_player_name");
+    if (name.empty()) name = GetUserNameA(user, &n) ? std::string(user).substr(0, 30) : "Player";
+    name = rex::system::online::SafeName(name);
+    if (name.empty()) name = "Player";
+    info.DisplayName = name.c_str();
+    EOS_Connect_LoginOptions l{};
+    l.ApiVersion = EOS_CONNECT_LOGIN_API_LATEST;
+    l.Credentials = &cred;
+    l.UserLoginInfo = &info;
+    p_EOS_Connect_Login(connect_if, &l, nullptr, [](const EOS_Connect_LoginCallbackInfo* r) { OnLogin(r); });
+  });
+}
