+// rt8/rt9: every gate the host's system-link search reply passes (type-0 handler
+// sub_823598B0 -> reply sub_82359500). Addresses = lis base + signed offset as in the
+// code (rt7 read 0x8270xxxx = code by mistake; the real globals are 0x8370xxxx).
+static void LogReplyGates(const char* why, int n) {
+    auto* mem = REX_KERNEL_MEMORY();
+    auto u8at = [&](uint32_t a) -> uint32_t { return *mem->TranslateVirtual<const uint8_t*>(a); };
+    auto u32at = [&](uint32_t a) -> uint32_t {
+      const uint8_t* q = mem->TranslateVirtual<const uint8_t*>(a);
+      return (uint32_t(q[0]) << 24) | (uint32_t(q[1]) << 16) | (uint32_t(q[2]) << 8) | q[3];
+    };
+    auto hex = [&](uint32_t a, uint32_t len) {
+      std::string h;
+      const uint8_t* q = mem->TranslateVirtual<const uint8_t*>(a);
+      for (uint32_t i = 0; i < len; ++i) h += fmt::format("{:02X}", q[i]);
+      return h;
+    };
+    const uint32_t kActive = 0x83710000u - 5642;      // 0x8370E9F6 net active (must be 1)
+    const uint32_t kHost = 0x83710000u - 5665;        // 0x8370E9DF is host (must be 1)
+    const uint32_t kModeSel = 0x83710000u + 179 - 5478;  // 0x8370EB4D selects the state check
+    const uint32_t kState = 0x827D0000u + 22412;      // 0x827D578C game state (== 6 when ModeSel == 0)
+    const uint32_t kStateIdx = kState - 12;           // 0x827D5780 index into 0x82B30E78 (value 5/6)
+    const uint32_t kStateTab = 0x82B30000u + 3704;    // 0x82B30E78
+    const uint32_t kSession = 0x83710000u - 4968;     // 0x8370EC98 session object (+104 must be 6)
+    const uint32_t mode_sel = u8at(kModeSel);
+    const int32_t state = int32_t(u32at(kState));
+    const int32_t idx = int32_t(u32at(kStateIdx));
+    int32_t tab = -999;
+    if (idx >= 0 && idx < 256) tab = int32_t(u32at(kStateTab + uint32_t(idx) * 4));
+    const uint32_t sess = u32at(kSession);
+    int32_t sess_state = -999;
+    if (sess >= 0x40000000u && sess < 0xA0000000u) sess_state = int32_t(u32at(sess + 104));
+    const bool gate_flags = u8at(kActive) == 1 && u8at(kHost) == 1;
+    const bool gate_state = mode_sel ? (tab == 5 || tab == 6) : (state == 6);
+    const bool gate_sess = sess != 0 && sess_state == 6;
+    REXKRNL_INFO(
+        "NET reply gates ({} #{}): active {} host {} -> {} | modesel(EB4D) {} state(578C) {} idx(5780) {} tab {} -> {} | "
+        "session(EC98) {:08X} +104 {} -> {} | WOULD REPLY {} | id(EBE8) {}",
+        why, n, u8at(kActive), u8at(kHost), gate_flags ? "ok" : "BLOCKS", mode_sel, state, idx, tab,
+        gate_state ? "ok" : "BLOCKS", sess, sess_state, gate_sess ? "ok" : "BLOCKS",
+        (gate_flags && gate_state && gate_sess) ? "yes" : "no", hex(0x83710000u - 5144, 8));
+}
