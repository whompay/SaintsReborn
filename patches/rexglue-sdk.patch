+/**
+ ******************************************************************************
+ * Native-frame engine capture bridge (verification ABI v1).
+ ******************************************************************************
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+
+// Plain C ABI shared by the recompiled game and rexgpu-xenos.dll. Records are
+// copied by the callee; the caller may release or reuse its storage as soon as
+// RexNativeRendererSubmitMeshRecordV1 returns.
+#define REX_NATIVE_MESH_RECORD_VERSION_1 1u
+#define REX_NATIVE_MESH_RECORD_FLAG_VERIFY_ONLY 1u
+
+typedef struct RexNativeMeshRecordV1 {
+  uint32_t size;
+  uint32_t version;
+  uint64_t frame_id;
+  uint32_t sequence;
+  uint32_t pass_id;
+  uint32_t flags;
+  uint32_t thread_id;
+  uint32_t primitive_type;
+  uint32_t index_count;
+  uint32_t start_index;
+  int32_t base_vertex;
+  uint32_t mesh_guest;
+  uint32_t instance_guest;
+  uint32_t device_guest;
+  uint32_t vertex_shader_guest;
+  uint32_t pixel_shader_guest;
+  uint32_t index_buffer_guest;
+  uint32_t vertex_decl_guest;
+  uint32_t surface_info;
+  uint32_t color_mask;
+  uint32_t depth_control;
+} RexNativeMeshRecordV1;
+
+#if defined(__cplusplus)
+static_assert(sizeof(RexNativeMeshRecordV1) == 88, "native mesh record ABI changed");
+static_assert(offsetof(RexNativeMeshRecordV1, frame_id) == 8, "native mesh frame_id ABI changed");
+static_assert(offsetof(RexNativeMeshRecordV1, sequence) == 16, "native mesh sequence ABI changed");
+static_assert(offsetof(RexNativeMeshRecordV1, depth_control) == 84,
+              "native mesh depth_control ABI changed");
+#endif
+
+
+// Verification ABI v2 (AGENT_FRAME 2026-10-23): one record per actual draw packet of every hooked engine
+// draw writer (not just mesh pass 8), keyed by the guest address just past the DRAW_INDX / DRAW_INDX_2
+// packet in the device's command buffer. The command processor sees the same address for the packet it
+// executes, so each CP draw maps to exactly one record (no state search, no ambiguity) and the record's
+// state can be checked field by field. Still verification-only: nothing is skipped or replaced.
+// Hashes: uint32 values in host order (registers / byteswapped device shadow), hashed with
+// RexNativeBridgeHashWords below, VS/PS float constants per group of 4 constants (16 words), fetch
+// constants per 2-word unit (texture slot s = units 3s..3s+2, vertex fetch k = unit k).
+#define REX_NATIVE_DRAW_RECORD_VERSION_2 2u
+#define REX_NATIVE_DRAW_FLAG_VERIFY_ONLY 1u
+#define REX_NATIVE_DRAW_FLAG_HAS_PACKET 2u     // packet_end valid
+#define REX_NATIVE_DRAW_FLAG_PM4_GEOMETRY 4u   // primitive/count decoded from the packet (not engine args)
+#define REX_NATIVE_DRAW_FLAG_INDEXED 8u        // DMA index source
+#define REX_NATIVE_DRAW_FLAG_STATE 16u         // device-shadow fields + hashes valid
