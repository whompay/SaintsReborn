+// records {u32 type, u32 pad, s64 value}, the count at +512; the pack is the
+// second XMsgInProcessCall parameter. Scalars are passed as pointers to them.
+template <class Mem>
+bool PackValue(Mem* memory, uint32_t pack, uint32_t index, uint32_t& value) {
+  if (!pack) return false;
+  auto* p = memory->template TranslateVirtual<uint8_t*>(pack);
+  if (rex::memory::load_and_swap<uint32_t>(p + 512) <= index) return false;
+  value = uint32_t(rex::memory::load_and_swap<uint64_t>(p + index * 16 + 8));
+  return true;
+}
+void PutBE32(uint8_t* p, uint32_t v) { rex::memory::store_and_swap<uint32_t>(p, v); }
