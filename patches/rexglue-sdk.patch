+class XStatsEnumerator : public XEnumerator {
+ public:
+  XStatsEnumerator(KernelState* ks, std::vector<StatsSpec> specs, std::string request, uint32_t rows)
+      : XEnumerator(ks, 1, 0), specs_(std::move(specs)), request_(std::move(request)), rows_(rows) {}
+  uint32_t size() const { return StatsBufferSize(specs_, rows_); }
+  uint32_t WriteItems(uint32_t buffer_ptr, uint8_t* buffer_data, uint32_t* written_count) override {
+    if (done_) return X_ERROR_NO_MORE_FILES;
+    done_ = true;
+    const auto answer = QueryStats(request_);
+    FillStats(buffer_ptr, buffer_data, size(), specs_, answer, rows_);
+    REXLOG_INFO("LIVE leaderboards '{}':{}", request_, DescribeAnswer(answer));
+    if (written_count) *written_count = 1;
+    return X_ERROR_SUCCESS;
+  }
+
+ private:
+  std::vector<StatsSpec> specs_;
+  std::string request_;
+  uint32_t rows_;
+  bool done_ = false;
+};
