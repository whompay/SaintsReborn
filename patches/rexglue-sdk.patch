+// RESOLVE COST (NATIVE18): GPU time of each resolve split by destination and phase (dist gpu_timing_resolves,
+// needs gpu_timing; log-only). Timer categories 0x40 + slot * 4 + phase (phase 0 pre / scene post, 1 copy + direct
+// snapshot, 2 EDRAM dump, 3 clear + transfers); command_processor.cpp PollGpuTimer counts them as resolves.
+constexpr uint32_t kRcostSlots = 32;
+struct RcostSlot {
+  uint32_t base = 0, w = 0, h = 0, fmt = 0, depth = 0, msaa = 0, clear = 0;
+  uint64_t count = 0;
+  double sec[4] = {};
+};
+static RcostSlot g_rcost[kRcostSlots];
+static uint32_t g_rcost_used = 0, g_rcost_poll = 0;
+static bool g_rcost_on = false;
+static uint32_t RcostBegin(const draw_util::ResolveInfo& ri) {
+  if ((g_rcost_poll++ & 1023) == 0) {
+    g_rcost_on = RexFlagExistsW(L"gpu_timing_resolves");
+  }
+  if (!g_rcost_on) return UINT32_MAX;
+  const uint32_t base = ri.copy_dest_extent_length ? ri.copy_dest_base : 0;
+  uint32_t slot = UINT32_MAX;
+  for (uint32_t i = 0; i < g_rcost_used && slot == UINT32_MAX; ++i) {
+    if (g_rcost[i].base == base) slot = i;
+  }
+  if (slot == UINT32_MAX) {
+    // Last slot = all destinations beyond the table.
+    slot = g_rcost_used < kRcostSlots - 1 ? g_rcost_used++ : kRcostSlots - 1;
+    if (slot != kRcostSlots - 1) g_rcost[slot].base = base;
+  }
+  RcostSlot& r = g_rcost[slot];
+  if (!r.count) {
+    const bool depth = ri.IsCopyingDepth();
+    const draw_util::ResolveEdramInfo e = depth ? ri.depth_edram_info : ri.color_edram_info;
+    if (slot == kRcostSlots - 1) r.base = 0xFFFFFFFFu;
+    r.w = ri.coordinate_info.width_div_8 * 8;
+    r.h = ri.height_div_8 * 8;
+    r.fmt = uint32_t(ri.copy_dest_info.copy_dest_format);
+    r.depth = depth ? 1 : 0;
+    r.msaa = 1u << uint32_t(e.msaa_samples);
+    r.clear = (ri.IsClearingDepth() ? 1 : 0) | (ri.IsClearingColor() ? 2 : 0);
+  }
+  ++r.count;
+  return slot;
+}
+static void RcostPhase(D3D12CommandProcessor& cp, uint32_t slot, uint32_t phase) {
+  if (slot != UINT32_MAX) cp.GpuTimerSwitch(uint8_t(0x40 + slot * 4 + phase));
+}
+void RcostAdd(uint8_t category, double sec) {
+  const uint32_t c = uint32_t(category) - 0x40;
+  if (c < kRcostSlots * 4) g_rcost[c >> 2].sec[c & 3] += sec;
+}
+void RcostLog(uint32_t frames) {
+  if (!g_rcost_on || !frames || !g_rcost_used) return;
+  const double f = 1000.0 / double(frames);
+  uint32_t order[kRcostSlots];
+  uint32_t n = 0;
+  for (uint32_t i = 0; i < kRcostSlots; ++i) {
+    if (g_rcost[i].count) order[n++] = i;
+  }
+  auto tot = [](const RcostSlot& r) { return r.sec[0] + r.sec[1] + r.sec[2] + r.sec[3]; };
+  std::sort(order, order + n, [&](uint32_t a, uint32_t b) { return tot(g_rcost[a]) > tot(g_rcost[b]); });
+  double all = 0;
+  std::string s;
+  for (uint32_t k = 0; k < n; ++k) {
+    RcostSlot& r = g_rcost[order[k]];
+    all += tot(r);
+    s += fmt::format(" | {:08X} {} x{} {}x{} f{} cl{} n {:.1f}: {:.3f} (pre {:.3f} copy {:.3f} dump {:.3f} clear {:.3f})",
+                     r.base, r.depth ? "D" : "C", r.msaa, r.w, r.h, r.fmt, r.clear, double(r.count) / frames,
+                     tot(r) * f, r.sec[0] * f, r.sec[1] * f, r.sec[2] * f, r.sec[3] * f);
+    r.count = 0;
+    r.sec[0] = r.sec[1] = r.sec[2] = r.sec[3] = 0;
+  }
+  REXLOG_INFO("RESOLVE COST (NATIVE18) ms/frame: total {:.3f} ({} frames){}", all * f, frames, s);
+}
