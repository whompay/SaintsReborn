+// Diagnostic (file "resolve_diag"): per resolve destination + copy control, how
+// often it repeats with no draws since the previous identical resolve.
+static bool ResolveDiagOn() {
+  static const bool on = [] {
+    FILE* f = std::fopen("resolve_diag", "rb");
+    if (f) std::fclose(f);
+    return f != nullptr;
+  }();
+  return on;
+}
+struct ResolveDiagEntry {
+  uint64_t count = 0, repeats_no_draws = 0, last_serial = ~uint64_t(0), draws_between = 0;
+};
+static void ResolveDiagNote(uint32_t address, uint32_t length, uint32_t copy_control,
+                            uint32_t surface_info, uint32_t dest_info) {
+  static std::unordered_map<uint64_t, ResolveDiagEntry> entries;
+  static std::unordered_map<uint64_t, uint64_t> keys_info;
+  static auto last_log = std::chrono::steady_clock::now();
+  static uint64_t last_any_serial = 0, no_draws_since_any = 0;
+  const uint64_t key = (uint64_t(address) << 32) ^ (uint64_t(length) << 8) ^
+                       (uint64_t(copy_control) * 0x9E3779B97F4A7C15ull) ^
+                       (uint64_t(surface_info) * 0xC2B2AE3D27D4EB4Full) ^ dest_info;
+  keys_info[key] = (uint64_t(address) << 32) | copy_control;
+  ResolveDiagEntry& e = entries[key];
+  ++e.count;
+  if (e.last_serial == g_resolve_diag_draw_serial) {
+    ++e.repeats_no_draws;
+  } else if (e.last_serial != ~uint64_t(0)) {
+    e.draws_between += g_resolve_diag_draw_serial - e.last_serial;
+  }
+  e.last_serial = g_resolve_diag_draw_serial;
+  if (last_any_serial == g_resolve_diag_draw_serial) {
+    ++no_draws_since_any;
+  }
+  last_any_serial = g_resolve_diag_draw_serial;
+  const auto now = std::chrono::steady_clock::now();
+  const double secs = std::chrono::duration<double>(now - last_log).count();
+  if (secs < 10.0) {
+    return;
+  }
+  last_log = now;
+  std::string text;
+  for (const auto& [k, v] : entries) {
+    const uint64_t info = keys_info[k];
+    text += fmt::format(" [{:08X} ctl {:08X}: {:.1f}/s, repeat w/o draws {:.1f}/s, avg draws between {:.0f}]",
+                        uint32_t(info >> 32), uint32_t(info), v.count / secs,
+                        v.repeats_no_draws / secs,
+                        v.count > v.repeats_no_draws ? double(v.draws_between) / double(v.count) : 0.0);
+  }
+  REXLOG_INFO("RESOLVE DIAG: no draws since previous resolve {:.1f}/s |{}", no_draws_since_any / secs, text);
+  entries.clear();
+  keys_info.clear();
+  no_draws_since_any = 0;
+}
