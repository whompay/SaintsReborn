+// Built instead of eos_lan.cpp when the Epic Online Services SDK headers
+// aren't available (REX_EOS_SDK_INCLUDE not set / not found). Online play
+// over Epic (Live lobbies, PLAYERS list, invites, chat) is then off; System
+// Link still works on a real LAN / VPN through xsocket.cpp.
+#include <atomic>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex::system::eoslan {
+
+struct LiveAdvertEntry {
+  std::string text;
+  bool modded = true;
+  std::string name;
+};
+struct OnlinePlayer {
+  uint64_t xuid = 0;
+  std::string puid, name, where;
+  bool modded = true;
+  bool in_session = false;
+  uint8_t session_id[8] = {};
+  bool online = true;
+  bool mutual = false;
+};
+
+std::atomic<bool> session_active{false};
+
+bool Start() { return false; }
+void Activate(const char*) {}
+bool Enabled() { return false; }
+uint32_t VirtualIp() { return 0; }
+bool IsVirtual(uint32_t ip) { return (ip >> 16) == ((10u << 8) | 77u) || ip == 0xFFFFFFFFu; }
+uint16_t HelperPort() { return 0; }
+void SetLiveAdvert(const std::string&) {}
+std::vector<LiveAdvertEntry> LiveAdverts(uint32_t) { return {}; }
+bool LiveReady() { return false; }
+uint64_t XuidForPuid(const std::string&) { return 0; }
+void SetQosData(const uint8_t[8], const uint8_t*, size_t) {}
+bool QosData(const uint8_t[8], std::vector<uint8_t>&) { return false; }
+std::vector<OnlinePlayer> FriendsList() { return {}; }
+std::vector<OnlinePlayer> OnlinePlayers() { return {}; }
+void SetSessionHost(const uint8_t*, bool) {}
+bool CheckHostMap(uint16_t, bool found) { return found; }
+void SetInviteSession(const uint8_t*) {}
+int SendInvites(const std::vector<uint64_t>&) { return -1; }
+bool AcceptPendingInvite() { return false; }
+bool AcceptedInvite(uint64_t&, uint8_t[60]) { return false; }
+void SetPrivateSession(bool) {}
+void Send(uint32_t, uint16_t, uint16_t, const uint8_t*, size_t) {}
+
+}  // namespace rex::system::eoslan
+
+#ifdef _WIN32
+#define SR_EXPORT extern "C" __declspec(dllexport)
+#else
+#define SR_EXPORT extern "C"
+#endif
+SR_EXPORT int SrEosLend(int) { return 1; }
+SR_EXPORT void SrEosReturn() {}
+// Marker: this runtime was built without the Epic SDK (the PLAYERS row then
+// says so instead of "CONNECTING...").
+SR_EXPORT int SrEosStub() { return 1; }
+SR_EXPORT int SrMapCheck(uint32_t, int found) { return found ? 1 : 0; }
