+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  auto& d = direct_resolve_dest_stats_[base];
+  d.width = width;
+  d.height = height;
+  ++d.resolves;
+  if (memory_skipped) ++d.memory_skipped;
+}
+
+const char* D3D12TextureCache::WhyNotSkipResolveMemory(uint32_t base) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (const auto& e : direct_resolves_) {
+    if (e.base == base) {
+      if (!e.consumer) return "no consumer texture";
+      if (e.never_skip) return "read the old way";
+      if (e.consumer_streak < 3) return "streak < 3";
+      return "ok";
+    }
+  }
+  return "no entry";
+}
+
+void D3D12TextureCache::InvalidateDirectResolves(uint32_t start, uint32_t length,
+                                                 bool memory_written) {
+  const uint32_t end = start + length;
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (auto& e : direct_resolves_) {
+    if (memory_written && start < e.extent_end && e.extent_start < end) e.memory_stale = false;
+    if (e.valid && start < e.extent_end && e.extent_start < end) {
+      e.valid = false;
+      ++direct_resolve_stat_invalidated_;
+    }
+  }
+}
