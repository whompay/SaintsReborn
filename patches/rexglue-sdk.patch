+// NATIVE11 (codex19 #3/#4): reads every finished per-compare result slot, releases retired verify textures.
+void DirectDepthHarvest(D3D12CommandProcessor& cp) {
+  const uint64_t completed = cp.GetCompletedSubmission();
+  for (size_t i = 0; i < g_dd.retired.size();) {
+    if (g_dd.retired[i].first <= completed) {
+      g_dd.retired[i] = std::move(g_dd.retired.back());
+      g_dd.retired.pop_back();
+    } else {
+      ++i;
+    }
+  }
+  if (!g_dd.readback) return;
+  bool any = false;
+  for (uint32_t i = 0; i < kDirectDepthSlots; ++i) {
+    if (g_dd.slot_pending[i] && g_dd.slot_submission[i] <= completed) any = true;
+  }
+  if (!any) return;
+  D3D12_RANGE range = {0, size_t(kDirectDepthSlots) * 32};
+  void* mapping = nullptr;
+  if (FAILED(g_dd.readback->Map(0, &range, &mapping))) return;
+  for (uint32_t i = 0; i < kDirectDepthSlots; ++i) {
+    if (!g_dd.slot_pending[i] || g_dd.slot_submission[i] > completed) continue;
+    g_dd.slot_pending[i] = false;
+    uint32_t r[5];
+    std::memcpy(r, static_cast<const uint8_t*>(mapping) + size_t(i) * 32, sizeof(r));
+    ++g_dd.harvested;
+    ++g_dd.total_harvested;
+    if (r[0]) {
+      ++g_dd.harvested_bad;
+      ++g_dd.total_harvested_bad;
+      g_dd.bad_texels += r[0];
+      g_dd.total_bad_texels += r[0];
+      g_dd.max_diff = std::max<uint64_t>(g_dd.max_diff, r[1]);
+      if (g_dd.first_bad.empty()) {
+        g_dd.first_bad = fmt::format(" | first bad compare: {:08X} {}x{} frame {} texels {} at {},{} loaded {:08X} "
+                                     "direct {:08X}",
+                                     g_dd.slot_base[i], g_dd.slot_w[i], g_dd.slot_h[i], g_dd.slot_frame[i], r[0],
+                                     r[2] & 0xFFFF, r[2] >> 16, r[3], r[4]);
+      }
+    }
+  }
+  D3D12_RANGE written = {0, 0};
+  g_dd.readback->Unmap(0, &written);
+}
