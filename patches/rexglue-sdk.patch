+      bool4 ok = abs(dz - z) <= 0.05 * z;
+      uint ni = uint(f.x + 0.5) + 2u * uint(f.y + 0.5);
+      bool nok = ni == 0u ? ok.x : ni == 1u ? ok.y : ni == 2u ? ok.z : ok.w;
+      uint pick = nok ? ni : ok.x ? 0u : ok.y ? 1u : ok.z ? 2u : ok.w ? 3u : ni;
