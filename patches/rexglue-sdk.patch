+// XNetQosLookup(cxna, apxna, apxnkid, apxnkey, cina, aina, adwServiceId,
+// cProbes, dwBitsPerSec, dwFlags, hEvent, ppxnqos) - game wrapper
+// sub_8265AC68, used before joining a Live session (search result or invite).
+// Players reach each other over the Epic virtual LAN, so every target is
+// reported contacted with a good connection; the real join follows.
+u32 NetDll_XNetQosLookup_entry(u32 caller, u32 cxna, u32 apxna, u32 apxnkid, u32 apxnkey, u32 cina, u32 aina,
+                               u32 service_ids, u32 probes, u32 bits_per_sec, u32 flags, u32 event_handle,
+                               u32 ppqos) {
+  const uint32_t count = std::min<uint32_t>(uint32_t(cxna) + uint32_t(cina), 64);
+  static constexpr uint32_t kDataRoom = 128;  // per target: the host's QoS data (XNetQosListen)
+  const uint32_t size = 8 + (24 + kDataRoom) * std::max<uint32_t>(count, 1);
+  const uint32_t qos_guest = REX_KERNEL_MEMORY()->SystemHeapAlloc(size);
+  if (!qos_guest) return X_ERROR_FUNCTION_FAILED;
