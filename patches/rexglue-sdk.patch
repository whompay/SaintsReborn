+void ParseRgb(const std::string& value, float* rgb) {
+  float v[3] = {rgb[0], rgb[1], rgb[2]};
+  size_t i = 0;
+  for (int c = 0; c < 3 && i <= value.size(); ++c) {
+    size_t j = value.find_first_of("/:", i);
+    if (j == std::string::npos) j = value.size();
+    if (j > i) {
+      const float t = float(std::atof(value.substr(i, j - i).c_str()));
+      if (std::isfinite(t)) v[c] = std::clamp(t, 0.0f, 4.0f);
+    }
+    i = j + 1;
+  }
+  rgb[0] = v[0];
+  rgb[1] = v[1];
+  rgb[2] = v[2];
+}
+
+void ParseOptions(const std::string& text, Options& o) {
+  std::vector<std::pair<std::string, std::string>> tokens;
+  std::string preset = "modern";
+  size_t i = 0;
+  while (i < text.size()) {
+    while (i < text.size() && (std::isspace(uint8_t(text[i])) || text[i] == ',' || text[i] == ';')) ++i;
+    size_t j = i;
+    while (j < text.size() && !std::isspace(uint8_t(text[j])) && text[j] != ',' && text[j] != ';') ++j;
+    if (j == i) break;
+    std::string token = text.substr(i, j - i);
+    i = j;
+    for (char& c : token) c = char(std::tolower(uint8_t(c)));
+    std::string key = token, value;
+    size_t eq = token.find('=');
+    if (eq != std::string::npos) {
+      key = token.substr(0, eq);
+      value = token.substr(eq + 1);
+    }
+    if (key == "preset") {
+      preset = value;
+    } else {
+      tokens.emplace_back(key, value);
+    }
+  }
+  ApplyPreset(preset, o);
+  for (const auto& kv : tokens) {
+    const std::string& key = kv.first;
+    const std::string& value = kv.second;
+    const float f = value.empty() ? 0.0f : float(std::atof(value.c_str()));
+    if (!std::isfinite(f)) continue;
+    const bool b = value.empty() || f != 0.0f;
+    if (key == "noao") o.ao = false;
+    else if (key == "nobloom") o.bloom = false;
+    else if (key == "notonemap") o.tonemap = false;
+    else if (key == "nosky") o.sky_on = false;
+    else if (key == "novoid") o.void_on = false;
+    else if (key == "nohaze") o.haze_on = false;
+    else if (key == "ao") o.ao = b;
+    else if (key == "bloom") o.bloom = b;
+    else if (key == "tonemap") o.tonemap = b;
+    else if (key == "debug")
+      o.debug = value == "ao" ? 1 : value == "depth" ? 2 : value == "logz" ? 3 : value == "haze" ? 4 : 0;
+    else if (key == "ao_radius") o.ao_radius = std::clamp(f, 0.01f, 8192.0f);
+    else if (key == "ao_strength") o.ao_strength = std::clamp(f, 0.0f, 8.0f);
+    else if (key == "ao_max_px") o.ao_max_px = std::clamp(f, 2.0f, 128.0f);
+    else if (key == "ao_samples") o.ao_samples = int(std::clamp(f, 2.0f, 24.0f));
+    else if (key == "ao_div") o.ao_div = int(std::clamp(f, 0.0f, 8.0f));
+    else if (key == "fov") o.fov = std::clamp(f, 10.0f, 150.0f);
+    else if (key == "bloom_threshold") o.bloom_threshold = std::clamp(f, 0.0f, 0.99f);
+    else if (key == "bloom_strength") o.bloom_strength = std::clamp(f, 0.0f, 4.0f);
+    else if (key == "bloom_radius") o.bloom_radius = std::clamp(f, 0.25f, 4.0f);
+    else if (key == "exposure") o.exposure = std::clamp(f, 0.0f, 16.0f);
+    else if (key == "contrast") o.contrast = std::clamp(f, 0.25f, 4.0f);
+    else if (key == "saturation") o.saturation = std::clamp(f, 0.0f, 4.0f);
+    else if (key == "vibrance") o.vibrance = std::clamp(f, -1.0f, 2.0f);
+    else if (key == "shoulder") o.shoulder = std::clamp(f, 0.1f, 1.0f);
+    else if (key == "white") o.white = std::clamp(f, 1.0f, 64.0f);
+    else if (key == "lift") o.lift = std::clamp(f, 0.0f, 0.5f);
+    else if (key == "filmic") o.filmic = std::clamp(f, 0.0f, 1.0f);
+    else if (key == "split") o.split = std::clamp(f, 0.0f, 2.0f);
+    else if (key == "temperature") o.temperature = std::clamp(f, -1.0f, 1.0f);
+    else if (key == "tint") o.tint = std::clamp(f, -1.0f, 1.0f);
+    else if (key == "vignette") o.vignette = std::clamp(f, 0.0f, 1.0f);
+    else if (key == "sharpen") o.sharpen = std::clamp(f, 0.0f, 1.0f);
+    else if (key == "black") o.black = std::clamp(f, 0.0f, 0.2f);
+    else if (key == "sky") o.sky = std::clamp(f, 0.0f, 1.0f);
+    else if (key == "horizon") o.horizon = std::clamp(f, 0.05f, 1.0f);
+    else if (key == "sky_top") ParseRgb(value, o.sky_top);
+    else if (key == "sky_horizon") ParseRgb(value, o.sky_horizon);
+    else if (key == "void") o.void_level = std::clamp(f, 0.0f, 2.0f);
+    else if (key == "haze") o.haze = std::clamp(f, 0.0f, 1.0f);
+    else if (key == "haze_start") o.haze_start = std::clamp(f, 1.0f, 1.0e6f);
+    else if (key == "haze_end") o.haze_end = std::clamp(f, 2.0f, 2.0e6f);
+    else if (key == "ao_color") o.ao_color = std::clamp(f, 0.0f, 2.0f);
+    else if (key == "nouav") o.uav = false;
+    else if (key == "ao_split") o.ao_split = b;
+    else if (key == "ao_lag1") o.ao_lag1 = b;
+    else if (key == "ao_far") o.ao_far = std::clamp(f, 0.0f, 1.0e6f);
+    else if (key == "v15") o.v15 = b;
+    else if (key == "count_pick") o.count_pick = b;
+    else if (key == "bloom_prev") o.bloom_prev = b;
+    else if (key == "ao_rel") o.ao_rel = std::clamp(f, 0.0f, 4.0f);
+    else if (key == "lag") o.lag = b;
+    else if (key == "ao_fused") o.ao_fused = b;
+    else if (key == "sky_sums") o.sky_sums = b;
+    else if (key == "skylight") o.skylight = std::clamp(f, 0.0f, 1.0f);
+    else if (key == "clarity") o.clarity = std::clamp(f, 0.0f, 1.0f);
+    else if (key == "uav") o.uav = b;
+    else if (key == "dest") o.dest = uint32_t(std::strtoul(value.c_str(), nullptr, 16));
+  }
+  if (o.haze_end <= o.haze_start) o.haze_end = o.haze_start * 2.0f;
+}
+
+bool ReadFile(const char* name, std::string& out) {
+  FILE* f = std::fopen(name, "rb");
+  if (!f) return false;
+  out.clear();
+  char buffer[512];
+  size_t n;
+  while ((n = std::fread(buffer, 1, sizeof(buffer), f)) > 0 && out.size() < 4096) out.append(buffer, n);
+  std::fclose(f);
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Shaders
+// ---------------------------------------------------------------------------
+
+const char kShaders[] = R"(
+cbuffer Constants : register(b0) {
+  uint2 origin;          // region origin in the colour / depth render targets
+  uint2 size;            // region size (host pixels)
+  uint2 out_size;        // output size of this pass
+  float2 inv_size;       // 1 / size
+  float focal;           // host pixels
+  float ao_radius;       // view space, near-plane units
+  float ao_strength;
+  float ao_max_px;       // host pixels
+  float bloom_threshold;
+  float bloom_strength;
+  float exposure;
+  float saturation;
+  float contrast;
+  float shoulder;
+  float white;
+  float lift;
+  float step;
+  float scale;
+  uint flags;
+  uint ao_samples;
+  uint ao_div;
+  uint frame;
+  float vibrance;
+  float filmic;
+  float split;
+  float temperature;
+  float tint;
+  float vignette;
+  float sharpen;
+  float black;
+  float sky;
+  float horizon;
+  float sky_top_r;
+  float sky_top_g;
+  float sky_top_b;
+  float sky_hor_r;
+  float sky_hor_g;
+  float sky_hor_b;
+  float void_level;
+  float haze;
+  float haze_log_start;
+  float haze_log_inv_range;
+  float ao_color;
+  float skylight;
+  float clarity;
+  float ao_far;          // 0 = AO at every depth
+  float ao_rel;          // MAIN20: AO radius <= ao_rel * z (0 = off)
+};
+Texture2D<float4> t0 : register(t0);
+Texture2D<float4> t1 : register(t1);
+Texture2D<float4> t2 : register(t2);
+Texture2D<float4> t3 : register(t3);
+Texture2D<float4> t4 : register(t4);
+RWTexture2D<float4> u0 : register(u0);
+RWTexture2D<float> u0_r : register(u0);    // R32 sky average (4 x 1)
+RWTexture2D<float4> u1 : register(u1);     // final: 1/8 res bright pass (next frame's bloom)
+RWTexture3D<float4> u2 : register(u2);     // lut_main: the grade LUT (32^3)
+RWTexture2D<float4> u2s : register(u2);    // final: 1/8 res sky sums (rgb mean, a = sky fraction)
+Texture3D<float4> t5 : register(t5);       // final: the grade LUT
+SamplerState s0 : register(s0);
+
+float LinZ(float d) { return 1.0 / max(d, 1e-7); }
+float3 ViewPos(float2 p, float z) { return float3((p - 0.5 * float2(size)) * (z / focal), z); }
+float DepthAt(int2 p) {
+  p = clamp(p, int2(0, 0), int2(size) - 1);
+  return t0.Load(int3(int2(origin) + p, 0)).r;
+}
+
+static const uint kBayer[16] = {0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5};
+
+// Gamma 2.0 (square / sqrt): exact round trip, a fraction of the cost of pow.
+float3 ToLinear(float3 c) { return c * c; }
+float3 ToGamma(float3 c) { return sqrt(saturate(c)); }
+float Luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }
+
+// AO resolution (size / ao_div): x = occlusion (1 = open), y = linear depth (0 = sky),
+// z = up component of the view space normal (-1 down .. 1 up).
+float3 AoAt(uint2 id) {
+  int2 pf = int2(id) * int(ao_div) + int(ao_div / 2u);
+  int st = max(1, int(scale));
+  // LIGHT19: the centre and its 4 neighbours in one batch of loads (the
+  // neighbours used to wait for the centre's early-out test).
+  // SP_OLD = the session-15 order (option v15, for A/B only).
+  float d = DepthAt(pf);
+#ifdef SP_OLD
+  if (d <= 1e-6) return float3(1.0, 0.0, 0.0);
+#endif
+  float d_r = DepthAt(pf + int2(st, 0));
+  float d_l = DepthAt(pf - int2(st, 0));
+  float d_d = DepthAt(pf + int2(0, st));
+  float d_u = DepthAt(pf - int2(0, st));
+  if (d <= 1e-6) return float3(1.0, 0.0, 0.0);
+  float z = LinZ(d);
+  float2 pc = float2(pf) + 0.5;
+  float3 P = ViewPos(pc, z);
+  float3 pr = ViewPos(pc + float2(st, 0), LinZ(d_r));
+  float3 pl = ViewPos(pc - float2(st, 0), LinZ(d_l));
+  float3 pd = ViewPos(pc + float2(0, st), LinZ(d_d));
+  float3 pu = ViewPos(pc - float2(0, st), LinZ(d_u));
+  float3 dx = abs(pr.z - z) < abs(z - pl.z) ? pr - P : P - pl;
+  float3 dy = abs(pd.z - z) < abs(z - pu.z) ? pd - P : P - pu;
+  float3 n = cross(dy, dx);
+  float nn = dot(n, n);
+  n = nn > 0.0 ? n * rsqrt(nn) : float3(0.0, 0.0, -1.0);
+  if (dot(n, P) > 0.0) n = -n;
+  // Beyond ao_far: open AO but keep the normal (skylight uses it).
+  if (ao_far > 0.0 && z > ao_far) return float3(1.0, min(z, 60000.0), -n.y);
+  float r_w = ao_rel > 0.0 ? min(ao_radius, ao_rel * z) : ao_radius;
+  float r_px = clamp(r_w * focal * d, 2.0 * scale, ao_max_px);
+  float r2 = r_w * r_w;
+  uint k = (id.x & 3u) * 4u + (id.y & 3u);
+  float rot = (float(kBayer[k]) + 0.5) * (6.2831853 / 16.0);
+  float jit = float(kBayer[(k + 5u) & 15u]) / 16.0;
+  // One sincos per pixel; the golden-angle steps are a constant rotation.
+  float2 dir;
+  sincos(rot, dir.y, dir.x);
+  const float gc = -0.7373688, gs = 0.6754903;  // cos / sin(2.3999632)
+  float occ = 0.0;
+  float inv_n = 1.0 / float(ao_samples);
+#ifndef SP_OLD
+  if (ao_samples <= 8u) {
+    // LIGHT19: up to 8 samples unrolled, all 8 depth loads issued together
+    // (the [loop] below waits for one load per iteration). Same positions,
+    // weights and order; samples >= ao_samples are masked out.
+    float2 spos[8];
+    float sdep[8];
+    [unroll] for (uint i = 0; i < 8u; ++i) {
+      float t = (float(i) + jit + 0.5) * inv_n;
+      spos[i] = floor(pc + dir * (r_px * t));
+      dir = float2(gc * dir.x - gs * dir.y, gs * dir.x + gc * dir.y);
+      sdep[i] = DepthAt(int2(spos[i]));
+    }
+    [unroll] for (uint j = 0; j < 8u; ++j) {
+      float ds = sdep[j];
+      if (j >= ao_samples || ds <= 1e-6) continue;
+      float3 v = ViewPos(spos[j] + 0.5, LinZ(ds)) - P;
+      float vv = dot(v, v);
+      float falloff = saturate(1.0 - vv / r2);
+      occ += falloff * saturate(dot(v, n) * rsqrt(vv + 1e-8) - 0.15);
+    }
+    float ao8 = saturate(1.0 - ao_strength * occ * (2.0 * inv_n));
+    return float3(ao8, min(z, 60000.0), -n.y);
+  }
+#endif
+  [loop] for (uint i = 0; i < ao_samples; ++i) {
+    float t = (float(i) + jit + 0.5) * inv_n;
+    float2 sp = pc + dir * (r_px * t);
+    dir = float2(gc * dir.x - gs * dir.y, gs * dir.x + gc * dir.y);
+    int2 si = int2(floor(sp));
+    float ds = DepthAt(si);
+    if (ds <= 1e-6) continue;
+    float3 v = ViewPos(float2(si) + 0.5, LinZ(ds)) - P;
+    float vv = dot(v, v);
+    float falloff = saturate(1.0 - vv / r2);
+    occ += falloff * saturate(dot(v, n) * rsqrt(vv + 1e-8) - 0.15);
+  }
+  float ao = saturate(1.0 - ao_strength * occ * (2.0 * inv_n));
+  return float3(ao, min(z, 60000.0), -n.y);  // RGBA16F: keep z finite
+}
+
+[numthreads(8, 8, 1)]
+void ao_main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= out_size)) return;
+  u0[id.xy] = float4(AoAt(id.xy), 0.0);
+}
+
+// AO + its 4x4 depth-aware blur in ONE pass (no extra barrier stage, no
+// ao_raw round trip): a 19x19 tile = 16x16 outputs + halo (1 before, 2
+// after) computed into groupshared, then the same blur as ao_blur_main.
+// Halo texels outside the image are clamped exactly like the blur's loads.
+groupshared float3 g_ao[361];
+// 16 x 16 threads fill the 19 x 19 tile (the first 105 also do a second
+// texel): full waves, same texels and blur as a 19 x 19 group.
+void AoTile(uint t, uint2 gid) {
+  int2 q = int2(gid) * 16 - 1 + int2(t % 19u, t / 19u);
+  q = clamp(q, int2(0, 0), int2(out_size) - 1);
+  g_ao[t] = AoAt(uint2(q));
+}
+[numthreads(16, 16, 1)]
+void ao_fused_main(uint3 gt : SV_GroupThreadID, uint3 gid : SV_GroupID, uint gi : SV_GroupIndex) {
+  AoTile(gi, gid.xy);
+  if (gi < 361u - 256u) AoTile(gi + 256u, gid.xy);
+  GroupMemoryBarrierWithGroupSync();
+  uint2 l = uint2(gi & 15u, gi >> 4);
+  uint2 o = gid.xy * 16u + l;
+  if (any(o >= out_size)) return;
+  float3 c = g_ao[(l.y + 1u) * 19u + l.x + 1u];
+  if (c.y <= 0.0) { u0[o] = float4(1.0, 0.0, 0.0, 0.0); return; }
+  if (ao_far > 0.0 && c.y > ao_far) { u0[o] = float4(c, 0.0); return; }
+  float2 sum = 0.0;
+  float wsum = 0.0;
+  float inv_tol = 1.0 / (0.05 * c.y);
+  [unroll] for (uint y = 0; y < 4; ++y) {
+    [unroll] for (uint x = 0; x < 4; ++x) {
+      float3 s = g_ao[(l.y + y) * 19u + l.x + x];
+      float w = s.y > 0.0 ? saturate(1.0 - abs(s.y - c.y) * inv_tol) : 0.0;
+      sum += s.xz * w;
+      wsum += w;
+    }
+  }
+  float2 r = wsum > 0.0 ? sum / wsum : c.xz;
+  u0[o] = float4(r.x, c.y, r.y, 0.0);
+}
+
+// 4x4 depth-aware blur (matches the 4x4 rotation pattern). The 8x8 group
+// loads its 11x11 input tile (1 before, 2 after, clamped like single loads)
+// once into groupshared memory: same texels, weights and order.
+groupshared float3 g_ab[121];
+void AoBlurTile(uint t, uint2 gid) {
+  int2 q = int2(gid) * 8 - 1 + int2(t % 11u, t / 11u);
+  q = clamp(q, int2(0, 0), int2(out_size) - 1);
+  g_ab[t] = t0.Load(int3(q, 0)).xyz;
+}
+[numthreads(8, 8, 1)]
+void ao_blur_main(uint3 gt : SV_GroupThreadID, uint3 gid : SV_GroupID, uint gi : SV_GroupIndex) {
+  AoBlurTile(gi, gid.xy);
+  if (gi < 121u - 64u) AoBlurTile(gi + 64u, gid.xy);
+  GroupMemoryBarrierWithGroupSync();
+  uint2 o = gid.xy * 8u + gt.xy;
+  if (any(o >= out_size)) return;
+  float3 c = g_ab[(gt.y + 1u) * 11u + gt.x + 1u];
+  if (c.y <= 0.0) { u0[o] = float4(1.0, 0.0, 0.0, 0.0); return; }
+  if (ao_far > 0.0 && c.y > ao_far) { u0[o] = float4(c, 0.0); return; }
+  float2 sum = 0.0;
+  float wsum = 0.0;
+  float inv_tol = 1.0 / (0.05 * c.y);
+  [unroll] for (uint y = 0; y < 4; ++y) {
+    [unroll] for (uint x = 0; x < 4; ++x) {
+      float3 sm = g_ab[(gt.y + y) * 11u + gt.x + x];
+      float w = sm.y > 0.0 ? saturate(1.0 - abs(sm.y - c.y) * inv_tol) : 0.0;
+      sum += sm.xz * w;
+      wsum += w;
+    }
+  }
+  float2 r = wsum > 0.0 ? sum / wsum : c.xz;
+  u0[o] = float4(r.x, c.y, r.y, 0.0);
+}
+
+// 1/8 res 13-tap dual filter of the previous frame's 1/8 res bright pass
+// (written by final_main; rgb = bright pass, a = luma), spread = step 1/8 res texels.
+[numthreads(8, 8, 1)]
+void bloom_blur_main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= out_size)) return;
+  uint2 src_size;
+  t0.GetDimensions(src_size.x, src_size.y);
+  float2 inv_src = 1.0 / float2(src_size);
+  float2 uv = (float2(id.xy) + 0.5) * inv_src;
+  float2 o = inv_src * step;
+  float4 a = t0.SampleLevel(s0, uv + o * float2(-2, -2), 0.0);
+  float4 b = t0.SampleLevel(s0, uv + o * float2(0, -2), 0.0);
+  float4 c = t0.SampleLevel(s0, uv + o * float2(2, -2), 0.0);
+  float4 d = t0.SampleLevel(s0, uv + o * float2(-1, -1), 0.0);
+  float4 e = t0.SampleLevel(s0, uv + o * float2(1, -1), 0.0);
+  float4 f = t0.SampleLevel(s0, uv + o * float2(-2, 0), 0.0);
+  float4 g = t0.SampleLevel(s0, uv, 0.0);
+  float4 h = t0.SampleLevel(s0, uv + o * float2(2, 0), 0.0);
+  float4 i = t0.SampleLevel(s0, uv + o * float2(-1, 1), 0.0);
+  float4 j = t0.SampleLevel(s0, uv + o * float2(1, 1), 0.0);
+  float4 k = t0.SampleLevel(s0, uv + o * float2(-2, 2), 0.0);
+  float4 l = t0.SampleLevel(s0, uv + o * float2(0, 2), 0.0);
+  float4 m = t0.SampleLevel(s0, uv + o * float2(2, 2), 0.0);
+  float4 acc = (d + e + i + j) * 0.125 + (a + c + k + m) * 0.03125 + (b + f + h + l) * 0.0625 +
+               g * 0.125;
+  u0[id.xy] = acc;
+}
+
+// MAIN20: THIS frame's 1/8 res bright pass + luma (bloom, clarity), from the
+// colour target before final (the previous frame's one lags behind the camera
+// and pumps on fast turns). One group = one 1/8 res texel (8 x 8 pixels).
+groupshared float4 g_bp[64];
+[numthreads(8, 8, 1)]
+void bright_main(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint gi : SV_GroupIndex) {
+  bool inside = all(id.xy < size);
+  int2 p = min(int2(id.xy), int2(size) - 1);
+  float3 lin = ToLinear(t0.Load(int3(int2(origin) + p, 0)).rgb);
+  float l = Luma(lin);
+  float knee = bloom_threshold * 0.5;
+  float soft = clamp(l - bloom_threshold + knee, 0.0, 2.0 * knee);
+  soft = soft * soft / (4.0 * knee + 1e-5);
+  float contribution = max(soft, l - bloom_threshold) / max(l, 1e-4);
+  g_bp[gi] = inside ? float4(lin * contribution, l) : 0.0.xxxx;
+  GroupMemoryBarrierWithGroupSync();
+  if (gi < 8u) {
+    float4 col = 0.0;
+    [unroll] for (uint r = 0; r < 8; ++r) col += g_bp[gi + r * 8u];
+    g_bp[gi] = col;
+  }
+  GroupMemoryBarrierWithGroupSync();
+  if (gi == 0u) {
+    float4 sum = 0.0;
+    [unroll] for (uint r = 0; r < 8; ++r) sum += g_bp[r];
+    u0[gid.xy] = sum * (1.0 / 64.0);
+  }
+}
+
+// One group: average linear colour of the sky pixels (depth 0, not black),
+// smoothed over time. Input t0 = the 1/8 res sky sums written by the previous
+// frame's final pass (rgb = mean linear sky colour of the 8x8 block, a = sky
+// fraction of the block), read on a 64 x 32 grid; t2 = the previous sky
+// average (ping-pong, so this pass never reads what it writes and may run
+// next to final). Output u0_r 4 x 1: r g b, fraction of sky.
+groupshared float4 g_sky[256];
+[numthreads(256, 1, 1)]
+void sky_main(uint3 id : SV_DispatchThreadID) {
+  float4 acc = 0.0;
+  if (flags & 131072u) {
+    // This frame's colour (t3) + depth (t1), before final changes them.
+    [unroll] for (uint r = 0; r < 8; ++r) {
+      uint row = (id.x >> 6) * 8u + r;
+      int2 p = int2((float2(id.x & 63u, row) + 0.5) * float2(size) / float2(64.0, 32.0));
+      int3 rp = int3(int2(origin) + p, 0);
+      float d = t1.Load(rp).r;
+      float3 c = t3.Load(rp).rgb;
+      if (d <= 1e-6 && Luma(c) > 0.03) acc += float4(ToLinear(c), 1.0);
+    }
+  } else if (flags & 32768u) {
+    uint2 ss;
+    t0.GetDimensions(ss.x, ss.y);
+    [unroll] for (uint r = 0; r < 8; ++r) {
+      uint row = (id.x >> 6) * 8u + r;
+      int2 p = int2((float2(id.x & 63u, row) + 0.5) * float2(ss) / float2(64.0, 32.0));
+      float4 v = t0.Load(int3(p, 0));
+      acc += float4(v.rgb * v.a, v.a);
+    }
+  }
+  g_sky[id.x] = acc;
+  GroupMemoryBarrierWithGroupSync();
+  [unroll] for (uint s = 128; s > 0; s >>= 1) {
+    if (id.x < s) g_sky[id.x] += g_sky[id.x + s];
+    GroupMemoryBarrierWithGroupSync();
+  }
+  if (id.x < 4) {
+    float4 t = g_sky[0];
+    uint ch = id.x;
+    float prev = t2.Load(int3(ch, 0, 0)).r;
+    float pl = Luma(float3(t2.Load(int3(0, 0, 0)).r, t2.Load(int3(1, 0, 0)).r, t2.Load(int3(2, 0, 0)).r));
+    bool have = t.w > 0.5;
+    float v = have ? (ch < 3u ? t[ch] / t.w : t.w / 2048.0) : (ch < 3u ? prev : 0.0);
+    // First use: take the new value at once (no sky yet = 0, never the
+    // undefined contents of a new texture). A big change of the sky
+    // brightness (cut, interior -> exterior, time of day jump) adapts in ~10
+    // frames instead of ~40; no sky on screen keeps the last sky colour.
+    // No valid sky sums (history invalidated) or no previous sky yet: fresh
+    // history, never an old average carried across a discontinuity.
+    bool fresh = frame == 0u || !(flags & 32768u) || !(pl > 1e-6) || !(abs(prev) < 1e6) ||
+                 !(abs(pl) < 1e6);
+    float nl = have ? Luma(t.rgb / t.w) : pl;
+    float rate = abs(nl - pl) > 0.6 * max(pl, 0.02) ? 0.3 : 0.08;
+    u0_r[uint2(ch, 0)] = fresh ? (have ? v : 0.0) : lerp(prev, v, rate);
+  }
+}
+
+// The colour grade, linear scene colour -> display colour (gamma 2), applied
+// through a 32^3 LUT: lut_main bakes it (when the options change), final_main
+// samples it. Input coordinate = sqrt(lin / kLutMax).
+static const float kLutMax = 1.5;
+float3 Grade(float3 lin) {
+  lin *= exposure;
+  // White balance.
+  lin *= float3(1.0 + 0.08 * temperature, 1.0 - 0.05 * tint, 1.0 - 0.08 * temperature);
+  float l = Luma(lin);
+  // Split tone: cool shadows, warm highlights (luma preserved).
+  if (split > 0.0 && l > 0.0) {
+    float wl = smoothstep(0.02, 0.5, l);
+    float3 tone = lerp(float3(1.0 - 0.07 * split, 1.0 + 0.01 * split, 1.0 + 0.10 * split),
+                       float3(1.0 + 0.06 * split, 1.0 + 0.01 * split, 1.0 - 0.09 * split), wl);
+    lin *= tone;
+    lin *= l / max(Luma(lin), 1e-6);
+  }
+  if (contrast != 1.0 && l > 0.0) lin *= pow(max(l / 0.18, 1e-6), contrast - 1.0);
+  l = Luma(lin);
+  lin = max(lerp(l.xxx, lin, saturation), 0.0);
+  if (vibrance != 0.0) {
+    float mx = max(lin.r, max(lin.g, lin.b)), mn = min(lin.r, min(lin.g, lin.b));
+    float sat = (mx - mn) / max(mx, 1e-4);
+    lin = max(lerp(Luma(lin).xxx, lin, 1.0 + vibrance * (1.0 - sat)), 0.0);
+  }
+  // Extended Reinhard shoulder: [shoulder, white] -> [shoulder, 1].
+  float r = 1.0 - shoulder;
+  if (r > 0.0) {
+    float wr = max(white - shoulder, r) / r;
+    float3 y = max(lin - shoulder, 0.0) / r;
+    float3 yt = y * (1.0 + y / (wr * wr)) / (1.0 + y);
+    lin = lin > shoulder ? shoulder + r * yt : lin;
+  }
+  if (black > 0.0) lin = max(lin - black, 0.0) / (1.0 - black);
+  float3 o = ToGamma(lin);
+  // Filmic S-curve on luma in display space (deeper shadows, brighter
+  // highlights, black and white stay put), hue kept.
+  if (filmic > 0.0) {
+    float gl = max(dot(o, float3(0.2126, 0.7152, 0.0722)), 1e-5);
+    float sl = gl * gl * (3.0 - 2.0 * gl);
+    float nl = lerp(gl, sl, filmic);
+    o = saturate(o * (nl / gl));
+  }
+  return o + lift * (1.0 - o);
+}
+
+[numthreads(4, 4, 4)]
+void lut_main(uint3 id : SV_DispatchThreadID) {
+  float3 e = float3(id) * (1.0 / 31.0);
+  u2[id] = float4(Grade(e * e * kLutMax), 1.0);
+}
+
+float3 SkyGradient(float yf) {
+  float t = pow(saturate(yf / horizon), 0.8);
+  return lerp(float3(sky_top_r, sky_top_g, sky_top_b), float3(sky_hor_r, sky_hor_g, sky_hor_b), t);
