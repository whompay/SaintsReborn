+
+void D3D12CommandProcessor::LogCpTime(double frames) {
+  if (!cp_timing_ || !cp_time_draws_) return;
+  LARGE_INTEGER q;
+  QueryPerformanceCounter(&q);
+  const uint64_t tsc = __rdtsc();
+  const double seconds = double(uint64_t(q.QuadPart) - cp_time_qpc0_) / double(stat_qpc_freq_);
+  if (seconds <= 0.0) return;
+  const double tsc_per_us = double(tsc - cp_time_tsc0_) / (seconds * 1e6);
+  static const char* const kNames[kCpTimeStages] = {
+      "shaders+submission", "primitives", "render targets", "pipeline", "textures",
+      "viewport+constants", "bindings", "vertex buffers", "draw record+tail"};
+  const double d = double(cp_time_draws_);
+  double total = 0.0;
+  std::string parts;
+  for (uint32_t i = 0; i < kCpTimeStages; ++i) {
+    const double us = double(cp_time_[i]) / tsc_per_us / d;
+    total += us;
+    parts += fmt::format(" | {} {:.3f}", kNames[i], us);
+  }
+  REXLOG_INFO("CP TIME per draw (us): total IssueDraw {:.3f} ({:.2f} ms/frame, {:.0f} draws/frame){} "
+              "| RT updates fast {:.0f} / full {:.0f} per frame",
+              total, total * d / frames / 1000.0, d / frames, parts,
+              render_target_cache_->stat_update_fast_ / frames,
+              render_target_cache_->stat_update_full_ / frames);
+  render_target_cache_->stat_update_fast_ = render_target_cache_->stat_update_full_ = 0;
+  for (uint64_t& t : cp_time_) t = 0;
+  cp_time_draws_ = 0;
+  cp_time_qpc0_ = uint64_t(q.QuadPart);
+  cp_time_tsc0_ = tsc;
+}
+
+void D3D12CommandProcessor::LogShaderCensus(double frames) {
+  if (shader_census_.empty()) return;
+  std::vector<const ShaderCensusEntry*> v;
+  uint64_t total = 0;
+  for (auto& [key, e] : shader_census_) {
+    v.push_back(&e);
+    total += e.draws;
+  }
+  std::sort(v.begin(), v.end(), [](auto* a, auto* b) { return a->draws > b->draws; });
+  std::string out;
+  static std::unordered_set<uint64_t> dumped;
+  std::error_code ec;
+  std::filesystem::create_directories("shader_dump", ec);
+  auto dump = [&](const Shader* shader, const char* kind) {
+    if (!shader || !dumped.insert(shader->ucode_data_hash()).second) return;
+    const std::string name =
+        fmt::format("shader_dump/{}_{:016X}.txt", kind, shader->ucode_data_hash());
+    if (FILE* f = std::fopen(name.c_str(), "wb")) {
+      const std::string& text = shader->ucode_disassembly();
+      std::fwrite(text.data(), 1, text.size(), f);
+      std::fclose(f);
+    }
+    const std::string bin =
+        fmt::format("shader_dump/{}_{:016X}.ucode", kind, shader->ucode_data_hash());
+    if (FILE* f = std::fopen(bin.c_str(), "wb")) {
+      std::fwrite(shader->ucode_dwords(), 4, shader->ucode_dword_count(), f);
+      std::fclose(f);
+    }
+  };
+  for (size_t i = 0; i < v.size() && i < 30; ++i) {
+    out += fmt::format(" [VS {:016X} PS {:016X}: {:.0f}]", v[i]->vs, v[i]->ps, v[i]->draws / frames);
+    dump(v[i]->vs_shader, "vs");
+    dump(v[i]->ps_shader, "ps");
+  }
+  REXLOG_INFO("SHADERS per frame: {} pairs, {:.0f} draws; top:{}", v.size(), total / frames, out);
+  shader_census_.clear();
+  // Per pass, most draws first.
+  std::vector<std::pair<uint64_t, uint64_t>> pass_totals;
+  for (auto& [pass_key, pairs] : pass_shader_census_) {
+    uint64_t n = 0;
+    for (auto& [k, pe] : pairs) n += pe[2];
+    pass_totals.emplace_back(pass_key, n);
+  }
+  std::sort(pass_totals.begin(), pass_totals.end(),
+            [](auto& a, auto& b) { return a.second > b.second; });
+  for (size_t i = 0; i < pass_totals.size() && i < 6; ++i) {
+    const uint64_t pk = pass_totals[i].first;
+    auto& pairs = pass_shader_census_[pk];
+    std::vector<const std::array<uint64_t, 3>*> pv;
+    for (auto& [k, pe] : pairs) pv.push_back(&pe);
+    std::sort(pv.begin(), pv.end(), [](auto* a, auto* b) { return (*a)[2] > (*b)[2]; });
+    std::string pout;
+    for (size_t j = 0; j < pv.size() && j < 8; ++j) {
+      pout += fmt::format(" [VS {:016X} PS {:016X}: {:.0f}]", (*pv[j])[0], (*pv[j])[1],
+                          (*pv[j])[2] / frames);
+    }
+    REXLOG_INFO(
+        "SHADERS by pass: pitch {} msaa {} depth base {} colour0 base {} colour mask {:X} {}: "
+        "{:.0f} draws, {} pairs;{}",
+        pk & 0x3FFF, (pk >> 14) & 3, (pk >> 16) & 0x7FF, (pk >> 27) & 0x7FF, (pk >> 38) & 0xF,
+        ((pk >> 42) & 1) ? "colour+depth" : "depth only", pass_totals[i].second / frames,
+        pairs.size(), pout);
+  }
+  pass_shader_census_.clear();
+}
+
+void D3D12CommandProcessor::CensusPassEnd(uint64_t key) {
+  auto& entry = census_[key];
+  entry[0] += census_pass_draws_;
+  entry[1] += 1;
+  census_pass_draws_ = 0;
+}
