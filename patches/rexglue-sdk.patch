+static constexpr uint32_t kM3ProveChecks = 64;  // exact shadows (0 differences) before a key becomes OWNABLE
+static constexpr size_t kM3MaxRecords = 131072;
+static constexpr size_t kM3MaxWordBytes = size_t(128) << 20;
+static constexpr uint64_t kM3RetireSwaps = 8, kM3ExpireSwaps = 16;
