+bool D3D12CommandProcessor::NativeInitialize() {
+  // Compile the host shaders with FXC (d3dcompiler_47.dll ships with Windows).
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile"))
+               : nullptr;
+  if (!compile) {
+    REXGPU_ERROR("Native renderer: d3dcompiler_47.dll / D3DCompile not available");
+    return false;
+  }
+  // D3DCOMPILE_IEEE_STRICTNESS (1 << 13): no refactoring, like the translated
+  // shaders (position invariance). D3DCOMPILE_OPTIMIZATION_LEVEL3 (1 << 15).
+  constexpr UINT kCompileFlags = (1u << 13) | (1u << 15);
+  auto compile_vs = [&](const char* source, size_t size, const char* name,
+                        std::vector<uint8_t>& out) {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(source, size, name, nullptr, nullptr, "main", "vs_5_1", kCompileFlags, 0,
+                         &code, &errors);
+    if (errors) {
+      REXGPU_ERROR("Native renderer: {} compiler output: {}", name,
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()),
+                               errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) {
+      REXGPU_ERROR("Native renderer: failed to compile {} (0x{:08X})", name, uint32_t(hr));
+      return false;
+    }
+    out.assign(static_cast<const uint8_t*>(code->GetBufferPointer()),
+               static_cast<const uint8_t*>(code->GetBufferPointer()) + code->GetBufferSize());
+    code->Release();
+    // FXC keeps dcl_globalFlags refactoringAllowed even with IEEE strictness
+    // (per-instruction precise only). The translated shaders declare no
+    // refactoring at all; clear the flag so the driver compiles both the same
+    // way (position invariance between native and emulated draws), then fix
+    // the container checksum.
+    bool flag_cleared = false;
+    if (out.size() >= 32 && !std::memcmp(out.data(), "DXBC", 4)) {
+      uint32_t chunk_count;
+      std::memcpy(&chunk_count, out.data() + 28, 4);
+      for (uint32_t i = 0; i < chunk_count && 32 + i * 4 + 4 <= out.size(); ++i) {
+        uint32_t chunk_offset;
+        std::memcpy(&chunk_offset, out.data() + 32 + i * 4, 4);
+        if (chunk_offset + 16 > out.size()) break;
+        if (std::memcmp(out.data() + chunk_offset, "SHEX", 4) &&
+            std::memcmp(out.data() + chunk_offset, "SHDR", 4)) {
+          continue;
+        }
+        // Chunk: fourcc, size, version token, length token, instructions.
+        uint32_t chunk_size;
+        std::memcpy(&chunk_size, out.data() + chunk_offset + 4, 4);
+        size_t pos = chunk_offset + 16;
+        size_t end = std::min(out.size(), size_t(chunk_offset) + 8 + chunk_size);
+        while (pos + 4 <= end) {
+          uint32_t token;
+          std::memcpy(&token, out.data() + pos, 4);
+          uint32_t opcode = token & 0x7FF;
+          uint32_t length = (token >> 24) & 0x7F;
+          if (opcode == 106) {  // dcl_globalFlags
+            token &= ~(uint32_t(1) << 11);  // REFACTORING_ALLOWED
+            std::memcpy(out.data() + pos, &token, 4);
+            flag_cleared = true;
+            break;
+          }
+          if (!length) break;
+          pos += size_t(length) * 4;
+        }
+      }
+      if (flag_cleared) {
+        CalculateDXBCChecksum(out.data(), uint32_t(out.size()),
+                              reinterpret_cast<unsigned int*>(out.data() + 4));
+      }
+    }
+    REXLOG_INFO("Native renderer: {} compiled ({} bytes), refactoring flag {}", name, out.size(),
+                flag_cleared ? "cleared" : "NOT FOUND");
+    return true;
+  };
+  if (!compile_vs(kNativeCityDepthVS, sizeof(kNativeCityDepthVS) - 1, "native_city_depth_vs",
+                  native_vs_city_depth_)) {
+    return false;
+  }
+
+  // Root signature: b0 root CBV, t0 root SRV (shared memory).
+  D3D12_ROOT_PARAMETER parameters[2] = {};
+  parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+  parameters[0].Descriptor.ShaderRegister = 0;
+  parameters[0].Descriptor.RegisterSpace = 0;
+  parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+  parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  parameters[1].Descriptor.ShaderRegister = 0;
+  parameters[1].Descriptor.RegisterSpace = 0;
+  parameters[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 2;
+  desc.pParameters = parameters;
+  desc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;
+  native_root_signature_ = ui::d3d12::util::CreateRootSignature(GetD3D12Provider(), desc);
+  if (!native_root_signature_) {
+    REXGPU_ERROR("Native renderer: failed to create the root signature");
+    return false;
+  }
+  {
+    std::error_code ec;
+    std::filesystem::create_directories("shader_dump", ec);
+    if (FILE* f = std::fopen("shader_dump/native_city_depth_vs.dxbc", "wb")) {
+      std::fwrite(native_vs_city_depth_.data(), 1, native_vs_city_depth_.size(), f);
+      std::fclose(f);
+    }
+  }
+  REXLOG_INFO("Native renderer: initialized (city depth VS {} bytes)",
+              native_vs_city_depth_.size());
+  return true;
+}
