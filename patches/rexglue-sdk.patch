+uint64_t Fnv64(const void* data, size_t n, uint64_t h = 1469598103934665603ull) {
+  const uint8_t* p = static_cast<const uint8_t*>(data);
+  for (size_t i = 0; i < n; ++i) { h ^= p[i]; h *= 1099511628211ull; }
+  return h;
+}
+std::string FriendCodeOf(const std::string& puid) {
+  const std::string key = "saintsreborn-friend|" + puid;
+  uint64_t h = Fnv64(key.data(), key.size());
+  static const char* k = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
+  std::string c;
+  for (int i = 0; i < 8; ++i) {
+    if (i == 4) c += '-';
+    c += k[h & 31];
+    h >>= 5;
+  }
+  return c;
+}
+std::string NormalizeCode(const std::string& in) {
+  std::string c;
+  for (char ch : in) {
+    if (ch >= 'a' && ch <= 'z') ch = char(ch - 'a' + 'A');
+    if ((ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9')) c += ch;
+  }
+  if (c.size() == 8) c.insert(4, "-");
+  return c;
+}
+std::string FriendsPath() { return ExeDir() + "friends.txt"; }
+// Needs invite_mutex.
+void LoadFriendsLocked() {
+  if (friends_loaded) return;
+  friends_loaded = true;
+  std::ifstream in(FriendsPath());
+  std::string line;
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::vector<std::string> f;
+    size_t a = 0;
+    while (true) {
+      const size_t b = line.find('\t', a);
+      f.push_back(line.substr(a, b == std::string::npos ? std::string::npos : b - a));
+      if (b == std::string::npos) break;
+      a = b + 1;
+    }
+    if (f.size() < 3 || f[0].empty()) continue;
+    Friend fr;
+    fr.puid = f[0];
+    fr.name = f[1];
+    fr.added = f[2].find('a') != std::string::npos;
+    fr.mutual = f[2].find('m') != std::string::npos;
+    fr.recent = f[2].find('r') != std::string::npos;
+    if (f.size() > 3) fr.added_at = std::atoll(f[3].c_str());
+    if (f.size() > 4) fr.seen_at = std::atoll(f[4].c_str());
+    friends.push_back(fr);
+  }
+  REXSYS_INFO("EOS LAN: {} friend / recent player entries loaded", friends.size());
+}
+// Needs invite_mutex.
+void SaveFriendsLocked() {
+  std::ofstream out(FriendsPath(), std::ios::trunc);
+  out << "# Saints Reborn friends: puid, name, flags (a added, m friends, r played together), added, last seen\n";
+  for (const auto& f : friends) {
+    std::string flags = std::string(f.added ? "a" : "") + (f.mutual ? "m" : "") + (f.recent ? "r" : "");
+    out << f.puid << '\t' << f.name << '\t' << flags << '\t' << f.added_at << '\t' << f.seen_at << '\n';
+  }
+}
+Friend* FindFriendLocked(const std::string& puid) {
+  for (auto& f : friends)
+    if (f.puid == puid) return &f;
+  return nullptr;
+}
+Friend& FriendEntryLocked(const std::string& puid, const std::string& name) {
+  if (Friend* f = FindFriendLocked(puid)) {
+    if (!name.empty()) f->name = name;
+    return *f;
+  }
+  friends.push_back(Friend{puid, name});
+  return friends.back();
+}
+
+// The map packs in dist\maps: content hash per pack, the map ids it adds.
+void ComputeMapsLocked() {
+  if (maps_ready) return;
+  maps_ready = true;
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  const fs::path root = fs::path(ExeDir()) / "maps";
+  std::vector<fs::path> packs;
+  for (const auto& e : fs::directory_iterator(root, ec))
+    if (e.is_directory(ec)) packs.push_back(e.path());
+  std::sort(packs.begin(), packs.end());
+  for (const auto& pack : packs) {
+    std::vector<std::pair<std::string, fs::path>> files;
+    for (const auto& e : fs::recursive_directory_iterator(pack, ec)) {
+      if (!e.is_regular_file(ec)) continue;
+      std::string rel = fs::relative(e.path(), pack, ec).generic_string();
+      for (char& c : rel) if (c >= 'A' && c <= 'Z') c = char(c - 'A' + 'a');
+      files.push_back({rel, e.path()});
+    }
+    std::sort(files.begin(), files.end());
+    uint64_t h = 1469598103934665603ull;
+    std::vector<uint16_t> ids;
+    std::vector<char> buf(1 << 16);
+    for (const auto& [rel, path] : files) {
+      h = Fnv64(rel.data(), rel.size() + 1, h);
+      std::ifstream in(path, std::ios::binary);
+      std::string whole;
+      while (in) {
+        in.read(buf.data(), std::streamsize(buf.size()));
+        const size_t got = size_t(in.gcount());
+        h = Fnv64(buf.data(), got, h);
+        if (rel.size() > 5 && rel.compare(rel.size() - 5, 5, ".xtbl") == 0) whole.append(buf.data(), got);
+      }
+      for (size_t at = whole.find("<ID>"); at != std::string::npos; at = whole.find("<ID>", at + 4)) {
+        const long id = std::strtol(whole.c_str() + at + 4, nullptr, 10);
+        if (id > 0 && id < 65535) ids.push_back(uint16_t(id));
+      }
+    }
+    if (ids.empty()) continue;
+    const uint32_t hash = uint32_t(h ^ (h >> 32));
+    char hex[16];
+    std::snprintf(hex, sizeof(hex), "%08x", hash);
+    std::string entry = std::string(hex) + ":";
+    for (size_t i = 0; i < ids.size(); ++i) {
+      my_maps[ids[i]] = hash;
+      my_map_pack[ids[i]] = pack.filename().string();
+      entry += (i ? "." : "") + std::to_string(ids[i]);
+    }
+    if (my_maps_text.size() + entry.size() + 1 > kAdvertParts * kAdvertPart) {
+      REXSYS_WARN("EOS LAN: too many map packs to publish, '{}' and later ones left out", pack.filename().string());
+      break;
+    }
+    my_maps_text += entry + ";";
+  }
+  REXSYS_INFO("EOS LAN: {} multiplayer map id(s) from {} map pack(s) published for the map check", my_maps.size(),
+              packs.size());
+}
+std::map<uint16_t, uint32_t> ParseMaps(const std::string& text) {
+  std::map<uint16_t, uint32_t> out;
+  size_t a = 0;
+  while (a < text.size()) {
+    size_t b = text.find(';', a);
+    if (b == std::string::npos) b = text.size();
+    const std::string e = text.substr(a, b - a);
+    const size_t colon = e.find(':');
+    if (colon == 8) {
+      const uint32_t hash = uint32_t(std::strtoul(e.substr(0, 8).c_str(), nullptr, 16));
+      size_t i = colon + 1;
+      while (i < e.size()) {
+        size_t j = e.find('.', i);
+        if (j == std::string::npos) j = e.size();
+        const long id = std::strtol(e.substr(i, j - i).c_str(), nullptr, 10);
+        if (id > 0 && id < 65535) out[uint16_t(id)] = hash;
+        i = j + 1;
+      }
+    }
+    a = b + 1;
+  }
+  return out;
+}
+
+void RefreshMembers() {
+  if (!in_lobby) return;
+  EOS_Lobby_CopyLobbyDetailsHandleOptions c{};
+  c.ApiVersion = EOS_LOBBY_COPYLOBBYDETAILSHANDLE_API_LATEST;
+  c.LobbyId = kLobbyId;
+  c.LocalUserId = me;
+  EOS_HLobbyDetails details = nullptr;
+  if (p_EOS_Lobby_CopyLobbyDetailsHandle(lobby_if, &c, &details) != EOS_EResult::EOS_Success || !details) return;
+  EOS_LobbyDetails_GetMemberCountOptions mc{};
+  mc.ApiVersion = EOS_LOBBYDETAILS_GETMEMBERCOUNT_API_LATEST;
+  const uint32_t count = p_EOS_LobbyDetails_GetMemberCount(details, &mc);
+  std::vector<EOS_ProductUserId> now;
+  for (uint32_t i = 0; i < count; ++i) {
+    EOS_LobbyDetails_GetMemberByIndexOptions mi{};
+    mi.ApiVersion = EOS_LOBBYDETAILS_GETMEMBERBYINDEX_API_LATEST;
+    mi.MemberIndex = i;
+    EOS_ProductUserId m = p_EOS_LobbyDetails_GetMemberByIndex(details, &mi);
+    if (m && m != me) now.push_back(m);
+  }
+  auto attr = [&](EOS_ProductUserId m, const char* key, bool& found) {
+    std::string text;
+    found = false;
+    EOS_LobbyDetails_CopyMemberAttributeByKeyOptions o{};
+    o.ApiVersion = EOS_LOBBYDETAILS_COPYMEMBERATTRIBUTEBYKEY_API_LATEST;
+    o.TargetUserId = m;
+    o.AttrKey = key;
+    EOS_Lobby_Attribute* a = nullptr;
+    if (p_EOS_LobbyDetails_CopyMemberAttributeByKey(details, &o, &a) != EOS_EResult::EOS_Success || !a) return text;
+    if (a->Data && a->Data->ValueType == EOS_ELobbyAttributeType::EOS_AT_STRING && a->Data->Value.AsUtf8) {
+      text = a->Data->Value.AsUtf8;
+      found = true;
+    }
+    p_EOS_Lobby_Attribute_Release(a);
+    return text;
+  };
+  std::vector<LiveAdvertEntry> adverts;
+  std::vector<OnlinePlayer> snapshot;
+  const int64_t now_s = int64_t(std::time(nullptr));
+  for (EOS_ProductUserId m : now) {
+    PeerInfo& pi = peers[m];
+    if (pi.puid.empty()) pi.puid = PuidString(m);
+    bool found = false;
+    const std::string name = attr(m, "SRNAME", found);
+    const std::string proof = attr(m, "SROWN", found);
+    bool where_found = false;
+    pi.where = attr(m, "SRWHERE", where_found);
+    const std::string mod = attr(m, "SRMOD", found);
+    const bool owner = !proof.empty() && rex::system::online::VerifyOwnerProof(pi.puid, proof);
+    const bool reserved = rex::system::online::IsReservedName(name);
+    if (owner != pi.owner || name != pi.name) {
+      if (owner) REXSYS_INFO("EOS LAN: {} ('{}') is the verified owner of the reserved name", pi.puid, name);
+      else if (reserved) REXSYS_WARN("EOS LAN: {} uses the reserved name '{}' without owner proof: ignored", pi.puid, name);
+    }
+    pi.owner = owner;
+    pi.name = name;
+    if (reserved && !owner) pi.imposter = true;
+    if (owner) pi.imposter = false;
+    // Only a game that says it is modded counts as modded. A missing SRMOD (an older version of the game, or its
+    // attributes not read yet) used to count as modded too: after the fair play update, updated players then
+    // dropped everyone still on the old version and loaded into public matches alone (2026-10-02).
+    const bool modded = found && !mod.empty() && mod.rfind("clean", 0) != 0;
+    if (modded != pi.modded || mod != pi.mod_text)
+      REXSYS_INFO("EOS LAN: {} ('{}') is {}", pi.puid, name, modded ? mod : (mod.empty() ? std::string("an older game (allowed)") : std::string("unmodded")));
+    pi.modded = modded;
+    pi.mod_text = mod;
+    std::string text;
+    for (int part = 0; part < kAdvertParts; ++part) {
+      char key[16];
+      std::snprintf(key, sizeof(key), "SRLIVE%d", part);
+      bool got = false;
+      const std::string piece = attr(m, key, got);
+      if (!got) break;
+      text += piece;
+    }
+    if (!text.empty() && !pi.imposter) adverts.push_back(LiveAdvertEntry{text, modded, name});
+    {
+      // Its virtual IP (SRIP, hex): known before any packet from it.
+      bool ip_found = false;
+      const std::string ip_text = attr(m, "SRIP", ip_found);
+      if (ip_found && ip_text.size() == 8) {
+        const uint32_t ip = uint32_t(std::strtoul(ip_text.c_str(), nullptr, 16));
+        if (IsVirtual(ip) && ip != 0xFFFFFFFFu) by_ip[ip] = m;
+      }
+    }
+    bool freq_found = false;
+    pi.freq = attr(m, "SRFREQ", freq_found);
+    {
+      std::string maps_text;
+      for (int part = 0; part < kAdvertParts; ++part) {
+        char key[16];
+        std::snprintf(key, sizeof(key), "SRMAPS%d", part);
+        bool got = false;
+        const std::string piece = attr(m, key, got);
+        if (!got) break;
+        maps_text += piece;
+      }
+      pi.maps = ParseMaps(maps_text);
+    }
+    {
+      bool qos_found = false;
+      const std::string qos = attr(m, "SRQOS", qos_found);
+      // "<kid>:<data>" entries separated by ';' (a host can have its party
+      // lobby and a match session at the same time).
+      size_t start = 0;
+      while (start < qos.size()) {
+        size_t end = qos.find(';', start);
+        if (end == std::string::npos) end = qos.size();
+        const std::string entry = qos.substr(start, end - start);
+        if (entry.size() > 17 && entry[16] == ':') {
+          std::lock_guard<std::mutex> il(invite_mutex);
+          qos_by_kid[entry.substr(0, 16)] = UnhexBytes(entry.substr(17));
+        }
+        start = end + 1;
+      }
+    }
+    bool inv_found = false;
+    const std::string inv = attr(m, "SRINV", inv_found);
+    const std::string inv_session = attr(m, "SRINVS", inv_found);
+    if (!pi.imposter && !name.empty()) {
+      OnlinePlayer op;
+      op.puid = pi.puid;
+      op.xuid = XuidFromPuid(pi.puid);
+      op.name = name;
+      op.where = pi.where;
+      op.modded = modded;
+      // Advert byte 0 = version, then XSESSION_INFO (session id first).
+      const std::vector<uint8_t> adv = UnhexBytes(text.substr(0, 2 + 16));
+      op.in_session = !text.empty() || !inv_session.empty();
+      if (adv.size() >= 9) std::memcpy(op.session_id, adv.data() + 1, 8);
+      snapshot.push_back(op);
+    }
+    // An invite for this game?
+    std::lock_guard<std::mutex> il(invite_mutex);
+    std::string& seen = invite_seen[pi.puid];
+    if (inv != seen) {
+      seen = inv;
+      const size_t bar = inv.find('|');
+      const int64_t sent_at = bar == std::string::npos ? 0 : std::atoll(inv.substr(0, bar).c_str());
+      const bool for_me = bar != std::string::npos && !my_puid.empty() && inv.find(my_puid, bar) != std::string::npos;
+      if (for_me && !pi.imposter && inv_session.size() == 120 && std::llabs(now_s - sent_at) <= kInviteSeconds) {
+        pending_invite = Invite{pi.puid, name.empty() ? std::string("Player") : name, inv_session,
+                                XuidFromPuid(pi.puid), now_s};
+        has_pending = true;
+        REXSYS_INFO("EOS LAN: invite from {} ('{}')", pi.puid, pending_invite.name);
+        rex::cvar::SetFlagByName("online_invite_from", pending_invite.name);
+        rex::system::online::Notice(pending_invite.name + " invited you to their lobby. Press F10 to join.");
+      }
+    }
+  }
+  {
+    std::lock_guard<std::mutex> il(invite_mutex);
+    players_snapshot = std::move(snapshot);
+    // Map check data by virtual IP (by_ip: learned from packets).
+    maps_by_ip.clear();
+    name_by_ip.clear();
+    for (const auto& [ip, id] : by_ip) {
+      auto it = peers.find(id);
+      if (it == peers.end()) continue;
+      maps_by_ip[ip] = it->second.maps;
+      name_by_ip[ip] = it->second.name;
+    }
+    // Friends.
+    LoadFriendsLocked();
+    bool dirty = false;
+    // Add Friend (a code typed in MULTIPLAYER > OPTIONS).
+    if (!pending_add.empty()) {
+      const std::string code = NormalizeCode(pending_add);
+      pending_add.clear();
+      if (code.size() != 9) {
+        rex::system::online::Notice("A friend code has 8 letters and digits, like ABCD-EF23.");
+      } else if (code == FriendCodeOf(my_puid)) {
+        rex::system::online::Notice("That is your own friend code.");
+      } else {
+        const PeerInfo* found = nullptr;
+        for (const auto& [id, pi] : peers)
+          if (!pi.imposter && FriendCodeOf(pi.puid) == code) found = &pi;
+        if (found) {
+          Friend& f = FriendEntryLocked(found->puid, found->name);
+          if (!f.added) { f.added = true; f.added_at = now_s; }
+          rex::system::online::Notice(f.mutual ? found->name + " is already your friend."
+                                               : "Friend request sent to " + found->name + ".");
+        } else if (!FindFriendLocked("code:" + code)) {
+          Friend f;
+          f.puid = "code:" + code;
+          f.added = true;
+          f.added_at = now_s;
+          friends.push_back(f);
+          rex::system::online::Notice("Nobody with that code is online right now. The friend request goes out when they are.");
+        }
+        dirty = true;
+      }
+    }
+    for (const auto& [id, pi] : peers) {
+      if (pi.imposter || pi.name.empty()) continue;
+      // A friend code added earlier: this is the player.
+      if (Friend* byc = FindFriendLocked("code:" + FriendCodeOf(pi.puid))) {
+        const int64_t at = byc->added_at;
+        friends.erase(friends.begin() + (byc - friends.data()));
+        Friend& f = FriendEntryLocked(pi.puid, pi.name);
+        f.added = true;
+        f.added_at = at;
+        dirty = true;
+      }
+      if (Friend* f = FindFriendLocked(pi.puid)) {
+        if (f->name != pi.name) { f->name = pi.name; dirty = true; }
+        f->seen_at = now_s;
+      }
+      // Played together (game packets while in a session).
+      if (recent_seen.count(id)) {
+        Friend& f = FriendEntryLocked(pi.puid, pi.name);
+        if (!f.recent) { f.recent = true; dirty = true; }
+        f.seen_at = now_s;
+      }
+      // A friend request for this game?
+      std::string& seen = freq_seen[pi.puid];
+      if (pi.freq != seen) {
+        seen = pi.freq;
+        const size_t bar = pi.freq.find('|');
+        const int64_t sent_at = bar == std::string::npos ? 0 : std::atoll(pi.freq.substr(0, bar).c_str());
+        const bool for_me = bar != std::string::npos && !my_puid.empty() &&
+                            pi.freq.find(my_puid, bar) != std::string::npos;
+        if (for_me && std::llabs(now_s - sent_at) <= 600) {
+          Friend* f = FindFriendLocked(pi.puid);
+          if (f && f->added) {
+            if (!f->mutual) {
+              f->mutual = true;
+              dirty = true;
+              REXSYS_INFO("EOS LAN: {} ('{}') and this player are friends now", pi.puid, pi.name);
+              rex::system::online::Notice(pi.name + " is now your friend.");
+            }
+          } else if (!(f && f->mutual)) {
+            pending_friend = Invite{pi.puid, pi.name, "", XuidFromPuid(pi.puid), now_s};
+            has_pending_friend = true;
+            rex::cvar::SetFlagByName("online_invite_from", pi.name);
+            REXSYS_INFO("EOS LAN: friend request from {} ('{}')", pi.puid, pi.name);
+            rex::system::online::Notice(pi.name + " wants to be your friend. Press F10 to accept.");
+          }
+        }
+      }
+    }
+    recent_seen.clear();
+    // Our own friend requests: added, not friends yet (or just now), online.
+    std::string list;
+    for (const auto& f : friends) {
+      if (!f.added || f.puid.rfind("code:", 0) == 0) continue;
+      if (f.mutual && now_s - f.added_at > 600) continue;
+      bool online = false;
+      for (const auto& [id, pi] : peers) online |= pi.puid == f.puid;
+      if (!online || list.size() + f.puid.size() + 1 > 220) continue;
+      list += (list.empty() ? "" : ",") + f.puid;
+    }
+    if (list != my_freq_list) {
+      my_freq_list = list;
+      my_freq = list.empty() ? std::string() : std::to_string(now_s) + "|" + list;
+    }
+    if (dirty) SaveFriendsLocked();
+  }
+  {
+    std::lock_guard<std::mutex> l(advert_mutex);
+    others_adverts = std::move(adverts);
+  }
+  ++refresh_count;
+  p_EOS_LobbyDetails_Release(details);
+  for (auto it = peers.begin(); it != peers.end();) {
+    bool still = false;
+    for (EOS_ProductUserId m : now) still |= m == it->first;
+    it = still ? std::next(it) : peers.erase(it);
+  }
+  owner_online = !my_proof.empty();
+  for (auto& [id, pi] : peers) owner_online |= pi.owner;
+  if (now.size() != members.size()) REXSYS_INFO("EOS LAN: {} other player(s) on the virtual LAN", now.size());
+  for (EOS_ProductUserId m : now) {
+    bool known = false;
+    for (EOS_ProductUserId o : members) known |= o == m;
+    if (!known) AcceptFrom(m);
+  }
+  members = now;
+  PublishPlayers();
+}
+
+void SendTo(EOS_ProductUserId to, const void* data, uint32_t len) {
+  EOS_P2P_SendPacketOptions s{};
+  s.ApiVersion = EOS_P2P_SENDPACKET_API_LATEST;
+  s.LocalUserId = me;
+  s.RemoteUserId = to;
+  s.SocketId = &socket_id;
+  s.Channel = 0;
+  s.DataLengthBytes = len;
+  s.Data = data;
+  s.bAllowDelayedDelivery = EOS_TRUE;
+  s.Reliability = EOS_EPacketReliability::EOS_PR_UnreliableUnordered;
+  s.bDisableAutoAcceptConnection = EOS_FALSE;
+  p_EOS_P2P_SendPacket(p2p_if, &s);
+}
+
+void Flush() {
+  std::deque<Out> q;
+  {
+    std::lock_guard<std::mutex> l(out_mutex);
+    q.swap(out_queue);
+  }
+  for (Out& o : q) {
+    std::vector<EOS_ProductUserId> targets;
+    if (o.dst_ip == 0xFFFFFFFFu || o.dst_ip == 0x0A4DFFFFu) {
+      targets = members;
+    } else {
+      auto it = by_ip.find(o.dst_ip);
+      if (it != by_ip.end()) targets.push_back(it->second);
+      // Not learned yet (Live search / invite joins send to the host without a
+      // broadcast first): everyone gets it, only the owner of the IP keeps it.
+      else targets = members;
+    }
+    if (targets.empty()) continue;
+    const uint32_t id = next_msg++;
+    const uint32_t count = std::max<uint32_t>(1, uint32_t((o.data.size() + kFragData - 1) / kFragData));
+    if (count > 255) continue;
+    for (uint32_t f = 0; f < count; ++f) {
+      const size_t off = size_t(f) * kFragData;
+      const size_t n = std::min<size_t>(kFragData, o.data.size() - std::min(off, o.data.size()));
+      uint8_t pkt[kMaxPacket];
+      Header h{};
+      std::memcpy(h.magic, "SRL1", 4);
+      h.src_ip = my_ip;
+      h.dst_ip = o.dst_ip;
+      h.src_port = o.src_port;
+      h.dst_port = o.dst_port;
+      h.msg_id = id;
+      h.frag = uint8_t(f);
+      h.count = uint8_t(count);
+      std::memcpy(pkt, &h, sizeof(h));
+      if (n) std::memcpy(pkt + sizeof(h), o.data.data() + off, n);
+      for (EOS_ProductUserId t : targets) SendTo(t, pkt, uint32_t(sizeof(h) + n));
+    }
+    sent_packets += 1;
+  }
+}
+
+void Inject(uint32_t src_ip, uint16_t src_port, uint16_t dst_port, const uint8_t* data, size_t len) {
+  if (helper == INVALID_SOCKET) return;
+  std::vector<uint8_t> buf(12 + len);
+  std::memcpy(buf.data(), "SRLI", 4);
+  std::memcpy(buf.data() + 4, &src_ip, 4);
+  std::memcpy(buf.data() + 8, &src_port, 2);
+  if (len) std::memcpy(buf.data() + 12, data, len);
+  sockaddr_in to{};
+  to.sin_family = AF_INET;
+  to.sin_port = htons(dst_port);
+  to.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  const int r =
+      sendto(helper, reinterpret_cast<const char*>(buf.data()), int(buf.size()), 0, (sockaddr*)&to, sizeof(to));
+  static std::atomic<int> logged{0};
+  if (logged < (r < 0 ? 40 : 12)) {
+    logged += 1;
+    REXSYS_INFO("EOS LAN: packet from {}.{}.{}.{}:{} to game port {}, {} bytes -> {}", src_ip >> 24,
+                (src_ip >> 16) & 255, (src_ip >> 8) & 255, src_ip & 255, src_port, dst_port, len,
+                r < 0 ? WSAGetLastError() : r);
+  }
+}
+
+void QueueOut(uint32_t dst_ip, uint16_t port, const std::vector<uint8_t>& data) {
+  std::lock_guard<std::mutex> l(out_mutex);
+  out_queue.push_back(Out{dst_ip, port, port, data});
+}
+// Worker thread.
+void HandleChat(EOS_ProductUserId from, uint32_t from_ip, const uint8_t* p, size_t n) {
+  if (n < 13 || std::memcmp(p, "SRC1", 4) != 0) return;
+  const uint32_t origin = uint32_t(p[4]) << 24 | uint32_t(p[5]) << 16 | uint32_t(p[6]) << 8 | p[7];
+  const uint32_t id = uint32_t(p[8]) << 24 | uint32_t(p[9]) << 16 | uint32_t(p[10]) << 8 | p[11];
+  if (origin == my_ip) return;
+  std::string payload_name, text;
+  size_t i = 12;
+  while (i < n && p[i]) payload_name += char(p[i++]);
+  ++i;
+  while (i < n && p[i] && text.size() < 200) text += char(p[i++]);
+  for (char& c : text) if (uint8_t(c) < 32) c = ' ';
+  if (text.empty()) return;
+  {
+    std::lock_guard<std::mutex> cl(chat_mutex);
+    if (!chat_seen.insert({origin, id}).second) return;
+  }
+  // Name: the origin's published one (relayed messages: look the origin up).
+  std::string name;
+  auto bit = by_ip.find(origin);
+  EOS_ProductUserId who = bit != by_ip.end() ? bit->second : (origin == from_ip ? from : nullptr);
+  if (who) {
+    auto pit = peers.find(who);
+    if (pit != peers.end()) {
+      if (pit->second.imposter) return;
+      name = pit->second.name;
+    }
+  }
+  if (name.empty()) name = rex::system::online::SafeName(payload_name.substr(0, 15));
+  if (name.empty()) name = "Player";
+  std::vector<std::pair<uint32_t, std::chrono::steady_clock::time_point>> relay;
+  {
+    std::lock_guard<std::mutex> cl(chat_mutex);
+    chat_in.push_back(name + "\t" + text);
+    while (chat_in.size() > 50) chat_in.pop_front();
+    for (auto& kv : session_peer_seen) relay.push_back(kv);
+  }
+  // Pass it on once to the others in the session.
+  const auto now = std::chrono::steady_clock::now();
+  const std::vector<uint8_t> data(p, p + n);
+  for (auto& [ip, seen] : relay)
+    if (ip != from_ip && ip != origin && now - seen < std::chrono::seconds(60)) QueueOut(ip, kChatPort, data);
+}
+
+void Receive() {
+  bool me_modded = false, me_checked = false;
+  for (int i = 0; i < 256; ++i) {
+    EOS_P2P_ReceivePacketOptions r{};
+    r.ApiVersion = EOS_P2P_RECEIVEPACKET_API_LATEST;
+    r.LocalUserId = me;
+    r.MaxDataSizeBytes = kMaxPacket;
+    r.RequestedChannel = nullptr;
+    EOS_ProductUserId peer = nullptr;
+    EOS_P2P_SocketId sid{};
+    uint8_t channel = 0;
+    uint32_t written = 0;
+    uint8_t pkt[kMaxPacket];
+    if (p_EOS_P2P_ReceivePacket(p2p_if, &r, &peer, &sid, &channel, pkt, &written) != EOS_EResult::EOS_Success) return;
+    if (!peer || written < sizeof(Header)) continue;
+    Header h;
+    std::memcpy(&h, pkt, sizeof(h));
+    if (std::memcmp(h.magic, "SRL1", 4) != 0) continue;
+    {
+      auto pit = peers.find(peer);
+      PeerInfo* pi = pit == peers.end() ? nullptr : &pit->second;
+      const char* why = nullptr;
+      if (pi && pi->imposter) {
+        why = "reserved name without owner proof";
+      } else if (!pi || !pi->owner) {
+        // A reserved name inside the game's own packets (e.g. a changed game
+        // sending another name than it publishes). Skipped while the real
+        // owner is online: hosts then legitimately relay the owner's name.
+        if (!owner_online && rex::system::online::PacketHasReservedName(pkt + sizeof(Header), written - sizeof(Header))) {
+          why = "reserved name in its packets without owner proof";
+          if (pi) pi->imposter = true;
+        }
+      }
+      // Mods, trainers and cheat tools only in a Private Party: public Live
+      // matches and System Link are unmodded games only (chat always passes).
+      if (!why && !private_session && h.dst_port != kChatPort) {
+        if (!me_checked) { me_modded = rex::system::online::Modded(); me_checked = true; }
+        if (me_modded) {
+          why = "this game is modded (mods only work in a Private Party)";
+          static auto told = std::chrono::steady_clock::time_point{};
+          const auto now = std::chrono::steady_clock::now();
+          if (told == std::chrono::steady_clock::time_point{} || now - told > std::chrono::seconds(60)) {
+            told = now;
+            rex::system::online::Notice("Public matches and System Link need an unmodded game. Turn off: " +
+                                        rex::system::online::ModdedReason() +
+                                        ". Mods work in a Private Party with invited friends.");
+          }
+        } else if (pi && pi->modded) {
+          why = "modded game (mods only work in a Private Party)";
+        }
+      }
+      if (why) {
+        if (pi && !pi->logged_drop) {
+          pi->logged_drop = true;
+          REXSYS_WARN("EOS LAN: ignoring {} ('{}'): {}", pi->puid, pi->name, why);
+        }
+        continue;
+      }
+      if (pi) pi->logged_drop = false;
+    }
+    by_ip[h.src_ip] = peer;  // learn who has this virtual IP
+    if (h.dst_ip != my_ip && h.dst_ip != 0xFFFFFFFFu && h.dst_ip != 0x0A4DFFFFu) continue;
+    if (blocked_host_ip != 0 && h.src_ip == blocked_host_ip) continue;  // host's map isn't here (SrMapCheck)
+    if (h.dst_ip == my_ip) {
+      // Game packets addressed to this game: the other player is in the same
+      // lobby / match (System Link lobbies have no session until a match).
+      if (session_active) recent_seen.insert(peer);   // played together
+      std::lock_guard<std::mutex> cl(chat_mutex);
+      session_peer_seen[h.src_ip] = std::chrono::steady_clock::now();
+    }
+    if (h.dst_port == kChatPort) {
+      if (h.count <= 1) HandleChat(peer, h.src_ip, pkt + sizeof(h), written - sizeof(h));
+      continue;
+    }
+    const uint8_t* data = pkt + sizeof(h);
+    const size_t n = written - sizeof(h);
+    if (h.count <= 1) {
+      Inject(h.src_ip, h.src_port, h.dst_port, data, n);
+      received_packets += 1;
+      continue;
+    }
+    auto key = std::make_pair(reinterpret_cast<uintptr_t>(peer), h.msg_id);
+    Partial& p = partials[key];
+    if (!p.count) { p.count = h.count; p.parts.resize(h.count); p.since = std::chrono::steady_clock::now(); }
+    if (h.frag < p.count && p.parts[h.frag].empty()) {
+      p.parts[h.frag].assign(data, data + n);
+      if (p.parts[h.frag].empty()) p.parts[h.frag].push_back(0);  // (never empty for real fragments)
+      ++p.got;
+    }
+    if (p.got == p.count) {
+      std::vector<uint8_t> whole;
+      for (auto& part : p.parts) whole.insert(whole.end(), part.begin(), part.end());
+      Inject(h.src_ip, h.src_port, h.dst_port, whole.data(), whole.size());
+      received_packets += 1;
+      partials.erase(key);
+    }
+  }
+}
+
+// Publishes this game's member attributes (Live advert parts, name, owner
+// proof, modded state) when they changed.
+void ApplyAttributes() {
+  std::map<std::string, std::string> want;
+  {
+    std::lock_guard<std::mutex> l(advert_mutex);
+    if (advert_busy) return;
+    for (int part = 0; part < kAdvertParts; ++part) {
+      char key[16];
+      std::snprintf(key, sizeof(key), "SRLIVE%d", part);
+      want[key] = my_advert.size() > part * kAdvertPart ? my_advert.substr(part * kAdvertPart, kAdvertPart) : std::string();
+    }
+  }
+  if (my_puid.empty()) {
+    my_puid = PuidString(me);
+    my_proof = rex::system::online::OwnerProof(my_puid);
+    if (!my_proof.empty()) REXSYS_INFO("EOS LAN: owner proof published for {}", my_puid);
+  }
+  std::string name = rex::cvar::GetFlagByName("xam_player_name");
+  if (name.empty()) {
+    const char* env = std::getenv("USERNAME");
+    name = env && *env ? env : "Player";
+  }
+  want["SRNAME"] = rex::system::online::SafeName(name);
+  want["SROWN"] = my_proof;
+  {
+    std::string where = rex::cvar::GetFlagByName("online_session");
+    if (where.empty()) where = rex::cvar::GetFlagByName("online_activity");
+    want["SRWHERE"] = where.substr(0, 60);
+  }
+  want["SRMOD"] = rex::system::online::Modded() ? "modded 1 " + rex::system::online::ModdedReason().substr(0, 200)
+                                                : std::string("clean 1");
+  {
+    std::lock_guard<std::mutex> il(invite_mutex);
+    want["SRINV"] = my_invite;
+    want["SRINVS"] = my_invite.empty() ? std::string() : my_invite_session;
+    want["SRFREQ"] = my_freq;
+    want["SRQOS"] = my_qos;
+    {
+      char ip_text[16];
+      std::snprintf(ip_text, sizeof(ip_text), "%08x", my_ip);
+      want["SRIP"] = ip_text;
+    }
+    ComputeMapsLocked();
+    for (int part = 0; part < kAdvertParts; ++part) {
+      char key[16];
+      std::snprintf(key, sizeof(key), "SRMAPS%d", part);
+      want[key] = my_maps_text.size() > size_t(part) * kAdvertPart ? my_maps_text.substr(part * kAdvertPart, kAdvertPart)
+                                                                   : std::string();
+    }
+    static std::string code_shown;
+    const std::string code = FriendCodeOf(my_puid);
+    if (!my_puid.empty() && code != code_shown) {
+      code_shown = code;
+      rex::cvar::SetFlagByName("online_friend_code", code);
+      REXSYS_INFO("EOS LAN: friend code {}", code);
+    }
+  }
+  bool changed = false;
+  for (auto& [k, v] : want) {
+    auto it = applied_attrs.find(k);
+    if (v.empty() ? (it != applied_attrs.end() && !it->second.empty()) : (it == applied_attrs.end() || it->second != v))
+      changed = true;
+  }
+  if (!changed) return;
+  EOS_Lobby_UpdateLobbyModificationOptions u{};
+  u.ApiVersion = EOS_LOBBY_UPDATELOBBYMODIFICATION_API_LATEST;
+  u.LocalUserId = me;
+  u.LobbyId = kLobbyId;
+  EOS_HLobbyModification mod = nullptr;
+  if (p_EOS_Lobby_UpdateLobbyModification(lobby_if, &u, &mod) != EOS_EResult::EOS_Success || !mod) return;
+  static std::map<std::string, std::string> sent;
+  sent = want;
+  for (auto& [k, v] : sent) {
+    auto it = applied_attrs.find(k);
+    if (v.empty()) {
+      if (it == applied_attrs.end() || it->second.empty()) continue;
+      EOS_LobbyModification_RemoveMemberAttributeOptions r{};
+      r.ApiVersion = EOS_LOBBYMODIFICATION_REMOVEMEMBERATTRIBUTE_API_LATEST;
+      r.Key = k.c_str();
+      p_EOS_LobbyModification_RemoveMemberAttribute(mod, &r);
+    } else {
+      if (it != applied_attrs.end() && it->second == v) continue;
+      EOS_Lobby_AttributeData d{};
+      d.ApiVersion = EOS_LOBBY_ATTRIBUTEDATA_API_LATEST;
+      d.Key = k.c_str();
+      d.Value.AsUtf8 = v.c_str();
+      d.ValueType = EOS_ELobbyAttributeType::EOS_AT_STRING;
+      EOS_LobbyModification_AddMemberAttributeOptions a{};
+      a.ApiVersion = EOS_LOBBYMODIFICATION_ADDMEMBERATTRIBUTE_API_LATEST;
+      a.Attribute = &d;
+      a.Visibility = EOS_ELobbyAttributeVisibility::EOS_LAT_PUBLIC;
+      p_EOS_LobbyModification_AddMemberAttribute(mod, &a);
+    }
+  }
+  {
+    std::lock_guard<std::mutex> l(advert_mutex);
+    advert_busy = true;
+  }
+  EOS_Lobby_UpdateLobbyOptions o{};
+  o.ApiVersion = EOS_LOBBY_UPDATELOBBY_API_LATEST;
+  o.LobbyModificationHandle = mod;
+  p_EOS_Lobby_UpdateLobby(lobby_if, &o, nullptr, [](const EOS_Lobby_UpdateLobbyCallbackInfo* d) {
+    std::lock_guard<std::mutex> l(advert_mutex);
+    advert_busy = false;
+    if (d->ResultCode == EOS_EResult::EOS_Success) {
+      std::string live;
+      for (int part = 0; part < kAdvertParts; ++part) live += sent["SRLIVE" + std::to_string(part)];
+      std::string before;
+      for (int part = 0; part < kAdvertParts; ++part) before += applied_attrs["SRLIVE" + std::to_string(part)];
+      if (live != before)
+        REXSYS_INFO("EOS LAN: Live session advert {} ({} chars)", live.empty() ? "removed" : "published", live.size());
+      if (sent["SRMOD"] != applied_attrs["SRMOD"]) REXSYS_INFO("EOS LAN: published '{}'", sent["SRMOD"]);
+      applied_attrs = sent;
+    } else {
+      REXSYS_WARN("EOS LAN: member attribute update failed: {}", R(d->ResultCode));
+    }
+  });
+  p_EOS_LobbyModification_Release(mod);
+}
+
+// Worker thread: leave the LAN lobby, release the platform and forget
+// everything about this login, so the co-op mod can create its own platform
+// (two platforms ticked from two threads corrupt the heap).
+void ReleaseForCoop() {
+  if (platform && lobby_if && me && in_lobby) {
+    static std::atomic<bool> left;
+    left = false;
+    EOS_Lobby_LeaveLobbyOptions l{};
+    l.ApiVersion = EOS_LOBBY_LEAVELOBBY_API_LATEST;
+    l.LocalUserId = me;
+    l.LobbyId = kLobbyId;
+    p_EOS_Lobby_LeaveLobby(lobby_if, &l, nullptr, [](const EOS_Lobby_LeaveLobbyCallbackInfo*) { left = true; });
+    for (int i = 0; i < 200 && !left; ++i) {
+      p_EOS_Platform_Tick(platform);
+      std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+  }
+  if (platform) p_EOS_Platform_Release(platform);
+  platform = nullptr;
+  connect_if = nullptr;
+  lobby_if = nullptr;
+  p2p_if = nullptr;
+  me = nullptr;
+  in_lobby = false;
+  creating = false;
+  members.clear();
+  by_ip.clear();
+  partials.clear();
+  peers.clear();
+  applied_attrs.clear();
+  attrs_busy = false;
+  my_puid.clear();
+  my_proof.clear();
+  owner_online = false;
+  last_players.clear();
+  {
+    std::lock_guard<std::mutex> l(out_mutex);
+    out_queue.clear();
+  }
+  {
+    std::lock_guard<std::mutex> l(advert_mutex);
+    applied_advert.clear();
+    advert_busy = false;
+    others_adverts.clear();
+  }
+  REXSYS_INFO("EOS LAN: Epic handed to co-op online (left the LAN lobby)");
+}
+
+void WorkerBody(std::string ini);
+void Worker(std::string ini) {
+  WorkerBody(std::move(ini));
+  const bool released = release_wanted;
+  if (released) ReleaseForCoop();
+  std::lock_guard<std::mutex> lock(activate_mutex);
+  release_wanted = false;
+  if (lent_out) state = State::Lent;
+  else if (released) state = State::Idle;  // given back already
+  worker_running = false;
+}
+
+void WorkerBody(std::string ini) {
+  EOS_InitializeOptions init{};
+  init.ApiVersion = EOS_INITIALIZE_API_LATEST;
+  init.ProductName = "Saints Reborn";
+  init.ProductVersion = "1.0";
+  const EOS_EResult r = p_EOS_Initialize(&init);
+  if (r != EOS_EResult::EOS_Success && r != EOS_EResult::EOS_AlreadyConfigured) {
+    REXSYS_WARN("EOS LAN: EOS_Initialize {}", R(r));
+    state = State::Failed;
+    return;
+  }
+  const std::string product = Ini(ini, "product"), sandbox = Ini(ini, "sandbox"), deployment = Ini(ini, "deployment"),
+                    client = Ini(ini, "client_id"), secret = Ini(ini, "client_secret");
+  if (product.empty() || client.empty()) {
+    REXSYS_WARN("EOS LAN: {} missing or incomplete", ini);
+    state = State::Failed;
+    return;
+  }
+  EOS_Platform_Options o{};
+  o.ApiVersion = EOS_PLATFORM_OPTIONS_API_LATEST;
+  o.ProductId = product.c_str();
+  o.SandboxId = sandbox.c_str();
+  o.DeploymentId = deployment.c_str();
+  o.ClientCredentials.ClientId = client.c_str();
+  o.ClientCredentials.ClientSecret = secret.c_str();
+  o.bIsServer = EOS_FALSE;
+  o.Flags = EOS_PF_DISABLE_OVERLAY;
+  platform = p_EOS_Platform_Create(&o);
+  if (!platform) { REXSYS_WARN("EOS LAN: EOS_Platform_Create failed"); state = State::Failed; return; }
+  connect_if = p_EOS_Platform_GetConnectInterface(platform);
+  lobby_if = p_EOS_Platform_GetLobbyInterface(platform);
+  p2p_if = p_EOS_Platform_GetP2PInterface(platform);
+  socket_id.ApiVersion = EOS_P2P_SOCKETID_API_LATEST;
+  std::snprintf(socket_id.SocketName, sizeof(socket_id.SocketName), "SRLAN");
+  Login();
+  auto next_refresh = std::chrono::steady_clock::now();
+  auto next_stats = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (true) {
+    if (release_wanted) return;
+    p_EOS_Platform_Tick(platform);
+    if (state == State::Ready) {
+      const auto now = std::chrono::steady_clock::now();
+      if (now >= next_refresh) { RefreshMembers(); next_refresh = now + std::chrono::seconds(2); }
+      static auto next_attrs = now;
+      if (now >= next_attrs) { ApplyAttributes(); next_attrs = now + std::chrono::milliseconds(500); }
+      Flush();
+      Receive();
+      for (auto it = partials.begin(); it != partials.end();)
+        it = now - it->second.since > std::chrono::seconds(3) ? partials.erase(it) : std::next(it);
+      if (now >= next_stats && (sent_packets || received_packets)) {
+        REXSYS_INFO("EOS LAN: {} packets sent, {} received (10 s), {} other player(s)", sent_packets.exchange(0),
+                    received_packets.exchange(0), members.size());
+        next_stats = now + std::chrono::seconds(10);
+      }
+    } else if (state == State::Failed) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+      continue;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+  }
+}
