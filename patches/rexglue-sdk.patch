+struct BindingMemoEntry {
+  uint32_t dwords[6] = {};
+  bool filled = false;
+  alignas(8) uint8_t key_bytes[32] = {};  // TextureCache::TextureKey (protected type)
+  uint8_t swizzled_signs = 0;
