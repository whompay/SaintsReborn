+  void Fill(const xenos::xe_gpu_texture_fetch_t& fetch, const Key& k, uint8_t signs,
+            uint32_t swizzle) {
+    static_assert(sizeof(Key) <= sizeof(key_bytes));
+    std::memcpy(dwords, &fetch, sizeof(dwords));
+    std::memcpy(key_bytes, &k, sizeof(Key));
