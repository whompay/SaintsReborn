+std::string MyName() {
+  const auto& profile = REX_KERNEL_STATE()->user_profile();
+  return profile ? profile->name() : std::string("Player");
+}
+
+// Server answer: "V <view> <total> <rows>" then rows
+// "r <xuid> <rank> <rating> <attr hex>=<value>/<type> ... <name>".
+std::vector<StatsView> ParseStats(const std::string& text) {
+  std::vector<StatsView> views;
+  size_t at = 0;
+  while (at < text.size()) {
+    size_t end = text.find('\n', at);
+    if (end == std::string::npos) end = text.size();
+    std::string line = text.substr(at, end - at);
+    at = end + 1;
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::vector<std::string> t;
+    size_t p = 0;
+    while (p < line.size()) {
+      const size_t q = line.find(' ', p);
+      t.push_back(line.substr(p, q == std::string::npos ? std::string::npos : q - p));
+      if (q == std::string::npos) break;
+      p = q + 1;
+    }
+    if (t.size() >= 4 && t[0] == "V") {
+      StatsView v;
+      v.view = uint32_t(std::strtoul(t[1].c_str(), nullptr, 10));
+      v.total = uint32_t(std::strtoul(t[2].c_str(), nullptr, 10));
+      views.push_back(std::move(v));
+    } else if (t.size() >= 4 && t[0] == "r" && !views.empty()) {
+      StatsRow r;
+      r.xuid = std::strtoull(t[1].c_str(), nullptr, 16);
+      r.rank = uint32_t(std::strtoul(t[2].c_str(), nullptr, 10));
+      r.rating = std::strtoll(t[3].c_str(), nullptr, 10);
+      size_t i = 4;
+      for (; i < t.size(); ++i) {
+        const size_t eq = t[i].find('=');
+        if (eq == std::string::npos) break;
+        const size_t slash = t[i].find('/', eq);
+        const uint16_t attr = uint16_t(std::strtoul(t[i].substr(0, eq).c_str(), nullptr, 16));
+        const int64_t value = std::strtoll(t[i].c_str() + eq + 1, nullptr, 10);
+        const uint8_t type = slash == std::string::npos ? kDataInt64 : uint8_t(std::strtoul(t[i].c_str() + slash + 1, nullptr, 10));
+        r.columns[attr] = {value, type == kDataInt32 ? kDataInt32 : kDataInt64};
+      }
+      for (; i < t.size(); ++i) {
+        if (!r.name.empty()) r.name += ' ';
+        r.name += t[i];
+      }
+      views.back().rows.push_back(std::move(r));
+    }
+  }
+  return views;
+}
+
+// Asks the server (blocking, short timeout). Empty views when it can't be reached.
+std::vector<StatsView> QueryStats(const std::string& request) {
+  std::string reply;
+  if (!REXCVAR_GET(xam_signed_in_to_live) ||
+      !rex::system::online::LiveStatsPost("/lb/read", MyName(), request + "\n", reply, 4000)) {
+    static std::atomic<int> told{0};
+    if (REXCVAR_GET(xam_signed_in_to_live) && told++ < 10)
+      REXLOG_WARN("LIVE leaderboards: server not reachable for '{}'", request);
+    return {};
+  }
+  return ParseStats(reply);
+}
