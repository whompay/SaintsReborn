+bool LoadSdk(std::string& ini) {
+  HMODULE dll = LoadLibraryA(g_dll_path.c_str());
+  if (!dll) { REXSYS_WARN("EOS LAN: could not load {}", g_dll_path); return false; }
+  ini = g_ini_path;
+#define EOSLAN_LOAD(name)                                                              \
+  p_##name = reinterpret_cast<decltype(p_##name)>(GetProcAddress(dll, #name));        \
+  if (!p_##name) { REXSYS_WARN("EOS LAN: DLL has no " #name); return false; }
+  EOSLAN_FUNCS(EOSLAN_LOAD)
+#undef EOSLAN_LOAD
+  sdk_loaded_here = true;
+  return true;
+}
