+std::string DescribeAnswer(const std::vector<StatsView>& answer) {
+  std::string s;
+  for (const auto& v : answer) s += fmt::format(" [view {} {} of {}]", v.view, v.rows.size(), v.total);
+  return s.empty() ? std::string(" (nothing)") : s;
+}
