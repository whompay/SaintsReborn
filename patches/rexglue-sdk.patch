+
+// Record v3 header + values: parsed by memcpy into an aligned local, validated before anything is allocated.
+// 0 ok, <0 malformed. Does not check the mask generation (callers do, under the bridge mutex).
+static int NativeBridgeParseV3(const void* data, uint32_t size, NativeBridgeRecord& rec) {
+  if (!data || size < REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE || size > REX_NATIVE_DRAW_RECORD_V3_MAX_SIZE) return -1;
+  RexNativeDrawRecordV3Header h;
+  std::memcpy(&h, data, sizeof(h));
+  if (h.v2.size != size || h.v2.version != REX_NATIVE_DRAW_RECORD_VERSION_3) return -1;
+  if (h.value_words > REX_NATIVE_DRAW_RECORD_V3_MAX_WORDS) return -1;
+  const uint32_t groups = uint32_t(std::popcount(h.vs_group_mask) + std::popcount(h.ps_group_mask));
+  if (h.value_words != groups * 16 || size != REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE + h.value_words * 4) return -1;
+  if (!(h.v2.flags & REX_NATIVE_DRAW_FLAG_CONST_VALUES) && h.value_words) return -1;
+  const bool verify = (h.v2.flags & REX_NATIVE_DRAW_FLAG_VERIFY_ONLY) != 0,
+             owned = (h.v2.flags & REX_NATIVE_DRAW_FLAG_OWNED) != 0;
+  if (verify == owned) return -1;
+  rec.r = h.v2;
+  rec.vmask[0] = h.vs_group_mask;
+  rec.vmask[1] = h.ps_group_mask;
+  rec.mask_generation = h.mask_generation;
+  rec.draw_header = h.draw_header;
+  rec.values.resize(h.value_words);
+  if (h.value_words) {
+    std::memcpy(rec.values.data(), static_cast<const uint8_t*>(data) + REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE,
+                size_t(h.value_words) * 4);
+  }
+  return 0;
+}
+
+// The record's masks are the current published ones for its key (generation and masks equal).
+static bool NativeBridgeMasksCurrent(const NativeBridgeRecord& rec) {
+  uint64_t m[2] = {};
+  uint32_t gen = 0;
+  if (NativeBridgeGetMasks(rec.r.vertex_shader_guest, rec.r.pixel_shader_guest, rec.r.vertex_decl_guest, m, &gen) !=
+      1) {
+    return false;
+  }
+  return gen == rec.mask_generation && m[0] == rec.vmask[0] && m[1] == rec.vmask[1];
+}
+
+// Record v3: verification intake (VERIFY_ONLY records only).
+static int NativeBridgeSubmitV3(const void* data, uint32_t size) {
+  if (!NativeBridgeEnabled()) return 0;
+  NativeBridgeRecord rec;
+  if (NativeBridgeParseV3(data, size, rec) < 0 || (rec.r.flags & REX_NATIVE_DRAW_FLAG_OWNED)) {
+    std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+    ++g_native_bridge.w.v3_bad;
+    return -1;
+  }
+  return NativeBridgeQueue(rec, REX_NATIVE_DRAW_RECORD_VERSION_3);
+}
+
+// EXEC8 x8c: caller holds g_native_bridge.mutex (single records: NativeBridgeQueue; batches: one lock per batch).
+static int NativeBridgeQueueLocked(NativeBridgeRecord& rec, uint32_t expected_version);
+static int NativeBridgeQueue(NativeBridgeRecord& rec, uint32_t expected_version) {
+  std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+  return NativeBridgeQueueLocked(rec, expected_version);
+}
+
+// EXEC8 x8c (AGENT_FRAME8 request): v3 records back to back in one blob (each r.size bytes, next record at the next
+// 8-byte boundary), parsed outside the lock, queued under ONE bridge mutex acquire. Returns the number of records
+// accepted (queued or counted), 0 when the bridge is off, -1 on a malformed blob (records before the bad one are
+// still queued; the bad one and the rest are dropped and counted as v3 bad).
+static int NativeBridgeSubmitV3Batch(const void* blob, uint32_t bytes, uint32_t count) {
+  if (!NativeBridgeEnabled()) return 0;
+  thread_local std::vector<NativeBridgeRecord> recs;
+  recs.clear();
+  bool bad = !blob && count;
+  const uint8_t* p = static_cast<const uint8_t*>(blob);
+  uint64_t off = 0;
+  for (uint32_t i = 0; i < count && !bad; ++i) {
+    if (off + sizeof(RexNativeDrawRecordV2) > bytes) {
+      bad = true;
+      break;
+    }
+    uint32_t sz = 0;
+    std::memcpy(&sz, p + off + offsetof(RexNativeDrawRecordV2, size), sizeof(sz));
+    if (sz < REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE || off + sz > bytes) {
+      bad = true;
+      break;
+    }
+    recs.emplace_back();
+    if (NativeBridgeParseV3(p + off, sz, recs.back()) < 0 || (recs.back().r.flags & REX_NATIVE_DRAW_FLAG_OWNED)) {
+      recs.pop_back();
+      bad = true;
+      break;
+    }
+    off += (uint64_t(sz) + 7) & ~uint64_t(7);
+  }
+  int accepted = 0;
+  {
+    std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+    ++g_native_bridge.w.v3_batches;
+    g_native_bridge.w.v3_batch_records += recs.size();
+    if (bad) ++g_native_bridge.w.v3_bad;
+    for (NativeBridgeRecord& rec : recs) {
+      if (NativeBridgeQueueLocked(rec, REX_NATIVE_DRAW_RECORD_VERSION_3) > 0) ++accepted;
+    }
+  }
+  recs.clear();
+  return bad ? -1 : accepted;
+}
+
+// Record v4 (AGENT_NATIVE29A session 29): v3 header (version 4) + const values + RexNativeDrawRecordV4Ext + fetch values
+// (+ call words with CALL_WORDS, not kept). 0 ok, <0 malformed.
+static int NativeBridgeParseV4(const void* data, uint32_t size, NativeBridgeRecord& rec) {
+  if (!data || size < REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE + sizeof(RexNativeDrawRecordV4Ext)) return -1;
+  RexNativeDrawRecordV3Header h;
+  std::memcpy(&h, data, sizeof(h));
+  if (h.v2.size != size || h.v2.version != REX_NATIVE_DRAW_RECORD_VERSION_4) return -1;
+  if (h.value_words > REX_NATIVE_DRAW_RECORD_V3_MAX_WORDS) return -1;
+  const uint32_t groups = uint32_t(std::popcount(h.vs_group_mask) + std::popcount(h.ps_group_mask));
+  if (h.value_words != groups * 16) return -1;
+  if (!(h.v2.flags & REX_NATIVE_DRAW_FLAG_CONST_VALUES) && h.value_words) return -1;
+  const bool verify = (h.v2.flags & REX_NATIVE_DRAW_FLAG_VERIFY_ONLY) != 0,
+             owned = (h.v2.flags & REX_NATIVE_DRAW_FLAG_OWNED) != 0;
+  if (verify == owned) return -1;
+  const size_t ext_off = REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE + size_t(h.value_words) * 4;
+  if (ext_off + sizeof(RexNativeDrawRecordV4Ext) > size) return -1;
+  const uint8_t* p = static_cast<const uint8_t*>(data);
+  RexNativeDrawRecordV4Ext x;
+  std::memcpy(&x, p + ext_off, sizeof(x));
+  const uint32_t units = uint32_t(std::popcount(x.fetch_unit_mask[0]) + std::popcount(x.fetch_unit_mask[1]) +
+                                  std::popcount(x.fetch_unit_mask[2]));
+  if (x.magic != REX_NATIVE_DRAW_V4_EXT_MAGIC || x.fetch_value_words != units * 2 || x.draw_packet_words > 8 ||
+      ext_off + size_t(x.ext_size) != size || x.ext_size < sizeof(x) + size_t(x.fetch_value_words) * 4) {
+    return -1;
+  }
+  const bool calls = (h.v2.flags & REX_NATIVE_DRAW_FLAG_CALL_WORDS) != 0;
+  if (!calls && x.ext_size != sizeof(x) + x.fetch_value_words * 4) return -1;
+  rec.r = h.v2;
+  rec.vmask[0] = h.vs_group_mask;
+  rec.vmask[1] = h.ps_group_mask;
+  rec.mask_generation = h.mask_generation;
+  rec.draw_header = h.draw_header;
+  rec.values.resize(h.value_words);
+  if (h.value_words) {
+    std::memcpy(rec.values.data(), p + REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE, size_t(h.value_words) * 4);
+  }
+  rec.v4 = true;
+  std::memcpy(rec.fetch_units, x.fetch_unit_mask, sizeof(rec.fetch_units));
+  rec.fetch_values.resize(x.fetch_value_words);
+  if (x.fetch_value_words) {
+    std::memcpy(rec.fetch_values.data(), p + ext_off + sizeof(x), size_t(x.fetch_value_words) * 4);
+  }
+  if (h.v2.flags & REX_NATIVE_DRAW_FLAG_REG_VALUES) rec.state_values.assign(x.state_values, x.state_values + 64);
+  rec.draw_packet_words = x.draw_packet_words;
+  std::memcpy(rec.draw_packet, x.draw_packet, sizeof(rec.draw_packet));
+  return 0;
+}
+
+// Batch of v3 / v4 VERIFY_ONLY records (V3Batch framing). Returns accepted count, 0 bridge off, -1 malformed blob.
+static int NativeBridgeSubmitV4Batch(const void* blob, uint32_t bytes, uint32_t count) {
+  if (!NativeBridgeEnabled()) return 0;
+  thread_local std::vector<NativeBridgeRecord> recs;
+  recs.clear();
+  bool bad = !blob && count, any_owned = false, any_verify = false;
+  const uint8_t* p = static_cast<const uint8_t*>(blob);
+  uint64_t off = 0;
+  for (uint32_t i = 0; i < count && !bad; ++i) {
+    if (off + sizeof(RexNativeDrawRecordV2) > bytes) {
+      bad = true;
+      break;
+    }
+    uint32_t sz = 0, ver = 0;
+    std::memcpy(&sz, p + off + offsetof(RexNativeDrawRecordV2, size), sizeof(sz));
+    std::memcpy(&ver, p + off + offsetof(RexNativeDrawRecordV2, version), sizeof(ver));
+    if (sz < REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE || off + sz > bytes) {
+      bad = true;
+      break;
+    }
+    recs.emplace_back();
+    const int pr = ver == REX_NATIVE_DRAW_RECORD_VERSION_4 ? NativeBridgeParseV4(p + off, sz, recs.back())
+                                                           : NativeBridgeParseV3(p + off, sz, recs.back());
+    if (pr < 0) {
+      recs.pop_back();
+      bad = true;
+      break;
+    }
+    if (recs.back().r.flags & REX_NATIVE_DRAW_FLAG_OWNED) {
+      any_owned = true;  // AGENT_NATIVE30A2: OWNED run batch (all-or-nothing, NativeOwnIntake)
+    } else {
+      any_verify = true;
+    }
+    off += (uint64_t(sz) + 7) & ~uint64_t(7);
+  }
+  if (any_owned) {
+    if (bad || any_verify) {
+      std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+      ++g_own_st.batches;
+      ++g_own_st.refused_runs;
+      g_own_st.refused_draws += count;
+      ++g_own_st.why[bad ? 1 : 2];
+      ++g_native_bridge.w.v4_bad;
+      recs.clear();
+      return 0;
+    }
+    const int r = NativeOwnIntake(recs);
+    recs.clear();
+    return r;
+  }
+  int accepted = 0;
+  {
+    std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+    NativeBridgeWindow& w = g_native_bridge.w;
+    ++w.v4_batches;
+    if (bad) ++w.v4_bad;
+    for (NativeBridgeRecord& rec : recs) {
+      if (rec.v4) {
+        ++w.v4_records;
+        if (rec.r.flags & REX_NATIVE_DRAW_FLAG_REG_VALUES) ++w.v4_reg_values;
+        if (rec.r.flags & REX_NATIVE_DRAW_FLAG_SELF_SUFFICIENT) ++w.v4_self;
+      }
+      if (NativeBridgeQueueLocked(rec, rec.r.version) > 0) ++accepted;
+    }
+  }
+  recs.clear();
+  return bad ? -1 : accepted;
+}
+
+static int NativeBridgeQueueLocked(NativeBridgeRecord& rec, uint32_t expected_version) {
+  NativeBridgeWindow& w = g_native_bridge.w;
+  const RexNativeDrawRecordV2& r = rec.r;
+  if (expected_version == REX_NATIVE_DRAW_RECORD_VERSION_2 && r.size != sizeof(RexNativeDrawRecordV2)) {
+    ++w.bad_size;
+    return -1;
+  }
+  if (r.version != expected_version) {
+    ++w.bad_version;
+    return -2;
+  }
+  if (expected_version != REX_NATIVE_DRAW_RECORD_VERSION_2) {
+    ++w.v3_records;
+    if (!(r.flags & REX_NATIVE_DRAW_FLAG_CONST_VALUES)) {
+      ++w.v3_no_values;
+    } else if (!NativeBridgeMasksCurrent(rec)) {
+      // Built from an older mask snapshot: the values may lack groups the SDK learned since -> not usable.
+      ++w.v3_stale_masks;
+      rec.r.flags &= ~REX_NATIVE_DRAW_FLAG_CONST_VALUES;
+      rec.values.clear();
+      rec.vmask[0] = rec.vmask[1] = 0;
+    } else if (g_native_bridge.pending_value_bytes + rec.values.size() * 4 > kNativeBridgeMaxValueBytes) {
+      ++w.v3_dropped_bytes;
+      rec.r.flags &= ~REX_NATIVE_DRAW_FLAG_CONST_VALUES;
+      rec.values.clear();
+      rec.vmask[0] = rec.vmask[1] = 0;
+    }
+    if (rec.r.flags & REX_NATIVE_DRAW_FLAG_CONST_VALUES) {
+      ++w.v3_with_values;
+      w.v3_value_words += rec.values.size();
+      // Values must hash to the record's own group hashes (capture-side consistency; not in dry mode).
+      for (uint32_t st = 0; st < 2 && !g_nb_dry.load(std::memory_order_relaxed); ++st) {
+        const uint32_t* hashes = st ? r.ps_const_hash : r.vs_const_hash;
+        for (uint32_t g = 0; g < 64; ++g) {
+          const uint32_t* v = NativeBridgeRecordGroup(rec.vmask, rec.values, st, g);
+          if (v && RexNativeBridgeHashWords(v, 16) != hashes[g]) ++w.v3_hash_bad_groups;
+        }
+      }
+    }
+  }
+  if (!(r.flags & REX_NATIVE_DRAW_FLAG_VERIFY_ONLY)) {
+    ++w.bad_flags;
+    return -2;
+  }
+  ++w.submitted;
+  ++w.submitted_path[r.path_id < REX_NATIVE_PATH_COUNT ? r.path_id : 0];
+  if (!(r.flags & REX_NATIVE_DRAW_FLAG_HAS_PACKET) || !r.packet_end) {
+    ++w.submitted_no_packet;
+    return 1;
+  }
+  if (g_native_bridge.pending_count >= kNativeBridgeMaxPending) {
+    ++w.dropped_full;
+    return -3;
+  }
+  g_native_bridge.pending_value_bytes += rec.values.size() * 4;
+  g_native_bridge.pending[NativeBridgeGpu(r.packet_end)].push_back(std::move(rec));
+  ++g_native_bridge.pending_count;
+  return 1;
+}
+
+// M3b marker record: 1 + nonzero *out_record_id when stored. OWNED (live) records are always refused (0) until the
+// native executor exists and passes its gates; VERIFY_ONLY records need complete values for the current masks,
+// the full 64-register state and the DRAW header.
+static int NativeMarkerSubmit(const void* data, uint32_t size, uint32_t* out_record_id) {
+  if (out_record_id) *out_record_id = 0;
+  if (!NativeBridgeEnabled() || !g_m3a_on.load(std::memory_order_relaxed)) return 0;
+  NativeBridgeRecord rec;
+  const int parsed = NativeBridgeParseV3(data, size, rec);
+  std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+  NativeMarkerWindow& mw = g_native_bridge.mw;
+  if (parsed < 0 || !out_record_id) {
+    ++mw.refused_bad;
+    return -1;
+  }
+  if (rec.r.flags & REX_NATIVE_DRAW_FLAG_OWNED) {
+    ++mw.owned_refused;
+    return 0;
+  }
+  if (!(rec.r.flags & REX_NATIVE_DRAW_FLAG_CONST_VALUES)) {
+    ++mw.refused_novalues;
+    return 0;
+  }
+  if (!NativeBridgeMasksCurrent(rec)) {
+    ++mw.refused_stale;
+    return 0;
+  }
+  const uint64_t known = uint64_t(rec.r.reserved2[0]) | (uint64_t(rec.r.reserved2[1]) << 32);
+  if (!(rec.r.flags & REX_NATIVE_DRAW_FLAG_STATE) || !(rec.r.flags & REX_NATIVE_DRAW_FLAG_STREAM_STATE) ||
+      known != ~0ull) {
+    ++mw.refused_state;
+    return 0;
+  }
+  if (!rec.draw_header) {
+    ++mw.refused_header;
+    return 0;
+  }
+  if (g_native_bridge.markers.size() >= kNativeMarkerMaxRecords ||
+      g_native_bridge.marker_value_bytes + rec.values.size() * 4 > kNativeBridgeMaxValueBytes) {
+    ++mw.refused_full;
+    return 0;
+  }
+  uint32_t id = g_native_bridge.next_marker_id++;
+  if (!id) id = g_native_bridge.next_marker_id++;
+  NativeMarkerRecord& m = g_native_bridge.markers[id];
+  g_native_bridge.marker_value_bytes += rec.values.size() * 4;
+  m.rec = std::move(rec);
+  m.submit_swap = g_native_bridge.cp_swaps;
+  ++mw.submitted;
+  *out_record_id = id;
+  return 1;
+}
+
+static void M3aMarkerProbe(NativeMarkerPending& pm);  // native_frame_exec_verify.inc
+
+// CP thread: marker NOP (count 2, REX_NATIVE_MARKER_MAGIC) executed (after the generic CP's predication).
+static uint32_t NativeBridgeCheck(const RexNativeDrawRecordV2& r, xenos::PrimitiveType primitive_type,
+                                  uint32_t index_count, bool has_index_buffer,
+                                  uint32_t index_buffer_guest_base, uint32_t index_size,
+                                  const RegisterFile& regs, const Shader* vertex_shader,
+                                  const Shader* pixel_shader, NativeBridgeWindow& w);  // below
+
+static void NativeMarkerHook(uint32_t id, uint32_t packet_header) {
+  if (!NativeBridgeEnabled() || !g_m3a_on.load(std::memory_order_relaxed)) return;
+  bool hit = false;
+  {
+    std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+    NativeMarkerWindow& mw = g_native_bridge.mw;
+    ++mw.markers;
+    if (g_m3b.active) ++mw.marker_no_draw;
+    g_m3b.active = false;
+    auto it = g_native_bridge.markers.find(id);
+    if (it == g_native_bridge.markers.end()) {
+      ++mw.id_miss;
+      return;
+    }
+    NativeMarkerRecord& m = it->second;
+    ++mw.id_hit;
+    if (m.execs) ++mw.replays;  // tiled replay of the same command buffer
+    ++m.execs;
+    m.last_exec_swap = g_native_bridge.cp_swaps;
+    if ((packet_header & 1) != (m.rec.draw_header & 1)) ++mw.pred_bad;
+    g_m3b.id = id;
+    g_m3b.header = packet_header;
+    g_m3b.rec = m.rec;
+    hit = true;
+    // NATIVE7: the marker refers back to the draw before it (same packet end as the record's).
+    if (!g_nb_last.valid) {
+      ++mw.back_no_draw;
+    } else if (NativeBridgePhys(g_nb_last.packet_end) != NativeBridgeGpu(m.rec.r.packet_end)) {
+      ++mw.back_other_draw;
+    } else if (g_nb_trace_regs) {
+      ++mw.back_checked;
+      ++mw.draws_after;
+      static NativeBridgeWindow scratch;  // NativeBridgeCheck's own counters are not wanted here
+      const uint32_t mbad = NativeBridgeCheck(m.rec.r, g_nb_last.prim, g_nb_last.index_count, g_nb_last.has_ib,
+                                              g_nb_last.ib_base, g_nb_last.index_size, *g_nb_trace_regs,
+                                              g_nb_last.vs, g_nb_last.ps, scratch);
+      if (!mbad) ++mw.exact;
+      for (uint32_t f = 0; f < kNbFieldCount; ++f) {
+        if (mbad & (1u << f)) ++mw.field_bad[f];
+      }
+      if ((g_nb_last.header & 1) != (m.rec.draw_header & 1)) ++mw.pred_bad;
+      if (mbad && mw.n_examples < 4) {
+        ++mw.n_examples;
+        std::string f;
+        for (uint32_t i = 0; i < kNbFieldCount; ++i) {
+          if (mbad & (1u << i)) f += fmt::format("{}{}", f.empty() ? "" : ",", kNbFieldName[i]);
+        }
+        mw.examples += fmt::format(" [back id {} path {} caller {:08X} {} | draw end {:08X} hdr {:08X}]", id,
+                                   m.rec.r.path_id, m.rec.r.caller, f, g_nb_last.packet_end, g_nb_last.header);
+      }
+    }
+  }
+  if (hit) {
+    // Probe the entry the record keys to; compare with the entry of the draw it refers back to.
+    M3aMarkerProbe(g_m3b);
+    if (g_nb_last.valid && g_nb_last.entry_valid &&
+        NativeBridgePhys(g_nb_last.packet_end) == NativeBridgeGpu(g_m3b.rec.r.packet_end)) {
+      std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+      NativeMarkerWindow& mw = g_native_bridge.mw;
+      if (g_m3b.entry_found && g_m3b.entry_hash == g_nb_last.entry_hash) {
+        ++mw.entry_same;
+      } else {
+        ++mw.entry_other;
+      }
+    }
+    g_m3b.active = false;  // refer-back markers: the next draw is not the marker's
+    g_m3b.compare_entry = false;
+  }
+}
+
+// IssueSwap (CP thread, bridge mutex held): retire marker records executed before this swap; expire unseen ones.
+static void NativeMarkerOnSwap() {
+  ++g_native_bridge.cp_swaps;
+  g_nb_last.valid = false;
+  NativeMarkerWindow& mw = g_native_bridge.mw;
+  if (g_m3b.active) {
+    ++mw.marker_no_draw;
+    g_m3b.active = false;
+  }
+  for (auto it = g_native_bridge.markers.begin(); it != g_native_bridge.markers.end();) {
+    const NativeMarkerRecord& m = it->second;
+    const bool retire = m.execs && m.last_exec_swap < g_native_bridge.cp_swaps;
+    const bool expire = !m.execs && m.submit_swap + 8 < g_native_bridge.cp_swaps;
+    if (retire || expire) {
+      ++(retire ? mw.retired : mw.expired);
+      g_native_bridge.marker_value_bytes -= m.rec.values.size() * 4;
+      it = g_native_bridge.markers.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+// v1 (88-byte pass-8 mesh records, no packet address): accepted and counted only.
+static int NativeBridgeSubmit(const void* data, uint32_t size) {
+  if (!NativeBridgeEnabled()) return 0;
+  std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+  if (!data || size != sizeof(RexNativeMeshRecordV1)) {
+    ++g_native_bridge.w.bad_size;
+    return -1;
+  }
+  ++g_native_bridge.w.v1_records;
+  return 1;
+}
+
+static int NativeBridgeFrameBoundary(uint64_t frame_id) {
+  if (!NativeBridgeEnabled()) return 0;
+  std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+  NativeBridgeWindow& w = g_native_bridge.w;
+  g_native_bridge.newest_frame = std::max(g_native_bridge.newest_frame, frame_id);
+  // The command processor may trail the engine by a few frames under load. Records older than eight
+  // frames are orphans (their packet was never executed, or executed without reaching IssueDraw).
+  const uint64_t oldest = frame_id > 7 ? frame_id - 7 : 0;
+  for (auto it = g_native_bridge.pending.begin(); it != g_native_bridge.pending.end();) {
+    std::vector<NativeBridgeRecord>& v = it->second;
+    size_t kept = 0;
+    for (size_t i = 0; i < v.size(); ++i) {
+      if (v[i].r.frame_id < oldest) {
+        const RexNativeDrawRecordV2& r = v[i].r;
+        ++w.stale_path[r.path_id < REX_NATIVE_PATH_COUNT ? r.path_id : 0];
+        if (w.n_stale < 6) {
+          ++w.n_stale;
+          w.examples_stale += fmt::format(" [path {} caller {:08X} pass {:X} end {:08X} prim {} n {} surf {:08X}]",
+                                          r.path_id, r.caller, r.pass_id, r.packet_end, r.primitive_type,
+                                          r.index_count, r.surface_info);
+        }
+        --g_native_bridge.pending_count;
+        g_native_bridge.pending_value_bytes -= v[i].values.size() * 4;
+      } else {
+        if (kept != i) v[kept] = std::move(v[i]);
+        ++kept;
+      }
+    }
+    v.resize(kept);
+    if (v.empty()) {
+      it = g_native_bridge.pending.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  return 1;
+}
+
+static NativeBridgeClass NativeBridgeClassify(const RegisterFile& regs) {
+  if (regs.Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy) return kNbCopy;
+  const uint32_t surface = regs[XE_GPU_REG_RB_SURFACE_INFO];
+  const uint32_t color_mask = regs[XE_GPU_REG_RB_COLOR_MASK] & 0xFFFF;
+  const uint32_t pitch = surface & 0x3FFF, msaa = (surface >> 16) & 3;
+  if (pitch == 1280 && msaa == 0 && color_mask == 0xF) return kNbMain;
+  if (pitch == 640 && msaa == 2 && color_mask == 0) return kNbPrepass;
+  return kNbOther;
+}
+
+// Field checks of one matched record against the register file. Returns the mismatch bit mask.
+static uint32_t NativeBridgeCheck(const RexNativeDrawRecordV2& r, xenos::PrimitiveType primitive_type,
+                                  uint32_t index_count, bool has_index_buffer,
+                                  uint32_t index_buffer_guest_base, uint32_t index_size,
+                                  const RegisterFile& regs, const Shader* vertex_shader,
+                                  const Shader* pixel_shader, NativeBridgeWindow& w) {
+  uint32_t bad = 0;
+  if (r.primitive_type != uint32_t(primitive_type)) bad |= 1u << kNbFPrim;
+  if (r.index_count != index_count) bad |= 1u << kNbFCount;
+  if (has_index_buffer && r.index_buffer_guest && !(r.flags & REX_NATIVE_DRAW_FLAG_PM4_GEOMETRY)) {
+    const uint32_t expected = r.index_buffer_guest + r.start_index * index_size;
+    if (NativeBridgePhys(index_buffer_guest_base) != NativeBridgeGpu(expected)) bad |= 1u << kNbFIb;
+  }
+  if (has_index_buffer && (r.flags & REX_NATIVE_DRAW_FLAG_ENGINE_BASE) &&
+      uint32_t(r.base_vertex) != regs.Get<reg::VGT_INDX_OFFSET>().indx_offset) {
+    bad |= 1u << kNbFBase;
+  }
+  if (!(r.flags & REX_NATIVE_DRAW_FLAG_STATE)) return bad;
+  {
+    const auto vs_it = g_native_bridge_shader_guest.find(vertex_shader);
+    const auto ps_it = g_native_bridge_shader_guest.find(pixel_shader);
+    const uint32_t vs_guest = vs_it == g_native_bridge_shader_guest.end() ? 0 : vs_it->second;
+    const uint32_t ps_guest = ps_it == g_native_bridge_shader_guest.end() ? 0 : ps_it->second;
+    if ((r.vertex_shader_guest && vs_guest &&
+         NativeBridgePhys(r.vertex_shader_guest) != NativeBridgePhys(vs_guest)) ||
+        (r.pixel_shader_guest && ps_guest &&
+         NativeBridgePhys(r.pixel_shader_guest) != NativeBridgePhys(ps_guest))) {
+      bad |= 1u << kNbFShader;
+    }
+  }
+  if (r.surface_info != regs[XE_GPU_REG_RB_SURFACE_INFO] || r.color_mask != regs[XE_GPU_REG_RB_COLOR_MASK] ||
+      r.depth_control != regs[XE_GPU_REG_RB_DEPTHCONTROL] ||
+      r.mode_control != regs[XE_GPU_REG_RB_MODECONTROL]) {
+    bad |= 1u << kNbFRt;
+  }
+  // Float constants the translated shaders read, per group of 4 constants (16 words).
+  const bool main_class = NativeBridgeClassify(regs) == kNbMain;
+  auto check_consts = [&](const Shader* shader, uint32_t first_register, const uint32_t* rec_hash,
+                          uint64_t& checked, uint64_t& mismatched, uint32_t* g_checked,
+                          uint32_t* g_bad) -> bool {
+    if (!shader || !shader->is_ucode_analyzed()) return false;
+    const Shader::ConstantRegisterMap& map = shader->constant_register_map();
+    bool any_bad = false;
+    for (uint32_t g = 0; g < 64; ++g) {
+      const bool used = map.float_dynamic_addressing ||
+                        ((map.float_bitmap[g >> 4] >> ((g & 15) * 4)) & 0xF) != 0;
+      if (!used) continue;
+      ++checked;
+      if (main_class) ++g_checked[g];
+      const uint32_t h = RexNativeBridgeHashWords(&regs[first_register + g * 16], 16);
+      if (h != rec_hash[g]) {
+        ++mismatched;
+        if (main_class) ++g_bad[g];
+        any_bad = true;
+      }
+    }
+    return any_bad;
+  };
+  if (check_consts(vertex_shader, XE_GPU_REG_SHADER_CONSTANT_000_X, r.vs_const_hash, w.vs_groups,
+                   w.vs_groups_bad, w.vs_g_checked, w.vs_g_bad)) {
+    bad |= 1u << kNbFVsConst;
+  }
+  if (check_consts(pixel_shader, XE_GPU_REG_SHADER_CONSTANT_256_X, r.ps_const_hash, w.ps_groups,
+                   w.ps_groups_bad, w.ps_g_checked, w.ps_g_bad)) {
+    bad |= 1u << kNbFPsConst;
+  }
+  // Fetch constants: texture slots of both stages (3 units each) and the vertex fetches of the VS.
+  uint32_t units[3] = {};  // bitmap of 2-word units 0..95
+  auto add_textures = [&](const Shader* shader) {
+    if (!shader || !shader->is_ucode_analyzed()) return;
+    for (const auto& t : shader->texture_bindings()) {
+      const uint32_t s = t.fetch_constant & 31;
+      for (uint32_t u = s * 3; u < s * 3 + 3; ++u) units[u >> 5] |= 1u << (u & 31);
+    }
+  };
+  add_textures(vertex_shader);
+  add_textures(pixel_shader);
+  if (vertex_shader && vertex_shader->is_ucode_analyzed()) {
+    const auto& vf = vertex_shader->constant_register_map().vertex_fetch_bitmap;
+    for (uint32_t i = 0; i < 3; ++i) units[i] |= vf[i];
+  }
+  bool fetch_bad = false;
+  for (uint32_t u = 0; u < 96; ++u) {
+    if (!(units[u >> 5] & (1u << (u & 31)))) continue;
+    ++w.fetch_units;
+    if (RexNativeBridgeHashWords(&regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + u * 2], 2) != r.fetch_hash[u]) {
+      ++w.fetch_units_bad;
+      fetch_bad = true;
+    }
+  }
+  if (fetch_bad) bad |= 1u << kNbFFetch;
+  if (r.flags & REX_NATIVE_DRAW_FLAG_STREAM_STATE) {
+    static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+    const uint64_t known = uint64_t(r.reserved2[0]) | (uint64_t(r.reserved2[1]) << 32);
+    uint32_t words[REX_NATIVE_STATE_REG_COUNT];
+    for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+      words[i] = ((known >> i) & 1) ? regs[kRegs[i]] : 0;
+    }
+    ++w.state_checked;
+    w.state_known_regs += uint64_t(std::popcount(known));
+    if (known == ~0ull) ++w.state_full;
+    if (RexNativeBridgeHashWords(words, REX_NATIVE_STATE_REG_COUNT) != r.reserved1) {
+      ++w.state_bad;
+      bad |= 1u << kNbFState;
+    }
+  }
+  return bad;
+}
+
+// Examples wanted in this window (first 3 s of each 10 s log window, while a class has fewer than 3).
+static bool NativeBridgeExamplesWanted(const NativeBridgeWindow& w) {
+  if (!g_nb_examples_on.load(std::memory_order_relaxed)) return false;
+  if (GetTickCount64() > g_native_bridge.last_log_tick + 3000) return false;
+  for (uint32_t f = kNbFRt; f <= kNbFState; ++f) {
+    if (w.ex[f].size() < kNbExamplesPerField) return true;
+  }
+  return false;
+}
+
+static void NativeBridgeSnapPrev(const RegisterFile& regs) {
+  static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+  NativeBridgeSnap& sn = g_nb_prev;
+  std::memcpy(sn.c, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X], sizeof(sn.c));
+  std::memcpy(sn.f, &regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], sizeof(sn.f));
+  for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) sn.st[i] = regs[kRegs[i]];
+  for (uint32_t i = 0; i < 4; ++i) sn.rt[i] = regs[kNbRtRegs[i]];
+  sn.valid = true;
+}
+
+// The draw after an example: does the record hold this (next) draw's value?
+static void NativeBridgeEvalNext(const RegisterFile& regs, NativeBridgeWindow& w) {
+  static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+  for (const NativeBridgeNextCheck& n : g_nb_next) {
+    if (n.field >= kNbFieldCount || n.example >= w.ex[n.field].size()) continue;
+    std::string& o = w.ex[n.field][n.example];
+    if (n.field == kNbFRt) {
+      o += " | next";
+      for (uint32_t i = 0; i < 4; ++i) {
+        if (!((n.known >> i) & 1)) continue;
+        const uint32_t v = regs[kNbRtRegs[i]];
+        o += v == n.cur[i] ? fmt::format(" {}=rec", kNbRtName[i]) : fmt::format(" {} {:08X}", kNbRtName[i], v);
+      }
+    } else if (n.field == kNbFState) {
+      uint32_t words[REX_NATIVE_STATE_REG_COUNT];
+      std::memcpy(words, n.cur, sizeof(words));
+      std::string found, changed;
+      uint32_t nchanged = 0;
+      for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+        if (!((n.known >> i) & 1)) continue;
+        const uint32_t v = regs[kRegs[i]];
+        if (v == n.cur[i]) continue;
+        if (++nchanged <= 8) changed += fmt::format(" {:04X} {:08X}->{:08X}", kRegs[i], n.cur[i], v);
+        words[i] = v;
+        if (RexNativeBridgeHashWords(words, REX_NATIVE_STATE_REG_COUNT) == n.rec_hash) {
+          found += fmt::format(" {:04X}=next({:08X})", kRegs[i], v);
+        }
+        words[i] = n.cur[i];
+      }
+      if (found.empty() && nchanged) {
+        for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+          if ((n.known >> i) & 1) words[i] = regs[kRegs[i]];
+        }
+        if (RexNativeBridgeHashWords(words, REX_NATIVE_STATE_REG_COUNT) == n.rec_hash) found = " all=next";
+      }
+      o += fmt::format(" | next draw changed {}:{} rec matches with:{}", nchanged, changed,
+                       found.empty() ? " -" : found);
+    } else {
+      o += RexNativeBridgeHashWords(&regs[n.first_reg], n.words) == n.rec_hash ? " | rec=next" : " | rec!=next";
+    }
+  }
+  g_nb_next.clear();
+}
+
+// One example per mismatch class (rate-limited): what the CP register file holds vs what the record says.
+static void NativeBridgeExamples(const NativeBridgeRecord& rec, uint32_t bad, NativeBridgeClass cls,
+                                 const RegisterFile& regs, const Shader* vertex_shader,
+                                 const Shader* pixel_shader, NativeBridgeWindow& w) {
+  static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+  const RexNativeDrawRecordV2& r = rec.r;
+  const NativeBridgeSnap* prev = g_nb_prev.valid ? &g_nb_prev : nullptr;
+  const std::string head = fmt::format(
+      "{} path {} caller {:08X} pass {:X} thr {} flags {:X} end {:08X} vs {:08X} ps {:08X} decl {:08X}",
+      kNbClassName[cls], r.path_id, r.caller, r.pass_id, r.thread_id, r.flags, r.packet_end,
+      r.vertex_shader_guest, r.pixel_shader_guest, r.vertex_decl_guest);
+  auto want = [&](uint32_t f) { return (bad & (1u << f)) && w.ex[f].size() < kNbExamplesPerField; };
+  if (want(kNbFRt)) {
+    const uint32_t recv[4] = {r.surface_info, r.color_mask, r.depth_control, r.mode_control};
+    std::string o = head + " | rt";
+    NativeBridgeNextCheck n;
+    n.field = kNbFRt;
+    n.example = uint32_t(w.ex[kNbFRt].size());
+    for (uint32_t i = 0; i < 4; ++i) {
+      const uint32_t cp = regs[kNbRtRegs[i]];
+      if (recv[i] == cp) continue;
+      o += fmt::format(" {} rec {:08X} cp {:08X} prev {}", kNbRtName[i], recv[i], cp,
+                       !prev ? std::string("?")
+                       : prev->rt[i] == recv[i] ? std::string("=rec")
+                                                : fmt::format("{:08X}", prev->rt[i]));
+      for (uint32_t k = 0; k < REX_NATIVE_STATE_REG_COUNT; ++k) {
+        if (kRegs[k] != kNbRtRegs[i] || !g_nb_trace.valid) continue;
+        const NativeBridgeRegWrite& lw = g_nb_trace.last[k];
+        const NativeBridgeRegWrite& bw = g_nb_trace.before[k];
+        o += fmt::format(" (last write {}; before {}{})", NativeBridgeWriterText(lw), NativeBridgeWriterText(bw),
+                         bw.valid && bw.value == recv[i] ? " =rec" : "");
+      }
+      n.known |= uint64_t(1) << i;
+      n.cur[i] = recv[i];
+    }
+    w.ex[kNbFRt].push_back(std::move(o));
+    g_nb_next.push_back(n);
+  }
+  auto consts = [&](uint32_t field, const Shader* sh, uint32_t stage, const uint32_t* rec_hash) {
+    if (!want(field) || !sh || !sh->is_ucode_analyzed()) return;
+    const Shader::ConstantRegisterMap& map = sh->constant_register_map();
+    const uint32_t first = stage ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X;
+    uint32_t nused = 0, nbad = 0, nprev = 0;
+    int first_bad = -1;
+    std::string groups;
+    for (uint32_t g = 0; g < 64; ++g) {
+      const bool used = map.float_dynamic_addressing || ((map.float_bitmap[g >> 4] >> ((g & 15) * 4)) & 0xF) != 0;
+      if (!used) continue;
+      ++nused;
+      if (RexNativeBridgeHashWords(&regs[first + g * 16], 16) == rec_hash[g]) continue;
+      ++nbad;
+      if (first_bad < 0) first_bad = int(g);
+      const bool is_prev = prev && RexNativeBridgeHashWords(prev->c + stage * 1024 + g * 16, 16) == rec_hash[g];
+      nprev += is_prev ? 1u : 0u;
+      if (groups.size() < 200) groups += fmt::format(" c{}{}", stage * 256 + g * 4, is_prev ? "=prev" : "");
+    }
+    std::string o = head + fmt::format(" | {} used groups bad {}/{} (rec=prev {}):{}", kNbFieldName[field], nbad,
+                                       nused, nprev, groups);
+    if (first_bad >= 0) {
+      const uint32_t g = uint32_t(first_bad);
+      const uint32_t* cw = &regs[first + g * 16];
+      const uint32_t* rv = NativeBridgeRecordGroup(rec.vmask, rec.values, stage, g);
+      o += fmt::format(" | c{}..{} cp", stage * 256 + g * 4, stage * 256 + g * 4 + 3);
+      for (uint32_t k = 0; k < 16; ++k) o += fmt::format(" {:08X}", cw[k]);
+      if (rv) {
+        o += " rec:";
+        for (uint32_t k = 0; k < 16; ++k) {
+          if (rv[k] != cw[k]) o += fmt::format(" w{} {:08X}", k, rv[k]);
+        }
+      }
+      if (prev) {
+        std::string pd;
+        for (uint32_t k = 0; k < 16; ++k) {
+          const uint32_t pv = prev->c[stage * 1024 + g * 16 + k];
+          if (pv != cw[k]) pd += fmt::format(" w{} {:08X}", k, pv);
+        }
+        o += pd.empty() ? std::string(" prev: same") : " prev:" + pd;
+      }
+      NativeBridgeNextCheck n;
+      n.field = field;
+      n.example = uint32_t(w.ex[field].size());
+      n.first_reg = first + g * 16;
+      n.words = 16;
+      n.rec_hash = rec_hash[g];
+      g_nb_next.push_back(n);
+    }
+    w.ex[field].push_back(std::move(o));
+  };
+  consts(kNbFVsConst, vertex_shader, 0, r.vs_const_hash);
+  consts(kNbFPsConst, pixel_shader, 1, r.ps_const_hash);
+  if (want(kNbFFetch)) {
+    uint32_t tex_units[3] = {}, vf_units[3] = {};
+    auto add_textures = [&](const Shader* shader) {
+      if (!shader || !shader->is_ucode_analyzed()) return;
+      for (const auto& t : shader->texture_bindings()) {
+        const uint32_t sl = t.fetch_constant & 31;
+        for (uint32_t u = sl * 3; u < sl * 3 + 3; ++u) tex_units[u >> 5] |= 1u << (u & 31);
+      }
+    };
+    add_textures(vertex_shader);
+    add_textures(pixel_shader);
+    if (vertex_shader && vertex_shader->is_ucode_analyzed()) {
+      const auto& vf = vertex_shader->constant_register_map().vertex_fetch_bitmap;
+      for (uint32_t i = 0; i < 3; ++i) vf_units[i] = vf[i];
+    }
+    std::string units;
+    uint32_t nused = 0, nbad = 0;
+    int first_bad = -1;
+    for (uint32_t u = 0; u < 96; ++u) {
+      const bool is_tex = (tex_units[u >> 5] >> (u & 31)) & 1, is_vf = (vf_units[u >> 5] >> (u & 31)) & 1;
+      if (!is_tex && !is_vf) continue;
+      ++nused;
+      const uint32_t* cw = &regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + u * 2];
+      if (RexNativeBridgeHashWords(cw, 2) == r.fetch_hash[u]) continue;
+      ++nbad;
+      if (first_bad < 0) first_bad = int(u);
+      const bool is_prev = prev && RexNativeBridgeHashWords(prev->f + u * 2, 2) == r.fetch_hash[u];
+      if (units.size() < 240) {
+        units += fmt::format(" {}{} cp {:08X} {:08X}{}", is_vf ? "vf" : "t",
+                             is_vf ? fmt::format("{}", u) : fmt::format("{}.{}", u / 3, u % 3), cw[0], cw[1],
+                             is_prev ? " =prev" : "");
+      }
+    }
+    std::string o = head + fmt::format(" | fetch units bad {}/{}:{}", nbad, nused, units);
+    if (first_bad >= 0) {
+      NativeBridgeNextCheck n;
+      n.field = kNbFFetch;
+      n.example = uint32_t(w.ex[kNbFFetch].size());
+      n.first_reg = XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + uint32_t(first_bad) * 2;
+      n.words = 2;
+      n.rec_hash = r.fetch_hash[first_bad];
+      g_nb_next.push_back(n);
+    }
+    w.ex[kNbFFetch].push_back(std::move(o));
+  }
+  if (want(kNbFState) && (r.flags & REX_NATIVE_DRAW_FLAG_STREAM_STATE)) {
+    const uint64_t known = uint64_t(r.reserved2[0]) | (uint64_t(r.reserved2[1]) << 32);
+    uint32_t cur[REX_NATIVE_STATE_REG_COUNT], words[REX_NATIVE_STATE_REG_COUNT];
+    for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) cur[i] = ((known >> i) & 1) ? regs[kRegs[i]] : 0;
+    std::string o = head + fmt::format(" | state rec {:08X} cp {:08X} known {}/64", r.reserved1,
+                                       RexNativeBridgeHashWords(cur, REX_NATIVE_STATE_REG_COUNT),
+                                       std::popcount(known));
+    if (prev) {
+      std::memcpy(words, cur, sizeof(words));
+      std::string found, changed;
+      uint32_t nchanged = 0;
+      for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+        if (!((known >> i) & 1) || prev->st[i] == cur[i]) continue;
+        if (++nchanged <= 8) changed += fmt::format(" {:04X} {:08X}->{:08X}", kRegs[i], prev->st[i], cur[i]);
+        words[i] = prev->st[i];
+        if (RexNativeBridgeHashWords(words, REX_NATIVE_STATE_REG_COUNT) == r.reserved1) {
+          found += fmt::format(" {:04X}=prev({:08X})", kRegs[i], prev->st[i]);
+        }
+        words[i] = cur[i];
+      }
+      if (found.empty() && nchanged) {
+        for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+          if ((known >> i) & 1) words[i] = prev->st[i];
+        }
+        if (RexNativeBridgeHashWords(words, REX_NATIVE_STATE_REG_COUNT) == r.reserved1) found = " all=prev";
+      }
+      o += fmt::format(" | changed since prev draw {}:{} rec matches with:{}", nchanged, changed,
+                       found.empty() ? " -" : found);
+    }
+    if (g_nb_trace.valid) {
+      // Which register, set back to its value before its last write, makes the record hash match?
+      std::memcpy(words, cur, sizeof(words));
+      std::string found;
+      uint32_t tried = 0;
+      for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+        const NativeBridgeRegWrite& bw = g_nb_trace.before[i];
+        if (!((known >> i) & 1) || !bw.valid || bw.value == cur[i]) continue;
+        ++tried;
+        words[i] = bw.value;
+        if (RexNativeBridgeHashWords(words, REX_NATIVE_STATE_REG_COUNT) == r.reserved1) {
+          found += fmt::format(" {:04X}=before-last-write({:08X}; last {})", kRegs[i], bw.value,
+                               NativeBridgeWriterText(g_nb_trace.last[i]));
+        }
+        words[i] = cur[i];
+      }
+      if (found.empty() && tried) {
+        for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+          const NativeBridgeRegWrite& bw = g_nb_trace.before[i];
+          if ((known >> i) & 1 && bw.valid) words[i] = bw.value;
+        }
+        if (RexNativeBridgeHashWords(words, REX_NATIVE_STATE_REG_COUNT) == r.reserved1) found = " all=before-last-write";
+        std::memcpy(words, cur, sizeof(words));
+      }
+      // The most recent writers of the state registers (newest first, up to 6).
+      std::string recent;
+      int order[REX_NATIVE_STATE_REG_COUNT];
+      int nrec = 0;
+      for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+        if (g_nb_trace.last[i].valid) order[nrec++] = int(i);
+      }
+      std::sort(order, order + nrec, [](int a, int b) { return g_nb_trace.last[a].address > g_nb_trace.last[b].address; });
+      for (int k = 0; k < nrec && k < 6; ++k) {
+        recent += fmt::format(" {:04X}={}", kRegs[order[k]], NativeBridgeWriterText(g_nb_trace.last[order[k]]));
+      }
+      o += fmt::format(" | trace: rec matches with:{} | last writers:{}", found.empty() ? " -" : found, recent);
+    }
+    NativeBridgeNextCheck n;
+    n.field = kNbFState;
+    n.example = uint32_t(w.ex[kNbFState].size());
+    n.rec_hash = r.reserved1;
+    n.known = known;
+    std::memcpy(n.cur, cur, sizeof(cur));
+    g_nb_next.push_back(n);
+    w.ex[kNbFState].push_back(std::move(o));
+  }
+}
