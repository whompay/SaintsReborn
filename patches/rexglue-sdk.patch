+ID3D12PipelineState* PipelineCache::GetNativePipeline(
+    D3D12Shader::D3D12Translation* vertex_shader,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    reg::RB_DEPTHCONTROL normalized_depth_control,
+    uint32_t bound_depth_and_color_render_target_bits,
+    const uint32_t* bound_depth_and_color_render_target_formats,
+    ID3D12RootSignature* root_signature, const void* vs_bytecode, size_t vs_bytecode_size,
+    uint32_t native_id) {
+  if (!vertex_shader->is_translated() || !vertex_shader->is_valid() ||
+      primitive_processing_result.IsTessellated()) {
+    return nullptr;
+  }
+  PipelineRuntimeDescription runtime_description;
+  if (!GetCurrentStateDescription(vertex_shader, nullptr, primitive_processing_result,
+                                  normalized_depth_control, 0,
+                                  bound_depth_and_color_render_target_bits,
+                                  bound_depth_and_color_render_target_formats,
+                                  runtime_description)) {
+    return nullptr;
+  }
+  if (runtime_description.geometry_shader != nullptr) {
+    return nullptr;
+  }
+  // The host shader replaces the guest vertex shader, so guest shaders that
+  // share a host shader share the pipeline (fewer pipeline switches).
+  runtime_description.description.vertex_shader_hash = 0;
+  runtime_description.description.vertex_shader_modification = 0;
+  const PipelineDescription& description = runtime_description.description;
+  uint64_t hash = XXH3_64bits(&description, sizeof(description)) ^
+                  (uint64_t(native_id) * 0x9E3779B97F4A7C15ull);
+  auto found_range = native_pipelines_.equal_range(hash);
+  for (auto it = found_range.first; it != found_range.second; ++it) {
+    if (it->second.native_id == native_id &&
+        !std::memcmp(it->second.description.data(), &description, sizeof(description))) {
+      return it->second.state;
+    }
+  }
+  runtime_description.root_signature = root_signature;
+  D3D12_SHADER_BYTECODE vs;
+  vs.pShaderBytecode = vs_bytecode;
+  vs.BytecodeLength = vs_bytecode_size;
+  native_vs_override = &vs;
+  ID3D12PipelineState* state = CreateD3D12Pipeline(runtime_description);
+  native_vs_override = nullptr;
+  NativePipeline entry;
+  entry.native_id = native_id;
+  entry.description.resize(sizeof(description));
+  std::memcpy(entry.description.data(), &description, sizeof(description));
+  entry.state = state;
+  native_pipelines_.emplace(hash, std::move(entry));
+  REXGPU_INFO("Native renderer: created pipeline {} for host shader {} ({} native pipelines)",
+              state ? "OK" : "FAILED", native_id, native_pipelines_.size());
+  return state;
+}
