+// ---------------------------------------------------------------------------
+// Native renderer (native_renderer_handoff.md)
+// ---------------------------------------------------------------------------
+
+// VS 56532B4CC70CFBA4 (Saints Row city depth-only pass, ~770 draws/frame):
+//   vfetch_full r0.xyz1, r0.x, vf0, FMT_32_32_32_FLOAT, Stride=8
+//   dp4 oPos.x, c4.zxyw, r0.zxyw  (y: c5, z: c6, w: c7)
+// Written to match the translated shader bit for bit (depth must be identical
+// to what the emulated passes drawn after it compute): Xenos dp4 = mul/add in
+// swizzled component order with the SM3 "0 * anything = 0" rule, no fused
+// multiply-add, then the same position epilogue as
+// DxbcShaderTranslator::CompleteVertexOrDomainShader.
+static const char kNativeCityDepthVS[] = R"(
+cbuffer NativeConstants : register(b0) {
+  float4 xe_c[4];      // guest float constants c4..c7
+  float4 xe_ndc_scale;
+  float4 xe_ndc_offset;
+  uint4 xe_p0;         // flags (1 W not 1/W, 2 XY/W, 4 Z/W), index endian, index offset, loop closing index
+  uint4 xe_p1;         // index min, index max, vfetch address (bytes), vfetch endian
+  uint4 xe_p2;         // vertex stride (bytes)
+};
+ByteAddressBuffer xe_shared_memory : register(t0);
+
+uint XeSwap(uint v, uint endian) {
+  if (endian == 1u || endian == 2u) {
+    v = ((v & 0x00FF00FFu) << 8u) | ((v >> 8u) & 0x00FF00FFu);
+  }
+  if (endian == 2u || endian == 3u) {
+    v = (v << 16u) | (v >> 16u);
+  }
+  return v;
+}
+
+float XeMul(float a, float b) {
+  precise float p = a * b;
+  return (min(abs(a), abs(b)) == 0.0f) ? 0.0f : p;
+}
+
+float XeDp4(float4 a, float4 b) {
+  precise float s = XeMul(a.x, b.x);
+  s = s + XeMul(a.y, b.y);
+  s = s + XeMul(a.z, b.z);
+  s = s + XeMul(a.w, b.w);
+  return s;
+}
+
+float4 main(uint vertex_id : SV_VertexID) : SV_Position {
+  uint index = vertex_id;
+  if (index == xe_p0.w) {
+    index = 0u;
+  }
+  index = XeSwap(index, xe_p0.y);
+  index = (index + xe_p0.z) & 0xFFFFFFu;
+  index = min(max(index, xe_p1.x), xe_p1.y);
+  uint address = (xe_p1.z & ~3u) + index * xe_p2.x;
+  uint3 words = xe_shared_memory.Load3(address);
+  float4 r0 = float4(asfloat(XeSwap(words.x, xe_p1.w)), asfloat(XeSwap(words.y, xe_p1.w)),
+                     asfloat(XeSwap(words.z, xe_p1.w)), 1.0f);
+  precise float4 pos;
+  pos.x = XeDp4(xe_c[0].zxyw, r0.zxyw);
+  pos.y = XeDp4(xe_c[1].zxyw, r0.zxyw);
+  pos.z = XeDp4(xe_c[2].zxyw, r0.zxyw);
+  pos.w = XeDp4(xe_c[3].zxyw, r0.zxyw);
+  uint flags = xe_p0.x;
+  if ((flags & 1u) == 0u) {
+    pos.w = 1.0f / pos.w;
+  }
+  if ((flags & 2u) != 0u) {
+    pos.xy = pos.xy * pos.ww;
+  }
+  if ((flags & 4u) != 0u) {
+    pos.z = pos.z * pos.w;
+  }
+  pos.xyz = pos.xyz * xe_ndc_scale.xyz;
+  pos.xyz = mad(xe_ndc_offset.xyz, pos.www, pos.xyz);
+  return pos;
+}
+)";
+
+uint32_t D3D12CommandProcessor::NativeShaderFor(const D3D12Shader& vertex_shader,
+                                                const D3D12Shader* pixel_shader) {
+  if (!pixel_shader) {
+    switch (vertex_shader.ucode_data_hash()) {
+      // The same depth-only program (vfetch float3 + c4..c7 transform) with
+      // different vertex strides (4..9 dwords); the stride comes from the
+      // shader's vertex binding, so they all share one host shader/pipeline.
+      case 0x56532B4CC70CFBA4ull:  // stride 8
+      case 0xE68A5DAFE68EDB9Dull:  // stride 9
+      case 0x139392D599EB4A31ull:  // stride 7
+      case 0x153C1F0F3197CCE7ull:  // stride 5
+      case 0x254CEA85F505D6CAull:  // stride 4
+        return kNativeShaderCityDepth;
+      case 0x154771C771CC1A5Cull:  // stride 6
+        return kNativeShaderCityDepth24;
+    }
+  }
+  return 0;
+}
