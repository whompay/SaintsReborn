diff --git a/src/graphics/d3d12/ps_fetch_census.h b/src/graphics/d3d12/ps_fetch_census.h
new file mode 100644
index 0000000..0f8b8ed
--- /dev/null
+++ b/src/graphics/d3d12/ps_fetch_census.h
@@ -0,0 +1,137 @@
+// AGENT_NATIVE27C (session 27): ps_fetch_census = DIAG ONLY (dist flag file 'ps_fetch_census', read once).
+// Counts, per 10 s window, how many distinct (PS ucode hash, normalised texture sign/gamma/exp tuple) combinations the
+// game draws with -> the PSO growth an exact per-draw sign/gamma specialisation of the PS tfetch code would cause.
+// Called from PipelineCache::GetCurrentPixelShaderModification (CP thread only). Reads registers only.
+// Signs per result component are derived from the raw fetch constant (dword_0 sign_x..w bits 2..9 through the
+// dword_3 swizzle bits 1..12), constant swizzle components (0/1) are "don't care". Class per fetch constant:
+//   U = every non-constant component TextureSign::kUnsigned (0), G = only kUnsigned/kGamma(3) with >= 1 gamma,
+//   B = only kUnsigned/kUnsignedBiased(2) with >= 1 biased, S = all kSigned(1), M = anything else, K = all constant.
+// exp = dword_3 exp_adjust bits 13..18 != 0.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <system_error>
+#include <unordered_set>
+
+#include <rex/graphics/register_file.h>  // AGENT_NATIVE28B: self-contained (codexTR1)
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+#include <rex/math.h>
+
+namespace rex::graphics::d3d12::ps_fetch_census {
+
+inline bool Enabled() {
+  static const bool on = [] {
+    std::error_code ec;
+    const bool e = std::filesystem::exists("ps_fetch_census", ec);
+    REXLOG_INFO("ps_fetch_census {}", e ? "ON (diag)" : "off");
+    return e;
+  }();
+  return on;
+}
+
+struct State {
+  uint64_t window_start = 0;
+  uint64_t draws = 0, draws_no_tex = 0, draws_all_u = 0, draws_all_u_or_g = 0;
+  uint64_t fetches = 0, cls[6] = {}, exp_nonzero = 0;
+  std::unordered_set<uint64_t> ps, ps_tuple, ps_class, ps_all_u;
+};
+
+inline State& GetState() {
+  static State s;
+  return s;
+}
+
+inline uint64_t Mix(uint64_t h, uint64_t v) {
+  h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+  return h;
+}
+
+// AGENT_NATIVE28B (codexTR1 defect 1): fetch-constant mask from the ucode ANALYSIS (Shader::texture_bindings(), filled by
+// AnalyzeUcode, asserted before GetCurrentPixelShaderModification) -> valid from the first draw of a shader; 0 = no texture fetches.
+template <typename ShaderT>
+inline uint32_t AnalyzedTextureMask(const ShaderT& shader) {
+  uint32_t mask = 0;
+  for (const auto& binding : shader.texture_bindings()) mask |= uint32_t(1) << (binding.fetch_constant & 31);
+  return mask;
+}
+
+// used_texture_mask: Shader::GetUsedTextureMaskAfterTranslation() (0 before the first translation of the shader, or no
+// textures; the first draw of each new shader is therefore counted as 'mask 0').
+inline void Record(const RegisterFile& regs, uint64_t ps_hash, uint32_t used_texture_mask) {
+  const bool translated = used_texture_mask != 0;
+  State& s = GetState();
+  const uint64_t now = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count());  // AGENT_NATIVE28B: no windows.h dependency
+  if (!s.window_start) s.window_start = now;
+  ++s.draws;
+  s.ps.insert(ps_hash);
+  if (!translated) {
+    ++s.draws_no_tex;
+  }
+  uint64_t tuple = ps_hash, class_tuple = ps_hash;
+  bool all_u = true, all_u_or_g = true;
+  uint32_t remaining = used_texture_mask;
+  uint32_t i;
+  while (rex::bit_scan_forward(remaining, &i)) {
+    remaining &= ~(uint32_t(1) << i);
+    const auto fetch = regs.GetTextureFetch(i);
+    const uint32_t swizzle = (fetch.dword_3 >> 1) & 0xFFF;
+    const int32_t exp_adjust = int32_t(fetch.dword_3 << (32 - 19)) >> (32 - 6);
+    uint32_t swizzled = 0, nonconst_mask = 0;
+    uint32_t n_u = 0, n_s = 0, n_b = 0, n_g = 0, n = 0;
+    for (uint32_t c = 0; c < 4; ++c) {
+      const uint32_t sw = (swizzle >> (c * 3)) & 7;
+      if (sw & 4) continue;  // constant 0 / 1
+      const uint32_t sign = (fetch.dword_0 >> (2 + sw * 2)) & 3;
+      swizzled |= sign << (c * 2);
+      nonconst_mask |= 1u << c;
+      ++n;
+      n_u += sign == 0;
+      n_s += sign == 1;
+      n_b += sign == 2;
+      n_g += sign == 3;
+    }
+    uint32_t cls;
+    if (!n) cls = 5;                              // K
+    else if (n_u == n) cls = 0;                   // U
+    else if (n_u + n_g == n) cls = 1;             // G
+    else if (n_u + n_b == n) cls = 2;             // B
+    else if (n_s == n) cls = 3;                   // S
+    else cls = 4;                                 // M
+    ++s.fetches;
+    ++s.cls[cls];
+    s.exp_nonzero += exp_adjust != 0;
+    if (!(cls == 0 || cls == 5) || exp_adjust) all_u = false;
+    if (!(cls == 0 || cls == 1 || cls == 5) || exp_adjust) all_u_or_g = false;
+    tuple = Mix(tuple, (uint64_t(i) << 40) | (uint64_t(nonconst_mask) << 32) | (uint64_t(swizzled) << 8) |
+                           uint64_t(exp_adjust != 0));
+    class_tuple = Mix(class_tuple, (uint64_t(i) << 8) | (uint64_t(cls) << 1) | uint64_t(exp_adjust != 0));
+  }
+  if (translated) {
+    s.draws_all_u += all_u;
+    s.draws_all_u_or_g += all_u_or_g;
+    s.ps_tuple.insert(tuple);
+    s.ps_class.insert(class_tuple);
+    s.ps_all_u.insert(Mix(ps_hash, all_u ? 1 : 2));
+  }
+  if (now - s.window_start >= 10000) {
+    const double sec = double(now - s.window_start) / 1000.0;
+    REXLOG_INFO(
+        "PS FETCH CENSUS {:.1f} s: draws {} (tex mask 0 {}) | distinct PS {} | (PS,full tuple) {} | (PS,class tuple) {}"
+        " | (PS,all-U bit) {} | of textured draws: all-U+exp0 {:.1f} % all-U/G+exp0 {:.1f} % | fetches {}: U {} G {} B {} S {} M {} K {} exp!=0 {}",
+        sec, s.draws, s.draws_no_tex, s.ps.size(), s.ps_tuple.size(), s.ps_class.size(),
+        s.ps_all_u.size(),
+        // AGENT_NATIVE28B (codexTR1): denominator = draws with a known (non-zero) texture mask, as the numerators.
+        s.draws > s.draws_no_tex ? 100.0 * double(s.draws_all_u) / double(s.draws - s.draws_no_tex) : 0.0,
+        s.draws > s.draws_no_tex ? 100.0 * double(s.draws_all_u_or_g) / double(s.draws - s.draws_no_tex) : 0.0, s.fetches, s.cls[0], s.cls[1], s.cls[2],
+        s.cls[3], s.cls[4], s.cls[5], s.exp_nonzero);
+    s = State();
+    s.window_start = now;
+  }
+}
+
+}  // namespace rex::graphics::d3d12::ps_fetch_census
diff --git a/src/graphics/d3d12/ps_fetch_exact.h b/src/graphics/d3d12/ps_fetch_exact.h
new file mode 100644
index 0000000..981e337
--- /dev/null
+++ b/src/graphics/d3d12/ps_fetch_exact.h
@@ -0,0 +1,53 @@
+// AGENT_NATIVE28B (session 28): ps_fetch_exact = EXACT per-draw specialisation of pixel-shader tfetch (dist flag file 'ps_fetch_exact', read once).
+// Design: claude_ipc/codex/codexTR2_exact_fetch_spec.answer.md. When EVERY kTextureFetch of the pixel shader reads a fetch constant whose
+// four raw sign fields (dword_0 bits 2..9) are all TextureSign::kUnsigned, texture_util::SwizzleSigns() of that constant is 0 for all four
+// components (non-constant components take the raw sign; constant components get kUnsigned because no component is signed), so the cache /
+// system-constant 'texture_swizzled_signs' byte the full shader branches on is all-unsigned (invalid textures are also bound as unsigned).
+// For such draws the full tfetch code always: samples only the unsigned view, never merges the signed view, and its biased/gamma switch is a
+// no-op -> the translation with Modification::pixel.texture_fetch_unsigned omits exactly that code. The exponent-adjust multiply is KEPT
+// (x * 2^exp is not provably bit-identical to x when removed: NaN/denormal float textures). LOD bias / coordinates / filtering unchanged.
+// The bit is part of the pipeline key (Modification value), so a draw gets the lite translation only when the predicate holds for it.
+// Conservative: a raw sign on a channel the swizzle does not reference also rejects (full path, still exact).
+// Cost when the flag file is absent: one static bool test per pixel-shader modification.
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <system_error>
+
+#include <rex/graphics/format/ucode.h>
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+
+namespace rex::graphics::d3d12::ps_fetch_exact {
+
+inline bool Enabled() {
+  static const bool on = [] {
+    std::error_code ec;
+    const bool e = std::filesystem::exists("ps_fetch_exact", ec);
+    REXLOG_INFO("ps_fetch_exact {}", e ? "ON (exact unsigned-only PS tfetch specialisation)" : "off");
+    return e;
+  }();
+  return on;
+}
+
+// True if the shader has at least one kTextureFetch and all of them read all-unsigned fetch constants.
+template <typename ShaderT>
+inline bool AllTextureFetchesUnsigned(const ShaderT& shader, const RegisterFile& regs) {
+  bool any = false;
+  for (const auto& binding : shader.texture_bindings()) {
+    if (binding.fetch_instr.opcode != ucode::FetchOpcode::kTextureFetch) continue;
+    any = true;
+    if ((regs.GetTextureFetch(binding.fetch_constant).dword_0 >> 2) & 0xFFu) return false;
+  }
+  return any;
+}
+
+// Call at the end of PipelineCache::GetCurrentPixelShaderModification (after the default modification is built).
+template <typename ShaderT, typename ModificationT>
+inline void Apply(const ShaderT& shader, const RegisterFile& regs, ModificationT& modification) {
+  if (Enabled() && AllTextureFetchesUnsigned(shader, regs)) modification.pixel.texture_fetch_unsigned = 1;
+}
+
+}  // namespace rex::graphics::d3d12::ps_fetch_exact
