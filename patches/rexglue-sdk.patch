+  uint32_t ndc = 0, ncm = 0;  // normalized RB_DEPTHCONTROL / colour mask of the learned draw (RT cache Update args)
+  bool rast = true;           // is_rasterization_done of the learned draw
+};
+static constexpr uint32_t kNexecSlots = 1024, kNexecProbe = 8;
+struct NexecState {
+  NexecEntry e[kNexecSlots];
+  bool on = false, verify = false;
+  uint64_t next_poll = 0;
+  uint32_t next_victim = 0;
+  // VS objects that have ever been learned (the native families: a handful). A draw whose VS is not here is not looked up
+  // (n29a: without this filter every emulated draw paid a 37-register hash, ~2300 lookups/frame at dtc for ~120 hits).
+  const void* vs_known[16] = {};
+  uint32_t vs_known_n = 0;
+  uint64_t filtered = 0;
+  // per log window
+  uint64_t lookups = 0, hits = 0, miss_none = 0, miss_stale = 0, stores = 0, evictions = 0, rt_full = 0;
+  uint64_t exec_draws = 0, exec_ticks = 0, verify_armed = 0;
+};
+static NexecState g_nexec;
+static inline uint32_t NexecHash(const void* vs, const void* ps, const uint32_t* key) {
+  uint64_t h = uint64_t(reinterpret_cast<uintptr_t>(vs)) * 0x9E3779B97F4A7C15ull ^
+               (uint64_t(reinterpret_cast<uintptr_t>(ps)) << 1);
+  for (size_t i = 0; i < kNativeFastKeyCount; ++i) {
+    h ^= key[i];
+    h *= 0x100000001B3ull;
+  }
+  h ^= h >> 31;
+  return uint32_t(h);
+}
+static void NexecPoll() {
+  const uint64_t now = GetTickCount64();
+  if (now < g_nexec.next_poll) return;
+  g_nexec.next_poll = now + 1000;
+  bool on = false, verify = false;
+  // AGENT_NATIVE30A: own flag files 'nexec' / 'nexec_verify'. n29a used 'native_exec', which ALSO switches on the
+  // 2026-10-23 MATERIAL CACHE (P5 'NATIVE EXEC 10 s' line) -> the n29a nx ABBA measured NEXEC + material cache together.
+  if (FILE* f = RexFlagFopen("nexec")) {
+    std::fclose(f);
+    on = true;
+    if (FILE* g = RexFlagFopen("nexec_verify")) {
+      std::fclose(g);
+      verify = true;
+    }
+  }
+  if (on != g_nexec.on || verify != g_nexec.verify) {
+    REXLOG_INFO("NEXEC (AGENT_NATIVE29A, native executor step 1): {}{}", on ? "ON" : "off",
+                verify ? " + VERIFY (cache-executed draws re-derived by the full path and compared)" : "");
+    ++g_nexec_inval_gen;
+  }
+  g_nexec.on = on;
+  g_nexec.verify = verify;
+}
+// Full native draw just validated nf: remember its state.
+static void NexecStore(const NativeFastState& nf, uint32_t ndc, uint32_t ncm, bool rast) {
+  NexecState& x = g_nexec;
+  const uint32_t h = NexecHash(nf.vs, nf.ps_raw, nf.key);
+  uint32_t slot = UINT32_MAX;
+  for (uint32_t p = 0; p < kNexecProbe; ++p) {
+    const uint32_t i = (h + p) & (kNexecSlots - 1);
+    const NexecEntry& e = x.e[i];
+    const bool live = e.vs && e.inval_gen == g_nexec_inval_gen && e.submission == nf.submission && e.frame == nf.frame;
+    if (!live || (e.vs == nf.vs && e.ps_raw == nf.ps_raw && !std::memcmp(e.key, nf.key, sizeof(e.key)))) {
+      slot = i;
+      break;
+    }
+  }
+  if (slot == UINT32_MAX) {
+    slot = (h + (x.next_victim++ % kNexecProbe)) & (kNexecSlots - 1);
+    ++x.evictions;
+  }
+  bool known = false;
+  for (uint32_t i = 0; i < x.vs_known_n; ++i) known |= x.vs_known[i] == nf.vs;
+  if (!known && x.vs_known_n < 16) x.vs_known[x.vs_known_n++] = nf.vs;
+  NexecEntry& e = x.e[slot];
+  e.vs = nf.vs;
+  e.ps_raw = nf.ps_raw;
+  e.submission = nf.submission;
+  e.frame = nf.frame;
+  e.inval_gen = g_nexec_inval_gen;
+  std::memcpy(e.key, nf.key, sizeof(e.key));
+  e.host_primitive_type = nf.host_primitive_type;
+  e.host_vertex_shader_type = nf.host_vertex_shader_type;
+  e.vfetch_index = nf.vfetch_index;
+  e.nc_template = nf.nc_template;
+  e.pipeline = nf.pipeline;
+  e.fused_pipeline = nf.fused_pipeline;
+  e.verify_fused_pipeline = nf.verify_fused_pipeline;
+  e.verify_plain_pipeline = nf.verify_plain_pipeline;
+  e.depth_format = nf.depth_format;
+  e.samples = nf.samples;
+  e.topology = nf.topology;
+  e.viewport = nf.viewport;
+  e.scissor = nf.scissor;
+  e.stencil_ref = nf.stencil_ref;
+  e.ndc = ndc;
+  e.ncm = ncm;
+  e.rast = rast;
+  ++x.stores;
+}
+// The 1-entry state missed: look the current draw up. true = nf now holds a live entry for (VS, PS, key) of this
+// submission (nf.valid), *ndc / *ncm / *rast = the RT cache Update arguments of the learned draw.
+static bool NexecLoad(NativeFastState& nf, const RegisterFile& regs, const void* vs, const void* ps, uint64_t submission,
+                      uint64_t frame, uint32_t* ndc, uint32_t* ncm, bool* rast) {
+  NexecState& x = g_nexec;
+  bool known = false;
+  for (uint32_t i = 0; i < x.vs_known_n && !known; ++i) known = x.vs_known[i] == vs;
+  if (!known) {
+    ++x.filtered;
+    return false;
+  }
+  ++x.lookups;
+  uint32_t key[kNativeFastKeyCount];
+  for (size_t i = 0; i < kNativeFastKeyCount; ++i) key[i] = regs[kNativeFastKeyRegs[i]];
+  const uint32_t h = NexecHash(vs, ps, key);
+  for (uint32_t p = 0; p < kNexecProbe; ++p) {
+    const NexecEntry& e = x.e[(h + p) & (kNexecSlots - 1)];
+    if (e.vs != vs || e.ps_raw != ps || std::memcmp(e.key, key, sizeof(key))) continue;
+    if (e.inval_gen != g_nexec_inval_gen || e.submission != submission || e.frame != frame) {
+      ++x.miss_stale;
+      return false;
+    }
+    nf.vs = e.vs;
+    nf.ps_raw = e.ps_raw;
+    nf.submission = e.submission;
+    nf.frame = e.frame;
+    std::memcpy(nf.key, e.key, sizeof(nf.key));
+    nf.host_primitive_type = e.host_primitive_type;
+    nf.host_vertex_shader_type = e.host_vertex_shader_type;
+    nf.vfetch_index = e.vfetch_index;
+    nf.nc_template = e.nc_template;
+    nf.pipeline = e.pipeline;
+    nf.fused_pipeline = e.fused_pipeline;
+    nf.verify_fused_pipeline = e.verify_fused_pipeline;
+    nf.verify_plain_pipeline = e.verify_plain_pipeline;
+    nf.depth_format = e.depth_format;
+    nf.samples = e.samples;
+    nf.topology = e.topology;
+    nf.viewport = e.viewport;
+    nf.scissor = e.scissor;
+    nf.stencil_ref = e.stencil_ref;
+    nf.valid = true;
+    *ndc = e.ndc;
+    *ncm = e.ncm;
+    *rast = e.rast;
+    ++x.hits;
+    return true;
+  }
+  ++x.miss_none;
+  return false;
+}
+static bool NativeFastVerify() {
+  static uint64_t next = 0;
+  static bool on = false;
+  const uint64_t now = GetTickCount64();
+  if (now >= next) {
+    next = now + 1000;
+    FILE* f = RexFlagFopen("native_fast_verify");
+    on = f != nullptr;
+    if (f) std::fclose(f);
+  }
+  return on;
+}
+// gpu_timing_draws (AGENT_NATIVE24A, diag, dist file; needs gpu_timing): draw GPU time split into
+// sub-categories 0xC0..0xEF that fold back into 'draws' / 'depth-only draws' (totals unchanged). v2 (18:50):
+// 0..14 depth-only draws by RB_DEPTHCONTROL value, 15 depth other, 16 native fast / fused depth draws,
+// 17 colour draws > 6 indices (scene), 18 the same with blending, 19 colour MSAA,
+// 32..46 colour draws <= 6 indices (rectangles / fullscreen passes) by (VS, PS) pair, 47 other small.
+// Tables restart every log period (2 s) so the bench window is not hidden by startup values (a few in-flight
+// frames may be attributed to the new table: diag only). Log 'GPU DRAW SPLIT per frame'.
+struct GpuDrawSplit {
+  bool on = false;
+  uint64_t next_check = 0;
+  uint32_t dc_values[15] = {};
+  uint32_t dc_count = 0;
+  uint64_t small_key[15] = {};  // PS hash ^ VS hash
+  uint64_t small_ps[15] = {}, small_vs[15] = {};
+  uint32_t small_rt[15] = {};  // RB_SURFACE_INFO
+  uint32_t small_rtfmt[15] = {};  // RB_COLOR_INFO
+  uint32_t small_dc[15] = {};     // depth-only rect (3..6 vertices): RB_DEPTHCONTROL | 1 << 31 marks depth-only (n26a)
+  uint32_t small_count = 0;
+  // 20..30: colour scene draws (> 6 indices) by key (NATIVE25A, request 25B): blend0 | alpha test << 32 | kill << 33,
+  // or the PS hash with dist gpu_timing_draws_ps. A window tracks 11 keys starting at a rotating ordinal of the keys
+  // in draw order (the rest stay in 17 / 18), so successive 2 s windows cover different keys.
+  bool scene_by_ps = false;
+  std::unordered_map<uint64_t, uint8_t> scene_map;
+  uint64_t scene_ps[11] = {};
+  uint32_t scene_blend[11] = {};
+  uint8_t scene_at[11] = {}, scene_kill[11] = {};
+  // n26a: depth control low byte | alpha func << 8 | alpha ref (float bits >> 16) << 11 (non-PS key only)
+  uint64_t scene_extra[11] = {};
+  uint32_t scene_count = 0, scene_skip = 0;
+  double sec[48] = {};
+  uint64_t draws[48] = {}, indices[48] = {};
+};
+static GpuDrawSplit g_gds;
+static bool GpuDrawSplitOn() {
+  const uint64_t now = GetTickCount64();
+  if (now >= g_gds.next_check) {
+    g_gds.next_check = now + 1000;
+    FILE* f = RexFlagFopen("gpu_timing_draws");
+    g_gds.on = f != nullptr;
+    if (f) std::fclose(f);
+    f = RexFlagFopen("gpu_timing_draws_ps");
+    g_gds.scene_by_ps = f != nullptr;
+    if (f) std::fclose(f);
+  }
+  return g_gds.on;
+}
+static uint8_t GpuDrawSplitSub(bool depth_only, uint32_t depthcontrol, uint32_t blend0, bool msaa,
+                               uint32_t index_count, uint64_t vs_hash, uint64_t ps_hash, uint32_t surface_info,
+                               uint32_t color_info, bool alpha_test, bool kills, uint64_t scene_extra = 0) {
+  if (depth_only && index_count >= 3 && index_count <= 6) {  // depth-only rectangles by (VS, PS) (n26a)
+    const uint64_t key = ps_hash ^ (vs_hash * 0x9E3779B97F4A7C15ull) ^ (uint64_t(depthcontrol) << 1) ^ 1;
+    for (uint32_t i = 0; i < g_gds.small_count; ++i) {
+      if (g_gds.small_key[i] == key) return uint8_t(32 + i);
+    }
+    if (g_gds.small_count < 15) {
+      const uint32_t i = g_gds.small_count++;
+      g_gds.small_key[i] = key;
+      g_gds.small_ps[i] = ps_hash;
+      g_gds.small_vs[i] = vs_hash;
+      g_gds.small_rt[i] = surface_info;
+      g_gds.small_rtfmt[i] = color_info;
+      g_gds.small_dc[i] = depthcontrol | 0x80000000u;
+      return uint8_t(32 + i);
+    }
+    return 15;
+  }
+  if (depth_only) {
+    for (uint32_t i = 0; i < g_gds.dc_count; ++i) {
+      if (g_gds.dc_values[i] == depthcontrol) return uint8_t(i);
+    }
+    if (g_gds.dc_count < 15) {
+      g_gds.dc_values[g_gds.dc_count] = depthcontrol;
+      return uint8_t(g_gds.dc_count++);
+    }
+    return 15;
+  }
+  if (msaa) return 19;
+  if (index_count > 6) {
+    const uint64_t key = g_gds.scene_by_ps
+                             ? ps_hash
+                             : (uint64_t(blend0) | (uint64_t(alpha_test) << 32) | (uint64_t(kills) << 33) |
+                                (scene_extra << 34));
+    auto it = g_gds.scene_map.find(key);
+    if (it != g_gds.scene_map.end()) return it->second;
+    uint8_t slot = blend0 != 0x00010001u ? 18 : 17;
+    if (g_gds.scene_map.size() >= g_gds.scene_skip && g_gds.scene_count < 11) {
+      const uint32_t i = g_gds.scene_count++;
+      g_gds.scene_ps[i] = ps_hash;
+      g_gds.scene_blend[i] = blend0;
+      g_gds.scene_at[i] = alpha_test;
+      g_gds.scene_kill[i] = kills;
+      g_gds.scene_extra[i] = scene_extra;
+      slot = uint8_t(20 + i);
+    }
+    g_gds.scene_map.emplace(key, slot);
+    return slot;
+  }
+  const uint64_t key = ps_hash ^ (vs_hash * 0x9E3779B97F4A7C15ull);
+  for (uint32_t i = 0; i < g_gds.small_count; ++i) {
+    if (g_gds.small_key[i] == key) return uint8_t(32 + i);
+  }
+  if (g_gds.small_count < 15) {
+    const uint32_t i = g_gds.small_count++;
+    g_gds.small_key[i] = key;
+    g_gds.small_ps[i] = ps_hash;
+    g_gds.small_vs[i] = vs_hash;
+    g_gds.small_rt[i] = surface_info;
+    g_gds.small_rtfmt[i] = color_info;
+    g_gds.small_dc[i] = 0;
+    return uint8_t(32 + i);
+  }
+  return 47;
+}
+
+static bool NativeFastOff() {
+  static uint64_t next = 0;
+  static bool off = false;
+  const uint64_t now = GetTickCount64();
+  if (now >= next) {
+    next = now + 1000;
+    FILE* f = RexFlagFopen("native_fast_off");
+    off = f != nullptr;
+    if (f) std::fclose(f);
+  }
+  return off;
+}
