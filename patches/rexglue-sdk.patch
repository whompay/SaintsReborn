+void D3D12CommandProcessor::InitializeGpuTimer() {
+  gpu_timer_enabled_ = false;
+  if (FILE* f = std::fopen("gpu_timing", "rb")) {
+    std::fclose(f);
+  } else {
+    return;
+  }
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  ID3D12CommandQueue* queue = GetD3D12Provider().GetDirectQueue();
+  if (!device || !queue || FAILED(queue->GetTimestampFrequency(&gpu_timer_frequency_)) ||
+      !gpu_timer_frequency_) {
+    return;
+  }
+  D3D12_QUERY_HEAP_DESC heap_desc = {};
+  heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  heap_desc.Count = kGpuTimerQueries;
+  if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&gpu_timer_heap_)))) {
+    return;
+  }
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buffer_desc, sizeof(uint64_t) * kGpuTimerQueries,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                             GetD3D12Provider().GetHeapFlagCreateNotZeroed(),
+                                             &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&gpu_timer_readback_)))) {
+    gpu_timer_heap_.Reset();
+    return;
+  }
+  D3D12_RANGE read_range = {0, sizeof(uint64_t) * kGpuTimerQueries};
+  void* mapping = nullptr;
+  if (FAILED(gpu_timer_readback_->Map(0, &read_range, &mapping))) {
+    gpu_timer_readback_.Reset();
+    gpu_timer_heap_.Reset();
+    return;
+  }
+  gpu_timer_mapping_ = reinterpret_cast<uint64_t*>(mapping);
+  gpu_timer_enabled_ = true;
+  REXLOG_INFO("GPU timing enabled (timestamp frequency {})", gpu_timer_frequency_);
+}
+
+void D3D12CommandProcessor::GpuTimerWrite() {
+  deferred_command_list_.D3DEndQuery(gpu_timer_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     gpu_timer_cursor_++);
+  gpu_timer_intervals_.push_back(gpu_timer_category_);
+}
+
+uint8_t D3D12CommandProcessor::GpuTimerSwitch(uint8_t category) {
+  const uint8_t previous = gpu_timer_category_;
+  if (category == previous) return previous;
+  gpu_timer_category_ = category;
+  if (gpu_timer_enabled_ && submission_open_ &&
+      gpu_timer_cursor_ - gpu_timer_start_ < kGpuTimerMaxPerSubmission - 1) {
+    GpuTimerWrite();
+  }
+  return previous;
+}
+
+void D3D12CommandProcessor::GpuTimerBeginSubmission() {
+  if (!gpu_timer_enabled_) return;
+  if (gpu_timer_cursor_ + kGpuTimerMaxPerSubmission > kGpuTimerQueries) gpu_timer_cursor_ = 0;
+  gpu_timer_start_ = gpu_timer_cursor_;
+  gpu_timer_intervals_.clear();
+  GpuTimerWrite();
+}
+
+void D3D12CommandProcessor::GpuTimerEndSubmission() {
+  if (!gpu_timer_enabled_ || gpu_timer_intervals_.empty()) return;
+  GpuTimerWrite();
+  const uint32_t count = gpu_timer_cursor_ - gpu_timer_start_;
+  deferred_command_list_.D3DResolveQueryData(gpu_timer_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                             gpu_timer_start_, count, gpu_timer_readback_.Get(),
+                                             sizeof(uint64_t) * gpu_timer_start_);
+  gpu_timer_pending_.push_back({submission_current_, gpu_timer_start_, gpu_timer_intervals_});
+  gpu_timer_intervals_.clear();
+}
+
+void D3D12CommandProcessor::PollGpuTimer() {
+  if (!gpu_timer_enabled_) return;
+  while (!gpu_timer_pending_.empty() && gpu_timer_pending_.front().submission <= submission_completed_) {
+    const GpuTimerSubmission& s = gpu_timer_pending_.front();
+    for (size_t i = 0; i + 1 < s.intervals.size(); ++i) {
+      const uint64_t a = gpu_timer_mapping_[s.start + i], b = gpu_timer_mapping_[s.start + i + 1];
+      if (b > a && s.intervals[i] < kGpuTimeCategoryCount) {
+        gpu_timer_seconds_[s.intervals[i]] += double(b - a) / double(gpu_timer_frequency_);
+      }
+    }
+    gpu_timer_pending_.pop_front();
+  }
+  const uint64_t now = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                    std::chrono::steady_clock::now().time_since_epoch())
+                                    .count());
+  if (!gpu_timer_last_log_) gpu_timer_last_log_ = now;
+  if (now - gpu_timer_last_log_ >= 2000 && gpu_timer_frames_) {
+    const double f = 1000.0 / double(gpu_timer_frames_);
+    double total = 0;
+    for (double v : gpu_timer_seconds_) total += v;
+    REXLOG_INFO(
+        "GPU TIME per frame: total {:.2f} ms | draws {:.2f} | render target transfers {:.2f} | "
+        "texture loads {:.2f} | resolves {:.2f} | uploads {:.2f} | swap {:.2f} ({} frames) | per "
+        "frame: {} draws, {} barriers in {} batches, {} uploads ({} KB)",
+        total * f, gpu_timer_seconds_[kGpuTimeDraw] * f,
+        gpu_timer_seconds_[kGpuTimeRenderTargetTransfer] * f,
+        gpu_timer_seconds_[kGpuTimeTextureLoad] * f, gpu_timer_seconds_[kGpuTimeResolve] * f,
+        gpu_timer_seconds_[kGpuTimeUpload] * f, gpu_timer_seconds_[kGpuTimeSwap] * f,
+        gpu_timer_frames_, gpu_count_draws_ / gpu_timer_frames_,
+        gpu_count_barriers_ / gpu_timer_frames_, gpu_count_barrier_batches_ / gpu_timer_frames_,
+        gpu_count_uploads_ / gpu_timer_frames_, gpu_count_upload_bytes_ / 1024 / gpu_timer_frames_);
+    gpu_count_draws_ = gpu_count_barriers_ = gpu_count_barrier_batches_ = gpu_count_uploads_ =
+        gpu_count_upload_bytes_ = 0;
+    for (double& v : gpu_timer_seconds_) v = 0;
+    gpu_timer_frames_ = 0;
+    gpu_timer_last_log_ = now;
+  }
+}
