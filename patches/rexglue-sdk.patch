+// XInviteSend for the game exe (its wrapper sub_8265BBC0 is replaced there,
+// project/src/online_players.cpp): user, invitee count, XUID array (guest),
+// XOVERLAPPED (guest, may be 0). Returns what XInviteSend returns.
+extern "C" __declspec(dllexport) uint32_t SrLiveInviteSend(uint32_t user, uint32_t count, uint32_t xuids_ptr,
+                                                           uint32_t overlapped_ptr) {
+  auto* ks = REX_KERNEL_STATE();
+  if (!ks) return 1627;  // ERROR_FUNCTION_FAILED
+  std::vector<uint64_t> xuids;
+  if (xuids_ptr) {
+    auto* p = ks->memory()->TranslateVirtual<uint8_t*>(xuids_ptr);
+    for (uint32_t i = 0; i < count && i < 16; ++i) xuids.push_back(rex::memory::load_and_swap<uint64_t>(p + i * 8));
