+static void NativeBridgeMaybeLog() {
+  if (!NativeBridgeEnabled()) return;
+  const uint64_t now = GetTickCount64();
+  std::lock_guard<std::mutex> lock(g_native_bridge.mutex);
+  NativeMarkerOnSwap();
+  NativeOwnOnSwap();  // AGENT_NATIVE30A2
+  if (now < g_native_bridge.last_log_tick + 10000) return;
+  NativeOwnLog(g_native_bridge.last_log_tick ? double(now - g_native_bridge.last_log_tick) / 1000.0 : 10.0);
+  g_native_bridge.last_log_tick = now;
+  NativeBridgeWindow& w = g_native_bridge.w;
+  std::string classes, paths;
+  for (uint32_t c = 0; c < kNbClassCount; ++c) {
+    classes += fmt::format(" {} {}/{} (no key {} no record {})", kNbClassName[c], w.matched[c], w.cp_draws[c],
+                           w.no_key[c], w.no_record[c]);
+  }
+  for (uint32_t p = 1; p < REX_NATIVE_PATH_COUNT; ++p) {
+    paths += fmt::format(" {}:{}/{}/{}", p, w.submitted_path[p], w.matched_path[p], w.stale_path[p]);
+  }
+  std::string fields;
+  for (uint32_t f = 0; f < kNbFieldCount; ++f) {
+    fields += fmt::format("{}{}", f ? "/" : "", w.field_mismatch[f]);
+  }
+  // REXLOG (core), not REXGPU: the gpu log category is filtered out at info level.
+  REXLOG_INFO(
+      "NATIVE BRIDGE verify v2 (10 s): records {} (no packet {}, v1 {}) pending {} | CP matched/draws:{} | "
+      "exact {} | field mismatches prim/count/ib/base/shader/rt/vsc/psc/fetch/state {} | const groups vs {}/{} ps {}/{} "
+      "fetch units {}/{} bad/checked | addr reuse {} offset hits 0/-1000/+1000 {}/{}/{} | per path "
+      "submitted/matched/stale:{} | rejected size {} version {} flags {} full {}",
+      w.submitted, w.submitted_no_packet, w.v1_records, g_native_bridge.pending_count, classes, w.exact, fields,
+      w.vs_groups_bad, w.vs_groups, w.ps_groups_bad, w.ps_groups, w.fetch_units_bad, w.fetch_units, w.addr_reuse,
+      w.addr_offset_hits[0], w.addr_offset_hits[1], w.addr_offset_hits[2], paths, w.bad_size, w.bad_version,
+      w.bad_flags, w.dropped_full);
+  if (g_nb_dry.load(std::memory_order_relaxed)) {
+    REXLOG_INFO("NATIVE EXEC dry (M3b step 1: records taken at IssueDraw, nothing compared or drawn natively): taken {} "
+                "with values {} full 64-reg state {} draw header bad {} | masks published {} (keys {})",
+                w.dry_taken, w.dry_with_values, w.dry_full_state, w.dry_hdr_bad, w.dry_masks_published,
+                g_nb_dry_masks.size());
+  }
+  {
+    // Float-constant groups (4 constants each) that differ most often on matched main-pass draws.
+    auto top = [](const uint32_t* bad, const uint32_t* checked) {
+      std::string o;
+      for (int n = 0; n < 16; ++n) {
+        int best = -1;
+        for (int g = 0; g < 64; ++g) {
+          if (bad[g] && (best < 0 || bad[g] > bad[best])) best = g;
+        }
+        if (best < 0) break;
+        o += fmt::format(" c{}-{}:{}/{}", best * 4, best * 4 + 3, bad[best], checked[best]);
+        const_cast<uint32_t*>(bad)[best] = 0;
+      }
+      return o;
+    };
+    REXLOG_INFO("NATIVE BRIDGE main-pass const groups (bad/checked): matched with state {} only-const-bad {} | vs:{} | ps:{}",
+                w.main_matched_state, w.main_const_only_bad, top(w.vs_g_bad, w.vs_g_checked),
+                top(w.ps_g_bad, w.ps_g_checked));
+    REXLOG_INFO("NATIVE BRIDGE M3 render state (64 regs from the game's stream mirror): checked {} bad {} | known regs "
+                "avg {:.1f}/64, all 64 known {} | main-pass draws with stream state {} fully exact {}",
+                w.state_checked, w.state_bad,
+                w.state_checked ? double(w.state_known_regs) / double(w.state_checked) : 0.0, w.state_full,
+                w.main_with_state, w.main_exact_all);
+  }
+  if (!w.examples_unmatched.empty()) REXLOG_INFO("NATIVE BRIDGE unmatched CP draws:{}", w.examples_unmatched);
+  if (!w.examples_field.empty()) REXLOG_INFO("NATIVE BRIDGE field mismatches:{}", w.examples_field);
+  if (!w.examples_stale.empty()) REXLOG_INFO("NATIVE BRIDGE stale records:{}", w.examples_stale);
+  for (uint32_t f = kNbFRt; f <= kNbFState; ++f) {
+    if (w.ex[f].empty()) continue;
+    std::string o;
+    for (const std::string& e : w.ex[f]) o += " [" + e + "]";
+    REXLOG_INFO("NATIVE BRIDGE {} mismatch examples (cp = register file at IssueDraw):{}", kNbFieldName[f], o);
+  }
+  REXLOG_INFO("NATIVE BRIDGE record v3: records {} with values {} (words {}) without values {} stale masks {} over "
+              "budget {} rejected {} value/hash disagreements {} | draw header checked {} bad {} predicate bad {}{} | "
+              "const masks published {} table full {} queries {} hits {} | batches {} (records {})",
+              w.v3_records, w.v3_with_values, w.v3_value_words, w.v3_no_values, w.v3_stale_masks, w.v3_dropped_bytes,
+              w.v3_bad, w.v3_hash_bad_groups, w.hdr_checked, w.hdr_bad, w.hdr_pred_bad, w.hdr_examples,
+              g_nb_mask_published.load(std::memory_order_relaxed), g_nb_mask_full.load(std::memory_order_relaxed),
+              g_nb_mask_queries.load(std::memory_order_relaxed), g_nb_mask_hits.load(std::memory_order_relaxed),
+              w.v3_batches, w.v3_batch_records);
+  {
+    NativeMarkerWindow& mw = g_native_bridge.mw;
+    std::string fb;
+    for (uint32_t f = 0; f < kNbFieldCount; ++f) fb += fmt::format("{}{}", f ? "/" : "", mw.field_bad[f]);
+    REXLOG_INFO("NATIVE EXEC M3b markers (verify, nothing drawn natively): records submitted {} refused owned {} "
+                "novalues {} stale {} state {} header {} full {} bad {} | live {} | markers {} id hit {} miss {} "
+                "replays {} predicate bad {} marker without draw {} | refer-back checked {} other draw {} no draw {} | draws checked {} record exact {} field "
+                "bad prim/count/ib/base/shader/rt/vsc/psc/fetch/state {} | entry at marker ready {} missing {} same "
+                "as the draw's {} other {} | retired {} expired {}{}",
+                mw.submitted, mw.owned_refused, mw.refused_novalues, mw.refused_stale, mw.refused_state,
+                mw.refused_header, mw.refused_full, mw.refused_bad, g_native_bridge.markers.size(), mw.markers,
+                mw.id_hit, mw.id_miss, mw.replays, mw.pred_bad, mw.marker_no_draw, mw.back_checked, mw.back_other_draw,
+                mw.back_no_draw, mw.draws_after, mw.exact, fb,
+                mw.entry_ready, mw.entry_missing, mw.entry_same, mw.entry_other, mw.retired, mw.expired, mw.examples);
+    mw = NativeMarkerWindow{};
+  }
+  {
+    std::string ex;
+    const uint32_t ne = std::min<uint32_t>(4, rex::graphics::g_native_alu_src_example_n.load(std::memory_order_relaxed));
+    for (uint32_t e = 0; e < ne; ++e) {
+      const uint32_t sz = rex::graphics::g_native_alu_src_example[e][1].load(std::memory_order_relaxed);
+      ex += fmt::format(" [type {} src {:08X} size {} index {}]",
+                        rex::graphics::g_native_alu_src_example[e][2].load(std::memory_order_relaxed),
+                        rex::graphics::g_native_alu_src_example[e][0].load(std::memory_order_relaxed), sz & 0xFFFF,
+                        sz >> 16);
+    }
+    auto ld = [](std::atomic<uint64_t>& a) { return a.exchange(0, std::memory_order_relaxed); };
+    std::string per;
+    static const char* const kAluType[5] = {"alu", "fetch", "bool", "loop", "regs"};
+    for (uint32_t t = 0; t < 5; ++t) {
+      per += fmt::format(" {} {}/{}", kAluType[t], ld(rex::graphics::g_native_alu_src_changed[t]),
+                         ld(rex::graphics::g_native_alu_src_checked[t]));
+    }
+    rex::graphics::g_native_alu_src_example_n.store(0, std::memory_order_relaxed);
+    REXLOG_INFO("NATIVE BRIDGE LOAD_ALU_CONSTANT source changed between submit and execution (changed/checked):{} | "
+                "not in the submit scan {} | packets traced {}{}",
+                per, ld(rex::graphics::g_native_alu_src_unknown), g_nb_trace.packets, ex);
+    g_nb_trace.packets = 0;
+  }
+  if (w.v4_batches || w.v4_records) {
+    std::string per, regs_bad;
+    for (uint32_t c = 0; c < kNbClassCount; ++c) {
+      per += fmt::format(" {} {}/{} (self-sufficient {}/{})", kNbClassName[c], w.v4_exact[c], w.v4_checked[c],
+                         w.v4_self_exact[c], w.v4_self_checked[c]);
+    }
+    static constexpr uint32_t kRegs[REX_NATIVE_STATE_REG_COUNT] = {REX_NATIVE_STATE_REGS};
+    for (uint32_t i = 0; i < REX_NATIVE_STATE_REG_COUNT; ++i) {
+      if (w.v4_reg_bad[i]) regs_bad += fmt::format(" {:04X}:{}", kRegs[i], w.v4_reg_bad[i]);
+    }
+    REXLOG_INFO("NATIVE CAPTURE V4 VERIFY (AGENT_NATIVE29A, 10 s): batches {} records v4 {} (REG_VALUES {}, "
+                "SELF_SUFFICIENT {}) malformed {} | exact/checked per class:{} | state checked {} draws bad {} (regs {}){} "
+                "| fetch units checked {} bad {} | coverage gaps: fetch {} const {} (self-sufficient incomplete {}) | "
+                "draw header bad {}{}",
+                w.v4_batches, w.v4_records, w.v4_reg_values, w.v4_self, w.v4_bad, per, w.v4_state_checked,
+                w.v4_state_bad_draws, w.v4_state_bad_regs, regs_bad.empty() ? "" : " by reg:" + regs_bad,
+                w.v4_fetch_units, w.v4_fetch_units_bad, w.v4_fetch_missing, w.v4_const_missing, w.v4_self_incomplete,
+                w.v4_draw_packet_bad, w.v4_examples.empty() ? "" : " | examples:" + w.v4_examples);
+  }
+  g_nb_next.clear();
+  w = NativeBridgeWindow{};
+}
