+// ---------------------------------------------------------------------------
+// Modern Look (see command_processor.h)
+// ---------------------------------------------------------------------------
+
+namespace {
+// Set by a mod through WML set_look (RexLookSettings). Empty = off.
+//  0 sharpen (0-1)        1 bloom strength       2 bloom threshold (0-1)  3 exposure (stops)
+//  4 contrast (1 = same)  5 saturation (1 = same) 6 vibrance              7 filmic curve (0-1)
+//  8 temperature (-1..1)  9 tint (-1..1)        10 vignette (0-1)       11 black level (0-0.2)
+// 12 FXAA (0/1)
+std::mutex g_look_mutex;
+std::vector<float> g_look;
+constexpr size_t kLookParams = 13;
+}  // namespace
+
+static const char kLookShader[] = R"(
+cbuffer LookConstants : register(b0) {
+  uint2 size;
+  uint2 bloom_size;
+  float4 p0;  // sharpen, bloom, bloom threshold, exposure
+  float4 p1;  // contrast, saturation, vibrance, filmic
+  float4 p2;  // temperature, tint, vignette, black level
+  float4 p3;  // x = blur step (bloom texels)
+};
+Texture2D<float4> src0 : register(t0);
+Texture2D<float4> src1 : register(t1);
+RWTexture2D<float4> dst : register(u0);
+SamplerState lin_clamp : register(s0);
+
+float3 ToLinear(float3 c) { return pow(max(c, 0.0), 2.2); }
+float3 ToGamma(float3 c) { return pow(max(c, 0.0), 1.0 / 2.2); }
+float Luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }
+
+// Bright parts of the frame at a quarter of its size.
+[numthreads(8, 8, 1)] void bright_cs(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= bloom_size)) return;
+  float2 uv = (float2(id.xy) + 0.5) / float2(bloom_size);
+  float2 px = 1.0 / float2(size);
+  float3 c = ToLinear(src0.SampleLevel(lin_clamp, uv + px * float2(-1, -1), 0).rgb) +
+             ToLinear(src0.SampleLevel(lin_clamp, uv + px * float2(1, -1), 0).rgb) +
+             ToLinear(src0.SampleLevel(lin_clamp, uv + px * float2(-1, 1), 0).rgb) +
+             ToLinear(src0.SampleLevel(lin_clamp, uv + px * float2(1, 1), 0).rgb);
+  c *= 0.25;
+  float k = saturate((Luma(c) - p0.z) / max(1.0 - p0.z, 1e-3));
+  dst[id.xy] = float4(c * k * k, 1.0);
+}
+
+// Soft blur of the bright parts (run twice with a growing step).
+[numthreads(8, 8, 1)] void blur_cs(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= bloom_size)) return;
+  float2 t = p3.x / float2(bloom_size);
+  float2 uv = (float2(id.xy) + 0.5) / float2(bloom_size);
+  float3 c = src0.SampleLevel(lin_clamp, uv, 0).rgb * 0.16;
+  static const float2 ring[8] = {float2(1, 0), float2(-1, 0), float2(0, 1), float2(0, -1),
+                                 float2(0.7071, 0.7071), float2(-0.7071, 0.7071),
+                                 float2(0.7071, -0.7071), float2(-0.7071, -0.7071)};
+  [unroll] for (int i = 0; i < 8; ++i) {
+    c += src0.SampleLevel(lin_clamp, uv + ring[i] * t * 1.2, 0).rgb * 0.065;
+    c += src0.SampleLevel(lin_clamp, uv + ring[i] * t * 2.8, 0).rgb * 0.04;
+  }
+  dst[id.xy] = float4(c, 1.0);
+}
+
+float3 Shoulder(float3 x) {
+  // Leaves everything below 0.8 alone and rolls the rest off towards 1.
+  float3 over = max(x - 0.8, 0.0);
+  return min(x, 0.8) + 0.2 * (1.0 - exp(-over / 0.2));
+}
+
+[numthreads(8, 8, 1)] void final_cs(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= size)) return;
+  int2 p = int2(id.xy);
+  int2 lim = int2(size) - 1;
+  float3 c = src0[p].rgb;
+  // Contrast-adaptive sharpening (after AMD's CAS idea): strongest on soft
+  // edges, weaker where the image already has contrast.
+  if (p0.x > 0.0) {
+    float3 n = src0[clamp(p + int2(0, -1), 0, lim)].rgb, s = src0[clamp(p + int2(0, 1), 0, lim)].rgb;
+    float3 e = src0[clamp(p + int2(1, 0), 0, lim)].rgb, w = src0[clamp(p + int2(-1, 0), 0, lim)].rgb;
+    float3 mn = min(c, min(min(n, s), min(e, w))), mx = max(c, max(max(n, s), max(e, w)));
+    float3 amp = sqrt(saturate(min(mn, 1.0 - mx) / max(mx, 1e-4)));
+    float3 wgt = amp * (-1.0 / lerp(8.0, 4.5, saturate(p0.x)));
+    c = saturate((c + (n + s + e + w) * wgt) / (1.0 + 4.0 * wgt));
+  }
+  float2 uv = (float2(id.xy) + 0.5) / float2(size);
+  float3 l = ToLinear(c) * exp2(p0.w);
+  if (p0.y > 0.0) l += src1.SampleLevel(lin_clamp, uv, 0).rgb * p0.y;  // (unused buffer when off)
+  // White balance: warmer (+) or cooler (-), tint towards magenta (+) or green (-).
+  l *= float3(1.0 + 0.08 * p2.x, 1.0 - 0.05 * p2.y, 1.0 - 0.08 * p2.x);
+  // Saturation, then vibrance (lifts dull colours more than strong ones).
+  float y = Luma(l);
+  l = lerp(y.xxx, l, p1.y);
+  float sat = (max(l.r, max(l.g, l.b)) - min(l.r, min(l.g, l.b))) / max(max(l.r, max(l.g, l.b)), 1e-4);
+  l = lerp(Luma(l).xxx, l, 1.0 + p1.z * (1.0 - sat));
+  l = Shoulder(max(l, 0.0));
+  // Deeper blacks.
+  l = max(l - p2.w, 0.0) / (1.0 - p2.w);
+  float3 g = ToGamma(l);
+  // Filmic curve and contrast around a pivot a little below middle grey. The
+  // game's shadows are already dark, so the dark side is barely touched (a
+  // tenth of the curve, 30 % of the contrast); the extra punch goes into the
+  // bright side.
+  const float pv = 0.42;
+  float a_hi = 1.0 + 0.6 * p1.w, a_lo = 1.0 + 0.1 * p1.w;
+  float3 lo = pv * pow(saturate(g) / pv, a_lo);
+  float3 hi = 1.0 - (1.0 - pv) * pow(saturate(1.0 - g) / (1.0 - pv), a_hi);
+  g = (g < pv) ? lo : hi;
+  float3 k = (g < pv) ? (1.0 + (p1.x - 1.0) * 0.3) : p1.x;
+  g = saturate(pv + (g - pv) * k);
+  // Vignette.
+  float2 d = (uv - 0.5) * float2(float(size.x) / float(size.y), 1.0);
+  g *= 1.0 - p2.z * smoothstep(0.45, 1.05, length(d) * 1.35);
+  dst[p] = float4(g, 1.0);
+}
+)";
+
+bool D3D12CommandProcessor::LookWantsFxaa() {
+  std::lock_guard<std::mutex> lock(g_look_mutex);
+  return g_look.size() > 12 && g_look[12] > 0.5f;
+}
+
+bool D3D12CommandProcessor::LookInitialize() {
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile"))
+               : nullptr;
+  if (!compile) {
+    REXGPU_ERROR("Modern look: d3dcompiler_47.dll / D3DCompile not available");
+    return false;
+  }
+  // Root signature: constants (b0), destination (u0), two sources (t0, t1), linear clamp sampler.
+  D3D12_DESCRIPTOR_RANGE ranges[3] = {};
+  ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  ranges[0].NumDescriptors = 1;
+  ranges[0].BaseShaderRegister = 0;
+  ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[1].NumDescriptors = 1;
+  ranges[1].BaseShaderRegister = 0;
+  ranges[2].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[2].NumDescriptors = 1;
+  ranges[2].BaseShaderRegister = 1;
+  D3D12_ROOT_PARAMETER params[4] = {};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants.ShaderRegister = 0;
+  params[0].Constants.Num32BitValues = 20;
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  for (int i = 0; i < 3; ++i) {
+    params[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+    params[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    params[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_STATIC_SAMPLER_DESC sampler = {};
+  sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+  sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.MaxLOD = 0.0f;
+  sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+  sampler.ShaderRegister = 0;
+  sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 4;
+  desc.pParameters = params;
+  desc.NumStaticSamplers = 1;
+  desc.pStaticSamplers = &sampler;
+  look_root_signature_.Attach(ui::d3d12::util::CreateRootSignature(GetD3D12Provider(), desc));
+  if (!look_root_signature_) {
+    REXGPU_ERROR("Modern look: failed to create the root signature");
+    return false;
+  }
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  auto build = [&](const char* entry, Microsoft::WRL::ComPtr<ID3D12PipelineState>& out) {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(kLookShader, sizeof(kLookShader) - 1, "modern_look", nullptr, nullptr, entry,
+                         "cs_5_1", 1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXGPU_ERROR("Modern look: {} compiler output: {}", entry,
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()),
+                               errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) {
+      REXGPU_ERROR("Modern look: failed to compile {} (0x{:08X})", entry, uint32_t(hr));
+      return false;
+    }
+    out.Attach(ui::d3d12::util::CreateComputePipeline(device, code->GetBufferPointer(),
+                                                      code->GetBufferSize(),
+                                                      look_root_signature_.Get()));
+    code->Release();
+    return out != nullptr;
+  };
+  if (!build("bright_cs", look_bright_pipeline_) || !build("blur_cs", look_blur_pipeline_) ||
+      !build("final_cs", look_final_pipeline_)) {
+    return false;
+  }
+  REXGPU_INFO("Modern look: initialized");
+  return true;
+}
+
+void D3D12CommandProcessor::LookApply(ID3D12Resource* guest_output, uint32_t width,
+                                      uint32_t height) {
+  float v[kLookParams];
+  {
+    std::lock_guard<std::mutex> lock(g_look_mutex);
+    if (g_look.size() < kLookParams) return;
+    std::memcpy(v, g_look.data(), sizeof(v));
+  }
+  if (!guest_output || !width || !height) return;
+  if (!look_init_tried_) {
+    look_init_tried_ = true;
+    look_init_ok_ = LookInitialize();
+  }
+  if (!look_init_ok_) return;
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  const uint32_t bw = std::max(1u, width / 4), bh = std::max(1u, height / 4);
+
+  // Work textures: a copy of the frame and two quarter-size bloom buffers.
+  auto retire = [&](Microsoft::WRL::ComPtr<ID3D12Resource>& r) {
+    if (!r) return;
+    if (submission_completed_ < look_textures_submission_) {
+      r->AddRef();
+      resources_for_deletion_.emplace_back(look_textures_submission_, r.Get());
+    }
+    r.Reset();
+  };
+  if (look_copy_) {
+    D3D12_RESOURCE_DESC d = look_copy_->GetDesc();
+    if (d.Width != width || d.Height != height) {
+      retire(look_copy_);
+      retire(look_bloom_a_);
+      retire(look_bloom_b_);
+    }
+  }
+  auto create = [&](Microsoft::WRL::ComPtr<ID3D12Resource>& r, uint32_t w, uint32_t h, DXGI_FORMAT format,
+                    bool uav) {
+    D3D12_RESOURCE_DESC d = {};
+    d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    d.Width = w;
+    d.Height = h;
+    d.DepthOrArraySize = 1;
+    d.MipLevels = 1;
+    d.Format = format;
+    d.SampleDesc.Count = 1;
+    d.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    d.Flags = uav ? D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS : D3D12_RESOURCE_FLAG_NONE;
+    return SUCCEEDED(device->CreateCommittedResource(
+        &ui::d3d12::util::kHeapPropertiesDefault, provider.GetHeapFlagCreateNotZeroed(), &d,
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, nullptr, IID_PPV_ARGS(&r)));
+  };
+  if (!look_copy_) {
+    if (!create(look_copy_, width, height, ui::d3d12::D3D12Presenter::kGuestOutputFormat, false) ||
+        !create(look_bloom_a_, bw, bh, DXGI_FORMAT_R16G16B16A16_FLOAT, true) ||
+        !create(look_bloom_b_, bw, bh, DXGI_FORMAT_R16G16B16A16_FLOAT, true)) {
+      REXGPU_ERROR("Modern look: could not create its textures; switched off");
+      look_copy_.Reset();
+      look_bloom_a_.Reset();
+      look_bloom_b_.Reset();
+      look_init_ok_ = false;
+      return;
+    }
+  }
+
+  // Descriptors for the four passes: (dst, src0, src1) each.
+  ui::d3d12::util::DescriptorCpuGpuHandlePair h[12];
+  if (!RequestOneUseSingleViewDescriptors(12, h)) return;
+  // From here nothing may change the descriptor heap.
+  look_textures_submission_ = submission_current_;
+
+  auto srv = [&](ID3D12Resource* r, DXGI_FORMAT f, D3D12_CPU_DESCRIPTOR_HANDLE at) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC d = {};
+    d.Format = f;
+    d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    d.Texture2D.MipLevels = 1;
+    device->CreateShaderResourceView(r, &d, at);
+  };
+  auto uav = [&](ID3D12Resource* r, DXGI_FORMAT f, D3D12_CPU_DESCRIPTOR_HANDLE at) {
+    D3D12_UNORDERED_ACCESS_VIEW_DESC d = {};
+    d.Format = f;
+    d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    device->CreateUnorderedAccessView(r, nullptr, &d, at);
+  };
+  const DXGI_FORMAT out_format = ui::d3d12::D3D12Presenter::kGuestOutputFormat;
+  const DXGI_FORMAT bloom_format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  // bright: copy -> A; blur: A -> B; blur: B -> A; final: copy + A -> output
+  uav(look_bloom_a_.Get(), bloom_format, h[0].first);
+  srv(look_copy_.Get(), out_format, h[1].first);
+  srv(look_copy_.Get(), out_format, h[2].first);
+  uav(look_bloom_b_.Get(), bloom_format, h[3].first);
+  srv(look_bloom_a_.Get(), bloom_format, h[4].first);
+  srv(look_bloom_a_.Get(), bloom_format, h[5].first);
+  uav(look_bloom_a_.Get(), bloom_format, h[6].first);
+  srv(look_bloom_b_.Get(), bloom_format, h[7].first);
+  srv(look_bloom_b_.Get(), bloom_format, h[8].first);
+  uav(guest_output, out_format, h[9].first);
+  srv(look_copy_.Get(), out_format, h[10].first);
+  srv(look_bloom_a_.Get(), bloom_format, h[11].first);
+
+  // The frame so far -> look_copy_.
+  const D3D12_RESOURCE_STATES out_state = ui::d3d12::D3D12Presenter::kGuestOutputInternalState;
+  PushTransitionBarrier(guest_output, out_state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  PushTransitionBarrier(look_copy_.Get(), D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                        D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyResource(look_copy_.Get(), guest_output);
+  PushTransitionBarrier(look_copy_.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  PushTransitionBarrier(guest_output, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+
+  struct {
+    uint32_t size[2], bloom_size[2];
+    float p[16];
+  } k = {};
+  k.size[0] = width;
+  k.size[1] = height;
+  k.bloom_size[0] = bw;
+  k.bloom_size[1] = bh;
+  for (size_t i = 0; i < 12; ++i) k.p[i] = v[i];
+  deferred_command_list_.D3DSetComputeRootSignature(look_root_signature_.Get());
+  auto pass = [&](ID3D12PipelineState* pipeline, int first, float step, uint32_t w, uint32_t hgt) {
+    k.p[12] = step;
+    deferred_command_list_.D3DSetComputeRoot32BitConstants(0, 20, &k, 0);
+    deferred_command_list_.D3DSetComputeRootDescriptorTable(1, h[first].second);
+    deferred_command_list_.D3DSetComputeRootDescriptorTable(2, h[first + 1].second);
+    deferred_command_list_.D3DSetComputeRootDescriptorTable(3, h[first + 2].second);
+    SetExternalPipeline(pipeline);
+    SubmitBarriers();
+    deferred_command_list_.D3DDispatch((w + 7) / 8, (hgt + 7) / 8, 1);
+  };
+  const bool bloom = v[1] > 0.0f;
+  if (bloom) {
+    PushTransitionBarrier(look_bloom_a_.Get(), D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                          D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    pass(look_bright_pipeline_.Get(), 0, 1.0f, bw, bh);
+    PushTransitionBarrier(look_bloom_a_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    PushTransitionBarrier(look_bloom_b_.Get(), D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                          D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    pass(look_blur_pipeline_.Get(), 3, 1.0f, bw, bh);
+    PushTransitionBarrier(look_bloom_b_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    PushTransitionBarrier(look_bloom_a_.Get(), D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                          D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    pass(look_blur_pipeline_.Get(), 6, 2.5f, bw, bh);
+    PushTransitionBarrier(look_bloom_a_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  }
+  pass(look_final_pipeline_.Get(), 9, 0.0f, width, height);
+  PushTransitionBarrier(guest_output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, out_state);
+}
+
+// ---------------------------------------------------------------------------
+// World beams (see command_processor.h)
+// ---------------------------------------------------------------------------
+
+namespace {
+std::mutex g_world_beam_mutex;
+std::vector<float> g_world_beams;  // 10 floats per beam: start, end, width, rgb
+float g_world_beam_camera[12] = {};  // position, right, up, forward (game thread)
+std::chrono::steady_clock::time_point g_world_beam_time{};
+}  // namespace
+
+static const char kBeamShader[] = R"(
+cbuffer BeamConstants : register(b0) {
+  float4 proj;           // x scale (signed), y scale, x shift, y shift (per unit depth)
+  float4 proj_z;         // z = x * w + y
+  float4 unused0[2];
+  float4 ndc_scale;
+  float4 ndc_offset;
+  uint4 flags;           // x: 1 W not 1/W, 2 XY/W, 4 Z/W; y: beam count
+  float4 cam;
+  float4 beam_start[8];  // w = half width (m)
+  float4 beam_end[8];
+  float4 beam_color[8];
+};
+struct VSOut {
+  float4 pos : SV_Position;
+  float2 uv : TEXCOORD0;
+  nointerpolation uint beam : TEXCOORD1;
+};
+VSOut vs_main(uint vid : SV_VertexID) {
+  VSOut o;
+  uint b = vid / 6u;
+  uint k = vid % 6u;
+  float2 corner[6] = {float2(0, -1), float2(1, -1), float2(0, 1), float2(0, 1), float2(1, -1), float2(1, 1)};
+  float2 c = corner[k];
+  o.uv = c;
+  o.beam = b;
+  float3 s = beam_start[b].xyz;
+  float3 e = beam_end[b].xyz;
+  float3 dir = e - s;
+  float len = length(dir);
+  if (b >= flags.y || len < 0.001) {
+    o.pos = float4(0, 0, -2, 1);
+    return o;
+  }
+  dir /= len;
+  o.uv.x = c.x * len;  // metres from the start
+  float3 p = lerp(s, e, c.x);
+  float3 tocam = normalize(cam.xyz - p);
+  float3 side = cross(dir, tocam);
+  float sl = length(side);
+  side = sl > 1e-4 ? side / sl : float3(0, 1, 0);
+  p += side * (c.y * beam_start[b].w);
+  // p is in camera space: x right, y up, z forward (depth).
+  float4 pos = float4(proj.x * p.x + proj.z * p.z, proj.y * p.y + proj.w * p.z,
+                      proj_z.x * p.z + proj_z.y, p.z);
+  if ((flags.x & 1u) == 0u) pos.w = 1.0 / pos.w;
+  if ((flags.x & 2u) != 0u) pos.xy *= pos.w;
+  if ((flags.x & 4u) != 0u) pos.z *= pos.w;
+  pos.xyz = pos.xyz * ndc_scale.xyz;
+  pos.xyz = mad(ndc_offset.xyz, pos.www, pos.xyz);
+  o.pos = pos;
+  return o;
+}
+float4 ps_main(VSOut i) : SV_Target0 {
+  float v = i.uv.y;
+  float glow = exp(-v * v * 3.0);
+  float core = exp(-v * v * 45.0);
+  float3 col = beam_color[i.beam].rgb * glow * 1.4 + core * float3(1.0, 0.9, 0.85) * 1.2;
+  // Soft start (15 cm).
+  col *= saturate(i.uv.x / 0.15);
+  return float4(col, 0.0);
+}
+)";
+
+bool D3D12CommandProcessor::BeamInitialize() {
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile =
+      compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile"))
+               : nullptr;
+  if (!compile) {
+    REXGPU_ERROR("World beams: d3dcompiler_47.dll / D3DCompile not available");
+    return false;
+  }
+  auto build = [&](const char* entry, const char* target, std::vector<uint8_t>& out) {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = compile(kBeamShader, sizeof(kBeamShader) - 1, "world_beams", nullptr, nullptr,
+                         entry, target, 1u << 15, 0, &code, &errors);
+    if (errors) {
+      REXGPU_ERROR("World beams: {} compiler output: {}", entry,
+                   std::string(static_cast<const char*>(errors->GetBufferPointer()),
+                               errors->GetBufferSize()));
+      errors->Release();
+    }
+    if (FAILED(hr) || !code) {
+      REXGPU_ERROR("World beams: failed to compile {} (0x{:08X})", entry, uint32_t(hr));
+      return false;
+    }
+    out.assign(static_cast<const uint8_t*>(code->GetBufferPointer()),
+               static_cast<const uint8_t*>(code->GetBufferPointer()) + code->GetBufferSize());
+    code->Release();
+    return true;
+  };
+  if (!build("vs_main", "vs_5_1", beam_vs_) || !build("ps_main", "ps_5_1", beam_ps_)) {
+    return false;
+  }
+  D3D12_ROOT_PARAMETER parameter = {};
+  parameter.ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+  parameter.Descriptor.ShaderRegister = 0;
+  parameter.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 1;
+  desc.pParameters = &parameter;
+  beam_root_signature_ = ui::d3d12::util::CreateRootSignature(GetD3D12Provider(), desc);
+  if (!beam_root_signature_) {
+    REXGPU_ERROR("World beams: failed to create the root signature");
+    return false;
+  }
+  REXGPU_INFO("World beams: initialized");
+  return true;
+}
+
+// A main colour pass draw: its projection, viewport transform and pass.
+void D3D12CommandProcessor::BeamCapture(uint32_t zfunc) {
+  const RegisterFile& regs = *register_file_;
+  float c[4][4];
+  std::memcpy(c, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * 4], sizeof(c));
+  std::memcpy(beam_c_, c, sizeof(c));
+  for (uint32_t i = 0; i < 3; ++i) {
+    beam_ndc_scale_[i] = system_constants_.ndc_scale[i];
+    beam_ndc_offset_[i] = system_constants_.ndc_offset[i];
+  }
+  const uint32_t sys_flags = system_constants_.flags;
+  beam_flags_ = ((sys_flags & DxbcShaderTranslator::kSysFlag_WNotReciprocal) ? 1u : 0u) |
+                ((sys_flags & DxbcShaderTranslator::kSysFlag_XYDividedByW) ? 2u : 0u) |
+                ((sys_flags & DxbcShaderTranslator::kSysFlag_ZDividedByW) ? 4u : 0u);
+  beam_zfunc_ = zfunc;
+  beam_main_pitch_ = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+  beam_c_valid_ = true;
+  ++beam_main_draws_;
+  BeamCheckExact();
+}
+
+// World-space geometry (no model rotation / offset): c4..c7 is the frame's
+// view-projection. Recognised by its W row matching the camera (forward and
+// position), so the beams line up with the frame being drawn.
+void D3D12CommandProcessor::BeamCheckExact() {
+  const RegisterFile& regs = *register_file_;
+  float c[4][4];
+  std::memcpy(c, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * 4], sizeof(c));
+  float cam[12];
+  {
+    std::lock_guard<std::mutex> lock(g_world_beam_mutex);
+    if (g_world_beams.empty()) return;
+    std::memcpy(cam, g_world_beam_camera, sizeof(cam));
+  }
+  const float wl = std::sqrt(c[3][0] * c[3][0] + c[3][1] * c[3][1] + c[3][2] * c[3][2]);
+  if (wl < 1e-4f) return;
+  const float dotf = (c[3][0] * cam[9] + c[3][1] * cam[10] + c[3][2] * cam[11]) / wl;
+  const float wpos = (c[3][0] * cam[0] + c[3][1] * cam[1] + c[3][2] * cam[2] + c[3][3]) / wl;
+  if (dotf > 0.999f && std::fabs(wpos) < 3.0f) {
+    std::memcpy(beam_vp_, c, sizeof(c));
+    beam_vp_exact_ = true;
+  }
+  // Diagnostics (file world_beams.log next to the exe, first frames with beams).
+  if (false) {
+    ++beam_diag_frame_;
+    if (FILE* f = std::fopen("world_beams.log", beam_diag_lines_ ? "a" : "w")) {
+      std::fprintf(f, "frame %llu main %u: c4 %.4f %.4f %.4f %.3f | c5 %.4f %.4f %.4f %.3f | c6 %.5f %.5f %.5f %.4f | "
+                      "c7 %.4f %.4f %.4f %.3f | dotF %.5f wpos %.3f | cam %.2f %.2f %.2f F %.4f %.4f %.4f U %.4f %.4f %.4f\n",
+                   (unsigned long long)beam_stat_frames_, beam_main_draws_, c[0][0], c[0][1], c[0][2], c[0][3],
+                   c[1][0], c[1][1], c[1][2], c[1][3], c[2][0], c[2][1], c[2][2], c[2][3], c[3][0], c[3][1],
+                   c[3][2], c[3][3], dotf, wpos, cam[0], cam[1], cam[2], cam[9], cam[10], cam[11], cam[6],
+                   cam[7], cam[8]);
+      std::fclose(f);
+    }
+    ++beam_diag_lines_;
+  }
+}
+
+void D3D12CommandProcessor::BeamDraw() {
+  if (beam_drawn_this_frame_ || !beam_c_valid_) return;
+  auto skip = [&](uint32_t why) {
+    ++beam_stat_skip_;
+    beam_last_skip_ = why;
+  };
+  std::vector<float> beams;
+  float cam[12];
+  {
+    std::lock_guard<std::mutex> lock(g_world_beam_mutex);
+    if (g_world_beams.empty() ||
+        std::chrono::steady_clock::now() - g_world_beam_time > std::chrono::milliseconds(150)) {
+      return;
+    }
+    beams = g_world_beams;
+    std::memcpy(cam, g_world_beam_camera, sizeof(cam));
+  }
+  // Only the resolve that ends the main colour pass.
+  if (beam_main_draws_ < 20) return skip(1);
+  const RegisterFile& regs = *register_file_;
+  const auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  if (si.surface_pitch != beam_main_pitch_) return skip(2);
+  if (si.msaa_samples != xenos::MsaaSamples::k1X) return skip(3);
+  if (render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) return skip(4);
+  uint32_t formats[1 + xenos::kMaxColorRenderTargets];
+  const uint32_t bits = render_target_cache_->GetLastUpdateBoundRenderTargets(formats);
+  if ((bits & 3u) != 3u) return skip(5);
+  if (!beam_init_tried_) {
+    beam_init_tried_ = true;
+    beam_init_ok_ = BeamInitialize();
+  }
+  if (!beam_init_ok_) return skip(6);
+
+  // Depth test direction from the projection itself (the main pass's own
+  // compare function is for its equal-depth pass and says nothing about which
+  // way is nearer): does depth grow or shrink with distance?
+  bool depth_grows = true;
+  {
+    const float(*c)[4] = beam_c_;
+    auto dot3 = [](const float* a, const float* b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; };
+    const float w2 = std::max(1e-8f, dot3(c[3], c[3]));
+    const float a = dot3(c[2], c[3]) / w2, b = (c[2][3] - a * c[3][3]) / std::sqrt(w2);
+    auto ndc_z = [&](float w) { return ((a * w + b) / w) * beam_ndc_scale_[2] + beam_ndc_offset_[2]; };
+    depth_grows = ndc_z(100.0f) > ndc_z(2.0f);
+  }
+  // Right Ctrl + B cycles the depth test for testing: 0 = automatic from the
+  // projection, 1 = the other way round, 2 = off (whole beam always visible).
+  static int depth_mode = 0;  // automatic (LESS_EQUAL here): the one that hides the beam behind the head
+  static bool f10_was = false;
+  const bool f10 = (GetAsyncKeyState(VK_RCONTROL) & 0x8000) != 0 && (GetAsyncKeyState('B') & 0x8000) != 0;
+  if (f10 && !f10_was) {
+    depth_mode = (depth_mode + 1) % 3;
+    REXLOG_INFO("World beams: depth test mode {} ({})", depth_mode,
+                depth_mode == 0 ? "automatic" : depth_mode == 1 ? "reversed" : "off");
+  }
+  f10_was = f10;
+  bool nearer_is_less = depth_grows;
+  if (depth_mode == 1) nearer_is_less = !nearer_is_less;
+  const uint32_t depth_func = depth_mode == 2 ? uint32_t(D3D12_COMPARISON_FUNC_ALWAYS)
+                              : nearer_is_less ? uint32_t(D3D12_COMPARISON_FUNC_LESS_EQUAL)
+                                               : uint32_t(D3D12_COMPARISON_FUNC_GREATER_EQUAL);
+  // Pipeline for these render target formats.
+  uint64_t key = uint64_t(bits) | (uint64_t(depth_func) << 8);
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    key = key * 0x100000001B3ull ^ formats[i];
+  }
+  ID3D12PipelineState* pipeline = nullptr;
+  auto found = beam_pipelines_.find(key);
+  if (found != beam_pipelines_.end()) {
+    pipeline = found->second;
+  } else {
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC d = {};
+    d.pRootSignature = beam_root_signature_;
+    d.VS.pShaderBytecode = beam_vs_.data();
+    d.VS.BytecodeLength = beam_vs_.size();
+    d.PS.pShaderBytecode = beam_ps_.data();
+    d.PS.BytecodeLength = beam_ps_.size();
+    d.SampleMask = UINT_MAX;
+    d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    d.RasterizerState.DepthClipEnable = TRUE;
+    d.DepthStencilState.DepthEnable = TRUE;
+    d.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+    d.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC(depth_func);
+    d.DSVFormat = D3D12RenderTargetCache::GetDepthDSVDXGIFormat(
+        xenos::DepthRenderTargetFormat(formats[0]));
+    d.BlendState.IndependentBlendEnable = TRUE;
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (!(bits & (2u << i))) continue;
+      d.NumRenderTargets = i + 1;
+      d.RTVFormats[i] = render_target_cache_->GetColorDrawDXGIFormat(
+          xenos::ColorRenderTargetFormat(formats[1 + i]));
+      D3D12_RENDER_TARGET_BLEND_DESC& blend = d.BlendState.RenderTarget[i];
+      if (i == 0) {
+        blend.BlendEnable = TRUE;
+        blend.SrcBlend = D3D12_BLEND_ONE;
+        blend.DestBlend = D3D12_BLEND_ONE;
+        blend.BlendOp = D3D12_BLEND_OP_ADD;
+        blend.SrcBlendAlpha = D3D12_BLEND_ZERO;
+        blend.DestBlendAlpha = D3D12_BLEND_ONE;
+        blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+        blend.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_RED | D3D12_COLOR_WRITE_ENABLE_GREEN |
+                                      D3D12_COLOR_WRITE_ENABLE_BLUE;
+      } else {
+        blend.RenderTargetWriteMask = 0;
+      }
+    }
+    d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    d.SampleDesc.Count = 1;
+    ID3D12Device* device = GetD3D12Provider().GetDevice();
+    if (FAILED(device->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&pipeline)))) {
+      pipeline = nullptr;
+    }
+    beam_pipelines_[key] = pipeline;
+    REXGPU_INFO("World beams: pipeline {} (RT0 format {}, depth format {}, zfunc {})",
+                pipeline ? "created" : "FAILED", formats[1], formats[0], beam_zfunc_);
+  }
+  if (!pipeline) return skip(7);
+
+  // Projection: the frame's own view-projection when a world-space draw had
+  // it, otherwise the camera the beams came with plus the projection terms of
+  // the last main pass draw (x / y scale and the depth mapping z = A w + B).
+  struct BeamConstants {
+    float proj[4];
+    float proj_z[4];
+    float unused0[2][4];
+    float ndc_scale[4];
+    float ndc_offset[4];
+    uint32_t flags[4];
+    float cam[4];
+    float start[8][4];
+    float end[8][4];
+    float color[8][4];
+  };
+  D3D12_GPU_VIRTUAL_ADDRESS cb_address;
+  auto* bc = reinterpret_cast<BeamConstants*>(constant_buffer_pool_->Request(
+      frame_current_, sizeof(BeamConstants), D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, nullptr,
+      nullptr, &cb_address));
+  if (!bc) return skip(8);
+  std::memset(bc, 0, sizeof(*bc));
+  {
+    // The projection of the frame being drawn (from the last main pass draw:
+    // its c4..c7 = projection * view * model; model has no scale, so the
+    // rows split into scale, shift along the view direction, and depth).
+    const float(*c)[4] = beam_c_;
+    auto dot3 = [](const float* a, const float* b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; };
+    const float w2 = std::max(1e-8f, dot3(c[3], c[3]));
+    const float kx = dot3(c[0], c[3]) / w2, ky = dot3(c[1], c[3]) / w2, a = dot3(c[2], c[3]) / w2;
+    float px[3], py[3];
+    for (int k = 0; k < 3; ++k) { px[k] = c[0][k] - kx * c[3][k]; py[k] = c[1][k] - ky * c[3][k]; }
+    const float wl = std::sqrt(w2);
+    const float sx = std::sqrt(dot3(px, px)) / wl, sy = std::sqrt(dot3(py, py)) / wl;
+    // Camera-space x is up x forward (see RexWorldBeamsCamera); the sign of
+    // the projection's x axis relative to that.
+    const float cross[3] = {py[1] * c[3][2] - py[2] * c[3][1], py[2] * c[3][0] - py[0] * c[3][2],
+                            py[0] * c[3][1] - py[1] * c[3][0]};
+    const float sgn = dot3(px, cross) >= 0.0f ? 1.0f : -1.0f;
+    bc->proj[0] = sgn * sx;
+    bc->proj[1] = sy;
+    bc->proj[2] = kx;
+    bc->proj[3] = ky;
+    bc->proj_z[0] = a;
+    bc->proj_z[1] = (c[2][3] - a * c[3][3]) / wl;
+  }
+  for (int k = 0; k < 3; ++k) {
+    bc->ndc_scale[k] = beam_ndc_scale_[k];
+    bc->ndc_offset[k] = beam_ndc_offset_[k];
+    bc->cam[k] = 0.0f;  // beams are in camera space
+  }
+  const uint32_t count = uint32_t(std::min<size_t>(8, beams.size() / 10));
+  bc->flags[0] = beam_flags_;
+  bc->flags[1] = count;
+  for (uint32_t i = 0; i < count; ++i) {
+    const float* s = &beams[i * 10];
+    for (int k = 0; k < 3; ++k) {
+      bc->start[i][k] = s[k];
+      bc->end[i][k] = s[3 + k];
+      bc->color[i][k] = s[7 + k];
+    }
+    bc->start[i][3] = std::max(0.005f, s[6] * 0.01f);  // half width in metres
+  }
+  SetExternalPipeline(pipeline);
+  SetExternalGraphicsRootSignature(beam_root_signature_);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(0, cb_address);
+  SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  deferred_command_list_.D3DDrawInstanced(count * 6, 1, 0, 0);
+  beam_drawn_this_frame_ = true;
+  ++beam_stat_drawn_;
+}
+
 }  // namespace rex::graphics::d3d12
+
+// Called by the game (WML overlay_beams) on the game thread, with the beams
+// already in camera space (x = up x forward, y = up, z = forward), taken at the
+// same moment as the beam ends, so the beams stay locked to the view.
+extern "C" __declspec(dllexport) void RexWorldBeamsCamera(const float* data, int count) {
+  using namespace rex::graphics::d3d12;
+  std::lock_guard<std::mutex> lock(g_world_beam_mutex);
+  if (data && count > 0 && count <= 64) {
+    g_world_beams.assign(data, data + size_t(count) * 10);
+  } else {
+    g_world_beams.clear();
+  }
+  g_world_beam_time = std::chrono::steady_clock::now();
+}
+
+// Called by the game (WML overlay_beams) on the game thread.
+extern "C" __declspec(dllexport) void RexWorldBeams(const float* data, int count,
+                                                     const float* camera) {
+  using namespace rex::graphics::d3d12;
+  std::lock_guard<std::mutex> lock(g_world_beam_mutex);
+  if (data && count > 0 && count <= 64) {
+    g_world_beams.assign(data, data + size_t(count) * 10);
+  } else {
+    g_world_beams.clear();
+  }
+  if (camera) std::memcpy(g_world_beam_camera, camera, sizeof(g_world_beam_camera));
+  g_world_beam_time = std::chrono::steady_clock::now();
+}
+
+// Called by the game (WML set_look). count 0 switches the look off.
+extern "C" __declspec(dllexport) void RexLookSettings(const float* data, int count) {
+  using namespace rex::graphics::d3d12;
+  std::lock_guard<std::mutex> lock(g_look_mutex);
+  if (data && count >= int(kLookParams)) {
+    g_look.assign(data, data + kLookParams);
+  } else {
+    g_look.clear();
+  }
+}
