+    const double secs = us / 1e6;
+    uint32_t order[132];
+    for (uint32_t k = 0; k < 132; ++k) order[k] = k;
+    std::sort(order, order + 132, [](uint32_t a, uint32_t b) { return g_pm4.ticks[a] > g_pm4.ticks[b]; });
