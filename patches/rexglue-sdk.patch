+struct NvQueued {
+  NvSnap s;
+  ID3D12PipelineState* override_pso = nullptr;
+  uint32_t vertex_count = 0;
+  uint32_t start_index = 0;
+  uint64_t vs_hash = 0, ps_hash = 0;  // VIEW13: pair of the guest draw (verify)
+  bool no_color = false;  // VIEW13 v13e: replayed with no colour target bound (clear quad: depth / stencil only)
+  uint32_t dc = 0, cmask = 0, rt_bits = 0;  // VIEW14: guest RB_DEPTHCONTROL / colour mask / bound targets (verify log)
+  uint32_t bc0 = 0, colctl = 0, srm = 0, srm_bf = 0;  // NATIVE16: RB_BLENDCONTROL0 / RB_COLORCONTROL / STENCILREFMASK(_BF)
+};
