+// Depth-only stand-ins (same 18-float layout, colours ignored), drawn before the meshes.
+// skate v0.9.4: body capsules for the board's per-pixel occlusion, camera space like the meshes,
+// 7 floats each (a.xyz, b.xyz, radius). count 0 / nullptr clears.
+extern "C" __declspec(dllexport) void RexWorldOccluderCapsulesV1(const float* data, int count) {
+  using namespace rex::graphics::d3d12;
+  std::lock_guard<std::mutex> lock(g_world_mesh_mutex);
+  g_world_capsules.clear();
+  if (data && count > 0) {
+    const int n = std::min(count, kMaxWorldCapsules);
+    g_world_capsules.resize(size_t(n) * 8);
+    for (int i = 0; i < n; ++i) {
+      const float* c = data + size_t(i) * 7;
+      float* o = g_world_capsules.data() + size_t(i) * 8;
+      o[0] = c[0]; o[1] = c[1]; o[2] = c[2]; o[3] = c[6];
+      o[4] = c[3]; o[5] = c[4]; o[6] = c[5]; o[7] = 0.0f;
+    }
+  }
+  g_world_capsules_time = std::chrono::steady_clock::now();
+}
