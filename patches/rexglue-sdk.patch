+// ---------------------------------------------------------------------------------------------------
+// Native view main-colour pass (whompay, 2026-10-25). Included by native_view.inc.
+//
+// NativeViewColorDraw picks OUR pixel/vertex shaders for one main-colour-pass draw that the native view
+// re-issues into its own colour target:
+//   1. city_main pair B910C2C14CFA4FFC / D21BBFA693592F65: the existing native city_main VS + PS (the same
+//      bytecode and the same material pipeline as the CityMain path, mode 1 = shared PSO cache entry).
+//   2. ported pairs (research/native_shaders_next, embedded above): VS + PS ports, used only when the
+//      translated pair's texture/sampler slots and packed float constant maps match what the port assumes.
+//   3. everything else: the translated VS + a simple native PS compiled at run time (d3dcompiler_47): the
+//      first 2D texture of the translated PS sampled at the interpolator its first fetch reads, shaded by the
+//      screen-space depth slope, alpha test from the system constants. Tinted magenta under
+//      dist\native_view_tint (coverage of our own material shaders = untinted).
+// All of them keep the emulated pipeline description and the emulated bindless root signature (only the
+// shader bytecode changes, PipelineCache::GetNativeMaterialPipeline), so the root arguments that
+// UpdateBindings set for the emulated draw are valid for the native draw unchanged.
+// Material pipeline ids (low 3 bits of the cache key): 1..3 CityMain modes (1 shared), 4 ported pair,
+// 5 fallback, 6 fallback tinted.
+// Switches (dist, polled about once per second): native_view_tint, native_view_ports.off,
+// native_view_fallback.off, native_view_city_main.off, native_view_fallback_nodepth (fallback for every draw
+// without a depth test), native_view_nodepth_ports (ports of no-depth screen-space passes, 436F/88D1),
+// native_view_nodepth_world (fallback for no-depth draws whose VS reads a transform = sky / world-space passes,
+// not full-screen quads (<= 6 vertices), not depth-writing), native_view_fallback_solid (diagnostic: fallback PS writes
+// opaque magenta, no texture, no alpha test: a surface that stays clear colour is rejected by depth, not by colour).
+// Log line "NATIVE VIEW COLOR (COLOR13)" every 10 s while draws arrive.
+// CP thread only.
+// ---------------------------------------------------------------------------------------------------
+
+namespace native_view_color {
+
+constexpr uint32_t kPortCount = 24;
+// Draw kinds: city_main pair, city_main PS only, each port pair, each port PS only, fallback, returned false.
+enum Kind : uint32_t {
+  kKindCityMain,
+  kKindCityMainPs,
+  kKindPort0,
+  kKindPortPs0 = kKindPort0 + kPortCount,
+  kKindFallback = kKindPortPs0 + kPortCount,
+  kKindFalse,
+  kKindCount
+};
+
+enum FalseReason : uint32_t {
+  kFrNoPs,
+  kFrState,
+  kFrModification,
+  kFrDisabled,
+  kFrCompile,
+  kFrPsoNotReady,
+  kFrPsoFailed,
+  kFrBudget,
+  kFrNoDepth,
+  kFrCount
+};
+static const char* const kFalseReasonNames[kFrCount] = {
+    "no pixel shader", "state", "modification", "disabled", "compile failed", "pipeline not ready",
+    "pso failed (gs/points/rects)", "pso budget", "fallback skipped (no depth test: full-screen / HUD pass)"};
+
+struct PortDesc {
+  const char* name;
+  uint64_t vs_hash, ps_hash;
+  const uint8_t* vs;
+  size_t vs_size;
+  const uint8_t* ps;
+  size_t ps_size;
+  // Guest float constants the port declares packed (ascending), VS and PS.
+  const uint8_t* vs_floats;
+  uint32_t vs_float_count;
+  const uint8_t* ps_floats;
+  uint32_t ps_float_count;
+  // (fetch constant, sampler slot, unsigned SRV slot, signed SRV slot) the port reads.
+  const uint32_t (*bindings)[4];
+  uint32_t binding_count;
+  uint32_t interpolator_mask;  // VS/PS interface of the port (TEXCOORD0..n-1)
+  // Port only used with dist\native_view_nodepth_ports (no-depth full-screen / screen-space passes).
+  bool nodepth_gated;
+};
