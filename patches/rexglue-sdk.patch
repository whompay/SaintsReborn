+    const uint64_t oldest = done_seq.load(std::memory_order_acquire) + 1;
+    if (oldest <= seq && seq - oldest < kEnqueueSlots &&
+        NowUs() - enqueue_us[oldest % kEnqueueSlots].load(std::memory_order_relaxed) >
+            uint64_t(max_lag)) {
+      stat_lag_drains.fetch_add(1, std::memory_order_relaxed);
+      ok = WaitDone(seq, worker_running_);
+    }
+  }
+  stat_wait_us.fetch_add(NowUs() - submit_start, std::memory_order_relaxed);
+  MaybeLogStats();
+  if (!ok) {
+    REXGPU_ERROR("Command stream submission timed out");
+    return false;
+  }
+  return true;
+}
