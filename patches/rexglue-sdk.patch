+static inline uint32_t M3SlotHash(uint32_t vs, uint32_t ps, uint32_t decl) {
+  uint64_t h = (uint64_t(vs) << 32 | ps) ^ (uint64_t(decl) * 0x9E3779B97F4A7C15ull);
+  h ^= h >> 31;
+  h *= 0xBF58476D1CE4E5B9ull;
+  h ^= h >> 29;
+  return uint32_t(h);
+}
+static inline uint64_t M3KeyId(uint32_t vs, uint32_t ps, uint32_t decl) {
+  uint64_t h = M3SlotHash(vs, ps, decl);
+  return (h << 32) ^ (uint64_t(vs) * 0x100000001B3ull) ^ (uint64_t(ps) << 7) ^ decl;
+}
+
+// Under g_m3.mutex.
+static void M3Publish(M3Key& k) {
+  k.gen = (k.gen + 1) | 1;
+  uint32_t i = M3SlotHash(k.vs, k.ps, k.decl) & (kM3MaskSlots - 1);
+  for (uint32_t probe = 0; probe < kM3MaskProbe; ++probe, i = (i + 1) & (kM3MaskSlots - 1)) {
+    M3MaskSlot& sl = g_m3_masks[i];
+    const bool used = sl.gen.load(std::memory_order_relaxed) != 0;
+    if (used && (sl.vs.load(std::memory_order_relaxed) != k.vs || sl.ps.load(std::memory_order_relaxed) != k.ps ||
+                 sl.decl.load(std::memory_order_relaxed) != k.decl)) {
+      continue;
+    }
+    const uint32_t q = sl.seq.load(std::memory_order_relaxed);
+    sl.seq.store(q + 1, std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_release);
+    sl.vs.store(k.vs, std::memory_order_relaxed);
+    sl.ps.store(k.ps, std::memory_order_relaxed);
+    sl.decl.store(k.decl, std::memory_order_relaxed);
+    sl.flags.store(REX_NATIVE_MASKS_FLAG_SHADOW | (k.ownable ? REX_NATIVE_MASKS_FLAG_OWNABLE : 0u),
+                   std::memory_order_relaxed);
+    sl.gen.store(k.gen, std::memory_order_relaxed);
+    sl.seq.store(q + 2, std::memory_order_release);
+    return;
+  }
+}
+
+// Any thread, lock-free.
+static int M3GetMasks(uint32_t vs, uint32_t ps, uint32_t decl, RexNativeDrawMasksV2* out) {
+  if (!out) return -1;
+  std::memset(out, 0, sizeof(*out));
+  if (!M3Mode()) return 0;
+  vs = NativeBridgePhys(vs);
+  ps = NativeBridgePhys(ps);
+  uint32_t i = M3SlotHash(vs, ps, decl) & (kM3MaskSlots - 1);
+  for (uint32_t probe = 0; probe < kM3MaskProbe; ++probe, i = (i + 1) & (kM3MaskSlots - 1)) {
+    const M3MaskSlot& sl = g_m3_masks[i];
+    bool stable = false, match = false, empty = false;
+    uint32_t gen = 0, flags = 0;
+    for (int tries = 0; tries < 16 && !stable; ++tries) {
+      const uint32_t q0 = sl.seq.load(std::memory_order_acquire);
+      if (q0 & 1) continue;
+      gen = sl.gen.load(std::memory_order_relaxed);
+      const uint32_t a = sl.vs.load(std::memory_order_relaxed), b = sl.ps.load(std::memory_order_relaxed),
+                     d = sl.decl.load(std::memory_order_relaxed);
+      flags = sl.flags.load(std::memory_order_relaxed);
+      std::atomic_thread_fence(std::memory_order_acquire);
+      if (sl.seq.load(std::memory_order_relaxed) != q0) continue;
+      stable = true;
+      empty = gen == 0;
+      match = !empty && a == vs && b == ps && d == decl;
+    }
+    if (!stable || empty) return 0;
+    if (match) {
+      out->generation = gen;
+      out->flags = flags;
+      return 1;
+    }
+  }
+  return 0;
+}
+
+// Walk call_words (host order): every packet complete, only writer-like packets, exactly one DRAW and it is the last
+// packet, and its words equal draw_packet. Returns kM3CCount when fine, else the reason.
+static uint32_t M3CheckCall(const std::vector<uint32_t>& c, const uint32_t* draw, uint32_t draw_words) {
+  uint64_t allowed[2] = {};
+  auto allow = [&](uint32_t op) { allowed[op >> 6] |= uint64_t(1) << (op & 63); };
+  allow(xenos::PM4_SET_CONSTANT);
+  allow(xenos::PM4_SET_CONSTANT2);
+  allow(xenos::PM4_LOAD_ALU_CONSTANT);
+  allow(xenos::PM4_SET_SHADER_CONSTANTS);
+  allow(xenos::PM4_IM_LOAD);
+  allow(xenos::PM4_IM_LOAD_IMMEDIATE);
+  allow(xenos::PM4_NOP);
+  allow(xenos::PM4_DRAW_INDX);
+  allow(xenos::PM4_DRAW_INDX_2);
+  allow(xenos::PM4_SET_BIN_MASK_LO);
+  allow(xenos::PM4_SET_BIN_MASK_HI);
+  allow(xenos::PM4_SET_BIN_SELECT_LO);
+  allow(xenos::PM4_SET_BIN_SELECT_HI);
+  allow(xenos::PM4_SET_BIN_MASK);
+  allow(xenos::PM4_SET_BIN_SELECT);
+  const size_t n = c.size();
+  if (n < 4 || n > REX_NATIVE_M3_MAX_CALL_WORDS) return kM3CBadLength;
+  size_t i = 0, draw_at = SIZE_MAX;
+  uint32_t draws = 0;
+  while (i < n) {
+    const uint32_t h = c[i];
+    const uint32_t type = h >> 30;
+    size_t len;
+    if (type == 0) {
+      len = 1 + (((h >> 16) & 0x3FFF) + 1);
+    } else if (type == 3) {
+      const uint32_t op = (h >> 8) & 0x7F;
+      if (!((allowed[op >> 6] >> (op & 63)) & 1)) return kM3CBadOp;
+      // A NOP carrying the M3 marker magic inside a call would be re-entrant.
+      if (op == xenos::PM4_NOP && i + 1 < n && c[i + 1] == REX_NATIVE_MARKER_MAGIC) return kM3CBadOp;
+      len = 1 + (((h >> 16) & 0x3FFF) + 1);
+      if (op == xenos::PM4_DRAW_INDX || op == xenos::PM4_DRAW_INDX_2) {
+        if (draws++) return kM3CTwoDraws;
+        draw_at = i;
+      }
+    } else if (type == 2) {
+      len = 1;
+    } else {
+      return kM3CBadPacket;  // type 1: the D3D writer never emits it
+    }
+    if (i + len > n) return kM3CBadPacket;
+    if (draw_at == i && i + len != n) return kM3CDrawNotLast;
+    i += len;
+  }
+  if (!draws) return kM3CNoDraw;
+  if (draw_words < 2 || draw_words > 8 || n - draw_at != draw_words ||
+      std::memcmp(&c[draw_at], draw, size_t(draw_words) * 4) != 0) {
+    return kM3CDrawTail;
+  }
+  return kM3CCount;
+}
+
+// Record v4 with CALL_WORDS. 0 ok, <0 malformed; *call_bad = M3CheckCall result.
+static int M3Parse(const void* data, uint32_t size, M3Record& rec, uint32_t* call_bad) {
+  *call_bad = kM3CCount;
+  if (!data || size < REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE + sizeof(RexNativeDrawRecordV4Ext) + 4) return -1;
+  RexNativeDrawRecordV3Header h;
+  std::memcpy(&h, data, sizeof(h));
+  if (h.v2.size != size || h.v2.version != REX_NATIVE_DRAW_RECORD_VERSION_4) return -1;
+  if (!(h.v2.flags & REX_NATIVE_DRAW_FLAG_CALL_WORDS)) return -1;
+  if (h.value_words > REX_NATIVE_DRAW_RECORD_V3_MAX_WORDS) return -1;
+  const uint32_t groups = uint32_t(std::popcount(h.vs_group_mask) + std::popcount(h.ps_group_mask));
+  if (h.value_words != groups * 16) return -1;
+  const bool verify = (h.v2.flags & REX_NATIVE_DRAW_FLAG_VERIFY_ONLY) != 0,
+             owned = (h.v2.flags & REX_NATIVE_DRAW_FLAG_OWNED) != 0;
+  if (verify == owned) return -1;
+  if (verify && !(h.v2.flags & REX_NATIVE_DRAW_FLAG_MARKER_BEFORE)) return -1;
+  const size_t ext_off = REX_NATIVE_DRAW_RECORD_V3_HEADER_SIZE + size_t(h.value_words) * 4;
+  if (ext_off + sizeof(RexNativeDrawRecordV4Ext) + 4 > size) return -1;
+  const uint8_t* p = static_cast<const uint8_t*>(data);
+  RexNativeDrawRecordV4Ext x;
+  std::memcpy(&x, p + ext_off, sizeof(x));
+  const uint32_t units = uint32_t(std::popcount(x.fetch_unit_mask[0]) + std::popcount(x.fetch_unit_mask[1]) +
+                                  std::popcount(x.fetch_unit_mask[2]));
+  if (x.magic != REX_NATIVE_DRAW_V4_EXT_MAGIC || x.fetch_value_words != units * 2 || x.draw_packet_words > 8 ||
+      (x.reserved[0] | x.reserved[1] | x.reserved[2] | x.reserved[3] | x.reserved[4])) {
+    return -1;
+  }
+  const size_t cw_off = ext_off + sizeof(x) + size_t(x.fetch_value_words) * 4;
+  if (cw_off + 4 > size) return -1;
+  uint32_t n = 0;
+  std::memcpy(&n, p + cw_off, 4);
+  if (n > REX_NATIVE_M3_MAX_CALL_WORDS || cw_off + 4 + size_t(n) * 4 != size ||
+      x.ext_size != sizeof(x) + x.fetch_value_words * 4 + 4 + n * 4) {
+    return -1;
+  }
+  rec.r = h.v2;
+  rec.owned = owned;
+  rec.draw_header = h.draw_header;
+  rec.call.resize(n);
+  if (n) std::memcpy(rec.call.data(), p + cw_off + 4, size_t(n) * 4);
+  uint32_t bad = M3CheckCall(rec.call, x.draw_packet, x.draw_packet_words);
+  if (bad == kM3CCount && (x.draw_packet[0] != h.draw_header)) bad = kM3CDrawTail;
+  *call_bad = bad;
+  return 0;
+}
+
+// Any game thread. -1 malformed, 0 refused (no marker / NOP span), 1 accepted (*out_id != 0).
+static int M3Submit(const void* data, uint32_t size, uint32_t* out_id) {
+  if (out_id) *out_id = 0;
+  const uint32_t mode = M3Mode();
+  M3Record rec;
+  uint32_t call_bad = kM3CCount;
+  const int parsed = M3Parse(data, size, rec, &call_bad);
+  std::lock_guard<std::mutex> lock(g_m3.mutex);
+  M3Window& w = g_m3.w;
+  if (parsed < 0 || !out_id) {
+    ++w.refused[kM3RBad];
+    return -1;
+  }
+  ++(rec.owned ? w.sub_owned : w.sub_shadow);
+  auto refuse = [&](M3Refuse why) {
+    ++w.refused[why];
+    return 0;
+  };
+  if (!mode || (rec.owned && mode != 2)) return refuse(kM3ROff);
+  if (call_bad != kM3CCount) {
+    ++w.call_bad[call_bad];
+    return refuse(kM3RCall);
+  }
+  const uint32_t vs = NativeBridgePhys(rec.r.vertex_shader_guest), ps = NativeBridgePhys(rec.r.pixel_shader_guest),
+                 decl = rec.r.vertex_decl_guest;
+  if (!(rec.r.flags & REX_NATIVE_DRAW_FLAG_HAS_PACKET) || !vs) return refuse(kM3RNoPacket);
+  rec.key = M3KeyId(vs, ps, decl);
+  if (rec.owned) {
+    auto kit = g_m3.keys.find(rec.key);
+    if (kit == g_m3.keys.end() || !kit->second.ownable || kit->second.vs != vs || kit->second.ps != ps ||
+        kit->second.decl != decl) {
+      return refuse(kM3RNotOwnable);
+    }
+    // First owned family: depth-only draws (the pre-pass); the record's colour mask comes from the device shadow.
+    if (rec.r.color_mask != 0) return refuse(kM3RFamily);
+  }
+  if (g_m3.recs.size() >= kM3MaxRecords || g_m3.word_bytes + rec.call.size() * 4 > kM3MaxWordBytes) {
+    return refuse(kM3RFull);
+  }
+  uint32_t id = 0x80000000u | (g_m3.next_id++ & 0x7FFFFFFFu);
+  if (id == 0x80000000u) id = 0x80000000u | (g_m3.next_id++ & 0x7FFFFFFFu);
+  if (!rec.owned) {
+    M3Key& k = g_m3.keys[rec.key];
+    if (!k.vs) {
+      k.vs = vs;
+      k.ps = ps;
+      k.decl = decl;
+      M3Publish(k);  // SHADOW flag: the SDK wants shadow records for this key
+    }
+  }
+  rec.submit_swap = g_m3.swaps;
+  g_m3.word_bytes += rec.call.size() * 4;
+  ++(rec.owned ? w.acc_owned : w.acc_shadow);
+  g_m3.recs.emplace(id, std::move(rec));
+  *out_id = id;
+  return 1;
+}
+
+static void M3Example(const std::string& s) {
+  M3Window& w = g_m3.w;
+  if (w.n_examples >= 8) return;
+  ++w.n_examples;
+  w.examples += s;
+}
+
+// Peek `count` stream dwords after the current read position (host order); false when the stream holds fewer.
+static bool M3Peek(memory::RingBuffer* reader, uint32_t count, std::vector<uint32_t>& out) {
+  out.resize(count);
+  if (!reader || reader->read_count() < size_t(count) * 4) return false;
+  const size_t off = reader->read_offset();
+  reader->Read(reinterpret_cast<uint8_t*>(out.data()), size_t(count) * 4);
+  reader->set_read_offset(off);
+  for (uint32_t& v : out) v = rex::byte_swap(v);
+  return true;
+}
+
+// CP thread: a marker NOP {magic, id, body...}. Returns the replay length in out (guest byte order) or 0.
+static uint32_t M3MarkerHook(uint32_t id, uint32_t header, memory::RingBuffer* reader, uint32_t body_words,
+                             uint32_t* out, uint32_t max_words) {
+  (void)M3Mode();
+  const uint64_t t0 = __rdtsc();
+  std::lock_guard<std::mutex> lock(g_m3.mutex);
+  M3Window& w = g_m3.w;
+  ++w.markers;
+  if (!id) {
+    ++w.id_zero;  // reserved shadow marker the game did not use (plain NOP)
+    return 0;
+  }
+  auto it = g_m3.recs.find(id);
+  if (it == g_m3.recs.end()) {
+    ++w.id_miss;
+    if (body_words) {
+      ++w.holes;
+      M3Example(fmt::format(" [HOLE unknown id {:08X} span {}]", id, body_words + 2));
+    }
+    return 0;
+  }
+  M3Record& m = it->second;
+  ++m.execs;
+  m.last_exec_swap = g_m3.swaps;
+  const uint32_t n = uint32_t(m.call.size());
+  auto kit = g_m3.keys.find(m.key);
+  M3Key* k = kit != g_m3.keys.end() ? &kit->second : nullptr;
+  if (!m.owned) {
+    // SHADOW: the call must follow the marker word for word.
+    ++w.shadow_markers;
+    if (body_words) {
+      ++w.shadow_body;  // a shadow marker must be a plain 2-dword NOP
+      return 0;
+    }
+    if (!M3Peek(reader, n, g_m3.peek)) {
+      ++w.shadow_short;
+      return 0;
+    }
+    if (g_m3.peek == m.call) {
+      ++w.shadow_exact;
+      if (k) {
+        ++k->ok;
+        if (!k->ownable && !k->revoked && !k->bad && k->ok >= kM3ProveChecks && m.r.color_mask == 0) {
+          k->ownable = true;
+          ++w.ownable_new;
+          M3Publish(*k);
+        }
+      }
+    } else {
+      ++w.shadow_diff;
+      uint32_t first = 0;
+      while (first < n && g_m3.peek[first] == m.call[first]) ++first;
+      M3Example(fmt::format(" [shadow diff id {:08X} path {} caller {:08X} vs {:08X} at {}/{} rec {:08X} cp {:08X}]",
+                            id, m.r.path_id, m.r.caller, NativeBridgePhys(m.r.vertex_shader_guest), first, n,
+                            first < n ? m.call[first] : 0, first < n ? g_m3.peek[first] : 0));
+      if (k) {
+        ++k->bad;
+        if (k->ownable) {
+          k->ownable = false;
+          k->revoked = true;
+          ++w.revoked;
+          M3Publish(*k);
+        }
+      }
+    }
+    w.hook_ticks += __rdtsc() - t0;
+    return 0;
+  }
+  // OWNED NOP span: rebuild the call = record words 0..2 + the stream body (the truth for what it still holds).
+  ++w.owned_markers;
+  if (n < 4 || body_words + 3 > max_words) {
+    ++w.holes;
+    M3Example(fmt::format(" [HOLE owned id {:08X} n {} body {}]", id, n, body_words));
+    return 0;
+  }
+  if (body_words + 3 != n) {
+    ++w.owned_len;
+    M3Example(fmt::format(" [owned span length id {:08X} n {} body {}]", id, n, body_words));
+  }
+  if (!M3Peek(reader, body_words, g_m3.peek)) {
+    ++w.holes;
+    return 0;
+  }
+  for (uint32_t i = 0; i < 3; ++i) out[i] = rex::byte_swap(m.call[i]);
+  for (uint32_t i = 0; i < body_words; ++i) out[3 + i] = rex::byte_swap(g_m3.peek[i]);
+  const bool same = body_words + 3 == n && std::equal(g_m3.peek.begin(), g_m3.peek.end(), m.call.begin() + 3);
+  if (same) {
+    ++w.owned_exact;
+    if (k) ++k->owned_ok;
+  } else {
+    ++w.owned_diff;
+    if (k) {
+      ++k->owned_bad;
+      if (k->ownable) {
+        k->ownable = false;
+        k->revoked = true;
+        ++w.revoked;
+        M3Publish(*k);
+      }
+    }
+  }
+  ++w.replays;
+  w.replay_words += body_words + 3;
+  w.hook_ticks += __rdtsc() - t0;
+  (void)header;
+  return body_words + 3;
+}
+
+// CP thread, IssueSwap: retire / expire records, log every 10 s.
+static void M3OnSwap() {
+  const uint32_t mode = M3Mode();
+  std::lock_guard<std::mutex> lock(g_m3.mutex);
+  if (!mode && !g_m3.ever_on) return;
+  g_m3.ever_on = true;
+  ++g_m3.swaps;
+  M3Window& w = g_m3.w;
+  for (auto it = g_m3.recs.begin(); it != g_m3.recs.end();) {
+    const M3Record& m = it->second;
+    const bool retire = m.execs && m.last_exec_swap + kM3RetireSwaps < g_m3.swaps;
+    const bool expire = !m.execs && m.submit_swap + kM3ExpireSwaps < g_m3.swaps;
+    if (retire || expire) {
+      ++(retire ? w.retired : w.expired);
+      g_m3.word_bytes -= m.call.size() * 4;
+      it = g_m3.recs.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  const uint64_t now = GetTickCount64();
+  LARGE_INTEGER q;
+  QueryPerformanceCounter(&q);
+  const uint64_t tsc = __rdtsc();
+  if (!g_m3.last_log) {
+    g_m3.last_log = now;
+    g_m3.qpc0 = uint64_t(q.QuadPart);
+    g_m3.tsc0 = tsc;
+    return;
+  }
+  if (now < g_m3.last_log + 10000) return;
+  LARGE_INTEGER fq;
+  QueryPerformanceFrequency(&fq);
+  const double secs = double(uint64_t(q.QuadPart) - g_m3.qpc0) / double(fq.QuadPart);
+  const double tpu = secs > 0 ? double(tsc - g_m3.tsc0) / (secs * 1e6) : 1.0;
+  g_m3.last_log = now;
+  g_m3.qpc0 = uint64_t(q.QuadPart);
+  g_m3.tsc0 = tsc;
+  std::string refused, calls;
+  for (uint32_t i = 0; i < kM3RCount; ++i) {
+    if (w.refused[i]) refused += fmt::format(" {} {}", kM3RefuseName[i], w.refused[i]);
+  }
+  for (uint32_t i = 0; i < kM3CCount; ++i) {
+    if (w.call_bad[i]) calls += fmt::format(" {} {}", kM3CallBadName[i], w.call_bad[i]);
+  }
+  uint64_t ownable = 0, proving = 0, failed = 0;
+  for (const auto& [kid, k] : g_m3.keys) {
+    if (k.ownable) {
+      ++ownable;
+    } else if (k.bad || k.owned_bad) {
+      ++failed;
+    } else if (k.ok) {
+      ++proving;
+    }
+  }
+  const uint64_t hooks = w.shadow_markers + w.owned_markers;
+  REXLOG_INFO(
+      "NATIVE M3 (10 s, mode {}): submitted shadow {} owned {} | accepted shadow {} owned {} | refused:{}{} | markers {} "
+      "(id 0 {}, unknown id {}, HOLES {}) | shadow {}: EXACT {} diff {} short {} bad-kind {} | owned spans {}: EXACT {} "
+      "diff {} length {} | replays {} ({:.1f} words) | keys {} (ownable {}, proving {}, failed {}; new ownable {}, "
+      "revoked {}) | records live {} ({} KB), retired {} expired {} | hook {:.2f} us{}",
+      g_m3.mode.load() == 2 ? "replace" : g_m3.mode.load() ? "shadow" : "off", w.sub_shadow, w.sub_owned, w.acc_shadow,
+      w.acc_owned, refused.empty() ? " none" : refused, calls.empty() ? std::string() : " | bad calls:" + calls,
+      w.markers, w.id_zero, w.id_miss, w.holes, w.shadow_markers, w.shadow_exact, w.shadow_diff, w.shadow_short,
+      w.shadow_body, w.owned_markers, w.owned_exact, w.owned_diff, w.owned_len, w.replays,
+      w.replays ? double(w.replay_words) / double(w.replays) : 0.0, g_m3.keys.size(), ownable, proving, failed,
+      w.ownable_new, w.revoked, g_m3.recs.size(), g_m3.word_bytes / 1024, w.retired, w.expired,
+      hooks ? double(w.hook_ticks) / tpu / double(hooks) : 0.0,
+      w.examples.empty() ? std::string() : " | examples:" + w.examples);
+  w = M3Window{};
+}
+
+static int M3GetMasksExport(uint32_t vs, uint32_t ps, uint32_t decl, void* out) {
+  if (!out) return -1;
+  RexNativeDrawMasksV2 m;
+  int r = M3GetMasks(vs, ps, decl, &m);
+  // AGENT_NATIVE30A (29B asks 1+b): whenever the bridge has published masks for the key (verify / dry mode, CP thread at
+  // the matched-record site), also return the used const groups and fetch units (capture v4-full needs them; before
+  // this only the M3 flags were returned and only in M3 mode -> 'const-unpub / fetch-unpub' 100 % in c30b).
+  uint64_t gm[2] = {};
+  uint32_t gen = 0, fu[3] = {};
+  if (NativeBridgeGetMasks(vs, ps, decl, gm, &gen, fu) == 1) {
+    m.vs_groups = gm[0];
+    m.ps_groups = gm[1];
+    std::memcpy(m.fetch_units, fu, sizeof(fu));
+    if (r != 1) {
+      m.generation = gen;
+      r = 1;
+    }
+    // AGENT_NATIVE30A2 step 2: flags bit 2 'executable' (RECORD_OWNABLE) = the SDK accepts OWNED runs of this key.
+    g_own_q_pub.fetch_add(1, std::memory_order_relaxed);  // MAIN31
+    if (NativeOwnHint(vs, ps, decl)) {
+      m.flags |= 4u;
+      g_own_q_hit.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  std::memcpy(out, &m, sizeof(m));
+  return r;
+}
