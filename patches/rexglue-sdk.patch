+struct BindingMemoEntry {
+  uint32_t dwords[6] = {};
+  bool filled = false;
+  alignas(8) uint8_t key_bytes[32] = {};  // TextureCache::TextureKey (protected type)
+  uint8_t swizzled_signs = 0;
+  uint32_t host_swizzle = 0;
+  template <typename Key>
+  void Fill(const xenos::xe_gpu_texture_fetch_t& fetch, const Key& k, uint8_t signs,
+            uint32_t swizzle) {
+    static_assert(sizeof(Key) <= sizeof(key_bytes));
+    std::memcpy(dwords, &fetch, sizeof(dwords));
+    std::memcpy(key_bytes, &k, sizeof(Key));
+    swizzled_signs = signs;
+    host_swizzle = swizzle;
+    filled = true;
+  }
+};
+constexpr uint32_t kBindingMemoSize = 4096;
+bool BindingMemoEnabled() {
+  static const bool enabled = [] {
+    bool on = true;
+    if (FILE* f = std::fopen("gpu_memo.off", "rb")) {
+      std::fclose(f);
+      on = false;
+    }
+    REXLOG_INFO("Texture fetch constant memo {}", on ? "on" : "OFF (gpu_memo.off)");
+    return on;
+  }();
+  return enabled;
+}
+BindingMemoEntry& BindingMemoFor(const xenos::xe_gpu_texture_fetch_t& fetch) {
+  static std::vector<BindingMemoEntry> memo(kBindingMemoSize);
+  uint32_t d[6];
+  std::memcpy(d, &fetch, sizeof(d));
+  uint64_t h = 0x9E3779B97F4A7C15ull;
+  for (uint32_t v : d) {
+    h = (h ^ v) * 0xFF51AFD7ED558CCDull;
+  }
+  h ^= h >> 29;
+  BindingMemoEntry& e = memo[uint32_t(h) & (kBindingMemoSize - 1)];
+  if (e.filled && std::memcmp(e.dwords, d, sizeof(d)) != 0) {
+    e.filled = false;  // different constant in this slot: decode + refill
+  }
+  return e;
+}
