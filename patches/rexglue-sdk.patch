+        pf.inel_ib = pf.inel_reset = pf.inel_align = pf.split_state = pf.split_ratio = pf.split_cap = 0;
+      }
+      nf.fast_draws = nf.misses_key = nf.misses_shader = nf.misses_submission = nf.misses_other = 0;
+      nf.fast_ticks = 0;
+    }
+    stat_native_draws_ = stat_native_fallbacks_ = 0;
+    stat_native_ticks_ = stat_emulated_ticks_ = stat_emulated_timed_draws_ = 0;
+  }
+  REXLOG_INFO("BARRIERS by kind:{}", top(barrier_stat_count_));
+  REXLOG_INFO("BARRIER BATCHES by first barrier:{}", top(barrier_stat_batches_));
+  stat_draws_ = stat_memexport_draws_ = stat_copies_ = stat_pipeline_binds_ = stat_submissions_ =
