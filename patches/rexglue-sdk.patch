+        msaa_rt.resource(), msaa_rt.SetResourceState(D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE),
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    const uint32_t constants[6] = {msaa_x0, msaa_y0, msaa_host_width, msaa_host_height, fill_x, fill_y};
+    DeferredCommandList& list = command_processor_.GetDeferredCommandList();
+    command_processor_.SetExternalPipeline(g_dm.pack.Get());
+    list.D3DSetComputeRootSignature(g_dm.root.Get());
+    list.D3DSetComputeRoot32BitConstants(0, 6, constants, 0);
+    list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+    list.D3DSetComputeRootDescriptorTable(4, descriptors[1].second);
+    command_processor_.SubmitBarriers();
+    list.D3DDispatch((msaa_host_width + 7) / 8, (msaa_host_height + 7) / 8, 1);
+    if (entry) {
+      entry->pending = true;
+      entry->base = resolve_info.copy_dest_base;
+      entry->width = msaa_width;
+      entry->height = msaa_height;
+      entry->host_width = msaa_host_width;
+      entry->host_height = msaa_host_height;
+      entry->fill_x = fill_x;
+      entry->fill_y = fill_y;
